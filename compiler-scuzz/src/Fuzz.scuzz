package scuzz.compiler

def lcgSeed(seed: Int): Int =
  seed % 2147483646 + 1

def lcgNext(s: Int): Int =
  s * 48271 % 2147483647

def lcgBelow(s: Int, n: Int): Int =
  if (n <= 0) 0 else s % n

def maxOf(a: Int, b: Int): Int =
  if (a >= b) a else b

def boolPos(n: Int): Int =
  if (n > 0) 1 else 0

def letterAt(i: Int): String =
  Str.slice("abcdefghijklmnopqrstuvwxyz", i, i + 1)

def fuzzKindCount(hasText: Int, hasScroll: Int, hasDrive: Int): Int =
  3 + hasDrive + hasText + hasText + hasText + hasScroll

def fuzzTap(s: Int, nButtons: Int): List =
  pair(strcat("tap ", Str.fromInt(lcgBelow(s, maxOf(nButtons, 1)))), Str.fromInt(s))

def fuzzPump(s: Int): List =
  pair(strcat("pump ", Str.fromInt(1 + lcgBelow(s, 3))), Str.fromInt(s))

def fuzzWordAcc(prefix: String, s: Int, n: Int, acc: String): List =
  if (n == 0) pair(strcat(prefix, acc), Str.fromInt(s)) else fuzzWordAcc(prefix, lcgNext(s), n - 1, Str.concat(acc, letterAt(lcgBelow(s, 26))))

def fuzzText(s: Int): List =
  fuzzWordAcc("text ", lcgNext(s), 1 + lcgBelow(s, 7), "")

def fuzzType(s: Int): List =
  fuzzWordAcc("type ", lcgNext(s), 1 + lcgBelow(s, 7), "")

def fuzzScroll(s: Int): List =
  pair("scroll 40", Str.fromInt(s))

def fuzzBackspace(s: Int): List =
  pair("backspace", Str.fromInt(s))

def fuzzScrollOrText(s: Int, hasScroll: Int): List =
  if (hasScroll == 1) fuzzScroll(s) else fuzzText(s)

def fuzzBackspaceOrText(s: Int, hasText: Int): List =
  if (hasText == 1) fuzzBackspace(s) else fuzzText(s)

def fuzzTypeOrText(s: Int, hasText: Int): List =
  if (hasText == 1) fuzzType(s) else fuzzText(s)

def driveBool(s: Int): String =
  if (lcgBelow(s, 2) == 0) "false" else "true"

def driveLine(spec: String, s: Int): String =
  if (endsWith(spec, " i") == 1) str4("drive ", Str.slice(spec, 0, Str.len(spec) - 2), " ", Str.fromInt(1 + lcgBelow(s, 3))) else if (endsWith(spec, " s") == 1) str4("drive ", Str.slice(spec, 0, Str.len(spec) - 2), " ", letterAt(lcgBelow(s, 26))) else if (endsWith(spec, " b") == 1) str4("drive ", Str.slice(spec, 0, Str.len(spec) - 2), " ", driveBool(s)) else str3("drive ", spec, "")

def fuzzDrive(s: Int, drivers: List): List =
  fuzzDriveSpec(List.at(drivers, lcgBelow(s, List.len(drivers))), lcgNext(s))

def fuzzDriveSpec(spec: String, s: Int): List =
  pair(driveLine(spec, s), Str.fromInt(s))

def fuzzEvent(s: Int, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List): List =
  fuzzEventAt(lcgNext(s), nButtons, hasText, hasScroll, drivers)

def fuzzEventAt(s: Int, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List): List =
  fuzzEventKind(s, lcgBelow(s, fuzzKindCount(hasText, hasScroll, boolPos(List.len(drivers)))), nButtons, hasScroll, hasText, drivers)

def fuzzEventKind(s: Int, k: Int, nButtons: Int, hasScroll: Int, hasText: Int, drivers: List): List =
  if (k <= 1) fuzzTap(lcgNext(s), nButtons) else if (k == 2) fuzzPump(lcgNext(s)) else if (boolPos(List.len(drivers)) == 1) if (k == 3) fuzzDrive(lcgNext(s), drivers) else fuzzEventExtra(lcgNext(s), k - 4, hasScroll, hasText) else fuzzEventExtra(lcgNext(s), k - 3, hasScroll, hasText)

def fuzzEventExtra(s: Int, k: Int, hasScroll: Int, hasText: Int): List =
  if (k == 0) fuzzScrollOrText(s, hasScroll) else if (k == 1) fuzzBackspaceOrText(s, hasText) else if (k == 2) fuzzTypeOrText(s, hasText) else fuzzText(s)

def fuzzScript(seed: Int, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List): List =
  fuzzScriptLen(lcgNext(lcgSeed(seed)), nButtons, hasText, hasScroll, drivers)

def fuzzScriptLen(s: Int, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List): List =
  fuzzScriptAcc(s, 1 + lcgBelow(s, 12), nButtons, hasText, hasScroll, drivers, List.empty())

def fuzzScriptAcc(s: Int, remaining: Int, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List, acc: List): List =
  if (remaining == 0) List.reverse(acc) else fuzzScriptStep(fuzzEvent(s, nButtons, hasText, hasScroll, drivers), remaining, nButtons, hasText, hasScroll, drivers, acc)

def fuzzScriptStep(ev: List, remaining: Int, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List, acc: List): List =
  fuzzScriptAcc(parseInt(snd(ev)), remaining - 1, nButtons, hasText, hasScroll, drivers, List.cons(fst(ev), acc))

def listTake(xs: List, n: Int, acc: List): List =
  if (n <= 0) List.reverse(acc) else if (List.isEmpty(xs) == 1) List.reverse(acc) else listTake(List.tail(xs), n - 1, List.cons(List.head(xs), acc))

def corpusPush(corpus: List, events: List): List =
  List.cons(events, listTake(corpus, 31, List.empty()))

def dumpPush(seen: List, dump: String): List =
  if (listContainsStr(seen, dump) == 1) seen else List.cons(dump, listTake(seen, 63, List.empty()))

def isDumpNovel(dump: String, seen: List): Int =
  if (listContainsStr(seen, dump) == 1) 0 else 1

def corpusKeep(reached: List, oldCamp: List, dump: String, seen: List): Int =
  boolPos(List.len(missingSometimes(reached, oldCamp, List.empty())) + isDumpNovel(dump, seen))

def pairLL(a: List, b: List): List =
  List.cons(a, List.cons(b, List.empty()))

def corpusPushIf(corpus: List, events: List, reached: List, oldCamp: List, dump: String, seen: List): List =
  if (corpusKeep(reached, oldCamp, dump, seen) == 0) pairLL(corpus, seen) else pairLL(corpusPush(corpus, events), dumpPush(seen, dump))

def fuzzExtendPrefix(prefix: List, s: Int, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List): List =
  fuzzScriptAcc(s, 1 + lcgBelow(s, 4), nButtons, hasText, hasScroll, drivers, List.reverse(prefix))

def fuzzPickScript(seed: Int, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List, corpus: List): List =
  if (List.isEmpty(corpus) == 1) fuzzScript(seed, nButtons, hasText, hasScroll, drivers) else fuzzPickScriptCoin(lcgNext(lcgSeed(seed)), seed, nButtons, hasText, hasScroll, drivers, corpus)

def fuzzPickScriptCoin(s: Int, seed: Int, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List, corpus: List): List =
  if (lcgBelow(s, 2) == 0) fuzzScript(seed, nButtons, hasText, hasScroll, drivers) else fuzzPickExtend(lcgNext(s), nButtons, hasText, hasScroll, drivers, corpus)

def fuzzPickExtend(s: Int, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List, corpus: List): List =
  fuzzExtendPrefix(List.at(corpus, lcgBelow(s, List.len(corpus))), lcgNext(s), nButtons, hasText, hasScroll, drivers)

def lineEndAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) i else if (Str.charAt(s, i) == 10) i else lineEndAt(s, i + 1)

def countPrefixLines(s: String, prefix: String, i: Int, acc: Int): Int =
  if (i >= Str.len(s)) acc else countPrefixLines(s, prefix, lineEndAt(s, i) + 1, acc + startsWith(Str.slice(s, i, Str.len(s)), prefix))

def fuzzScriptText(events: List): String =
  Str.concat(join(events, "\n"), "\n")

def schedEnv(scheduleSeed: String): String =
  if (Str.len(scheduleSeed) == 0) "" else str3(" SCUZZ_SCHED_SEED=", scheduleSeed, "")

def fuzzCmd(exe: String, script: String, dump: String, w: String, h: String, scheduleSeed: String, sometimesDump: String): String =
  Str.concat(str6("env SCUZZ_UI_RUNTIME=headless SCUZZ_TESTRT=1 SCUZZ_UI_SCRIPT=", script, " SCUZZ_FUZZ_DUMP=", dump, " SCUZZ_UI_WIDTH=", w), str6(" SCUZZ_UI_HEIGHT=", h, schedEnv(scheduleSeed), " SCUZZ_SOMETIMES_DUMP=", sometimesDump, Str.concat(" ", exe)))

def fuzzCmdIo(exe: String, scheduleSeed: String, sometimesDump: String): String =
  if (Str.len(scheduleSeed) == 0) str5("env SCUZZ_TESTRT=1 SCUZZ_SOMETIMES_DUMP=", sometimesDump, " ", exe, "") else str5("env SCUZZ_TESTRT=1 SCUZZ_SCHED_SEED=", scheduleSeed, str3(" SCUZZ_SOMETIMES_DUMP=", sometimesDump, " "), exe, "")

def fuzzLinesAcc(s: String, i: Int, acc: List): List =
  if (i >= Str.len(s)) List.reverse(acc) else fuzzLinesOne(s, i, acc)

def fuzzLinesOne(s: String, i: Int, acc: List): List =
  for {
    end = lineEndAt(s, i)
    line = Str.slice(s, i, end)
    next = end + 1
  } yield if (Str.len(line) == 0) fuzzLinesAcc(s, next, acc) else fuzzLinesAcc(s, next, List.cons(line, acc))

def unionStr(xs: List, ys: List): List =
  if (List.isEmpty(ys) == 1) xs else if (listContainsStr(xs, List.head(ys)) == 1) unionStr(xs, List.tail(ys)) else unionStr(List.cons(List.head(ys), xs), List.tail(ys))

def missingSometimes(declared: List, reached: List, acc: List): List =
  if (List.isEmpty(declared) == 1) List.reverse(acc) else if (listContainsStr(reached, List.head(declared)) == 1) missingSometimes(List.tail(declared), reached, acc) else missingSometimes(List.tail(declared), reached, List.cons(List.head(declared), acc))

def mergeSometimes(reachedPath: String, campaignPath: String): IO[Unit] =
  Fs.read(reachedPath).flatMap(reached =>
    Fs.read(campaignPath).flatMap(camp => Fs.write(campaignPath, sometimesDeclaredText(unionStr(fuzzLinesAcc(camp, 0, List.empty()), fuzzLinesAcc(reached, 0, List.empty())))))
  )

def checkSometimesMissing(missing: List): IO[Unit] =
  if (List.isEmpty(missing) == 1) IO.pure(()) else IO.fail(str3("Law.sometimes never reached: ", join(missing, ", "), ""))

def checkSometimesCampaign(projectDir: String, fuzzDir: String): IO[Unit] =
  Fs.read(pathJoin(pathJoin(projectDir, "build"), "sometimes.declared")).flatMap(declText =>
    Fs.read(pathJoin(fuzzDir, "sometimes.campaign")).flatMap(campText => checkSometimesMissing(missingSometimes(fuzzLinesAcc(declText, 0, List.empty()), fuzzLinesAcc(campText, 0, List.empty()), List.empty())))
  )

def fuzzExec(exe: String, fuzzDir: String, w: String, h: String, events: List, scheduleSeed: String): IO[Int] =
  Fs.write(pathJoin(fuzzDir, "script.txt"), fuzzScriptText(events)).flatMap(_ =>
    Fs.write(pathJoin(fuzzDir, "dump.txt"), "").flatMap(_ =>
      Fs.write(pathJoin(fuzzDir, "sometimes.reached"), "").flatMap(_ =>
        Sys.exec(fuzzCmd(exe, pathJoin(fuzzDir, "script.txt"), pathJoin(fuzzDir, "dump.txt"), w, h, scheduleSeed, pathJoin(fuzzDir, "sometimes.reached"))).flatMap(code =>
          mergeSometimes(pathJoin(fuzzDir, "sometimes.reached"), pathJoin(fuzzDir, "sometimes.campaign")).flatMap(_ => IO.pure(code))
        )
      )
    )
  )

def fuzzExecIo(exe: String, fuzzDir: String, scheduleSeed: String): IO[Int] =
  Fs.write(pathJoin(fuzzDir, "sometimes.reached"), "").flatMap(_ =>
    Sys.exec(fuzzCmdIo(exe, scheduleSeed, pathJoin(fuzzDir, "sometimes.reached"))).flatMap(code =>
      mergeSometimes(pathJoin(fuzzDir, "sometimes.reached"), pathJoin(fuzzDir, "sometimes.campaign")).flatMap(_ => IO.pure(code))
    )
  )

def quoteEvents(events: List, acc: List): List =
  if (List.isEmpty(events) == 1) List.reverse(acc) else quoteEvents(List.tail(events), List.cons(str3("\"", List.head(events), "\""), acc))

def scheduleSeedLine(scheduleSeed: String): String =
  if (Str.len(scheduleSeed) == 0) "" else str3("schedule_seed = ", scheduleSeed, "\n")

def reproText(seed: Int, scheduleSeed: String, events: List): String =
  Str.concat(str4("[fuzz]\nseed = ", Str.fromInt(seed), "\n", scheduleSeedLine(scheduleSeed)), str3("events = [", join(quoteEvents(events, List.empty()), ", "), "]\n"))

def fuzzFail(projectDir: String, fuzzDir: String, scriptSeed: Int, scheduleSeed: Int, iter: Int, events: List): IO[Unit] =
  Fs.write(pathJoin(fuzzDir, "repro.toml"), reproText(scriptSeed, Str.fromInt(scheduleSeed), events)).flatMap(_ =>
    IO.println(str6("fuzz failure at script ", Str.fromInt(iter), " (seed ", Str.fromInt(scriptSeed), "); wrote ", pathJoin(fuzzDir, "repro.toml"))).flatMap(_ =>
      IO.println(str4("replay: scuzz fuzz ", projectDir, " --replay ", pathJoin(fuzzDir, "repro.toml"))).flatMap(_ => IO.fail("fuzz failure"))
    )
  )

def fuzzExhaustFail(projectDir: String, fuzzDir: String, depth: Int, scriptIndex: Int, events: List): IO[Unit] =
  Fs.write(pathJoin(fuzzDir, "repro.toml"), reproText(depth, "", events)).flatMap(_ =>
    IO.println(str6("fuzz --exhaust failure at script ", Str.fromInt(scriptIndex), " (depth ", Str.fromInt(depth), "); wrote ", pathJoin(fuzzDir, "repro.toml"))).flatMap(_ =>
      IO.println(str4("replay: scuzz fuzz ", projectDir, " --replay ", pathJoin(fuzzDir, "repro.toml"))).flatMap(_ => IO.fail("fuzz exhaust failure"))
    )
  )

def fuzzLoop(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List, seed: Int, iter: Int, iters: Int, corpus: List, seen: List): IO[Unit] =
  if (iter >= iters) checkSometimesCampaign(projectDir, fuzzDir).flatMap(_ => IO.println(str6("scuzz fuzz ok (", Str.fromInt(iters), " scripts, seed ", Str.fromInt(seed), ", ", str3(Str.fromInt(List.len(corpus)), " corpus prefixes)", "")))) else fuzzIter(exe, fuzzDir, w, h, projectDir, nButtons, hasText, hasScroll, drivers, seed, iter, iters, corpus, seen)

def fuzzIter(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List, seed: Int, iter: Int, iters: Int, corpus: List, seen: List): IO[Unit] =
  for {
    events = fuzzPickScript(seed + iter, nButtons, hasText, hasScroll, drivers, corpus)
    sched = seed + iter
    campPath = pathJoin(fuzzDir, "sometimes.campaign")
  } yield Fs.read(campPath).flatMap(oldCamp =>
  fuzzExec(exe, fuzzDir, w, h, events, Str.fromInt(sched)).flatMap(code => if (code == 0) fuzzIterOk(exe, fuzzDir, w, h, projectDir, nButtons, hasText, hasScroll, drivers, seed, iter, iters, corpus, seen, events, oldCamp) else fuzzFail(projectDir, fuzzDir, seed + iter, sched, iter, events))
)

def fuzzIterOk(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List, seed: Int, iter: Int, iters: Int, corpus: List, seen: List, events: List, oldCamp: String): IO[Unit] =
  Fs.read(pathJoin(fuzzDir, "sometimes.reached")).flatMap(reached =>
    Fs.read(pathJoin(fuzzDir, "dump.txt")).flatMap(dump => fuzzIterOkPacked(exe, fuzzDir, w, h, projectDir, nButtons, hasText, hasScroll, drivers, seed, iter, iters, corpusPushIf(corpus, events, fuzzLinesAcc(reached, 0, List.empty()), fuzzLinesAcc(oldCamp, 0, List.empty()), dump, seen)))
  )

def fuzzIterOkPacked(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List, seed: Int, iter: Int, iters: Int, packed: List): IO[Unit] =
  fuzzLoop(exe, fuzzDir, w, h, projectDir, nButtons, hasText, hasScroll, drivers, seed, iter + 1, iters, fstL(packed), sndL(packed))

def fuzzIoLoop(exe: String, fuzzDir: String, projectDir: String, seed: Int, iter: Int, iters: Int): IO[Unit] =
  if (iter >= iters) checkSometimesCampaign(projectDir, fuzzDir).flatMap(_ => IO.println(str5("scuzz fuzz ok (", Str.fromInt(iters), " schedules, seed ", Str.fromInt(seed), ")"))) else fuzzIoIter(exe, fuzzDir, projectDir, seed, iter, iters)

def fuzzIoIter(exe: String, fuzzDir: String, projectDir: String, seed: Int, iter: Int, iters: Int): IO[Unit] =
  for {
    sched = seed + iter
  } yield fuzzExecIo(exe, fuzzDir, Str.fromInt(sched)).flatMap(code => if (code == 0) fuzzIoLoop(exe, fuzzDir, projectDir, seed, iter + 1, iters) else fuzzFail(projectDir, fuzzDir, seed + iter, sched, iter, List.empty()))

def exhaustTapAcc(i: Int, nButtons: Int, acc: List): List =
  if (i >= nButtons) List.reverse(acc) else exhaustTapAcc(i + 1, nButtons, List.cons(strcat("tap ", Str.fromInt(i)), acc))

def exhaustAlphabet(nButtons: Int, hasText: Int, hasScroll: Int, drivers: List): List =
  exhaustAlphabetFinish(exhaustAlphabetDrivers(exhaustAlphabetScroll(exhaustAlphabetText(exhaustTapAcc(0, nButtons, List.empty()), hasText), hasScroll), drivers))

def exhaustAlphabetDrivers(base: List, drivers: List): List =
  if (List.isEmpty(drivers) == 1) base else exhaustAlphabetDrivers(List.append(base, driveLine(List.head(drivers), 0)), List.tail(drivers))

def exhaustAlphabetText(taps: List, hasText: Int): List =
  if (hasText == 1) List.append(List.append(List.append(List.append(taps, "text"), "text a"), "backspace"), "type a") else taps

def exhaustAlphabetScroll(base: List, hasScroll: Int): List =
  if (hasScroll == 1) List.append(base, "scroll 40") else base

def exhaustAlphabetFinish(base: List): List =
  List.append(base, "pump 1")

def exhaustRunPrefix(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, depth: Int, scriptIndex: Int, prefix: List): IO[Int] =
  fuzzExec(exe, fuzzDir, w, h, prefix, "").flatMap(code => if (code == 0) IO.pure(scriptIndex + 1) else fuzzExhaustFail(projectDir, fuzzDir, depth, scriptIndex, prefix).flatMap(_ => IO.pure(scriptIndex)))

def exhaustExtend(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, maxDepth: Int, targetLen: Int, alphabet: List, prefix: List, scriptIndex: Int): IO[Int] =
  if (List.len(prefix) == targetLen) exhaustRunPrefix(exe, fuzzDir, w, h, projectDir, maxDepth, scriptIndex, prefix) else exhaustExtendOver(exe, fuzzDir, w, h, projectDir, maxDepth, targetLen, alphabet, alphabet, prefix, scriptIndex)

def exhaustExtendOver(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, maxDepth: Int, targetLen: Int, alphabet: List, remaining: List, prefix: List, scriptIndex: Int): IO[Int] =
  if (List.isEmpty(remaining) == 1) IO.pure(scriptIndex) else exhaustExtend(exe, fuzzDir, w, h, projectDir, maxDepth, targetLen, alphabet, List.append(prefix, List.head(remaining)), scriptIndex).flatMap(next => exhaustExtendOver(exe, fuzzDir, w, h, projectDir, maxDepth, targetLen, alphabet, List.tail(remaining), prefix, next))

def fuzzExhaustDepth(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, alphabet: List, depth: Int, maxDepth: Int, scriptIndex: Int): IO[Unit] =
  if (depth > maxDepth) checkSometimesCampaign(projectDir, fuzzDir).flatMap(_ => IO.println(str5("scuzz fuzz --exhaust ok (depth ", Str.fromInt(maxDepth), ", ", Str.fromInt(scriptIndex), " scripts)"))) else exhaustExtend(exe, fuzzDir, w, h, projectDir, maxDepth, depth, alphabet, List.empty(), scriptIndex).flatMap(next => fuzzExhaustDepth(exe, fuzzDir, w, h, projectDir, alphabet, depth + 1, maxDepth, next))

def fuzzExhaust(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List, depth: Int): IO[Unit] =
  fuzzExhaustDepth(exe, fuzzDir, w, h, projectDir, exhaustAlphabet(nButtons, hasText, hasScroll, drivers), 1, depth, 0)

def fuzzProbe(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, seed: Int, iters: Int, exhaust: Int, depth: Int): IO[Unit] =
  fuzzExec(exe, fuzzDir, w, h, List.empty(), "").flatMap(code => if (code != 0) IO.fail("fuzz probe failed: app fails under TestRuntime before any event") else Fs.read(pathJoin(fuzzDir, "dump.txt")).flatMap(dump => fuzzProbeDump(exe, fuzzDir, w, h, projectDir, seed, iters, exhaust, depth, dump)))

def fuzzProbeDump(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, seed: Int, iters: Int, exhaust: Int, depth: Int, dump: String): IO[Unit] =
  fuzzProbeButtons(exe, fuzzDir, w, h, projectDir, seed, iters, exhaust, depth, countPrefixLines(dump, "button:", 0, 0), dump)

def fuzzProbeButtons(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, seed: Int, iters: Int, exhaust: Int, depth: Int, nButtons: Int, dump: String): IO[Unit] =
  fuzzProbeFields(exe, fuzzDir, w, h, projectDir, seed, iters, exhaust, depth, nButtons, countPrefixLines(dump, "textfield:", 0, 0), dump)

def fuzzProbeFields(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, seed: Int, iters: Int, exhaust: Int, depth: Int, nButtons: Int, nFields: Int, dump: String): IO[Unit] =
  fuzzProbeCont(exe, fuzzDir, w, h, projectDir, seed, iters, exhaust, depth, nButtons, nFields, countPrefixLines(dump, "scroll:", 0, 0), dump)

def fuzzProbeCont(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, seed: Int, iters: Int, exhaust: Int, depth: Int, nButtons: Int, nFields: Int, nScrolls: Int, dump: String): IO[Unit] =
  Fs.read(pathJoin(pathJoin(projectDir, "build"), "drivers.txt")).flatMap(dtext => fuzzProbeContDrivers(exe, fuzzDir, w, h, projectDir, seed, iters, exhaust, depth, nButtons, nFields, nScrolls, fuzzLinesAcc(dtext, 0, List.empty()), dump))

def fuzzProbeContDrivers(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, seed: Int, iters: Int, exhaust: Int, depth: Int, nButtons: Int, nFields: Int, nScrolls: Int, drivers: List, dump: String): IO[Unit] =
  if (nButtons + nFields + nScrolls == 0) checkSometimesCampaign(projectDir, fuzzDir).flatMap(_ => IO.println("scuzz fuzz ok (no buttons, text fields, or scrolls; probe only)")) else if (exhaust == 1) fuzzExhaust(exe, fuzzDir, w, h, projectDir, nButtons, boolPos(nFields), boolPos(nScrolls), drivers, depth) else fuzzLoop(exe, fuzzDir, w, h, projectDir, nButtons, boolPos(nFields), boolPos(nScrolls), drivers, seed, 0, iters, List.empty(), List.cons(dump, List.empty()))

def fuzzReplay(exe: String, fuzzDir: String, w: String, h: String, replayPath: String, isUi: Int): IO[Unit] =
  Fs.read(replayPath).flatMap(text => fuzzReplayLoaded(exe, fuzzDir, w, h, replayPath, isUi, tomlGetArrayString(text, "fuzz", "events"), tomlGetInt(text, "fuzz", "seed", "0"), tomlGetInt(text, "fuzz", "schedule_seed", "")))

def fuzzReplayLoaded(exe: String, fuzzDir: String, w: String, h: String, replayPath: String, isUi: Int, events: List, seedStr: String, scheduleSeed: String): IO[Unit] =
  IO.println(str6("scuzz fuzz --replay ", replayPath, " (", Str.fromInt(List.len(events)), " events, seed ", str3(seedStr, schedReplayNote(scheduleSeed), ""))).flatMap(_ =>
    fuzzReplayRun(exe, fuzzDir, w, h, isUi, events, scheduleSeed).flatMap(code => fuzzReplayResult(code))
  )

def schedReplayNote(scheduleSeed: String): String =
  if (Str.len(scheduleSeed) == 0) ")" else str3(", schedule_seed ", scheduleSeed, ")")

def fuzzReplayRun(exe: String, fuzzDir: String, w: String, h: String, isUi: Int, events: List, scheduleSeed: String): IO[Int] =
  if (isUi == 1) fuzzExec(exe, fuzzDir, w, h, events, scheduleSeed) else fuzzExecIo(exe, fuzzDir, scheduleSeed)

def fuzzReplayResult(code: Int): IO[Unit] =
  if (code == 0) IO.println("fuzz replay ok (no failure)") else IO.println("fuzz replay reproduced a failure").flatMap(_ => IO.fail("fuzz replay failure"))

def isFuzzValueFlag(s: String): Int =
  if (streq(s, "--iters") == 1) 1 else if (streq(s, "--seed") == 1) 1 else if (streq(s, "--replay") == 1) 1 else if (streq(s, "--depth") == 1) 1 else 0

def fuzzProjectArg(args: List, i: Int): String =
  if (i >= List.len(args)) "." else if (isFuzzValueFlag(List.at(args, i)) == 1) fuzzProjectArg(args, i + 2) else if (isFlag(List.at(args, i)) == 1) fuzzProjectArg(args, i + 1) else List.at(args, i)

def argValueAt(args: List, flag: String, fallback: String, i: Int): String =
  if (i >= List.len(args)) fallback else if (streq(List.at(args, i), flag) == 1) argValueTake(args, i + 1, fallback) else argValueAt(args, flag, fallback, i + 1)

def argValueTake(args: List, i: Int, fallback: String): String =
  if (i >= List.len(args)) fallback else List.at(args, i)

def cmdFuzzArgs(args: List): IO[Unit] =
  cmdFuzzValidated(fuzzProjectArg(args, 1), argValueAt(args, "--replay", "", 0), parseInt(argValueAt(args, "--iters", "32", 0)), parseInt(argValueAt(args, "--seed", "42", 0)), argFlag(args, "--exhaust", 0), argValueAt(args, "--depth", "", 0))

def cmdFuzzValidated(projectDir: String, replay: String, iters: Int, seed: Int, exhaust: Int, depthStr: String): IO[Unit] =
  if (Str.len(replay) > 0) cmdFuzz(projectDir, replay, iters, seed, 0, 0) else if (exhaust == 1) cmdFuzzExhaust(projectDir, depthStr) else if (Str.len(depthStr) > 0) IO.fail("fuzz --depth requires --exhaust") else cmdFuzz(projectDir, replay, iters, seed, 0, 0)

def cmdFuzzExhaust(projectDir: String, depthStr: String): IO[Unit] =
  if (Str.len(depthStr) == 0) IO.fail("fuzz --exhaust requires --depth N") else cmdFuzzExhaustDepth(projectDir, parseInt(depthStr))

def cmdFuzzExhaustDepth(projectDir: String, depth: Int): IO[Unit] =
  if (depth <= 0) IO.fail("fuzz --exhaust --depth N requires N > 0") else cmdFuzz(projectDir, "", 0, 0, 1, depth)

def cmdFuzz(projectDir: String, replay: String, iters: Int, seed: Int, exhaust: Int, depth: Int): IO[Unit] =
  Fs.read(pathJoin(projectDir, "scuzz.toml")).flatMap(toml => fuzzChecked(projectDir, replay, iters, seed, exhaust, depth, toml))

def fuzzChecked(projectDir: String, replay: String, iters: Int, seed: Int, exhaust: Int, depth: Int, toml: String): IO[Unit] =
  if (hasUiSection(toml) == 0) fuzzCheckedIo(projectDir, replay, iters, seed, exhaust, depth, toml) else compileProjectVerify(projectDir, pathJoin(projectDir, "build")).flatMap(_ => fuzzBuilt(projectDir, replay, iters, seed, exhaust, depth, toml, 1))

def fuzzCheckedIo(projectDir: String, replay: String, iters: Int, seed: Int, exhaust: Int, depth: Int, toml: String): IO[Unit] =
  if (exhaust == 1) IO.fail("fuzz --exhaust requires a [ui] project (event alphabet)") else compileProjectVerify(projectDir, pathJoin(projectDir, "build")).flatMap(_ => fuzzBuilt(projectDir, replay, iters, seed, exhaust, depth, toml, 0))

def fuzzBuilt(projectDir: String, replay: String, iters: Int, seed: Int, exhaust: Int, depth: Int, toml: String, isUi: Int): IO[Unit] =
  for {
    exe = pathJoin(pathJoin(projectDir, "build"), readTomlName(toml))
    fuzzDir = pathJoin(pathJoin(projectDir, "build"), "fuzz")
    w = readTomlHeadlessW(toml)
    h = readTomlHeadlessH(toml)
  } yield Fs.mkdirs(fuzzDir).flatMap(_ =>
  Fs.write(pathJoin(fuzzDir, "sometimes.campaign"), "").flatMap(_ => fuzzDispatch(exe, fuzzDir, w, h, projectDir, replay, iters, seed, exhaust, depth, isUi))
)

def fuzzDispatch(exe: String, fuzzDir: String, w: String, h: String, projectDir: String, replay: String, iters: Int, seed: Int, exhaust: Int, depth: Int, isUi: Int): IO[Unit] =
  if (Str.len(replay) > 0) fuzzReplay(exe, fuzzDir, w, h, replay, isUi) else if (isUi == 1) fuzzProbe(exe, fuzzDir, w, h, projectDir, seed, iters, exhaust, depth) else fuzzIoLoop(exe, fuzzDir, projectDir, seed, 0, iters)

