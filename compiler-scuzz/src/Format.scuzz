package scuzz.compiler

def strHasChar(s: String, ch: Int, i: Int): Int =
  if (i >= Str.len(s)) 0 else if (Str.charAt(s, i) == ch) 1 else strHasChar(s, ch, i + 1)

def isFmtWs(c: Int): Int =
  if (c == 32) 1 else if (c == 10) 1 else if (c == 9) 1 else if (c == 13) 1 else 0

def trimStartAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) i else if (isFmtWs(Str.charAt(s, i)) == 1) trimStartAt(s, i + 1) else i

def trimEndAt(s: String, j: Int): Int =
  if (j <= 0) 0 else if (isFmtWs(Str.charAt(s, j - 1)) == 1) trimEndAt(s, j - 1) else j

def trimStr(s: String): String =
  Str.slice(s, trimStartAt(s, 0), trimEndAt(s, Str.len(s)))

def escapeAt(s: String, i: Int, acc: String): String =
  if (i >= Str.len(s)) acc else escapeAtCont(s, i, acc, Str.charAt(s, i))

def escapeAtCont(s: String, i: Int, acc: String, c: Int): String =
  if (c == 92) escapeAt(s, i + 1, Str.concat(acc, "\\\\")) else if (c == 34) escapeAt(s, i + 1, Str.concat(acc, "\\\"")) else if (c == 10) escapeAt(s, i + 1, Str.concat(acc, "\\n")) else if (c == 9) escapeAt(s, i + 1, Str.concat(acc, "\\t")) else if (c == 13) escapeAt(s, i + 1, Str.concat(acc, "\\r")) else escapeAt(s, i + 1, Str.concat(acc, Str.slice(s, i, i + 1)))

def escape(s: String): String =
  escapeAt(s, 0, "")

def escapeInterpAt(s: String, i: Int, acc: String): String =
  if (i >= Str.len(s)) acc else escapeInterpAtCont(s, i, acc, Str.charAt(s, i))

def escapeInterpAtCont(s: String, i: Int, acc: String, c: Int): String =
  if (c == 92) escapeInterpAt(s, i + 1, Str.concat(acc, "\\\\")) else if (c == 34) escapeInterpAt(s, i + 1, Str.concat(acc, "\\\"")) else if (c == 36) escapeInterpAt(s, i + 1, Str.concat(acc, "\\$")) else if (c == 10) escapeInterpAt(s, i + 1, Str.concat(acc, "\\n")) else if (c == 9) escapeInterpAt(s, i + 1, Str.concat(acc, "\\t")) else if (c == 13) escapeInterpAt(s, i + 1, Str.concat(acc, "\\r")) else escapeInterpAt(s, i + 1, Str.concat(acc, Str.slice(s, i, i + 1)))

def escapeInterpLit(s: String): String =
  escapeInterpAt(s, 0, "")

def padOf(indent: Int): String =
  if (indent <= 0) "" else Str.concat("  ", padOf(indent - 1))

def formatSource(source: String): String =
  prettyProg(parseSource("", source))

def prettyProg(p: Prog): String =
  prettyProgParts(progPkg(p), progEnums(p), progTraits(p), progImpls(p), progImports(p), progDefs(p), progMain(p))

def prettyProgParts(pkg: String, enums: List, traits: List, impls: List, imports: List, defs: List, main: Expr): String =
  for {
    head = prettyPkg(pkg)
    mid = Str.concat(prettyEnums(enums, ""), Str.concat(prettyTraits(traits, ""), Str.concat(prettyImpls(impls, ""), Str.concat(prettyImports(imports, ""), prettyDefs(defs, "")))))
  } yield if (isUnitExpr(main) == 1) Str.concat(head, mid) else str4(head, mid, "@main def main: IO[Unit] =\n", Str.concat(prettyExpr(main, 1), "\n"))

def prettyPkg(pkg: String): String =
  if (Str.len(pkg) == 0) "" else str3("package ", pkg, "\n\n")

def prettyImports(imports: List, acc: String): String =
  if (List.isEmpty(imports) == 1) if (Str.len(acc) == 0) acc else Str.concat(acc, "\n") else prettyImports(List.tail(imports), Str.concat(acc, prettyImport(List.head(imports))))

def prettyImport(im: Import): String =
  str4("import ", importFromModule(im), ".", Str.concat(importName(im), "\n"))

def prettyEnums(enums: List, acc: String): String =
  if (List.isEmpty(enums) == 1) acc else prettyEnums(List.tail(enums), Str.concat(acc, Str.concat(prettyEnum(List.head(enums)), "\n")))

def prettyTraits(traits: List, acc: String): String =
  if (List.isEmpty(traits) == 1) acc else prettyTraits(List.tail(traits), Str.concat(acc, Str.concat(prettyTrait(List.head(traits)), "\n")))

def prettyTrait(t: TraitDef): String =
  t match {
    case TraitDef.Trait(module, name, methods) => str4("trait ", name, ":\n", prettyTraitMethods(methods, ""))
  }

def prettyTraitMethods(methods: List, acc: String): String =
  if (List.isEmpty(methods) == 1) acc else prettyTraitMethods(List.tail(methods), Str.concat(acc, prettyTraitMethod(List.head(methods))))

def prettyTraitMethod(m: TraitMethod): String =
  m match {
    case TraitMethod.Method(name, params, ret) => for {
  ps = prettyParams(params, "")
} yield str3("  def ", name, str3("(", ps, str3("): ", tyPretty(ret), "\n")))
  }

def prettyImpls(impls: List, acc: String): String =
  if (List.isEmpty(impls) == 1) acc else prettyImpls(List.tail(impls), Str.concat(acc, Str.concat(prettyImpl(List.head(impls)), "\n")))

def prettyImpl(im: ImplDef): String =
  im match {
    case ImplDef.Impl(module, traitName, forType, methods) => for {
  body = prettyImplMethods(methods, "")
} yield str3("impl ", traitName, str3(" for ", forType, str3(":\n", body, "")))
  }

def prettyImplMethods(methods: List, acc: String): String =
  if (List.isEmpty(methods) == 1) acc else prettyImplMethods(List.tail(methods), Str.concat(acc, prettyImplMethod(List.head(methods))))

def prettyImplMethod(m: ImplMethod): String =
  m match {
    case ImplMethod.Method(name, params, ret, body) => for {
  ps = prettyParams(params, "")
  bd = prettyExpr(body, 2)
} yield str3("  def ", name, str3("(", ps, str3("): ", tyPretty(ret), str3(" =\n", bd, "\n"))))
  }

def prettyEnum(e: EnumDef): String =
  if (enumIsRecord(e) == 1) prettyRecord(e) else str4("enum ", Str.concat(enumName(e), prettyTypeParams(enumTParams(e))), ":\n", prettyEnumCases(enumCases(e), ""))

def prettyRecord(e: EnumDef): String =
  for {
    fields = caseFields(List.head(enumCases(e)))
  } yield str4("record ", Str.concat(enumName(e), prettyTypeParams(enumTParams(e))), "(", str3(prettyEnumFields(fields, ""), ")\n", ""))

def prettyEnumCases(cases: List, acc: String): String =
  if (List.isEmpty(cases) == 1) acc else prettyEnumCases(List.tail(cases), Str.concat(acc, prettyEnumCase(List.head(cases))))

def prettyEnumCase(c: EnumCase): String =
  for {
    fields = caseFields(c)
  } yield if (List.isEmpty(fields) == 1) str4("  case ", caseName(c), "\n", "") else str5("  case ", caseName(c), "(", prettyEnumFields(fields, ""), ")\n")

def prettyEnumFields(fields: List, acc: String): String =
  if (List.isEmpty(fields) == 1) acc else prettyEnumFieldsCont(List.head(fields), List.tail(fields), acc)

def prettyEnumFieldsCont(f: EnumField, rest: List, acc: String): String =
  for {
    one = str3(fieldName(f), ": ", tyPretty(fieldType(f)))
    acc2 = if (Str.len(acc) == 0) one else str3(acc, ", ", one)
  } yield prettyEnumFields(rest, acc2)

def prettyDefs(defs: List, acc: String): String =
  if (List.isEmpty(defs) == 1) acc else prettyDefs(List.tail(defs), Str.concat(acc, Str.concat(prettyDef(List.head(defs)), "\n\n")))

def prettyDef(d: Def): String =
  for {
    head = if (defIsPrivate(d) == 1) "private def " else "def "
    tparams = prettyTypeParams(defTypeParams(d))
  } yield str5(head, defName(d), str4(tparams, "(", prettyParams(defParams(d), ""), "): "), tyPretty(defRet(d)), str3(" =\n", prettyExpr(defBody(d), 1), ""))

def prettyTypeParams(tparams: List): String =
  if (List.isEmpty(tparams) == 1) "" else str3("[", prettyTypeParamList(tparams, ""), "]")

def prettyTypeParamList(tparams: List, acc: String): String =
  if (List.isEmpty(tparams) == 1) acc else prettyTypeParamListCont(List.head(tparams), List.tail(tparams), acc)

def prettyTypeParamListCont(name: String, rest: List, acc: String): String =
  for {
    acc2 = if (Str.len(acc) == 0) name else str3(acc, ", ", name)
  } yield prettyTypeParamList(rest, acc2)

def prettyParams(params: List, acc: String): String =
  if (List.isEmpty(params) == 1) acc else prettyParamsCont(List.head(params), List.tail(params), acc)

def prettyParamsCont(p: Param, rest: List, acc: String): String =
  for {
    piece = str3(paramName(p), ": ", tyPretty(paramType(p)))
  } yield if (Str.len(acc) == 0) prettyParams(rest, piece) else prettyParams(rest, str3(acc, ", ", piece))

def prettyExpr(expr: Expr, indent: Int): String =
  for {
    pad = padOf(indent)
  } yield prettyExprMatch(expr, indent, pad)

def prettyExprMatch(expr: Expr, indent: Int, pad: String): String =
  expr match {
    case Expr.Unit(span) => Str.concat(pad, "()")
    case Expr.IntLit(digits, span) => Str.concat(pad, digits)
    case Expr.StrLit(value, span) => str4(pad, "\"", escape(value), "\"")
    case Expr.ListLit(elems, span) => str4(pad, "[", prettyExprList(elems, ""), "]")
    case Expr.Interp(parts, span) => str4(pad, "s\"", prettyInterpParts(parts, ""), "\"")
    case Expr.Println(arg, span) => str4(pad, "IO.println(", trimStr(prettyExpr(arg, 0)), ")")
    case Expr.Delay(span) => Str.concat(pad, "IO.delay(() => ())")
    case Expr.Sleep(arg, span) => str4(pad, "IO.sleep(", trimStr(prettyExpr(arg, 0)), ")")
    case Expr.Fail(arg, span) => str4(pad, "IO.fail(", trimStr(prettyExpr(arg, 0)), ")")
    case Expr.Pure(arg, span) => str4(pad, "IO.pure(", trimStr(prettyExpr(arg, 0)), ")")
    case Expr.Var(name, span) => Str.concat(pad, name)
    case Expr.Field(base, field, span) => str3(pad, trimStr(prettyExpr(base, 0)), str3(".", field, ""))
    case Expr.MethodCall(receiver, method, args, span) => str3(pad, trimStr(prettyExpr(receiver, 0)), str3(".", method, str3("(", prettyExprList(args, ""), ")")))
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => prettyAdt(enumName, caseName, args, pad)
    case Expr.Lambda(param, body, span) => str4(pad, param, " => ", trimStr(prettyExpr(body, 0)))
    case Expr.Call(callee, args, span) => str4(pad, callee, str3("(", prettyExprList(args, ""), ")"), "")
    case Expr.If(cond, thenB, elseB, span) => prettyIf(cond, thenB, elseB, indent, pad)
    case Expr.BinOp(op, left, right, span) => str4(pad, trimStr(prettyExpr(left, 0)), str3(" ", op, " "), trimStr(prettyExpr(right, 0)))
    case Expr.FlatMap(inner, param, body, span) => prettyFlatMap(inner, param, body, indent, pad)
    case Expr.Handle(inner, body, span) => prettyHandle(inner, body, indent, pad)
    case Expr.Attempt(inner, span) => str3(pad, trimStr(prettyExpr(inner, 0)), ".attempt")
    case Expr.IoRace(left, right, span) => str4(pad, "IO.race(", str3(trimStr(prettyExpr(left, 0)), ", ", trimStr(prettyExpr(right, 0))), ")")
    case Expr.IoBoth(left, right, span) => str4(pad, "IO.both(", str3(trimStr(prettyExpr(left, 0)), ", ", trimStr(prettyExpr(right, 0))), ")")
    case Expr.Let(name, value, body, span) => prettyFor(List.cons(ForBinder.Eq(name, value), List.empty()), body, indent, pad)
    case Expr.For(binders, body, span) => prettyFor(binders, body, indent, pad)
    case Expr.Match(scrut, arms, span) => prettyMatch(scrut, arms, indent, pad)
  }

def prettyAdt(enumName: String, caseName: String, args: List, pad: String): String =
  for {
    bare = enumBareFromId(enumName)
  } yield if (streq(bare, caseName) == 1) prettyAdtRecord(bare, args, pad) else prettyAdtEnum(bare, caseName, args, pad)

def prettyAdtRecord(bare: String, args: List, pad: String): String =
  if (List.isEmpty(args) == 1) Str.concat(pad, bare) else str4(pad, bare, str3("(", prettyExprList(args, ""), ")"), "")

def prettyAdtEnum(bare: String, caseName: String, args: List, pad: String): String =
  for {
    base = str3(bare, ".", caseName)
  } yield if (List.isEmpty(args) == 1) Str.concat(pad, base) else str4(pad, base, str3("(", prettyExprList(args, ""), ")"), "")

def prettyFor(binders: List, body: Expr, indent: Int, pad: String): String =
  str4(pad, "for {\n", prettyForBinders(binders, indent + 1, ""), str3(pad, "} yield ", trimStr(prettyExpr(body, 0))))

def prettyForBinders(binders: List, indent: Int, acc: String): String =
  if (List.isEmpty(binders) == 1) acc else prettyForBinders(List.tail(binders), indent, Str.concat(acc, prettyForBinder(List.head(binders), indent)))

def prettyForBinder(b: ForBinder, indent: Int): String =
  b match {
    case ForBinder.Eq(name, value) => str4(padOf(indent), name, " = ", str3(trimStr(prettyExpr(value, 0)), "\n", ""))
    case ForBinder.Draw(name, value) => str4(padOf(indent), name, " <- ", str3(trimStr(prettyExpr(value, 0)), "\n", ""))
  }

def prettyIf(cond: Expr, thenB: Expr, elseB: Expr, indent: Int, pad: String): String =
  str4(pad, str4("if (", trimStr(prettyExpr(cond, 0)), ") ", trimStr(prettyExpr(thenB, 0))), " else ", trimStr(prettyExpr(elseB, 0)))

def prettyFlatMap(inner: Expr, param: String, body: Expr, indent: Int, pad: String): String =
  for {
    left = trimStr(prettyExpr(inner, 0))
    right = prettyExpr(body, indent + 1)
  } yield if (isLetExpr(body) == 1) prettyFlatMapMulti(pad, left, param, right) else if (isMatchExpr(body) == 1) prettyFlatMapMulti(pad, left, param, right) else if (isFlatMapExpr(body) == 1) prettyFlatMapMulti(pad, left, param, right) else if (strHasChar(right, 10, 0) == 1) prettyFlatMapMulti(pad, left, param, right) else str4(pad, left, str4(".flatMap(", param, " => ", trimStr(right)), ")")

def prettyFlatMapMulti(pad: String, left: String, p: String, right: String): String =
  str4(pad, left, str4(".flatMap(", p, " =>\n", right), str3("\n", pad, ")"))

def prettyHandle(inner: Expr, body: Expr, indent: Int, pad: String): String =
  for {
    left = trimStr(prettyExpr(inner, 0))
    right = prettyExpr(body, indent + 1)
  } yield str4(pad, left, str3(".handleErrorWith(_ =>\n", right, "\n"), str3(pad, ")", ""))

def prettyMatch(scrut: Expr, arms: List, indent: Int, pad: String): String =
  str4(pad, trimStr(prettyExpr(scrut, 0)), " match {\n", Str.concat(prettyArms(arms, indent + 1, ""), Str.concat(pad, "}")))

def prettyArms(arms: List, indent: Int, acc: String): String =
  if (List.isEmpty(arms) == 1) acc else prettyArms(List.tail(arms), indent, Str.concat(acc, Str.concat(prettyArm(List.head(arms), indent), "\n")))

def prettyArm(arm: MatchArm, indent: Int): String =
  arm match {
    case MatchArm.Arm(pat, body) => str4(padOf(indent), "case ", prettyPat(pat), str3(" => ", trimStr(prettyExpr(body, 0)), ""))
  }

def prettyPat(pat: Pattern): String =
  pat match {
    case Pattern.Wild => "_"
    case Pattern.Adt(enumName, caseName, binds, typeArgs) => prettyPatAdt(enumName, caseName, binds)
  }

def prettyPatAdt(enumName: String, caseName: String, binds: List): String =
  for {
    bare = enumBareFromId(enumName)
  } yield if (streq(bare, caseName) == 1) prettyPatRecord(bare, binds) else prettyPatEnum(bare, caseName, binds)

def prettyPatRecord(bare: String, binds: List): String =
  if (List.isEmpty(binds) == 1) bare else str4(bare, "(", prettyBindList(binds, ""), ")")

def prettyPatEnum(bare: String, caseName: String, binds: List): String =
  for {
    base = str3(bare, ".", caseName)
  } yield if (List.isEmpty(binds) == 1) base else str4(base, "(", prettyBindList(binds, ""), ")")

def enumBareFromId(id: String): String =
  for {
    parts = splitDotted(id)
  } yield if (List.isEmpty(parts) == 1) id else List.head(List.tail(parts))

def prettyBindList(binds: List, acc: String): String =
  if (List.isEmpty(binds) == 1) acc else prettyBindListCont(List.head(binds), List.tail(binds), acc)

def prettyBindListCont(b: String, rest: List, acc: String): String =
  for {
    acc2 = if (Str.len(acc) == 0) b else str3(acc, ", ", b)
  } yield prettyBindList(rest, acc2)

def prettyExprList(xs: List, acc: String): String =
  if (List.isEmpty(xs) == 1) acc else prettyExprListCont(List.head(xs), List.tail(xs), acc)

def prettyExprListCont(e: Expr, rest: List, acc: String): String =
  for {
    piece = trimStr(prettyExpr(e, 0))
  } yield if (Str.len(acc) == 0) prettyExprList(rest, piece) else prettyExprList(rest, str3(acc, ", ", piece))

def prettyInterpParts(parts: List, acc: String): String =
  if (List.isEmpty(parts) == 1) acc else prettyInterpParts(List.tail(parts), Str.concat(acc, prettyInterpPart(List.head(parts))))

def prettyInterpPart(part: InterpPart): String =
  part match {
    case InterpPart.Lit(text) => escapeInterpLit(text)
    case InterpPart.Hole(expr) => prettyInterpHole(expr)
  }

def prettyInterpHole(e: Expr): String =
  if (isVarExpr(e) == 1) Str.concat("$", varExprName(e)) else str3("${", trimStr(prettyExpr(e, 0)), "}")

