package scuzz.compiler

def lowerProg(prog: Prog): Prog =
  for {
    enums = progEnums(prog)
    imports = progImports(prog)
    mainMod = progMainModule(prog)
    enums2 = lowerEnums(enums, enums, imports, List.empty())
  } yield Prog.Prog(progPkg(prog), enums2, lowerDefs(progDefs(prog), enums2, imports, List.empty()), lowerExpr(progMain(prog), enums2, imports, mainMod), mainMod, imports, progTraits(prog), lowerImpls(progImpls(prog), enums2, imports, List.empty()))

def lowerEnums(enums: List, all: List, imports: List, acc: List): List =
  if (List.isEmpty(enums) == 1) List.reverse(acc) else lowerEnums(List.tail(enums), all, imports, List.cons(lowerEnum(List.head(enums), all, imports), acc))

def lowerEnum(e: EnumDef, enums: List, imports: List): EnumDef =
  e match {
    case EnumDef.Enum(module, name, cases, tparams, methods) => EnumDef.Enum(module, name, cases, tparams, lowerImplMethods(methods, enums, imports, module, List.empty()))
    case EnumDef.Record(module, name, fields, tparams, methods) => EnumDef.Record(module, name, fields, tparams, lowerImplMethods(methods, enums, imports, module, List.empty()))
  }

def lowerImpls(impls: List, enums: List, imports: List, acc: List): List =
  if (List.isEmpty(impls) == 1) List.reverse(acc) else lowerImpls(List.tail(impls), enums, imports, List.cons(lowerImpl(List.head(impls), enums, imports), acc))

def lowerImpl(im: ImplDef, enums: List, imports: List): ImplDef =
  im match {
    case ImplDef.Impl(module, traitName, traitArgs, forType, methods) => ImplDef.Impl(module, traitName, traitArgs, forType, lowerImplMethods(methods, enums, imports, module, List.empty()))
  }

def lowerImplMethods(methods: List, enums: List, imports: List, mod: String, acc: List): List =
  if (List.isEmpty(methods) == 1) List.reverse(acc) else lowerImplMethods(List.tail(methods), enums, imports, mod, List.cons(lowerImplMethod(List.head(methods), enums, imports, mod), acc))

def lowerImplMethod(m: ImplMethod, enums: List, imports: List, mod: String): ImplMethod =
  m match {
    case ImplMethod.Method(name, params, ret, body) => ImplMethod.Method(name, params, ret, lowerExpr(body, enums, imports, mod))
  }

def splitDotted(s: String): List =
  for {
    d = indexOfChar(s, 46, 0)
  } yield if (d <= 0) List.empty() else if (indexOfChar(s, 46, d + 1) >= 0) List.empty() else if (d + 1 >= Str.len(s)) List.empty() else List.cons(Str.slice(s, 0, d), List.cons(Str.slice(s, d + 1, Str.len(s)), List.empty()))

def findEnumByQual(enums: List, module: String, name: String): List =
  if (List.isEmpty(enums) == 1) List.empty() else if (streq(enumModule(List.head(enums)), module) == 1) if (streq(enumName(List.head(enums)), name) == 1) enumHit(List.head(enums)) else findEnumByQual(List.tail(enums), module, name) else findEnumByQual(List.tail(enums), module, name)

def findEnumById(enums: List, id: String): List =
  if (List.isEmpty(enums) == 1) List.empty() else if (streq(enumId(List.head(enums)), id) == 1) enumHit(List.head(enums)) else findEnumById(List.tail(enums), id)

def collectEnumsByName(enums: List, name: String, acc: List): List =
  if (List.isEmpty(enums) == 1) List.reverse(acc) else if (streq(enumName(List.head(enums)), name) == 1) collectEnumsByName(List.tail(enums), name, List.cons(List.head(enums), acc)) else collectEnumsByName(List.tail(enums), name, acc)

def resolveEnum(enums: List, imports: List, name: String, currentModule: String): List =
  for {
    parts = splitDotted(name)
  } yield if (List.isEmpty(parts) == 0) findEnumByQual(enums, List.head(parts), List.head(List.tail(parts))) else resolveEnumBare(enums, imports, name, currentModule)

def resolveEnumBare(enums: List, imports: List, name: String, currentModule: String): List =
  for {
    local = findEnumByQual(enums, currentModule, name)
  } yield if (List.isEmpty(local) == 0) local else resolveEnumImport(enums, imports, name, currentModule)

def resolveEnumImport(enums: List, imports: List, name: String, currentModule: String): List =
  for {
    hit = findImport(imports, currentModule, name)
  } yield if (List.isEmpty(hit) == 0) findEnumByQual(enums, importFromModule(List.head(hit)), name) else resolveEnumUnique(enums, name)

def resolveEnumUnique(enums: List, name: String): List =
  for {
    all = collectEnumsByName(enums, name, List.empty())
  } yield if (List.len(all) == 1) enumHit(List.head(all)) else List.empty()

def resolveCtorId(enums: List, imports: List, enumName: String, caseName: String, currentModule: String): String =
  for {
    e = resolveEnum(enums, imports, enumName, currentModule)
  } yield if (List.isEmpty(e) == 1) "" else if (enumHasCase(enumCases(List.head(e)), caseName) == 0) "" else enumId(List.head(e))

def lowerDefs(defs: List, enums: List, imports: List, acc: List): List =
  if (List.isEmpty(defs) == 1) List.reverse(acc) else lowerDefs(List.tail(defs), enums, imports, List.cons(lowerDef(List.head(defs), enums, imports), acc))

def lowerDef(d: Def, enums: List, imports: List): Def =
  d match {
    case Def(name, params, ret, body, module, isPrivate, typeParams, isLaw) => Def.Def(name, params, ret, lowerExpr(body, enums, imports, module), module, isPrivate, typeParams, isLaw)
  }

def lowerExpr(e: Expr, enums: List, imports: List, mod: String): Expr =
  e match {
    case Expr.For(binders, body, span) => desugarFor(binders, lowerExpr(body, enums, imports, mod), span, enums, imports, mod)
    case Expr.Let(name, value, body, span) => Expr.Let(name, lowerExpr(value, enums, imports, mod), lowerExpr(body, enums, imports, mod), span)
    case Expr.FlatMap(inner, param, body, span) => Expr.FlatMap(lowerExpr(inner, enums, imports, mod), param, lowerExpr(body, enums, imports, mod), span)
    case Expr.Handle(inner, body, span) => Expr.Handle(lowerExpr(inner, enums, imports, mod), lowerExpr(body, enums, imports, mod), span)
    case Expr.Attempt(inner, span) => Expr.Attempt(lowerExpr(inner, enums, imports, mod), span)
    case Expr.If(cond, thenB, elseB, span) => Expr.If(lowerExpr(cond, enums, imports, mod), lowerExpr(thenB, enums, imports, mod), lowerExpr(elseB, enums, imports, mod), span)
    case Expr.BinOp(op, left, right, span) => Expr.BinOp(op, lowerExpr(left, enums, imports, mod), lowerExpr(right, enums, imports, mod), span)
    case Expr.Call(callee, args, span) => lowerCall(callee, lowerExprList(args, enums, imports, mod, List.empty()), span, enums, imports, mod)
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => lowerAdt(enumName, caseName, lowerExprList(args, enums, imports, mod, List.empty()), typeArgs, span, enums, imports, mod)
    case Expr.Lambda(param, body, span) => Expr.Lambda(param, lowerExpr(body, enums, imports, mod), span)
    case Expr.Match(scrut, arms, span) => Expr.Match(lowerExpr(scrut, enums, imports, mod), lowerArms(arms, enums, imports, mod, List.empty()), span)
    case Expr.Println(arg, span) => Expr.Println(lowerExpr(arg, enums, imports, mod), span)
    case Expr.Fail(arg, span) => Expr.Fail(lowerExpr(arg, enums, imports, mod), span)
    case Expr.Pure(arg, span) => Expr.Pure(lowerExpr(arg, enums, imports, mod), span)
    case Expr.Sleep(arg, span) => Expr.Sleep(lowerExpr(arg, enums, imports, mod), span)
    case Expr.IoRace(left, right, span) => Expr.IoRace(lowerExpr(left, enums, imports, mod), lowerExpr(right, enums, imports, mod), span)
    case Expr.IoBoth(left, right, span) => Expr.IoBoth(lowerExpr(left, enums, imports, mod), lowerExpr(right, enums, imports, mod), span)
    case Expr.IoEnsure(inner, finalizer, span) => Expr.IoEnsure(lowerExpr(inner, enums, imports, mod), lowerExpr(finalizer, enums, imports, mod), span)
    case Expr.IoTimeout(ms, inner, span) => Expr.IoTimeout(lowerExpr(ms, enums, imports, mod), lowerExpr(inner, enums, imports, mod), span)
    case Expr.ListLit(elems, span) => Expr.ListLit(lowerExprList(elems, enums, imports, mod, List.empty()), span)
    case Expr.Interp(parts, span) => Expr.Interp(lowerInterpParts(parts, enums, imports, mod, List.empty()), span)
    case Expr.Unit(span) => e
    case Expr.IntLit(digits, span) => e
    case Expr.StrLit(value, span) => e
    case Expr.Var(name, span) => e
    case Expr.Field(base, field, span) => Expr.Field(lowerExpr(base, enums, imports, mod), field, span)
    case Expr.MethodCall(receiver, method, args, span) => Expr.MethodCall(lowerExpr(receiver, enums, imports, mod), method, lowerExprList(args, enums, imports, mod, List.empty()), span)
  }

def lowerCall(callee: String, args: List, sp: Span, enums: List, imports: List, mod: String): Expr =
  for {
    parts = splitDotted(callee)
  } yield if (List.isEmpty(parts) == 1) lowerCallBare(callee, args, sp, enums, imports, mod) else lowerCallDotted(List.head(parts), List.head(List.tail(parts)), args, sp, enums, imports, mod)

def lowerCallBare(callee: String, args: List, sp: Span, enums: List, imports: List, mod: String): Expr =
  for {
    id = resolveRecordCtorId(enums, imports, callee, List.len(args), mod)
  } yield if (Str.len(id) == 0) Expr.Call(callee, args, sp) else Expr.Adt(id, callee, args, List.empty(), sp)

def lowerCallDotted(en: String, cn: String, args: List, sp: Span, enums: List, imports: List, mod: String): Expr =
  for {
    id = resolveCtorId(enums, imports, en, cn, mod)
  } yield if (Str.len(id) == 0) Expr.Call(str3(en, ".", cn), args, sp) else Expr.Adt(id, cn, args, List.empty(), sp)

def resolveRecordCtorId(enums: List, imports: List, name: String, arity: Int, currentModule: String): String =
  for {
    e = resolveEnum(enums, imports, name, currentModule)
  } yield if (List.isEmpty(e) == 1) "" else if (enumIsRecord(List.head(e)) == 0) "" else if (List.len(caseFields(List.head(enumCases(List.head(e))))) == arity) enumId(List.head(e)) else ""

def lowerAdt(en: String, cn: String, args: List, typeArgs: List, sp: Span, enums: List, imports: List, mod: String): Expr =
  for {
    id = resolveCtorId(enums, imports, en, cn, mod)
  } yield if (Str.len(id) == 0) if (List.isEmpty(args) == 1) Expr.Call(str3(en, ".", cn), args, sp) else Expr.Adt(en, cn, args, typeArgs, sp) else Expr.Adt(id, cn, args, typeArgs, sp)

def lowerExprList(xs: List, enums: List, imports: List, mod: String, acc: List): List =
  if (List.isEmpty(xs) == 1) List.reverse(acc) else lowerExprList(List.tail(xs), enums, imports, mod, List.cons(lowerExpr(List.head(xs), enums, imports, mod), acc))

def lowerArms(arms: List, enums: List, imports: List, mod: String, acc: List): List =
  if (List.isEmpty(arms) == 1) List.reverse(acc) else lowerArms(List.tail(arms), enums, imports, mod, List.cons(lowerArm(List.head(arms), enums, imports, mod), acc))

def lowerArm(arm: MatchArm, enums: List, imports: List, mod: String): MatchArm =
  arm match {
    case MatchArm.Arm(pat, body) => MatchArm.Arm(lowerPat(pat, enums, imports, mod), lowerExpr(body, enums, imports, mod))
  }

def lowerPat(pat: Pattern, enums: List, imports: List, mod: String): Pattern =
  pat match {
    case Pattern.Wild => Pattern.Wild
    case Pattern.Adt(enumName, caseName, binds, typeArgs) => lowerPatAdt(enumName, caseName, binds, enums, imports, mod)
  }

def lowerPatAdt(en: String, cn: String, binds: List, enums: List, imports: List, mod: String): Pattern =
  for {
    id = resolveCtorId(enums, imports, en, cn, mod)
  } yield if (Str.len(id) == 0) Pattern.Adt(en, cn, binds, List.empty()) else Pattern.Adt(id, cn, binds, List.empty())

def lowerInterpParts(parts: List, enums: List, imports: List, mod: String, acc: List): List =
  if (List.isEmpty(parts) == 1) List.reverse(acc) else lowerInterpParts(List.tail(parts), enums, imports, mod, List.cons(lowerInterpPart(List.head(parts), enums, imports, mod), acc))

def lowerInterpPart(part: InterpPart, enums: List, imports: List, mod: String): InterpPart =
  part match {
    case InterpPart.Lit(text) => InterpPart.Lit(text)
    case InterpPart.Hole(expr) => InterpPart.Hole(lowerExpr(expr, enums, imports, mod))
  }

def forBindersHaveDraw(binders: List): Int =
  if (List.isEmpty(binders) == 1) 0 else forBinderIsDraw(List.head(binders), List.tail(binders))

def forBinderIsDraw(b: ForBinder, rest: List): Int =
  b match {
    case ForBinder.Eq(name, value) => forBindersHaveDraw(rest)
    case ForBinder.Draw(name, value) => 1
  }

def desugarFor(binders: List, body: Expr, sp: Span, enums: List, imports: List, mod: String): Expr =
  if (forBindersHaveDraw(binders) == 1) desugarForBinders(binders, Expr.Pure(body, sp), enums, imports, mod) else desugarForBinders(binders, body, enums, imports, mod)

def desugarForBinders(binders: List, body: Expr, enums: List, imports: List, mod: String): Expr =
  if (List.isEmpty(binders) == 1) body else wrapForBinder(List.head(binders), desugarForBinders(List.tail(binders), body, enums, imports, mod), enums, imports, mod)

def wrapForBinder(b: ForBinder, body: Expr, enums: List, imports: List, mod: String): Expr =
  b match {
    case ForBinder.Eq(name, value) => wrapForBinderEq(name, lowerExpr(value, enums, imports, mod), body)
    case ForBinder.Draw(name, value) => wrapForBinderDraw(name, lowerExpr(value, enums, imports, mod), body)
  }

def wrapForBinderEq(name: String, value: Expr, body: Expr): Expr =
  Expr.Let(name, value, body, coverSpan(exprSpan(value), exprSpan(body)))

def wrapForBinderDraw(name: String, value: Expr, body: Expr): Expr =
  Expr.FlatMap(value, name, body, coverSpan(exprSpan(value), exprSpan(body)))

