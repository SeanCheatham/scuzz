package scuzz.compiler

def lowerProg(prog: Prog): Prog =
  for {
    ctors = enumCtors(progEnums(prog), List.empty())
  } yield Prog.Prog(progPkg(prog), progEnums(prog), lowerDefs(progDefs(prog), ctors, List.empty()), lowerExpr(progMain(prog), ctors), progMainModule(prog))

def enumCtors(enums: List, acc: List): List =
  if (List.isEmpty(enums) == 1) acc else enumCtors(List.tail(enums), enumCtorsOne(List.head(enums), acc))

def enumCtorsOne(e: EnumDef, acc: List): List =
  enumCtorsCases(enumName(e), enumCases(e), acc)

def enumCtorsCases(en: String, cases: List, acc: List): List =
  if (List.isEmpty(cases) == 1) acc else enumCtorsCases(en, List.tail(cases), List.cons(str3(en, ".", caseName(List.head(cases))), acc))

def ctorKnown(ctors: List, key: String): Int =
  if (List.isEmpty(ctors) == 1) 0 else if (streq(List.head(ctors), key) == 1) 1 else ctorKnown(List.tail(ctors), key)

def splitDotted(s: String): List =
  for {
    d = indexOfChar(s, 46, 0)
  } yield if (d <= 0) List.empty() else if (indexOfChar(s, 46, d + 1) >= 0) List.empty() else if (d + 1 >= Str.len(s)) List.empty() else List.cons(Str.slice(s, 0, d), List.cons(Str.slice(s, d + 1, Str.len(s)), List.empty()))

def lowerDefs(defs: List, ctors: List, acc: List): List =
  if (List.isEmpty(defs) == 1) List.reverse(acc) else lowerDefs(List.tail(defs), ctors, List.cons(lowerDef(List.head(defs), ctors), acc))

def lowerDef(d: Def, ctors: List): Def =
  d match {
    case Def.Def(name, params, ret, body, module, isPrivate) => Def.Def(name, params, ret, lowerExpr(body, ctors), module, isPrivate)
  }

def lowerExpr(e: Expr, ctors: List): Expr =
  e match {
    case Expr.For(binders, body, span) => desugarFor(binders, lowerExpr(body, ctors), span, ctors)
    case Expr.Let(name, value, body, span) => Expr.Let(name, lowerExpr(value, ctors), lowerExpr(body, ctors), span)
    case Expr.FlatMap(inner, param, body, span) => Expr.FlatMap(lowerExpr(inner, ctors), param, lowerExpr(body, ctors), span)
    case Expr.Handle(inner, body, span) => Expr.Handle(lowerExpr(inner, ctors), lowerExpr(body, ctors), span)
    case Expr.Attempt(inner, span) => Expr.Attempt(lowerExpr(inner, ctors), span)
    case Expr.If(cond, thenB, elseB, span) => Expr.If(lowerExpr(cond, ctors), lowerExpr(thenB, ctors), lowerExpr(elseB, ctors), span)
    case Expr.BinOp(op, left, right, span) => Expr.BinOp(op, lowerExpr(left, ctors), lowerExpr(right, ctors), span)
    case Expr.Call(callee, args, span) => lowerCall(callee, lowerExprList(args, ctors, List.empty()), span, ctors)
    case Expr.Adt(enumName, caseName, args, span) => Expr.Adt(enumName, caseName, lowerExprList(args, ctors, List.empty()), span)
    case Expr.Lambda(param, body, span) => Expr.Lambda(param, lowerExpr(body, ctors), span)
    case Expr.Match(scrut, arms, span) => Expr.Match(lowerExpr(scrut, ctors), lowerArms(arms, ctors, List.empty()), span)
    case Expr.Println(arg, span) => Expr.Println(lowerExpr(arg, ctors), span)
    case Expr.Fail(arg, span) => Expr.Fail(lowerExpr(arg, ctors), span)
    case Expr.Pure(arg, span) => Expr.Pure(lowerExpr(arg, ctors), span)
    case Expr.Sleep(arg, span) => Expr.Sleep(lowerExpr(arg, ctors), span)
    case Expr.IoRace(left, right, span) => Expr.IoRace(lowerExpr(left, ctors), lowerExpr(right, ctors), span)
    case Expr.IoBoth(left, right, span) => Expr.IoBoth(lowerExpr(left, ctors), lowerExpr(right, ctors), span)
    case Expr.ListLit(elems, span) => Expr.ListLit(lowerExprList(elems, ctors, List.empty()), span)
    case Expr.Interp(parts, span) => Expr.Interp(lowerInterpParts(parts, ctors, List.empty()), span)
    case Expr.Unit(span) => e
    case Expr.IntLit(digits, span) => e
    case Expr.StrLit(value, span) => e
    case Expr.Var(name, span) => e
    case Expr.Delay(span) => e
  }

def lowerCall(callee: String, args: List, sp: Span, ctors: List): Expr =
  for {
    parts = splitDotted(callee)
  } yield if (List.isEmpty(parts) == 1) Expr.Call(callee, args, sp) else if (ctorKnown(ctors, callee) == 1) Expr.Adt(List.head(parts), List.head(List.tail(parts)), args, sp) else Expr.Call(callee, args, sp)

def lowerExprList(xs: List, ctors: List, acc: List): List =
  if (List.isEmpty(xs) == 1) List.reverse(acc) else lowerExprList(List.tail(xs), ctors, List.cons(lowerExpr(List.head(xs), ctors), acc))

def lowerArms(arms: List, ctors: List, acc: List): List =
  if (List.isEmpty(arms) == 1) List.reverse(acc) else lowerArms(List.tail(arms), ctors, List.cons(lowerArm(List.head(arms), ctors), acc))

def lowerArm(arm: MatchArm, ctors: List): MatchArm =
  arm match {
    case MatchArm.Arm(pat, body) => MatchArm.Arm(pat, lowerExpr(body, ctors))
  }

def lowerInterpParts(parts: List, ctors: List, acc: List): List =
  if (List.isEmpty(parts) == 1) List.reverse(acc) else lowerInterpParts(List.tail(parts), ctors, List.cons(lowerInterpPart(List.head(parts), ctors), acc))

def lowerInterpPart(part: InterpPart, ctors: List): InterpPart =
  part match {
    case InterpPart.Lit(text) => InterpPart.Lit(text)
    case InterpPart.Hole(expr) => InterpPart.Hole(lowerExpr(expr, ctors))
  }

def forBindersHaveDraw(binders: List): Int =
  if (List.isEmpty(binders) == 1) 0 else forBinderIsDraw(List.head(binders), List.tail(binders))

def forBinderIsDraw(b: ForBinder, rest: List): Int =
  b match {
    case ForBinder.Eq(name, value) => forBindersHaveDraw(rest)
    case ForBinder.Draw(name, value) => 1
  }

def desugarFor(binders: List, body: Expr, sp: Span, ctors: List): Expr =
  if (forBindersHaveDraw(binders) == 1) desugarForBinders(binders, Expr.Pure(body, sp), ctors) else desugarForBinders(binders, body, ctors)

def desugarForBinders(binders: List, body: Expr, ctors: List): Expr =
  if (List.isEmpty(binders) == 1) body else wrapForBinder(List.head(binders), desugarForBinders(List.tail(binders), body, ctors), ctors)

def wrapForBinder(b: ForBinder, body: Expr, ctors: List): Expr =
  b match {
    case ForBinder.Eq(name, value) => wrapForBinderEq(name, lowerExpr(value, ctors), body)
    case ForBinder.Draw(name, value) => wrapForBinderDraw(name, lowerExpr(value, ctors), body)
  }

def wrapForBinderEq(name: String, value: Expr, body: Expr): Expr =
  Expr.Let(name, value, body, coverSpan(exprSpan(value), exprSpan(body)))

def wrapForBinderDraw(name: String, value: Expr, body: Expr): Expr =
  Expr.FlatMap(value, name, body, coverSpan(exprSpan(value), exprSpan(body)))

