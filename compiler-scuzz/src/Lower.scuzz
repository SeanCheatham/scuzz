package scuzz.compiler

def lowerProg(prog: List): List =
  for {
    ctors = enumCtors(progEnums(prog), List.empty())
  } yield List.cons("Prog", List.cons(nodeStr(prog, 0), List.cons(progEnums(prog), List.cons(lowerDefs(progDefs(prog), ctors, List.empty()), List.cons(lowerExpr(progMain(prog), ctors), List.cons(progMainModule(prog), List.empty()))))))

def enumCtors(enums: List, acc: List): List =
  if (List.isEmpty(enums) == 1) acc else enumCtors(List.tail(enums), enumCtorsOne(List.head(enums), acc))

def enumCtorsOne(e: List, acc: List): List =
  enumCtorsCases(enumName(e), enumCases(e), acc)

def enumCtorsCases(en: String, cases: List, acc: List): List =
  if (List.isEmpty(cases) == 1) acc else enumCtorsCases(en, List.tail(cases), List.cons(str3(en, ".", caseName(List.head(cases))), acc))

def ctorKnown(ctors: List, key: String): Int =
  if (List.isEmpty(ctors) == 1) 0 else if (streq(List.head(ctors), key) == 1) 1 else ctorKnown(List.tail(ctors), key)

def splitDotted(s: String): List =
  for {
    d = indexOfChar(s, 46, 0)
  } yield if (d <= 0) List.empty() else if (indexOfChar(s, 46, d + 1) >= 0) List.empty() else if (d + 1 >= Str.len(s)) List.empty() else List.cons(Str.slice(s, 0, d), List.cons(Str.slice(s, d + 1, Str.len(s)), List.empty()))

def lowerDefs(defs: List, ctors: List, acc: List): List =
  if (List.isEmpty(defs) == 1) List.reverse(acc) else lowerDefs(List.tail(defs), ctors, List.cons(lowerDef(List.head(defs), ctors), acc))

def lowerDef(d: List, ctors: List): List =
  List.cons("Def", List.cons(nodeStr(d, 0), List.cons(nodeExpr(d, 1), List.cons(nodeStr(d, 2), List.cons(lowerExpr(nodeExpr(d, 3), ctors), List.cons(nodeStr(d, 4), List.empty()))))))

def lowerExpr(e: List, ctors: List): List =
  lowerExprTag(exprTag(e), e, ctors)

def lowerExprTag(tag: String, e: List, ctors: List): List =
  if (streq(tag, "For") == 1) desugarFor(nodeExpr(e, 0), lowerExpr(nodeExpr(e, 1), ctors), exprSpan(e), ctors) else if (streq(tag, "Let") == 1) withSpan(List.cons("Let", List.cons(nodeStr(e, 0), List.cons(lowerExpr(nodeExpr(e, 1), ctors), List.cons(lowerExpr(nodeExpr(e, 2), ctors), List.empty())))), exprSpan(e)) else if (streq(tag, "FlatMap") == 1) withSpan(List.cons("FlatMap", List.cons(lowerExpr(nodeExpr(e, 0), ctors), List.cons(nodeStr(e, 1), List.cons(lowerExpr(nodeExpr(e, 2), ctors), List.empty())))), exprSpan(e)) else if (streq(tag, "Handle") == 1) withSpan(List.cons("Handle", List.cons(lowerExpr(nodeExpr(e, 0), ctors), List.cons(lowerExpr(nodeExpr(e, 1), ctors), List.empty()))), exprSpan(e)) else if (streq(tag, "Attempt") == 1) withSpan(List.cons("Attempt", List.cons(lowerExpr(nodeExpr(e, 0), ctors), List.empty())), exprSpan(e)) else if (streq(tag, "If") == 1) withSpan(List.cons("If", List.cons(lowerExpr(nodeExpr(e, 0), ctors), List.cons(lowerExpr(nodeExpr(e, 1), ctors), List.cons(lowerExpr(nodeExpr(e, 2), ctors), List.empty())))), exprSpan(e)) else if (streq(tag, "BinOp") == 1) withSpan(List.cons("BinOp", List.cons(nodeStr(e, 0), List.cons(lowerExpr(nodeExpr(e, 1), ctors), List.cons(lowerExpr(nodeExpr(e, 2), ctors), List.empty())))), exprSpan(e)) else if (streq(tag, "Call") == 1) lowerCall(nodeStr(e, 0), lowerExprList(nodeExpr(e, 1), ctors, List.empty()), exprSpan(e), ctors) else if (streq(tag, "Adt") == 1) withSpan(List.cons("Adt", List.cons(nodeStr(e, 0), List.cons(nodeStr(e, 1), List.cons(lowerExprList(nodeExpr(e, 2), ctors, List.empty()), List.empty())))), exprSpan(e)) else if (streq(tag, "Lambda") == 1) withSpan(List.cons("Lambda", List.cons(nodeStr(e, 0), List.cons(lowerExpr(nodeExpr(e, 1), ctors), List.empty()))), exprSpan(e)) else if (streq(tag, "Match") == 1) withSpan(List.cons("Match", List.cons(lowerExpr(nodeExpr(e, 0), ctors), List.cons(lowerArms(nodeExpr(e, 1), ctors, List.empty()), List.empty()))), exprSpan(e)) else if (streq(tag, "Println") == 1) withSpan(List.cons("Println", List.cons(lowerExpr(nodeExpr(e, 0), ctors), List.empty())), exprSpan(e)) else if (streq(tag, "Fail") == 1) withSpan(List.cons("Fail", List.cons(lowerExpr(nodeExpr(e, 0), ctors), List.empty())), exprSpan(e)) else if (streq(tag, "Pure") == 1) withSpan(List.cons("Pure", List.cons(lowerExpr(nodeExpr(e, 0), ctors), List.empty())), exprSpan(e)) else if (streq(tag, "Sleep") == 1) withSpan(List.cons("Sleep", List.cons(lowerExpr(nodeExpr(e, 0), ctors), List.empty())), exprSpan(e)) else if (streq(tag, "IoRace") == 1) withSpan(List.cons("IoRace", List.cons(lowerExpr(nodeExpr(e, 0), ctors), List.cons(lowerExpr(nodeExpr(e, 1), ctors), List.empty()))), exprSpan(e)) else if (streq(tag, "IoBoth") == 1) withSpan(List.cons("IoBoth", List.cons(lowerExpr(nodeExpr(e, 0), ctors), List.cons(lowerExpr(nodeExpr(e, 1), ctors), List.empty()))), exprSpan(e)) else if (streq(tag, "ListLit") == 1) withSpan(List.cons("ListLit", List.cons(lowerExprList(nodeExpr(e, 0), ctors, List.empty()), List.empty())), exprSpan(e)) else if (streq(tag, "Interp") == 1) withSpan(List.cons("Interp", List.cons(lowerInterpParts(nodeExpr(e, 0), ctors, List.empty()), List.empty())), exprSpan(e)) else e

def lowerCall(callee: String, args: List, sp: List, ctors: List): List =
  for {
    parts = splitDotted(callee)
  } yield if (List.isEmpty(parts) == 1) withSpan(List.cons("Call", List.cons(callee, List.cons(args, List.empty()))), sp) else if (ctorKnown(ctors, callee) == 1) withSpan(List.cons("Adt", List.cons(List.head(parts), List.cons(List.head(List.tail(parts)), List.cons(args, List.empty())))), sp) else withSpan(List.cons("Call", List.cons(callee, List.cons(args, List.empty()))), sp)

def lowerExprList(xs: List, ctors: List, acc: List): List =
  if (List.isEmpty(xs) == 1) List.reverse(acc) else lowerExprList(List.tail(xs), ctors, List.cons(lowerExpr(List.head(xs), ctors), acc))

def lowerArms(arms: List, ctors: List, acc: List): List =
  if (List.isEmpty(arms) == 1) List.reverse(acc) else lowerArms(List.tail(arms), ctors, List.cons(lowerArm(List.head(arms), ctors), acc))

def lowerArm(arm: List, ctors: List): List =
  List.cons("Arm", List.cons(nodeExpr(arm, 0), List.cons(lowerExpr(nodeExpr(arm, 1), ctors), List.empty())))

def lowerInterpParts(parts: List, ctors: List, acc: List): List =
  if (List.isEmpty(parts) == 1) List.reverse(acc) else lowerInterpParts(List.tail(parts), ctors, List.cons(lowerInterpPart(List.head(parts), ctors), acc))

def lowerInterpPart(part: List, ctors: List): List =
  if (streq(List.head(part), "Lit") == 1) part else List.cons("Hole", List.cons(lowerExpr(nodeExpr(part, 0), ctors), List.empty()))

def forBindersHaveDraw(binders: List): Int =
  if (List.isEmpty(binders) == 1) 0 else if (streq(List.head(List.head(binders)), "Draw") == 1) 1 else forBindersHaveDraw(List.tail(binders))

def desugarFor(binders: List, body: List, sp: List, ctors: List): List =
  if (forBindersHaveDraw(binders) == 1) desugarForBinders(binders, withSpan(List.cons("Pure", List.cons(body, List.empty())), sp), ctors) else desugarForBinders(binders, body, ctors)

def desugarForBinders(binders: List, body: List, ctors: List): List =
  if (List.isEmpty(binders) == 1) body else wrapForBinder(List.head(binders), desugarForBinders(List.tail(binders), body, ctors), ctors)

def wrapForBinder(b: List, body: List, ctors: List): List =
  for {
    value = lowerExpr(nodeExpr(b, 1), ctors)
    sp = coverSpan(exprSpan(value), exprSpan(body))
  } yield if (streq(List.head(b), "Eq") == 1) withSpan(List.cons("Let", List.cons(nodeStr(b, 0), List.cons(value, List.cons(body, List.empty())))), sp) else withSpan(List.cons("FlatMap", List.cons(value, List.cons(nodeStr(b, 0), List.cons(body, List.empty())))), sp)

