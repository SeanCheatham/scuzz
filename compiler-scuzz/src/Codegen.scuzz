def emitBuiltinFiber(callee: String, code: String, vals: List, kinds: List, id: Int, conts: String, prefix: String): Emit =
  if (streq(callee, "Fiber.fork") == 1) emitFiberFork(code, vals, kinds, id, conts, prefix) else if (streq(callee, "Fiber.join") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_fiber_join(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Io, id, conts) else if (streq(callee, "Fiber.interrupt") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_fiber_interrupt(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Io, id, conts) else mkS(code, "null", EmitKind.Ptr, id, conts)

def emitFiberFork(code: String, vals: List, kinds: List, id: Int, conts: String, prefix: String): Emit =
  for {
    io = ensureIoPair(code, List.at(kinds, 0), List.at(vals, 0), Str.concat(prefix, "_fio"))
  } yield mkS(str4(fst(io), "  %", prefix, str3("_v = call ptr @sz_fiber_fork(ptr ", snd(io), ")\n")), str3("%", prefix, "_v"), EmitKind.Io, id, conts)

def emitBuiltinIoLoop(callee: String, code: String, vals: List, kinds: List, id: Int, conts: String, prefix: String): Emit =
  if (streq(callee, "IO.forever") == 1) emitIoForever(code, vals, kinds, id, conts, prefix) else if (streq(callee, "IO.repeatN") == 1) emitIoRepeatN(code, vals, kinds, id, conts, prefix) else if (streq(callee, "IO.retryN") == 1) emitIoRetryN(code, vals, kinds, id, conts, prefix) else mkS(code, "null", EmitKind.Ptr, id, conts)

def emitIoForever(code: String, vals: List, kinds: List, id: Int, conts: String, prefix: String): Emit =
  for {
    io = ensureIoPair(code, List.at(kinds, 0), List.at(vals, 0), Str.concat(prefix, "_fio"))
  } yield mkS(str4(fst(io), "  %", prefix, str3("_v = call ptr @sz_io_forever(ptr ", snd(io), ")\n")), str3("%", prefix, "_v"), EmitKind.Io, id, conts)

def emitIoRepeatN(code: String, vals: List, kinds: List, id: Int, conts: String, prefix: String): Emit =
  for {
    io = ensureIoPair(code, List.at(kinds, 1), List.at(vals, 1), Str.concat(prefix, "_rio"))
  } yield emitIoCounted(fst(io), List.at(vals, 0), snd(io), kinds, prefix, "@sz_io_repeat_n", id, conts)

def emitIoRetryN(code: String, vals: List, kinds: List, id: Int, conts: String, prefix: String): Emit =
  for {
    io = ensureIoPair(code, List.at(kinds, 1), List.at(vals, 1), Str.concat(prefix, "_tio"))
  } yield emitIoCounted(fst(io), List.at(vals, 0), snd(io), kinds, prefix, "@sz_io_retry_n", id, conts)

def emitIoCounted(code: String, n: String, inner: String, kinds: List, prefix: String, fn: String, id: Int, conts: String): Emit =
  if (kindIsInt(List.at(kinds, 0)) == 1) mkS(str4(code, "  %", prefix, str5("_v = call ptr ", fn, "(i64 ", n, str3(", ptr ", inner, ")\n"))), str3("%", prefix, "_v"), EmitKind.Io, id, conts) else mkS(str4(code, "  %", prefix, str3("_n0 = add i64 0, 0\n  %", prefix, str5("_v = call ptr ", fn, "(i64 %", prefix, str3("_n0, ptr ", inner, ")\n")))), str3("%", prefix, "_v"), EmitKind.Io, id, conts)

