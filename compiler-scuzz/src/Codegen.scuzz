(i64 ", List.at(vals, 0), ", i64 ", List.at(vals, 1), ")\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else if (streq(callee, "View.image") == 1) mkS(str4(code, "  %", prefix, str4("_v = call ptr @sz_lang_view_image(i64 ", List.at(vals, 0), str4(", i64 ", List.at(vals, 1), ", i64 ", List.at(vals, 2)), str3(", ptr ", List.at(vals, 3), ")\n"))), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else if (streq(callee, "View.showWhen") == 1) mkS(str4(code, "  %", prefix, str4("_v = call ptr @sz_lang_view_show_when(ptr ", List.at(vals, 0), str4(", i64 ", List.at(vals, 1), ", ptr ", List.at(vals, 2)), ")\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else mkS(code, "null", EmitKind.Ptr, id, conts)

def emitBuiltinTheme(callee: String, code: String, vals: List, id: Int, conts: String, prefix: String): Emit =
  if (streq(callee, "Theme.accent") == 1) mkS(str3(code, "  %", Str.concat(prefix, "_v = call i64 @sz_theme_accent()\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(callee, "Theme.primary") == 1) mkS(str3(code, "  %", Str.concat(prefix, "_v = call i64 @sz_theme_primary()\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(callee, "Theme.muted") == 1) mkS(str3(code, "  %", Str.concat(prefix, "_v = call i64 @sz_theme_muted()\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(callee, "Theme.foreground") == 1) mkS(str3(code, "  %", Str.concat(prefix, "_v = call i64 @sz_theme_foreground()\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else mkS(code, "null", EmitKind.Ptr, id, conts)

def emitBuiltinColor(callee: String, code: String, vals: List, id: Int, conts: String, prefix: String): Emit =
  if (streq(callee, "Color.rgb") == 1) mkS(str4(code, "  %", prefix, str4("_v = call i64 @sz_color_rgb(i64 ", List.at(vals, 0), str4(", i64 ", List.at(vals, 1), ", i64 ", List.at(vals, 2)), ")\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else mkS(code, "null", EmitKind.Ptr, id, conts)

def emitViewBox(code: String, vals: List, id: Int, conts: String, prefix: String, createFn: String): Emit =
  for {
    c0 = str4(code, "  %", prefix, str3("_v = call ptr @", createFn, "()\n"))
  } yield emitViewBoxChildren(c0, vals, 0, id, conts, prefix)

def emitViewBoxChildren(code: String, vals: List, i: Int, id: Int, conts: String, prefix: String): Emit =
  if (i >= List.len(vals)) mkS(code, str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else emitViewBoxChildren(str4(code, "  %", prefix, str4("_ac", Str.fromInt(i), " = call ptr @sz_lang_view_add_child(ptr %", str4(prefix, "_v, ptr ", List.at(vals, i), ")\n"))), vals, i + 1, id, conts, prefix)

def emitViewButton(code: String, vals: List, id: Int, conts: String, prefix: String): Emit =
  for {
    cl = List.at(vals, 1)
    c1 = str4(code, "  %", prefix, str3("_fnp = call ptr @sz_list_head(ptr ", cl, ")\n"))
    c2 = str4(c1, "  %", prefix, str3("_fnt = call ptr @sz_list_tail(ptr ", cl, ")\n"))
    c3 = str4(c2, "  %", prefix, str4("_envp = call ptr @sz_list_head(ptr %", prefix, "_fnt)\n", ""))
    c4 = str4(c3, "  %", prefix, str5("_v = call ptr @sz_lang_view_button(ptr ", List.at(vals, 0), ", ptr %", prefix, str4("_fnp, ptr %", prefix, "_envp)\n", "")))
  } yield mkS(c4, str3("%", prefix, "_v"), EmitKind.Ptr, id, conts)

def emitBuiltinUi(callee: String, code: String, vals: List, id: Int, conts: String, prefix: String): Emit =
  if (streq(callee, "Ui.run") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_ui_run_view(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Io, id, conts) else mkS(code, "null", EmitKind.Ptr, id, conts)

def emitListCons(code: String, vals: List, kinds: List, id: Int, conts: String, prefix: String): Emit =
  if (kindIsInt(List.head(kinds)) == 1) mkS(str4(code, "  %", prefix, str6("_hd = call ptr @sz_box_i64(i64 ", List.at(vals, 0), ")\n  %", prefix, "_v = call ptr @sz_list_cons(ptr %", str4(prefix, "_hd, ptr ", List.at(vals, 1), ")\n"))), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else mkS(str4(code, "  %", prefix, str5("_v = call ptr @sz_list_cons(ptr ", List.at(vals, 0), ", ptr ", List.at(vals, 1), ")\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts)

def emitListAppend(code: String, vals: List, kinds: List, id: Int, conts: String, prefix: String): Emit =
  if (kindIsInt(List.at(kinds, 1)) == 1) mkS(str4(code, "  %", prefix, str5("_el = call ptr @sz_box_i64(i64 ", List.at(vals, 1), ")\n  %", prefix, str5("_v = call ptr @sz_list_append(ptr ", List.at(vals, 0), ", ptr %", prefix, "_el)\n"))), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else mkS(str4(code, "  %", prefix, str5("_v = call ptr @sz_list_append(ptr ", List.at(vals, 0), ", ptr ", List.at(vals, 1), ")\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts)

def emitListLit(strs: List, elems: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  emitListLitRev(strs, List.reverse(elems), ctx, env, prefix, id, conts, str3("  %", prefix, "_0 = call ptr @sz_list_nil()\n"), str3("%", prefix, "_0"), 1)

def emitListLitRev(strs: List, revElems: List, ctx: List, env: List, prefix: String, id: Int, conts: String, code: String, cur: String, n: Int): Emit =
  if (List.isEmpty(revElems) == 1) mkS(code, cur, EmitKind.Ptr, id, conts) else emitListLitRevOne(List.head(revElems), List.tail(revElems), strs, ctx, env, prefix, id, conts, code, cur, n)

def emitListLitRevOne(elem: Expr, rest: List, strs: List, ctx: List, env: List, prefix: String, id: Int, conts: String, code: String, cur: String, n: Int): Emit =
  for {
    ee = emitExpr(elem, strs, ctx, env, str4(prefix, "_e", Str.fromInt(n), ""), id, conts)
  } yield emitListLitRevCons(rest, strs, ctx, env, prefix, sId(ee), sConts(ee), str3(code, sCode(ee), ""), ee, cur, n)

def emitListLitRevCons(rest: List, strs: List, ctx: List, env: List, prefix: String, id: Int, conts: String, code: String, ee: Emit, cur: String, n: Int): Emit =
  if (kindIsInt(sKind(ee)) == 1) emitListLitRevAfterCons(rest, strs, ctx, env, prefix, id, conts, str4(code, "  %", prefix, str5("_b", Str.fromInt(n), " = call ptr @sz_box_i64(i64 ", sValue(ee), ")\n")), str4("%", prefix, "_b", Str.fromInt(n)), cur, n) else emitListLitRevAfterCons(rest, strs, ctx, env, prefix, id, conts, code, sValue(ee), cur, n)

def emitListLitRevAfterCons(rest: List, strs: List, ctx: List, env: List, prefix: String, id: Int, conts: String, code: String, ptr: String, cur: String, n: Int): Emit =
  for {
    next = str4("%", prefix, "_", Str.fromInt(n))
    code2 = str4(code, "  ", next, str5(" = call ptr @sz_list_cons(ptr ", ptr, ", ptr ", cur, ")\n"))
  } yield emitListLitRev(strs, rest, ctx, env, prefix, id, conts, code2, next, n + 1)

def emitUserCall(callee: String, code: String, vals: List, kinds: List, id: Int, conts: String, ctx: List, prefix: String): Emit =
  for {
    d = resolveFun(ctxDefs(ctx), ctxImports(ctx), callee, ctxModule(ctx))
  } yield if (List.isEmpty(d) == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_user_", callee, "()\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else if (resolveIsAmbiguous(d) == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_user_", callee, "()\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else if (resolveIsPrivate(d) == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_user_", callee, "()\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else emitUserCallDef(code, vals, kinds, id, conts, resolvedDef(d), prefix)

def emitUserCallDef(code: String, vals: List, kinds: List, id: Int, conts: String, d: Def, prefix: String): Emit =
  for {
    retTy = llvmTypeOf(defRet(d))
    retKind = kindOfType(defRet(d))
    sym = userSymbol(defModule(d), defName(d))
    ap = emitUserArgs(defParams(d), vals, kinds, code, prefix, 0, "")
  } yield mkS(str4(fst(ap), "  %", prefix, str5("_v = call ", retTy, " @sz_user_", sym, str3("(", snd(ap), ")\n"))), str3("%", prefix, "_v"), retKind, id, conts)

def emitUserArgs(params: List, vals: List, kinds: List, code: String, prefix: String, i: Int, acc: String): List =
  if (List.isEmpty(params) == 1) pair(code, acc) else emitUserArgsOne(List.head(params), List.tail(params), vals, kinds, code, prefix, i, acc)

def emitUserArgsOne(p: Param, rest: List, vals: List, kinds: List, code: String, prefix: String, i: Int, acc: String): List =
  for {
    want = kindOfType(paramType(p))
    got = List.at(kinds, i)
    v = List.at(vals, i)
    sep = if (Str.len(acc) == 0) "" else ", "
  } yield if (kindIsInt(want) == 1) if (kindIsInt(got) == 1) emitUserArgs(rest, vals, kinds, code, prefix, i + 1, str4(acc, sep, "i64 ", v)) else emitUserArgs(rest, vals, kinds, str4(code, "  %", prefix, str3("_a", Str.fromInt(i), " = add i64 0, 0\n")), prefix, i + 1, str4(acc, sep, "i64 %", str3(prefix, "_a", Str.fromInt(i)))) else if (kindIsInt(got) == 1) emitUserArgs(rest, vals, kinds, str4(code, "  %", prefix, str5("_a", Str.fromInt(i), " = call ptr @sz_box_i64(i64 ", v, ")\n")), prefix, i + 1, str4(acc, sep, "ptr %", str3(prefix, "_a", Str.fromInt(i)))) else emitUserArgs(rest, vals, kinds, code, prefix, i + 1, str4(acc, sep, "ptr ", v))

def emitParams(params: List, i: Int, acc: String): String =
  if (List.isEmpty(params) == 1) acc else emitParamsOne(List.head(params), List.tail(params), i, acc)

def emitParamsOne(p: Param, rest: List, i: Int, acc: String): String =
  for {
    sep = if (i == 0) "" else ", "
    part = str4(sep, llvmTypeOf(paramType(p)), " %", paramName(p))
  } yield emitParams(rest, i + 1, Str.concat(acc, part))

def paramsEnv(params: List, env: List): List =
  if (List.isEmpty(params) == 1) env else paramsEnv(List.tail(params), envPut(env, paramName(List.head(params)), Str.concat("%", paramName(List.head(params))), kindOfType(paramType(List.head(params)))))

def emitFundefRetInt(code: String, bodyKind: EmitKind, bodyVal: String): List =
  if (kindIsInt(bodyKind) == 1) pair(str3(code, "  ret i64 ", bodyVal), "") else pair(Str.concat(code, "  %ret_coerce = add i64 0, 0\n  ret i64 %ret_coerce"), "")

def emitFundefRetPtr(code: String, bodyKind: EmitKind, bodyVal: String): List =
  if (kindIsInt(bodyKind) == 1) pair(str3(code, "  %ret_box = call ptr @sz_box_i64(i64 ", Str.concat(bodyVal, ")\n  ret ptr %ret_box")), "") else if (kindIsPtr(bodyKind) == 1) pair(str3(code, "  ret ptr ", bodyVal), "") else if (isIoKind(bodyKind) == 1) pair(str3(code, "  ret ptr ", bodyVal), "") else pair(Str.concat(code, "  ret ptr null"), "")

def emitFundefRetIo(code: String, bodyKind: EmitKind, bodyVal: String): List =
  for {
    p = ensureIoPair(code, bodyKind, bodyVal, "ret_wrap")
  } yield pair(str3(fst(p), "  ret ptr ", snd(p)), "")

def emitFundef(d: Def, strs: List, ctx: List, id: Int, conts: String): Emit =
  for {
    ret = llvmTypeOf(defRet(d))
    env = paramsEnv(defParams(d), List.empty())
    body = emitExpr(defBody(d), strs, setCtxModule(ctx, defModule(d)), env, "body", id, conts)
    retKind = kindOfType(defRet(d))
    tail = if (isIoKind(retKind) == 1) emitFundefRetIo(sCode(body), sKind(body), sValue(body)) else if (kindIsInt(retKind) == 1) emitFundefRetInt(sCode(body), sKind(body), sValue(body)) else emitFundefRetPtr(sCode(body), sKind(body), sValue(body))
    sym = userSymbol(defModule(d), defName(d))
    ir = str4("define internal ", ret, " @sz_user_", str6(sym, "(", emitParams(defParams(d), 0, ""), ") {\nentry:\n", fst(tail), "\n}\n\n"))
  } yield mkS(ir, "", EmitKind.Ptr, sId(body), sConts(body))

def emitDefs(defs: List, strs: List, allDefs: List, id: Int, conts: String, acc: String): Emit =
  if (List.isEmpty(defs) == 1) mkS(acc, "", EmitKind.Ptr, id, conts) else emitDefsOne(List.head(defs), List.tail(defs), strs, allDefs, id, conts, acc)

def emitDefsOne(d: Def, rest: List, strs: List, allDefs: List, id: Int, conts: String, acc: String): Emit =
  for {
    fe = emitFundef(d, strs, allDefs, id, conts)
  } yield emitDefs(rest, strs, allDefs, sId(fe), sConts(fe), Str.concat(acc, sCode(fe)))

def emitMain(prog: Prog, strs: List, ctx: List, defsIr: Emit, driverNames: List): String =
  for {
    body = emitExpr(progMain(prog), strs, setCtxModule(ctx, progMainModule(prog)), List.empty(), "build", sId(defsIr), sConts(defsIr))
    regs = emitDriverRegs(driverNames, progDefs(prog), strs, 0, "")
    p = ensureIoPair(str3(regs, sCode(body), ""), sKind(body), sValue(body), "wrapped")
    mainFn = str4("define i32 @main(i32 %argc, ptr %argv) {\nentry:\n", fst(p), "  %rc = call i32 @sz_runtime_main_args(ptr ", Str.concat(snd(p), ", i32 %argc, ptr %argv)\n  ret i32 %rc\n}\n"))
  } yield str4(sConts(body), sCode(defsIr), mainFn, "")

def emitDriverRegs(names: List, defs: List, strs: List, i: Int, acc: String): String =
  if (List.isEmpty(names) == 1) acc else emitDriverRegOne(List.head(names), List.tail(names), defs, strs, i, acc)

def emitDriverRegOne(name: String, rest: List, defs: List, strs: List, i: Int, acc: String): String =
  for {
    d = List.head(collectDefsByName(defs, name, List.empty()))
    nargs = List.len(defParams(d))
    isStr = if (nargs == 0) 0 else if (tyEq(paramType(List.head(defParams(d))), Type.String) == 1) 1 else if (tyEq(paramType(List.head(defParams(d))), Type.Bool) == 1) 2 else 0
    idx = strIndexAt(strs, name, 0)
    prefix = str3("drv", Str.fromInt(i), "")
    len = Str.len(name) + 1
    gep = str4("  %", prefix, "_gep = getelementptr inbounds [", str4(Str.fromInt(len), " x i8], ptr @.str", Str.fromInt(idx), ", i64 0, i64 0\n"))
    ss = str4("  %", prefix, "_ss = call ptr @sz_string_from_cstr(ptr %", str3(prefix, "_gep)\n", ""))
    call = str3("  call void @sz_driver_register(ptr %", prefix, str5("_ss, i64 ", Str.fromInt(nargs), ", i64 ", Str.fromInt(isStr), str3(", ptr @sz_user_", userSymbol(defModule(d), defName(d)), ")\n")))
  } yield emitDriverRegs(rest, defs, strs, i + 1, str3(acc, str3(gep, ss, call), ""))

def emitProgram(prog: Prog, driverNames: List): String =
  for {
    strs = collectProgramWith(prog, driverNames)
    tags = buildEnumTags(progEnums(prog))
    payloads = buildEnumPayloads(progEnums(prog))
    ctx = emitCtx(progDefs(prog), tags, payloads, "", progImports(prog))
    header = emitHeader(strs)
    defsIr = emitDefs(progDefs(prog), strs, ctx, 0, "", "")
  } yield Str.concat(header, emitMain(prog, strs, ctx, defsIr, driverNames))

