package scuzz.compiler

def progPkg(p: Prog): String =
  p match {
    case Prog(pkg, enums, defs, main, mainModule, imports, traits, impls) => pkg
  }

def progEnums(p: Prog): List =
  p match {
    case Prog(pkg, enums, defs, main, mainModule, imports, traits, impls) => enums
  }

def progDefs(p: Prog): List =
  p match {
    case Prog(pkg, enums, defs, main, mainModule, imports, traits, impls) => defs
  }

def progMain(p: Prog): Expr =
  p match {
    case Prog(pkg, enums, defs, main, mainModule, imports, traits, impls) => main
  }

def progMainModule(p: Prog): String =
  p match {
    case Prog(pkg, enums, defs, main, mainModule, imports, traits, impls) => mainModule
  }

def progImports(p: Prog): List =
  p match {
    case Prog(pkg, enums, defs, main, mainModule, imports, traits, impls) => imports
  }

def progTraits(p: Prog): List =
  p match {
    case Prog(pkg, enums, defs, main, mainModule, imports, traits, impls) => traits
  }

def progImpls(p: Prog): List =
  p match {
    case Prog(pkg, enums, defs, main, mainModule, imports, traits, impls) => impls
  }

def enumModule(e: EnumDef): String =
  e match {
    case EnumDef.Enum(module, name, cases, tparams) => module
    case EnumDef.Record(module, name, fields, tparams) => module
  }

def enumName(e: EnumDef): String =
  e match {
    case EnumDef.Enum(module, name, cases, tparams) => name
    case EnumDef.Record(module, name, fields, tparams) => name
  }

def enumCases(e: EnumDef): List =
  e match {
    case EnumDef.Enum(module, name, cases, tparams) => cases
    case EnumDef.Record(module, name, fields, tparams) => List.cons(EnumCase.Case(name, fields), List.empty())
  }

def enumTParams(e: EnumDef): List =
  e match {
    case EnumDef.Enum(module, name, cases, tparams) => tparams
    case EnumDef.Record(module, name, fields, tparams) => tparams
  }

def enumIsRecord(e: EnumDef): Int =
  e match {
    case EnumDef.Enum(module, name, cases, tparams) => 0
    case EnumDef.Record(module, name, fields, tparams) => 1
  }

def enumId(e: EnumDef): String =
  if (Str.len(enumModule(e)) == 0) enumName(e) else qualKey(enumModule(e), enumName(e))

def caseName(c: EnumCase): String =
  c match {
    case EnumCase.Case(name, fields) => name
  }

def caseFields(c: EnumCase): List =
  c match {
    case EnumCase.Case(name, fields) => fields
  }

def fieldName(f: EnumField): String =
  f match {
    case EnumField.Field(name, ty, rfn) => name
  }

def fieldType(f: EnumField): Type =
  f match {
    case EnumField.Field(name, ty, rfn) => ty
  }

def fieldRfn(f: EnumField): List =
  f match {
    case EnumField.Field(name, ty, rfn) => rfn
  }

def emitCtx(defs: List, tags: List, payloads: List, mod: String, imports: List): List =
  List.cons(defs, List.cons(tags, List.cons(payloads, List.cons(mod, List.cons(imports, List.empty())))))

def ctxDefs(ctx: List): List =
  List.head(ctx)

def ctxTags(ctx: List): List =
  List.head(List.tail(ctx))

def ctxPayloads(ctx: List): List =
  List.head(List.tail(List.tail(ctx)))

def ctxModule(ctx: List): String =
  List.head(List.tail(List.tail(List.tail(ctx))))

def ctxImports(ctx: List): List =
  List.head(List.tail(List.tail(List.tail(List.tail(ctx)))))

def setCtxModule(ctx: List, mod: String): List =
  emitCtx(ctxDefs(ctx), ctxTags(ctx), ctxPayloads(ctx), mod, ctxImports(ctx))

def buildEnumTags(enums: List): List =
  buildEnumTagsAcc(enums, List.empty())

def buildEnumTagsAcc(enums: List, acc: List): List =
  if (List.isEmpty(enums) == 1) acc else buildEnumTagsAcc(List.tail(enums), buildOneEnumTags(List.head(enums), acc))

def buildOneEnumTags(e: EnumDef, acc: List): List =
  buildCaseTags(enumId(e), enumCases(e), 0, acc)

def buildCaseTags(en: String, cases: List, i: Int, acc: List): List =
  if (List.isEmpty(cases) == 1) acc else buildCaseTags(en, List.tail(cases), i + 1, List.cons(str4(en, ".", caseName(List.head(cases)), str3("=", Str.fromInt(i), "")), acc))

def buildEnumPayloads(enums: List): List =
  buildEnumPayloadsAcc(enums, List.empty())

def buildEnumPayloadsAcc(enums: List, acc: List): List =
  if (List.isEmpty(enums) == 1) acc else buildEnumPayloadsAcc(List.tail(enums), buildOneEnumPayloads(List.head(enums), acc))

def buildOneEnumPayloads(e: EnumDef, acc: List): List =
  buildCasePayloads(enumId(e), enumCases(e), acc)

def buildCasePayloads(en: String, cases: List, acc: List): List =
  if (List.isEmpty(cases) == 1) acc else buildCasePayloads(en, List.tail(cases), buildCasePayloadOne(en, List.head(cases), acc))

def buildCasePayloadOne(en: String, c: EnumCase, acc: List): List =
  if (List.isEmpty(caseFields(c)) == 1) acc else List.cons(CasePayload.Row(str3(en, ".", caseName(c)), joinFieldTyList(caseFields(c))), acc)

def joinFieldTyList(fields: List): List =
  if (List.isEmpty(fields) == 1) List.empty() else List.cons(fieldType(List.head(fields)), joinFieldTyList(List.tail(fields)))

def tagLookup(tags: List, en: String, caseName: String): String =
  tagLookupKey(tags, str3(en, ".", caseName))

def tagLookupKey(tags: List, key: String): String =
  if (List.isEmpty(tags) == 1) "0" else tagLookupKeyCont(List.head(tags), List.tail(tags), key)

def tagLookupKeyCont(row: String, rest: List, key: String): String =
  if (startsWith(row, Str.concat(key, "=")) == 1) Str.slice(row, Str.len(key) + 1, Str.len(row)) else tagLookupKey(rest, key)

def payloadLookup(payloads: List, en: String, caseName: String): List =
  payloadLookupKey(payloads, str3(en, ".", caseName))

def payloadLookupKey(payloads: List, key: String): List =
  if (List.isEmpty(payloads) == 1) List.empty() else payloadLookupKeyCont(List.head(payloads), List.tail(payloads), key)

def payloadLookupKeyCont(row: CasePayload, rest: List, key: String): List =
  if (streq(payloadRowKey(row), key) == 1) payloadRowTys(row) else payloadLookupKey(rest, key)

def armPat(arm: MatchArm): Pattern =
  arm match {
    case MatchArm.Arm(pat, body) => pat
  }

def armBody(arm: MatchArm): Expr =
  arm match {
    case MatchArm.Arm(pat, body) => body
  }

def setArmBody(arm: MatchArm, body: Expr): MatchArm =
  MatchArm.Arm(armPat(arm), body)

def findWildArm(arms: List): List =
  if (List.isEmpty(arms) == 1) List.empty() else findWildArmOne(List.head(arms), List.tail(arms))

def findWildArmOne(arm: MatchArm, rest: List): List =
  findWildArmPat(armPat(arm), arm, rest)

def findWildArmPat(pat: Pattern, arm: MatchArm, rest: List): List =
  pat match {
    case Pattern.Wild => List.cons(arm, List.empty())
    case Pattern.Adt(enumName, caseName, binds, typeArgs) => findWildArm(rest)
  }

def defName(d: Def): String =
  d match {
    case Def(name, params, ret, body, module, isPrivate, typeParams, isLaw) => name
  }

def defParams(d: Def): List =
  d match {
    case Def(name, params, ret, body, module, isPrivate, typeParams, isLaw) => params
  }

def defRet(d: Def): Type =
  d match {
    case Def(name, params, ret, body, module, isPrivate, typeParams, isLaw) => ret
  }

def defBody(d: Def): Expr =
  d match {
    case Def(name, params, ret, body, module, isPrivate, typeParams, isLaw) => body
  }

def defModule(d: Def): String =
  d match {
    case Def(name, params, ret, body, module, isPrivate, typeParams, isLaw) => module
  }

def defIsPrivate(d: Def): Int =
  d match {
    case Def(name, params, ret, body, module, isPrivate, typeParams, isLaw) => isPrivate
  }

def defTypeParams(d: Def): List =
  d match {
    case Def(name, params, ret, body, module, isPrivate, typeParams, isLaw) => typeParams
  }

def defIsLaw(d: Def): Int =
  d match {
    case Def(name, params, ret, body, module, isPrivate, typeParams, isLaw) => isLaw
  }

def setDefModule(d: Def, mod: String): Def =
  d match {
    case Def(name, params, ret, body, module, isPrivate, typeParams, isLaw) => Def.Def(name, params, ret, body, mod, isPrivate, typeParams, isLaw)
  }

def setDefBody(d: Def, body: Expr): Def =
  d match {
    case Def(name, params, ret, old, module, isPrivate, typeParams, isLaw) => Def.Def(name, params, ret, body, module, isPrivate, typeParams, isLaw)
  }

def stampDefsModule(defs: List, mod: String): List =
  if (List.isEmpty(defs) == 1) List.empty() else List.cons(setDefModule(List.head(defs), mod), stampDefsModule(List.tail(defs), mod))

def paramName(p: Param): String =
  p match {
    case Param(name, ty, rfn) => name
  }

def paramType(p: Param): Type =
  p match {
    case Param(name, ty, rfn) => ty
  }

def funHit(d: Def): List =
  List.cons("Hit", List.cons(d, List.empty()))

def funAmbiguous(): List =
  List.cons("Ambiguous", List.empty())

def funPrivate(module: String, name: String): List =
  List.cons("Private", List.cons(module, List.cons(name, List.empty())))

def resolvedDef(d: List): Def =
  List.head(List.tail(d))

def resolvePrivateModule(d: List): String =
  List.head(List.tail(d))

def resolvePrivateName(d: List): String =
  List.head(List.tail(List.tail(d)))

def defVisibleFrom(d: Def, currentModule: String): Int =
  if (defIsPrivate(d) == 0) 1 else if (streq(defModule(d), currentModule) == 1) 1 else 0

def enumHit(e: EnumDef): List =
  List.cons(e, List.empty())

def caseHit(c: EnumCase): List =
  List.cons(c, List.empty())

def llvmTypeOf(ty: Type): String =
  ty match {
    case Type.Int => "i64"
    case Type.Bool => "i64"
    case _ => "ptr"
  }

def kindOfType(ty: Type): EmitKind =
  ty match {
    case Type.Int => EmitKind.Int
    case Type.Bool => EmitKind.Int
    case Type.Io(inner) => kindOfIoInner(inner)
    case _ => EmitKind.Ptr
  }

def kindOfIoInner(inner: Type): EmitKind =
  inner match {
    case Type.Int => EmitKind.IoInt
    case _ => EmitKind.Io
  }

def findDef(defs: List, name: String): List =
  if (List.isEmpty(defs) == 1) List.empty() else if (streq(defName(List.head(defs)), name) == 1) funHit(List.head(defs)) else findDef(List.tail(defs), name)

def findDefByQual(defs: List, module: String, name: String): List =
  if (List.isEmpty(defs) == 1) List.empty() else if (streq(defModule(List.head(defs)), module) == 1) if (streq(defName(List.head(defs)), name) == 1) funHit(List.head(defs)) else findDefByQual(List.tail(defs), module, name) else findDefByQual(List.tail(defs), module, name)

def collectDefsByName(defs: List, name: String, acc: List): List =
  if (List.isEmpty(defs) == 1) List.reverse(acc) else if (streq(defName(List.head(defs)), name) == 1) collectDefsByName(List.tail(defs), name, List.cons(List.head(defs), acc)) else collectDefsByName(List.tail(defs), name, acc)

def collectVisibleDefsByName(defs: List, name: String, currentModule: String, acc: List): List =
  if (List.isEmpty(defs) == 1) List.reverse(acc) else if (streq(defName(List.head(defs)), name) == 1) if (defVisibleFrom(List.head(defs), currentModule) == 1) collectVisibleDefsByName(List.tail(defs), name, currentModule, List.cons(List.head(defs), acc)) else collectVisibleDefsByName(List.tail(defs), name, currentModule, acc) else collectVisibleDefsByName(List.tail(defs), name, currentModule, acc)

def resolveFunQual(defs: List, module: String, name: String, currentModule: String): List =
  for {
    hit = findDefByQual(defs, module, name)
  } yield if (List.isEmpty(hit) == 1) List.empty() else if (defVisibleFrom(resolvedDef(hit), currentModule) == 0) funPrivate(module, name) else hit

def resolveFunBareUnique(defs: List, name: String, currentModule: String): List =
  for {
    hits = collectVisibleDefsByName(defs, name, currentModule, List.empty())
  } yield if (List.isEmpty(hits) == 1) List.empty() else if (List.isEmpty(List.tail(hits)) == 1) funHit(List.head(hits)) else funAmbiguous()

def importInModule(im: Import): String =
  im match {
    case Import(inModule, fromModule, name) => inModule
  }

def importFromModule(im: Import): String =
  im match {
    case Import(inModule, fromModule, name) => fromModule
  }

def importName(im: Import): String =
  im match {
    case Import(inModule, fromModule, name) => name
  }

def findImport(imports: List, inModule: String, name: String): List =
  if (List.isEmpty(imports) == 1) List.empty() else if (streq(importInModule(List.head(imports)), inModule) == 1) if (streq(importName(List.head(imports)), name) == 1) List.cons(List.head(imports), List.empty()) else findImport(List.tail(imports), inModule, name) else findImport(List.tail(imports), inModule, name)

def resolveFunImport(defs: List, imports: List, name: String, currentModule: String): List =
  for {
    hit = findImport(imports, currentModule, name)
  } yield if (List.isEmpty(hit) == 1) resolveFunBareUnique(defs, name, currentModule) else findDefByQual(defs, importFromModule(List.head(hit)), name)

def resolveFunBare(defs: List, imports: List, name: String, currentModule: String): List =
  for {
    local = findDefByQual(defs, currentModule, name)
  } yield if (List.isEmpty(local) == 0) local else resolveFunImport(defs, imports, name, currentModule)

def resolveFun(defs: List, imports: List, callee: String, currentModule: String): List =
  for {
    parts = splitDotted(callee)
  } yield if (List.isEmpty(parts) == 0) resolveFunQual(defs, List.head(parts), List.head(List.tail(parts)), currentModule) else resolveFunBare(defs, imports, callee, currentModule)

def resolveIsAmbiguous(d: List): Int =
  if (List.isEmpty(d) == 1) 0 else if (streq(List.head(d), "Ambiguous") == 1) 1 else 0

def resolveIsPrivate(d: List): Int =
  if (List.isEmpty(d) == 1) 0 else if (streq(List.head(d), "Private") == 1) 1 else 0

def strContains(strs: List, s: String): Int =
  if (List.isEmpty(strs) == 1) 0 else if (streq(List.head(strs), s) == 1) 1 else strContains(List.tail(strs), s)

def strIndexAt(strs: List, s: String, i: Int): Int =
  if (i >= List.len(strs)) 0 else if (streq(List.at(strs, i), s) == 1) i else strIndexAt(strs, s, i + 1)

def collectPush(strs: List, s: String): List =
  if (strContains(strs, s) == 1) strs else List.cons(s, strs)

def collectExpr(e: Expr, strs: List): List =
  e match {
    case Expr.StrLit(value, span) => collectPush(strs, value)
    case Expr.Println(arg, span) => collectExpr(arg, strs)
    case Expr.Fail(arg, span) => collectExpr(arg, strs)
    case Expr.Pure(arg, span) => collectExpr(arg, strs)
    case Expr.Sleep(arg, span) => collectExpr(arg, strs)
    case Expr.FlatMap(inner, param, body, span) => collectExpr(body, collectExpr(inner, strs))
    case Expr.Handle(inner, body, span) => collectExpr(body, collectExpr(inner, strs))
    case Expr.Attempt(inner, span) => collectExpr(inner, strs)
    case Expr.Let(name, value, body, span) => collectExpr(body, collectExpr(value, strs))
    case Expr.If(cond, thenB, elseB, span) => collectExpr(elseB, collectExpr(thenB, collectExpr(cond, strs)))
    case Expr.BinOp(op, left, right, span) => collectExpr(right, collectExpr(left, strs))
    case Expr.Call(callee, args, span) => collectArgs(args, strs)
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => collectArgs(args, strs)
    case Expr.IoRace(left, right, span) => collectExpr(right, collectExpr(left, strs))
    case Expr.IoBoth(left, right, span) => collectExpr(right, collectExpr(left, strs))
    case Expr.IoEnsure(inner, finalizer, span) => collectExpr(finalizer, collectExpr(inner, strs))
    case Expr.IoTimeout(ms, inner, span) => collectExpr(inner, collectExpr(ms, strs))
    case Expr.Lambda(param, body, span) => collectExpr(body, strs)
    case Expr.Interp(parts, span) => collectInterpParts(parts, strs)
    case Expr.ListLit(elems, span) => collectArgs(elems, strs)
    case Expr.Match(scrut, arms, span) => collectMatchArms(arms, collectExpr(scrut, strs))
    case Expr.Unit(span) => strs
    case Expr.IntLit(digits, span) => strs
    case Expr.Var(name, span) => strs
    case Expr.Field(base, field, span) => collectExpr(base, strs)
    case Expr.MethodCall(receiver, method, args, span) => collectArgs(args, collectExpr(receiver, strs))
    case Expr.For(binders, body, span) => strs
  }

def collectInterpParts(parts: List, strs: List): List =
  if (List.isEmpty(parts) == 1) strs else collectInterpParts(List.tail(parts), collectInterpPart(List.head(parts), strs))

def collectInterpPart(part: InterpPart, strs: List): List =
  part match {
    case InterpPart.Lit(text) => collectPush(strs, text)
    case InterpPart.Hole(expr) => collectExpr(expr, strs)
  }

def collectArgs(args: List, strs: List): List =
  if (List.isEmpty(args) == 1) strs else collectArgs(List.tail(args), collectExpr(List.head(args), strs))

def collectMatchArms(arms: List, strs: List): List =
  if (List.isEmpty(arms) == 1) strs else collectMatchArms(List.tail(arms), collectExpr(armBody(List.head(arms)), strs))

def collectDefs(defs: List, strs: List): List =
  if (List.isEmpty(defs) == 1) strs else collectDefs(List.tail(defs), collectExpr(defBody(List.head(defs)), strs))

def collectProgram(prog: Prog): List =
  List.reverse(collectExpr(progMain(prog), collectDefs(progDefs(prog), List.empty())))

def collectProgramWith(prog: Prog, extra: List): List =
  List.reverse(collectExpr(progMain(prog), collectDefs(progDefs(prog), collectDriverStrs(extra, List.empty()))))

def collectDriverStrs(names: List, strs: List): List =
  if (List.isEmpty(names) == 1) strs else collectDriverStrs(List.tail(names), collectPush(strs, List.head(names)))

def emitStrConsts(strs: List, i: Int, acc: String): String =
  if (i >= List.len(strs)) acc else emitStrConsts(strs, i + 1, Str.concat(acc, emitOneStr(List.at(strs, i), i)))

def emitOneStr(s: String, i: Int): String =
  str4(str4("@.str", Str.fromInt(i), " = private unnamed_addr constant [", Str.fromInt(Str.len(s) + 1)), " x i8] c\"", llvmEscape(s), "\\00\", align 1\n")

def runtimeDeclares(): String =
  Str.concat(runtimeDeclaresA(), Str.concat(runtimeDeclaresB(), runtimeDeclaresC()))

def runtimeDeclaresA(): String =
  str5("declare ptr @sz_string_from_cstr(ptr)\ndeclare ptr @sz_string_cstr(ptr)\n", "declare ptr @sz_string_concat(ptr, ptr)\ndeclare i64 @sz_string_len(ptr)\n", "declare ptr @sz_string_slice(ptr, i64, i64)\ndeclare i32 @sz_string_eq(ptr, ptr)\n", "declare i64 @sz_string_char_at(ptr, i64)\ndeclare ptr @sz_string_from_int(i64)\n", str5("declare i64 @sz_string_index_of(ptr, ptr)\ndeclare ptr @sz_io_println(ptr)\n", "declare ptr @sz_io_pure(ptr)\ndeclare ptr @sz_io_delay(ptr, ptr)\n", "declare ptr @sz_io_flatmap(ptr, ptr, ptr)\ndeclare ptr @sz_io_fail_cstr(ptr)\n", "declare ptr @sz_io_sleep_ms(i64)\ndeclare ptr @sz_io_handle_error_with(ptr, ptr, ptr)\n", str4("declare ptr @sz_io_attempt(ptr)\ndeclare ptr @sz_io_race(ptr, ptr)\n", "declare ptr @sz_io_both(ptr, ptr)\ndeclare ptr @sz_io_ensure(ptr, ptr)\ndeclare ptr @sz_io_timeout(i64, ptr)\ndeclare ptr @sz_io_forever(ptr)\ndeclare ptr @sz_io_repeat_n(i64, ptr)\ndeclare ptr @sz_io_retry_n(i64, ptr)\ndeclare ptr @sz_fiber_fork(ptr)\ndeclare ptr @sz_fiber_join(ptr)\ndeclare ptr @sz_fiber_interrupt(ptr)\ndeclare ptr @sz_adt_new(i32, ptr)\n", "declare i32 @sz_adt_tag(ptr)\ndeclare ptr @sz_adt_payload(ptr)\n", "")))

def runtimeDeclaresB(): String =
  str5("declare ptr @sz_list_nil()\n", "declare i32 @sz_list_is_empty(ptr)\ndeclare ptr @sz_list_cons(ptr, ptr)\n", "declare ptr @sz_list_head(ptr)\ndeclare ptr @sz_list_tail(ptr)\n", "declare i64 @sz_list_len(ptr)\ndeclare ptr @sz_list_at(ptr, i64)\n", str5("declare ptr @sz_list_reverse(ptr)\ndeclare ptr @sz_list_join(ptr, ptr)\n", "declare ptr @sz_list_append(ptr, ptr)\ndeclare ptr @sz_fs_read(ptr)\n", "declare ptr @sz_fs_write(ptr, ptr)\ndeclare ptr @sz_fs_list(ptr)\n", "declare ptr @sz_fs_mkdirs(ptr)\ndeclare ptr @sz_fs_canonicalize(ptr)\ndeclare ptr @sz_sys_args()\n", str5("declare ptr @sz_sys_read_line()\ndeclare ptr @sz_sys_exec(ptr)\ndeclare ptr @sz_sys_spawn(ptr)\ndeclare ptr @sz_sys_alive(i64)\ndeclare ptr @sz_sys_getenv(ptr)\n", "declare ptr @sz_clock_real_time()\ndeclare ptr @sz_clock_monotonic()\n", "declare ptr @sz_random_next_int(i64)\ndeclare ptr @sz_net_http_get(ptr)\ndeclare ptr @sz_net_serve_once(i64, ptr, ptr)\ndeclare ptr @sz_net_serve(i64, ptr, ptr)\n", "declare ptr @sz_impurity_run_kit()\ndeclare ptr @sz_ref_of(ptr)\ndeclare ptr @sz_ref_get(ptr)\ndeclare ptr @sz_ref_set(ptr, ptr)\ndeclare ptr @sz_queue_unbounded()\ndeclare ptr @sz_queue_offer(ptr, ptr)\ndeclare ptr @sz_queue_take(ptr)\ndeclare ptr @sz_deferred_empty()\ndeclare ptr @sz_deferred_complete(ptr, ptr)\ndeclare ptr @sz_deferred_get(ptr)\ndeclare ptr @sz_lang_resource_make(ptr, ptr, ptr)\ndeclare ptr @sz_lang_resource_use(ptr, ptr, ptr)\ndeclare ptr @sz_stream_emit(ptr)\ndeclare ptr @sz_stream_emits(ptr)\ndeclare ptr @sz_stream_eval(ptr)\ndeclare ptr @sz_stream_concat(ptr, ptr)\ndeclare ptr @sz_stream_take(ptr, i64)\ndeclare ptr @sz_stream_drop(ptr, i64)\ndeclare ptr @sz_stream_evalmap(ptr, ptr, ptr)\ndeclare ptr @sz_stream_filter(ptr, ptr, ptr)\ndeclare ptr @sz_stream_map(ptr, ptr, ptr)\ndeclare ptr @sz_stream_takewhile(ptr, ptr, ptr)\ndeclare ptr @sz_stream_dropwhile(ptr, ptr, ptr)\ndeclare ptr @sz_stream_find(ptr, ptr, ptr)\ndeclare ptr @sz_stream_exists(ptr, ptr, ptr)\ndeclare ptr @sz_stream_compile_to_list(ptr)\ndeclare ptr @sz_stream_drain(ptr)\ndeclare ptr @sz_lang_signal_int(i64)\n", str5("declare i64 @sz_lang_signal_get(ptr)\ndeclare ptr @sz_lang_signal_set(ptr, i64)\n", "declare ptr @sz_lang_signal_str(ptr)\ndeclare ptr @sz_lang_signal_str_get(ptr)\n", "declare ptr @sz_lang_signal_str_set(ptr, ptr)\ndeclare ptr @sz_lang_signal_list(ptr)\n", "declare ptr @sz_lang_signal_list_get(ptr)\ndeclare ptr @sz_lang_signal_list_set(ptr, ptr)\n", str3("declare ptr @sz_string_lines(ptr)\n", "declare ptr @sz_io_unsafe_run_or_die(ptr)\n", "")))))

def runtimeDeclaresC(): String =
  Str.concat(str5("declare ptr @sz_lang_view_text(ptr)\ndeclare ptr @sz_lang_view_bind_text(ptr)\n", "declare ptr @sz_lang_view_button(ptr, ptr, ptr)\n", "declare i64 @sz_theme_accent()\ndeclare i64 @sz_theme_primary()\n", "declare i64 @sz_theme_muted()\ndeclare i64 @sz_theme_foreground()\n", "declare i64 @sz_color_rgb(i64, i64, i64)\n"), str5("declare ptr @sz_lang_view_column()\ndeclare ptr @sz_lang_view_row()\ndeclare ptr @sz_lang_view_stack()\n", "declare ptr @sz_lang_view_each(ptr)\n", "declare ptr @sz_lang_view_scroll(ptr)\ndeclare ptr @sz_lang_view_expanded(ptr)\ndeclare ptr @sz_lang_view_center(ptr)\ndeclare ptr @sz_lang_view_align(i64, i64, ptr)\ndeclare ptr @sz_lang_view_positioned(i64, i64, ptr)\ndeclare ptr @sz_lang_view_padding(i64, ptr)\ndeclare ptr @sz_lang_view_sized(i64, i64, ptr)\ndeclare ptr @sz_lang_view_min_size(i64, i64, ptr)\ndeclare ptr @sz_lang_view_background(i64, ptr)\ndeclare ptr @sz_lang_view_aspect_ratio(i64, i64, ptr)\ndeclare ptr @sz_lang_view_fraction(i64, i64, ptr)\n", "declare ptr @sz_lang_view_text_field(ptr, ptr)\ndeclare ptr @sz_lang_view_icon(i64, i64)\n", str3("declare ptr @sz_lang_view_image(i64, i64, i64, ptr)\ndeclare ptr @sz_lang_view_add_child(ptr, ptr)\n", "declare ptr @sz_lang_view_show_when(ptr, i64, ptr)\n", "declare ptr @sz_lang_signal_map(ptr, ptr, ptr)\ndeclare ptr @sz_ui_run_view(ptr)\ndeclare ptr @sz_ui_run_rebuild(ptr, ptr)\ndeclare i64 @sz_law_signal_int(i64)\ndeclare ptr @sz_law_signal_str(i64)\ndeclare i64 @sz_law_signal_list_len(i64)\ndeclare ptr @sz_law_signal_list_at(i64, i64)\ndeclare i64 @sz_law_a11y_has(ptr)\ndeclare ptr @sz_law_assert(ptr, i64)\ndeclare void @sz_law_check(ptr, i64)\ndeclare void @sz_law_sometimes(ptr)\ndeclare void @sz_driver_register(ptr, i64, i64, ptr)\ndeclare ptr @sz_box_i64(i64)\ndeclare i64 @sz_unbox_i64(ptr)\ndeclare i32 @sz_runtime_main_args(ptr, i32, ptr)\n\n")))

def emitHeader(strs: List): String =
  Str.concat("; Scuzz Lang Stage-1 generated LLVM IR\n\n", Str.concat(runtimeDeclares(), Str.concat(emitStrConsts(strs, 0, "\n"), "\n")))

def ensureIoPair(code: String, kind: EmitKind, value: String, tmp: String): List =
  if (isIoKind(kind) == 1) pair(code, value) else if (kindIsInt(kind) == 1) pair(str4(code, "  %", tmp, Str.concat(str4("_box = call ptr @sz_box_i64(i64 ", value, ")\n  %", tmp), str3(" = call ptr @sz_io_pure(ptr %", tmp, "_box)\n"))), Str.concat("%", tmp)) else pair(str4(code, "  %", tmp, str3(" = call ptr @sz_io_pure(ptr ", value, ")\n")), Str.concat("%", tmp))

def emitSzString(strs: List, e: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  if (isStrLitExpr(e) == 1) emitSzStringLit(strs, strLitExprValue(e), prefix, id, conts) else emitSzStringExpr(strs, e, ctx, env, prefix, id, conts)

def emitSzStringLit(strs: List, s: String, prefix: String, id: Int, conts: String): Emit =
  for {
    idx = strIndexAt(strs, s, 0)
    len = Str.len(s) + 1
    code = str4("  %", prefix, "_gep = getelementptr inbounds [", str4(Str.fromInt(len), " x i8], ptr @.str", Str.fromInt(idx), ", i64 0, i64 0\n  %"))
    code2 = str4(code, prefix, "_ss = call ptr @sz_string_from_cstr(ptr %", str3(prefix, "_gep", ")\n"))
  } yield mkS(code2, str3("%", prefix, "_ss"), EmitKind.Ptr, id, conts)

def emitSzStringExpr(strs: List, e: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  emitExpr(e, strs, ctx, env, Str.concat(prefix, "_e"), id, conts)

def emitCstr(strs: List, e: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  if (isStrLitExpr(e) == 1) emitCstrLit(strs, strLitExprValue(e), prefix, id, conts) else emitCstrExpr(strs, e, ctx, env, prefix, id, conts)

def emitCstrLit(strs: List, s: String, prefix: String, id: Int, conts: String): Emit =
  for {
    idx = strIndexAt(strs, s, 0)
    len = Str.len(s) + 1
    code = str4("  %", prefix, "_cstr = getelementptr inbounds [", str4(Str.fromInt(len), " x i8], ptr @.str", Str.fromInt(idx), ", i64 0, i64 0\n"))
  } yield mkS(code, str3("%", prefix, "_cstr"), EmitKind.Ptr, id, conts)

def emitCstrExpr(strs: List, e: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    se = emitExpr(e, strs, ctx, env, Str.concat(prefix, "_s"), id, conts)
  } yield mkS(str4(sCode(se), "  %", prefix, str3("_cstr = call ptr @sz_string_cstr(ptr ", sValue(se), ")\n")), str3("%", prefix, "_cstr"), EmitKind.Ptr, sId(se), sConts(se))

def emitExpr(e: Expr, strs: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  e match {
    case Expr.Unit(span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IntLit(digits, span) => mkS("", digits, EmitKind.Int, id, conts)
    case Expr.StrLit(value, span) => emitSzStringLit(strs, value, prefix, id, conts)
    case Expr.Var(name, span) => emitVar(env, name, id, conts)
    case Expr.Field(base, field, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.MethodCall(receiver, method, args, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Println(arg, span) => emitPrintln(strs, arg, ctx, env, prefix, id, conts)
    case Expr.Fail(arg, span) => emitFail(strs, arg, ctx, env, prefix, id, conts)
    case Expr.Pure(arg, span) => emitPure(strs, arg, ctx, env, prefix, id, conts)
    case Expr.Sleep(arg, span) => emitSleep(strs, arg, ctx, env, prefix, id, conts)
    case Expr.Let(name, value, body, span) => emitLet(strs, name, value, body, ctx, env, prefix, id, conts)
    case Expr.If(cond, thenB, elseB, span) => emitIf(strs, cond, thenB, elseB, ctx, env, prefix, id, conts)
    case Expr.BinOp(op, left, right, span) => emitBinOp(strs, op, left, right, ctx, env, prefix, id, conts)
    case Expr.Call(callee, args, span) => emitCall(strs, callee, args, ctx, env, prefix, id, conts)
    case Expr.FlatMap(inner, param, body, span) => emitFlatMap(strs, inner, param, body, ctx, env, prefix, id, conts)
    case Expr.Handle(inner, body, span) => emitHandle(strs, inner, body, ctx, env, prefix, id, conts)
    case Expr.Attempt(inner, span) => emitAttempt(strs, inner, ctx, env, prefix, id, conts)
    case Expr.IoRace(left, right, span) => emitRaceBoth(strs, left, right, ctx, env, prefix, id, conts, "race")
    case Expr.IoBoth(left, right, span) => emitRaceBoth(strs, left, right, ctx, env, prefix, id, conts, "both")
    case Expr.IoEnsure(inner, finalizer, span) => emitRaceBoth(strs, inner, finalizer, ctx, env, prefix, id, conts, "ensure")
    case Expr.IoTimeout(ms, inner, span) => emitTimeout(strs, ms, inner, ctx, env, prefix, id, conts)
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => emitAdt(strs, enumName, caseName, args, ctx, env, prefix, id, conts)
    case Expr.Match(scrut, arms, span) => emitMatch(strs, scrut, arms, ctx, env, prefix, id, conts)
    case Expr.Lambda(param, body, span) => emitLambda(strs, param, body, ctx, env, prefix, id, conts)
    case Expr.Interp(parts, span) => emitInterp(strs, parts, ctx, env, prefix, id, conts)
    case Expr.ListLit(elems, span) => emitListLit(strs, elems, ctx, env, prefix, id, conts)
    case Expr.For(binders, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
  }

def emitVar(env: List, name: String, id: Int, conts: String): Emit =
  for {
    b = envGet(env, name)
  } yield mkS("", envBindValue(b), envBindKind(b), id, conts)

def emitPrintln(strs: List, arg: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    se = emitSzString(strs, arg, ctx, env, prefix, id, conts)
  } yield mkS(str4(sCode(se), "  %", prefix, str3("_io = call ptr @sz_io_println(ptr ", sValue(se), ")\n")), str3("%", prefix, "_io"), EmitKind.Io, sId(se), sConts(se))

def emitFail(strs: List, arg: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    ce = emitCstr(strs, arg, ctx, env, prefix, id, conts)
  } yield mkS(str4(sCode(ce), "  %", prefix, str3("_io = call ptr @sz_io_fail_cstr(ptr ", sValue(ce), ")\n")), str3("%", prefix, "_io"), EmitKind.Io, sId(ce), sConts(ce))

def emitPure(strs: List, inner: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    ie = emitExpr(inner, strs, ctx, env, Str.concat(prefix, "_p"), id, conts)
  } yield emitPureCont(ie, prefix)

def emitPureCont(ie: Emit, prefix: String): Emit =
  if (kindIsInt(sKind(ie)) == 1) mkS(str4(sCode(ie), "  %", prefix, str6("_box = call ptr @sz_box_i64(i64 ", sValue(ie), ")\n  %", prefix, "_io = call ptr @sz_io_pure(ptr %", str3(prefix, "_box", ")\n"))), str3("%", prefix, "_io"), EmitKind.IoInt, sId(ie), sConts(ie)) else if (isIoKind(sKind(ie)) == 1) mkS(str4(sCode(ie), "  %", prefix, str3("_io = call ptr @sz_io_pure(ptr ", sValue(ie), ")\n")), str3("%", prefix, "_io"), sKind(ie), sId(ie), sConts(ie)) else mkS(str4(sCode(ie), "  %", prefix, str3("_io = call ptr @sz_io_pure(ptr ", sValue(ie), ")\n")), str3("%", prefix, "_io"), EmitKind.Io, sId(ie), sConts(ie))

def emitSleep(strs: List, ms: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    me = emitExpr(ms, strs, ctx, env, Str.concat(prefix, "_ms"), id, conts)
  } yield emitSleepCont(me, prefix)

def emitSleepCont(me: Emit, prefix: String): Emit =
  if (kindIsInt(sKind(me)) == 1) mkS(str4(sCode(me), "  %", prefix, str3("_sleep = call ptr @sz_io_sleep_ms(i64 ", sValue(me), ")\n")), str3("%", prefix, "_sleep"), EmitKind.Io, sId(me), sConts(me)) else mkS(str5(sCode(me), "  %", prefix, "_ms0 = add i64 0, 0\n  %", str4(prefix, "_sleep = call ptr @sz_io_sleep_ms(i64 %", prefix, "_ms0)\n")), str3("%", prefix, "_sleep"), EmitKind.Io, sId(me), sConts(me))

def emitLet(strs: List, name: String, value: Expr, body: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    ve = emitExpr(value, strs, ctx, env, str4(prefix, "_lv_", name, ""), id, conts)
    env2 = envPut(env, name, sValue(ve), sKind(ve))
    be = emitExpr(body, strs, ctx, env2, str4(prefix, "_l_", name, ""), sId(ve), sConts(ve))
  } yield mkS(Str.concat(sCode(ve), sCode(be)), sValue(be), sKind(be), sId(be), sConts(be))

def emitIf(strs: List, condE: Expr, thenB: Expr, elseB: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    ce = emitExpr(condE, strs, ctx, env, Str.concat(prefix, "_ic"), id, conts)
  } yield emitIfAfterCond(strs, thenB, elseB, ctx, env, prefix, ce)

def emitIfAfterCond(strs: List, thenB: Expr, elseB: Expr, ctx: List, env: List, prefix: String, ce: Emit): Emit =
  for {
    id = sId(ce)
    cond = if (kindIsInt(sKind(ce)) == 1) sValue(ce) else str3("%", prefix, "_c0")
    pre = if (kindIsInt(sKind(ce)) == 1) sCode(ce) else str4(sCode(ce), "  %", prefix, "_c0 = add i64 0, 0\n")
    thenL = str4(prefix, "_then_", Str.fromInt(id), "")
    elseL = str4(prefix, "_else_", Str.fromInt(id), "")
    thenJ = str4(prefix, "_tj_", Str.fromInt(id), "")
    elseJ = str4(prefix, "_ej_", Str.fromInt(id), "")
    merge = str4(prefix, "_merge_", Str.fromInt(id), "")
    head = str4(pre, "  %", prefix, str5("_cmp = icmp ne i64 ", cond, ", 0\n  br i1 %", prefix, str5("_cmp, label %", thenL, ", label %", elseL, "\n")))
    te = emitExpr(thenB, strs, ctx, env, Str.concat(prefix, Str.concat("_t", Str.fromInt(id))), id + 1, sConts(ce))
    ee = emitExpr(elseB, strs, ctx, env, Str.concat(prefix, Str.concat("_e", Str.fromInt(id))), sId(te), sConts(te))
    ty = llvmTyOfKind(sKind(te))
    body = str4(head, thenL, ":\n", str4(sCode(te), "  br label %", thenJ, str5("\n", thenJ, ":\n  br label %", merge, str4("\n", elseL, ":\n", str4(sCode(ee), "  br label %", elseJ, str5("\n", elseJ, ":\n  br label %", merge, str5("\n", merge, ":\n  %", prefix, str5("_phi = phi ", ty, " [ ", sValue(te), str5(", %", thenJ, " ], [ ", sValue(ee), str3(", %", elseJ, " ]\n"))))))))))
  } yield mkS(body, str3("%", prefix, "_phi"), sKind(te), sId(ee), sConts(ee))

def emitBinOp(strs: List, op: String, left: Expr, right: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    le = emitExpr(left, strs, ctx, env, Str.concat(prefix, "_l"), id, conts)
    re = emitExpr(right, strs, ctx, env, Str.concat(prefix, "_r"), sId(le), sConts(le))
  } yield emitBinOpCont(op, le, re, prefix)

def emitBinOpCont(op: String, le: Emit, re: Emit, prefix: String): Emit =
  if (streq(op, "+") == 1) if (kindIsPtr(sKind(le)) == 1) if (kindIsPtr(sKind(re)) == 1) mkS(str5(sCode(le), sCode(re), "  %", prefix, str5("_add = call ptr @sz_string_concat(ptr ", sValue(le), ", ptr ", sValue(re), ")\n")), str3("%", prefix, "_add"), EmitKind.Ptr, sId(re), sConts(re)) else emitBinOpInt(op, le, re, prefix) else emitBinOpInt(op, le, re, prefix) else if (streq(op, "==") == 1) if (kindIsPtr(sKind(le)) == 1) if (kindIsPtr(sKind(re)) == 1) emitBinOpStrEq(le, re, prefix, 1) else emitBinOpInt(op, le, re, prefix) else emitBinOpInt(op, le, re, prefix) else if (streq(op, "!=") == 1) if (kindIsPtr(sKind(le)) == 1) if (kindIsPtr(sKind(re)) == 1) emitBinOpStrEq(le, re, prefix, 0) else emitBinOpInt(op, le, re, prefix) else emitBinOpInt(op, le, re, prefix) else emitBinOpInt(op, le, re, prefix)

def emitBinOpStrEq(le: Emit, re: Emit, prefix: String, isEq: Int): Emit =
  for {
    code0 = str5(sCode(le), sCode(re), "  %", prefix, str5("_eqi = call i32 @sz_string_eq(ptr ", sValue(le), ", ptr ", sValue(re), ")\n  %"))
    code1 = str4(code0, prefix, "_eq = zext i32 %", str3(prefix, "_eqi", " to i64\n"))
  } yield if (isEq == 1) mkS(code1, str3("%", prefix, "_eq"), EmitKind.Int, sId(re), sConts(re)) else mkS(str4(code1, "  %", prefix, str6("_ne = icmp eq i64 %", prefix, "_eq, 0\n  %", prefix, "_nev = zext i1 %", str3(prefix, "_ne", " to i64\n"))), str3("%", prefix, "_nev"), EmitKind.Int, sId(re), sConts(re))

def emitBinOpInt(op: String, le: Emit, re: Emit, prefix: String): Emit =
  for {
    lv = if (kindIsInt(sKind(le)) == 1) sValue(le) else str3("%", prefix, "_l0")
    rv = if (kindIsInt(sKind(re)) == 1) sValue(re) else str3("%", prefix, "_r0")
    c0 = Str.concat(sCode(le), sCode(re))
    c1 = if (kindIsInt(sKind(le)) == 1) c0 else str4(c0, "  %", prefix, "_l0 = add i64 0, 0\n")
    c2 = if (kindIsInt(sKind(re)) == 1) c1 else str4(c1, "  %", prefix, "_r0 = add i64 0, 0\n")
  } yield emitBinOpIntOp(op, c2, lv, rv, prefix, sId(re), sConts(re))

def emitBinOpIntOp(op: String, code: String, lv: String, rv: String, prefix: String, id: Int, conts: String): Emit =
  if (streq(op, "+") == 1) mkS(str4(code, "  %", prefix, str5("_v = add i64 ", lv, ", ", rv, "\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(op, "-") == 1) mkS(str4(code, "  %", prefix, str5("_v = sub i64 ", lv, ", ", rv, "\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(op, "*") == 1) mkS(str4(code, "  %", prefix, str5("_v = mul i64 ", lv, ", ", rv, "\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(op, "/") == 1) mkS(str4(code, "  %", prefix, str5("_v = sdiv i64 ", lv, ", ", rv, "\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(op, "%") == 1) mkS(str4(code, "  %", prefix, str5("_v = srem i64 ", lv, ", ", rv, "\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(op, "&&") == 1) mkS(str4(code, "  %", prefix, str5("_v = and i64 ", lv, ", ", rv, "\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(op, "||") == 1) mkS(str4(code, "  %", prefix, str5("_v = or i64 ", lv, ", ", rv, "\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else emitIcmp(op, code, lv, rv, prefix, id, conts)

def icmpPred(op: String): String =
  if (streq(op, "==") == 1) "eq" else if (streq(op, "!=") == 1) "ne" else if (streq(op, "<") == 1) "slt" else if (streq(op, "<=") == 1) "sle" else if (streq(op, ">") == 1) "sgt" else if (streq(op, ">=") == 1) "sge" else "eq"

def emitIcmp(op: String, code: String, lv: String, rv: String, prefix: String, id: Int, conts: String): Emit =
  mkS(str4(code, "  %", prefix, str5("_cmp = icmp ", icmpPred(op), " i64 ", lv, str6(", ", rv, "\n  %", prefix, "_v = zext i1 %", str3(prefix, "_cmp", " to i64\n")))), str3("%", prefix, "_v"), EmitKind.Int, id, conts)

def emitAdt(strs: List, enumName: String, caseName: String, args: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    tag = tagLookup(ctxTags(ctx), enumName, caseName)
  } yield if (List.isEmpty(args) == 1) mkS(str5("  %", prefix, "_adt = call ptr @sz_adt_new(i32 ", tag, ", ptr null)\n"), str3("%", prefix, "_adt"), EmitKind.Ptr, id, conts) else if (List.len(args) == 1) emitAdtWithArg(strs, enumName, caseName, ctx, env, prefix, id, conts, tag, List.head(args)) else emitAdtMulti(strs, enumName, caseName, ctx, env, prefix, id, conts, tag, args)

def emitAdtWithArg(strs: List, enumName: String, caseName: String, ctx: List, env: List, prefix: String, id: Int, conts: String, tag: String, arg: Expr): Emit =
  for {
    ae = emitExpr(arg, strs, ctx, env, Str.concat(prefix, "_ap"), id, conts)
    pty = payloadLookup(ctxPayloads(ctx), enumName, caseName)
  } yield emitAdtFinish(ae, prefix, tag, List.at(pty, 0))

def emitAdtFinish(ae: Emit, prefix: String, tag: String, pty: Type): Emit =
  if (tyEq(pty, Type.Int) == 1) emitAdtIntPayload(ae, prefix, tag) else mkS(str4(sCode(ae), "  %", prefix, str5("_adt = call ptr @sz_adt_new(i32 ", tag, ", ptr ", sValue(ae), ")\n")), str3("%", prefix, "_adt"), EmitKind.Ptr, sId(ae), sConts(ae))

def emitAdtIntPayload(ae: Emit, prefix: String, tag: String): Emit =
  for {
    v = if (kindIsInt(sKind(ae)) == 1) sValue(ae) else str3("%", prefix, "_ap0")
    pre = if (kindIsInt(sKind(ae)) == 1) sCode(ae) else str4(sCode(ae), "  %", prefix, "_ap0 = add i64 0, 0\n")
  } yield mkS(str4(pre, "  %", prefix, str5("_box = call ptr @sz_box_i64(i64 ", v, ")\n  %", prefix, str4("_adt = call ptr @sz_adt_new(i32 ", tag, ", ptr %", Str.concat(prefix, "_box)\n")))), str3("%", prefix, "_adt"), EmitKind.Ptr, sId(ae), sConts(ae))

def emitAdtMulti(strs: List, enumName: String, caseName: String, ctx: List, env: List, prefix: String, id: Int, conts: String, tag: String, args: List): Emit =
  for {
    pty = payloadLookup(ctxPayloads(ctx), enumName, caseName)
    tys = pty
  } yield emitAdtMultiPack(strs, List.reverse(args), List.reverse(tys), ctx, env, prefix, id, conts, tag, List.len(args), str3("  %", prefix, "_pl0 = call ptr @sz_list_nil()\n"), str3("%", prefix, "_pl0"), 0)

def emitAdtMultiPack(strs: List, argsRev: List, tysRev: List, ctx: List, env: List, prefix: String, id: Int, conts: String, tag: String, n: Int, code: String, cur: String, packed: Int): Emit =
  if (List.isEmpty(argsRev) == 1) mkS(str4(code, "  %", prefix, str5("_adt = call ptr @sz_adt_new(i32 ", tag, ", ptr ", cur, ")\n")), str3("%", prefix, "_adt"), EmitKind.Ptr, id, conts) else emitAdtMultiPackOne(strs, List.head(argsRev), List.at(tysRev, 0), List.tail(argsRev), List.tail(tysRev), ctx, env, prefix, id, conts, tag, n, code, cur, packed)

def emitAdtMultiPackOne(strs: List, arg: Expr, ty: Type, argsRev: List, tysRev: List, ctx: List, env: List, prefix: String, id: Int, conts: String, tag: String, n: Int, code: String, cur: String, packed: Int): Emit =
  for {
    idx = n - 1 - packed
    ae = emitExpr(arg, strs, ctx, env, str3(prefix, "_ap", Str.fromInt(idx)), id, conts)
    next = str3("%", prefix, Str.concat("_pl", Str.fromInt(packed + 1)))
    boxed = if (tyEq(ty, Type.Int) == 1) emitAdtMultiBoxInt(ae, prefix, idx, code, next, cur) else pair(str4(code, sCode(ae), "  ", str4(next, " = call ptr @sz_list_cons(ptr ", sValue(ae), str3(", ptr ", cur, ")\n"))), next)
  } yield emitAdtMultiPack(strs, argsRev, tysRev, ctx, env, prefix, sId(ae), sConts(ae), tag, n, fst(boxed), snd(boxed), packed + 1)

def emitAdtMultiBoxInt(ae: Emit, prefix: String, idx: Int, code: String, next: String, cur: String): List =
  for {
    v = if (kindIsInt(sKind(ae)) == 1) sValue(ae) else str3("%", prefix, Str.concat("_ap", Str.concat(Str.fromInt(idx), "i")))
    pre0 = str3(code, sCode(ae), "")
    pre = if (kindIsInt(sKind(ae)) == 1) pre0 else str4(pre0, "  %", prefix, Str.concat("_ap", str3(Str.fromInt(idx), "i = add i64 0, 0\n", "")))
    bx = str3("%", prefix, Str.concat("_bx", Str.fromInt(idx)))
  } yield pair(str4(pre, "  ", bx, str5(" = call ptr @sz_box_i64(i64 ", v, ")\n  ", next, str3(" = call ptr @sz_list_cons(ptr ", bx, str3(", ptr ", cur, ")\n")))), next)

def emitSwitchLabels(arms: List, tags: List, prefix: String, mid: Int, i: Int): String =
  if (List.isEmpty(arms) == 1) "" else emitSwitchLabelOne(List.head(arms), List.tail(arms), tags, prefix, mid, i)

def emitSwitchLabelOne(arm: MatchArm, rest: List, tags: List, prefix: String, mid: Int, i: Int): String =
  emitSwitchLabelPat(armPat(arm), rest, tags, prefix, mid, i)

def emitSwitchLabelPat(pat: Pattern, rest: List, tags: List, prefix: String, mid: Int, i: Int): String =
  pat match {
    case Pattern.Wild => emitSwitchLabels(rest, tags, prefix, mid, i + 1)
    case Pattern.Adt(enumName, caseName, binds, typeArgs) => str5(" i32 ", tagLookup(tags, enumName, caseName), ", label %", str4(prefix, "_arm_", Str.fromInt(mid), str3("_", Str.fromInt(i), "")), emitSwitchLabels(rest, tags, prefix, mid, i + 1))
  }

def emitMatch(strs: List, scrut: Expr, arms: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    se = emitExpr(scrut, strs, ctx, env, Str.concat(prefix, "_sc"), id, conts)
  } yield emitMatchAfterScrut(strs, arms, ctx, env, prefix, se)

def emitMatchAfterScrut(strs: List, arms: List, ctx: List, env: List, prefix: String, se: Emit): Emit =
  for {
    mid = sId(se)
    merge = str4(prefix, "_merge_", Str.fromInt(mid), "")
    defaultL = str4(prefix, "_default_", Str.fromInt(mid), "")
    sw = str4(sCode(se), "  %", prefix, str5("_tag = call i32 @sz_adt_tag(ptr ", sValue(se), ")\n  switch i32 %", prefix, str5("_tag, label %", defaultL, " [", emitSwitchLabels(arms, ctxTags(ctx), prefix, mid, 0), " ]\n")))
    ar = emitMatchArms(strs, arms, ctx, env, prefix, mid, merge, sValue(se), sId(se) + 1, sConts(se), sw, "", EmitKind.Io, 0)
  } yield emitMatchDefault(strs, arms, ctx, env, prefix, mid, merge, defaultL, ar)

def emitMatchArms(strs: List, arms: List, ctx: List, env: List, prefix: String, mid: Int, merge: String, scrut: String, id: Int, conts: String, code: String, phi: String, kind: EmitKind, i: Int): Emit =
  if (List.isEmpty(arms) == 1) mkS(code, phi, kind, id, conts) else emitMatchArmOne(List.head(arms), List.tail(arms), strs, ctx, env, prefix, mid, merge, scrut, id, conts, code, phi, kind, i)

def emitMatchArmOne(arm: MatchArm, rest: List, strs: List, ctx: List, env: List, prefix: String, mid: Int, merge: String, scrut: String, id: Int, conts: String, code: String, phi: String, kind: EmitKind, i: Int): Emit =
  emitMatchArmOnePat(armPat(arm), arm, rest, strs, ctx, env, prefix, mid, merge, scrut, id, conts, code, phi, kind, i)

def emitMatchArmOnePat(pat: Pattern, arm: MatchArm, rest: List, strs: List, ctx: List, env: List, prefix: String, mid: Int, merge: String, scrut: String, id: Int, conts: String, code: String, phi: String, kind: EmitKind, i: Int): Emit =
  pat match {
    case Pattern.Wild => emitMatchArms(strs, rest, ctx, env, prefix, mid, merge, scrut, id, conts, code, phi, kind, i + 1)
    case Pattern.Adt(enumName, caseName, binds, typeArgs) => emitMatchArmBody(arm, rest, strs, ctx, env, prefix, mid, merge, scrut, id, conts, code, phi, kind, i)
  }

def emitMatchArmBody(arm: MatchArm, rest: List, strs: List, ctx: List, env: List, prefix: String, mid: Int, merge: String, scrut: String, id: Int, conts: String, code: String, phi: String, kind: EmitKind, i: Int): Emit =
  for {
    label = str4(prefix, "_arm_", Str.fromInt(mid), str3("_", Str.fromInt(i), ""))
    armJoin = str4(prefix, "_aj_", Str.fromInt(mid), str3("_", Str.fromInt(i), ""))
    bound = emitPatBind(armPat(arm), ctx, env, prefix, mid, i, scrut)
    ae = emitExpr(armBody(arm), strs, ctx, sndL(bound), str4(prefix, "_a", Str.fromInt(mid), str3("_", Str.fromInt(i), "")), id, conts)
    code2 = str5(code, label, ":\n", fst(bound), str4(sCode(ae), "  br label %", armJoin, str4("\n", armJoin, ":\n  br label %", str3(merge, "\n", ""))))
    phi2 = if (streq(phi, "") == 1) str5(" [ ", sValue(ae), ", %", armJoin, " ]") else str5(phi, ", [ ", sValue(ae), Str.concat(", %", armJoin), " ]")
    kind2 = if (streq(phi, "") == 1) sKind(ae) else kind
  } yield emitMatchArms(strs, rest, ctx, env, prefix, mid, merge, scrut, sId(ae), sConts(ae), code2, phi2, kind2, i + 1)

def emitPatBind(pat: Pattern, ctx: List, env: List, prefix: String, mid: Int, i: Int, scrut: String): List =
  emitPatBindPat(pat, ctx, env, prefix, mid, i, scrut)

def emitPatBindPat(pat: Pattern, ctx: List, env: List, prefix: String, mid: Int, i: Int, scrut: String): List =
  pat match {
    case Pattern.Wild => pairSL("", env)
    case Pattern.Adt(enumName, caseName, binds, typeArgs) => if (List.isEmpty(binds) == 1) pairSL("", env) else emitPatBindPayload(enumName, caseName, binds, typeArgs, ctx, env, prefix, mid, i, scrut)
  }

def emitPatBindPayload(enumName: String, caseName: String, binds: List, typeArgs: List, ctx: List, env: List, prefix: String, mid: Int, i: Int, scrut: String): List =
  for {
    pl = str4(prefix, "_pl", Str.fromInt(mid), str3("_", Str.fromInt(i), ""))
    pty = payloadLookup(ctxPayloads(ctx), enumName, caseName)
    tys = if (List.isEmpty(typeArgs) == 1) pty else overridePatTys(pty, typeArgs, 0, List.empty())
    code = str5("  %", pl, " = call ptr @sz_adt_payload(ptr ", scrut, ")\n")
  } yield if (List.len(binds) == 1) emitPatBindUnary(code, pl, List.head(binds), List.at(tys, 0), env, prefix, mid, i) else emitPatBindMulti(code, pl, binds, tys, env, prefix, mid, i, 0)

def overridePatTys(tys: List, targs: List, i: Int, acc: List): List =
  if (List.isEmpty(tys) == 1) List.reverse(acc) else overridePatTys(List.tail(tys), targs, i + 1, List.cons(patTyAt(List.head(tys), targs, i), acc))

def patTyAt(ty: Type, targs: List, i: Int): Type =
  if (i < List.len(targs)) List.at(targs, i) else ty

def emitPatBindUnary(code: String, pl: String, bind: String, pty: Type, env: List, prefix: String, mid: Int, i: Int): List =
  for {
    bn = str4(prefix, "_b", Str.fromInt(mid), str3("_", Str.fromInt(i), ""))
  } yield if (tyEq(pty, Type.Int) == 1) pairSL(str4(code, "  %", bn, str3(" = call i64 @sz_unbox_i64(ptr %", pl, ")\n")), envPut(env, bind, Str.concat("%", bn), EmitKind.Int)) else pairSL(code, envPut(env, bind, Str.concat("%", pl), EmitKind.Ptr))

def emitPatBindMulti(code: String, pl: String, binds: List, tys: List, env: List, prefix: String, mid: Int, i: Int, fi: Int): List =
  if (List.isEmpty(binds) == 1) pairSL(code, env) else emitPatBindMultiOne(code, pl, List.head(binds), List.at(tys, 0), List.tail(binds), List.tail(tys), env, prefix, mid, i, fi)

def emitPatBindMultiOne(code: String, pl: String, bind: String, ty: Type, binds: List, tys: List, env: List, prefix: String, mid: Int, i: Int, fi: Int): List =
  for {
    cell = str4(prefix, "_c", Str.fromInt(mid), str3("_", Str.fromInt(i), Str.concat("_", Str.fromInt(fi))))
    code2 = str4(code, "  %", cell, str5(" = call ptr @sz_list_at(ptr %", pl, ", i64 ", Str.fromInt(fi), ")\n"))
  } yield if (tyEq(ty, Type.Int) == 1) emitPatBindMultiInt(code2, pl, cell, bind, binds, tys, env, prefix, mid, i, fi) else emitPatBindMulti(code2, pl, binds, tys, envPut(env, bind, Str.concat("%", cell), EmitKind.Ptr), prefix, mid, i, fi + 1)

def emitPatBindMultiInt(code: String, pl: String, cell: String, bind: String, binds: List, tys: List, env: List, prefix: String, mid: Int, i: Int, fi: Int): List =
  for {
    bn = str4(prefix, "_b", Str.fromInt(mid), str3("_", Str.fromInt(i), Str.concat("_", Str.fromInt(fi))))
    code2 = str4(code, "  %", bn, str3(" = call i64 @sz_unbox_i64(ptr %", cell, ")\n"))
  } yield emitPatBindMulti(code2, pl, binds, tys, envPut(env, bind, Str.concat("%", bn), EmitKind.Int), prefix, mid, i, fi + 1)

def emitMatchDefault(strs: List, arms: List, ctx: List, env: List, prefix: String, mid: Int, merge: String, defaultL: String, ar: Emit): Emit =
  for {
    wild = findWildArm(arms)
  } yield if (List.isEmpty(wild) == 1) emitMatchDefaultSynth(prefix, mid, merge, defaultL, ar) else emitMatchDefaultWild(strs, wild, ctx, env, prefix, mid, merge, defaultL, ar)

def emitMatchDefaultWild(strs: List, wild: List, ctx: List, env: List, prefix: String, mid: Int, merge: String, defaultL: String, ar: Emit): Emit =
  for {
    defaultJoin = str4(prefix, "_dj_", Str.fromInt(mid), "")
    ae = emitExpr(armBody(List.head(wild)), strs, ctx, env, str4(prefix, "_aw", Str.fromInt(mid), ""), sId(ar), sConts(ar))
    phi0 = sValue(ar)
    kind0 = sKind(ar)
    kind2 = if (streq(phi0, "") == 1) sKind(ae) else kind0
    phi2 = if (streq(phi0, "") == 1) str5(" [ ", sValue(ae), ", %", defaultJoin, " ]") else str5(phi0, ", [ ", sValue(ae), Str.concat(", %", defaultJoin), " ]")
    code2 = str4(sCode(ar), defaultL, ":\n", str4(sCode(ae), "  br label %", defaultJoin, str4("\n", defaultJoin, ":\n  br label %", str3(merge, "\n", ""))))
  } yield emitMatchFinish(code2, phi2, kind2, sId(ae), sConts(ae), prefix, merge)

def emitMatchDefaultSynth(prefix: String, mid: Int, merge: String, defaultL: String, ar: Emit): Emit =
  for {
    kind = if (streq(sValue(ar), "") == 1) EmitKind.Io else sKind(ar)
    dflt = emitMatchDfltVal(prefix, kind)
    phi0 = sValue(ar)
    phi2 = if (streq(phi0, "") == 1) str5(" [ ", fst(dflt), ", %", defaultL, " ]") else str5(phi0, ", [ ", fst(dflt), Str.concat(", %", defaultL), " ]")
    code2 = str4(sCode(ar), defaultL, ":\n", str4(snd(dflt), "  br label %", merge, "\n"))
  } yield emitMatchFinish(code2, phi2, kind, sId(ar), sConts(ar), prefix, merge)

def emitMatchDfltVal(prefix: String, kind: EmitKind): List =
  if (kindIsInt(kind) == 1) pair(str3("%", prefix, "_dflt"), str3("  %", prefix, "_dflt = add i64 0, 0\n")) else if (kindIsPtr(kind) == 1) pair("null", "") else pair(str3("%", prefix, "_dflt"), str3("  %", prefix, "_dflt = call ptr @sz_io_pure(ptr null)\n"))

def emitMatchFinish(code: String, phi: String, kind: EmitKind, id: Int, conts: String, prefix: String, merge: String): Emit =
  for {
    ty = llvmTyOfKind(kind)
    body = str4(code, merge, ":\n  %", str5(prefix, "_phi = phi ", ty, phi, "\n"))
  } yield mkS(body, str3("%", prefix, "_phi"), kind, id, conts)

def emitAttempt(strs: List, inner: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    ie = emitExpr(inner, strs, ctx, env, Str.concat(prefix, "_at"), id, conts)
    p = ensureIoPair(sCode(ie), sKind(ie), sValue(ie), Str.concat(prefix, "_atio"))
  } yield mkS(str4(fst(p), "  %", prefix, str3("_attempt = call ptr @sz_io_attempt(ptr ", snd(p), ")\n")), str3("%", prefix, "_attempt"), EmitKind.Io, sId(ie), sConts(ie))

def emitRaceBoth(strs: List, left: Expr, right: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String, which: String): Emit =
  for {
    le = emitExpr(left, strs, ctx, env, Str.concat(prefix, "_rl"), id, conts)
    re = emitExpr(right, strs, ctx, env, Str.concat(prefix, "_rr"), sId(le), sConts(le))
    lp = ensureIoPair(sCode(le), sKind(le), sValue(le), Str.concat(prefix, "_rlio"))
    rp = ensureIoPair(Str.concat(fst(lp), sCode(re)), sKind(re), sValue(re), Str.concat(prefix, "_rrio"))
    fn = if (streq(which, "race") == 1) "@sz_io_race" else if (streq(which, "both") == 1) "@sz_io_both" else "@sz_io_ensure"
  } yield mkS(str4(fst(rp), "  %", prefix, str5("_v = call ptr ", fn, "(ptr ", snd(lp), str3(", ptr ", snd(rp), ")\n"))), str3("%", prefix, "_v"), EmitKind.Io, sId(re), sConts(re))

def emitTimeout(strs: List, ms: Expr, inner: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    me = emitExpr(ms, strs, ctx, env, Str.concat(prefix, "_ms"), id, conts)
    ie = emitExpr(inner, strs, ctx, env, Str.concat(prefix, "_ti"), sId(me), sConts(me))
    ip = ensureIoPair(sCode(ie), sKind(ie), sValue(ie), Str.concat(prefix, "_tiio"))
  } yield emitTimeoutCont(me, ip, prefix, sId(ie), sConts(ie))

def emitTimeoutCont(me: Emit, ip: List, prefix: String, id: Int, conts: String): Emit =
  if (kindIsInt(sKind(me)) == 1) mkS(str4(sCode(me), fst(ip), "  %", str3(prefix, "_timeout = call ptr @sz_io_timeout(i64 ", str4(sValue(me), ", ptr ", snd(ip), ")\n"))), str3("%", prefix, "_timeout"), EmitKind.Io, id, conts) else mkS(str4(sCode(me), str3("  %", prefix, "_ms0 = add i64 0, 0\n"), fst(ip), str3("  %", prefix, str4("_timeout = call ptr @sz_io_timeout(i64 %", prefix, "_ms0, ptr ", str3(snd(ip), ")\n", "")))), str3("%", prefix, "_timeout"), EmitKind.Io, id, conts)

def nameInList(names: List, n: String): Int =
  if (List.isEmpty(names) == 1) 0 else if (streq(List.head(names), n) == 1) 1 else nameInList(List.tail(names), n)

def captureNames(env: List, acc: List): List =
  if (List.isEmpty(env) == 1) List.reverse(acc) else captureNamesCont(List.head(env), List.tail(env), acc)

def captureNamesCont(b: EnvBind, rest: List, acc: List): List =
  b match {
    case EnvBind.Bind(n, value, kind) => if (nameInList(acc, n) == 1) captureNames(rest, acc) else captureNames(rest, List.cons(n, acc))
  }

def packEnvRev(revNames: List, env: List, prefix: String, i: Int, code: String, cur: String): List =
  if (List.isEmpty(revNames) == 1) pair(code, cur) else packEnvRevOne(List.head(revNames), List.tail(revNames), env, prefix, i, code, cur)

def packEnvRevOne(n: String, rest: List, env: List, prefix: String, i: Int, code: String, cur: String): List =
  for {
    b = envGet(env, n)
    v = envBindValue(b)
    k = envBindKind(b)
  } yield if (kindIsInt(k) == 1) packEnvRev(rest, env, prefix, i + 1, str4(code, "  %", prefix, str5("_b", Str.fromInt(i), " = call ptr @sz_box_i64(i64 ", v, str4(")\n  %", prefix, "_", str5(Str.fromInt(i + 1), " = call ptr @sz_list_cons(ptr %", prefix, "_b", str4(Str.fromInt(i), ", ptr ", cur, ")\n"))))), str3("%", prefix, Str.concat("_", Str.fromInt(i + 1)))) else packEnvRev(rest, env, prefix, i + 1, str4(code, "  %", prefix, str4("_", Str.fromInt(i + 1), " = call ptr @sz_list_cons(ptr ", str4(v, ", ptr ", cur, ")\n"))), str3("%", prefix, Str.concat("_", Str.fromInt(i + 1))))

def packEnv(env: List, prefix: String, code: String): List =
  for {
    names = captureNames(env, List.empty())
  } yield if (List.isEmpty(names) == 1) pair(code, "null") else packEnvRev(List.reverse(names), env, prefix, 0, str4(code, "  %", prefix, "_0 = call ptr @sz_list_nil()\n"), str3("%", prefix, "_0"))

def unpackEnvAt(names: List, prefix: String, i: Int, cur: String, code: String, envAcc: List, outer: List): List =
  if (List.isEmpty(names) == 1) pairSL(code, envAcc) else unpackEnvOne(List.head(names), List.tail(names), prefix, i, cur, code, envAcc, outer)

def unpackEnvOne(n: String, rest: List, prefix: String, i: Int, cur: String, code: String, envAcc: List, outer: List): List =
  for {
    k = envGetKind(outer, n)
    h = str4("%", prefix, "_h", Str.fromInt(i))
    t = str4("%", prefix, "_t", Str.fromInt(i))
    code2 = str4(code, "  ", h, str4(" = call ptr @sz_list_head(ptr ", cur, ")\n  ", str4(t, " = call ptr @sz_list_tail(ptr ", cur, ")\n")))
  } yield if (kindIsInt(k) == 1) unpackEnvAt(rest, prefix, i + 1, t, str4(code2, "  %", n, str3(" = call i64 @sz_unbox_i64(ptr ", h, ")\n")), envPut(envAcc, n, Str.concat("%", n), EmitKind.Int), outer) else unpackEnvAt(rest, prefix, i + 1, t, code2, envPut(envAcc, n, h, k), outer)

def unpackEnv(names: List, prefix: String, outer: List): List =
  if (List.isEmpty(names) == 1) pairSL("", List.empty()) else unpackEnvAt(names, prefix, 0, "%env", "", List.empty(), outer)

def flatMapResultKind(bodyKind: EmitKind): EmitKind =
  if (isIoKind(bodyKind) == 1) bodyKind else if (kindIsInt(bodyKind) == 1) EmitKind.IoInt else EmitKind.Io

def flatMapBind(param: String, payload: EmitKind, env: List): List =
  if (streq(param, "_") == 1) pairSL("", env) else if (kindIsInt(payload) == 1) pairSL(str3("  %", param, " = call i64 @sz_unbox_i64(ptr %value)\n"), envPut(env, param, Str.concat("%", param), EmitKind.Int)) else pairSL("", envPut(env, param, "%value", EmitKind.Ptr))

def emitHandle(strs: List, inner: Expr, body: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    contName = Str.concat("sz_err_", Str.fromInt(id))
    names = captureNames(env, List.empty())
    up = unpackEnv(names, Str.concat("e", Str.fromInt(id)), env)
    be = emitExpr(body, strs, ctx, sndL(up), Str.concat("e", Str.fromInt(id)), id + 1, conts)
    wrap = ensureIoPair(sCode(be), sKind(be), sValue(be), Str.concat("e", Str.concat(Str.fromInt(id), "_wrap")))
    contDef = str4("define internal ptr @", contName, "(ptr %err, ptr %env) {\nentry:\n", str5(fst(up), fst(wrap), "  ret ptr ", snd(wrap), "\n}\n\n"))
    ie = emitExpr(inner, strs, ctx, env, Str.concat(prefix, "_he"), sId(be), Str.concat(sConts(be), contDef))
    ip = ensureIoPair(sCode(ie), sKind(ie), sValue(ie), Str.concat(prefix, "_heio"))
    packed = packEnv(env, Str.concat(prefix, "_ecap"), fst(ip))
  } yield mkS(str4(fst(packed), "  %", prefix, str5("_h = call ptr @sz_io_handle_error_with(ptr ", snd(ip), ", ptr @", contName, str3(", ptr ", snd(packed), ")\n"))), str3("%", prefix, "_h"), EmitKind.Io, sId(ie), sConts(ie))

def emitFlatMap(strs: List, innerE: Expr, param: String, body: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    contName = Str.concat("sz_cont_", Str.fromInt(id))
    inner = emitExpr(innerE, strs, ctx, env, Str.concat(prefix, "_in"), id + 1, conts)
    payload = payloadOfKind(sKind(inner))
    names = captureNames(env, List.empty())
    up = unpackEnv(names, Str.concat("c", Str.fromInt(id)), env)
    bind = flatMapBind(param, payload, sndL(up))
    be = emitExpr(body, strs, ctx, sndL(bind), Str.concat("c", Str.fromInt(id)), sId(inner), sConts(inner))
    wrap = ensureIoPair(sCode(be), sKind(be), sValue(be), Str.concat("c", Str.concat(Str.fromInt(id), "_wrap")))
    contDef = str4("define internal ptr @", contName, "(ptr %value, ptr %env) {\nentry:\n", str3(fst(up), fst(bind), str4(fst(wrap), "  ret ptr ", snd(wrap), "\n}\n\n")))
    ip = ensureIoPair(sCode(inner), sKind(inner), sValue(inner), Str.concat(prefix, "_inio"))
    packed = packEnv(env, Str.concat(prefix, "_cap"), fst(ip))
  } yield mkS(str4(fst(packed), "  %", prefix, str5("_fm = call ptr @sz_io_flatmap(ptr ", snd(ip), ", ptr @", contName, str3(", ptr ", snd(packed), ")\n"))), str3("%", prefix, "_fm"), flatMapResultKind(sKind(be)), sId(be), Str.concat(sConts(be), contDef))

def emitInterp(strs: List, parts: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  emitInterpParts(strs, parts, ctx, env, prefix, id, conts, "", "", 0)

def emitInterpParts(strs: List, parts: List, ctx: List, env: List, prefix: String, id: Int, conts: String, code: String, acc: String, i: Int): Emit =
  if (List.isEmpty(parts) == 1) if (streq(acc, "") == 1) emitSzStringLit(strs, "", prefix, id, conts) else mkS(code, acc, EmitKind.Ptr, id, conts) else emitInterpPart(strs, List.head(parts), List.tail(parts), ctx, env, prefix, id, conts, code, acc, i)

def emitInterpPart(strs: List, part: InterpPart, rest: List, ctx: List, env: List, prefix: String, id: Int, conts: String, code: String, acc: String, i: Int): Emit =
  part match {
    case InterpPart.Lit(text) => emitInterpPiece(strs, rest, ctx, env, prefix, id, conts, code, acc, i, emitSzStringLit(strs, text, str4(prefix, "_l", Str.fromInt(i), ""), id, conts))
    case InterpPart.Hole(expr) => emitInterpHole(strs, rest, ctx, env, prefix, id, conts, code, acc, i, emitExpr(expr, strs, ctx, env, str4(prefix, "_e", Str.fromInt(i), ""), id, conts))
  }

def emitInterpHole(strs: List, rest: List, ctx: List, env: List, prefix: String, id: Int, conts: String, code: String, acc: String, i: Int, pe: Emit): Emit =
  if (kindIsInt(sKind(pe)) == 1) emitInterpPiece(strs, rest, ctx, env, prefix, sId(pe), sConts(pe), str4(code, sCode(pe), "  %", str6(prefix, "_s", Str.fromInt(i), " = call ptr @sz_string_from_int(i64 ", sValue(pe), ")\n")), acc, i, mkS("", str4("%", prefix, "_s", Str.fromInt(i)), EmitKind.Ptr, sId(pe), sConts(pe))) else emitInterpPiece(strs, rest, ctx, env, prefix, sId(pe), sConts(pe), str3(code, sCode(pe), ""), acc, i, pe)

def emitInterpPiece(strs: List, rest: List, ctx: List, env: List, prefix: String, id: Int, conts: String, code: String, acc: String, i: Int, pe: Emit): Emit =
  if (streq(acc, "") == 1) emitInterpParts(strs, rest, ctx, env, prefix, id, conts, str3(code, sCode(pe), ""), sValue(pe), i + 1) else emitInterpParts(strs, rest, ctx, env, prefix, id, conts, str4(code, sCode(pe), "  %", str6(prefix, "_c", Str.fromInt(i), " = call ptr @sz_string_concat(ptr ", acc, str3(", ptr ", sValue(pe), ")\n"))), str4("%", prefix, "_c", Str.fromInt(i)), i + 1)

def emitLambda(strs: List, param: String, body: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    fnName = Str.concat("sz_tap_", Str.fromInt(id))
    names = captureNames(env, List.empty())
    up = unpackEnv(names, Str.concat("t", Str.fromInt(id)), env)
    benv = lambdaBind(param, sndL(up))
    be = emitExpr(body, strs, ctx, benv, Str.concat("t", Str.fromInt(id)), id + 1, conts)
    bodyEnd = if (isIoKind(sKind(be)) == 1) emitTapIoRun(sCode(be), sValue(be), id) else str4(sCode(be), "  ret void\n", "", "")
    contDef = str4("define internal void @", fnName, "(ptr %self, ptr %env) {\nentry:\n", str4(fst(up), bodyEnd, "}\n\n", ""))
  } yield emitLambdaClosure(env, prefix, fnName, sId(be), Str.concat(sConts(be), contDef))

def emitTapIoRun(code: String, ioVal: String, id: Int): String =
  for {
    sid = Str.fromInt(id)
    a = str3(code, "  %t", sid)
    b = str3("_ur = call ptr @sz_io_unsafe_run_or_die(ptr ", ioVal, ")\n  ret void\n")
  } yield Str.concat(a, b)

def emitMapIoRun(code: String, ioVal: String, id: Int): String =
  for {
    sid = Str.fromInt(id)
    a = str3(code, "  %m", sid)
    b = str3("_ok = call ptr @sz_io_unsafe_run_or_die(ptr ", ioVal, ")\n  ret ptr %m")
    c = str3(sid, "_ok\n", "")
  } yield Str.concat(a, Str.concat(b, c))

def lambdaBind(param: String, env: List): List =
  if (streq(param, "_") == 1) env else envPut(env, param, "%self", EmitKind.Ptr)

def emitLambdaClosure(env: List, prefix: String, fnName: String, id: Int, conts: String): Emit =
  for {
    packed = packEnv(env, Str.concat(prefix, "_cap"), "")
    code = str4(fst(packed), "  %", prefix, str5("_cl0 = call ptr @sz_list_nil()\n  %", prefix, "_cl1 = call ptr @sz_list_cons(ptr ", snd(packed), str6(", ptr %", prefix, "_cl0)\n  %", prefix, "_cl2 = call ptr @sz_list_cons(ptr @", str4(fnName, ", ptr %", prefix, "_cl1)\n"))))
  } yield mkS(code, str3("%", prefix, "_cl2"), EmitKind.Ptr, id, conts)

def emitCall(strs: List, callee: String, args: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  if (streq(callee, "Signal.map") == 1) emitSignalMap(strs, args, ctx, env, prefix, id, conts) else if (startsWith(callee, "Resource.") == 1) emitResource(strs, callee, args, ctx, env, prefix, id, conts) else if (streq(callee, "Stream.evalMap") == 1) emitStreamEvalMap(strs, args, ctx, env, prefix, id, conts) else if (streq(callee, "Stream.filter") == 1) emitStreamPred(strs, args, ctx, env, prefix, id, conts, "sz_stream_filter") else if (streq(callee, "Stream.takeWhile") == 1) emitStreamPred(strs, args, ctx, env, prefix, id, conts, "sz_stream_takewhile") else if (streq(callee, "Stream.dropWhile") == 1) emitStreamPred(strs, args, ctx, env, prefix, id, conts, "sz_stream_dropwhile") else if (streq(callee, "Stream.find") == 1) emitStreamPred(strs, args, ctx, env, prefix, id, conts, "sz_stream_find") else if (streq(callee, "Stream.exists") == 1) emitStreamExists(strs, args, ctx, env, prefix, id, conts) else if (streq(callee, "Stream.map") == 1) emitStreamMap(strs, args, ctx, env, prefix, id, conts) else if (streq(callee, "Net.serveOnce") == 1) emitNetServeRt(strs, args, ctx, env, prefix, id, conts, "sz_net_serve_once") else if (streq(callee, "Net.serve") == 1) emitNetServeRt(strs, args, ctx, env, prefix, id, conts, "sz_net_serve") else if (streq(callee, "Ui.run") == 1) emitUiRun(strs, args, ctx, env, prefix, id, conts) else emitCallArgs(strs, callee, args, ctx, env, prefix, id, conts)

def emitCallArgs(strs: List, callee: String, args: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    ae = emitArgList(args, strs, ctx, env, prefix, 0, id, conts, "", List.empty(), List.empty())
  } yield emitCallWithArgs(callee, ae, ctx, prefix)

def emitResource(strs: List, callee: String, args: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    first = emitExpr(List.head(args), strs, ctx, env, Str.concat(prefix, "_a0"), id, conts)
    lam = emitIoContLambda(strs, List.head(List.tail(args)), ctx, env, Str.concat(prefix, "_fn"), sId(first), sConts(first))
    code0 = str3(sCode(first), sCode(lam), "")
    code1 = str4(code0, "  %", prefix, str3("_fnp = call ptr @sz_list_head(ptr ", sValue(lam), ")\n"))
    code2 = str4(code1, "  %", prefix, str3("_fnt = call ptr @sz_list_tail(ptr ", sValue(lam), ")\n"))
    code3 = str4(code2, "  %", prefix, str4("_envp = call ptr @sz_list_head(ptr %", prefix, "_fnt)\n", ""))
  } yield emitResourceCall(callee, first, lam, code3, prefix)

def emitResourceCall(callee: String, first: Emit, lam: Emit, code: String, prefix: String): Emit =
  if (streq(callee, "Resource.make") == 1) emitResourceMakeCall(first, lam, code, prefix) else emitResourceUseCall(first, lam, code, prefix)

def emitResourceMakeCall(first: Emit, lam: Emit, code: String, prefix: String): Emit =
  for {
    acq = ensureIoPair(code, sKind(first), sValue(first), Str.concat(prefix, "_acq"))
    c = str4(fst(acq), "  %", prefix, str5("_v = call ptr @sz_lang_resource_make(ptr ", snd(acq), ", ptr %", prefix, str4("_fnp, ptr %", prefix, "_envp)\n", "")))
  } yield mkS(c, str3("%", prefix, "_v"), EmitKind.Ptr, sId(lam), sConts(lam))

def emitResourceUseCall(first: Emit, lam: Emit, code: String, prefix: String): Emit =
  mkS(str4(code, "  %", prefix, str5("_v = call ptr @sz_lang_resource_use(ptr ", sValue(first), ", ptr %", prefix, str4("_fnp, ptr %", prefix, "_envp)\n", ""))), str3("%", prefix, "_v"), EmitKind.Io, sId(lam), sConts(lam))

def emitStreamEvalMap(strs: List, args: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    first = emitExpr(List.head(args), strs, ctx, env, Str.concat(prefix, "_a0"), id, conts)
    lam = emitIoContLambda(strs, List.head(List.tail(args)), ctx, env, Str.concat(prefix, "_fn"), sId(first), sConts(first))
    code0 = str3(sCode(first), sCode(lam), "")
    code1 = str4(code0, "  %", prefix, str3("_fnp = call ptr @sz_list_head(ptr ", sValue(lam), ")\n"))
    code2 = str4(code1, "  %", prefix, str3("_fnt = call ptr @sz_list_tail(ptr ", sValue(lam), ")\n"))
    code3 = str4(code2, "  %", prefix, str4("_envp = call ptr @sz_list_head(ptr %", prefix, "_fnt)\n", ""))
  } yield mkS(str4(code3, "  %", prefix, str5("_v = call ptr @sz_stream_evalmap(ptr ", sValue(first), ", ptr %", prefix, str4("_fnp, ptr %", prefix, "_envp)\n", ""))), str3("%", prefix, "_v"), EmitKind.Ptr, sId(lam), sConts(lam))

def emitStreamPred(strs: List, args: List, ctx: List, env: List, prefix: String, id: Int, conts: String, rt: String): Emit =
  for {
    first = emitExpr(List.head(args), strs, ctx, env, Str.concat(prefix, "_a0"), id, conts)
    lam = emitPredLambda(strs, List.head(List.tail(args)), ctx, env, Str.concat(prefix, "_fn"), sId(first), sConts(first))
    code0 = str3(sCode(first), sCode(lam), "")
    code1 = str4(code0, "  %", prefix, str3("_fnp = call ptr @sz_list_head(ptr ", sValue(lam), ")\n"))
    code2 = str4(code1, "  %", prefix, str3("_fnt = call ptr @sz_list_tail(ptr ", sValue(lam), ")\n"))
    code3 = str4(code2, "  %", prefix, str4("_envp = call ptr @sz_list_head(ptr %", prefix, "_fnt)\n", ""))
  } yield mkS(str4(code3, "  %", prefix, str4("_v = call ptr @", rt, str5("(ptr ", sValue(first), ", ptr %", prefix, str4("_fnp, ptr %", prefix, "_envp)\n", "")), "")), str3("%", prefix, "_v"), EmitKind.Ptr, sId(lam), sConts(lam))

def emitStreamExists(strs: List, args: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    e = emitStreamPred(strs, args, ctx, env, prefix, id, conts, "sz_stream_exists")
  } yield mkS(sCode(e), sValue(e), EmitKind.IoInt, sId(e), sConts(e))

def emitStreamMap(strs: List, args: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    first = emitExpr(List.head(args), strs, ctx, env, Str.concat(prefix, "_a0"), id, conts)
    lam = emitSmapLambda(strs, List.head(List.tail(args)), ctx, env, Str.concat(prefix, "_fn"), sId(first), sConts(first))
    code0 = str3(sCode(first), sCode(lam), "")
    code1 = str4(code0, "  %", prefix, str3("_fnp = call ptr @sz_list_head(ptr ", sValue(lam), ")\n"))
    code2 = str4(code1, "  %", prefix, str3("_fnt = call ptr @sz_list_tail(ptr ", sValue(lam), ")\n"))
    code3 = str4(code2, "  %", prefix, str4("_envp = call ptr @sz_list_head(ptr %", prefix, "_fnt)\n", ""))
  } yield mkS(str4(code3, "  %", prefix, str5("_v = call ptr @sz_stream_map(ptr ", sValue(first), ", ptr %", prefix, str4("_fnp, ptr %", prefix, "_envp)\n", ""))), str3("%", prefix, "_v"), EmitKind.Ptr, sId(lam), sConts(lam))

def emitNetServeOnce(strs: List, args: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  emitNetServeRt(strs, args, ctx, env, prefix, id, conts, "sz_net_serve_once")

def emitNetServeRt(strs: List, args: List, ctx: List, env: List, prefix: String, id: Int, conts: String, rt: String): Emit =
  for {
    first = emitExpr(List.head(args), strs, ctx, env, Str.concat(prefix, "_a0"), id, conts)
    lam = emitIoContLambda(strs, List.head(List.tail(args)), ctx, env, Str.concat(prefix, "_fn"), sId(first), sConts(first))
    code0 = str3(sCode(first), sCode(lam), "")
    code1 = str4(code0, "  %", prefix, str3("_fnp = call ptr @sz_list_head(ptr ", sValue(lam), ")\n"))
    code2 = str4(code1, "  %", prefix, str3("_fnt = call ptr @sz_list_tail(ptr ", sValue(lam), ")\n"))
    code3 = str4(code2, "  %", prefix, str4("_envp = call ptr @sz_list_head(ptr %", prefix, "_fnt)\n", ""))
  } yield mkS(str4(code3, "  %", prefix, str4("_v = call ptr @", rt, str5("(i64 ", sValue(first), ", ptr %", prefix, str4("_fnp, ptr %", prefix, "_envp)\n", "")), "")), str3("%", prefix, "_v"), EmitKind.Io, sId(lam), sConts(lam))

def emitUiRun(strs: List, args: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  emitUiRunMatch(List.head(args), strs, ctx, env, prefix, id, conts)

def emitUiRunMatch(e: Expr, strs: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  e match {
    case Expr.Lambda(param, body, span) => emitUiRunRebuild(strs, param, body, ctx, env, prefix, id, conts)
    case Expr.Unit(span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.IntLit(digits, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.StrLit(value, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.ListLit(elems, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.Interp(parts, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.Var(name, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.Field(base, field, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.MethodCall(receiver, method, args, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.Call(callee, args, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.BinOp(op, left, right, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.If(cond, thenB, elseB, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.For(binders, body, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.Let(name, value, body, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.FlatMap(inner, param, body, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.Handle(inner, body, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.Attempt(inner, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.Match(scrut, arms, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.Println(arg, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.Fail(arg, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.Pure(arg, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.Sleep(arg, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.IoRace(left, right, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.IoBoth(left, right, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.IoEnsure(inner, finalizer, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
    case Expr.IoTimeout(ms, inner, span) => emitUiRunView(e, strs, ctx, env, prefix, id, conts)
  }

def emitUiRunView(e: Expr, strs: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    root = emitExpr(e, strs, ctx, env, Str.concat(prefix, "_a0"), id, conts)
  } yield mkS(str4(sCode(root), "  %", prefix, str3("_v = call ptr @sz_ui_run_view(ptr ", sValue(root), ")\n")), str3("%", prefix, "_v"), EmitKind.Io, sId(root), sConts(root))

def emitUiRunRebuild(strs: List, param: String, body: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    fnName = Str.concat("sz_uibuild_", Str.fromInt(id))
    names = captureNames(env, List.empty())
    up = unpackEnv(names, Str.concat("u", Str.fromInt(id)), env)
    benv = rebuildBind(param, sndL(up))
    be = emitExpr(body, strs, ctx, benv, Str.concat("u", Str.fromInt(id)), id + 1, conts)
    bodyEnd = str4(sCode(be), "  ret ptr ", sValue(be), "\n")
    contDef = str4("define internal ptr @", fnName, "(ptr %env) {\nentry:\n", str4(fst(up), bodyEnd, "}\n\n", ""))
    lam = emitLambdaClosure(env, Str.concat(prefix, "_fn"), fnName, sId(be), Str.concat(sConts(be), contDef))
    code0 = sCode(lam)
    code1 = str4(code0, "  %", prefix, str3("_fnp = call ptr @sz_list_head(ptr ", sValue(lam), ")\n"))
    code2 = str4(code1, "  %", prefix, str3("_fnt = call ptr @sz_list_tail(ptr ", sValue(lam), ")\n"))
    code3 = str4(code2, "  %", prefix, str4("_envp = call ptr @sz_list_head(ptr %", prefix, "_fnt)\n", ""))
    code4 = str4(code3, "  %", prefix, str5("_v = call ptr @sz_ui_run_rebuild(ptr %", prefix, "_fnp, ptr %", prefix, "_envp)\n"))
  } yield mkS(code4, str3("%", prefix, "_v"), EmitKind.Io, sId(lam), sConts(lam))

def rebuildBind(param: String, env: List): List =
  if (streq(param, "_") == 1) env else envPut(env, param, "%env", EmitKind.Ptr)

def emitIoContLambda(strs: List, e: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  emitIoContLambdaMatch(e, strs, ctx, env, prefix, id, conts)

def emitIoContLambdaMatch(e: Expr, strs: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  e match {
    case Expr.Lambda(param, body, span) => emitIoContLambdaBody(strs, param, body, ctx, env, prefix, id, conts)
    case Expr.Unit(span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IntLit(digits, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.StrLit(value, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.ListLit(elems, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Interp(parts, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Var(name, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Field(base, field, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.MethodCall(receiver, method, args, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Call(callee, args, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.BinOp(op, left, right, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.If(cond, thenB, elseB, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.For(binders, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Let(name, value, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.FlatMap(inner, param, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Handle(inner, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Attempt(inner, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Match(scrut, arms, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Println(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Fail(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Pure(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Sleep(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoRace(left, right, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoBoth(left, right, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoEnsure(inner, finalizer, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoTimeout(ms, inner, span) => mkS("", "null", EmitKind.Ptr, id, conts)
  }

def emitIoContLambdaBody(strs: List, param: String, body: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    fnName = Str.concat("sz_rcont_", Str.fromInt(id))
    names = captureNames(env, List.empty())
    up = unpackEnv(names, Str.concat("r", Str.fromInt(id)), env)
    benv = ioContBind(param, sndL(up))
    be = emitExpr(body, strs, ctx, benv, Str.concat("r", Str.fromInt(id)), id + 1, conts)
    wrap = ensureIoPair(sCode(be), sKind(be), sValue(be), Str.concat("r", Str.concat(Str.fromInt(id), "_wrap")))
    contDef = str4("define internal ptr @", fnName, "(ptr %value, ptr %env) {\nentry:\n", str4(fst(up), fst(wrap), "  ret ptr ", str3(snd(wrap), "\n}\n\n", "")))
  } yield emitLambdaClosure(env, prefix, fnName, sId(be), Str.concat(sConts(be), contDef))

def ioContBind(param: String, env: List): List =
  if (streq(param, "_") == 1) env else envPut(env, param, "%value", EmitKind.Ptr)

def emitPredLambda(strs: List, e: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  emitPredLambdaMatch(e, strs, ctx, env, prefix, id, conts)

def emitPredLambdaMatch(e: Expr, strs: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  e match {
    case Expr.Lambda(param, body, span) => emitPredLambdaBody(strs, param, body, ctx, env, prefix, id, conts)
    case Expr.Unit(span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IntLit(digits, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.StrLit(value, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.ListLit(elems, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Interp(parts, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Var(name, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Field(base, field, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.MethodCall(receiver, method, args, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Call(callee, args, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.BinOp(op, left, right, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.If(cond, thenB, elseB, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.For(binders, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Let(name, value, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.FlatMap(inner, param, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Handle(inner, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Attempt(inner, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Match(scrut, arms, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Println(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Fail(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Pure(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Sleep(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoRace(left, right, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoBoth(left, right, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoEnsure(inner, finalizer, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoTimeout(ms, inner, span) => mkS("", "null", EmitKind.Ptr, id, conts)
  }

def emitPredLambdaBody(strs: List, param: String, body: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    fnName = Str.concat("sz_pred_", Str.fromInt(id))
    names = captureNames(env, List.empty())
    up = unpackEnv(names, Str.concat("p", Str.fromInt(id)), env)
    benv = ioContBind(param, sndL(up))
    be = emitExpr(body, strs, ctx, benv, Str.concat("p", Str.fromInt(id)), id + 1, conts)
    bodyEnd = predLambdaRet(be)
    contDef = str4("define internal i64 @", fnName, "(ptr %value, ptr %env) {\nentry:\n", str4(fst(up), bodyEnd, "}\n\n", ""))
  } yield emitLambdaClosure(env, prefix, fnName, sId(be), Str.concat(sConts(be), contDef))

def predLambdaRet(be: Emit): String =
  if (kindIsInt(sKind(be)) == 1) str4(sCode(be), "  ret i64 ", sValue(be), "\n") else Str.concat(sCode(be), "  ret i64 0\n")

def emitSmapLambda(strs: List, e: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  emitSmapLambdaMatch(e, strs, ctx, env, prefix, id, conts)

def emitSmapLambdaMatch(e: Expr, strs: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  e match {
    case Expr.Lambda(param, body, span) => emitSmapLambdaBody(strs, param, body, ctx, env, prefix, id, conts)
    case Expr.Unit(span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IntLit(digits, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.StrLit(value, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.ListLit(elems, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Interp(parts, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Var(name, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Field(base, field, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.MethodCall(receiver, method, args, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Call(callee, args, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.BinOp(op, left, right, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.If(cond, thenB, elseB, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.For(binders, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Let(name, value, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.FlatMap(inner, param, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Handle(inner, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Attempt(inner, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Match(scrut, arms, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Println(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Fail(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Pure(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Sleep(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoRace(left, right, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoBoth(left, right, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoEnsure(inner, finalizer, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoTimeout(ms, inner, span) => mkS("", "null", EmitKind.Ptr, id, conts)
  }

def emitSmapLambdaBody(strs: List, param: String, body: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    fnName = Str.concat("sz_smap_", Str.fromInt(id))
    names = captureNames(env, List.empty())
    up = unpackEnv(names, Str.concat("sm", Str.fromInt(id)), env)
    benv = ioContBind(param, sndL(up))
    be = emitExpr(body, strs, ctx, benv, Str.concat("sm", Str.fromInt(id)), id + 1, conts)
    bodyEnd = smapLambdaRet(be, id)
    contDef = str4("define internal ptr @", fnName, "(ptr %value, ptr %env) {\nentry:\n", str4(fst(up), bodyEnd, "}\n\n", ""))
  } yield emitLambdaClosure(env, prefix, fnName, sId(be), Str.concat(sConts(be), contDef))

def smapLambdaRet(be: Emit, id: Int): String =
  if (kindIsInt(sKind(be)) == 1) str5(sCode(be), "  %sm", Str.fromInt(id), str3("_istr = call ptr @sz_string_from_int(i64 ", sValue(be), ")\n  ret ptr %sm"), Str.concat(Str.fromInt(id), "_istr\n")) else str4(sCode(be), "  ret ptr ", sValue(be), "\n")

def emitSignalMap(strs: List, args: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    src = emitExpr(List.head(args), strs, ctx, env, Str.concat(prefix, "_src"), id, conts)
    lam = List.head(List.tail(args))
    mapper = emitMapLambda(strs, lam, ctx, env, Str.concat(prefix, "_fn"), sId(src), sConts(src))
    code0 = str3(sCode(src), sCode(mapper), "")
    code1 = str4(code0, "  %", prefix, str3("_fnp = call ptr @sz_list_head(ptr ", sValue(mapper), ")\n"))
    code2 = str4(code1, "  %", prefix, str3("_fnt = call ptr @sz_list_tail(ptr ", sValue(mapper), ")\n"))
    code3 = str4(code2, "  %", prefix, str4("_envp = call ptr @sz_list_head(ptr %", prefix, "_fnt)\n", ""))
    code4 = str4(code3, "  %", prefix, str5("_v = call ptr @sz_lang_signal_map(ptr ", sValue(src), ", ptr %", prefix, str4("_fnp, ptr %", prefix, "_envp)\n", "")))
  } yield mkS(code4, str3("%", prefix, "_v"), EmitKind.Ptr, sId(mapper), sConts(mapper))

def emitMapLambda(strs: List, e: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  emitMapLambdaMatch(e, strs, ctx, env, prefix, id, conts)

def emitMapLambdaMatch(e: Expr, strs: List, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  e match {
    case Expr.Lambda(param, body, span) => emitMapLambdaBody(strs, param, body, ctx, env, prefix, id, conts)
    case Expr.Unit(span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IntLit(digits, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.StrLit(value, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.ListLit(elems, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Interp(parts, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Var(name, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Field(base, field, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.MethodCall(receiver, method, args, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Call(callee, args, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.BinOp(op, left, right, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.If(cond, thenB, elseB, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.For(binders, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Let(name, value, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.FlatMap(inner, param, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Handle(inner, body, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Attempt(inner, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Match(scrut, arms, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Println(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Fail(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Pure(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.Sleep(arg, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoRace(left, right, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoBoth(left, right, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoEnsure(inner, finalizer, span) => mkS("", "null", EmitKind.Ptr, id, conts)
    case Expr.IoTimeout(ms, inner, span) => mkS("", "null", EmitKind.Ptr, id, conts)
  }

def emitMapLambdaBody(strs: List, param: String, body: Expr, ctx: List, env: List, prefix: String, id: Int, conts: String): Emit =
  for {
    fnName = Str.concat("sz_map_", Str.fromInt(id))
    names = captureNames(env, List.empty())
    up = unpackEnv(names, Str.concat("m", Str.fromInt(id)), env)
    benv = mapLambdaBind(param, sndL(up))
    be = emitExpr(body, strs, ctx, benv, Str.concat("m", Str.fromInt(id)), id + 1, conts)
    bodyEnd = mapLambdaRet(be, id)
    contDef = str4("define internal ptr @", fnName, "(i64 %n, ptr %env) {\nentry:\n", str4(fst(up), bodyEnd, "}\n\n", ""))
  } yield emitLambdaClosure(env, prefix, fnName, sId(be), Str.concat(sConts(be), contDef))

def mapLambdaBind(param: String, env: List): List =
  if (streq(param, "_") == 1) env else envPut(env, param, "%n", EmitKind.Int)

def mapLambdaRet(be: Emit, id: Int): String =
  if (isIoKind(sKind(be)) == 1) emitMapIoRun(sCode(be), sValue(be), id) else if (kindIsInt(sKind(be)) == 1) str5(sCode(be), "  %m", Str.fromInt(id), str3("_s = call ptr @sz_string_from_int(i64 ", sValue(be), ")\n  ret ptr %m"), Str.concat(Str.fromInt(id), "_s\n")) else str4(sCode(be), "  ret ptr ", sValue(be), "\n")

def emitArgList(args: List, strs: List, ctx: List, env: List, prefix: String, i: Int, id: Int, conts: String, code: String, vals: List, kinds: List): List =
  if (List.isEmpty(args) == 1) List.cons(code, List.cons(Str.fromInt(id), List.cons(conts, List.cons(List.reverse(vals), List.cons(List.reverse(kinds), List.empty()))))) else emitArgListOne(List.head(args), List.tail(args), strs, ctx, env, prefix, i, id, conts, code, vals, kinds)

def emitArgListOne(arg: Expr, rest: List, strs: List, ctx: List, env: List, prefix: String, i: Int, id: Int, conts: String, code: String, vals: List, kinds: List): List =
  for {
    ee = emitExpr(arg, strs, ctx, env, str4(prefix, "_arg", Str.fromInt(i), ""), id, conts)
  } yield emitArgList(rest, strs, ctx, env, prefix, i + 1, sId(ee), sConts(ee), Str.concat(code, sCode(ee)), List.cons(sValue(ee), vals), List.cons(sKind(ee), kinds))

def argPackCode(p: List): String =
  List.head(p)

def argPackId(p: List): Int =
  parseInt(List.head(List.tail(p)))

def argPackConts(p: List): String =
  List.head(List.tail(List.tail(p)))

def argPackVals(p: List): List =
  List.head(List.tail(List.tail(List.tail(p))))

def argPackKinds(p: List): List =
  List.head(List.tail(List.tail(List.tail(List.tail(p)))))

def emitCallWithArgs(callee: String, ae: List, ctx: List, prefix: String): Emit =
  emitBuiltinOrUser(callee, argPackCode(ae), argPackVals(ae), argPackKinds(ae), argPackId(ae), argPackConts(ae), ctx, prefix)

def emitBuiltinOrUser(callee: String, code: String, vals: List, kinds: List, id: Int, conts: String, ctx: List, prefix: String): Emit =
  if (startsWith(callee, "Str.") == 1) emitBuiltinStr(callee, code, vals, id, conts, prefix) else if (startsWith(callee, "List.") == 1) emitBuiltinList(callee, code, vals, kinds, id, conts, prefix) else if (startsWith(callee, "Fs.") == 1) emitBuiltinFs(callee, code, vals, id, conts, prefix) else if (startsWith(callee, "Sys.") == 1) emitBuiltinSys(callee, code, vals, id, conts, prefix) else if (startsWith(callee, "Clock.") == 1) emitBuiltinClock(callee, code, vals, id, conts, prefix) else if (startsWith(callee, "Ref.") == 1) emitBuiltinRef(callee, code, vals, id, conts, prefix) else if (startsWith(callee, "Queue.") == 1) emitBuiltinQueue(callee, code, vals, id, conts, prefix) else if (startsWith(callee, "Deferred.") == 1) emitBuiltinDeferred(callee, code, vals, id, conts, prefix) else if (startsWith(callee, "Fiber.") == 1) emitBuiltinFiber(callee, code, vals, kinds, id, conts, prefix) else if (startsWith(callee, "IO.") == 1) emitBuiltinIoLoop(callee, code, vals, kinds, id, conts, prefix) else if (startsWith(callee, "Stream.") == 1) emitBuiltinStream(callee, code, vals, kinds, id, conts, prefix) else if (startsWith(callee, "Signal.") == 1) emitBuiltinSignal(callee, code, vals, id, conts, prefix) else if (startsWith(callee, "Law.") == 1) emitBuiltinLaw(callee, code, vals, kinds, id, conts, prefix) else if (startsWith(callee, "View.") == 1) emitBuiltinView(callee, code, vals, id, conts, prefix) else if (startsWith(callee, "Theme.") == 1) emitBuiltinTheme(callee, code, vals, id, conts, prefix) else if (startsWith(callee, "Color.") == 1) emitBuiltinColor(callee, code, vals, id, conts, prefix) else if (startsWith(callee, "Ui.") == 1) emitBuiltinUi(callee, code, vals, id, conts, prefix) else if (streq(callee, "Random.nextInt") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_random_next_int(i64 ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.IoInt, id, conts) else if (streq(callee, "Net.httpGet") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_net_http_get(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Io, id, conts) else if (streq(callee, "Impurity.runKit") == 1) mkS(str3(code, "  %", Str.concat(prefix, "_v = call ptr @sz_impurity_run_kit()\n")), str3("%", prefix, "_v"), EmitKind.Io, id, conts) else emitUserCall(callee, code, vals, kinds, id, conts, ctx, prefix)

def emitBuiltinStr(callee: String, code: String, vals: List, id: Int, conts: String, prefix: String): Emit =
  if (streq(callee, "Str.concat") == 1) mkS(str4(code, "  %", prefix, str5("_v = call ptr @sz_string_concat(ptr ", List.at(vals, 0), ", ptr ", List.at(vals, 1), ")\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else if (streq(callee, "Str.len") == 1) mkS(str4(code, "  %", prefix, str3("_v = call i64 @sz_string_len(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(callee, "Str.slice") == 1) mkS(str4(code, "  %", prefix, str5("_v = call ptr @sz_string_slice(ptr ", List.at(vals, 0), ", i64 ", List.at(vals, 1), str3(", i64 ", List.at(vals, 2), ")\n"))), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else if (streq(callee, "Str.eq") == 1) mkS(str5(code, "  %", prefix, str5("_eqi = call i32 @sz_string_eq(ptr ", List.at(vals, 0), ", ptr ", List.at(vals, 1), ")\n  %"), str4(prefix, "_v = zext i32 %", prefix, "_eqi to i64\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(callee, "Str.charAt") == 1) mkS(str4(code, "  %", prefix, str5("_v = call i64 @sz_string_char_at(ptr ", List.at(vals, 0), ", i64 ", List.at(vals, 1), ")\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(callee, "Str.fromInt") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_string_from_int(i64 ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else if (streq(callee, "Str.indexOf") == 1) mkS(str4(code, "  %", prefix, str5("_v = call i64 @sz_string_index_of(ptr ", List.at(vals, 0), ", ptr ", List.at(vals, 1), ")\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(callee, "Str.lines") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_string_lines(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else mkS(code, "null", EmitKind.Ptr, id, conts)

def emitBuiltinList(callee: String, code: String, vals: List, kinds: List, id: Int, conts: String, prefix: String): Emit =
  if (streq(callee, "List.empty") == 1) mkS(str3(code, "  %", Str.concat(prefix, "_v = call ptr @sz_list_nil()\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else if (streq(callee, "List.cons") == 1) emitListCons(code, vals, kinds, id, conts, prefix) else if (streq(callee, "List.isEmpty") == 1) mkS(str5(code, "  %", prefix, str3("_i = call i32 @sz_list_is_empty(ptr ", List.at(vals, 0), ")\n  %"), str4(prefix, "_v = zext i32 %", prefix, "_i to i64\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(callee, "List.head") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_list_head(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else if (streq(callee, "List.tail") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_list_tail(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else if (streq(callee, "List.len") == 1) mkS(str4(code, "  %", prefix, str3("_v = call i64 @sz_list_len(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Int, id, conts) else if (streq(callee, "List.at") == 1) mkS(str4(code, "  %", prefix, str5("_v = call ptr @sz_list_at(ptr ", List.at(vals, 0), ", i64 ", List.at(vals, 1), ")\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else if (streq(callee, "List.reverse") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_list_reverse(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else if (streq(callee, "List.join") == 1) mkS(str5(code, "  %", prefix, str3("_sep = call ptr @sz_string_cstr(ptr ", List.at(vals, 1), ")\n  %"), str6(prefix, "_v = call ptr @sz_list_join(ptr ", List.at(vals, 0), ", ptr %", prefix, "_sep)\n")), str3("%", prefix, "_v"), EmitKind.Ptr, id, conts) else if (streq(callee, "List.append") == 1) emitListAppend(code, vals, kinds, id, conts, prefix) else mkS(code, "null", EmitKind.Ptr, id, conts)

def emitBuiltinFs(callee: String, code: String, vals: List, id: Int, conts: String, prefix: String): Emit =
  if (streq(callee, "Fs.read") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_fs_read(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Io, id, conts) else if (streq(callee, "Fs.write") == 1) mkS(str4(code, "  %", prefix, str5("_v = call ptr @sz_fs_write(ptr ", List.at(vals, 0), ", ptr ", List.at(vals, 1), ")\n")), str3("%", prefix, "_v"), EmitKind.Io, id, conts) else if (streq(callee, "Fs.list") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_fs_list(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Io, id, conts) else if (streq(callee, "Fs.mkdirs") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_fs_mkdirs(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Io, id, conts) else if (streq(callee, "Fs.canonicalize") == 1) mkS(str4(code, "  %", prefix, str3("_v = call ptr @sz_fs_canonicalize(ptr ", List.at(vals, 0), ")\n")), str3("%", prefix, "_v"), EmitKind.Io, id, conts) else mkS(code, "null", EmitKind.Ptr, id, conts)

def emitBuiltinSys(callee: String, code: String, vals: List, id: Int, conts: String, prefix: String): Emit =
