def emitStreamEval(code: String, vals: List, kinds: List, id: Int, conts: String, prefix: String): Emit =
  for {
    io = ensureIoPair(code, List.head(kinds), List.at(vals, 0), Str.concat(prefix, "_eval"))
    c = str4(fst(io), "  %", prefix, str3("_v = call ptr @sz_stream_eval(ptr ", snd(io), ")\n"))
  } yield mkS(c, str3("%", prefix, "_v"), EmitKind.Ptr, id, conts)

