package scuzz.compiler

enum Tok:
  case Ident(name: String, start: Int, end: Int)
  case StrLit(value: String, start: Int, end: Int)
  case IntLit(digits: String, start: Int, end: Int)
  case InterpLit(text: String, start: Int, end: Int)
  case InterpId(name: String, start: Int, end: Int)
  case InterpBrace(body: String, start: Int, end: Int)
  case Sym(kind: String, start: Int, end: Int)

def tokStart(t: Tok): Int =
  t match {
    case Tok.Ident(name, start, end) => start
    case Tok.StrLit(value, start, end) => start
    case Tok.IntLit(digits, start, end) => start
    case Tok.InterpLit(text, start, end) => start
    case Tok.InterpId(name, start, end) => start
    case Tok.InterpBrace(body, start, end) => start
    case Tok.Sym(kind, start, end) => start
  }

def tokEnd(t: Tok): Int =
  t match {
    case Tok.Ident(name, start, end) => end
    case Tok.StrLit(value, start, end) => end
    case Tok.IntLit(digits, start, end) => end
    case Tok.InterpLit(text, start, end) => end
    case Tok.InterpId(name, start, end) => end
    case Tok.InterpBrace(body, start, end) => end
    case Tok.Sym(kind, start, end) => end
  }

def tokSpan(file: String, t: Tok): List =
  mkSpan(file, tokStart(t), tokEnd(t))

def tokKind(t: Tok): String =
  t match {
    case Tok.Ident(name, start, end) => "Ident"
    case Tok.StrLit(value, start, end) => "StrLit"
    case Tok.IntLit(digits, start, end) => "IntLit"
    case Tok.InterpLit(text, start, end) => "InterpLit"
    case Tok.InterpId(name, start, end) => "InterpId"
    case Tok.InterpBrace(body, start, end) => "InterpBrace"
    case Tok.Sym(kind, start, end) => kind
  }

def isIdentTok(t: Tok): Int =
  t match {
    case Tok.Ident(name, start, end) => 1
    case Tok.StrLit(value, start, end) => 0
    case Tok.IntLit(digits, start, end) => 0
    case Tok.InterpLit(text, start, end) => 0
    case Tok.InterpId(name, start, end) => 0
    case Tok.InterpBrace(body, start, end) => 0
    case Tok.Sym(kind, start, end) => 0
  }

def isStringTok(t: Tok): Int =
  t match {
    case Tok.Ident(name, start, end) => 0
    case Tok.StrLit(value, start, end) => 1
    case Tok.IntLit(digits, start, end) => 0
    case Tok.InterpLit(text, start, end) => 0
    case Tok.InterpId(name, start, end) => 0
    case Tok.InterpBrace(body, start, end) => 0
    case Tok.Sym(kind, start, end) => 0
  }

def isIntTok(t: Tok): Int =
  t match {
    case Tok.Ident(name, start, end) => 0
    case Tok.StrLit(value, start, end) => 0
    case Tok.IntLit(digits, start, end) => 1
    case Tok.InterpLit(text, start, end) => 0
    case Tok.InterpId(name, start, end) => 0
    case Tok.InterpBrace(body, start, end) => 0
    case Tok.Sym(kind, start, end) => 0
  }

def isInterpLitTok(t: Tok): Int =
  t match {
    case Tok.Ident(name, start, end) => 0
    case Tok.StrLit(value, start, end) => 0
    case Tok.IntLit(digits, start, end) => 0
    case Tok.InterpLit(text, start, end) => 1
    case Tok.InterpId(name, start, end) => 0
    case Tok.InterpBrace(body, start, end) => 0
    case Tok.Sym(kind, start, end) => 0
  }

def isInterpIdTok(t: Tok): Int =
  t match {
    case Tok.Ident(name, start, end) => 0
    case Tok.StrLit(value, start, end) => 0
    case Tok.IntLit(digits, start, end) => 0
    case Tok.InterpLit(text, start, end) => 0
    case Tok.InterpId(name, start, end) => 1
    case Tok.InterpBrace(body, start, end) => 0
    case Tok.Sym(kind, start, end) => 0
  }

def isInterpBraceTok(t: Tok): Int =
  t match {
    case Tok.Ident(name, start, end) => 0
    case Tok.StrLit(value, start, end) => 0
    case Tok.IntLit(digits, start, end) => 0
    case Tok.InterpLit(text, start, end) => 0
    case Tok.InterpId(name, start, end) => 0
    case Tok.InterpBrace(body, start, end) => 1
    case Tok.Sym(kind, start, end) => 0
  }

def identName(t: Tok): String =
  t match {
    case Tok.Ident(name, start, end) => name
    case Tok.StrLit(value, start, end) => ""
    case Tok.IntLit(digits, start, end) => ""
    case Tok.InterpLit(text, start, end) => ""
    case Tok.InterpId(name, start, end) => ""
    case Tok.InterpBrace(body, start, end) => ""
    case Tok.Sym(kind, start, end) => ""
  }

def stringVal(t: Tok): String =
  t match {
    case Tok.Ident(name, start, end) => ""
    case Tok.StrLit(value, start, end) => value
    case Tok.IntLit(digits, start, end) => ""
    case Tok.InterpLit(text, start, end) => ""
    case Tok.InterpId(name, start, end) => ""
    case Tok.InterpBrace(body, start, end) => ""
    case Tok.Sym(kind, start, end) => ""
  }

def intDigits(t: Tok): String =
  t match {
    case Tok.Ident(name, start, end) => ""
    case Tok.StrLit(value, start, end) => ""
    case Tok.IntLit(digits, start, end) => digits
    case Tok.InterpLit(text, start, end) => ""
    case Tok.InterpId(name, start, end) => ""
    case Tok.InterpBrace(body, start, end) => ""
    case Tok.Sym(kind, start, end) => ""
  }

def interpLitVal(t: Tok): String =
  t match {
    case Tok.Ident(name, start, end) => ""
    case Tok.StrLit(value, start, end) => ""
    case Tok.IntLit(digits, start, end) => ""
    case Tok.InterpLit(text, start, end) => text
    case Tok.InterpId(name, start, end) => ""
    case Tok.InterpBrace(body, start, end) => ""
    case Tok.Sym(kind, start, end) => ""
  }

def interpIdVal(t: Tok): String =
  t match {
    case Tok.Ident(name, start, end) => ""
    case Tok.StrLit(value, start, end) => ""
    case Tok.IntLit(digits, start, end) => ""
    case Tok.InterpLit(text, start, end) => ""
    case Tok.InterpId(name, start, end) => name
    case Tok.InterpBrace(body, start, end) => ""
    case Tok.Sym(kind, start, end) => ""
  }

def interpBraceVal(t: Tok): String =
  t match {
    case Tok.Ident(name, start, end) => ""
    case Tok.StrLit(value, start, end) => ""
    case Tok.IntLit(digits, start, end) => ""
    case Tok.InterpLit(text, start, end) => ""
    case Tok.InterpId(name, start, end) => ""
    case Tok.InterpBrace(body, start, end) => body
    case Tok.Sym(kind, start, end) => ""
  }

