package scuzz.compiler

enum Param:
  case Param(name: String, ty: Type)

enum Def:
  case Def(name: String, params: List, ret: Type, body: Expr, module: String, isPrivate: Int, typeParams: List, isLaw: Int)

enum Import:
  case Import(inModule: String, fromModule: String, name: String)

enum ImplMethod:
  case Method(name: String, params: List, ret: Type, body: Expr)

enum ImplDef:
  case Impl(module: String, traitName: String, forType: String, methods: List)

enum Prog:
  case Prog(pkg: String, enums: List, defs: List, main: Expr, mainModule: String, imports: List, traits: List, impls: List)

