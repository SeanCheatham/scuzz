package scuzz.compiler

enum Param:
  case Param(name: String, ty: Type)

enum Def:
  case Def(name: String, params: List, ret: Type, body: Expr, module: String, isPrivate: Int)

enum Import:
  case Import(inModule: String, fromModule: String, name: String)

enum Prog:
  case Prog(pkg: String, enums: List, defs: List, main: Expr, mainModule: String, imports: List)

