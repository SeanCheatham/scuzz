package scuzz.compiler

enum EnumField:
  case Field(name: String, ty: Type)

enum EnumCase:
  case Case(name: String, fields: List)

enum EnumDef:
  case Enum(module: String, name: String, cases: List, tparams: List)
  case Record(module: String, name: String, fields: List, tparams: List)

enum TraitMethod:
  case Method(name: String, params: List, ret: Type)

enum TraitDef:
  case Trait(module: String, name: String, methods: List)

