package scuzz.compiler

def mExpr(p: List): Expr =
  List.head(p)

def mSeen(p: List): Int =
  parseInt(List.head(List.tail(p)))

def mPack(e: Expr, seen: Int): List =
  List.cons(e, List.cons(Str.fromInt(seen), List.empty()))

def mList(p: List): List =
  List.head(p)

def mListPack(xs: List, seen: Int): List =
  List.cons(xs, List.cons(Str.fromInt(seen), List.empty()))

def mProgPack(p: Prog, seen: Int): List =
  List.cons(p, List.cons(Str.fromInt(seen), List.empty()))

def isOracleCallee(callee: String): Int =
  if (streq(callee, "Law.check") == 1) 1 else if (streq(callee, "Law.assert") == 1) 1 else 0

def negatePred(pred: Expr): Expr =
  Expr.If(pred, Expr.IntLit("0", dummySpan()), Expr.IntLit("1", dummySpan()), dummySpan())

def flipOp(op: String): String =
  if (streq(op, "==") == 1) "!=" else if (streq(op, "!=") == 1) "==" else if (streq(op, "<") == 1) ">=" else if (streq(op, "<=") == 1) ">" else if (streq(op, ">") == 1) "<=" else if (streq(op, ">=") == 1) "<" else if (streq(op, "&&") == 1) "||" else if (streq(op, "||") == 1) "&&" else op

def isFlipOp(op: String): Int =
  if (streq(flipOp(op), op) == 1) 0 else 1

def isArithOp(op: String): Int =
  if (streq(op, "+") == 1) 1 else if (streq(op, "-") == 1) 1 else 0

def flipArith(op: String): String =
  if (streq(op, "+") == 1) "-" else "+"

def andDropCount(op: String): Int =
  if (streq(op, "&&") == 1) 2 else 0

def binSiteCount(op: String): Int =
  if (isFlipOp(op) == 1) 1 + andDropCount(op) else if (isArithOp(op) == 1) 1 else 0

def is01Lit(digits: String): Int =
  if (streq(digits, "0") == 1) 1 else if (streq(digits, "1") == 1) 1 else 0

def flip01(digits: String): String =
  if (streq(digits, "0") == 1) "1" else "0"

def mutateExpr(e: Expr, target: Int, seen: Int, inOracle: Int): List =
  e match {
    case Expr.IntLit(digits, span) => mutateIntLit(digits, span, target, seen, inOracle)
    case Expr.Call(callee, args, span) => mutateCall(callee, args, span, target, seen, inOracle)
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => mutateAdt(enumName, caseName, args, typeArgs, span, target, seen, inOracle)
    case Expr.Let(name, value, body, span) => mutateLet(name, value, body, span, target, seen, inOracle)
    case Expr.FlatMap(inner, param, body, span) => mutateFlat(inner, param, body, span, target, seen, inOracle)
    case Expr.Handle(inner, body, span) => mutateHandle(inner, body, span, target, seen, inOracle)
    case Expr.If(cond, thenB, elseB, span) => mutateIf(cond, thenB, elseB, span, target, seen, inOracle)
    case Expr.BinOp(op, left, right, span) => mutateBin(op, left, right, span, target, seen, inOracle)
    case Expr.Lambda(param, body, span) => mutateLam(param, body, span, target, seen, inOracle)
    case Expr.Match(scrut, arms, span) => mutateMatch(scrut, arms, span, target, seen, inOracle)
    case Expr.For(binders, body, span) => mutateFor(binders, body, span, target, seen, inOracle)
    case Expr.ListLit(elems, span) => mutateListLit(elems, span, target, seen, inOracle)
    case Expr.Interp(parts, span) => mutateInterp(parts, span, target, seen, inOracle)
    case Expr.MethodCall(receiver, method, args, span) => mutateMethod(receiver, method, args, span, target, seen, inOracle)
    case Expr.Field(base, field, span) => mutateField(base, field, span, target, seen, inOracle)
    case Expr.Println(arg, span) => mutateUnary("println", arg, span, target, seen, inOracle)
    case Expr.Fail(arg, span) => mutateUnary("fail", arg, span, target, seen, inOracle)
    case Expr.Pure(arg, span) => mutateUnary("pure", arg, span, target, seen, inOracle)
    case Expr.Sleep(arg, span) => mutateUnary("sleep", arg, span, target, seen, inOracle)
    case Expr.Attempt(inner, span) => mutateUnary("attempt", inner, span, target, seen, inOracle)
    case Expr.IoRace(left, right, span) => mutateIo2("race", left, right, span, target, seen, inOracle)
    case Expr.IoBoth(left, right, span) => mutateIo2("both", left, right, span, target, seen, inOracle)
    case Expr.IoEnsure(inner, finalizer, span) => mutateIo2("ensure", inner, finalizer, span, target, seen, inOracle)
    case Expr.IoTimeout(ms, inner, span) => mutateIo2("timeout", ms, inner, span, target, seen, inOracle)
    case _ => mPack(e, seen)
  }

def mutateIntLit(digits: String, span: Span, target: Int, seen: Int, inOracle: Int): List =
  if (inOracle == 0) mPack(Expr.IntLit(digits, span), seen) else if (is01Lit(digits) == 0) mPack(Expr.IntLit(digits, span), seen) else if (seen == target) mPack(Expr.IntLit(flip01(digits), span), seen + 1) else mPack(Expr.IntLit(digits, span), seen + 1)

def mutateCall(callee: String, args: List, span: Span, target: Int, seen: Int, inOracle: Int): List =
  if (isOracleCallee(callee) == 0) mutateCallPlain(callee, args, span, target, seen, inOracle) else mutateOracle(callee, args, span, target, seen)

def mutateCallPlain(callee: String, args: List, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    a = mutateExprList(args, target, seen, List.empty(), inOracle)
  } yield mPack(Expr.Call(callee, mList(a), span), mSeen(a))

def mutateOracle(callee: String, args: List, span: Span, target: Int, seen: Int): List =
  if (List.len(args) < 2) mutateCallPlain(callee, args, span, target, seen, 0) else mutateOracleArgs(callee, args, span, target, seen)

def mutateOracleArgs(callee: String, args: List, span: Span, target: Int, seen: Int): List =
  for {
    n = mutateExpr(List.head(args), target, seen + 1, 0)
    p = mutateExpr(List.at(args, 1), target, mSeen(n), 1)
    rest = mutateExprList(List.tail(List.tail(args)), target, mSeen(p), List.empty(), 0)
    predOut = if (seen == target) negatePred(List.at(args, 1)) else mExpr(p)
  } yield mPack(Expr.Call(callee, List.cons(mExpr(n), List.cons(predOut, mList(rest))), span), mSeen(rest))

def mutateAdt(enumName: String, caseName: String, args: List, typeArgs: List, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    a = mutateExprList(args, target, seen, List.empty(), inOracle)
  } yield mPack(Expr.Adt(enumName, caseName, mList(a), typeArgs, span), mSeen(a))

def mutateLet(name: String, value: Expr, body: Expr, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    v = mutateExpr(value, target, seen, inOracle)
    b = mutateExpr(body, target, mSeen(v), inOracle)
  } yield mPack(Expr.Let(name, mExpr(v), mExpr(b), span), mSeen(b))

def mutateFlat(inner: Expr, param: String, body: Expr, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    i = mutateExpr(inner, target, seen, inOracle)
    b = mutateExpr(body, target, mSeen(i), inOracle)
  } yield mPack(Expr.FlatMap(mExpr(i), param, mExpr(b), span), mSeen(b))

def mutateHandle(inner: Expr, body: Expr, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    i = mutateExpr(inner, target, seen, inOracle)
    b = mutateExpr(body, target, mSeen(i), inOracle)
  } yield mPack(Expr.Handle(mExpr(i), mExpr(b), span), mSeen(b))

def mutateIf(cond: Expr, thenB: Expr, elseB: Expr, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    c = mutateExpr(cond, target, seen, inOracle)
    t = mutateExpr(thenB, target, mSeen(c), inOracle)
    e = mutateExpr(elseB, target, mSeen(t), inOracle)
  } yield mPack(Expr.If(mExpr(c), mExpr(t), mExpr(e), span), mSeen(e))

def mutateBin(op: String, left: Expr, right: Expr, span: Span, target: Int, seen: Int, inOracle: Int): List =
  if (inOracle == 0) mutateBinKids(op, left, right, span, target, seen, 0) else mutateBinOracle(op, left, right, span, target, seen)

def mutateBinOracle(op: String, left: Expr, right: Expr, span: Span, target: Int, seen: Int): List =
  for {
    n = binSiteCount(op)
    l = mutateExpr(left, target, seen + n, 1)
    r = mutateExpr(right, target, mSeen(l), 1)
  } yield mPack(binMutant(op, mExpr(l), mExpr(r), span, target, seen), mSeen(r))

def binMutant(op: String, left: Expr, right: Expr, span: Span, target: Int, seen: Int): Expr =
  if (isFlipOp(op) == 1) binMutantFlip(op, left, right, span, target, seen) else if (isArithOp(op) == 1) binMutantArith(op, left, right, span, target, seen) else Expr.BinOp(op, left, right, span)

def binMutantArith(op: String, left: Expr, right: Expr, span: Span, target: Int, seen: Int): Expr =
  if (seen == target) Expr.BinOp(flipArith(op), left, right, span) else Expr.BinOp(op, left, right, span)

def binMutantFlip(op: String, left: Expr, right: Expr, span: Span, target: Int, seen: Int): Expr =
  if (seen == target) Expr.BinOp(flipOp(op), left, right, span) else if (streq(op, "&&") == 1) binMutantAnd(left, right, span, target, seen) else Expr.BinOp(op, left, right, span)

def binMutantAnd(left: Expr, right: Expr, span: Span, target: Int, seen: Int): Expr =
  if (seen + 1 == target) left else if (seen + 2 == target) right else Expr.BinOp("&&", left, right, span)

def mutateBinKids(op: String, left: Expr, right: Expr, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    l = mutateExpr(left, target, seen, inOracle)
    r = mutateExpr(right, target, mSeen(l), inOracle)
  } yield mPack(Expr.BinOp(op, mExpr(l), mExpr(r), span), mSeen(r))

def mutateLam(param: String, body: Expr, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    b = mutateExpr(body, target, seen, inOracle)
  } yield mPack(Expr.Lambda(param, mExpr(b), span), mSeen(b))

def mutateMatch(scrut: Expr, arms: List, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    s = mutateExpr(scrut, target, seen, inOracle)
    a = mutateArms(arms, target, mSeen(s), List.empty(), inOracle)
  } yield mPack(Expr.Match(mExpr(s), mList(a), span), mSeen(a))

def mutateFor(binders: List, body: Expr, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    b = mutateBinders(binders, target, seen, List.empty(), inOracle)
    e = mutateExpr(body, target, mSeen(b), inOracle)
  } yield mPack(Expr.For(mList(b), mExpr(e), span), mSeen(e))

def mutateListLit(elems: List, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    a = mutateExprList(elems, target, seen, List.empty(), inOracle)
  } yield mPack(Expr.ListLit(mList(a), span), mSeen(a))

def mutateInterp(parts: List, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    a = mutateParts(parts, target, seen, List.empty(), inOracle)
  } yield mPack(Expr.Interp(mList(a), span), mSeen(a))

def mutateMethod(receiver: Expr, method: String, args: List, span: Span, target: Int, seen: Int, inOracle: Int): List =
  if (streq(method, "require") == 1) mutateRequire(receiver, args, span, target, seen) else mutateMethodPlain(receiver, method, args, span, target, seen, inOracle)

def mutateMethodPlain(receiver: Expr, method: String, args: List, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    r = mutateExpr(receiver, target, seen, inOracle)
    a = mutateExprList(args, target, mSeen(r), List.empty(), inOracle)
  } yield mPack(Expr.MethodCall(mExpr(r), method, mList(a), span), mSeen(a))

def requirePredIndex(args: List): Int =
  if (List.isEmpty(splitRequireArgs(args)) == 1) 0 - 1 else if (List.len(args) == 1) 0 else 1

def mutateRequire(receiver: Expr, args: List, span: Span, target: Int, seen: Int): List =
  if (requirePredIndex(args) < 0) mutateMethodPlain(receiver, "require", args, span, target, seen, 0) else mutateRequireHit(receiver, args, span, target, seen, requirePredIndex(args))

def mutateRequireHit(receiver: Expr, args: List, span: Span, target: Int, seen: Int, predIdx: Int): List =
  for {
    r = mutateExpr(receiver, target, seen + 1, 0)
    a = mutateRequireArgs(args, target, mSeen(r), List.empty(), 0, predIdx, seen)
  } yield mPack(Expr.MethodCall(mExpr(r), "require", mList(a), span), mSeen(a))

def mutateRequireArgs(xs: List, target: Int, seen: Int, acc: List, i: Int, predIdx: Int, negSite: Int): List =
  if (List.isEmpty(xs) == 1) mListPack(List.reverse(acc), seen) else mutateRequireArgsOne(List.head(xs), List.tail(xs), target, seen, acc, i, predIdx, negSite)

def mutateRequireArgsOne(x: Expr, rest: List, target: Int, seen: Int, acc: List, i: Int, predIdx: Int, negSite: Int): List =
  if (i == predIdx) mutateRequirePredArg(x, rest, target, seen, acc, i, predIdx, negSite) else mutateRequireOtherArg(x, rest, target, seen, acc, i, predIdx, negSite)

def mutateRequirePredArg(x: Expr, rest: List, target: Int, seen: Int, acc: List, i: Int, predIdx: Int, negSite: Int): List =
  for {
    p = mutateExpr(x, target, seen, 1)
    out = if (negSite == target) negatePred(x) else mExpr(p)
  } yield mutateRequireArgs(rest, target, mSeen(p), List.cons(out, acc), i + 1, predIdx, negSite)

def mutateRequireOtherArg(x: Expr, rest: List, target: Int, seen: Int, acc: List, i: Int, predIdx: Int, negSite: Int): List =
  for {
    p = mutateExpr(x, target, seen, 0)
  } yield mutateRequireArgs(rest, target, mSeen(p), List.cons(mExpr(p), acc), i + 1, predIdx, negSite)

def mutateField(base: Expr, field: String, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    b = mutateExpr(base, target, seen, inOracle)
  } yield mPack(Expr.Field(mExpr(b), field, span), mSeen(b))

def mutateUnary(which: String, arg: Expr, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    a = mutateExpr(arg, target, seen, inOracle)
  } yield mutateUnaryPack(which, mExpr(a), span, mSeen(a))

def mutateUnaryPack(which: String, arg: Expr, span: Span, seen: Int): List =
  if (streq(which, "println") == 1) mPack(Expr.Println(arg, span), seen) else if (streq(which, "fail") == 1) mPack(Expr.Fail(arg, span), seen) else if (streq(which, "pure") == 1) mPack(Expr.Pure(arg, span), seen) else if (streq(which, "sleep") == 1) mPack(Expr.Sleep(arg, span), seen) else mPack(Expr.Attempt(arg, span), seen)

def mutateIo2(which: String, left: Expr, right: Expr, span: Span, target: Int, seen: Int, inOracle: Int): List =
  for {
    l = mutateExpr(left, target, seen, inOracle)
    r = mutateExpr(right, target, mSeen(l), inOracle)
  } yield mutateIo2Pack(which, mExpr(l), mExpr(r), span, mSeen(r))

def mutateIo2Pack(which: String, left: Expr, right: Expr, span: Span, seen: Int): List =
  if (streq(which, "race") == 1) mPack(Expr.IoRace(left, right, span), seen) else if (streq(which, "both") == 1) mPack(Expr.IoBoth(left, right, span), seen) else if (streq(which, "ensure") == 1) mPack(Expr.IoEnsure(left, right, span), seen) else mPack(Expr.IoTimeout(left, right, span), seen)

def mutateExprList(xs: List, target: Int, seen: Int, acc: List, inOracle: Int): List =
  if (List.isEmpty(xs) == 1) mListPack(List.reverse(acc), seen) else mutateExprListOne(List.head(xs), List.tail(xs), target, seen, acc, inOracle)

def mutateExprListOne(x: Expr, rest: List, target: Int, seen: Int, acc: List, inOracle: Int): List =
  for {
    p = mutateExpr(x, target, seen, inOracle)
  } yield mutateExprList(rest, target, mSeen(p), List.cons(mExpr(p), acc), inOracle)

def mutateArms(arms: List, target: Int, seen: Int, acc: List, inOracle: Int): List =
  if (List.isEmpty(arms) == 1) mListPack(List.reverse(acc), seen) else mutateArmsOne(List.head(arms), List.tail(arms), target, seen, acc, inOracle)

def mutateArmsOne(arm: MatchArm, rest: List, target: Int, seen: Int, acc: List, inOracle: Int): List =
  for {
    p = mutateExpr(armBody(arm), target, seen, inOracle)
  } yield mutateArms(rest, target, mSeen(p), List.cons(setArmBody(arm, mExpr(p)), acc), inOracle)

def mutateBinders(binders: List, target: Int, seen: Int, acc: List, inOracle: Int): List =
  if (List.isEmpty(binders) == 1) mListPack(List.reverse(acc), seen) else mutateBindersOne(List.head(binders), List.tail(binders), target, seen, acc, inOracle)

def mutateBindersOne(b: ForBinder, rest: List, target: Int, seen: Int, acc: List, inOracle: Int): List =
  b match {
    case ForBinder.Eq(name, value) => mutateBinderEq(name, value, rest, target, seen, acc, inOracle)
    case ForBinder.Draw(name, value) => mutateBinderDraw(name, value, rest, target, seen, acc, inOracle)
  }

def mutateBinderEq(name: String, value: Expr, rest: List, target: Int, seen: Int, acc: List, inOracle: Int): List =
  for {
    p = mutateExpr(value, target, seen, inOracle)
  } yield mutateBinders(rest, target, mSeen(p), List.cons(ForBinder.Eq(name, mExpr(p)), acc), inOracle)

def mutateBinderDraw(name: String, value: Expr, rest: List, target: Int, seen: Int, acc: List, inOracle: Int): List =
  for {
    p = mutateExpr(value, target, seen, inOracle)
  } yield mutateBinders(rest, target, mSeen(p), List.cons(ForBinder.Draw(name, mExpr(p)), acc), inOracle)

def mutateParts(parts: List, target: Int, seen: Int, acc: List, inOracle: Int): List =
  if (List.isEmpty(parts) == 1) mListPack(List.reverse(acc), seen) else mutatePartsOne(List.head(parts), List.tail(parts), target, seen, acc, inOracle)

def mutatePartsOne(part: InterpPart, rest: List, target: Int, seen: Int, acc: List, inOracle: Int): List =
  part match {
    case InterpPart.Lit(text) => mutateParts(rest, target, seen, List.cons(part, acc), inOracle)
    case InterpPart.Hole(expr) => mutatePartHole(expr, rest, target, seen, acc, inOracle)
  }

def mutatePartHole(expr: Expr, rest: List, target: Int, seen: Int, acc: List, inOracle: Int): List =
  for {
    p = mutateExpr(expr, target, seen, inOracle)
  } yield mutateParts(rest, target, mSeen(p), List.cons(InterpPart.Hole(mExpr(p)), acc), inOracle)

def mutateDefs(defs: List, target: Int, seen: Int, acc: List): List =
  if (List.isEmpty(defs) == 1) mListPack(List.reverse(acc), seen) else mutateDefsOne(List.head(defs), List.tail(defs), target, seen, acc)

def mutateDefsOne(d: Def, rest: List, target: Int, seen: Int, acc: List): List =
  for {
    p = mutateExpr(defBody(d), target, seen, 0)
  } yield mutateDefs(rest, target, mSeen(p), List.cons(setDefBody(d, mExpr(p)), acc))

def mutateProgAt(prog: Prog, target: Int): List =
  for {
    d = mutateDefs(progDefs(prog), target, 0, List.empty())
    m = mutateExpr(progMain(prog), target, mSeen(d), 0)
  } yield mProgPack(setProgMain(setProgDefs(prog, mList(d)), mExpr(m)), mSeen(m))

def mutateCount(prog: Prog): Int =
  mSeen(mutateProgAt(prog, 0 - 1))

def mutateApply(prog: Prog, target: Int): Prog =
  List.head(mutateProgAt(prog, target))

def minInt(a: Int, b: Int): Int =
  if (a < b) a else b

def isMutateValueFlag(s: String): Int =
  if (streq(s, "--limit") == 1) 1 else if (streq(s, "--iters") == 1) 1 else if (streq(s, "--seed") == 1) 1 else 0

def mutateProjectArg(args: List, i: Int): String =
  if (i >= List.len(args)) "." else if (isMutateValueFlag(List.at(args, i)) == 1) mutateProjectArg(args, i + 2) else if (isFlag(List.at(args, i)) == 1) mutateProjectArg(args, i + 1) else List.at(args, i)

def cmdMutateArgs(args: List): IO[Unit] =
  cmdMutateValidated(mutateProjectArg(args, 1), parseInt(argValueAt(args, "--limit", "16", 0)), parseInt(argValueAt(args, "--iters", "4", 0)), parseInt(argValueAt(args, "--seed", "42", 0)))

def cmdMutateValidated(projectDir: String, limit: Int, iters: Int, seed: Int): IO[Unit] =
  if (limit <= 0) IO.fail("mutate --limit N requires N > 0") else if (iters < 0) IO.fail("mutate --iters N requires N >= 0") else cmdMutate(projectDir, limit, iters, seed)

def cmdMutate(projectDir: String, limit: Int, iters: Int, seed: Int): IO[Unit] =
  Sys.getenv("SCUZZ_RUNTIME").flatMap(rtEnv =>
    resolveRuntimeEnv(rtEnv, projectDir).flatMap(runtimeDir =>
      Sys.getenv("SCUZZ_CLANG").flatMap(clangEnv =>
        Fs.read(pathJoin(projectDir, "scuzz.toml")).flatMap(toml => cmdMutateToml(projectDir, limit, iters, seed, runtimeDir, clangOrDefault(clangEnv), toml))
      )
    )
  )

def cmdMutateToml(projectDir: String, limit: Int, iters: Int, seed: Int, runtimeDir: String, clang: String, toml: String): IO[Unit] =
  loadGraphBundle(projectDir, toml).flatMap(bundle =>
    mergeSources(List.head(bundle), emptyProg(), 0).flatMap(prog0 =>
      prepareVerifyProg(prog0, List.head(List.tail(bundle))).flatMap(prog1 => cmdMutateProg(projectDir, limit, iters, seed, runtimeDir, clang, toml, prog1, List.head(List.tail(bundle))))
    )
  )

def cmdMutateProg(projectDir: String, limit: Int, iters: Int, seed: Int, runtimeDir: String, clang: String, toml: String, prog: Prog, overlays: List): IO[Unit] =
  for {
    n = mutateCount(prog)
  } yield if (n == 0) IO.println("scuzz mutate: no residual Law.check / Law.assert / .require sites") else cmdMutateSites(projectDir, minInt(n, limit), n, iters, seed, runtimeDir, clang, toml, prog, overlays)

def cmdMutateSites(projectDir: String, take: Int, total: Int, iters: Int, seed: Int, runtimeDir: String, clang: String, toml: String, prog: Prog, overlays: List): IO[Unit] =
  IO.println(str6("scuzz mutate: ", Str.fromInt(take), " of ", Str.fromInt(total), " residual oracle sites (negate/flip/0-1/arith/drop); idle + ", str3(Str.fromInt(iters), " fuzz iters", ""))).flatMap(_ => mutateLoop(projectDir, take, iters, seed, runtimeDir, clang, toml, prog, overlays, 0, 0, 0))

def mutateLoop(projectDir: String, take: Int, iters: Int, seed: Int, runtimeDir: String, clang: String, toml: String, prog: Prog, overlays: List, i: Int, killed: Int, survived: Int): IO[Unit] =
  if (i >= take) mutateFinish(killed, survived, take, iters) else mutateOne(projectDir, take, iters, seed, runtimeDir, clang, toml, prog, overlays, i, killed, survived)

def mutateOne(projectDir: String, take: Int, iters: Int, seed: Int, runtimeDir: String, clang: String, toml: String, prog: Prog, overlays: List, i: Int, killed: Int, survived: Int): IO[Unit] =
  for {
    name = readTomlName(toml)
    withUi = hasUiSection(toml)
    outDir = pathJoin(pathJoin(pathJoin(projectDir, "build"), "mutate"), Str.fromInt(i))
    mutant = mutateApply(prog, i)
    exe = pathJoin(outDir, name)
    w = readTomlHeadlessW(toml)
    h = readTomlHeadlessH(toml)
  } yield compilePrepared(projectDir, outDir, 1, runtimeDir, clang, name, withUi, mutant, overlays).flatMap(_ =>
  mutateExec(exe, outDir, withUi, w, h, i, iters, seed).flatMap(code => mutateAfterRun(projectDir, take, iters, seed, runtimeDir, clang, toml, prog, overlays, i, killed, survived, code))
)

def mutateIterSeed(seed: Int, mutantIndex: Int, iter: Int): Int =
  seed + mutantIndex * 32 + iter

def mutateExec(exe: String, outDir: String, withUi: Int, w: String, h: String, mutantIndex: Int, iters: Int, seed: Int): IO[Int] =
  if (withUi == 1) mutateExecUi(exe, outDir, w, h, mutantIndex, iters, seed) else mutateExecIo(exe, outDir, mutantIndex, iters, seed)

def mutateExecUi(exe: String, outDir: String, w: String, h: String, mutantIndex: Int, iters: Int, seed: Int): IO[Int] =
  mutateExecUiEvents(exe, outDir, w, h, List.empty(), "").flatMap(code => if (code != 0) IO.pure(code) else mutateExecUiAfterIdle(exe, outDir, w, h, mutantIndex, iters, seed))

def mutateExecUiAfterIdle(exe: String, outDir: String, w: String, h: String, mutantIndex: Int, iters: Int, seed: Int): IO[Int] =
  if (iters <= 0) IO.pure(0) else Fs.read(pathJoin(outDir, "dump.txt")).flatMap(dump => mutateExecUiDump(exe, outDir, w, h, mutantIndex, iters, seed, dump))

def mutateExecUiDump(exe: String, outDir: String, w: String, h: String, mutantIndex: Int, iters: Int, seed: Int, dump: String): IO[Int] =
  mutateExecUiWidgets(exe, outDir, w, h, mutantIndex, iters, seed, countPrefixLines(dump, "button:", 0, 0), countPrefixLines(dump, "textfield:", 0, 0), countPrefixLines(dump, "scroll:", 0, 0))

def mutateExecUiWidgets(exe: String, outDir: String, w: String, h: String, mutantIndex: Int, iters: Int, seed: Int, nButtons: Int, nFields: Int, nScrolls: Int): IO[Int] =
  if (nButtons + nFields + nScrolls == 0) IO.pure(0) else Fs.read(pathJoin(outDir, "drivers.txt")).flatMap(dtext => mutateUiIters(exe, outDir, w, h, nButtons, boolPos(nFields), boolPos(nScrolls), fuzzLinesAcc(dtext, 0, List.empty()), mutantIndex, iters, seed, 0))

def mutateUiIters(exe: String, outDir: String, w: String, h: String, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List, mutantIndex: Int, iters: Int, seed: Int, iter: Int): IO[Int] =
  if (iter >= iters) IO.pure(0) else mutateUiIter(exe, outDir, w, h, nButtons, hasText, hasScroll, drivers, mutantIndex, iters, seed, iter)

def mutateUiIter(exe: String, outDir: String, w: String, h: String, nButtons: Int, hasText: Int, hasScroll: Int, drivers: List, mutantIndex: Int, iters: Int, seed: Int, iter: Int): IO[Int] =
  for {
    s = mutateIterSeed(seed, mutantIndex, iter)
  } yield mutateExecUiEvents(exe, outDir, w, h, fuzzScript(s, nButtons, hasText, hasScroll, drivers), Str.fromInt(s)).flatMap(code => if (code != 0) IO.pure(code) else mutateUiIters(exe, outDir, w, h, nButtons, hasText, hasScroll, drivers, mutantIndex, iters, seed, iter + 1))

def mutateExecUiEvents(exe: String, outDir: String, w: String, h: String, events: List, scheduleSeed: String): IO[Int] =
  Fs.write(pathJoin(outDir, "script.txt"), fuzzScriptText(events)).flatMap(_ =>
    Fs.write(pathJoin(outDir, "dump.txt"), "").flatMap(_ =>
      Fs.write(pathJoin(outDir, "sometimes.reached"), "").flatMap(_ => Sys.exec(fuzzCmd(exe, pathJoin(outDir, "script.txt"), pathJoin(outDir, "dump.txt"), w, h, scheduleSeed, pathJoin(outDir, "sometimes.reached"))))
    )
  )

def mutateExecIo(exe: String, outDir: String, mutantIndex: Int, iters: Int, seed: Int): IO[Int] =
  mutateExecIoAt(exe, outDir, "").flatMap(code => if (code != 0) IO.pure(code) else mutateIoIters(exe, outDir, mutantIndex, iters, seed, 0))

def mutateIoIters(exe: String, outDir: String, mutantIndex: Int, iters: Int, seed: Int, iter: Int): IO[Int] =
  if (iter >= iters) IO.pure(0) else mutateExecIoAt(exe, outDir, Str.fromInt(mutateIterSeed(seed, mutantIndex, iter))).flatMap(code => if (code != 0) IO.pure(code) else mutateIoIters(exe, outDir, mutantIndex, iters, seed, iter + 1))

def mutateExecIoAt(exe: String, outDir: String, scheduleSeed: String): IO[Int] =
  Fs.write(pathJoin(outDir, "sometimes.reached"), "").flatMap(_ => Sys.exec(fuzzCmdIo(exe, scheduleSeed, pathJoin(outDir, "sometimes.reached"))))

def mutateAfterRun(projectDir: String, take: Int, iters: Int, seed: Int, runtimeDir: String, clang: String, toml: String, prog: Prog, overlays: List, i: Int, killed: Int, survived: Int, code: Int): IO[Unit] =
  if (code == 0) mutateReport(i, "survived").flatMap(_ => mutateLoop(projectDir, take, iters, seed, runtimeDir, clang, toml, prog, overlays, i + 1, killed, survived + 1)) else mutateReport(i, "killed").flatMap(_ => mutateLoop(projectDir, take, iters, seed, runtimeDir, clang, toml, prog, overlays, i + 1, killed + 1, survived))

def mutateReport(i: Int, status: String): IO[Unit] =
  IO.println(str5("  mutant ", Str.fromInt(i), ": ", status, ""))

def mutateFinish(killed: Int, survived: Int, take: Int, iters: Int): IO[Unit] =
  IO.println(str6("scuzz mutate: ", Str.fromInt(killed), " killed, ", Str.fromInt(survived), " survived (", str3(Str.fromInt(take), " ran)", ""))).flatMap(_ => if (survived == 0) IO.println("scuzz mutate ok") else IO.println(str5("surviving mutants mean weak or unreachable residual oracles; rerun: scuzz mutate --limit ", Str.fromInt(take), " --iters ", Str.fromInt(iters), "")).flatMap(_ => IO.fail("mutate survivors")))

