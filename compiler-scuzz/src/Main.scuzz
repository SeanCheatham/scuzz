package scuzz.compiler

def usage(): String =
  "scuzz (build|run|test|check|fuzz|fmt|watch|new|package) [args]\n  scuzz --help   scuzz <command> --help\n  --message-format=human|json   (JSON on check only)"

def helpTop(): String =
  Str.concat(usage(), "\n\nExamples:\n  scuzz new myapp --ui\n  scuzz check\n  scuzz check --message-format=json\n  scuzz test\n  scuzz run --headless\n  scuzz watch\n  scuzz run --watch --headless\n  scuzz fuzz --iters 16\n")

def helpBuild(): String =
  "scuzz build [project]\n\nCompile to a native binary (LLVM + clang).\n\nExamples:\n  scuzz build\n  scuzz build examples/hello\n"

def helpRun(): String =
  "scuzz run [project] [--headless] [--watch]\n\nBuild and run. --headless forces Headless (writes build/snapshot.png).\nDefault follows [ui].default_runtime when present.\n[ui] --watch keeps the process and stamp-reloads the View tree (not source).\nLive dump: build/debug.dump. Live inject: append tap/text/type/pump/scroll/backspace lines to build/inject.script.\nIO-only --watch rebuilds and reruns after the process exits.\n\nExamples:\n  scuzz run\n  scuzz run --headless\n  scuzz run --watch --headless\n  scuzz run examples/counter --headless\n"

def helpTest(): String =
  "scuzz test [project] [--update] [--pixels] [--runtime-tests]\n\n[ui]: Headless structural goldens (seed on first run). IO: TESTRT exit-0 smoke.\n\nExamples:\n  scuzz test\n  scuzz test --update\n  scuzz test --pixels\n"

def helpCheck(): String =
  "scuzz check [project] [--message-format=human|json]\n\nFormat-check src/, then typecheck live + sim + laws. JSON is the editor protocol (LSP wraps check).\n\nExamples:\n  scuzz check\n  scuzz check --message-format=json\n"

def helpFuzz(): String =
  "scuzz fuzz [project] [--iters N] [--seed S] [--exhaust --depth N] [--replay FILE]\n\nSearch laws under TestRuntime. [ui]: event scripts × schedules; IO-only: schedules.\n--exhaust is [ui] event alphabet only (FIFO schedule).\n\nExamples:\n  scuzz fuzz --iters 16\n  scuzz fuzz --iters 16 examples/concurrency\n  scuzz fuzz --exhaust --depth 1\n  scuzz fuzz --replay build/fuzz/repro.toml\n"

def helpFmt(): String =
  "scuzz fmt [project] [--check]\n\nFormat *.scuzz under src/. --check is nonzero if files would change.\n\nExamples:\n  scuzz fmt\n  scuzz fmt --check\n"

def helpWatch(): String =
  "scuzz watch [project]\n\nRebuild when sources or scuzz.toml change. Does not hot-reload a running\nprocess or preserve Signal state.\n\nExamples:\n  scuzz watch\n  scuzz watch examples/counter\n"

def helpNew(): String =
  "scuzz new <name> [--ui] [--path <dir>]\n\nScaffold a project. --ui is a Counter-shaped Headless app; otherwise IO hello.\n\nExamples:\n  scuzz new myapp --ui\n  scuzz new mycli\n  scuzz new myapp --ui --path /tmp\n"

def helpPackage(): String =
  "scuzz package [project] [--target host|android|ios|all]\n\nEmit copy-patched mobile packaging shells (not a Gradle/CocoaPods API).\n\nExamples:\n  scuzz package\n  scuzz package --target host\n"

def helpFor(cmd: String): String =
  if (streq(cmd, "build") == 1) helpBuild() else if (streq(cmd, "run") == 1) helpRun() else if (streq(cmd, "test") == 1) helpTest() else if (streq(cmd, "check") == 1) helpCheck() else if (streq(cmd, "fuzz") == 1) helpFuzz() else if (streq(cmd, "fmt") == 1) helpFmt() else if (streq(cmd, "watch") == 1) helpWatch() else if (streq(cmd, "new") == 1) helpNew() else if (streq(cmd, "package") == 1) helpPackage() else str3("unknown command: ", cmd, Str.concat("\n", usage()))

def isHelpToken(s: String): Int =
  if (streq(s, "--help") == 1) 1 else if (streq(s, "-h") == 1) 1 else if (streq(s, "help") == 1) 1 else 0

def wantsHelp(args: List): Int =
  if (argFlag(args, "--help", 0) == 1) 1 else argFlag(args, "-h", 0)

def isFlag(s: String): Int =
  if (startsWith(s, "--") == 1) 1 else 0

def positionalAt(args: List, i: Int, n: Int): String =
  if (i >= List.len(args)) "." else if (streq(List.at(args, i), "--path") == 1) positionalAt(args, i + 2, n) else if (streq(List.at(args, i), "--target") == 1) positionalAt(args, i + 2, n) else if (isFlag(List.at(args, i)) == 1) positionalAt(args, i + 1, n) else if (n == 0) List.at(args, i) else positionalAt(args, i + 1, n - 1)

def defaultProject(args: List): String =
  positionalAt(args, 1, 0)

def argFlag(args: List, flag: String, i: Int): Int =
  if (i >= List.len(args)) 0 else if (streq(List.at(args, i), flag) == 1) 1 else argFlag(args, flag, i + 1)

def argValue(args: List, flag: String, i: Int): String =
  if (i >= List.len(args)) "" else if (streq(List.at(args, i), flag) == 1) if (i + 1 >= List.len(args)) "" else List.at(args, i + 1) else if (startsWith(List.at(args, i), Str.concat(flag, "=")) == 1) Str.slice(List.at(args, i), Str.len(flag) + 1, Str.len(List.at(args, i))) else argValue(args, flag, i + 1)

def messageFormatJson(args: List): Int =
  if (streq(argValue(args, "--message-format", 0), "json") == 1) 1 else 0

def packageTarget(args: List): String =
  for {
    v = argValue(args, "--target", 0)
  } yield if (Str.len(v) == 0) "all" else v

def dispatch(args: List): IO[Unit] =
  if (List.isEmpty(args) == 1) IO.println(usage()) else dispatchSkipFlags(args, args)

def dispatchSkipFlags(args: List, all: List): IO[Unit] =
  if (List.isEmpty(args) == 1) IO.println(usage()) else if (isFlag(List.head(args)) == 1) if (startsWith(List.head(args), "--message-format=") == 1) dispatchSkipFlags(List.tail(args), all) else if (streq(List.head(args), "--message-format") == 1) if (List.len(args) < 2) IO.println(usage()) else dispatchSkipFlags(List.tail(List.tail(args)), all) else dispatchCmd(List.head(args), args, all) else dispatchCmd(List.head(args), args, all)

def dispatchCmd(cmd: String, args: List, all: List): IO[Unit] =
  if (isHelpToken(cmd) == 1) IO.println(helpTop()) else if (wantsHelp(args) == 1) IO.println(helpFor(cmd)) else if (streq(cmd, "build") == 1) dispatchBuild(defaultProject(args)) else if (streq(cmd, "run") == 1) cmdRun(defaultProject(args), argFlag(args, "--headless", 0), argFlag(args, "--watch", 0)) else if (streq(cmd, "test") == 1) cmdTest(defaultProject(args), argFlag(args, "--update", 0), argFlag(args, "--runtime-tests", 0), argFlag(args, "--pixels", 0)) else if (streq(cmd, "check") == 1) cmdCheck(defaultProject(args), messageFormatJson(all)) else if (streq(cmd, "fuzz") == 1) cmdFuzzArgs(args) else if (streq(cmd, "fmt") == 1) cmdFmt(defaultProject(args), argFlag(args, "--check", 0)) else if (streq(cmd, "watch") == 1) cmdWatch(defaultProject(args)) else if (streq(cmd, "new") == 1) cmdNew(args) else if (streq(cmd, "package") == 1) cmdPackage(defaultProject(args), packageTarget(args)) else IO.println(str3("unknown command: ", cmd, Str.concat("\n", usage())))

def dispatchBuild(projectDir: String): IO[Unit] =
  compileProject(projectDir, pathJoin(projectDir, "build"))

def cmdCheck(projectDir: String, json: Int): IO[Unit] =
  fmtDirtyFiles(projectDir).flatMap(dirty =>
    checkProject(projectDir).flatMap(res => emitHygiene(dirty, List.head(res), List.head(List.tail(res)), json))
  )

def emitHygiene(dirty: List, ty: TyRes, sources: List, json: Int): IO[Unit] =
  for {
    fmtObjs = fmtDiagObjs(dirty, json)
    tyObjs = tyDiagObjs(ty, sources, json)
    objs = listConcat(fmtObjs, tyObjs)
  } yield if (List.isEmpty(objs) == 1) if (json == 1) IO.println("[]") else IO.println("scuzz check ok") else emitHygieneFail(objs, json)

def emitHygieneFail(objs: List, json: Int): IO[Unit] =
  if (json == 1) IO.println(str3("[", join(objs, ","), "]")).flatMap(_ => IO.fail("check failed")) else IO.println(join(objs, "\n")).flatMap(_ => IO.fail("check failed"))

def tyDiagObjs(ty: TyRes, sources: List, json: Int): List =
  if (tyIsOk(ty) == 1) List.empty() else List.cons(tyDiagOne(ty, sources, json), List.empty())

def tyDiagOne(ty: TyRes, sources: List, json: Int): String =
  for {
    msg = tyMsg(ty)
    loc = diagLoc(ty, sources)
  } yield if (json == 1) diagJson(msg, loc) else diagHuman(msg, loc)

def fmtDiagObjs(dirty: List, json: Int): List =
  if (List.isEmpty(dirty) == 1) List.empty() else List.cons(fmtDiagOne(List.head(dirty), json), fmtDiagObjs(List.tail(dirty), json))

def fmtDiagOne(path: String, json: Int): String =
  for {
    loc = List.cons(path, List.cons("1", List.cons("1", List.empty())))
  } yield if (json == 1) diagJson("needs formatting (run scuzz fmt)", loc) else diagHuman("needs formatting (run scuzz fmt)", loc)

def diagLoc(ty: TyRes, sources: List): List =
  if (tyIsAt(ty) == 0) List.empty() else diagLocFromSpan(tyAtFile(ty), tyAtStart(ty), sources)

def diagLocFromSpan(file: String, start: Int, sources: List): List =
  for {
    text = findSourceText(sources, file)
    lc = if (Str.len(text) == 0) pair("1", "1") else offsetToLineCol(text, start)
  } yield List.cons(file, List.cons(fst(lc), List.cons(snd(lc), List.empty())))

def diagHasLoc(loc: List): Int =
  if (List.isEmpty(loc) == 1) 0 else 1

def diagFile(loc: List): String =
  List.head(loc)

def diagLine(loc: List): String =
  List.head(List.tail(loc))

def diagCol(loc: List): String =
  List.head(List.tail(List.tail(loc)))

def diagHuman(msg: String, loc: List): String =
  if (diagHasLoc(loc) == 0) str3("error: ", msg, "") else str5(diagFile(loc), ":", diagLine(loc), ":", str4(diagCol(loc), ": error: ", msg, ""))

def diagJson(msg: String, loc: List): String =
  if (diagHasLoc(loc) == 0) str3("{\"severity\":\"error\",\"message\":", jsonQuote(msg), "}") else str5("{\"severity\":\"error\",\"message\":", jsonQuote(msg), ",\"file\":", jsonQuote(diagFile(loc)), str5(",\"line\":", diagLine(loc), ",\"column\":", diagCol(loc), "}"))

def jsonQuote(s: String): String =
  str3("\"", jsonEscape(s, 0, ""), "\"")

def jsonEscape(s: String, i: Int, acc: String): String =
  if (i >= Str.len(s)) acc else jsonEscapeChar(s, i, acc, Str.charAt(s, i))

def jsonEscapeChar(s: String, i: Int, acc: String, c: Int): String =
  if (c == 34) jsonEscape(s, i + 1, Str.concat(acc, "\\\"")) else if (c == 92) jsonEscape(s, i + 1, Str.concat(acc, "\\\\")) else if (c == 10) jsonEscape(s, i + 1, Str.concat(acc, "\\n")) else jsonEscape(s, i + 1, Str.concat(acc, charToStr(c)))

@main def main: IO[Unit] =
  Sys.args().flatMap(args => dispatch(args))
