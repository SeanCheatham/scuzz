package scuzz.compiler

enum EmitKind:
  case Int
  case Ptr
  case Io
  case IoInt

enum Emit:
  case S(code: String, value: String, kind: EmitKind, id: Int, conts: String)

enum EnvBind:
  case Bind(name: String, value: String, kind: EmitKind)

enum CasePayload:
  case Row(key: String, tys: List)

def mkS(code: String, value: String, kind: EmitKind, id: Int, conts: String): Emit =
  Emit.S(code, value, kind, id, conts)

def sCode(s: Emit): String =
  s match {
    case Emit.S(code, value, kind, id, conts) => code
  }

def sValue(s: Emit): String =
  s match {
    case Emit.S(code, value, kind, id, conts) => value
  }

def sKind(s: Emit): EmitKind =
  s match {
    case Emit.S(code, value, kind, id, conts) => kind
  }

def sId(s: Emit): Int =
  s match {
    case Emit.S(code, value, kind, id, conts) => id
  }

def sConts(s: Emit): String =
  s match {
    case Emit.S(code, value, kind, id, conts) => conts
  }

def kindIsInt(k: EmitKind): Int =
  k match {
    case EmitKind.Int => 1
    case _ => 0
  }

def kindIsPtr(k: EmitKind): Int =
  k match {
    case EmitKind.Ptr => 1
    case _ => 0
  }

def isIoKind(k: EmitKind): Int =
  k match {
    case EmitKind.Io => 1
    case EmitKind.IoInt => 1
    case _ => 0
  }

def payloadOfKind(k: EmitKind): EmitKind =
  k match {
    case EmitKind.IoInt => EmitKind.Int
    case _ => EmitKind.Ptr
  }

def llvmTyOfKind(k: EmitKind): String =
  k match {
    case EmitKind.Int => "i64"
    case _ => "ptr"
  }

def envPut(env: List, name: String, value: String, kind: EmitKind): List =
  List.cons(EnvBind.Bind(name, value, kind), env)

def envMiss(): EnvBind =
  EnvBind.Bind("", "null", EmitKind.Ptr)

def envGet(env: List, name: String): EnvBind =
  if (List.isEmpty(env) == 1) envMiss() else envGetCont(List.head(env), List.tail(env), name)

def envGetCont(b: EnvBind, rest: List, name: String): EnvBind =
  b match {
    case EnvBind.Bind(n, value, kind) => if (streq(n, name) == 1) b else envGet(rest, name)
  }

def envBindValue(b: EnvBind): String =
  b match {
    case EnvBind.Bind(n, value, kind) => value
  }

def envBindKind(b: EnvBind): EmitKind =
  b match {
    case EnvBind.Bind(n, value, kind) => kind
  }

def envGetVal(env: List, name: String): String =
  envBindValue(envGet(env, name))

def envGetKind(env: List, name: String): EmitKind =
  envBindKind(envGet(env, name))

def payloadRowKey(r: CasePayload): String =
  r match {
    case CasePayload.Row(key, tys) => key
  }

def payloadRowTys(r: CasePayload): List =
  r match {
    case CasePayload.Row(key, tys) => tys
  }

