package scuzz.compiler

enum EmitKind:
  case Int
  case Ptr
  case Io
  case IoInt

enum Emit:
  case S(code: String, value: String, kind: EmitKind, id: Int, conts: String)

enum EnvBind:
  case Bind(name: String, value: String, kind: EmitKind)

enum CasePayload:
  case Row(key: String, tys: List)

def mkS(code: String, value: String, kind: EmitKind, id: Int, conts: String): Emit =
  Emit.S(code, value, kind, id, conts)

def sCode(s: Emit): String =
  s match {
    case Emit.S(code, value, kind, id, conts) => code
  }

def sValue(s: Emit): String =
  s match {
    case Emit.S(code, value, kind, id, conts) => value
  }

def sKind(s: Emit): EmitKind =
  s match {
    case Emit.S(code, value, kind, id, conts) => kind
  }

def sId(s: Emit): Int =
  s match {
    case Emit.S(code, value, kind, id, conts) => id
  }

def sConts(s: Emit): String =
  s match {
    case Emit.S(code, value, kind, id, conts) => conts
  }

def kindIsInt(k: EmitKind): Int =
  k match {
    case EmitKind.Int => 1
    case EmitKind.Ptr => 0
    case EmitKind.Io => 0
    case EmitKind.IoInt => 0
  }

def kindIsPtr(k: EmitKind): Int =
  k match {
    case EmitKind.Ptr => 1
    case EmitKind.Int => 0
    case EmitKind.Io => 0
    case EmitKind.IoInt => 0
  }

def isIoKind(k: EmitKind): Int =
  k match {
    case EmitKind.Io => 1
    case EmitKind.IoInt => 1
    case EmitKind.Int => 0
    case EmitKind.Ptr => 0
  }

def kindEq(a: EmitKind, b: EmitKind): Int =
  a match {
    case EmitKind.Int => kindIsInt(b)
    case EmitKind.Ptr => kindIsPtr(b)
    case EmitKind.Io => kindEqIo(b)
    case EmitKind.IoInt => kindEqIoInt(b)
  }

def kindEqIo(b: EmitKind): Int =
  b match {
    case EmitKind.Io => 1
    case EmitKind.Int => 0
    case EmitKind.Ptr => 0
    case EmitKind.IoInt => 0
  }

def kindEqIoInt(b: EmitKind): Int =
  b match {
    case EmitKind.IoInt => 1
    case EmitKind.Int => 0
    case EmitKind.Ptr => 0
    case EmitKind.Io => 0
  }

def payloadOfKind(k: EmitKind): EmitKind =
  k match {
    case EmitKind.IoInt => EmitKind.Int
    case EmitKind.Int => EmitKind.Ptr
    case EmitKind.Ptr => EmitKind.Ptr
    case EmitKind.Io => EmitKind.Ptr
  }

def llvmTyOfKind(k: EmitKind): String =
  k match {
    case EmitKind.Int => "i64"
    case EmitKind.Ptr => "ptr"
    case EmitKind.Io => "ptr"
    case EmitKind.IoInt => "ptr"
  }

def envPut(env: List, name: String, value: String, kind: EmitKind): List =
  List.cons(EnvBind.Bind(name, value, kind), env)

def envGetVal(env: List, name: String): String =
  if (List.isEmpty(env) == 1) "null" else envGetValCont(List.head(env), List.tail(env), name)

def envGetValCont(b: EnvBind, rest: List, name: String): String =
  b match {
    case EnvBind.Bind(n, value, kind) => if (streq(n, name) == 1) value else envGetVal(rest, name)
  }

def envGetKind(env: List, name: String): EmitKind =
  if (List.isEmpty(env) == 1) EmitKind.Ptr else envGetKindCont(List.head(env), List.tail(env), name)

def envGetKindCont(b: EnvBind, rest: List, name: String): EmitKind =
  b match {
    case EnvBind.Bind(n, value, kind) => if (streq(n, name) == 1) kind else envGetKind(rest, name)
  }

def payloadRowKey(r: CasePayload): String =
  r match {
    case CasePayload.Row(key, tys) => key
  }

def payloadRowTys(r: CasePayload): List =
  r match {
    case CasePayload.Row(key, tys) => tys
  }

