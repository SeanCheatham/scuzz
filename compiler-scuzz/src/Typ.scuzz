package scuzz.compiler

def fieldTy(f: EnumField): Type =
  f match {
    case EnumField.Field(name, ty) => ty
  }

def paramTy(p: Param): Type =
  p match {
    case Param(name, ty) => ty
  }

def declRet(d: Def): Type =
  d match {
    case Def(name, params, ret, body, module, isPrivate, typeParams) => ret
  }

def findEnum(enums: List, name: String): List =
  findEnumById(enums, name)

def findDupEnum(enums: List, seen: List): String =
  if (List.isEmpty(enums) == 1) "" else findDupEnumOne(List.head(enums), List.tail(enums), seen)

def findDupEnumOne(e: EnumDef, rest: List, seen: List): String =
  for {
    q = qualKey(enumModule(e), enumName(e))
  } yield if (defSeen(seen, q) == 1) q else findDupEnum(rest, List.cons(q, seen))

def enumHasCase(cases: List, name: String): Int =
  if (List.isEmpty(cases) == 1) 0 else if (streq(caseName(List.head(cases)), name) == 1) 1 else enumHasCase(List.tail(cases), name)

def findCase(cases: List, name: String): List =
  if (List.isEmpty(cases) == 1) List.empty() else if (streq(caseName(List.head(cases)), name) == 1) caseHit(List.head(cases)) else findCase(List.tail(cases), name)

def checkPayloadFields(en: String, c: EnumCase): TyRes =
  for {
    fields = caseFields(c)
  } yield if (List.isEmpty(fields) == 1) tyOk(Type.Unit) else checkPayloadFieldTys(en, caseName(c), fields)

def checkPayloadFieldTys(en: String, cn: String, fields: List): TyRes =
  if (List.isEmpty(fields) == 1) tyOk(Type.Unit) else for {
  one = checkPayloadFieldTy(en, cn, List.head(fields))
} yield if (tyIsOk(one) == 0) one else checkPayloadFieldTys(en, cn, List.tail(fields))

def checkPayloadFieldTy(en: String, cn: String, f: EnumField): TyRes =
  for {
    ty = fieldTy(f)
  } yield checkPayloadFieldTyOne(en, cn, f, ty)

def checkPayloadFieldTyOne(en: String, cn: String, f: EnumField, ty: Type): TyRes =
  ty match {
    case Type.Int => tyOk(Type.Unit)
    case Type.String => tyOk(Type.Unit)
    case Type.List => tyOk(Type.Unit)
    case Type.Adt(name) => tyOk(Type.Unit)
    case Type.Var(name) => tyOk(Type.Unit)
    case Type.App(name, args) => tyOk(Type.Unit)
    case _ => tyErr(str5(en, ".", cn, str3(" field ", fieldName(f), ": Stage 0 payload types are Int, String, List, or an ADT, got "), tyShow(ty)))
  }

def defSeen(seen: List, name: String): Int =
  if (List.isEmpty(seen) == 1) 0 else if (streq(List.head(seen), name) == 1) 1 else defSeen(List.tail(seen), name)

def findDupDef(defs: List, seen: List): String =
  if (List.isEmpty(defs) == 1) "" else findDupDefOne(List.head(defs), List.tail(defs), seen)

def findDupDefOne(d: Def, rest: List, seen: List): String =
  for {
    q = qualKey(defModule(d), defName(d))
  } yield if (defSeen(seen, q) == 1) q else findDupDef(rest, List.cons(q, seen))

def bindParams(params: List, enums: List, imports: List, mod: String, tparams: List, env: List): List =
  if (List.isEmpty(params) == 1) env else bindParams(List.tail(params), enums, imports, mod, tparams, tyEnvPut(env, paramName(List.head(params)), resolveTypeIn(paramTy(List.head(params)), enums, imports, mod, tparams)))

def resolveType(ty: Type, enums: List, imports: List, mod: String): Type =
  resolveTypeIn(ty, enums, imports, mod, List.empty())

def resolveTypeIn(ty: Type, enums: List, imports: List, mod: String, tparams: List): Type =
  ty match {
    case Type.Var(name) => if (listContainsStr(tparams, name) == 1) tyMkVar(name) else tyMkVar(name)
    case Type.Adt(name) => if (listContainsStr(tparams, name) == 1) tyMkVar(name) else resolveTypeAdt(name, enums, imports, mod)
    case Type.App(name, args) => resolveTypeApp(name, args, enums, imports, mod, tparams)
    case Type.Io(inner) => Type.Io(resolveTypeIn(inner, enums, imports, mod, tparams))
    case _ => ty
  }

def resolveTypeApp(name: String, args: List, enums: List, imports: List, mod: String, tparams: List): Type =
  for {
    e = resolveEnum(enums, imports, name, mod)
    rargs = resolveTypeArgsIn(args, enums, imports, mod, tparams, List.empty())
  } yield if (List.isEmpty(e) == 1) Type.App(name, rargs) else Type.App(enumId(List.head(e)), rargs)

def resolveTypeArgsIn(args: List, enums: List, imports: List, mod: String, tparams: List, acc: List): List =
  if (List.isEmpty(args) == 1) List.reverse(acc) else resolveTypeArgsIn(List.tail(args), enums, imports, mod, tparams, List.cons(resolveTypeIn(List.head(args), enums, imports, mod, tparams), acc))

def resolveTypeAdt(name: String, enums: List, imports: List, mod: String): Type =
  for {
    e = resolveEnum(enums, imports, name, mod)
  } yield if (List.isEmpty(e) == 1) Type.Adt(name) else Type.Adt(enumId(List.head(e)))

def mkFuns(mod: String, defs: List, imports: List): List =
  List.cons(mod, List.cons(defs, List.cons(imports, List.empty())))

def funsMod(funs: List): String =
  List.head(funs)

def funsDefs(funs: List): List =
  List.head(List.tail(funs))

def funsImports(funs: List): List =
  List.head(List.tail(List.tail(funs)))

def typecheckProg(prog: Prog): TyRes =
  for {
    dup = findDupDef(progDefs(prog), List.empty())
    edup = findDupEnum(progEnums(prog), List.empty())
    defs = progDefs(prog)
    enums = progEnums(prog)
    imports = progImports(prog)
    impErr = validateImports(imports, defs, enums)
  } yield if (Str.len(dup) > 0) tyErr(str3("duplicate def ", dup, "")) else if (Str.len(edup) > 0) tyErr(str3("duplicate enum ", edup, "")) else if (Str.len(impErr) > 0) tyErr(impErr) else typecheckDefsThenMain(defs, enums, defs, imports, progMain(prog), progMainModule(prog))

def expandImplsProg(prog: Prog): Prog =
  for {
    extra = expandAllImpls(progImpls(prog), List.empty())
  } yield setProgDefs(prog, listConcat(progDefs(prog), extra))

def expandAllImpls(impls: List, acc: List): List =
  if (List.isEmpty(impls) == 1) List.reverse(acc) else expandAllImpls(List.tail(impls), listConcat(expandOneImpl(List.head(impls), List.empty()), acc))

def expandOneImpl(im: ImplDef, acc: List): List =
  im match {
    case ImplDef.Impl(module, traitName, forType, methods) => expandOneImplMethods(module, traitName, forType, methods, acc)
  }

def expandOneImplMethods(module: String, traitName: String, forType: String, methods: List, acc: List): List =
  if (List.isEmpty(methods) == 1) List.reverse(acc) else expandOneImplMethods(module, traitName, forType, List.tail(methods), List.cons(expandOneImplMethod(module, traitName, forType, List.head(methods)), acc))

def expandOneImplMethod(module: String, traitName: String, forType: String, m: ImplMethod): Def =
  m match {
    case ImplMethod.Method(name, params, ret, body) => Def.Def(implMethodName(traitName, forType, name), List.cons(Param.Param("self", Type.Adt(forType)), params), ret, body, module, 0, List.empty())
  }

def importDupKey(im: Import): String =
  str3(importInModule(im), ".", importName(im))

def validateImports(imports: List, defs: List, enums: List): String =
  validateImportsAcc(imports, defs, enums, List.empty())

def validateImportsAcc(imports: List, defs: List, enums: List, seen: List): String =
  if (List.isEmpty(imports) == 1) "" else validateImportsOne(List.head(imports), List.tail(imports), defs, enums, seen)

def validateImportsOne(im: Import, rest: List, defs: List, enums: List, seen: List): String =
  for {
    key = importDupKey(im)
  } yield if (defSeen(seen, key) == 1) str4("duplicate import of ", importName(im), " in module ", importInModule(im)) else validateImportTarget(im, rest, defs, enums, List.cons(key, seen))

def validateImportTarget(im: Import, rest: List, defs: List, enums: List, seen: List): String =
  for {
    hit = findDefByQual(defs, importFromModule(im), importName(im))
    ehit = findEnumByQual(enums, importFromModule(im), importName(im))
  } yield if (List.isEmpty(hit) == 0) if (defIsPrivate(resolvedDef(hit)) == 1) str4("cannot import private def ", importFromModule(im), ".", importName(im)) else validateImportsAcc(rest, defs, enums, seen) else if (List.isEmpty(ehit) == 0) validateImportsAcc(rest, defs, enums, seen) else str4("unknown import ", importFromModule(im), ".", importName(im))

def typecheckDefsThenMain(defs: List, enums: List, allDefs: List, imports: List, main: Expr, mainMod: String): TyRes =
  if (List.isEmpty(defs) == 1) checkMainTy(inferExpr(main, enums, mkFuns(mainMod, allDefs, imports), List.empty())) else typecheckDefsThenMainOne(List.head(defs), List.tail(defs), enums, allDefs, imports, main, mainMod)

def typecheckDefsThenMainOne(d: Def, rest: List, enums: List, allDefs: List, imports: List, main: Expr, mainMod: String): TyRes =
  for {
    tparams = defTypeParams(d)
    env = bindParams(defParams(d), enums, imports, defModule(d), tparams, List.empty())
    bodyR = inferExpr(defBody(d), enums, mkFuns(defModule(d), allDefs, imports), env)
    ret = resolveTypeIn(declRet(d), enums, imports, defModule(d), tparams)
  } yield if (tyIsOk(bodyR) == 0) bodyR else if (typesCompat(tyVal(bodyR), ret) == 0) tyErr(str5("def ", defName(d), " body ", tyShow(tyVal(bodyR)), str3(" does not match declared ", tyShow(ret), ""))) else typecheckDefsThenMain(rest, enums, allDefs, imports, main, mainMod)

def checkMainTy(r: TyRes): TyRes =
  if (tyIsOk(r) == 0) r else if (tyEq(tyVal(r), tyMkIo(Type.Unit)) == 1) tyOk(tyMkIo(Type.Unit)) else tyErr(str3("@main body must be IO[Unit], got ", tyShow(tyVal(r)), ""))

def inferExpr(e: Expr, enums: List, funs: List, env: List): TyRes =
  for {
    r = inferExprMatch(e, enums, funs, env)
  } yield withSpanIfBare(r, exprSpan(e))

def inferExprMatch(e: Expr, enums: List, funs: List, env: List): TyRes =
  e match {
    case Expr.Unit(span) => tyOk(Type.Unit)
    case Expr.IntLit(digits, span) => tyOk(Type.Int)
    case Expr.StrLit(value, span) => tyOk(Type.String)
    case Expr.ListLit(elems, span) => inferListLit(elems, enums, funs, env)
    case Expr.Interp(parts, span) => inferInterp(parts, enums, funs, env)
    case Expr.Println(arg, span) => inferIoChild(arg, Type.String, enums, funs, env)
    case Expr.Delay(span) => tyOk(tyMkIo(Type.Unit))
    case Expr.Sleep(arg, span) => inferIoChild(arg, Type.Int, enums, funs, env)
    case Expr.Fail(arg, span) => inferIoChild(arg, Type.String, enums, funs, env)
    case Expr.Pure(arg, span) => inferPure(arg, enums, funs, env)
    case Expr.Var(name, span) => inferVar(name, env)
    case Expr.Field(base, field, span) => inferField(base, field, enums, funs, env)
    case Expr.MethodCall(receiver, method, args, span) => inferMethodCall(receiver, method, args, enums, funs, env)
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => inferAdt(enumName, caseName, args, enums, funs, env)
    case Expr.Let(name, value, body, span) => inferLet(name, value, body, enums, funs, env)
    case Expr.If(cond, thenB, elseB, span) => inferIf(cond, thenB, elseB, enums, funs, env)
    case Expr.BinOp(op, left, right, span) => inferBinOp(op, left, right, enums, funs, env)
    case Expr.Call(callee, args, span) => inferCall(callee, args, enums, funs, env)
    case Expr.Match(scrut, arms, span) => inferMatch(scrut, arms, enums, funs, env)
    case Expr.FlatMap(inner, param, body, span) => inferFlatMap(inner, param, body, enums, funs, env)
    case Expr.Handle(inner, body, span) => inferHandle(inner, body, enums, funs, env)
    case Expr.Attempt(inner, span) => inferAttempt(inner, enums, funs, env)
    case Expr.Lambda(param, body, span) => inferLambda(param, body, enums, funs, env)
    case Expr.IoRace(left, right, span) => inferIoPair(left, right, enums, funs, env)
    case Expr.IoBoth(left, right, span) => inferIoPair(left, right, enums, funs, env)
    case Expr.For(binders, body, span) => tyErr("internal: unlowered `for` (run lower before typecheck)")
  }

def inferIoChild(child: Expr, want: Type, enums: List, funs: List, env: List): TyRes =
  for {
    r = inferExpr(child, enums, funs, env)
  } yield if (tyIsOk(r) == 0) r else if (typesCompat(tyVal(r), want) == 1) tyOk(tyMkIo(Type.Unit)) else tyErr(str4("expected ", tyShow(want), ", got ", tyShow(tyVal(r))))

def inferPure(inner: Expr, enums: List, funs: List, env: List): TyRes =
  for {
    r = inferExpr(inner, enums, funs, env)
  } yield if (tyIsOk(r) == 0) r else tyOk(tyMkIo(tyVal(r)))

def inferVar(name: String, env: List): TyRes =
  for {
    ts = tyEnvGet(env, name)
  } yield if (List.isEmpty(ts) == 1) tyErr(str3("unbound variable ", name, "")) else tyOk(List.head(ts))

def isRecordLike(e: EnumDef): Int =
  if (enumIsRecord(e) == 1) 1 else if (List.len(enumCases(e)) == 1) if (streq(caseName(List.head(enumCases(e))), enumName(e)) == 1) 1 else 0 else 0

def inferField(base: Expr, field: String, enums: List, funs: List, env: List): TyRes =
  for {
    br = inferExpr(base, enums, funs, env)
  } yield if (tyIsOk(br) == 0) br else inferFieldTy(tyVal(br), field, enums, funsMod(funs), funsImports(funs))

def inferMethodCall(receiver: Expr, method: String, args: List, enums: List, funs: List, env: List): TyRes =
  for {
    rr = inferExpr(receiver, enums, funs, env)
  } yield if (tyIsOk(rr) == 0) rr else inferMethodCallOnTy(tyVal(rr), method, args, enums, funs, env, receiver)

def inferMethodCallOnTy(rt: Type, method: String, args: List, enums: List, funs: List, env: List, receiver: Expr): TyRes =
  rt match {
    case Type.Adt(id) => inferMethodCallOnAdt(id, method, args, enums, funs, env, receiver)
    case _ => tyErr(str3("method .", method, str3(" needs a record/ADT receiver, got ", tyShow(rt), "")))
  }

def inferMethodCallOnAdt(id: String, method: String, args: List, enums: List, funs: List, env: List, receiver: Expr): TyRes =
  for {
    bare = enumBareFromId(id)
    mangled = findImplMangled(funsDefs(funs), bare, method)
  } yield if (Str.len(mangled) == 0) tyErr(str4("no impl method ", method, " for type ", id)) else inferCall(mangled, List.cons(receiver, args), enums, funs, env)

def findImplMangled(defs: List, bare: String, method: String): String =
  if (List.isEmpty(defs) == 1) "" else findImplMangledOne(List.head(defs), List.tail(defs), bare, method)

def findImplMangledOne(d: Def, rest: List, bare: String, method: String): String =
  for {
    name = defName(d)
    suf = str3("_", bare, str3("_", method, ""))
  } yield if (startsWith(name, "__impl_") == 1) if (endsWith(name, suf) == 1) name else findImplMangled(rest, bare, method) else findImplMangled(rest, bare, method)

def inferFieldTy(bt: Type, field: String, enums: List, mod: String, imports: List): TyRes =
  bt match {
    case Type.Adt(id) => inferFieldOnAdt(id, List.empty(), field, enums, mod, imports)
    case Type.App(id, args) => inferFieldOnAdt(id, args, field, enums, mod, imports)
    case _ => tyErr(str3("field access .", field, str3(" needs a record type, got ", tyShow(bt), "")))
  }

def inferFieldOnAdt(id: String, targs: List, field: String, enums: List, mod: String, imports: List): TyRes =
  for {
    e = resolveEnum(enums, imports, id, mod)
  } yield if (List.isEmpty(e) == 1) tyErr(str3("unknown enum ", id, "")) else if (isRecordLike(List.head(e)) == 0) tyErr(str3("field access .", field, str3(" requires a record type, got enum ", enumName(List.head(e)), ""))) else inferFieldLookup(List.head(e), field, targs, enums, imports)

def inferFieldLookup(e: EnumDef, field: String, targs: List, enums: List, imports: List): TyRes =
  for {
    c = List.head(enumCases(e))
    hit = findFieldTy(caseFields(c), field)
    ss = targsSubst(enumTParams(e), targs, List.empty(), List.empty())
    resolved = resolveTypeIn(List.head(hit), enums, imports, enumModule(e), enumTParams(e))
  } yield if (List.isEmpty(hit) == 1) tyErr(str4("record ", enumName(e), " has no field ", field)) else tyOk(eraseVars(applySubst(resolved, List.head(ss)), List.head(List.tail(ss))))

def targsSubst(tparams: List, targs: List, subst: List, skipped: List): List =
  if (List.isEmpty(tparams) == 1) List.cons(subst, List.cons(skipped, List.empty())) else if (tyIsOpaque(List.head(targs)) == 1) targsSubst(List.tail(tparams), List.tail(targs), subst, List.cons(List.head(tparams), skipped)) else targsSubst(List.tail(tparams), List.tail(targs), substPut(subst, List.head(tparams), List.head(targs)), skipped)

def findFieldTy(fields: List, name: String): List =
  if (List.isEmpty(fields) == 1) List.empty() else if (streq(fieldName(List.head(fields)), name) == 1) List.cons(fieldTy(List.head(fields)), List.empty()) else findFieldTy(List.tail(fields), name)

def inferAdt(en: String, cn: String, args: List, enums: List, funs: List, env: List): TyRes =
  for {
    e = resolveEnum(enums, funsImports(funs), en, funsMod(funs))
  } yield if (List.isEmpty(e) == 1) tyErr(str3("unknown enum ", en, "")) else inferAdtCase(List.head(e), cn, args, enums, funs, env)

def inferAdtCase(e: EnumDef, cn: String, args: List, enums: List, funs: List, env: List): TyRes =
  for {
    c = findCase(enumCases(e), cn)
  } yield if (List.isEmpty(c) == 1) tyErr(str4("unknown case ", enumId(e), ".", cn)) else inferAdtPayload(e, List.head(c), args, enums, funs, env)

def inferAdtPayload(e: EnumDef, c: EnumCase, args: List, enums: List, funs: List, env: List): TyRes =
  for {
    id = enumId(e)
    pf = checkPayloadFields(id, c)
    fields = caseFields(c)
    tparams = enumTParams(e)
  } yield if (tyIsOk(pf) == 0) pf else if (List.len(args) == List.len(fields)) if (List.isEmpty(tparams) == 1) inferAdtArgs(id, caseName(c), args, fields, enums, funs, env, enumModule(e)) else inferAdtGeneric(id, e, caseName(c), args, fields, tparams, enums, funs, env) else tyErr(str5(id, ".", caseName(c), " expects ", str3(Str.fromInt(List.len(fields)), " arg(s), got ", Str.fromInt(List.len(args)))))

def inferAdtGeneric(id: String, e: EnumDef, cn: String, args: List, fields: List, tparams: List, enums: List, funs: List, env: List): TyRes =
  for {
    us = inferAdtUnify(args, fields, tparams, enums, funs, env, enumModule(e), List.empty())
  } yield if (tyIsOk(List.head(us)) == 0) List.head(us) else tyOk(Type.App(id, substResultTypes(tparams, List.head(List.tail(us)), List.empty())))

def inferAdtUnify(args: List, fields: List, tparams: List, enums: List, funs: List, env: List, enumMod: String, subst: List): List =
  if (List.isEmpty(args) == 1) List.cons(tyOk(Type.Unit), List.cons(subst, List.empty())) else for {
  ar = inferExpr(List.head(args), enums, funs, env)
  want = resolveTypeIn(fieldTy(List.head(fields)), enums, funsImports(funs), enumMod, tparams)
  us = unifyConstruct(want, tyVal(ar), subst)
} yield if (tyIsOk(ar) == 0) List.cons(ar, List.cons(subst, List.empty())) else if (List.isEmpty(us) == 1) List.cons(tyErr(str4("type mismatch: expected ", tyShow(want), ", got ", tyShow(tyVal(ar)))), List.cons(subst, List.empty())) else inferAdtUnify(List.tail(args), List.tail(fields), tparams, enums, funs, env, enumMod, List.head(us))

def inferAdtArgs(en: String, cn: String, args: List, fields: List, enums: List, funs: List, env: List, enumMod: String): TyRes =
  if (List.isEmpty(args) == 1) tyOk(tyMkAdt(en)) else for {
  ar = inferExpr(List.head(args), enums, funs, env)
  want = resolveType(fieldTy(List.head(fields)), enums, funsImports(funs), enumMod)
} yield if (tyIsOk(ar) == 0) ar else if (typesCompat(tyVal(ar), want) == 0) tyErr(str4("expected ", tyShow(want), ", got ", tyShow(tyVal(ar)))) else inferAdtArgs(en, cn, List.tail(args), List.tail(fields), enums, funs, env, enumMod)

def inferLet(name: String, value: Expr, body: Expr, enums: List, funs: List, env: List): TyRes =
  for {
    vr = inferExpr(value, enums, funs, env)
  } yield if (tyIsOk(vr) == 0) vr else inferExpr(body, enums, funs, tyEnvPut(env, name, tyVal(vr)))

def inferIf(cond: Expr, thenB: Expr, elseB: Expr, enums: List, funs: List, env: List): TyRes =
  for {
    cr = inferExpr(cond, enums, funs, env)
  } yield if (tyIsOk(cr) == 0) cr else inferIfBranches(tyVal(cr), thenB, elseB, enums, funs, env)

def inferIfBranches(ct: Type, thenB: Expr, elseB: Expr, enums: List, funs: List, env: List): TyRes =
  ct match {
    case Type.Int => inferIfBody(thenB, elseB, enums, funs, env)
    case Type.Bool => inferIfBody(thenB, elseB, enums, funs, env)
    case _ => tyErr(str3("if condition must be Int/Bool, got ", tyShow(ct), ""))
  }

def inferIfBody(thenB: Expr, elseB: Expr, enums: List, funs: List, env: List): TyRes =
  for {
    tr = inferExpr(thenB, enums, funs, env)
    er = inferExpr(elseB, enums, funs, env)
  } yield if (tyIsOk(tr) == 0) tr else if (tyIsOk(er) == 0) er else if (typesCompat(tyVal(tr), tyVal(er)) == 0) tyErr(str4("if branches disagree: ", tyShow(tyVal(tr)), " vs ", tyShow(tyVal(er)))) else tr

def inferBinOp(op: String, left: Expr, right: Expr, enums: List, funs: List, env: List): TyRes =
  for {
    lr = inferExpr(left, enums, funs, env)
    rr = inferExpr(right, enums, funs, env)
  } yield if (tyIsOk(lr) == 0) lr else if (tyIsOk(rr) == 0) rr else inferBinOpTy(op, tyVal(lr), tyVal(rr))

def inferBinOpTy(op: String, lt: Type, rt: Type): TyRes =
  if (streq(op, "+") == 1) inferBinOpAdd(lt, rt) else if (streq(op, "-") == 1) inferArith(lt, rt) else if (streq(op, "*") == 1) inferArith(lt, rt) else if (streq(op, "/") == 1) inferArith(lt, rt) else if (streq(op, "%") == 1) inferArith(lt, rt) else if (streq(op, "==") == 1) inferEq(lt, rt) else if (streq(op, "!=") == 1) inferEq(lt, rt) else if (streq(op, "<") == 1) inferOrd(lt, rt) else if (streq(op, "<=") == 1) inferOrd(lt, rt) else if (streq(op, ">") == 1) inferOrd(lt, rt) else if (streq(op, ">=") == 1) inferOrd(lt, rt) else if (streq(op, "&&") == 1) inferLogic(lt, rt) else if (streq(op, "||") == 1) inferLogic(lt, rt) else tyErr(str3("unknown binop ", op, ""))

def inferBinOpAdd(lt: Type, rt: Type): TyRes =
  lt match {
    case Type.String => inferBinOpAddString(rt, lt)
    case Type.Int => inferBinOpAddInt(rt, lt)
    case _ => tyErr(str4("arithmetic needs Int, got ", tyShow(lt), " and ", tyShow(rt)))
  }

def inferBinOpAddString(rt: Type, lt: Type): TyRes =
  rt match {
    case Type.String => tyOk(Type.String)
    case _ => tyErr(str4("arithmetic needs Int, got ", tyShow(lt), " and ", tyShow(rt)))
  }

def inferBinOpAddInt(rt: Type, lt: Type): TyRes =
  rt match {
    case Type.Int => tyOk(Type.Int)
    case _ => tyErr(str4("arithmetic needs Int, got ", tyShow(lt), " and ", tyShow(rt)))
  }

def inferArith(lt: Type, rt: Type): TyRes =
  lt match {
    case Type.Int => inferArithRhs(rt, lt)
    case _ => tyErr(str4("arithmetic needs Int, got ", tyShow(lt), " and ", tyShow(rt)))
  }

def inferArithRhs(rt: Type, lt: Type): TyRes =
  rt match {
    case Type.Int => tyOk(Type.Int)
    case _ => tyErr(str4("arithmetic needs Int, got ", tyShow(lt), " and ", tyShow(rt)))
  }

def inferEq(lt: Type, rt: Type): TyRes =
  if (typesCompat(lt, rt) == 1) tyOk(Type.Int) else inferEqString(lt, rt)

def inferEqString(lt: Type, rt: Type): TyRes =
  lt match {
    case Type.String => inferEqStringRhs(rt, lt)
    case _ => tyErr(str4("comparison type mismatch ", tyShow(lt), " vs ", tyShow(rt)))
  }

def inferEqStringRhs(rt: Type, lt: Type): TyRes =
  rt match {
    case Type.String => tyOk(Type.Int)
    case _ => tyErr(str4("comparison type mismatch ", tyShow(lt), " vs ", tyShow(rt)))
  }

def inferOrd(lt: Type, rt: Type): TyRes =
  lt match {
    case Type.Int => inferOrdRhs(rt)
    case _ => tyErr("ordered compare needs Int")
  }

def inferOrdRhs(rt: Type): TyRes =
  rt match {
    case Type.Int => tyOk(Type.Int)
    case _ => tyErr("ordered compare needs Int")
  }

def inferLogic(lt: Type, rt: Type): TyRes =
  lt match {
    case Type.Int => inferLogicRhs(rt)
    case Type.Bool => inferLogicRhs(rt)
    case _ => tyErr("&&/|| need Int/Bool")
  }

def inferLogicRhs(rt: Type): TyRes =
  rt match {
    case Type.Int => tyOk(Type.Int)
    case Type.Bool => tyOk(Type.Int)
    case _ => tyErr("&&/|| need Int/Bool")
  }

def inferListLit(elems: List, enums: List, funs: List, env: List): TyRes =
  if (List.isEmpty(elems) == 1) tyOk(Type.List) else for {
  r = inferExpr(List.head(elems), enums, funs, env)
} yield if (tyIsOk(r) == 0) r else inferListLit(List.tail(elems), enums, funs, env)

def inferInterp(parts: List, enums: List, funs: List, env: List): TyRes =
  if (List.isEmpty(parts) == 1) tyOk(Type.String) else inferInterpPart(List.head(parts), List.tail(parts), enums, funs, env)

def inferInterpPart(part: InterpPart, rest: List, enums: List, funs: List, env: List): TyRes =
  part match {
    case InterpPart.Lit(text) => inferInterp(rest, enums, funs, env)
    case InterpPart.Hole(expr) => inferInterpHole(expr, rest, enums, funs, env)
  }

def inferInterpHole(expr: Expr, rest: List, enums: List, funs: List, env: List): TyRes =
  for {
    r = inferExpr(expr, enums, funs, env)
  } yield if (tyIsOk(r) == 0) r else inferInterpHoleTy(tyVal(r), rest, enums, funs, env)

def inferInterpHoleTy(t: Type, rest: List, enums: List, funs: List, env: List): TyRes =
  t match {
    case Type.String => inferInterp(rest, enums, funs, env)
    case Type.Int => inferInterp(rest, enums, funs, env)
    case Type.Opaque(name) => inferInterp(rest, enums, funs, env)
    case _ => tyErr(str3("interpolation hole must be String or Int, got ", tyShow(t), ""))
  }

def inferFlatMap(inner: Expr, param: String, body: Expr, enums: List, funs: List, env: List): TyRes =
  for {
    ir = inferExpr(inner, enums, funs, env)
  } yield if (tyIsOk(ir) == 0) ir else if (tyIsIo(tyVal(ir)) == 0) tyErr("flatMap receiver must be IO[_]") else inferFlatMapBody(param, tyIoInner(tyVal(ir)), body, enums, funs, env)

def inferFlatMapBody(param: String, innerT: Type, body: Expr, enums: List, funs: List, env: List): TyRes =
  for {
    env2 = if (Str.len(param) == 0) env else if (streq(param, "_") == 1) env else tyEnvPut(env, param, innerT)
    br = inferExpr(body, enums, funs, env2)
  } yield if (tyIsOk(br) == 0) br else if (tyIsIo(tyVal(br)) == 0) tyErr("flatMap body must return IO[_]") else br

def inferHandle(inner: Expr, body: Expr, enums: List, funs: List, env: List): TyRes =
  for {
    ir = inferExpr(inner, enums, funs, env)
    br = inferExpr(body, enums, funs, env)
  } yield if (tyIsOk(ir) == 0) ir else if (tyIsIo(tyVal(ir)) == 0) tyErr("handleErrorWith receiver must be IO[_]") else if (tyIsOk(br) == 0) br else if (tyIsIo(tyVal(br)) == 0) tyErr("handleErrorWith body must return IO[_]") else br

def inferAttempt(inner: Expr, enums: List, funs: List, env: List): TyRes =
  for {
    ir = inferExpr(inner, enums, funs, env)
  } yield if (tyIsOk(ir) == 0) ir else if (tyIsIo(tyVal(ir)) == 0) tyErr("attempt receiver must be IO[_]") else tyOk(tyMkIo(tyMkOpaque("Either")))

def inferLambda(param: String, body: Expr, enums: List, funs: List, env: List): TyRes =
  for {
    env2 = if (Str.len(param) == 0) env else if (streq(param, "_") == 1) env else tyEnvPut(env, param, tyMkOpaque("Param"))
    br = inferExpr(body, enums, funs, env2)
  } yield if (tyIsOk(br) == 0) br else tyOk(tyMkOpaque("TapFn"))

def inferIoPair(left: Expr, right: Expr, enums: List, funs: List, env: List): TyRes =
  for {
    lr = inferExpr(left, enums, funs, env)
    rr = inferExpr(right, enums, funs, env)
  } yield if (tyIsOk(lr) == 0) lr else if (tyIsOk(rr) == 0) rr else if (tyIsIo(tyVal(lr)) == 0) tyErr("IO.race/both arguments must be IO[_]") else if (tyIsIo(tyVal(rr)) == 0) tyErr("IO.race/both arguments must be IO[_]") else tyOk(tyMkIo(Type.Unit))

def inferMatch(scrut: Expr, arms: List, enums: List, funs: List, env: List): TyRes =
  for {
    sr = inferExpr(scrut, enums, funs, env)
  } yield if (tyIsOk(sr) == 0) sr else inferMatchArms(tyVal(sr), arms, enums, funs, env, List.empty())

def inferMatchArms(st: Type, arms: List, enums: List, funs: List, env: List, acc: List): TyRes =
  if (List.isEmpty(arms) == 1) if (List.isEmpty(acc) == 1) tyErr("empty match") else tyOk(List.head(acc)) else inferMatchArm(st, List.head(arms), List.tail(arms), enums, funs, env, acc)

def inferMatchArm(st: Type, arm: MatchArm, rest: List, enums: List, funs: List, env: List, acc: List): TyRes =
  for {
    pr = checkPattern(armPat(arm), st, enums)
    env2 = patternExtendEnv(armPat(arm), st, enums, env)
    br = inferExpr(armBody(arm), enums, funs, env2)
  } yield if (tyIsOk(pr) == 0) pr else if (tyIsOk(br) == 0) br else if (List.isEmpty(acc) == 1) inferMatchArms(st, rest, enums, funs, env, List.cons(tyVal(br), List.empty())) else if (typesCompat(List.head(acc), tyVal(br)) == 0) tyErr(str4("match arms disagree: ", tyShow(List.head(acc)), " vs ", tyShow(tyVal(br)))) else inferMatchArms(st, rest, enums, funs, env, acc)

def checkPattern(pat: Pattern, scrut: Type, enums: List): TyRes =
  pat match {
    case Pattern.Wild => tyOk(Type.Unit)
    case Pattern.Adt(enumName, caseName, binds, typeArgs) => checkPatAdt(enumName, caseName, binds, scrut, enums)
  }

def checkPatAdt(en: String, cn: String, binds: List, scrut: Type, enums: List): TyRes =
  for {
    e = findEnum(enums, en)
  } yield if (List.isEmpty(e) == 1) tyErr(str3("unknown enum ", en, " in pattern")) else checkPatAdtCase(en, cn, binds, scrut, List.head(e))

def checkPatAdtCase(en: String, cn: String, binds: List, scrut: Type, e: EnumDef): TyRes =
  for {
    c = findCase(enumCases(e), cn)
  } yield if (List.isEmpty(c) == 1) tyErr(str5("unknown case ", en, ".", cn, " in pattern")) else checkPatAdtScrut(en, cn, binds, scrut, e, List.head(c))

def checkPatAdtScrut(en: String, cn: String, binds: List, scrut: Type, e: EnumDef, c: EnumCase): TyRes =
  for {
    tparams = enumTParams(e)
    generic = if (List.isEmpty(tparams) == 1) 0 else 1
  } yield if (tyIsAdt(scrut) == 1) if (streq(tyAdtName(scrut), en) == 1) if (generic == 0) checkPatAdtBind(en, cn, binds, c) else tyErr(str5("pattern ", en, ".", cn, str3(" does not match scrutinee ", tyShow(scrut), ""))) else tyErr(str5("pattern ", en, ".", cn, str3(" does not match scrutinee ", tyShow(scrut), ""))) else if (tyIsApp(scrut) == 1) if (streq(tyAppName(scrut), en) == 1) checkPatAdtBind(en, cn, binds, c) else tyErr(str5("pattern ", en, ".", cn, str3(" does not match scrutinee ", tyShow(scrut), ""))) else if (tyIsOpaque(scrut) == 1) if (generic == 0) checkPatAdtBind(en, cn, binds, c) else tyErr(str3("cannot match an untyped value against generic enum ", en, "")) else tyErr(str5("pattern ", en, ".", cn, str3(" does not match scrutinee ", tyShow(scrut), "")))

def checkPatAdtBind(en: String, cn: String, binds: List, c: EnumCase): TyRes =
  for {
    pf = checkPayloadFields(en, c)
    fields = caseFields(c)
  } yield if (tyIsOk(pf) == 0) pf else if (List.len(binds) == List.len(fields)) tyOk(Type.Unit) else if (List.isEmpty(fields) == 1) tyErr(str5("pattern ", en, ".", cn, " is nullary; remove payload binder")) else if (List.isEmpty(binds) == 1) tyErr(str5("pattern ", en, ".", cn, str3(" needs a payload binder, e.g. ", str4(en, ".", cn, "(x)"), ""))) else tyErr(str5("pattern ", en, ".", cn, str3(" expects ", Str.fromInt(List.len(fields)), str3(" binder(s), got ", Str.fromInt(List.len(binds)), ""))))

def patternExtendEnv(pat: Pattern, scrut: Type, enums: List, env: List): List =
  pat match {
    case Pattern.Wild => env
    case Pattern.Adt(enumName, caseName, binds, typeArgs) => patternExtendEnvAdt(enumName, caseName, binds, scrut, enums, env)
  }

def patternExtendEnvAdt(en: String, cn: String, binds: List, scrut: Type, enums: List, env: List): List =
  if (List.isEmpty(binds) == 1) env else patternExtendEnvCase(en, cn, binds, scrut, enums, env)

def patternExtendEnvCase(en: String, cn: String, binds: List, scrut: Type, enums: List, env: List): List =
  for {
    e = findEnum(enums, en)
    c = findCase(enumCases(List.head(e)), cn)
    fields = caseFields(List.head(c))
    tparams = enumTParams(List.head(e))
    ss = if (tyIsApp(scrut) == 1) if (streq(tyAppName(scrut), en) == 1) targsSubst(tparams, tyAppArgs(scrut), List.empty(), List.empty()) else List.cons(List.empty(), List.cons(List.empty(), List.empty())) else List.cons(List.empty(), List.cons(List.empty(), List.empty()))
  } yield patternBindFields(binds, fields, tparams, List.head(ss), List.head(List.tail(ss)), enums, enumModule(List.head(e)), env)

def patternBindFields(binds: List, fields: List, tparams: List, subst: List, skipped: List, enums: List, enumMod: String, env: List): List =
  if (List.isEmpty(binds) == 1) env else patternBindFields(List.tail(binds), List.tail(fields), tparams, subst, skipped, enums, enumMod, tyEnvPut(env, List.head(binds), eraseVars(applySubst(resolveTypeIn(fieldTy(List.head(fields)), enums, List.empty(), enumMod, tparams), subst), skipped)))

def expectArity(name: String, n: Int, got: Int): TyRes =
  if (n == got) tyOk(Type.Unit) else tyErr(str4(name, " expects ", Str.fromInt(n), str3(" args, got ", Str.fromInt(got), "")))

def expectTy(got: Type, want: Type): TyRes =
  if (typesCompat(got, want) == 1) tyOk(Type.Unit) else tyErr(str4("expected ", tyShow(want), ", got ", tyShow(got)))

def argTyAt(tys: List, i: Int): Type =
  List.at(tys, i)

def inferCall(callee: String, args: List, enums: List, funs: List, env: List): TyRes =
  inferCallArgs(args, enums, funs, env, List.empty(), callee, funs)

def inferCallArgs(args: List, enums: List, funs: List, env: List, acc: List, callee: String, funs2: List): TyRes =
  if (List.isEmpty(args) == 1) inferCallTy(callee, List.reverse(acc), funs2, enums) else for {
  r = inferExpr(List.head(args), enums, funs, env)
} yield if (tyIsOk(r) == 0) r else inferCallArgs(List.tail(args), enums, funs, env, List.cons(tyVal(r), acc), callee, funs2)

def inferCallTy(callee: String, argTys: List, funs: List, enums: List): TyRes =
  if (streq(callee, "Str.concat") == 1) callStrConcat(argTys) else if (streq(callee, "Str.len") == 1) callStrLen(argTys) else if (streq(callee, "Str.charAt") == 1) callStrCharAt(argTys) else if (streq(callee, "Str.indexOf") == 1) callStrIndexOf(argTys) else if (streq(callee, "Str.slice") == 1) callStrSlice(argTys) else if (streq(callee, "Str.eq") == 1) callStrEq(argTys) else if (streq(callee, "Str.fromInt") == 1) callStrFromInt(argTys) else if (streq(callee, "Str.lines") == 1) callStrLines(argTys) else if (streq(callee, "List.empty") == 1) callListEmpty(argTys) else if (streq(callee, "List.cons") == 1) callListCons(argTys) else if (streq(callee, "List.isEmpty") == 1) callListIsEmpty(argTys) else if (streq(callee, "List.head") == 1) callListHead(argTys) else if (streq(callee, "List.at") == 1) callListAt(argTys) else if (streq(callee, "List.tail") == 1) callListTail(argTys) else if (streq(callee, "List.reverse") == 1) callListReverse(argTys) else if (streq(callee, "List.len") == 1) callListLen(argTys) else if (streq(callee, "List.join") == 1) callListJoin(argTys) else if (streq(callee, "List.append") == 1) callListAppend(argTys) else if (streq(callee, "Fs.read") == 1) callFsRead(argTys) else if (streq(callee, "Fs.list") == 1) callFsList(argTys) else if (streq(callee, "Fs.mkdirs") == 1) callFsMkdirs(argTys) else if (streq(callee, "Fs.canonicalize") == 1) callFsCanonicalize(argTys) else if (streq(callee, "Fs.write") == 1) callFsWrite(argTys) else if (streq(callee, "Sys.args") == 1) callSysArgs(argTys) else if (streq(callee, "Sys.readLine") == 1) callSysReadLine(argTys) else if (streq(callee, "Sys.exec") == 1) callSysExec(argTys) else if (streq(callee, "Sys.spawn") == 1) callSysSpawn(argTys) else if (streq(callee, "Sys.alive") == 1) callSysAlive(argTys) else if (streq(callee, "Sys.getenv") == 1) callSysGetenv(argTys) else if (streq(callee, "Clock.realTime") == 1) callClock(argTys) else if (streq(callee, "Clock.monotonic") == 1) callClock(argTys) else if (streq(callee, "R