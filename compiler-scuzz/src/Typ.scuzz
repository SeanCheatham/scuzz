def callStrConcat(argTys: List): TyRes =
  for {
    a = expectArity("Str.concat", 2, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.String)) == 0) expectTy(argTyAt(argTys, 0), Type.String) else if (tyIsOk(expectTy(argTyAt(argTys, 1), Type.String)) == 0) expectTy(argTyAt(argTys, 1), Type.String) else tyOk(Type.String)

def callStrLen(argTys: List): TyRes =
  for {
    a = expectArity("Str.len", 1, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.String)) == 0) expectTy(argTyAt(argTys, 0), Type.String) else tyOk(Type.Int)

def callStrCharAt(argTys: List): TyRes =
  for {
    a = expectArity("Str.charAt", 2, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.String)) == 0) expectTy(argTyAt(argTys, 0), Type.String) else if (tyIsOk(expectTy(argTyAt(argTys, 1), Type.Int)) == 0) expectTy(argTyAt(argTys, 1), Type.Int) else tyOk(Type.Int)

def callStrIndexOf(argTys: List): TyRes =
  for {
    a = expectArity("Str.indexOf", 2, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.String)) == 0) expectTy(argTyAt(argTys, 0), Type.String) else if (tyIsOk(expectTy(argTyAt(argTys, 1), Type.String)) == 0) expectTy(argTyAt(argTys, 1), Type.String) else tyOk(Type.Int)

def callStrSlice(argTys: List): TyRes =
  for {
    a = expectArity("Str.slice", 3, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.String)) == 0) expectTy(argTyAt(argTys, 0), Type.String) else if (tyIsOk(expectTy(argTyAt(argTys, 1), Type.Int)) == 0) expectTy(argTyAt(argTys, 1), Type.Int) else if (tyIsOk(expectTy(argTyAt(argTys, 2), Type.Int)) == 0) expectTy(argTyAt(argTys, 2), Type.Int) else tyOk(Type.String)

def callStrEq(argTys: List): TyRes =
  for {
    a = expectArity("Str.eq", 2, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.String)) == 0) expectTy(argTyAt(argTys, 0), Type.String) else if (tyIsOk(expectTy(argTyAt(argTys, 1), Type.String)) == 0) expectTy(argTyAt(argTys, 1), Type.String) else tyOk(Type.Int)

def callStrFromInt(argTys: List): TyRes =
  for {
    a = expectArity("Str.fromInt", 1, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.Int)) == 0) expectTy(argTyAt(argTys, 0), Type.Int) else tyOk(Type.String)

def callStrLines(argTys: List): TyRes =
  for {
    a = expectArity("Str.lines", 1, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.String)) == 0) expectTy(argTyAt(argTys, 0), Type.String) else tyOk(Type.List)

def callListEmpty(argTys: List): TyRes =
  for {
    a = expectArity("List.empty", 0, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else tyOk(Type.List)

def callListCons(argTys: List): TyRes =
  for {
    a = expectArity("List.cons", 2, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 1), Type.List)) == 0) expectTy(argTyAt(argTys, 1), Type.List) else tyOk(Type.List)

def callListIsEmpty(argTys: List): TyRes =
  for {
    a = expectArity("List.isEmpty", 1, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.List)) == 0) expectTy(argTyAt(argTys, 0), Type.List) else tyOk(Type.Int)

def callListHead(argTys: List): TyRes =
  for {
    a = expectArity("List.head", 1, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.List)) == 0) expectTy(argTyAt(argTys, 0), Type.List) else tyOk(tyMkOpaque("Any"))

def callListAt(argTys: List): TyRes =
  for {
    a = expectArity("List.at", 2, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.List)) == 0) expectTy(argTyAt(argTys, 0), Type.List) else if (tyIsOk(expectTy(argTyAt(argTys, 1), Type.Int)) == 0) expectTy(argTyAt(argTys, 1), Type.Int) else tyOk(tyMkOpaque("Any"))

def callListTail(argTys: List): TyRes =
  for {
    a = expectArity("List.tail", 1, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.List)) == 0) expectTy(argTyAt(argTys, 0), Type.List) else tyOk(Type.List)

def callListReverse(argTys: List): TyRes =
  for {
    a = expectArity("List.reverse", 1, List.len(argTys))
  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.List)) == 0) expectTy(argTyAt(argTys, 0), Type.List) else tyOk(Type.List)

