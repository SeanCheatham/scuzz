  } yield if (tyIsOk(a) == 0) a else if (tyIsOk(expectTy(argTyAt(argTys, 0), Type.Int)) == 0) expectTy(argTyAt(argTys, 0), Type.Int) else if (tyIsOk(expectTy(argTyAt(argTys, 1), Type.Int)) == 0) expectTy(argTyAt(argTys, 1), Type.Int) else if (tyIsOk(expectTy(argTyAt(argTys, 2), Type.Int)) == 0) expectTy(argTyAt(argTys, 2), Type.Int) else if (tyIsOk(expectTy(argTyAt(argTys, 3), Type.String)) == 0) expectTy(argTyAt(argTys, 3), Type.String) else tyOk(tyMkOpaque("View"))

