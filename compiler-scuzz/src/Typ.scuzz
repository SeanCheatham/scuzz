def callUserFun(callee: String, argTys: List, funs: List): TyRes =
  for {
    d = resolveFun(funsDefs(funs), callee, funsMod(funs))
  } yield if (List.isEmpty(d) == 1) tyErr(str3("unknown function ", callee, "")) else if (resolveIsAmbiguous(d) == 1) tyErr(str4("ambiguous function ", callee, ": qualify as Module.", callee)) else callUserFunParams(callee, defParams(resolvedDef(d)), argTys, 0, normalizeTy(declRet(resolvedDef(d))))

def callUserFunParams(callee: String, params: List, argTys: List, i: Int, ret: Type): TyRes =
  if (List.len(params) != List.len(argTys)) tyErr(str4(callee, " expects ", Str.fromInt(List.len(params)), str3(" args, got ", Str.fromInt(List.len(argTys)), ""))) else if (i >= List.len(params)) tyOk(ret) else if (typesCompat(argTyAt(argTys, i), normalizeTy(paramTy(List.at(params, i)))) == 0) tyErr(str4(callee, " arg type mismatch: expected ", tyShow(normalizeTy(paramTy(List.at(params, i)))), str3(", got ", tyShow(argTyAt(argTys, i)), ""))) else callUserFunParams(callee, params, argTys, i + 1, ret)

