package scuzz.compiler

def uiMainTemplate(): String =
  "@main def main: IO[Unit] =\n  for {\n    count = Signal.int(0)\n    label = Signal.map(count, n => s\"count = $n\")\n    _ <- Ui.run(_ => View.column(\n      View.text(\"Counter\"),\n      View.bindText(label),\n      View.row(View.button(\"+1\", _ => Signal.set(count, Signal.get(count) + 1)))\n    ))\n  } yield ()\n"

def helloMainTemplate(): String =
  Str.concat("@main def main: IO[Unit] =\n", "  IO.println(\"Hello, Scuzz!\").flatMap(_ => IO.println(\"ready.\"))\n")

def uiToml(name: String): String =
  str5("[package]\nname = \"", name, "\"\nversion = \"0.1.0\"\n\n[targets.native]\nkind = \"executable\"\nmain = \"Main\"\n\n[ui]\n", "default_runtime = \"headless\"\nheadless_size = [200, 120]\nheadless_scale = 1.0\n", str3("bundle_id = \"dev.scuzz.", name, "\"\n"))

def helloToml(name: String): String =
  str3("[package]\nname = \"", name, "\"\nversion = \"0.1.0\"\n\n[targets.native]\nkind = \"executable\"\nmain = \"Main\"\n")

def cmdNew(args: List): IO[Unit] =
  if (List.len(args) < 2) IO.println("usage: scuzz new <name> [--ui] [--path <dir>]") else cmdNewResolved(newNameArg(args), args)

def newNameArg(args: List): String =
  positionalAt(args, 1, 0)

def newParentDir(args: List): String =
  for {
    v = argValue(args, "--path", 0)
  } yield if (Str.len(v) == 0) "." else v

def cmdNewResolved(name: String, args: List): IO[Unit] =
  if (streq(name, ".") == 1) IO.println("usage: scuzz new <name> [--ui] [--path <dir>]") else if (startsWith(name, "--") == 1) IO.println("usage: scuzz new <name> [--ui] [--path <dir>]") else writeNewProject(pathJoin(newParentDir(args), name), name, argFlag(args, "--ui", 0))

def writeNewProject(dir: String, name: String, ui: Int): IO[Unit] =
  if (ui == 1) writeNewUi(dir, name) else writeNewHello(dir, name)

def writeNewUi(dir: String, name: String): IO[Unit] =
  Fs.mkdirs(pathJoin(dir, "src")).flatMap(_ =>
    Fs.mkdirs(pathJoin(dir, "goldens")).flatMap(_ =>
      Fs.write(pathJoin(dir, "scuzz.toml"), uiToml(name)).flatMap(_ =>
        Fs.write(pathJoin(dir, "src/Main.scuzz"), uiMainTemplate()).flatMap(_ => IO.println(str3("created ", dir, " (ui) — next: scuzz test (seeds goldens) && scuzz run --headless")))
      )
    )
  )

def writeNewHello(dir: String, name: String): IO[Unit] =
  Fs.mkdirs(pathJoin(dir, "src")).flatMap(_ =>
    Fs.write(pathJoin(dir, "scuzz.toml"), helloToml(name)).flatMap(_ =>
      Fs.write(pathJoin(dir, "src/Main.scuzz"), helloMainTemplate()).flatMap(_ => IO.println(str3("created ", dir, " — next: scuzz test && scuzz run")))
    )
  )

def updateFlagEnv(update: Int): String =
  if (update == 1) "SCUZZ_UPDATE_GOLDENS=1 " else ""

def pixelsFlagEnv(pixels: Int): String =
  if (pixels == 1) "SCUZZ_PIXEL_GOLDENS=1 " else ""

def cmdTest(projectDir: String, update: Int, runtimeTests: Int, pixels: Int): IO[Unit] =
  resolveRuntimeEnv("", projectDir).flatMap(runtimeDir =>
    maybeRuntimeTests(runtimeDir, runtimeTests).flatMap(_ =>
      compileProject(projectDir, pathJoin(projectDir, "build")).flatMap(_ =>
        Fs.read(pathJoin(projectDir, "scuzz.toml")).flatMap(toml => afterTestCompile(projectDir, toml, update, pixels, runtimeDir))
      )
    )
  )

def afterTestCompile(projectDir: String, toml: String, update: Int, pixels: Int, runtimeDir: String): IO[Unit] =
  if (hasUiSection(toml) == 0) runIoSmoke(projectDir, readTomlName(toml)).flatMap(_ => IO.println("scuzz test ok")) else execOk(str5(updateFlagEnv(update), pixelsFlagEnv(pixels), "bash ", pathJoin(pathJoin(parentDir(parentDir(runtimeDir)), "scripts"), "run_goldens.sh"), Str.concat(" ", projectDir))).flatMap(_ => IO.println("scuzz test ok"))

def runIoSmoke(projectDir: String, name: String): IO[Unit] =
  execOk(str3("SCUZZ_TESTRT=1 ", pathJoin(pathJoin(projectDir, "build"), name), ""))

def maybeRuntimeTests(runtimeDir: String, runtimeTests: Int): IO[Unit] =
  if (runtimeTests == 0) IO.pure(()) else execOk(str3("make -C ", runtimeDir, " test")).flatMap(_ => execOk(str3("make -C ", pathJoin(parentDir(runtimeDir), "ffi-skia"), " test")))

def cmdFmt(projectDir: String, check: Int): IO[Unit] =
  Fs.list(pathJoin(projectDir, "src")).flatMap(names => fmtFiles(pathJoin(projectDir, "src"), fmtSourceNames(names), check, 0)).flatMap(dirty => if (check == 1) if (dirty == 0) IO.println("scuzz fmt ok") else IO.println(str3("scuzz fmt: ", Str.fromInt(dirty), " file(s) need formatting")).flatMap(_ => IO.fail("fmt --check failed")) else IO.println("scuzz fmt ok"))

def fmtDirtyFiles(projectDir: String): IO[List] =
  Fs.list(pathJoin(projectDir, "src")).flatMap(names => collectFmtDirty(pathJoin(projectDir, "src"), fmtSourceNames(names), List.empty()))

def collectFmtDirty(srcDir: String, names: List, acc: List): IO[List] =
  if (List.isEmpty(names) == 1) IO.pure(List.reverse(acc)) else fmtDirtyOne(srcDir, List.head(names)).flatMap(p => if (Str.len(p) == 0) collectFmtDirty(srcDir, List.tail(names), acc) else collectFmtDirty(srcDir, List.tail(names), List.cons(p, acc)))

def fmtDirtyOne(srcDir: String, name: String): IO[String] =
  for {
    path = pathJoin(srcDir, name)
  } yield Fs.read(path).flatMap(text =>
  for {
    formatted = formatSource(text)
  } yield if (streq(formatted, text) == 1) IO.pure("") else IO.pure(path)
)

def fmtFiles(srcDir: String, names: List, check: Int, dirty: Int): IO[Int] =
  if (List.isEmpty(names) == 1) IO.pure(dirty) else fmtOne(srcDir, List.head(names), check).flatMap(d => fmtFiles(srcDir, List.tail(names), check, dirty + d))

def fmtOne(srcDir: String, name: String, check: Int): IO[Int] =
  for {
    path = pathJoin(srcDir, name)
  } yield Fs.read(path).flatMap(text =>
  for {
    formatted = formatSource(text)
  } yield if (streq(formatted, text) == 1) IO.pure(0) else if (check == 1) IO.println(str3("would reformat ", path, "")).flatMap(_ => IO.pure(1)) else Fs.write(path, formatted).flatMap(_ =>
  IO.println(str3("formatted ", path, "")).flatMap(_ => IO.pure(0))
)
)

def cmdWatch(projectDir: String): IO[Unit] =
  IO.println(str3("scuzz watch ", projectDir, " (rebuild on change; not hot reload)")).flatMap(_ =>
    srcFingerprint(projectDir).flatMap(fp => watchLoop(projectDir, fp, 1))
  )

def watchLoop(projectDir: String, lastFp: String, force: Int): IO[Unit] =
  maybeRebuild(projectDir, lastFp, force).flatMap(fp2 =>
    IO.sleep(500).flatMap(_ =>
      srcFingerprint(projectDir).flatMap(fp3 => if (streq(fp3, fp2) == 1) watchLoop(projectDir, fp2, 0) else watchLoop(projectDir, fp3, 1))
    )
  )

def maybeRebuild(projectDir: String, lastFp: String, force: Int): IO[String] =
  if (force == 0) IO.pure(lastFp) else compileProject(projectDir, pathJoin(projectDir, "build")).flatMap(_ =>
  IO.println("rebuilt").flatMap(_ => IO.pure(lastFp))
).handleErrorWith(_ =>
  IO.println("scuzz watch build error").flatMap(_ => IO.pure(lastFp))
)

def srcFingerprint(projectDir: String): IO[String] =
  Fs.read(pathJoin(projectDir, "scuzz.toml")).flatMap(toml =>
    loadGraphBundle(projectDir, toml).flatMap(bundle => fpTexts(List.head(bundle), toml))
  )

def fpTexts(texts: List, acc: String): IO[String] =
  if (List.isEmpty(texts) == 1) IO.pure(acc) else fpTexts(List.tail(texts), str3(acc, "\n", srcText(List.head(texts))))

def cmdPackage(projectDir: String, target: String): IO[Unit] =
  compileProject(projectDir, pathJoin(projectDir, "build")).flatMap(_ =>
    resolveRuntimeEnv("", projectDir).flatMap(runtimeDir => execOk(str5("bash ", pathJoin(pathJoin(parentDir(parentDir(runtimeDir)), "scripts"), "package_project.sh"), " ", projectDir, Str.concat(" ", target))))
  )

def cmdRun(projectDir: String, headless: Int, watch: Int): IO[Unit] =
  if (watch == 0) compileProject(projectDir, pathJoin(projectDir, "build")).flatMap(_ =>
  Fs.read(pathJoin(projectDir, "scuzz.toml")).flatMap(toml => runCompiled(projectDir, readTomlName(toml), toml, headless))
) else Fs.read(pathJoin(projectDir, "scuzz.toml")).flatMap(toml => cmdRunWatch(projectDir, readTomlName(toml), toml, headless))

def cmdRunWatch(projectDir: String, name: String, toml: String, headless: Int): IO[Unit] =
  if (hasUiSection(toml) == 0) runWatchRestart(projectDir, name, toml, headless) else runWatchUi(projectDir, name, toml, headless)

def runWatchRestart(projectDir: String, name: String, toml: String, headless: Int): IO[Unit] =
  IO.println(str3("scuzz run --watch ", projectDir, " (rebuild and rerun on source change; kills a still-running process; not hot reload)")).flatMap(_ =>
    srcFingerprint(projectDir).flatMap(fp => spawnWatchIo(projectDir, name, toml, headless, fp))
  )

def spawnWatchIo(projectDir: String, name: String, toml: String, headless: Int, fp: String): IO[Unit] =
  compileProject(projectDir, pathJoin(projectDir, "build")).flatMap(_ =>
  Sys.spawn(pathJoin(pathJoin(projectDir, "build"), name)).flatMap(pid =>
    IO.println(str3("scuzz run --watch: running (pid ", Str.fromInt(pid), ")")).flatMap(_ => watchIoLoop(projectDir, name, toml, headless, fp, pid))
  )
).handleErrorWith(_ =>
    IO.println("scuzz watch run error").flatMap(_ =>
      IO.sleep(500).flatMap(_ => spawnWatchIo(projectDir, name, toml, headless, fp))
    )
  )

def watchIoLoop(projectDir: String, name: String, toml: String, headless: Int, fp: String, pid: Int): IO[Unit] =
  IO.sleep(500).flatMap(_ =>
    srcFingerprint(projectDir).flatMap(fp2 => if (streq(fp2, fp) == 1) watchIoLoop(projectDir, name, toml, headless, fp, pid) else restartWatchIo(projectDir, name, toml, headless, fp2, pid))
  )

def restartWatchIo(projectDir: String, name: String, toml: String, headless: Int, fp: String, pid: Int): IO[Unit] =
  Sys.alive(pid).flatMap(a =>
    maybeKillPid(a, pid).flatMap(_ => spawnWatchIo(projectDir, name, toml, headless, fp))
  )

def maybeKillPid(alive: Int, pid: Int): IO[Unit] =
  if (alive == 0) IO.pure(()) else Sys.kill(pid)

def runWatchUi(projectDir: String, name: String, toml: String, headless: Int): IO[Unit] =
  for {
    stamp = pathJoin(pathJoin(projectDir, "build"), "reload.stamp")
  } yield Fs.mkdirs(pathJoin(projectDir, "build")).flatMap(_ =>
  Fs.write(stamp, "0\n").flatMap(_ =>
    IO.println(str3("scuzz run --watch ", projectDir, " (keep process; recompiles build/reload.dylib then stamp-reloads View tree; live dump build/debug.dump; inject build/inject.script)")).flatMap(_ =>
      srcFingerprint(projectDir).flatMap(fp => spawnWatchUi(projectDir, name, toml, headless, stamp, fp, 0))
    )
  )
)

def spawnWatchUi(projectDir: String, name: String, toml: String, headless: Int, stamp: String, fp: String, gen: Int): IO[Unit] =
  compileProject(projectDir, pathJoin(projectDir, "build")).flatMap(_ =>
  Sys.spawn(uiKeepCmd(projectDir, name, toml, headless, stamp)).flatMap(pid =>
    IO.println(str3("scuzz run --watch: running (pid ", Str.fromInt(pid), ")")).flatMap(_ => watchUiLoop(projectDir, name, toml, headless, stamp, fp, gen, pid))
  )
).handleErrorWith(_ =>
    IO.println("scuzz watch run error").flatMap(_ =>
      IO.sleep(500).flatMap(_ => spawnWatchUi(projectDir, name, toml, headless, stamp, fp, gen))
    )
  )

def watchUiLoop(projectDir: String, name: String, toml: String, headless: Int, stamp: String, fp: String, gen: Int, pid: Int): IO[Unit] =
  IO.sleep(500).flatMap(_ =>
    Sys.alive(pid).flatMap(a =>
      if (a == 0) spawnWatchUi(projectDir, name, toml, headless, stamp, fp, gen) else srcFingerprint(projectDir).flatMap(fp2 =>
  if (streq(fp2, fp) == 1) watchUiLoop(projectDir, name, toml, headless, stamp, fp, gen, pid) else compileProject(projectDir, pathJoin(projectDir, "build")).flatMap(_ =>
  Fs.write(stamp, Str.concat(Str.fromInt(gen + 1), "\n")).flatMap(_ =>
    IO.println(str3("scuzz: view reload stamp ", Str.fromInt(gen + 1), "")).flatMap(_ => watchUiLoop(projectDir, name, toml, headless, stamp, fp2, gen + 1, pid))
  )
).handleErrorWith(_ =>
  IO.println("scuzz watch compile error").flatMap(_ => watchUiLoop(projectDir, name, toml, headless, stamp, fp2, gen, pid))
)
)
    )
  )

def uiKeepCmd(projectDir: String, name: String, toml: String, headlessForce: Int, stamp: String): String =
  for {
    exe = pathJoin(pathJoin(projectDir, "build"), name)
    dump = pathJoin(pathJoin(projectDir, "build"), "debug.dump")
    inject = pathJoin(pathJoin(projectDir, "build"), "inject.script")
    code = pathJoin(pathJoin(projectDir, "build"), "reload.dylib")
  } yield if (headlessForce == 1) uiKeepHeadless(exe, toml, stamp, dump, inject, code) else if (streq(readTomlDefaultRuntime(toml), "window") == 1) uiKeepWindow(exe, toml, stamp, dump, inject, code) else if (streq(readTomlDefaultRuntime(toml), "mobile") == 1) uiKeepMobile(exe, toml, stamp, dump, inject, code) else uiKeepHeadless(exe, toml, stamp, dump, inject, code)

def uiKeepHeadless(exe: String, toml: String, stamp: String, dump: String, inject: String, code: String): String =
  str5("env SCUZZ_UI_RELOAD_STAMP=", stamp, " SCUZZ_UI_RELOAD_CODE=", code, str5(" SCUZZ_UI_DEBUG_DUMP=", dump, " SCUZZ_UI_INJECT=", inject, str5(" SCUZZ_UI_RUNTIME=headless SCUZZ_UI_WIDTH=", readTomlHeadlessW(toml), " SCUZZ_UI_HEIGHT=", readTomlHeadlessH(toml), str3(" ", exe, ""))))

def uiKeepWindow(exe: String, toml: String, stamp: String, dump: String, inject: String, code: String): String =
  str5("env SCUZZ_UI_RELOAD_STAMP=", stamp, " SCUZZ_UI_RELOAD_CODE=", code, str5(" SCUZZ_UI_DEBUG_DUMP=", dump, " SCUZZ_UI_INJECT=", inject, str5(" SCUZZ_UI_RUNTIME=window SCUZZ_UI_WIDTH=", readTomlHeadlessW(toml), " SCUZZ_UI_HEIGHT=", readTomlHeadlessH(toml), str3(" ", exe, ""))))

def uiKeepMobile(exe: String, toml: String, stamp: String, dump: String, inject: String, code: String): String =
  str5("env SCUZZ_UI_RELOAD_STAMP=", stamp, " SCUZZ_UI_RELOAD_CODE=", code, str5(" SCUZZ_UI_DEBUG_DUMP=", dump, " SCUZZ_UI_INJECT=", inject, str5(" SCUZZ_UI_RUNTIME=mobile SCUZZ_MOBILE_SHELL=1 SCUZZ_UI_WIDTH=", readTomlHeadlessW(toml), " SCUZZ_UI_HEIGHT=", readTomlHeadlessH(toml), str3(" ", exe, ""))))

def runCompiled(projectDir: String, name: String, toml: String, headlessForce: Int): IO[Unit] =
  if (headlessForce == 1) runHeadless(projectDir, name, toml) else if (hasUiSection(toml) == 0) execOk(pathJoin(pathJoin(projectDir, "build"), name)) else runWithDefaultRuntime(projectDir, name, toml)

def runWithDefaultRuntime(projectDir: String, name: String, toml: String): IO[Unit] =
  if (streq(readTomlDefaultRuntime(toml), "window") == 1) runWindow(projectDir, name, toml) else if (streq(readTomlDefaultRuntime(toml), "mobile") == 1) runMobile(projectDir, name, toml) else runHeadless(projectDir, name, toml)

def runHeadless(projectDir: String, name: String, toml: String): IO[Unit] =
  for {
    exe = pathJoin(pathJoin(projectDir, "build"), name)
    snap = pathJoin(pathJoin(projectDir, "build"), "snapshot.png")
    w = readTomlHeadlessW(toml)
    h = readTomlHeadlessH(toml)
  } yield IO.println(str3("scuzz run --headless → snapshot ", snap, "")).flatMap(_ => execOk(str5("env SCUZZ_UI_RUNTIME=headless SCUZZ_SNAPSHOT_PATH=", snap, " SCUZZ_UI_WIDTH=", w, str4(" SCUZZ_UI_HEIGHT=", h, " ", exe))))

def runWindow(projectDir: String, name: String, toml: String): IO[Unit] =
  for {
    exe = pathJoin(pathJoin(projectDir, "build"), name)
  } yield IO.println("scuzz run → UiRuntime.Window (desktop embedder)").flatMap(_ => execOk(str5("env SCUZZ_UI_RUNTIME=window SCUZZ_UI_WIDTH=", readTomlHeadlessW(toml), " SCUZZ_UI_HEIGHT=", readTomlHeadlessH(toml), Str.concat(" ", exe))))

def runMobile(projectDir: String, name: String, toml: String): IO[Unit] =
  for {
    exe = pathJoin(pathJoin(projectDir, "build"), name)
  } yield IO.println("scuzz run → UiRuntime.Mobile (host shell)").flatMap(_ => execOk(str5("env SCUZZ_UI_RUNTIME=mobile SCUZZ_MOBILE_SHELL=1 SCUZZ_UI_WIDTH=", readTomlHeadlessW(toml), " SCUZZ_UI_HEIGHT=", readTomlHeadlessH(toml), Str.concat(" ", exe))))

