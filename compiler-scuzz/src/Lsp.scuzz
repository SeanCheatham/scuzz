package scuzz.compiler

def cmdLsp(projectDir: String): IO[Unit] =
  Ref.of(projectDir).flatMap(rootRef => lspLoop(rootRef))

def lspLoop(rootRef: String): IO[Unit] =
  lspReadHeaders(0, 0).flatMap(n =>
    if (n < 0) IO.pure(()) else Sys.read(n).flatMap(body =>
  lspHandle(rootRef, body).flatMap(cont => if (cont == 0) IO.pure(()) else lspLoop(rootRef))
)
  )

def lspReadHeaders(accLen: Int, saw: Int): IO[Int] =
  Sys.readLine().flatMap(line => if (Str.len(line) == 0) if (saw == 0) IO.pure(0 - 1) else IO.pure(accLen) else lspReadHeaders(headerLen(line, accLen), 1))

def headerLen(line: String, acc: Int): Int =
  if (startsWith(line, "Content-Length:") == 1) parseIntAt(line, skipWs(line, 15), 0) else if (startsWith(line, "Content-length:") == 1) parseIntAt(line, skipWs(line, 15), 0) else acc

def lspHandle(rootRef: String, body: String): IO[Int] =
  for {
    method = jsonStringField(body, "method")
    id = jsonId(body)
  } yield lspDispatch(rootRef, body, method, id)

def lspDispatch(rootRef: String, body: String, method: String, id: Int): IO[Int] =
  if (streq(method, "initialize") == 1) lspInit(rootRef, body, id).flatMap(_ => IO.pure(1)) else if (streq(method, "shutdown") == 1) lspWrite(lspResult(id, "null")).flatMap(_ => IO.pure(1)) else if (streq(method, "exit") == 1) IO.pure(0) else if (streq(method, "initialized") == 1) IO.pure(1) else if (streq(method, "textDocument/didOpen") == 1) lspPublishRef(rootRef).flatMap(_ => IO.pure(1)) else if (streq(method, "textDocument/didSave") == 1) lspPublishRef(rootRef).flatMap(_ => IO.pure(1)) else if (streq(method, "textDocument/didChange") == 1) lspPublishRef(rootRef).flatMap(_ => IO.pure(1)) else if (id < 0) IO.pure(1) else lspWrite(lspResult(id, "null")).flatMap(_ => IO.pure(1))

def lspInit(rootRef: String, body: String, id: Int): IO[Unit] =
  Ref.get(rootRef).flatMap(cur =>
    Ref.set(rootRef, rootFromInit(body, cur)).flatMap(_ => lspWrite(lspResult(id, "{\"capabilities\":{\"textDocumentSync\":1}}")))
  )

def rootFromInit(body: String, fallback: String): String =
  for {
    uri = jsonStringField(body, "rootUri")
    path = jsonStringField(body, "rootPath")
  } yield if (Str.len(uri) == 0) if (Str.len(path) == 0) fallback else path else uriToPath(uri)

def uriToPath(uri: String): String =
  if (startsWith(uri, "file://") == 1) stripFileHost(Str.slice(uri, 7, Str.len(uri))) else uri

def stripFileHost(s: String): String =
  if (startsWith(s, "localhost") == 1) Str.slice(s, 9, Str.len(s)) else s

def lspPublishRef(rootRef: String): IO[Unit] =
  Ref.get(rootRef).flatMap(root => lspPublish(root))

def lspPublish(root: String): IO[Unit] =
  fmtDirtyFiles(root).flatMap(dirty =>
    checkProject(root).flatMap(res => lspEmit(root, dirty, List.head(res), List.head(List.tail(res)))).handleErrorWith(_ =>
      IO.pure(())
    )
  )

def lspEmit(root: String, dirty: List, ty: TyRes, sources: List): IO[Unit] =
  lspAccumDiags(root, dirty, ty, sources, List.empty()).flatMap(groups =>
    Fs.list(pathJoin(root, "src")).flatMap(names =>
      lspClearSrc(root, fmtSourceNames(names)).flatMap(_ => lspPublishGroups(groups))
    )
  )

def lspClearSrc(root: String, names: List): IO[Unit] =
  if (List.isEmpty(names) == 1) IO.pure(()) else lspUri(pathJoin(pathJoin(root, "src"), List.head(names))).flatMap(uri =>
  lspWrite(lspNotify("textDocument/publishDiagnostics", str3("{\"uri\":", jsonQuote(uri), ",\"diagnostics\":[]}"))).flatMap(_ => lspClearSrc(root, List.tail(names)))
)

def lspAccumDiags(root: String, dirty: List, ty: TyRes, sources: List, groups: List): IO[List] =
  lspAccumDirty(root, dirty, groups).flatMap(g2 => lspAccumTy(root, ty, sources, g2))

def lspAccumDirty(root: String, dirty: List, groups: List): IO[List] =
  if (List.isEmpty(dirty) == 1) IO.pure(groups) else lspUri(List.head(dirty)).flatMap(uri => lspAccumDirty(root, List.tail(dirty), lspAddGroup(groups, uri, lspDiagJson("needs formatting (run scuzz fmt)", List.cons(List.head(dirty), List.cons("1", List.cons("1", List.empty())))))))

def lspAccumTy(root: String, ty: TyRes, sources: List, groups: List): IO[List] =
  if (tyIsOk(ty) == 1) IO.pure(groups) else lspUri(lspTyPath(root, diagLoc(ty, sources))).flatMap(uri => IO.pure(lspAddGroup(groups, uri, lspDiagJson(tyMsg(ty), diagLoc(ty, sources)))))

def lspTyPath(root: String, loc: List): String =
  if (diagHasLoc(loc) == 0) pathJoin(root, "scuzz.toml") else lspRelPath(root, diagFile(loc))

def lspRelPath(root: String, file: String): String =
  if (startsWith(file, "/") == 1) file else if (startsWith(file, "src/") == 1) pathJoin(root, file) else pathJoin(pathJoin(root, "src"), file)

def lspAddGroup(groups: List, uri: String, diag: String): List =
  if (List.isEmpty(groups) == 1) List.cons(pairSL(uri, List.cons(diag, List.empty())), List.empty()) else if (streq(fst(List.head(groups)), uri) == 1) List.cons(pairSL(uri, List.cons(diag, sndL(List.head(groups)))), List.tail(groups)) else List.cons(List.head(groups), lspAddGroup(List.tail(groups), uri, diag))

def lspPublishGroups(groups: List): IO[Unit] =
  if (List.isEmpty(groups) == 1) IO.pure(()) else lspPublishOne(List.head(groups)).flatMap(_ => lspPublishGroups(List.tail(groups)))

def lspPublishOne(g: List): IO[Unit] =
  lspWrite(lspNotify("textDocument/publishDiagnostics", str5("{\"uri\":", jsonQuote(fst(g)), ",\"diagnostics\":[", join(sndL(g), ","), "]}")))

def lspDiagJson(msg: String, loc: List): String =
  str5("{\"range\":{\"start\":{\"line\":", lspLine0(loc), ",\"character\":", lspCol0(loc), str5("},\"end\":{\"line\":", lspLine0(loc), ",\"character\":", lspCol0(loc), str3("}},\"severity\":1,\"message\":", jsonQuote(msg), "}")))

def lspLine0(loc: List): String =
  if (diagHasLoc(loc) == 0) "0" else Str.fromInt(intMax0(parseInt(diagLine(loc)) - 1))

def lspCol0(loc: List): String =
  if (diagHasLoc(loc) == 0) "0" else Str.fromInt(intMax0(parseInt(diagCol(loc)) - 1))

def intMax0(n: Int): Int =
  if (n < 0) 0 else n

def lspUri(path: String): IO[String] =
  Fs.canonicalize(path).flatMap(p => IO.pure(str3("file://", p, ""))).handleErrorWith(_ =>
    IO.pure(str3("file://", path, ""))
  )

def lspWrite(body: String): IO[Unit] =
  Sys.write(str4("Content-Length: ", Str.fromInt(Str.len(body)), "r\nr\n", body))

def lspResult(id: Int, result: String): String =
  str5("{\"jsonrpc\":\"2.0\",\"id\":", Str.fromInt(id), ",\"result\":", result, "}")

def lspNotify(method: String, params: String): String =
  str5("{\"jsonrpc\":\"2.0\",\"method\":", jsonQuote(method), ",\"params\":", params, "}")

def jsonStringField(s: String, key: String): String =
  jsonStringFieldPat(s, str3("\"", key, "\":"))

def jsonStringFieldPat(s: String, pat: String): String =
  for {
    i = Str.indexOf(s, pat)
  } yield if (i < 0) "" else jsonStringAt(s, skipWs(s, i + Str.len(pat)))

def jsonStringAt(s: String, i: Int): String =
  if (i >= Str.len(s)) "" else if (Str.charAt(s, i) == 34) jsonStringTake(s, i + 1, "") else ""

def jsonStringTake(s: String, i: Int, acc: String): String =
  if (i >= Str.len(s)) acc else jsonStringTakeAt(s, i, acc, Str.charAt(s, i))

def jsonStringTakeAt(s: String, i: Int, acc: String, c: Int): String =
  if (c == 34) acc else if (c == 92) jsonStringTakeEsc(s, i + 1, acc) else jsonStringTake(s, i + 1, Str.concat(acc, charToStr(c)))

def jsonStringTakeEsc(s: String, i: Int, acc: String): String =
  if (i >= Str.len(s)) acc else jsonStringTake(s, i + 1, Str.concat(acc, jsonEscChar(Str.charAt(s, i))))

def jsonEscChar(c: Int): String =
  if (c == 110) "\n" else charToStr(c)

def jsonId(s: String): Int =
  for {
    i = Str.indexOf(s, "\"id\":")
  } yield if (i < 0) 0 - 1 else parseIntAt(s, skipWs(s, i + 5), 0)

