package scuzz.compiler

enum Expr:
  case Unit(span: Span)
  case IntLit(digits: String, span: Span)
  case StrLit(value: String, span: Span)
  case ListLit(elems: List, span: Span)
  case Interp(parts: List, span: Span)
  case Var(name: String, span: Span)
  case Field(base: Expr, field: String, span: Span)
  case MethodCall(receiver: Expr, method: String, args: List, span: Span)
  case Adt(enumName: String, caseName: String, args: List, typeArgs: List, span: Span)
  case Call(callee: String, args: List, span: Span)
  case BinOp(op: String, left: Expr, right: Expr, span: Span)
  case If(cond: Expr, thenB: Expr, elseB: Expr, span: Span)
  case For(binders: List, body: Expr, span: Span)
  case Let(name: String, value: Expr, body: Expr, span: Span)
  case FlatMap(inner: Expr, param: String, body: Expr, span: Span)
  case Handle(inner: Expr, body: Expr, span: Span)
  case Attempt(inner: Expr, span: Span)
  case Lambda(param: String, body: Expr, span: Span)
  case Match(scrut: Expr, arms: List, span: Span)
  case Println(arg: Expr, span: Span)
  case Fail(arg: Expr, span: Span)
  case Pure(arg: Expr, span: Span)
  case Sleep(arg: Expr, span: Span)
  case Delay(span: Span)
  case IoRace(left: Expr, right: Expr, span: Span)
  case IoBoth(left: Expr, right: Expr, span: Span)

def isUnitExpr(e: Expr): Int =
  e match {
    case Expr.Unit(span) => 1
    case Expr.IntLit(digits, span) => 0
    case Expr.StrLit(value, span) => 0
    case Expr.ListLit(elems, span) => 0
    case Expr.Interp(parts, span) => 0
    case Expr.Var(name, span) => 0
    case Expr.Field(base, field, span) => 0
    case Expr.MethodCall(receiver, method, args, span) => 0
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => 0
    case Expr.Call(callee, args, span) => 0
    case Expr.BinOp(op, left, right, span) => 0
    case Expr.If(cond, thenB, elseB, span) => 0
    case Expr.For(binders, body, span) => 0
    case Expr.Let(name, value, body, span) => 0
    case Expr.FlatMap(inner, param, body, span) => 0
    case Expr.Handle(inner, body, span) => 0
    case Expr.Attempt(inner, span) => 0
    case Expr.Lambda(param, body, span) => 0
    case Expr.Match(scrut, arms, span) => 0
    case Expr.Println(arg, span) => 0
    case Expr.Fail(arg, span) => 0
    case Expr.Pure(arg, span) => 0
    case Expr.Sleep(arg, span) => 0
    case Expr.Delay(span) => 0
    case Expr.IoRace(left, right, span) => 0
    case Expr.IoBoth(left, right, span) => 0
  }

