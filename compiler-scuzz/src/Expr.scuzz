    case Expr.IoBoth(left, right, span) => 0
  }

def varExprName(e: Expr): String =
  e match {
    case Expr.Var(name, span) => name
    case Expr.Field(base, field, span) => ""
    case Expr.MethodCall(receiver, method, args, span) => ""
    case Expr.Unit(span) => ""
    case Expr.IntLit(digits, span) => ""
    case Expr.StrLit(value, span) => ""
    case Expr.ListLit(elems, span) => ""
    case Expr.Interp(parts, span) => ""
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => ""
    case Expr.Call(callee, args, span) => ""
    case Expr.BinOp(op, left, right, span) => ""
    case Expr.If(cond, thenB, elseB, span) => ""
    case Expr.For(binders, body, span) => ""
    case Expr.Let(name, value, body, span) => ""
    case Expr.FlatMap(inner, param, body, span) => ""
    case Expr.Handle(inner, body, span) => ""
    case Expr.Attempt(inner, span) => ""
    case Expr.Lambda(param, body, span) => ""
    case Expr.Match(scrut, arms, span) => ""
    case Expr.Println(arg, span) => ""
    case Expr.Fail(arg, span) => ""
    case Expr.Pure(arg, span) => ""
    case Expr.Sleep(arg, span) => ""
    case Expr.Delay(span) => ""
    case Expr.IoRace(left, right, span) => ""
    case Expr.IoBoth(left, right, span) => ""
  }

def strLitExprValue(e: Expr): String =
  e match {
    case Expr.StrLit(value, span) => value
    case Expr.Unit(span) => ""
    case Expr.IntLit(digits, span) => ""
    case Expr.ListLit(elems, span) => ""
    case Expr.Interp(parts, span) => ""
    case Expr.Var(name, span) => ""
