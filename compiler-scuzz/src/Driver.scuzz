package scuzz.compiler

def emptyProg(): Prog =
  Prog.Prog("", List.empty(), List.empty(), unitExpr(), "", List.empty(), List.empty(), List.empty())

def mkProgFull(pkg: String, enums: List, defs: List, main: Expr, mainMod: String, imports: List, traits: List, impls: List): Prog =
  Prog.Prog(pkg, enums, defs, main, mainMod, imports, traits, impls)

def setProgDefs(prog: Prog, defs: List): Prog =
  mkProgFull(progPkg(prog), progEnums(prog), defs, progMain(prog), progMainModule(prog), progImports(prog), progTraits(prog), progImpls(prog))

def setProgMain(prog: Prog, main: Expr): Prog =
  mkProgFull(progPkg(prog), progEnums(prog), progDefs(prog), main, progMainModule(prog), progImports(prog), progTraits(prog), progImpls(prog))

def chooseMain(a: Expr, b: Expr): Expr =
  if (isUnitExpr(b) == 1) a else b

def chooseMainModule(accMain: Expr, pMain: Expr, accMod: String, pMod: String): String =
  if (isUnitExpr(pMain) == 1) accMod else pMod

def mergeProg(acc: Prog, p: Prog): Prog =
  mkProgFull(progPkg(p), listConcat(progEnums(acc), progEnums(p)), listConcat(progDefs(acc), progDefs(p)), chooseMain(progMain(acc), progMain(p)), chooseMainModule(progMain(acc), progMain(p), progMainModule(acc), progMainModule(p)), listConcat(progImports(acc), progImports(p)), listConcat(progTraits(acc), progTraits(p)), listConcat(progImpls(acc), progImpls(p)))

def parseSource(label: String, src: String): Prog =
  parseProgram(lex(src), label)

def readUntilQuote(s: String, i: Int, acc: String): String =
  if (i >= Str.len(s)) acc else if (Str.charAt(s, i) == 34) acc else readUntilQuote(s, i + 1, Str.concat(acc, Str.slice(s, i, i + 1)))

def isScuzzName(name: String): Int =
  if (endsWith(name, ".scuzz") == 1) 1 else 0

def isSimName(name: String): Int =
  if (endsWith(name, ".scuzz_sim") == 1) 1 else 0

def isDriverName(name: String): Int =
  if (endsWith(name, ".scuzz_drivers") == 1) 1 else 0

def isLawsName(name: String): Int =
  if (endsWith(name, ".scuzz_laws") == 1) 1 else 0

def liveStem(name: String): String =
  Str.slice(name, 0, Str.len(name) - 6)

def simStem(name: String): String =
  Str.slice(name, 0, Str.len(name) - 10)

def driverStem(name: String): String =
  Str.slice(name, 0, Str.len(name) - 14)

def overlayStemOf(name: String): String =
  if (isSimName(name) == 1) simStem(name) else driverStem(name)

def isMainName(name: String): Int =
  if (streq(name, "Main.scuzz") == 1) 1 else if (streq(name, "main.scuzz") == 1) 1 else 0

def partitionSources(names: List, others: List, mains: List): List =
  if (List.isEmpty(names) == 1) listConcat(List.reverse(others), List.reverse(mains)) else partitionSourcesOne(List.head(names), List.tail(names), others, mains)

def partitionSourcesOne(name: String, rest: List, others: List, mains: List): List =
  if (isScuzzName(name) == 0) partitionSources(rest, others, mains) else if (isMainName(name) == 1) partitionSources(rest, others, List.cons(name, mains)) else partitionSources(rest, List.cons(name, others), mains)

def collectLiveStems(names: List, acc: List): List =
  if (List.isEmpty(names) == 1) acc else collectLiveStemsOne(List.head(names), List.tail(names), acc)

def collectLiveStemsOne(name: String, rest: List, acc: List): List =
  if (isScuzzName(name) == 0) collectLiveStems(rest, acc) else collectLiveStems(rest, List.cons(liveStem(name), acc))

def filterSimNames(names: List, acc: List): List =
  if (List.isEmpty(names) == 1) List.reverse(acc) else if (isSimName(List.head(names)) == 1) filterSimNames(List.tail(names), List.cons(List.head(names), acc)) else filterSimNames(List.tail(names), acc)

def filterDriverNames(names: List, acc: List): List =
  if (List.isEmpty(names) == 1) List.reverse(acc) else if (isDriverName(List.head(names)) == 1) filterDriverNames(List.tail(names), List.cons(List.head(names), acc)) else filterDriverNames(List.tail(names), acc)

def fmtSourceNames(names: List): List =
  listConcat(partitionSources(names, List.empty(), List.empty()), listConcat(filterSimNames(names, List.empty()), filterDriverNames(names, List.empty())))

def ovKind(o: List): String =
  List.head(o)

def ovLabel(o: List): String =
  List.head(List.tail(o))

def ovText(o: List): String =
  List.head(List.tail(List.tail(o)))

def mkOverlay(kind: String, label: String, text: String): List =
  List.cons(kind, List.cons(label, List.cons(text, List.empty())))

def resolveRuntimeEnv(env: String, projectDir: String): IO[String] =
  if (Str.len(env) > 0) IO.pure(env) else Sys.getenv("SCUZZ_HOME").flatMap(home =>
  if (Str.len(home) > 0) IO.pure(pathJoin(home, "crates/runtime")) else tryFindRuntime(projectDir).handleErrorWith(_ =>
  Sys.getenv("PWD").flatMap(pwd => if (Str.len(pwd) > 0) tryFindRuntime(pwd) else IO.fail("could not find crates/runtime (set SCUZZ_HOME or SCUZZ_RUNTIME)"))
)
)

def tryFindRuntime(start: String): IO[String] =
  findRuntimeFrom(start, 8).flatMap(dir =>
    Fs.read(pathJoin(dir, "include/scuzz_rt.h")).flatMap(_ => IO.pure(dir))
  )

def findRuntimeFrom(dir: String, fuel: Int): IO[String] =
  if (fuel <= 0) IO.fail("could not find crates/runtime") else Fs.read(pathJoin(pathJoin(dir, "crates/runtime"), "include/scuzz_rt.h")).flatMap(_ => IO.pure(pathJoin(dir, "crates/runtime"))).handleErrorWith(_ =>
  findRuntimeFrom(parentDir(dir), fuel - 1)
)

def clangOrDefault(env: String): String =
  if (Str.len(env) > 0) env else "clang"

def execOk(cmd: String): IO[Unit] =
  Sys.exec(cmd).flatMap(code => if (code == 0) IO.pure(()) else IO.fail(str3("exec failed (", Str.fromInt(code), str3("): ", cmd, ""))))

def readSources(srcDir: String, names: List, acc: List): IO[List] =
  if (List.isEmpty(names) == 1) IO.pure(List.reverse(acc)) else Fs.read(pathJoin(srcDir, List.head(names))).flatMap(text => readSources(srcDir, List.tail(names), List.cons(mkSrc(List.head(names), text), acc)))

def readOverlayFiles(srcDir: String, kind: String, names: List, acc: List): IO[List] =
  if (List.isEmpty(names) == 1) IO.pure(List.reverse(acc)) else Fs.read(pathJoin(srcDir, List.head(names))).flatMap(text => readOverlayFiles(srcDir, kind, List.tail(names), List.cons(mkOverlay(kind, List.head(names), text), acc)))

def mergeSources(sources: List, acc: Prog, mains: Int): IO[Prog] =
  if (List.isEmpty(sources) == 1) if (mains == 0) IO.fail("no @main definition") else if (mains > 1) IO.fail("multiple @main definitions") else IO.pure(acc) else mergeSourcesOne(List.head(sources), List.tail(sources), acc, mains)

def mergeSourcesOne(src: List, rest: List, acc: Prog, mains: Int): IO[Prog] =
  for {
    p = parseSource(srcLabel(src), srcText(src))
    n = if (isUnitExpr(progMain(p)) == 1) 0 else 1
  } yield mergeSources(rest, mergeProg(acc, p), mains + n)

def validateOverlayStems(stems: List, names: List): IO[Unit] =
  if (List.isEmpty(names) == 1) IO.pure(()) else validateOverlayStemOne(stems, List.head(names), List.tail(names))

def validateOverlayStemOne(stems: List, name: String, rest: List): IO[Unit] =
  for {
    stem = overlayStemOf(name)
  } yield if (listContainsStr(stems, stem) == 0) IO.fail(str4(name, ": overlay stem `", stem, str3("` has no live `", stem, ".scuzz` twin"))) else validateOverlayStems(stems, rest)

def buildRuntime(runtimeDir: String, clang: String): IO[Unit] =
  execOk(str4("make -C ", runtimeDir, " lib CC=", clang)).flatMap(_ =>
    execOk(str4("make -C ", pathJoin(parentDir(runtimeDir), "embedder-desktop"), " lib CC=", clang)).flatMap(_ => execOk(str4("make -C ", pathJoin(parentDir(runtimeDir), "embedder-mobile"), " lib CC=", clang)))
  )

def embedderLinkFlags(embedder: String): String =
  str5("$(test -f ", embedder, " && if [ \"`uname -s`\" = Darwin ]; then echo -Wl,-force_load,", embedder, str3(" -framework Cocoa -lobjc; elif [ \"`uname -s`\" = Linux ]; then echo -Wl,--whole-archive ", embedder, " -Wl,--no-whole-archive -lX11; fi)"))

def mobileLinkFlags(mobile: String): String =
  str5("$(test -f ", mobile, " && if [ \"`uname -s`\" = Darwin ]; then echo -Wl,-force_load,", mobile, str3("; elif [ \"`uname -s`\" = Linux ]; then echo -Wl,--whole-archive ", mobile, " -Wl,--no-whole-archive; fi)"))

def cxxLinkFlags(): String =
  "$(if [ \"`uname -s`\" = Darwin ]; then echo -lc++ -lm -framework CoreFoundation; else echo -lstdc++ -lm; fi)"

def skiaExtraLinkFlags(ffi: String): String =
  str5("$(test -f ", pathJoin(ffi, "build/sk_capi_backend"), " && grep -qx skia ", pathJoin(ffi, "build/sk_capi_backend"), " && if [ \"`uname -s`\" = Darwin ]; then echo -lz -lbz2 -lbrotlidec -lbrotlicommon -framework CoreFoundation -framework CoreGraphics -framework CoreText -framework Foundation -framework Carbon; else echo -lz -lbz2 -lbrotlidec -lbrotlicommon; fi)")

def linkCmd(clang: String, ll: String, lib: String, skia: String, inc: String, skInc: String, embedder: String, mobile: String, exe: String): String =
  str4(clang, " ", ll, str4(" ", lib, " ", str4(skia, " -I", inc, str4(" -I", skInc, " -lpthread ", str5(cxxLinkFlags(), " ", skiaExtraLinkFlags(parentDir(parentDir(skia))), " ", str5(embedderLinkFlags(embedder), " ", mobileLinkFlags(mobile), " -o ", exe))))))

def linkCmdIo(clang: String, ll: String, lib: String, inc: String, exe: String): String =
  str5(clang, " ", ll, " ", str4(lib, " -I", inc, str3(" -lpthread ", cxxLinkFlagsIo(), str3(" -o ", exe, ""))))

def cxxLinkFlagsIo(): String =
  "$(if [ \"`uname -s`\" = Darwin ]; then echo -framework CoreFoundation; else echo; fi)"

def lawCall(name: String): Expr =
  Expr.Call(name, List.empty(), dummySpan())

def lawAssertCall(name: String): Expr =
  Expr.Call("Law.assert", List.cons(Expr.StrLit(name, dummySpan()), List.cons(lawCall(name), List.empty())), dummySpan())

def wrapLawAssert(body: Expr, name: String): Expr =
  Expr.FlatMap(body, "_", lawAssertCall(name), coverSpan(exprSpan(body), dummySpan()))

def residualizeLaws(prog: Prog, lawNames: List): Prog =
  if (List.isEmpty(lawNames) == 1) prog else setProgMain(prog, residualizeMain(progMain(prog), lawNames))

def residualizeMain(body: Expr, lawNames: List): Expr =
  if (List.isEmpty(lawNames) == 1) body else residualizeMain(wrapLawAssert(body, List.head(lawNames)), List.tail(lawNames))

def residualizeRefinements(prog: Prog): Prog =
  setProgMain(setProgDefs(prog, residualizeDefs(progDefs(prog), progDefs(prog), progEnums(prog), List.empty())), residualizeExpr(progMain(prog), progDefs(prog), progEnums(prog)))

def residualizeDefs(defs: List, all: List, enums: List, acc: List): List =
  if (List.isEmpty(defs) == 1) List.reverse(acc) else residualizeDefs(List.tail(defs), all, enums, List.cons(setDefBody(List.head(defs), residualizeExpr(defBody(List.head(defs)), all, enums)), acc))

def paramsHaveRfn(params: List): Int =
  if (List.isEmpty(params) == 1) 0 else if (List.isEmpty(paramRfn(List.head(params))) == 0) 1 else paramsHaveRfn(List.tail(params))

def fieldsHaveRfn(fields: List): Int =
  if (List.isEmpty(fields) == 1) 0 else if (List.isEmpty(fieldRfn(List.head(fields))) == 0) 1 else fieldsHaveRfn(List.tail(fields))

def findDefByCallee(defs: List, callee: String): List =
  if (List.isEmpty(defs) == 1) List.empty() else if (streq(defName(List.head(defs)), callee) == 1) List.cons(List.head(defs), List.empty()) else if (streq(qualKey(defModule(List.head(defs)), defName(List.head(defs))), callee) == 1) List.cons(List.head(defs), List.empty()) else findDefByCallee(List.tail(defs), callee)

def findRecordByCallee(enums: List, callee: String): List =
  if (List.isEmpty(enums) == 1) List.empty() else if (enumIsRecord(List.head(enums)) == 0) findRecordByCallee(List.tail(enums), callee) else if (streq(enumName(List.head(enums)), callee) == 1) List.cons(List.head(enums), List.empty()) else if (streq(qualKey(enumModule(List.head(enums)), enumName(List.head(enums))), callee) == 1) List.cons(List.head(enums), List.empty()) else findRecordByCallee(List.tail(enums), callee)

def lawCheck(name: String, pred: Expr, value: Expr): Expr =
  Expr.Call("Law.check", List.cons(Expr.StrLit(name, dummySpan()), List.cons(pred, List.cons(value, List.empty()))), dummySpan())

def checkedParamArg(label: String, p: Param): Expr =
  if (List.isEmpty(paramRfn(p)) == 1) Expr.Var(paramName(p), dummySpan()) else lawCheck(str3(label, ".", paramName(p)), List.head(paramRfn(p)), Expr.Var(paramName(p), dummySpan()))

def checkedParamArgs(label: String, params: List, acc: List): List =
  if (List.isEmpty(params) == 1) List.reverse(acc) else checkedParamArgs(label, List.tail(params), List.cons(checkedParamArg(label, List.head(params)), acc))

def wrapParamLets(params: List, args: List, body: Expr): Expr =
  if (List.isEmpty(params) == 1) body else Expr.Let(paramName(List.head(params)), List.head(args), wrapParamLets(List.tail(params), List.tail(args), body), dummySpan())

def refinedDefCall(callee: String, d: Def, args: List, span: Span): Expr =
  if (paramsHaveRfn(defParams(d)) == 0) Expr.Call(callee, args, span) else if (List.len(defParams(d)) != List.len(args)) Expr.Call(callee, args, span) else wrapParamLets(defParams(d), args, Expr.Call(callee, checkedParamArgs(defName(d), defParams(d), List.empty()), span))

def checkedFieldArg(label: String, f: EnumField): Expr =
  if (List.isEmpty(fieldRfn(f)) == 1) Expr.Var(fieldName(f), dummySpan()) else lawCheck(str3(label, ".", fieldName(f)), List.head(fieldRfn(f)), Expr.Var(fieldName(f), dummySpan()))

def checkedFieldArgs(label: String, fields: List, acc: List): List =
  if (List.isEmpty(fields) == 1) List.reverse(acc) else checkedFieldArgs(label, List.tail(fields), List.cons(checkedFieldArg(label, List.head(fields)), acc))

def wrapFieldLets(fields: List, args: List, body: Expr): Expr =
  if (List.isEmpty(fields) == 1) body else Expr.Let(fieldName(List.head(fields)), List.head(args), wrapFieldLets(List.tail(fields), List.tail(args), body), dummySpan())

def refinedRecordCall(callee: String, en: EnumDef, args: List, span: Span): Expr =
  for {
    fields = caseFields(List.head(enumCases(en)))
  } yield if (fieldsHaveRfn(fields) == 0) Expr.Call(callee, args, span) else if (List.len(fields) != List.len(args)) Expr.Call(callee, args, span) else wrapFieldLets(fields, args, Expr.Call(callee, checkedFieldArgs(enumName(en), fields, List.empty()), span))

def residualizeCall(callee: String, args: List, span: Span, defs: List, enums: List): Expr =
  residualizeCallHit(callee, args, span, findDefByCallee(defs, callee), findRecordByCallee(enums, callee))

def residualizeCallHit(callee: String, args: List, span: Span, defs: List, recs: List): Expr =
  if (List.isEmpty(defs) == 0) refinedDefCall(callee, List.head(defs), args, span) else if (List.isEmpty(recs) == 0) refinedRecordCall(callee, List.head(recs), args, span) else Expr.Call(callee, args, span)

def residualizeAdt(enumName: String, caseName: String, args: List, typeArgs: List, span: Span, enums: List): Expr =
  residualizeAdtHit(enumName, caseName, args, typeArgs, span, findRecordByCallee(enums, enumName))

def residualizeAdtHit(enumName: String, caseName: String, args: List, typeArgs: List, span: Span, recs: List): Expr =
  if (List.isEmpty(recs) == 1) Expr.Adt(enumName, caseName, args, typeArgs, span) else residualizeAdtRecord(enumName, caseName, args, typeArgs, span, List.head(recs))

def residualizeAdtRecord(enN: String, caseN: String, args: List, typeArgs: List, span: Span, en: EnumDef): Expr =
  for {
    fields = caseFields(List.head(enumCases(en)))
  } yield if (fieldsHaveRfn(fields) == 0) Expr.Adt(enN, caseN, args, typeArgs, span) else if (List.len(fields) != List.len(args)) Expr.Adt(enN, caseN, args, typeArgs, span) else wrapFieldLets(fields, args, Expr.Adt(enN, caseN, checkedFieldArgs(enumName(en), fields, List.empty()), typeArgs, span))

def residualizeExpr(e: Expr, defs: List, enums: List): Expr =
  e match {
    case Expr.Call(callee, args, span) => residualizeCall(callee, residualizeExprList(args, defs, enums, List.empty()), span, defs, enums)
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => residualizeAdt(enumName, caseName, residualizeExprList(args, defs, enums, List.empty()), typeArgs, span, enums)
    case Expr.Let(name, value, body, span) => Expr.Let(name, residualizeExpr(value, defs, enums), residualizeExpr(body, defs, enums), span)
    case Expr.FlatMap(inner, param, body, span) => Expr.FlatMap(residualizeExpr(inner, defs, enums), param, residualizeExpr(body, defs, enums), span)
    case Expr.Handle(inner, body, span) => Expr.Handle(residualizeExpr(inner, defs, enums), residualizeExpr(body, defs, enums), span)
    case Expr.If(cond, thenB, elseB, span) => Expr.If(residualizeExpr(cond, defs, enums), residualizeExpr(thenB, defs, enums), residualizeExpr(elseB, defs, enums), span)
    case Expr.BinOp(op, left, right, span) => Expr.BinOp(op, residualizeExpr(left, defs, enums), residualizeExpr(right, defs, enums), span)
    case Expr.Lambda(param, body, span) => Expr.Lambda(param, residualizeExpr(body, defs, enums), span)
    case Expr.Match(scrut, arms, span) => Expr.Match(residualizeExpr(scrut, defs, enums), residualizeArms(arms, defs, enums, List.empty()), span)
    case Expr.For(binders, body, span) => Expr.For(residualizeBinders(binders, defs, enums, List.empty()), residualizeExpr(body, defs, enums), span)
    case Expr.ListLit(elems, span) => Expr.ListLit(residualizeExprList(elems, defs, enums, List.empty()), span)
    case Expr.Interp(parts, span) => Expr.Interp(residualizeParts(parts, defs, enums, List.empty()), span)
    case Expr.MethodCall(receiver, method, args, span) => Expr.MethodCall(residualizeExpr(receiver, defs, enums), method, residualizeExprList(args, defs, enums, List.empty()), span)
    case Expr.Field(base, field, span) => Expr.Field(residualizeExpr(base, defs, enums), field, span)
    case Expr.Println(arg, span) => Expr.Println(residualizeExpr(arg, defs, enums), span)
    case Expr.Fail(arg, span) => Expr.Fail(residualizeExpr(arg, defs, enums), span)
    case Expr.Pure(arg, span) => Expr.Pure(residualizeExpr(arg, defs, enums), span)
    case Expr.Sleep(arg, span) => Expr.Sleep(residualizeExpr(arg, defs, enums), span)
    case Expr.Attempt(inner, span) => Expr.Attempt(residualizeExpr(inner, defs, enums), span)
    case Expr.IoRace(left, right, span) => Expr.IoRace(residualizeExpr(left, defs, enums), residualizeExpr(right, defs, enums), span)
    case Expr.IoBoth(left, right, span) => Expr.IoBoth(residualizeExpr(left, defs, enums), residualizeExpr(right, defs, enums), span)
    case Expr.IoEnsure(inner, finalizer, span) => Expr.IoEnsure(residualizeExpr(inner, defs, enums), residualizeExpr(finalizer, defs, enums), span)
    case Expr.IoTimeout(ms, inner, span) => Expr.IoTimeout(residualizeExpr(ms, defs, enums), residualizeExpr(inner, defs, enums), span)
    case _ => e
  }

def residualizeExprList(xs: List, defs: List, enums: List, acc: List): List =
  if (List.isEmpty(xs) == 1) List.reverse(acc) else residualizeExprList(List.tail(xs), defs, enums, List.cons(residualizeExpr(List.head(xs), defs, enums), acc))

def residualizeArms(arms: List, defs: List, enums: List, acc: List): List =
  if (List.isEmpty(arms) == 1) List.reverse(acc) else residualizeArms(List.tail(arms), defs, enums, List.cons(setArmBody(List.head(arms), residualizeExpr(armBody(List.head(arms)), defs, enums)), acc))

def residualizeBinders(binders: List, defs: List, enums: List, acc: List): List =
  if (List.isEmpty(binders) == 1) List.reverse(acc) else residualizeBinders(List.tail(binders), defs, enums, List.cons(residualizeBinder(List.head(binders), defs, enums), acc))

def residualizeBinder(b: ForBinder, defs: List, enums: List): ForBinder =
  b match {
    case ForBinder.Eq(name, value) => ForBinder.Eq(name, residualizeExpr(value, defs, enums))
    case ForBinder.Draw(name, value) => ForBinder.Draw(name, residualizeExpr(value, defs, enums))
  }

def residualizeParts(parts: List, defs: List, enums: List, acc: List): List =
  if (List.isEmpty(parts) == 1) List.reverse(acc) else residualizeParts(List.tail(parts), defs, enums, List.cons(residualizePart(List.head(parts), defs, enums), acc))

def residualizePart(part: InterpPart, defs: List, enums: List): InterpPart =
  part match {
    case InterpPart.Lit(text) => part
    case InterpPart.Hole(expr) => InterpPart.Hole(residualizeExpr(expr, defs, enums))
  }

def checkSimParams(lp: List, sp: List, name: String, label: String, i: Int): IO[Unit] =
  if (i >= List.len(lp)) IO.pure(()) else if (tyEq(paramTy(List.at(lp, i)), paramTy(List.at(sp, i))) == 0) IO.fail(str4(label, ": sim def `", name, str3("` param `", paramName(List.at(sp, i)), "` type mismatch"))) else checkSimParams(lp, sp, name, label, i + 1)

def checkSimMatch(live: Def, sim: Def, label: String): IO[Unit] =
  for {
    lp = defParams(live)
    sp = defParams(sim)
    name = defName(sim)
  } yield if (defIsLaw(live) == 1) IO.fail(str4(label, ": sim def `", name, "` cannot replace a law")) else if (defIsLaw(sim) == 1) IO.fail(str3(label, ": *.scuzz_sim must not declare a law", "")) else if (List.len(lp) != List.len(sp)) IO.fail(str4(label, ": sim def `", name, str3("` arity mismatch (live ", Str.fromInt(List.len(lp)), str3(", sim ", Str.fromInt(List.len(sp)), ")")))) else if (tyEq(declRet(live), declRet(sim)) == 0) IO.fail(str4(label, ": sim def `", name, "` return type mismatch")) else if (tyIsIo(declRet(live)) != tyIsIo(declRet(sim))) IO.fail(str4(label, ": sim def `", name, "` purity mismatch")) else checkSimParams(lp, sp, name, label, 0)

def replaceSimDefAcc(defs: List, sim: Def, label: String, acc: List, found: Int): IO[List] =
  if (List.isEmpty(defs) == 1) if (found == 0) IO.fail(str5(label, ": sim def `", defName(sim), "` has no live twin", "")) else IO.pure(List.reverse(acc)) else if (streq(defName(List.head(defs)), defName(sim)) == 1) if (streq(defModule(List.head(defs)), defModule(sim)) == 1) checkSimMatch(List.head(defs), sim, label).flatMap(_ => replaceSimDefAcc(List.tail(defs), sim, label, List.cons(sim, acc), 1)) else replaceSimDefAcc(List.tail(defs), sim, label, List.cons(List.head(defs), acc), found) else replaceSimDefAcc(List.tail(defs), sim, label, List.cons(List.head(defs), acc), found)

def replaceSimDef(defs: List, sim: Def, label: String): IO[List] =
  replaceSimDefAcc(defs, sim, label, List.empty(), 0)

def applySimDefs(prog: Prog, defs: List, label: String): IO[Prog] =
  if (List.isEmpty(defs) == 1) IO.pure(prog) else replaceSimDef(progDefs(prog), List.head(defs), label).flatMap(newDefs => applySimDefs(setProgDefs(prog, newDefs), List.tail(defs), label))

def applyOneSim(prog: Prog, ov: List): IO[Prog] =
  for {
    p = parseSource(ovLabel(ov), ovText(ov))
    label = ovLabel(ov)
    defs = stampDefsModule(progDefs(p), simStem(label))
  } yield if (isUnitExpr(progMain(p)) == 0) IO.fail(str3(label, ": *.scuzz_sim must not define @main", "")) else if (List.isEmpty(progEnums(p)) == 0) IO.fail(str3(label, ": *.scuzz_sim must not define enums", "")) else applySimDefs(prog, defs, label)

def applySims(prog: Prog, sims: List): IO[Prog] =
  if (List.isEmpty(sims) == 1) IO.pure(prog) else applyOneSim(prog, List.head(sims)).flatMap(p2 => applySims(p2, List.tail(sims)))

def driverRetOk(ret: Type): Int =
  if (tyIsIo(ret) == 0) 0 else if (tyEq(tyIoInner(ret), Type.Unit) == 1) 1 else 0

def driverParamOk(t: Type): Int =
  t match {
    case Type.Int => 1
    case Type.String => 1
    case _ => 0
  }

def findDefNamed(defs: List, mod: String, name: String): Int =
  if (List.isEmpty(defs) == 1) 0 else if (streq(defName(List.head(defs)), name) == 1) if (streq(defModule(List.head(defs)), mod) == 1) 1 else findDefNamed(List.tail(defs), mod, name) else findDefNamed(List.tail(defs), mod, name)

def exprHasLaw(e: Expr): Int =
  e match {
    case Expr.Call(callee, args, span) => if (startsWith(callee, "Law.") == 1) 1 else exprHasLawList(args)
    case Expr.Let(name, value, body, span) => if (exprHasLaw(value) == 1) 1 else exprHasLaw(body)
    case Expr.FlatMap(inner, param, body, span) => if (exprHasLaw(inner) == 1) 1 else exprHasLaw(body)
    case Expr.Handle(inner, body, span) => if (exprHasLaw(inner) == 1) 1 else exprHasLaw(body)
    case Expr.If(cond, thenB, elseB, span) => if (exprHasLaw(cond) == 1) 1 else if (exprHasLaw(thenB) == 1) 1 else exprHasLaw(elseB)
    case Expr.BinOp(op, left, right, span) => if (exprHasLaw(left) == 1) 1 else exprHasLaw(right)
    case Expr.Lambda(param, body, span) => exprHasLaw(body)
    case Expr.Match(scrut, arms, span) => if (exprHasLaw(scrut) == 1) 1 else exprHasLawArms(arms)
    case Expr.For(binders, body, span) => if (exprHasLawBinders(binders) == 1) 1 else exprHasLaw(body)
    case Expr.ListLit(elems, span) => exprHasLawList(elems)
    case Expr.Interp(parts, span) => exprHasLawParts(parts)
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => exprHasLawList(args)
    case Expr.MethodCall(receiver, method, args, span) => if (exprHasLaw(receiver) == 1) 1 else exprHasLawList(args)
    case Expr.Field(base, field, span) => exprHasLaw(base)
    case Expr.Println(arg, span) => exprHasLaw(arg)
    case Expr.Fail(arg, span) => exprHasLaw(arg)
    case Expr.Pure(arg, span) => exprHasLaw(arg)
    case Expr.Sleep(arg, span) => exprHasLaw(arg)
    case Expr.Attempt(inner, span) => exprHasLaw(inner)
    case Expr.IoRace(left, right, span) => if (exprHasLaw(left) == 1) 1 else exprHasLaw(right)
    case Expr.IoBoth(left, right, span) => if (exprHasLaw(left) == 1) 1 else exprHasLaw(right)
    case Expr.IoEnsure(inner, finalizer, span) => if (exprHasLaw(inner) == 1) 1 else exprHasLaw(finalizer)
    case Expr.IoTimeout(ms, inner, span) => if (exprHasLaw(ms) == 1) 1 else exprHasLaw(inner)
    case _ => 0
  }

def exprHasLawList(xs: List): Int =
  if (List.isEmpty(xs) == 1) 0 else if (exprHasLaw(List.head(xs)) == 1) 1 else exprHasLawList(List.tail(xs))

def exprHasLawArms(arms: List): Int =
  if (List.isEmpty(arms) == 1) 0 else if (exprHasLaw(armBody(List.head(arms))) == 1) 1 else exprHasLawArms(List.tail(arms))

def exprHasLawBinders(binders: List): Int =
  if (List.isEmpty(binders) == 1) 0 else if (exprHasLawBinder(List.head(binders)) == 1) 1 else exprHasLawBinders(List.tail(binders))

def exprHasLawBinder(b: ForBinder): Int =
  b match {
    case ForBinder.Eq(name, value) => exprHasLaw(value)
    case ForBinder.Draw(name, value) => exprHasLaw(value)
  }

def exprHasLawParts(parts: List): Int =
  if (List.isEmpty(parts) == 1) 0 else if (exprHasLawPart(List.head(parts)) == 1) 1 else exprHasLawParts(List.tail(parts))

def exprHasLawPart(part: InterpPart): Int =
  part match {
    case InterpPart.Lit(text) => 0
    case InterpPart.Hole(expr) => exprHasLaw(expr)
  }

def checkDriverDef(prog: Prog, d: Def, label: String): IO[Unit] =
  for {
    name = defName(d)
    params = defParams(d)
  } yield if (defIsLaw(d) == 1) IO.fail(str3(label, ": *.scuzz_drivers must not declare a law", "")) else if (findDefNamed(progDefs(prog), defModule(d), name) == 1) IO.fail(str4(label, ": driver `", name, "` collides with a live def")) else if (driverRetOk(declRet(d)) == 0) IO.fail(str4(label, ": driver `", name, "` must return IO[Unit]")) else if (List.len(params) > 1) IO.fail(str4(label, ": driver `", name, "` takes at most one Int or String param")) else if (List.isEmpty(params) == 0) if (driverParamOk(paramType(List.head(params))) == 0) IO.fail(str4(label, ": driver `", name, "` param must be Int or String")) else if (exprHasLaw(defBody(d)) == 1) IO.fail(str4(label, ": driver `", name, "` must not call Law.*")) else IO.pure(()) else if (exprHasLaw(defBody(d)) == 1) IO.fail(str4(label, ": driver `", name, "` must not call Law.*")) else IO.pure(())

def applyDriverDefs(prog: Prog, defs: List, label: String): IO[Prog] =
  if (List.isEmpty(defs) == 1) IO.pure(prog) else checkDriverDef(prog, List.head(defs), label).flatMap(_ => applyDriverDefs(setProgDefs(prog, listConcat(progDefs(prog), List.cons(List.head(defs), List.empty()))), List.tail(defs), label))

def applyOneDriver(prog: Prog, ov: List): IO[Prog] =
  for {
    p = parseSource(ovLabel(ov), ovText(ov))
    label = ovLabel(ov)
    defs = stampDefsModule(progDefs(p), driverStem(label))
  } yield if (isUnitExpr(progMain(p)) == 0) IO.fail(str3(label, ": *.scuzz_drivers must not define @main", "")) else if (List.isEmpty(progEnums(p)) == 0) IO.fail(str3(label, ": *.scuzz_drivers must not define enums", "")) else applyDriverDefs(prog, defs, label)

def applyDrivers(prog: Prog, ovs: List): IO[Prog] =
  if (List.isEmpty(ovs) == 1) IO.pure(prog) else applyOneDriver(prog, List.head(ovs)).flatMap(p2 => applyDrivers(p2, List.tail(ovs)))

def driverKindSuffix(params: List): String =
  if (List.isEmpty(params) == 1) "" else if (tyEq(paramType(List.head(params)), Type.String) == 1) " s" else " i"

def driverTableAcc(defs: List, acc: String): String =
  if (List.isEmpty(defs) == 1) acc else driverTableAcc(List.tail(defs), Str.concat(acc, str3(defName(List.head(defs)), driverKindSuffix(defParams(List.head(defs))), "\n")))

def driverTableFromOverlay(ov: List): String =
  driverTableAcc(progDefs(parseSource(ovLabel(ov), ovText(ov))), "")

def driverTableFromOverlays(ovs: List, acc: String): String =
  if (List.isEmpty(ovs) == 1) acc else driverTableFromOverlays(List.tail(ovs), Str.concat(acc, driverTableFromOverlay(List.head(ovs))))

def collectDriverNamesFromOverlays(ovs: List, acc: List): List =
  if (List.isEmpty(ovs) == 1) List.reverse(acc) else collectDriverNamesFromOverlays(List.tail(ovs), collectDriverNamesFromDefs(progDefs(parseSource(ovLabel(List.head(ovs)), ovText(List.head(ovs)))), acc))

def collectDriverNamesFromDefs(defs: List, acc: List): List =
  if (List.isEmpty(defs) == 1) acc else collectDriverNamesFromDefs(List.tail(defs), List.cons(defName(List.head(defs)), acc))

def writeDriversTable(outDir: String, verify: Int, overlays: List): IO[Unit] =
  if (verify == 0) IO.pure(()) else Fs.write(pathJoin(outDir, "drivers.txt"), driverTableFromOverlays(filterOverlays(overlays, "drivers", List.empty()), ""))

def lawRetOk(ret: Type): Int =
  ret match {
    case Type.Bool => 1
    case Type.Int => 1
    case _ => 0
  }

def collectLawNames(defs: List, acc: List): List =
  if (List.isEmpty(defs) == 1) List.reverse(acc) else if (defIsLaw(List.head(defs)) == 1) collectLawNames(List.tail(defs), List.cons(defName(List.head(defs)), acc)) else collectLawNames(List.tail(defs), acc)

def collectSometimesPush(acc: List, name: String): List =
  if (listContainsStr(acc, name) == 1) acc else List.cons(name, acc)

def collectSometimesProg(prog: Prog): List =
  List.reverse(collectSometimesExpr(progMain(prog), collectSometimesDefs(progDefs(prog), List.empty())))

def collectSometimesDefs(defs: List, acc: List): List =
  if (List.isEmpty(defs) == 1) acc else collectSometimesDefs(List.tail(defs), collectSometimesExpr(defBody(List.head(defs)), acc))

def collectSometimesExpr(e: Expr, acc: List): List =
  e match {
    case Expr.Call(callee, args, span) => collectSometimesCall(callee, args, acc)
    case Expr.Let(name, value, body, span) => collectSometimesExpr(body, collectSometimesExpr(value, acc))
    case Expr.FlatMap(inner, param, body, span) => collectSometimesExpr(body, collectSometimesExpr(inner, acc))
    case Expr.Handle(inner, body, span) => collectSometimesExpr(body, collectSometimesExpr(inner, acc))
    case Expr.If(cond, thenB, elseB, span) => collectSometimesExpr(elseB, collectSometimesExpr(thenB, collectSometimesExpr(cond, acc)))
    case Expr.BinOp(op, left, right, span) => collectSometimesExpr(right, collectSometimesExpr(left, acc))
    case Expr.Lambda(param, body, span) => collectSometimesExpr(body, acc)
    case Expr.Match(scrut, arms, span) => collectSometimesArms(arms, collectSometimesExpr(scrut, acc))
    case Expr.For(binders, body, span) => collectSometimesExpr(body, collectSometimesBinders(binders, acc))
    case Expr.ListLit(elems, span) => collectSometimesArgs(elems, acc)
    case Expr.Interp(parts, span) => collectSometimesParts(parts, acc)
    case Expr.Adt(enumName, caseName, args, typeArgs, span) => collectSometimesArgs(args, acc)
    case Expr.MethodCall(receiver, method, args, span) => collectSometimesArgs(args, collectSometimesExpr(receiver, acc))
    case Expr.Field(base, field, span) => collectSometimesExpr(base, acc)
    case Expr.Println(arg, span) => collectSometimesExpr(arg, acc)
    case Expr.Fail(arg, span) => collectSometimesExpr(arg, acc)
    case Expr.Pure(arg, span) => collectSometimesExpr(arg, acc)
    case Expr.Sleep(arg, span) => collectSometimesExpr(arg, acc)
    case Expr.Attempt(inner, span) => collectSometimesExpr(inner, acc)
    case Expr.IoRace(left, right, span) => collectSometimesExpr(right, collectSometimesExpr(left, acc))
    case Expr.IoBoth(left, right, span) => collectSometimesExpr(right, collectSometimesExpr(left, acc))
    case Expr.IoEnsure(inner, finalizer, span) => collectSometimesExpr(finalizer, collectSometimesExpr(inner, acc))
    case Expr.IoTimeout(ms, inner, span) => collectSometimesExpr(inner, collectSometimesExpr(ms, acc))
    case _ => acc
  }

def collectSometimesCall(callee: String, args: List, acc: List): List =
  if (streq(callee, "Law.sometimes") == 0) collectSometimesArgs(args, acc) else if (List.isEmpty(args) == 1) acc else collectSometimesArgs(args, collectSometimesName(List.head(args), acc))

def collectSometimesName(e: Expr, acc: List): List =
  if (isStrLitExpr(e) == 0) acc else collectSometimesPush(acc, strLitExprValue(e))

def collectSometimesArgs(args: List, acc: List): List =
  if (List.isEmpty(args) == 1) acc else collectSometimesArgs(List.tail(args), collectSometimesExpr(List.head(args), acc))

def collectSometimesArms(arms: List, acc: List): List =
  if (List.isEmpty(arms) == 1) acc else collectSometimesArms(List.tail(arms), collectSometimesExpr(armBody(List.head(arms)), acc))

def collectSometimesBinders(binders: List, acc: List): List =
  if (List.isEmpty(binders) == 1) acc else collectSometimesBinders(List.tail(binders), collectSometimesBinder(List.head(binders), acc))

def collectSometimesBinder(b: ForBinder, acc: List): List =
  b match {
    case ForBinder.Eq(name, value) => collectSometimesExpr(value, acc)
    case ForBinder.Draw(name, value) => collectSometimesExpr(value, acc)
  }

def collectSometimesParts(parts: List, acc: List): List =
  if (List.isEmpty(parts) == 1) acc else collectSometimesParts(List.tail(parts), collectSometimesPart(List.head(parts), acc))

def collectSometimesPart(part: InterpPart, acc: List): List =
  part match {
    case InterpPart.Lit(text) => acc
    case InterpPart.Hole(expr) => collectSometimesExpr(expr, acc)
  }

def sometimesDeclaredText(names: List): String =
  if (List.isEmpty(names) == 1) "" else Str.concat(join(names, "\n"), "\n")

def writeSometimesDeclared(outDir: String, verify: Int, prog: Prog): IO[Unit] =
  if (verify == 0) IO.pure(()) else Fs.write(pathJoin(outDir, "sometimes.declared"), sometimesDeclaredText(collectSometimesProg(prog)))

def eraseLawsDefs(defs: List, acc: List): List =
  if (List.isEmpty(defs) == 1) List.reverse(acc) else if (defIsLaw(List.head(defs)) == 1) eraseLawsDefs(List.tail(defs), acc) else eraseLawsDefs(List.tail(defs), List.cons(List.head(defs), acc))

def checkLawDefs(defs: List): IO[Unit] =
  if (List.isEmpty(defs) == 1) IO.pure(()) else checkLawDefOne(List.head(defs), List.tail(defs))

def checkLawDefOne(d: Def, rest: List): IO[Unit] =
  if (defIsLaw(d) == 0) checkLawDefs(rest) else if (lawRetOk(declRet(d)) == 0) IO.fail(str3("law `", defName(d), str3("` must return Bool (or Int), got ", tyShow(declRet(d)), ""))) else if (List.isEmpty(defParams(d)) == 0) IO.fail(str3("law `", defName(d), "` must be nullary for residual checks")) else checkLawDefs(rest)

def applyOverlays(live: Prog, overlays: List): IO[Prog] =
  applySims(live, filterOverlays(overlays, "sim", List.empty())).flatMap(p1 => applyDrivers(p1, filterOverlays(overlays, "drivers", List.empty())))

def filterOverlays(ovs: List, kind: String, acc: List): List =
  if (List.isEmpty(ovs) == 1) List.reverse(acc) else if (streq(ovKind(List.head(ovs)), kind) == 1) filterOverlays(List.tail(ovs), kind, List.cons(List.head(ovs), acc)) else filterOverlays(List.tail(ovs), kind, acc)

def prepareVerifyProg(prog0: Prog, overlays: List): IO[Prog] =
  applyOverlays(prog0, overlays).flatMap(p1 =>
    checkLawDefs(progDefs(p1)).flatMap(_ => IO.pure(residualizeRefinements(residualizeLaws(p1, collectLawNames(progDefs(p1), List.empty())))))
  )

def compileProject(projectDir: String, outDir: String): IO[Unit] =
  Sys.getenv("SCUZZ_RUNTIME").flatMap(rtEnv =>
    resolveRuntimeEnv(rtEnv, projectDir).flatMap(runtimeDir =>
      Sys.getenv("SCUZZ_CLANG").flatMap(clangEnv => compileProjectWith(projectDir, outDir, 0, runtimeDir, clangOrDefault(clangEnv)))
    )
  )

def compileProjectVerify(projectDir: String, outDir: String): IO[Unit] =
  Sys.getenv("SCUZZ_RUNTIME").flatMap(rtEnv =>
    resolveRuntimeEnv(rtEnv, projectDir).flatMap(runtimeDir =>
      Sys.getenv("SCUZZ_CLANG").flatMap(clangEnv => compileProjectWith(projectDir, outDir, 1, runtimeDir, clangOrDefault(clangEnv)))
    )
  )

def compileProjectWith(projectDir: String, outDir: String, verify: Int, runtimeDir: String, clang: String): IO[Unit] =
  Fs.read(pathJoin(projectDir, "scuzz.toml")).flatMap(toml => compileAfterToml(projectDir, outDir, verify, runtimeDir, clang, toml, readTomlName(toml)))

def compileAfterToml(projectDir: String, outDir: String, verify: Int, runtimeDir: String, clang: String, toml: String, name: String): IO[Unit] =
  loadGraphBundle(projectDir, toml).flatMap(bundle => compileAfterSources(projectDir, outDir, verify, runtimeDir, clang, name, hasUiSection(toml), List.head(bundle), List.head(List.tail(bundle))))

def checkProject(projectDir: String): IO[List] =
  Fs.read(pathJoin(projectDir, "scuzz.toml")).flatMap(toml =>
    loadGraphBundle(projectDir, toml).flatMap(bundle =>
      for {
        sources = List.head(bundle)
      } yield mergeSources(sources, emptyProg(), 0).flatMap(prog0 =>
  prepareVerifyProg(prog0, List.head(List.tail(bundle))).flatMap(prog1 =>
    for {
      prog = expandImplsProg(lowerProg(prog1))
      ty = typecheckProg(prog)
      ep = elaborateProg(prog)
      ty2 = if (tyIsOk(ty) == 0) ty else elabResOf(ep)
    } yield IO.pure(List.cons(ty2, List.cons(sources, List.empty())))
  )
)
    )
  )

def linkProject(clang: String, ll: String, lib: String, ffi: String, inc: String, embedder: String, mobile: String, exe: String, withUi: Int): IO[Unit] =
  if (withUi == 0) execOk(linkCmdIo(clang, ll, lib, inc, exe)) else execOk(linkCmd(clang, ll, lib, pathJoin(ffi, "build/libsk_capi.a"), inc, pathJoin(ffi, "include"), embedder, mobile, exe))

def compileAfterSources(projectDir: String, outDir: String, verify: Int, runtimeDir: String, clang: String, name: String, withUi: Int, texts: List, overlays: List): IO[Unit] =
  mergeSources(texts, emptyProg(), 0).flatMap(prog0 =>
    prepareCompileProg(prog0, overlays, verify).flatMap(prog1 =>
      for {
        prog0 = lowerProg(prog1)
        prog1b = expandImplsProg(prog0)
        ty = typecheckProg(prog1b)
        ep = elaborateProg(prog1b)
        progMono = monomorphizeProg(List.head(ep))
        prog = resolveFieldsProg(progMono)
        dnames = if (verify == 0) List.empty() else collectDriverNamesFromOverlays(filterOverlays(overlays, "drivers", List.empty()), List.empty())
        ir = emitProgram(prog, dnames)
        ll = pathJoin(outDir, Str.concat(name, ".ll"))
        exe = pathJoin(outDir, name)
        lib = pathJoin(runtimeDir, "build/libscuzz_rt.a")
        ffi = pathJoin(parentDir(runtimeDir), "ffi-skia")
        inc = pathJoin(runtimeDir, "include")
        embedder = pathJoin(pathJoin(parentDir(runtimeDir), "embedder-desktop"), "build/libscuzz_embedder.a")
        mobile = pathJoin(pathJoin(parentDir(runtimeDir), "embedder-mobile"), "build/libscuzz_mobile.a")
      } yield if (tyIsOk(ty) == 0) IO.fail(tyMsg(ty)) else if (tyIsOk(elabResOf(ep)) == 0) IO.fail(tyMsg(elabResOf(ep))) else Fs.mkdirs(outDir).flatMap(_ =>
  writeSometimesDeclared(outDir, verify, prog1b).flatMap(_ =>
    writeDriversTable(outDir, verify, overlays).flatMap(_ =>
      Fs.write(ll, ir).flatMap(_ =>
        buildRuntime(runtimeDir, clang).flatMap(_ => linkProject(clang, ll, lib, ffi, inc, embedder, mobile, exe, withUi))
      )
    )
  )
)
    )
  )

def prepareCompileProg(prog0: Prog, overlays: List, verify: Int): IO[Prog] =
  if (verify == 0) IO.pure(setProgDefs(prog0, eraseLawsDefs(progDefs(prog0), List.empty()))) else prepareVerifyProg(prog0, overlays)

def loadGraphBundle(projectDir: String, toml: String): IO[List] =
  Fs.canonicalize(projectDir).flatMap(root =>
    visitPackage(root, toml, "", List.empty(), List.empty()).flatMap(state => IO.pure(List.cons(List.head(state), List.cons(List.head(List.tail(state)), List.empty()))))
  )

def visitPackage(pkgDir: String, toml: String, viaDep: String, stack: List, done: List): IO[List] =
  Fs.canonicalize(pkgDir).flatMap(canon => visitPackageCanon(canon, toml, viaDep, stack, done))

def visitPackageCanon(canon: String, toml: String, viaDep: String, stack: List, done: List): IO[List] =
  if (listContainsStr(stack, canon) == 1) IO.fail(str3("dependency cycle: ", join(List.reverse(List.cons(cycleLabel(viaDep, canon), stack)), " -> "), "")) else if (listContainsStr(done, canon) == 1) IO.pure(List.cons(List.empty(), List.cons(List.empty(), List.cons(done, List.empty())))) else validateScuzzToml(toml).flatMap(_ =>
  readTomlDeps(toml).flatMap(deps =>
    visitDeps(canon, deps, List.cons(canon, stack), done, List.empty(), List.empty()).flatMap(depState =>
      loadPackageBundle(canon).flatMap(bundle =>
        for {
          depTexts = List.head(depState)
          depOvs = List.head(List.tail(depState))
          depDone = List.head(List.tail(List.tail(depState)))
          allTexts = listConcat(depTexts, List.head(bundle))
          allOvs = listConcat(depOvs, List.head(List.tail(bundle)))
        } yield IO.pure(List.cons(allTexts, List.cons(allOvs, List.cons(List.cons(canon, depDone), List.empty()))))
      )
    )
  )
)

def cycleLabel(viaDep: String, canon: String): String =
  if (Str.len(viaDep) > 0) viaDep else canon

def visitDeps(pkgDir: String, deps: List, stack: List, done: List, accTexts: List, accOvs: List): IO[List] =
  if (List.isEmpty(deps) == 1) IO.pure(List.cons(accTexts, List.cons(accOvs, List.cons(done, List.empty())))) else visitDepOne(pkgDir, List.head(deps), List.tail(deps), stack, done, accTexts, accOvs)

def visitDepOne(pkgDir: String, dep: List, rest: List, stack: List, done: List, accTexts: List, accOvs: List): IO[List] =
  for {
    name = depName(dep)
    rel = depPath(dep)
    child = pathJoin(pkgDir, rel)
  } yield readDepManifest(name, child).flatMap(childToml =>
  visitPackage(child, childToml, name, stack, done).flatMap(childState =>
    for {
      childTexts = List.head(childState)
      childOvs = List.head(List.tail(childState))
      childDone = List.head(List.tail(List.tail(childState)))
    } yield visitDeps(pkgDir, rest, stack, childDone, listConcat(accTexts, childTexts), listConcat(accOvs, childOvs))
  )
)

def readDepManifest(name: String, child: String): IO[String] =
  Fs.read(pathJoin(child, "scuzz.toml")).handleErrorWith(_ =>
    IO.fail(str5("dependency `", name, "`: missing scuzz.toml in ", child, "")).flatMap(_ => IO.pure(""))
  )

def loadPackageBundle(pkgDir: String): IO[List] =
  for {
    srcDir = pathJoin(pkgDir, "src")
  } yield Fs.list(srcDir).flatMap(names => loadPackageFromNames(srcDir, names)).handleErrorWith(_ =>
  IO.fail(str3("missing src/ in ", pkgDir, "")).flatMap(_ => IO.pure(List.cons(List.empty(), List.cons(List.empty(), List.empty()))))
)

def rejectLawsFiles(names: List): IO[Unit] =
  if (List.isEmpty(names) == 1) IO.pure(()) else if (isLawsName(List.head(names)) == 1) IO.fail(str3(List.head(names), ": *.scuzz_laws is removed; declare `law name: Bool = …` in the live *.scuzz module", "")) else rejectLawsFiles(List.tail(names))

def loadPackageFromNames(srcDir: String, names: List): IO[List] =
  for {
    stems = collectLiveStems(names, List.empty())
    simNames = filterSimNames(names, List.empty())
    driverNames = filterDriverNames(names, List.empty())
  } yield rejectLawsFiles(names).flatMap(_ =>
  validateOverlayStems(stems, simNames).flatMap(_ =>
    validateOverlayStems(stems, driverNames).flatMap(_ =>
      readSources(srcDir, partitionSources(names, List.empty(), List.empty()), List.empty()).flatMap(texts =>
        readOverlayFiles(srcDir, "sim", simNames, List.empty()).flatMap(sims =>
          readOverlayFiles(srcDir, "drivers", driverNames, List.empty()).flatMap(drvs => IO.pure(List.cons(texts, List.cons(listConcat(sims, drvs), List.empty()))))
        )
      )
    )
  )
