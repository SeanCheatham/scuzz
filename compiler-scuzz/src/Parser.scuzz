package scuzz.compiler

def ok(node: List, i: Int): List =
  List.cons(node, List.cons(Str.fromInt(i), List.empty()))

def okExpr(e: Expr, i: Int): List =
  List.cons(e, List.cons(Str.fromInt(i), List.empty()))

def okStr(s: String, i: Int): List =
  List.cons(s, List.cons(Str.fromInt(i), List.empty()))

def okPat(pat: Pattern, i: Int): List =
  List.cons(pat, List.cons(Str.fromInt(i), List.empty()))

def okEnum(e: EnumDef, i: Int): List =
  List.cons(e, List.cons(Str.fromInt(i), List.empty()))

def okDef(d: Def, i: Int): List =
  List.cons(d, List.cons(Str.fromInt(i), List.empty()))

def okParam(p: Param, i: Int): List =
  List.cons(p, List.cons(Str.fromInt(i), List.empty()))

def okType(t: Type, i: Int): List =
  List.cons(t, List.cons(Str.fromInt(i), List.empty()))

def pType(p: List): Type =
  List.head(p)

def pAst(p: List): List =
  List.head(p)

def pExpr(p: List): Expr =
  List.head(p)

def pPat(p: List): Pattern =
  List.head(p)

def pEnum(p: List): EnumDef =
  List.head(p)

def pDef(p: List): Def =
  List.head(p)

def pParam(p: List): Param =
  List.head(p)

def pStr(p: List): String =
  List.head(p)

def pIdx(p: List): Int =
  parseInt(List.head(List.tail(p)))

def unitExpr(): Expr =
  Expr.Unit(dummySpan())

def unitAt(file: String, tokens: List, i: Int): Expr =
  Expr.Unit(tokSpan(file, tokAt(tokens, i)))

def tokAt(tokens: List, i: Int): Tok =
  if (i >= List.len(tokens)) Tok.Sym("Eof", 0, 0) else List.at(tokens, i)

def isTok(tokens: List, i: Int, t: String): Int =
  if (streq(tokKind(tokAt(tokens, i)), t) == 1) 1 else 0

def expectTok(tokens: List, i: Int, t: String): Int =
  if (isTok(tokens, i, t) == 1) i + 1 else i + 1

def spanCover(file: String, tokens: List, lo: Int, hi: Int): Span =
  if (hi <= lo) tokSpan(file, tokAt(tokens, lo)) else coverSpan(tokSpan(file, tokAt(tokens, lo)), tokSpan(file, tokAt(tokens, hi - 1)))

def parseIdent(file: String, tokens: List, i: Int): List =
  for {
    tok = tokAt(tokens, i)
  } yield if (isIdentTok(tok) == 1) okStr(identName(tok), i + 1) else okStr("", i)

def parseType(file: String, tokens: List, i: Int): List =
  parseTypeWith(file, tokens, i, List.empty())

def parseTypeWith(file: String, tokens: List, i: Int, tparams: List): List =
  for {
    nameP = parseIdent(file, tokens, i)
  } yield parseTypeAfterName(file, tokens, pStr(nameP), pIdx(nameP), tparams)

def parseTypeAfterName(file: String, tokens: List, name: String, i: Int, tparams: List): List =
  if (streq(name, "IO") == 1) parseTypeIo(file, tokens, i, tparams) else if (isTok(tokens, i, "LBracket") == 1) if (listContainsStr(tparams, name) == 1) okType(parseTypeBuiltinWith(name, tparams), i) else parseTypeApp(file, tokens, i + 1, name, tparams, List.empty()) else okType(parseTypeBuiltinWith(name, tparams), i)

def parseTypeApp(file: String, tokens: List, i: Int, name: String, tparams: List, acc: List): List =
  for {
    argP = parseTypeWith(file, tokens, i, tparams)
    j = pIdx(argP)
  } yield if (isTok(tokens, j, "Comma") == 1) parseTypeApp(file, tokens, j + 1, name, tparams, List.cons(pType(argP), acc)) else parseTypeAppEnd(file, tokens, j, name, List.cons(pType(argP), acc))

def parseTypeAppEnd(file: String, tokens: List, i: Int, name: String, acc: List): List =
  for {
    i1 = expectTok(tokens, i, "RBracket")
  } yield okType(tyMkApp(name, List.reverse(acc)), i1)

def parseTypeBuiltin(name: String): Type =
  parseTypeBuiltinWith(name, List.empty())

def parseTypeBuiltinWith(name: String, tparams: List): Type =
  if (listContainsStr(tparams, name) == 1) tyMkVar(name) else if (streq(name, "Unit") == 1) Type.Unit else if (streq(name, "Int") == 1) Type.Int else if (streq(name, "String") == 1) Type.String else if (streq(name, "Bool") == 1) Type.Bool else if (streq(name, "List") == 1) Type.List else tyMkAdt(name)

def parseTypeIo(file: String, tokens: List, i: Int, tparams: List): List =
  for {
    i1 = expectTok(tokens, i, "LBracket")
    innerP = parseTypeWith(file, tokens, i1, tparams)
    i2 = expectTok(tokens, pIdx(innerP), "RBracket")
  } yield okType(tyMkIo(pType(innerP)), i2)

def parsePackage(file: String, tokens: List, i: Int): List =
  if (isTok(tokens, i, "Package") == 0) okStr("", i) else parsePackageParts(file, tokens, i + 1, "")

def parsePackageParts(file: String, tokens: List, i: Int, acc: String): List =
  for {
    nameP = parseIdent(file, tokens, i)
    name = pStr(nameP)
    i1 = pIdx(nameP)
    next = if (Str.len(acc) == 0) name else str3(acc, ".", name)
  } yield if (isTok(tokens, i1, "Dot") == 1) parsePackageParts(file, tokens, i1 + 1, next) else okStr(next, i1)

def parseParam(file: String, tokens: List, i: Int): List =
  parseParamWith(file, tokens, i, List.empty())

def parseParamWith(file: String, tokens: List, i: Int, tparams: List): List =
  for {
    nameP = parseIdent(file, tokens, i)
    i1 = expectTok(tokens, pIdx(nameP), "Colon")
    tyP = parseTypeWith(file, tokens, i1, tparams)
  } yield okParam(Param.Param(pStr(nameP), pType(tyP)), pIdx(tyP))

def parseParams(file: String, tokens: List, i: Int, acc: List): List =
  parseParamsWith(file, tokens, i, acc, List.empty())

def parseParamsWith(file: String, tokens: List, i: Int, acc: List, tparams: List): List =
  if (isTok(tokens, i, "RParen") == 1) ok(List.reverse(acc), i) else parseParamsContWith(file, tokens, i, acc, tparams)

def parseParamsCont(file: String, tokens: List, i: Int, acc: List): List =
  parseParamsContWith(file, tokens, i, acc, List.empty())

def parseParamsContWith(file: String, tokens: List, i: Int, acc: List, tparams: List): List =
  for {
    pP = parseParamWith(file, tokens, i, tparams)
    i1 = pIdx(pP)
    acc2 = List.cons(pParam(pP), acc)
  } yield if (isTok(tokens, i1, "Comma") == 1) parseParamsWith(file, tokens, i1 + 1, acc2, tparams) else ok(List.reverse(acc2), i1)

def parseArgs(file: String, tokens: List, i: Int, acc: List): List =
  if (isTok(tokens, i, "RParen") == 1) ok(List.reverse(acc), i) else parseArgsCont(file, tokens, i, acc)

def parseArgsCont(file: String, tokens: List, i: Int, acc: List): List =
  for {
    e = parseExpr(file, tokens, i)
    acc2 = List.cons(pExpr(e), acc)
  } yield if (isTok(tokens, pIdx(e), "Comma") == 1) parseArgs(file, tokens, pIdx(e) + 1, acc2) else ok(List.reverse(acc2), pIdx(e))

def parseListLit(file: String, tokens: List, i: Int): List =
  parseListLitElems(file, tokens, i, List.empty(), i - 1)

def parseListLitElems(file: String, tokens: List, i: Int, acc: List, startI: Int): List =
  if (isTok(tokens, i, "RBracket") == 1) okExpr(Expr.ListLit(List.reverse(acc), spanCover(file, tokens, startI, i + 1)), i + 1) else parseListLitElemsCont(file, tokens, i, acc, startI)

def parseListLitElemsCont(file: String, tokens: List, i: Int, acc: List, startI: Int): List =
  for {
    e = parseExpr(file, tokens, i)
    acc2 = List.cons(pExpr(e), acc)
  } yield if (isTok(tokens, pIdx(e), "Comma") == 1) parseListLitElems(file, tokens, pIdx(e) + 1, acc2, startI) else parseListLitElemsEnd(file, tokens, pIdx(e), acc2, startI)

def parseListLitElemsEnd(file: String, tokens: List, i: Int, acc: List, startI: Int): List =
  for {
    i1 = expectTok(tokens, i, "RBracket")
  } yield okExpr(Expr.ListLit(List.reverse(acc), spanCover(file, tokens, startI, i1)), i1)

def parseBlock(file: String, tokens: List, i: Int): List =
  parseExpr(file, tokens, i)

def parseExpr(file: String, tokens: List, i: Int): List =
  parseOr(file, tokens, i)

def parseOr(file: String, tokens: List, i: Int): List =
  for {
    leftP = parseAnd(file, tokens, i)
  } yield parseOrRest(file, tokens, pExpr(leftP), pIdx(leftP))

def parseOrRest(file: String, tokens: List, left: Expr, i: Int): List =
  if (isTok(tokens, i, "PipePipe") == 1) parseOrRestOp(file, tokens, left, i + 1) else okExpr(left, i)

def parseOrRestOp(file: String, tokens: List, left: Expr, i: Int): List =
  for {
    rightP = parseAnd(file, tokens, i)
    right = pExpr(rightP)
  } yield parseOrRest(file, tokens, Expr.BinOp("||", left, right, coverSpan(exprSpan(left), exprSpan(right))), pIdx(rightP))

def parseAnd(file: String, tokens: List, i: Int): List =
  for {
    leftP = parseCmp(file, tokens, i)
  } yield parseAndRest(file, tokens, pExpr(leftP), pIdx(leftP))

def parseAndRest(file: String, tokens: List, left: Expr, i: Int): List =
  if (isTok(tokens, i, "AmpAmp") == 1) parseAndRestOp(file, tokens, left, i + 1) else okExpr(left, i)

def parseAndRestOp(file: String, tokens: List, left: Expr, i: Int): List =
  for {
    rightP = parseCmp(file, tokens, i)
    right = pExpr(rightP)
  } yield parseAndRest(file, tokens, Expr.BinOp("&&", left, right, coverSpan(exprSpan(left), exprSpan(right))), pIdx(rightP))

def cmpOp(t: String): String =
  if (streq(t, "EqEq") == 1) "==" else if (streq(t, "BangEq") == 1) "!=" else if (streq(t, "Lt") == 1) "<" else if (streq(t, "LtEq") == 1) "<=" else if (streq(t, "Gt") == 1) ">" else if (streq(t, "GtEq") == 1) ">=" else ""

def parseCmp(file: String, tokens: List, i: Int): List =
  for {
    leftP = parseAdd(file, tokens, i)
  } yield parseCmpRest(file, tokens, pExpr(leftP), pIdx(leftP))

def parseCmpRest(file: String, tokens: List, left: Expr, i: Int): List =
  for {
    op = cmpOp(tokKind(tokAt(tokens, i)))
  } yield if (Str.len(op) == 0) okExpr(left, i) else parseCmpRestOp(file, tokens, left, i + 1, op)

def parseCmpRestOp(file: String, tokens: List, left: Expr, i: Int, op: String): List =
  for {
    rightP = parseAdd(file, tokens, i)
    right = pExpr(rightP)
  } yield parseCmpRest(file, tokens, Expr.BinOp(op, left, right, coverSpan(exprSpan(left), exprSpan(right))), pIdx(rightP))

def parseAdd(file: String, tokens: List, i: Int): List =
  for {
    leftP = parseMul(file, tokens, i)
  } yield parseAddRest(file, tokens, pExpr(leftP), pIdx(leftP))

def parseAddRest(file: String, tokens: List, left: Expr, i: Int): List =
  if (isTok(tokens, i, "Plus") == 1) parseAddRestOp(file, tokens, left, i + 1, "+") else if (isTok(tokens, i, "Minus") == 1) parseAddRestOp(file, tokens, left, i + 1, "-") else okExpr(left, i)

def parseAddRestOp(file: String, tokens: List, left: Expr, i: Int, op: String): List =
  for {
    rightP = parseMul(file, tokens, i)
    right = pExpr(rightP)
  } yield parseAddRest(file, tokens, Expr.BinOp(op, left, right, coverSpan(exprSpan(left), exprSpan(right))), pIdx(rightP))

def parseMul(file: String, tokens: List, i: Int): List =
  for {
    leftP = parsePostfix(file, tokens, i)
  } yield parseMulRest(file, tokens, pExpr(leftP), pIdx(leftP))

def parseMulRest(file: String, tokens: List, left: Expr, i: Int): List =
  if (isTok(tokens, i, "Star") == 1) parseMulRestOp(file, tokens, left, i + 1, "*") else if (isTok(tokens, i, "Slash") == 1) parseMulRestOp(file, tokens, left, i + 1, "/") else if (isTok(tokens, i, "Percent") == 1) parseMulRestOp(file, tokens, left, i + 1, "%") else okExpr(left, i)

def parseMulRestOp(file: String, tokens: List, left: Expr, i: Int, op: String): List =
  for {
    rightP = parsePostfix(file, tokens, i)
    right = pExpr(rightP)
  } yield parseMulRest(file, tokens, Expr.BinOp(op, left, right, coverSpan(exprSpan(left), exprSpan(right))), pIdx(rightP))

def parsePostfix(file: String, tokens: List, i: Int): List =
  for {
    primP = parsePrimary(file, tokens, i)
  } yield parsePostfixRest(file, tokens, pExpr(primP), pIdx(primP))

def parsePostfixRest(file: String, tokens: List, expr: Expr, i: Int): List =
  if (isTok(tokens, i, "Dot") == 1) parsePostfixDot(file, tokens, expr, i + 1) else if (isTok(tokens, i, "Match") == 1) parseMatch(file, tokens, expr, i + 1) else okExpr(expr, i)

def parseMatch(file: String, tokens: List, scrut: Expr, i: Int): List =
  for {
    i1 = if (isTok(tokens, i, "LBrace") == 1) i + 1 else i
    armsP = parseMatchArms(file, tokens, i1, List.empty())
    i2 = if (isTok(tokens, pIdx(armsP), "RBrace") == 1) pIdx(armsP) + 1 else pIdx(armsP)
  } yield parsePostfixRest(file, tokens, Expr.Match(scrut, pAst(armsP), coverSpan(exprSpan(scrut), spanCover(file, tokens, i - 1, i2))), i2)

def parseMatchArms(file: String, tokens: List, i: Int, acc: List): List =
  if (isTok(tokens, i, "Case") == 0) ok(List.reverse(acc), i) else parseMatchArm(file, tokens, i + 1, acc)

def parseMatchArm(file: String, tokens: List, i: Int, acc: List): List =
  for {
    patP = parsePattern(file, tokens, i)
    i1 = expectTok(tokens, pIdx(patP), "Arrow")
    bodyP = parseExpr(file, tokens, i1)
  } yield parseMatchArms(file, tokens, pIdx(bodyP), List.cons(MatchArm.Arm(pPat(patP), pExpr(bodyP)), acc))

def parsePattern(file: String, tokens: List, i: Int): List =
  if (isTok(tokens, i, "Underscore") == 1) okPat(Pattern.Wild, i + 1) else parsePatternAdt(file, tokens, i)

def parsePatternAdt(file: String, tokens: List, i: Int): List =
  for {
    nameP = parseIdent(file, tokens, i)
  } yield if (isTok(tokens, pIdx(nameP), "Dot") == 1) parsePatternAdtDot(file, tokens, pIdx(nameP) + 1, pStr(nameP)) else if (isTok(tokens, pIdx(nameP), "LParen") == 1) parsePatternBinds(file, tokens, pIdx(nameP) + 1, pStr(nameP), pStr(nameP), List.empty()) else okPat(Pattern.Adt(pStr(nameP), pStr(nameP), List.empty(), List.empty()), pIdx(nameP))

def parsePatternAdtDot(file: String, tokens: List, i: Int, en: String): List =
  for {
    caseP = parseIdent(file, tokens, i)
    j = pIdx(caseP)
  } yield if (isTok(tokens, j, "LParen") == 1) parsePatternBinds(file, tokens, j + 1, en, pStr(caseP), List.empty()) else okPat(Pattern.Adt(en, pStr(caseP), List.empty(), List.empty()), j)

def parsePatternBinds(file: String, tokens: List, i: Int, en: String, caseName: String, acc: List): List =
  if (isTok(tokens, i, "RParen") == 1) okPat(Pattern.Adt(en, caseName, List.reverse(acc), List.empty()), i + 1) else parsePatternBindsCont(file, tokens, i, en, caseName, acc)

def parsePatternBindsCont(file: String, tokens: List, i: Int, en: String, caseName: String, acc: List): List =
  for {
    bindP = parseIdent(file, tokens, i)
    acc2 = List.cons(pStr(bindP), acc)
    j = pIdx(bindP)
  } yield if (isTok(tokens, j, "Comma") == 1) parsePatternBinds(file, tokens, j + 1, en, caseName, acc2) else parsePatternBindsEnd(file, tokens, j, en, caseName, acc2)

def parsePatternBindsEnd(file: String, tokens: List, i: Int, en: String, caseName: String, acc: List): List =
  for {
    i1 = expectTok(tokens, i, "RParen")
  } yield okPat(Pattern.Adt(en, caseName, List.reverse(acc), List.empty()), i1)

def parsePostfixDot(file: String, tokens: List, expr: Expr, i: Int): List =
  for {
    methodP = parseIdent(file, tokens, i)
    method = pStr(methodP)
    i1 = pIdx(methodP)
  } yield if (streq(method, "flatMap") == 1) parseFlatMap(file, tokens, expr, i1) else if (streq(method, "handleErrorWith") == 1) parseHandle(file, tokens, expr, i1) else if (streq(method, "attempt") == 1) parseAttempt(file, tokens, expr, i1) else if (isTok(tokens, i1, "LParen") == 1) parseMethodCall(file, tokens, expr, method, i1) else parsePostfixRest(file, tokens, Expr.Field(expr, method, coverSpan(exprSpan(expr), tokSpan(file, tokAt(tokens, i1 - 1)))), i1)

def parseMethodCall(file: String, tokens: List, expr: Expr, method: String, i: Int): List =
  for {
    argsP = parseArgs(file, tokens, i + 1, List.empty())
    i1 = expectTok(tokens, pIdx(argsP), "RParen")
    args = pAst(argsP)
    sp = coverSpan(exprSpan(expr), spanCover(file, tokens, i, i1))
  } yield parsePostfixRest(file, tokens, Expr.MethodCall(expr, method, args, sp), i1)

def isUpperIdent(name: String): Int =
  if (Str.len(name) == 0) 0 else if (Str.charAt(name, 0) >= 65) if (Str.charAt(name, 0) <= 90) 1 else 0 else 0

def parseDotCallOrAdt(file: String, tokens: List, i: Int, enumName: String, startI: Int): List =
  for {
    caseP = parseIdent(file, tokens, i)
    caseName = pStr(caseP)
    j = pIdx(caseP)
  } yield if (isTok(tokens, j, "LParen") == 1) parseCallArgs(file, tokens, j + 1, str3(enumName, ".", caseName), startI) else if (isUpperIdent(enumName) == 1) okExpr(Expr.Adt(enumName, caseName, List.empty(), List.empty(), spanCover(file, tokens, startI, j)), j) else okExpr(Expr.Field(Expr.Var(enumName, tokSpan(file, tokAt(tokens, startI))), caseName, spanCover(file, tokens, startI, j)), j)

def parseLambda(file: String, tokens: List, i: Int): List =
  for {
    tok = tokAt(tokens, i)
    t = tokKind(tok)
  } yield if (streq(t, "Underscore") == 1) parseLambdaBody(file, tokens, i + 1, "_") else if (isIdentTok(tok) == 1) parseLambdaBody(file, tokens, i + 1, identName(tok)) else if (streq(t, "LParen") == 1) parseLambdaUnit(file, tokens, i + 1) else ok(List.cons("_", List.cons(unitAt(file, tokens, i), List.empty())), i)

def parseLambdaUnit(file: String, tokens: List, i: Int): List =
  for {
    i1 = expectTok(tokens, i, "RParen")
  } yield parseLambdaBody(file, tokens, i1, "_")

def parseLambdaBody(file: String, tokens: List, i: Int, param: String): List =
  for {
    i1 = expectTok(tokens, i, "Arrow")
    bodyP = parseBlock(file, tokens, i1)
  } yield ok(List.cons(param, List.cons(pExpr(bodyP), List.empty())), pIdx(bodyP))

def parseFlatMap(file: String, tokens: List, expr: Expr, i: Int): List =
  for {
    i1 = expectTok(tokens, i, "LParen")
    lamP = parseLambda(file, tokens, i1)
    i2 = expectTok(tokens, pIdx(lamP), "RParen")
    param = List.head(pAst(lamP))
    body = List.head(List.tail(pAst(lamP)))
  } yield parsePostfixRest(file, tokens, Expr.FlatMap(expr, param, body, coverSpan(exprSpan(expr), spanCover(file, tokens, i, i2))), i2)

def parseHandle(file: String, tokens: List, expr: Expr, i: Int): List =
  for {
    i1 = expectTok(tokens, i, "LParen")
    lamP = parseLambda(file, tokens, i1)
    i2 = expectTok(tokens, pIdx(lamP), "RParen")
    body = List.head(List.tail(pAst(lamP)))
  } yield parsePostfixRest(file, tokens, Expr.Handle(expr, body, coverSpan(exprSpan(expr), spanCover(file, tokens, i, i2))), i2)

def parseAttempt(file: String, tokens: List, expr: Expr, i: Int): List =
  if (isTok(tokens, i, "LParen") == 1) parseAttemptParen(file, tokens, expr, i + 1) else parsePostfixRest(file, tokens, Expr.Attempt(expr, coverSpan(exprSpan(expr), tokSpan(file, tokAt(tokens, i - 1)))), i)

def parseAttemptParen(file: String, tokens: List, expr: Expr, i: Int): List =
  for {
    i1 = expectTok(tokens, i, "RParen")
  } yield parsePostfixRest(file, tokens, Expr.Attempt(expr, coverSpan(exprSpan(expr), tokSpan(file, tokAt(tokens, i1 - 1)))), i1)

def parsePrimary(file: String, tokens: List, i: Int): List =
  for {
    tok = tokAt(tokens, i)
    t = tokKind(tok)
  } yield if (streq(t, "For") == 1) parseFor(file, tokens, i + 1, i) else if (streq(t, "If") == 1) parseIf(file, tokens, i + 1, i) else if (streq(t, "LParen") == 1) parseParen(file, tokens, i + 1, i) else if (isIntTok(tok) == 1) okExpr(Expr.IntLit(intDigits(tok), tokSpan(file, tok)), i + 1) else if (isStringTok(tok) == 1) okExpr(Expr.StrLit(stringVal(tok), tokSpan(file, tok)), i + 1) else if (streq(t, "InterpStart") == 1) parseInterp(file, tokens, i + 1, List.empty(), i) else if (streq(t, "LBracket") == 1) parseListLit(file, tokens, i + 1) else if (streq(t, "Minus") == 1) parseNegInt(file, tokens, i + 1, i) else if (streq(t, "Underscore") == 1) if (isTok(tokens, i + 1, "Arrow") == 1) parseLambdaExpr(file, tokens, i + 1, "_", i) else okExpr(unitAt(file, tokens, i), i + 1) else if (isIdentTok(tok) == 1) parsePrimaryIdent(file, tokens, i, tok) else okExpr(unitAt(file, tokens, i), i)

def parseBinderName(file: String, tokens: List, i: Int): List =
  if (isTok(tokens, i, "Underscore") == 1) okStr("_", i + 1) else parseIdent(file, tokens, i)

def parseFor(file: String, tokens: List, i: Int, startI: Int): List =
  for {
    i1 = expectTok(tokens, i, "LBrace")
    bindersP = parseForBinders(file, tokens, i1, List.empty())
    i2 = expectTok(tokens, pIdx(bindersP), "RBrace")
    i3 = expectTok(tokens, i2, "Yield")
    bodyP = parseExpr(file, tokens, i3)
  } yield okExpr(Expr.For(pAst(bindersP), pExpr(bodyP), spanCover(file, tokens, startI, pIdx(bodyP))), pIdx(bodyP))

def parseForBinders(file: String, tokens: List, i: Int, acc: List): List =
  if (isTok(tokens, i, "RBrace") == 1) ok(List.reverse(acc), i) else if (isTok(tokens, i, "Yield") == 1) ok(List.reverse(acc), i) else parseForBinder(file, tokens, i, acc)

def parseForBinder(file: String, tokens: List, i: Int, acc: List): List =
  for {
    nameP = parseBinderName(file, tokens, i)
  } yield if (isTok(tokens, pIdx(nameP), "Eq") == 1) parseForBinderEq(file, tokens, pIdx(nameP) + 1, pStr(nameP), acc) else if (isTok(tokens, pIdx(nameP), "LeftArrow") == 1) parseForBinderDraw(file, tokens, pIdx(nameP) + 1, pStr(nameP), acc) else ok(List.reverse(acc), pIdx(nameP))

def parseForBinderEq(file: String, tokens: List, i: Int, name: String, acc: List): List =
  for {
    valueP = parseExpr(file, tokens, i)
  } yield parseForBinders(file, tokens, pIdx(valueP), List.cons(ForBinder.Eq(name, pExpr(valueP)), acc))

def parseForBinderDraw(file: String, tokens: List, i: Int, name: String, acc: List): List =
  for {
    valueP = parseExpr(file, tokens, i)
  } yield parseForBinders(file, tokens, pIdx(valueP), List.cons(ForBinder.Draw(name, pExpr(valueP)), acc))

def parseInterp(file: String, tokens: List, i: Int, acc: List, startI: Int): List =
  for {
    tok = tokAt(tokens, i)
    t = tokKind(tok)
  } yield if (streq(t, "InterpEnd") == 1) okExpr(Expr.Interp(List.reverse(acc), spanCover(file, tokens, startI, i + 1)), i + 1) else if (isInterpLitTok(tok) == 1) parseInterp(file, tokens, i + 1, List.cons(InterpPart.Lit(interpLitVal(tok)), acc), startI) else if (isInterpIdTok(tok) == 1) parseInterp(file, tokens, i + 1, List.cons(InterpPart.Hole(Expr.Var(interpIdVal(tok), tokSpan(file, tok))), acc), startI) else if (isInterpBraceTok(tok) == 1) parseInterpBrace(file, tokens, i, acc, interpBraceVal(tok), startI) else okExpr(Expr.Interp(List.reverse(acc), spanCover(file, tokens, startI, i)), i)

def parseInterpBrace(file: String, tokens: List, i: Int, acc: List, body: String, startI: Int): List =
  for {
    nested = parseExpr(file, lex(body), 0)
  } yield parseInterp(file, tokens, i + 1, List.cons(InterpPart.Hole(pExpr(nested)), acc), startI)

def parsePrimaryIdent(file: String, tokens: List, i: Int, tok: Tok): List =
  if (isTok(tokens, i + 1, "Arrow") == 1) parseLambdaExpr(file, tokens, i + 1, identName(tok), i) else parseIdentExpr(file, tokens, i, identName(tok))

def parseLambdaExpr(file: String, tokens: List, i: Int, param: String, startI: Int): List =
  for {
    i1 = expectTok(tokens, i, "Arrow")
    bodyP = parseBlock(file, tokens, i1)
  } yield okExpr(Expr.Lambda(param, pExpr(bodyP), spanCover(file, tokens, startI, pIdx(bodyP))), pIdx(bodyP))

def parseNegInt(file: String, tokens: List, i: Int, startI: Int): List =
  for {
    tok = tokAt(tokens, i)
  } yield if (isIntTok(tok) == 1) okExpr(Expr.IntLit(Str.concat("-", intDigits(tok)), spanCover(file, tokens, startI, i + 1)), i + 1) else okExpr(unitAt(file, tokens, startI), i)

def parseParen(file: String, tokens: List, i: Int, startI: Int): List =
  if (isTok(tokens, i, "RParen") == 1) okExpr(Expr.Unit(spanCover(file, tokens, startI, i + 1)), i + 1) else parseParenExpr(file, tokens, i)

def parseParenExpr(file: String, tokens: List, i: Int): List =
  for {
    e = parseExpr(file, tokens, i)
    i1 = expectTok(tokens, pIdx(e), "RParen")
  } yield okExpr(pExpr(e), i1)

def parseIf(file: String, tokens: List, i: Int, startI: Int): List =
  for {
    i1 = expectTok(tokens, i, "LParen")
    condP = parseExpr(file, tokens, i1)
    i2 = expectTok(tokens, pIdx(condP), "RParen")
    thenP = parseIfBranch(file, tokens, i2)
    i3 = expectTok(tokens, pIdx(thenP), "Else")
    elseP = parseIfBranch(file, tokens, i3)
  } yield okExpr(Expr.If(pExpr(condP), pExpr(thenP), pExpr(elseP), spanCover(file, tokens, startI, pIdx(elseP))), pIdx(elseP))

def parseIfBranch(file: String, tokens: List, i: Int): List =
  parseExpr(file, tokens, i)

def parseIdentExpr(file: String, tokens: List, i: Int, name: String): List =
  if (streq(name, "IO") == 1) parseIo(file, tokens, i + 1, i) else if (streq(name, "Str") == 1) parseModuleCall(file, tokens, i + 1, "Str", i) else if (streq(name, "List") == 1) parseModuleCall(file, tokens, i + 1, "List", i) else if (streq(name, "Fs") == 1) parseModuleCall(file, tokens, i + 1, "Fs", i) else if (streq(name, "Sys") == 1) parseModuleCall(file, tokens, i + 1, "Sys", i) else if (streq(name, "Clock") == 1) parseModuleCall(file, tokens, i + 1, "Clock", i) else if (streq(name, "Random") == 1) parseModuleCall(file, tokens, i + 1, "Random", i) else if (streq(name, "Net") == 1) parseModuleCall(file, tokens, i + 1, "Net", i) else if (streq(name, "Impurity") == 1) parseModuleCall(file, tokens, i + 1, "Impurity", i) else if (streq(name, "Ref") == 1) parseModuleCall(file, tokens, i + 1, "Ref", i) else if (streq(name, "Queue") == 1) parseModuleCall(file, tokens, i + 1, "Queue", i) else if (streq(name, "Deferred") == 1) parseModuleCall(file, tokens, i + 1, "Deferred", i) else if (streq(name, "Resource") == 1) parseModuleCall(file, tokens, i + 1, "Resource", i) else if (streq(name, "Stream") == 1) parseModuleCall(file, tokens, i + 1, "Stream", i) else if (streq(name, "Signal") == 1) parseModuleCall(file, tokens, i + 1, "Signal", i) else if (streq(name, "Theme") == 1) parseModuleCall(file, tokens, i + 1, "Theme", i) else if (streq(name, "View") == 1) parseModuleCall(file, tokens, i + 1, "View", i) else if (streq(name, "Ui") == 1) parseModuleCall(file, tokens, i + 1, "Ui", i) else if (streq(name, "Lexer") == 1) parseModuleCall(file, tokens, i + 1, "Lexer", i) else parseCallOrVar(file, tokens, i + 1, name, i)

def parseCallOrVar(file: String, tokens: List, i: Int, name: String, startI: Int): List =
  if (isTok(tokens, i, "LParen") == 1) parseCallArgs(file, tokens, i + 1, name, startI) else if (isTok(tokens, i, "Dot") == 1) parseDotCallOrAdt(file, tokens, i + 1, name, startI) else okExpr(Expr.Var(name, tokSpan(file, tokAt(tokens, startI))), i)

def parseCallArgs(file: String, tokens: List, i: Int, callee: String, startI: Int): List =
  for {
    argsP = parseArgs(file, tokens, i, List.empty())
    i1 = expectTok(tokens, pIdx(argsP), "RParen")
  } yield okExpr(Expr.Call(callee, pAst(argsP), spanCover(file, tokens, startI, i1)), i1)

def parseModuleCall(file: String, tokens: List, i: Int, mod: String, startI: Int): List =
  for {
    i1 = expectTok(tokens, i, "Dot")
    methodP = parseIdent(file, tokens, i1)
    callee = str3(mod, ".", pStr(methodP))
    i2 = pIdx(methodP)
  } yield if (isTok(tokens, i2, "LParen") == 1) parseModuleCallArgs(file, tokens, i2 + 1, mod, callee, startI) else okExpr(Expr.Call(callee, List.empty(), spanCover(file, tokens, startI, i2)), i2)

def parseModuleCallArgs(file: String, tokens: List, i: Int, mod: String, callee: String, startI: Int): List =
  if (streq(mod, "IO") == 1) parseIoArgs(file, tokens, i, callee, startI) else parseCallArgs(file, tokens, i, callee, startI)

def parseIo(file: String, tokens: List, i: Int, startI: Int): List =
  for {
    i1 = expectTok(tokens, i, "Dot")
    methodP = parseIdent(file, tokens, i1)
    method = pStr(methodP)
    i2 = pIdx(methodP)
  } yield if (streq(method, "delay") == 1) parseIoDelay(file, tokens, i2, startI) else if (isTok(tokens, i2, "LParen") == 1) parseIoArgs(file, tokens, i2 + 1, Str.concat("IO.", method), startI) else okExpr(Expr.Call(Str.concat("IO.", method), List.empty(), spanCover(file, tokens, startI, i2)), i2)

def parseIoDelay(file: String, tokens: List, i: Int, startI: Int): List =
  for {
    i1 = expectTok(tokens, i, "LParen")
    i2 = expectTok(tokens, i1, "LParen")
    i3 = expectTok(tokens, i2, "RParen")
    i4 = expectTok(tokens, i3, "Arrow")
    i5 = expectTok(tokens, i4, "LParen")
    i6 = expectTok(tokens, i5, "RParen")
    i7 = expectTok(tokens, i6, "RParen")
  } yield okExpr(Expr.Delay(spanCover(file, tokens, startI, i7)), i7)

def parseIoArgs(file: String, tokens: List, i: Int, callee: String, startI: Int): List =
  for {
    argsP = parseArgs(file, tokens, i, List.empty())
    i1 = expectTok(tokens, pIdx(argsP), "RParen")
    args = pAst(argsP)
    sp = spanCover(file, tokens, startI, i1)
  } yield if (streq(callee, "IO.println") == 1) okExpr(Expr.Println(List.head(args), sp), i1) else if (streq(callee, "IO.fail") == 1) okExpr(Expr.Fail(List.head(args), sp), i1) else if (streq(callee, "IO.pure") == 1) okExpr(Expr.Pure(List.head(args), sp), i1) else if (streq(callee, "IO.sleep") == 1) okExpr(Expr.Sleep(List.head(args), sp), i1) else if (streq(callee, "IO.race") == 1) okExpr(Expr.IoRace(List.head(args), List.head(List.tail(args)), sp), i1) else if (streq(callee, "IO.both") == 1) okExpr(Expr.IoBoth(List.head(args), List.head(List.tail(args)), sp), i1) else if (streq(callee, "IO.ensure") == 1) okExpr(Expr.IoEnsure(List.head(args), List.head(List.tail(args)), sp), i1) else okExpr(Expr.Call(callee, args, sp), i1)

def parseDef(file: String, tokens: List, i: Int, isPrivate: Int): List =
  for {
    nameP = parseIdent(file, tokens, i)
    i0 = pIdx(nameP)
  } yield if (isTok(tokens, i0, "LBracket") == 1) parseDefWithTParams(file, tokens, i0 + 1, pStr(nameP), isPrivate) else parseDefAfterName(file, tokens, i0, pStr(nameP), isPrivate, List.empty())

def parseTypeParams(file: String, tokens: List, i: Int, acc: List): List =
  for {
    nameP = parseIdent(file, tokens, i)
    i1 = pIdx(nameP)
  } yield if (isTok(tokens, i1, "Comma") == 1) parseTypeParams(file, tokens, i1 + 1, List.cons(pStr(nameP), acc)) else parseTypeParamsEnd(file, tokens, i1, List.cons(pStr(nameP), acc))

def parseTypeParamsEnd(file: String, tokens: List, i: Int, acc: List): List =
  for {
    i1 = expectTok(tokens, i, "RBracket")
  } yield ok(List.reverse(acc), i1)

def parseDefWithTParams(file: String, tokens: List, i: Int, name: String, isPrivate: Int): List =
  for {
    tp = parseTypeParams(file, tokens, i, List.empty())
    tparams = pAst(tp)
  } yield if (List.isEmpty(tparams) == 1) parseDefAfterName(file, tokens, pIdx(tp), name, isPrivate, List.empty()) else parseDefAfterName(file, tokens, pIdx(tp), name, isPrivate, tparams)

def parseDefAfterName(file: String, tokens: List, i: Int, name: String, isPrivate: Int, tparams: List): List =
  for {
    i1 = expectTok(tokens, i, "LParen")
    paramsP = parseParamsWith(file, tokens, i1, List.empty(), tparams)
    i2 = expectTok(tokens, pIdx(paramsP), "RParen")
    i3 = expectTok(tokens, i2, "Colon")
    retP = parseTypeWith(file, tokens, i3, tparams)
    i4 = expectTok(tokens, pIdx(retP), "Eq")
    bodyP = parseBlock(file, tokens, i4)
  } yield okDef(Def.Def(name, pAst(paramsP), pType(retP), pExpr(bodyP), moduleIdFromLabel(file), isPrivate, tparams), pIdx(bodyP))

def parseMain(file: String, tokens: List, i: Int): List =
  for {
    i1 = expectTok(tokens, i, "Def")
    nameP = parseIdent(file, tokens, i1)
    i2 = expectTok(tokens, pIdx(nameP), "Colon")
    tyP = parseType(file, tokens, i2)
    i3 = expectTok(tokens, pIdx(tyP), "Eq")
  } yield parseBlock(file, tokens, i3)

def parseTop(file: String, tokens: List, i: Int, pkg: String, enums: List, traits: List, impls: List, defs: List, main: Expr, mainMod: String, imports: List): Prog =
  for {
    t = tokKind(tokAt(tokens, i))
  } yield if (streq(t, "Eof") == 1) Prog.Prog(pkg, List.reverse(enums), List.reverse(defs), main, mainMod, List.reverse(imports), List.reverse(traits), List.reverse(impls)) else if (streq(t, "Enum") == 1) parseTopEnum(file, tokens, i + 1, pkg, enums, traits, impls, defs, main, mainMod, imports) else if (streq(t, "Record") == 1) parseTopRecord(file, tokens, i + 1, pkg, enums, traits, impls, defs, main, mainMod, imports) else if (streq(t, "Trait") == 1) parseTopTrait(file, tokens, i + 1, pkg, enums, traits, impls, defs, main, mainMod, imports) else if (streq(t, "Impl") == 1) parseTopImpl(file, tokens, i + 1, pkg, enums, traits, impls, defs, main, mainMod, imports) else if (streq(t, "Import") == 1) parseTopImport(file, tokens, i + 1, pkg, enums, traits, impls, defs, main, mainMod, imports) else if (streq(t, "Private") == 1) parseTopPrivateDef(file, tokens, i + 1, pkg, enums, traits, impls, defs, main, mainMod, imports) else if (streq(t, "Def") == 1) parseTopDef(file, tokens, i + 1, pkg, enums, traits, impls, defs, main, mainMod, imports) else if (streq(t, "AtMain") == 1) parseTopMain(file, tokens, i + 1, pkg, enums, traits, impls, defs, imports) else parseTop(file, tokens, i + 1, pkg, enums, traits, impls, defs, main, mainMod, imports)

def parseEnum(file: String, tokens: List, i: Int): List =
  for {
    nameP = parseIdent(file, tokens, i)
    i1 = pIdx(nameP)
  } yield if (isTok(tokens, i1, "LBracket") == 1) parseEnumTParams(file, tokens, i1 + 1, pStr(nameP)) else parseEnumBody(file, tokens, i1, pStr(nameP), List.empty())

def parseEnumTParams(file: String, tokens: List, i: Int, name: String): List =
  for {
    tp = parseTypeParams(file, tokens, i, List.empty())
  } yield parseEnumBody(file, tokens, pIdx(tp), name, pAst(tp))

def parseEnumBody(file: String, tokens: List, i: Int, name: String, tparams: List): List =
  if (isTok(tokens, i, "LBrace") == 1) parseEnumBrace(file, tokens, i + 1, name, tparams, List.empty()) else if (isTok(tokens, i, "Colon") == 1) parseEnumColon(file, tokens, i + 1, name, tparams, List.empty()) else okEnum(EnumDef.Enum(moduleIdFromLabel(file), name, List.empty(), tparams), i)

def parseEnumBrace(file: String, tokens: List, i: Int, name: String, tparams: List, acc: List): List =
  if (isTok(tokens, i, "RBrace") == 1) okEnum(EnumDef.Enum(moduleIdFromLabel(file), name, List.reverse(acc), tparams), i + 1) else parseEnumBraceCase(file, tokens, i, name, tparams, acc)

def parseEnumBraceCase(file: String, tokens: List, i: Int, name: String, tparams: List, acc: List): List =
  for {
    i1 = expectTok(tokens, i, "Case")
    caseP = parseIdent(file, tokens, i1)
    fieldsP = parseEnumCaseFields(file, tokens, pIdx(caseP), tparams)
    i2 = pIdx(fieldsP)
    acc2 = List.cons(EnumCase.Case(pStr(caseP), pAst(fieldsP)), acc)
  } yield if (isTok(tokens, i2, "Comma") == 1) parseEnumBrace(file, tokens, i2 + 1, name, tparams, acc2) else parseEnumBrace(file, tokens, i2, name, tparams, acc2)

def parseEnumColon(file: String, tokens: List, i: Int, name: String, tparams: List, acc: List): List =
  if (isTok(tokens, i, "Case") == 0) okEnum(EnumDef.Enum(moduleIdFromLabel(file), name, List.reverse(acc), tparams), i) else parseEnumColonCase(file, tokens, i + 1, name, tparams, acc)

def parseEnumColonCase(file: String, tokens: List, i: Int, name: String, tparams: List, acc: List): List =
  for {
    caseP = parseIdent(file, tokens, i)
    fieldsP = parseEnumCaseFields(file, tokens, pIdx(caseP), tparams)
  } yield parseEnumColon(file, tokens, pIdx(fieldsP), name, tparams, List.cons(EnumCase.Case(pStr(caseP), pAst(fieldsP)), acc))

def parseEnumCaseFields(file: String, tokens: List, i: Int, tparams: List): List =
  if (isTok(tokens, i, "LParen") == 0) ok(List.empty(), i) else parseEnumCaseFieldsAcc(file, tokens, i + 1, List.empty(), tparams)

def parseEnumCaseFieldsAcc(file: String, tokens: List, i: Int, acc: List, tparams: List): List =
  if (isTok(tokens, i, "RParen") == 1) ok(List.reverse(acc), i + 1) else parseEnumCaseFieldCont(file, tokens, i, acc, tparams)

def parseEnumCaseFieldCont(file: String, tokens: List, i: Int, acc: List, tparams: List): List =
  for {
    fnameP = parseIdent(file, tokens, i)
    i1 = expectTok(tokens, pIdx(fnameP), "Colon")
    tyP = parseTypeWith(file, tokens, i1, tparams)
    acc2 = List.cons(EnumField.Field(pStr(fnameP), pType(tyP)), acc)
    j = pIdx(tyP)
  } yield if (isTok(tokens, j, "Comma") == 1) parseEnumCaseFieldsAcc(file, tokens, j + 1, acc2, tparams) else parseEnumCaseFieldsEnd(file, tokens, j, acc2)

def parseEnumCaseFieldsEnd(file: String, tokens: List, i: Int, acc: List): List =
  for {
    i1 = expectTok(tokens, i, "RParen")
  } yield ok(List.reverse(acc), i1)

def parseTopEnum(file: String, tokens: List, i: Int, pkg: String, enums: List, traits: List, impls: List, defs: List, main: Expr, mainMod: String, imports: List): Prog =
  for {
    e = parseEnum(file, tokens, i)
  } yield parseTop(file, tokens, pIdx(e), pkg, List.cons(pEnum(e), enums), traits, impls, defs, main, mainMod, imports)

def parseTopRecord(file: String, tokens: List, i: Int, pkg: String, enums: List, traits: List, impls: List, defs: List, main: Expr, mainMod: String, imports: List): Prog =
  for {
    e = parseRecord(file, tokens, i)
  } yield parseTop(file, tokens, pIdx(e), pkg, List.cons(pEnum(e), enums), traits, impls, defs, main, mainMod, imports)

def parseRecord(file: String, tokens: List, i: Int): List =
  for {
    nameP = parseIdent(file, tokens, i)
    i1 = pIdx(nameP)
  } yield if (isTok(tokens, i1, "LBracket") == 1) parseRecordTParams(file, tokens, i1 + 1, pStr(nameP)) else parseRecordBody(file, tokens, i1, pStr(nameP), List.empty())

def parseRecordTParams(file: String, tokens: List, i: Int, name: String): List =
  for {
    tp = parseTypeParams(file, tokens, i, List.empty())
  } yield parseRecordBody(file, tokens, pIdx(tp), name, pAst(tp))

def parseRecordBody(file: String, tokens: List, i: Int, name: String, tparams: List): List =
  for {
    i1 = expectTok(tokens, i, "LParen")
    fieldsP = parseEnumCaseFieldsAcc(file, tokens, i1, List.empty(), tparams)
  } yield okEnum(EnumDef.Record(moduleIdFromLabel(file), name, pAst(fieldsP), tparams), pIdx(fieldsP))

def parseTopTrait(file: String, tokens: List, i: Int, pkg: String, enums: List, traits: List, impls: List, defs: List, main: Expr, mainMod: String, imports: List): Prog =
  for {
    t = parseTrait(file, tokens, i)
  } yield parseTop(file, tokens, pIdx(t), pkg, enums, List.cons(pTrait(t), traits), impls, defs, main, mainMod, imports)

def okTrait(t: TraitDef, i: Int): List =
  List.cons(t, List.cons(Str.fromInt(i), List.empty()))

def pTrait(p: List): TraitDef =
  List.head(p)

def parseTrait(file: String, tokens: List, i: Int): List =
  for {
    nameP = parseIdent(file, tokens, i)
    i1 = expectTok(tokens, pIdx(nameP), "Colon")
    methodsP = parseTraitMethods(file, tokens, i1, List.empty())
  } yield okTrait(TraitDef.Trait(moduleIdFromLabel(file), pStr(nameP), pAst(methodsP)), pIdx(methodsP))

def parseTraitMethods(file: String, tokens: List, i: Int, acc: List): List =
  if (isTok(tokens, i, "Def") == 0) ok(List.reverse(acc), i) else parseTraitMethodCont(file, tokens, i, acc)

def parseTraitMethodCont(file: String, tokens: List, i: Int, acc: List): List =
  for {
    i1 = expectTok(tokens, i, "Def")
    nameP = parseIdent(file, tokens, i1)
    i2 = expectTok(tokens, pIdx(nameP), "LParen")
    paramsP = parseParams(file, tokens, i2, List.empty())
    i3 = expectTok(tokens, pIdx(paramsP), "RParen")
    i4 = expectTok(tokens, i3, "Colon")
    retP = parseType(file, tokens, i4)
    m = TraitMethod.Method(pStr(nameP), pAst(paramsP), pType(retP))
  } yield parseTraitMethods(file, tokens, pIdx(retP), List.cons(m, acc))

def parseTopImpl(file: String, tokens: List, i: Int, pkg: String, enums: List, traits: List, impls: List, defs: List, main: Expr, mainMod: String, imports: List): Prog =
  for {
    traitP = parseIdent(file, tokens, i)
    i1 = expectTok(tokens, pIdx(traitP), "For")
    forP = parseIdent(file, tokens, i1)
    i2 = expectTok(tokens, pIdx(forP), "Colon")
    methodsP = parseImplMethods(file, tokens, i2, List.empty())
    im = ImplDef.Impl(moduleIdFromLabel(file), pStr(traitP), pStr(forP), pAst(methodsP))
  } yield parseTop(file, tokens, pIdx(methodsP), pkg, enums, traits, List.cons(im, impls), defs, main, mainMod, imports)

def parseImplMethods(file: String, tokens: List, i: Int, acc: List): List =
  if (isTok(tokens, i, "Def") == 0) ok(List.reverse(acc), i) else parseImplMethodCont(file, tokens, i, acc)

def parseImplMethodCont(file: String, tokens: List, i: Int, acc: List): List =
  for {
    i1 = expectTok(tokens, i, "Def")
    nameP = parseIdent(file, tokens, i1)
    i2 = expectTok(tokens, pIdx(nameP), "LParen")
    paramsP = parseParams(file, tokens, i2, List.empty())
    i3 = expectTok(tokens, pIdx(paramsP), "RParen")
    i4 = expectTok(tokens, i3, "Colon")
    retP = parseType(file, tokens, i4)
    i5 = expectTok(tokens, pIdx(retP), "Eq")
    bodyP = parseBlock(file, tokens, i5)
    m = ImplMethod.Method(pStr(nameP), pAst(paramsP), pType(retP), pExpr(bodyP))
  } yield parseImplMethods(file, tokens, pIdx(bodyP), List.cons(m, acc))

def implMethodName(traitName: String, forType: String, method: String): String =
  str3("__impl_", traitName, str3("_", forType, str3("_", method, "")))

def parseTopDef(file: String, tokens: List, i: Int, pkg: String, enums: List, traits: List, impls: List, defs: List, main: Expr, mainMod: String, imports: List): Prog =
  for {
    d = parseDef(file, tokens, i, 0)
  } yield parseTop(file, tokens, pIdx(d), pkg, enums, traits, impls, List.cons(pDef(d), defs), main, mainMod, imports)

def parseTopPrivateDef(file: String, tokens: List, i: Int, pkg: String, enums: List, traits: List, impls: List, defs: List, main: Expr, mainMod: String, imports: List): Prog =
  for {
    i1 = expectTok(tokens, i, "Def")
    d = parseDef(file, tokens, i1, 1)
  } yield parseTop(file, tokens, pIdx(d), pkg, enums, traits, impls, List.cons(pDef(d), defs), main, mainMod, imports)

def parseTopImport(file: String, tokens: List, i: Int, pkg: String, enums: List, traits: List, impls: List, defs: List, main: Expr, mainMod: String, imports: List): Prog =
  for {
    fromP = parseIdent(file, tokens, i)
    i1 = expectTok(tokens, pIdx(fromP), "Dot")
    nameP = parseIdent(file, tokens, i1)
    im = Import.Import(moduleIdFromLabel(file), pStr(fromP), pStr(nameP))
  } yield parseTop(file, tokens, pIdx(nameP), pkg, enums, traits, impls, defs, main, mainMod, List.cons(im, imports))

def parseTopMain(file: String, tokens: List, i: Int, pkg: String, enums: List, traits: List, impls: List, defs: List, imports: List): Prog =
  for {
    m = parseMain(file, tokens, i)
  } yield parseTop(file, tokens, pIdx(m), pkg, enums, traits, impls, defs, pExpr(m), moduleIdFromLabel(file), imports)

def parseProgram(tokens: List, file: String): Prog =
  for {
    pkgP = parsePackage(file, tokens, 0)
  } yield parseTop(file, tokens, pIdx(pkgP), pStr(pkgP), List.empty(), List.empty(), List.empty(), List.empty(), unitExpr(), "", List.empty())

