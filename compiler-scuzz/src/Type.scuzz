package scuzz.compiler

enum Type:
  case Unit
  case Int
  case String
  case Bool
  case List
  case Io(inner: Type)
  case Adt(name: String)
  case App(name: String, args: List)
  case Var(name: String)
  case Opaque(name: String)

enum TyBind:
  case Bind(name: String, ty: Type)

enum TyRes:
  case Ok(ty: Type)
  case Err(msg: String)
  case At(file: String, start: Int, end: Int, msg: String)

def tyShow(t: Type): String =
  t match {
    case Type.Unit => "Unit"
    case Type.Int => "Int"
    case Type.String => "String"
    case Type.Bool => "Bool"
    case Type.List => "List"
    case Type.Io(inner) => str3("IO[", tyShow(inner), "]")
    case Type.Adt(name) => Str.concat("Adt:", name)
    case Type.App(name, args) => str4("App:", name, "[", tyShowArgs(args))
    case Type.Var(name) => Str.concat("Var:", name)
    case Type.Opaque(name) => Str.concat("Opaque:", name)
  }

def tyShowArgs(args: List): String =
  if (List.isEmpty(args) == 1) "]" else Str.concat(tyShow(List.head(args)), tyShowArgsCont(List.tail(args)))

def tyShowArgsCont(rest: List): String =
  if (List.isEmpty(rest) == 1) "]" else str3(",", tyShow(List.head(rest)), tyShowArgsCont(List.tail(rest)))

def tyPretty(t: Type): String =
  t match {
    case Type.Unit => "Unit"
    case Type.Int => "Int"
    case Type.String => "String"
    case Type.Bool => "Bool"
    case Type.List => "List"
    case Type.Io(inner) => str3("IO[", tyPretty(inner), "]")
    case Type.Adt(name) => name
    case Type.App(name, args) => str3(name, "[", tyPrettyArgs(args))
    case Type.Var(name) => name
    case Type.Opaque(name) => name
  }

def tyPrettyArgs(args: List): String =
  if (List.isEmpty(args) == 1) "]" else Str.concat(tyPretty(List.head(args)), tyPrettyArgsCont(List.tail(args)))

def tyPrettyArgsCont(rest: List): String =
  if (List.isEmpty(rest) == 1) "]" else str3(", ", tyPretty(List.head(rest)), tyPrettyArgsCont(List.tail(rest)))

def tyEq(a: Type, b: Type): Int =
  a match {
    case Type.Unit => tyEqUnit(b)
    case Type.Int => tyEqInt(b)
    case Type.String => tyEqString(b)
    case Type.Bool => tyEqBool(b)
    case Type.List => tyEqList(b)
    case Type.Io(ia) => tyEqIo(ia, b)
    case Type.Adt(na) => tyEqAdt(na, b)
    case Type.App(na, aa) => tyEqApp(na, aa, b)
    case Type.Var(na) => tyEqVar(na, b)
    case Type.Opaque(na) => tyEqOpaque(na, b)
  }

def tyEqApp(na: String, aa: List, b: Type): Int =
  b match {
    case Type.App(nb, ab) => if (streq(na, nb) == 1) tyEqArgs(aa, ab) else 0
    case _ => 0
  }

def tyEqArgs(aa: List, ab: List): Int =
  if (List.isEmpty(aa) == 1) List.isEmpty(ab) else tyEqArgsCont(aa, ab)

def tyEqArgsCont(aa: List, ab: List): Int =
  if (List.isEmpty(ab) == 1) 0 else if (tyEq(List.head(aa), List.head(ab)) == 1) tyEqArgs(List.tail(aa), List.tail(ab)) else 0

def tyEqUnit(b: Type): Int =
  b match {
    case Type.Unit => 1
    case _ => 0
  }

def tyEqInt(b: Type): Int =
  b match {
    case Type.Int => 1
    case _ => 0
  }

def tyEqString(b: Type): Int =
  b match {
    case Type.String => 1
    case _ => 0
  }

def tyEqBool(b: Type): Int =
  b match {
    case Type.Bool => 1
    case _ => 0
  }

def tyEqList(b: Type): Int =
  b match {
    case Type.List => 1
    case _ => 0
  }

def tyEqIo(ia: Type, b: Type): Int =
  b match {
    case Type.Io(ib) => tyEq(ia, ib)
    case _ => 0
  }

def tyEqAdt(na: String, b: Type): Int =
  b match {
    case Type.Adt(nb) => streq(na, nb)
    case _ => 0
  }

def tyEqOpaque(na: String, b: Type): Int =
  b match {
    case Type.Opaque(nb) => streq(na, nb)
    case _ => 0
  }

def tyEqVar(na: String, b: Type): Int =
  b match {
    case Type.Var(nb) => streq(na, nb)
    case _ => 0
  }

def typesCompat(a: Type, b: Type): Int =
  if (tyEq(a, b) == 1) 1 else if (tyIsOpaque(a) == 1) 1 else if (tyIsOpaque(b) == 1) 1 else typesCompatCont(a, b)

def typesCompatCont(a: Type, b: Type): Int =
  a match {
    case Type.Bool => typesCompatBool(b)
    case Type.Int => typesCompatInt(b)
    case Type.Io(ia) => typesCompatIo(b)
    case Type.App(na, aa) => typesCompatApp(na, aa, b)
    case _ => 0
  }

def typesCompatApp(na: String, aa: List, b: Type): Int =
  b match {
    case Type.App(nb, ab) => if (streq(na, nb) == 1) typesCompatArgs(aa, ab) else 0
    case _ => 0
  }

def typesCompatArgs(aa: List, ab: List): Int =
  if (List.isEmpty(aa) == 1) List.isEmpty(ab) else typesCompatArgsCont(aa, ab)

def typesCompatArgsCont(aa: List, ab: List): Int =
  if (List.isEmpty(ab) == 1) 0 else if (typesCompat(List.head(aa), List.head(ab)) == 1) typesCompatArgs(List.tail(aa), List.tail(ab)) else 0

def typesCompatBool(b: Type): Int =
  b match {
    case Type.Int => 1
    case _ => 0
  }

def typesCompatInt(b: Type): Int =
  b match {
    case Type.Bool => 1
    case _ => 0
  }

def typesCompatIo(b: Type): Int =
  b match {
    case Type.Io(ib) => 1
    case _ => 0
  }

def tyIsIo(t: Type): Int =
  t match {
    case Type.Io(inner) => 1
    case _ => 0
  }

def tyIoInner(t: Type): Type =
  t match {
    case Type.Io(inner) => inner
    case _ => t
  }

def tyMkIo(inner: Type): Type =
  Type.Io(inner)

def tyIsAdt(t: Type): Int =
  t match {
    case Type.Adt(name) => 1
    case _ => 0
  }

def tyAdtName(t: Type): String =
  t match {
    case Type.Adt(name) => name
    case _ => ""
  }

def tyMkAdt(name: String): Type =
  Type.Adt(name)

def tyIsApp(t: Type): Int =
  t match {
    case Type.App(name, args) => 1
    case _ => 0
  }

def tyAppName(t: Type): String =
  t match {
    case Type.App(name, args) => name
    case _ => ""
  }

def tyAppArgs(t: Type): List =
  t match {
    case Type.App(name, args) => args
    case _ => List.empty()
  }

def tyMkApp(name: String, args: List): Type =
  Type.App(name, args)

def tyIsOpaque(t: Type): Int =
  t match {
    case Type.Opaque(name) => 1
    case _ => 0
  }

def tyMkOpaque(name: String): Type =
  Type.Opaque(name)

def tyIsVar(t: Type): Int =
  t match {
    case Type.Var(name) => 1
    case _ => 0
  }

def tyVarName(t: Type): String =
  t match {
    case Type.Var(name) => name
    case _ => ""
  }

def tyOpaqueName(t: Type): String =
  t match {
    case Type.Opaque(name) => name
    case _ => ""
  }

def tyMkVar(name: String): Type =
  Type.Var(name)

def tyOk(t: Type): TyRes =
  TyRes.Ok(t)

def tyErr(m: String): TyRes =
  TyRes.Err(m)

def tyErrAt(m: String, sp: Span): TyRes =
  TyRes.At(spanFile(sp), spanStart(sp), spanEnd(sp), m)

def tyIsOk(r: TyRes): Int =
  r match {
    case TyRes.Ok(ty) => 1
    case _ => 0
  }

def tyIsAt(r: TyRes): Int =
  r match {
    case TyRes.At(file, start, end, msg) => 1
    case _ => 0
  }

def tyVal(r: TyRes): Type =
  r match {
    case TyRes.Ok(ty) => ty
    case _ => Type.Unit
  }

def tyMsg(r: TyRes): String =
  r match {
    case TyRes.Err(msg) => msg
    case TyRes.At(file, start, end, msg) => msg
    case _ => ""
  }

def tyAtFile(r: TyRes): String =
  r match {
    case TyRes.At(file, start, end, msg) => file
    case _ => ""
  }

def tyAtStart(r: TyRes): Int =
  r match {
    case TyRes.At(file, start, end, msg) => start
    case _ => 0
  }

def tyAtEnd(r: TyRes): Int =
  r match {
    case TyRes.At(file, start, end, msg) => end
    case _ => 0
  }

def withSpanIfBare(r: TyRes, sp: Span): TyRes =
  r match {
    case TyRes.Err(msg) => tyErrAt(msg, sp)
    case _ => r
  }

def tySpanOf(r: TyRes): Span =
  r match {
    case TyRes.At(file, start, end, msg) => mkSpan(file, start, end)
    case _ => dummySpan()
  }

def tyEnvPut(env: List, name: String, ty: Type): List =
  List.cons(TyBind.Bind(name, ty), env)

def tyEnvGet(env: List, name: String): List =
  if (List.isEmpty(env) == 1) List.empty() else tyEnvGetCont(List.head(env), List.tail(env), name)

def tyEnvGetCont(b: TyBind, rest: List, name: String): List =
  b match {
    case TyBind.Bind(n, ty) => if (streq(n, name) == 1) List.cons(ty, List.empty()) else tyEnvGet(rest, name)
  }

