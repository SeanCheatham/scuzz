#!/usr/bin/env bash
# Check index contents for conflict markers and C compiler errors.
# Install with ./scripts/install-githooks.sh.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/scuzz-precommit.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
CHECKOUT="$WORK/index"
mkdir "$CHECKOUT"
git diff --cached --name-only --diff-filter=ACMR -z >"$WORK/paths"
[[ -s "$WORK/paths" ]] || exit 0
STAGED=()
while IFS= read -r -d '' path; do
  STAGED+=("$path")
done <"$WORK/paths"

git checkout-index --all --prefix="$CHECKOUT/"
CC="${CC:-clang}"
CFLAGS=(-std=c11 -Wall -Wextra -Werror -O2)
INCLUDES=(-Icrates/runtime/include -Icrates/ffi-skia/include
  -Icrates/embedder-desktop/include -Icrates/embedder-mobile/include)
platform="$(uname -s)"
if [[ "$platform" == Darwin ]] && command -v brew >/dev/null 2>&1; then
  ssl_prefix="$(brew --prefix openssl@3 2>/dev/null || true)"
  if [[ -n "$ssl_prefix" ]]; then INCLUDES+=("-I$ssl_prefix/include"); fi
fi

if [[ "$platform" == Linux ]] && command -v pkg-config >/dev/null 2>&1; then
  read -r -a DBUS_INCLUDES <<<"$(pkg-config --cflags dbus-1 2>/dev/null || true)"
  INCLUDES+=("${DBUS_INCLUDES[@]}")
fi

fail=0
for path in "${STAGED[@]}"; do
  [[ -f "$CHECKOUT/$path" ]] || continue
  if grep -qE '^(<<<<<<<|=======|>>>>>>>)' "$CHECKOUT/$path"; then
    echo "pre-commit: conflict markers in staged file: $path" >&2
    fail=1
  fi
  case "$path" in
    crates/runtime/src/*.c | crates/runtime/tests/*.c | \
    crates/ffi-skia/src/*.c | crates/ffi-skia/tests/*.c | \
    crates/embedder-desktop/src/*.c | crates/embedder-desktop/tests/*.c | \
    crates/embedder-mobile/src/*.c | crates/embedder-mobile/tests/*.c) ;;
    *) continue ;;
  esac
  # Check only translation units for the host platform.
  case "$path" in
    crates/embedder-desktop/src/x11_present.c | \
    crates/embedder-desktop/tests/test_headless.c | \
    crates/embedder-desktop/tests/test_idle_events.c | \
    crates/embedder-desktop/tests/test_resize.c | \
    crates/embedder-desktop/tests/test_motion.c)
      [[ "$platform" == Linux ]] || continue ;;
    crates/runtime/tests/test_net_apple.c)
      [[ "$platform" == Darwin ]] || continue ;;
  esac
  if ! command -v "$CC" >/dev/null 2>&1; then
    echo "pre-commit: $CC is required for staged C" >&2
    fail=1
    break
  fi
  ARGS=("${CFLAGS[@]}")
  if [[ "$path" == crates/ffi-skia/src/sk_gpu.c ]]; then
    ARGS+=(-Wno-deprecated-declarations)
  fi
  if ! (cd "$CHECKOUT" && "$CC" "${ARGS[@]}" "${INCLUDES[@]}" \
      -c "$path" -o "$WORK/check.o") 2>"$WORK/check.err"; then
    echo "pre-commit: $CC -Werror compile failed for staged source: $path" >&2
    cat "$WORK/check.err" >&2
    fail=1
  fi
done
if [[ "$fail" -ne 0 ]]; then
  echo "pre-commit: fix the reported files or use git commit --no-verify" >&2
  exit 1
fi
