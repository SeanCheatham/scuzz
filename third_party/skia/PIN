# Pinned sk_capi Skia CPU prebuilt (default UI backend).
# package_release.sh / fetch_skia.sh / ffi-skia Makefile fetch when url= is set.
# Opt out of Skia with SCUZZ_SKIA=sk_sw (in-tree sk_sw).
#
# Format: key=value lines
#   skia_branch=...   milestone used to build the assets
#   url=...           HTTPS (or file://) tarball; embed {triple} for host selection
#   hdr_url=...       Skia include/ tarball for the shim relink (release asset;
#                   platform-independent)
#
# {triple} is replaced with the host triple from scripts/skia_triple.sh
# (override with SCUZZ_SKIA_TRIPLE). Published triples from skia-cpu.yml:
#   x86_64-unknown-linux-gnu, aarch64-apple-darwin
skia_branch=chrome/m131
url=https://github.com/SeanCheatham/scuzz/releases/download/skia-cpu-v0.3/skia-{triple}-cpu.tar.gz
hdr_url=https://github.com/SeanCheatham/scuzz/releases/download/skia-cpu-v0.3/skia-include.tar.gz

