def fractionStaysValid(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "fraction") >= 0 && Timeline.signalInt(t, i, "fraction") <= 100)

def separatorMatchesFraction(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, Str.concat("split:Tools=", Str.fromInt(Timeline.signalInt(t, i, "fraction")))))

def collapsedPrimaryHasNoInput(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "fraction") != 0 == Timeline.a11yHas(t, i, "button:Add"))

def sizeLabelMatchesFraction(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, Str.concat("text:Primary size: ", Str.concat(Str.fromInt(Timeline.signalInt(t, i, "fraction")), "%"))))

def addChangesCount(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Add", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "count") == Timeline.signalInt(t, before, "count") + 1
})

def resetRestoresSize(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Reset panes", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "fraction") == 40
})

def startsWithBothPanes(t: Timeline): Verdict =
  Verdict.every(t, i => i != 0 || Timeline.signalInt(t, i, "fraction") == 40 && Timeline.signalInt(t, i, "count") == 0 && Timeline.a11yHas(t, i, "text:Tools") && Timeline.a11yHas(t, i, "text:Preview"))

def hideToolsCollapsesPrimary(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Hide tools", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "fraction") == 0
})

def hidePreviewCollapsesSecondary(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Hide preview", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "fraction") == 100
})

def countLabelMatchesValue(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "fraction") == 100 || Timeline.a11yHas(t, i, Str.concat("text:Count: ", Str.fromInt(Timeline.signalInt(t, i, "count")))))

