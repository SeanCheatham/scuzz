  steerFailed = steerBadErr == Result.Err("invalid steer store") || steerBadErr match {
  case Result.Ok(_) => false
  case Result.Err(e) => isSimFsFault(e)
}
  handleStatusesOk = unavail503._1 == 503 && (missAcc._1 == 200 && resultFirstStatus(missAcc._3) == "missing-card" || missAcc._1 == 503) && (retiredAcc._1 == 200 && resultFirstStatus(retiredAcc._3) == "missing-card" || retiredAcc._1 == 503) && (dupAcc._1 == 200 && resultFirstStatus(dupAcc._3) == "already-decided" || dupAcc._1 == 503) && (dupRej._1 == 200 && resultFirstStatus(dupRej._3) == "already-decided" || dupRej._1 == 503) && (snapOk._1 == 200 || snapOk._1 == 503) && (conflict409._1 == 409 || conflict409._1 == 503)
} yield parentFailed && rootFailed && optMiss == "" && optHit == "a0" && owned == [("src/A.scuzz", "a0"), ("src/B.scuzz", "b0")] && badOwnFailed && IdeSync.validHex(minted) && reusedTrim == minted && explicit == tok && badTokFailed && objEmpty == "" && objSet == "ship contracts" && List.isEmpty(dirtyEmpty) && dirtyOne == ["src/A.scuzz"] && dirtyFailed && List.isEmpty(steerEmpty) && steerFailed && List.len(steerLoaded) == 1 && !dec0 && decChoice && decAccept && handleStatusesOk))
  } yield traversalRejected && route404._1 == 404 && method405._1 == 405 && auth401._1 == 401 && badBody400._1 == 400 && ioChecks match {
  case Result.Ok(ok) => ok
  case Result.Err(e) => isSimFsFault(e)
}

private def faulted(t: Timeline, i: Int): Bool =
  Timeline.faultKindHas(t, i, "net") || Timeline.faultKindHas(t, i, "fs")

private def isUnauthorizedDrive(t: Timeline, i: Int): Bool =
  Timeline.driveHas(t, i, "unauthorizedMissing") || Timeline.driveHas(t, i, "unauthorizedWrongToken") || Timeline.driveHas(t, i, "unauthorizedScheme") || Timeline.driveHas(t, i, "invalidServerToken")

private def isRejectedDrive(t: Timeline, i: Int): Bool =
  isUnauthorizedDrive(t, i) || Timeline.driveHas(t, i, "wrongRoute") || Timeline.driveHas(t, i, "wrongMethod") || Timeline.driveHas(t, i, "malformedRequest")

def mainIdlePreservesWorkspaces(t: Timeline): Verdict =
  Verdict.every(t, i => for {
  main = i == 0
} yield !main || Timeline.fileTextIs(t, 0, "ws/src/Main.scuzz", "v0") && Timeline.fileTextIs(t, 0, "ws-dirty/src/Main.scuzz", "v0") && Timeline.fileTextIs(t, 0, "ws-rec/src/Main.scuzz", "beta") && Timeline.fileTextIs(t, 0, "ws-undo/src/Main.scuzz", "beta") && Timeline.fileTextIs(t, 0, "ws-conflict/src/Main.scuzz", "external-edit") && Timeline.fileTextIs(t, 0, "ws-token/.scuzz/ide/sync-token.txt", "") && !Timeline.effectHas(t, 0, "Net.httpGet") && !Timeline.effectHas(t, 0, "Net.httpPost"))

def sourceIntegrity(t: Timeline): Verdict =
