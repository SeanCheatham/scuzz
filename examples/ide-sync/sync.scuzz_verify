def acceptedNeverClobbered(t: Timeline): Verdict =
  Verdict.stepEvery(t, pair => pair match {
  case (a, b) => (!Timeline.fileTextIs(t, a, "ws/src/Main.scuzz", "alpha") || Timeline.fileTextIs(t, b, "ws/src/Main.scuzz", "alpha")) && (!Timeline.fileTextIs(t, a, "ws/src/Main.scuzz", "beta") || Timeline.fileTextIs(t, b, "ws/src/Main.scuzz", "beta"))
})

def rejectedPreservesWorkspace(t: Timeline): Verdict =
  Verdict.stepEvery(t, pair => pair match {
  case (a, b) => !isRejectedDrive(t, b) || Timeline.fileSame(t, a, b, "ws/src/Main.scuzz") && Timeline.fileSame(t, a, b, "ws/.scuzz/ide/journal.json") && Timeline.fileSame(t, a, b, "ws/.scuzz/ide/steer.json") && Timeline.fileSame(t, a, b, "ws/.scuzz/ide/last.json")
})

