oracle loopCrankAndSteerContracts(): Bool =
  for {
    cidPre = Str.repeat("7", 64)
    cidRetired = Str.repeat("8", 64)
    propose = (ctx: IdeLoop.GenContext) => if (ctx.steerPrompt == "fail-twice") IO.pure(Result.Err("bad-gen")) else IO.pure(Result.Ok(IdeLoop.Candidate("p-ok", "sim", [("src/Main.scuzz", "v1")])))
    verify = (_v: IdeLoop.VerifyInput) => IO.pure(IdeLoop.VerifyEvidence(true, "", "idle", 1, "tl-a", "tl-b", [Json.Obj([("section", Json.Str("signals"))])], 1, 0, 0))
    ioChecks = Property.force(IO.attempt(for {
  u <- Uuid.v4()
  root = Str.concat("ora-loop-", u)
  _ <- Fs.mkdirs(Fs.join(root, "src"))
  _ <- Fs.write(Fs.join(root, "src/Main.scuzz"), "v0")
  _ <- IdeSync.recover(root)
  base0 = IdeSync.setHash([("src/Main.scuzz", "v0")])
  unchangedItems <- IdeLoop.recoverSteerItems(root, [Json.Obj([("id", Json.Str("q0")), ("status", Json.Str("queued"))])])
  preCard = Json.Obj([("v", Json.Int(1)), ("id", Json.Str(cidPre)), ("a", Json.Str(base0)), ("steer_id", Json.Str("s-done")), ("status", Json.Str("ready"))])
  retiredCard = Json.Obj([("v", Json.Int(1)), ("id", Json.Str(cidRetired)), ("a", Json.Str("old-base")), ("status", Json.Str("retired"))])
  _ <- Fs.mkdirs(Fs.dirname(IdeSync.cardFile(root, cidPre)))
  _ <- Fs.write(IdeSync.cardFile(root, cidPre), IdeSync.text(preCard))
  _ <- Fs.mkdirs(Fs.dirname(IdeSync.cardFile(root, cidRetired)))
  _ <- Fs.write(IdeSync.cardFile(root, cidRetired), IdeSync.text(retiredCard))
  rawSteer = [Json.Obj([("id", Json.Str("s-done")), ("prompt", Json.Str("done")), ("status", Json.Str("active"))]), Json.Obj([("id", Json.Str("s-requeue")), ("prompt", Json.Str("fail-twice")), ("status", Json.Str("active")), ("attempts", Json.Int(0))])]
  recovered <- IdeLoop.recoverSteerItems(root, rawSteer)
  zeroRounds <- IdeLoop.crankRounds(root, 0, propose, verify)
  exhaustRounds <- IdeLoop.crankRounds(root, 3, propose, verify)
  _ <- Fs.write(Fs.join(IdeSync.storage(root), "dirty.json"), "[\"src/Main.scuzz\"]")
  dirtyStop <- IdeLoop.crankRounds(root, 3, propose, verify)
  _ <- Fs.write(Fs.join(IdeSync.storage(root), "dirty.json"), "")
  _ <- Fs.write(IdeSync.steerPath(root), "{\"v\":1,\"items\":[{\"seq\":1,\"id\":\"s-go\",\"prompt\":\"ship\",\"status\":\"queued\",\"attempts\":0}]}")
  onePub <- IdeLoop.crankOne(root, propose, verify)
  idleSameBase <- IdeLoop.crankRounds(root, 3, propose, verify)
  preBeforeRaw <- IdeSync.readOptional(IdeSync.cardFile(root, cidPre))
  preBeforeDoc <- IdeSync.parseStored(preBeforeRaw, "pre-before")
  _ <- Fs.write(Fs.join(root, "src/Main.scuzz"), "v2")
  retireOnce <- IdeLoop.crankOne(root, propose, verify)
  preAfterRaw <- IdeSync.readOptional(IdeSync.cardFile(root, cidPre))
  preAfterDoc <- IdeSync.parseStored(preAfterRaw, "pre-after")
  retAfterRaw <- IdeSync.readOptional(IdeSync.cardFile(root, cidRetired))
  retAfterDoc <- IdeSync.parseStored(retAfterRaw, "ret-after")
} yield List.len(unchangedItems) == 1 && IdeSync.str(List.at(recovered, 0), "status") == "consumed" && IdeSync.str(List.at(recovered, 0), "card") == cidPre && IdeSync.str(List.at(recovered, 1), "status") == "queued" && List.isEmpty(zeroRounds) && List.len(exhaustRounds) == 3 && List.at(exhaustRounds, 0).status == "rejected" && List.at(exhaustRounds, 1).status == "rejected" && List.at(exhaustRounds, 2).status == "idle" && List.len(dirtyStop) == 1 && List.at(dirtyStop, 0).status == "dirty" && onePub.status == "published" && IdeSync.validHex(onePub.cardId) && List.len(idleSameBase) == 1 && List.at(idleSameBase, 0).status == "idle" && IdeSync.str(preBeforeDoc, "status") == "ready" && retireOnce.status == "idle" && IdeSync.str(preAfterDoc, "status") == "stale" && IdeSync.str(retAfterDoc, "status") == "retired"))
  } yield ioChecks match {
  case Result.Ok(ok) => ok
  case Result.Err(e) => isSimFsFault(e)
}

def generationPreservesWorkspaceSources(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.fileTextIs(t, i, "ws-gen/src/Main.scuzz", "v0") && Timeline.fileTextIs(t, i, "ws-gen-dirty/src/Main.scuzz", "v0") && Timeline.fileTextIs(t, i, "ws-gen-dirty/.scuzz/ide/dirty.json", "[\"src/Main.scuzz\"]") && Timeline.fileTextIs(t, i, "ws-gen-crash/src/Main.scuzz", "v0") && (Timeline.fileTextIs(t, i, "ws-adv/src/Main.scuzz", "v0") || Timeline.fileTextIs(t, i, "ws-adv/src/Main.scuzz", "alpha")))

def steerPreferencesAndVerifiedFeed(t: Timeline): Verdict =
  Verdict.stepEvery(t, pair => pair match {
  case (a, b) => (!Timeline.driveHas(t, b, "mobileSteerGenerateAndServe") || faulted(t, b) && Timeline.fileSame(t, a, b, "ws-gen/src/Main.scuzz") || Timeline.fileTextIs(t, b, "obs/gen.txt", "proposals=p-compact,p-polished;steer=")) && (!Timeline.driveHas(t, b, "acceptAdvancesAndRetiresStale") || faulted(t, b) && (Timeline.fileSame(t, a, b, "ws-adv/src/Main.scuzz") || Timeline.fileTextIs(t, b, "ws-adv/src/Main.scuzz", "alpha")) || Timeline.fileTextIs(t, b, "ws-adv/src/Main.scuzz", "alpha") && Timeline.fileTextIs(t, b, "obs/gen.txt", "beta=stale;proposals=p-alpha-ext;steer="))
})

def dirtyAndCrashLoopDurability(t: Timeline): Verdict =
  Verdict.stepEvery(t, pair => pair match {
  case (a, b) => (!Timeline.driveHas(t, b, "dirtyBlocksAndPreservesSteer") || faulted(t, b) && Timeline.fileSame(t, a, b, "ws-gen-dirty/src/Main.scuzz") || Timeline.fileTextIs(t, b, "obs/gen.txt", "dirty-stopped;proposals=;steer=keep-clean")) && (!Timeline.driveHas(t, b, "crashActiveSteerRecovery") || faulted(t, b) && Timeline.fileSame(t, a, b, "ws-gen-crash/src/Main.scuzz") || a == 0 && Timeline.fileTextIs(t, b, "obs/gen.txt", "proposals=p-pre;steer=crash-mid-steer -> proposals=p-pre,p-recovered;steer=") || a != 0 && (Timeline.fileTextIs(t, b, "obs/gen.txt", "proposals=p-pre;steer=crash-mid-steer -> proposals=p-pre,p-recovered;steer=") || Timeline.fileTextIs(t, b, "obs/gen.txt", "proposals=p-pre,p-recovered;steer= -> proposals=p-pre,p-recovered;steer="))) && (!Timeline.driveHas(t, b, "verifierGateRejections") || faulted(t, b) || Timeline.fileTextIs(t, b, "obs/gen.txt", "gates-verified"))
})

