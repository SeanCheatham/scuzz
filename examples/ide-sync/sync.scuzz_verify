    prefSerOk = IdeSync.str(pj, "kind") == "preference" && IdeSync.str(pj, "decision") == "skip" && IdeSync.str(pj, "card") == "c2" && IdeSync.str(pj, "proposal") == "p2" && IdeSync.str(pj, "reason") == "outside-my-goal" && Json.arr(IdeSync.field(pj, "paths")) == [Json.Str("src/Main.scuzz"), Json.Str("src/Extra.scuzz")] && Json.getInt(pj, "time", 0) == 2
    noteSerOk = IdeSync.str(nj, "kind") == "automatic" && IdeSync.str(nj, "decision") == "candidate-failed" && IdeSync.str(nj, "diagnostic") == "err" && IdeSync.pairs(IdeSync.field(nj, "source")) == [("src/A.scuzz", "1"), ("src/B.scuzz", "2")] && Json.getInt(nj, "time", 0) == 3
    fbNone = IdeLoop.buildFeedback([p1], "", "", 0, [])
    fbSteer = IdeLoop.buildFeedback([p1], "s1", "focus", 1, [IdeLoop.AutoNote("candidate-failed", "err", [("src/Main.scuzz", "bad")], 3)])
    humanRecs = List.map(List.range(0, 9), i => Json.Obj([("decision", Json.Str(if (i == 0) "baseline" else if (i == 1) "abstain" else if (i == 2) "undo" else "accept")), ("card", Json.Str(Str.concat("c", Str.fromInt(i)))), ("proposal", Json.Str(Str.concat("p", Str.fromInt(i)))), ("reason", Json.Str(if (i == 1) "no-visible-difference" else "")), ("region", Json.Arr(if (i == 2) [] else [Json.Str("src/Main.scuzz")])), ("writes", Json.Arr(if (i == 2) [Json.Obj([("path", Json.Str("src/Undo.scuzz"))])] else [])), ("time", Json.Int(10 - i))]))
    withAuto = List.append(humanRecs, Json.Obj([("v", Json.Int(1)), ("kind", Json.Str("automatic")), ("decision", Json.Str("candidate-failed")), ("a", Json.Str("h1")), ("diagnostic", Json.Str("d0")), ("source", IdeSync.pairsJson([("src/Main.scuzz", "x")])), ("time", Json.Int(99))]))
    prefs = IdeLoop.extractPreferences(withAuto)
    autoRecs = [Json.Obj([("v", Json.Int(0)), ("kind", Json.Str("automatic")), ("decision", Json.Str("candidate-failed")), ("a", Json.Str("h1")), ("diagnostic", Json.Str("bad-v")), ("source", Json.Arr([])), ("time", Json.Int(60))]), Json.Obj([("v", Json.Int(1)), ("kind", Json.Str("automatic")), ("decision", Json.Str("candidate-failed")), ("a", Json.Str("other")), ("diagnostic", Json.Str("wrong-base")), ("source", Json.Arr([])), ("time", Json.Int(50))]), Json.Obj([("v", Json.Int(1)), ("kind", Json.Str("automatic")), ("decision", Json.Str("candidate-failed")), ("a", Json.Str("h1")), ("diagnostic", Json.Str("d4")), ("source", Json.Arr([])), ("time", Json.Int(4))]), Json.Obj([("v", Json.Int(1)), ("kind", Json.Str("automatic")), ("decision", Json.Str("candidate-failed")), ("a", Json.Str("h1")), ("diagnostic", Json.Str("d1")), ("source", Json.Arr([])), ("time", Json.Int(1))]), Json.Obj([("v", Json.Int(1)), ("kind", Json.Str("automatic")), ("decision", Json.Str("candidate-failed")), ("a", Json.Str("h1")), ("diagnostic", Json.Str("d3")), ("source", Json.Arr([])), ("time", Json.Int(3))]), Json.Obj([("v", Json.Int(1)), ("kind", Json.Str("automatic")), ("decision", Json.Str("candidate-failed")), ("a", Json.Str("h1")), ("diagnostic", Json.Str("d2")), ("source", Json.Arr([])), ("time", Json.Int(2))])]
    notes = IdeLoop.extractAutoNotes(List.concat(humanRecs, autoRecs), "h1")
    goodEv = IdeLoop.VerifyEvidence(true, "", "idle", 0, "a", "b", [], 1, 0, 0)
  } yield prefSerOk && noteSerOk && IdeLoop.maxSteerAttempts() == 2 && IdeLoop.flipOf(Str.repeat("0", 64)) == 0 && IdeLoop.flipOf(Str.repeat("1", 64)) == 1 && IdeLoop.flipOf(Str.concat("0", Str.repeat("1", 63))) == 0 && IdeLoop.flipOf(Str.concat("1", Str.repeat("0", 63))) == 1 && IdeLoop.decisionLabel("baseline") == "reject" && IdeLoop.decisionLabel("abstain") == "skip" && IdeLoop.decisionLabel("accept") == "accept" && IdeLoop.decisionLabel("undo") == "undo" && IdeLoop.composePrompt("", "only-steer", []) == "only-steer" && IdeLoop.composePrompt("only-obj", "", []) == "only-obj" && IdeLoop.composePrompt("obj", "st", [p1, p2]) == "obj | steer: st | prefs: reject:p1,skip:p2#outside-my-goal" && List.len(fbNone) == 1 && List.len(fbSteer) == 3 && List.len(prefs) == 8 && List.at(prefs, 0).time == 3 && List.at(prefs, 5).decision == "undo" && List.at(prefs, 5).paths == ["src/Undo.scuzz"] && List.at(prefs, 6).decision == "skip" && List.at(prefs, 7).decision == "reject" && List.len(notes) == 3 && List.map(notes, n => noteDiag(n)) == ["d2", "d3", "d4"] && IdeLoop.verifiedPass(goodEv) == (true, "") && IdeLoop.verifiedPass(IdeLoop.VerifyEvidence(false, "", "idle", 0, "a", "b", [], 1, 0, 0)) == (false, "candidate-check-failed") && IdeLoop.verifiedPass(IdeLoop.VerifyEvidence(false, "custom", "idle", 0, "a", "b", [], 1, 0, 0)) == (false, "custom") && IdeLoop.verifiedPass(IdeLoop.VerifyEvidence(true, "", "idle", 0, "a", "b", [], 1, 1, 0)) == (false, "candidate-regressed") && IdeLoop.verifiedPass(IdeLoop.VerifyEvidence(true, "", "idle", 0, "a", "b", [], 1, 0, 1)) == (false, "mutation-survived") && IdeLoop.verifiedPass(IdeLoop.VerifyEvidence(true, "", "idle", 0, "a", "b", [], 0, 0, 0)) == (false, "no-observed-difference") && IdeLoop.verifiedPass(IdeLoop.VerifyEvidence(true, "", "", 0, "a", "b", [], 1, 0, 0)) == (false, "incomplete-evidence") && IdeLoop.verifiedPass(IdeLoop.VerifyEvidence(true, "", "idle", -1, "a", "b", [], 1, 0, 0)) == (false, "incomplete-evidence") && IdeLoop.verified