private def isSimFsFault(err: String): Bool =
  err == "Fs: injected fault" || err == "Fs: partial write" || err == "Fs: error after replacement"

private def resultFirstStatus(body: String): String =
  Json.parse(body) match {
    case Result.Err(_) => "bad-json"
    case Result.Ok(doc) => List.head(Json.arr(IdeSync.field(doc, "results"))) match {
  case Option.None => "empty"
  case Option.Some(row) => IdeSync.str(row, "status")
}
  }

