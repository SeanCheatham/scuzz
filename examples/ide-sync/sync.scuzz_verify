  } yield IdeSync.authorized(tok, good) && IdeSync.authorized(tok, upper) && !IdeSync.authorized(tok, dup) && !IdeSync.authorized(tok, wrong) && !IdeSync.authorized(tok, Map.empty()) && !IdeSync.authorized("short", IdeSync.authHeaders("short")) && IdeSync.validToken(Str.repeat("x", 16)) && IdeSync.validToken(Str.repeat("x", 128)) && !IdeSync.validToken(Str.repeat("x", 15)) && !IdeSync.validToken(Str.repeat("x", 129)) && hexOk && idOk && skipOk

