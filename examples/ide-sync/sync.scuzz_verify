private def isOkDecode(raw: String): Bool =
  IdeSync.decodeActions(raw) match {
    case Result.Ok(_) => true
    case Result.Err(_) => false
  }

private def decodeErr(raw: String): String =
  IdeSync.decodeActions(raw) match {
    case Result.Ok(_) => ""
    case Result.Err(code) => code
  }

oracle decodeBoundaries(): Bool =
  for {
    hex = Str.repeat("a", 64)
    singleAccept = Str.concat("{\"v\":1,\"id\":\"a_1\",\"kind\":\"accept\",\"card\":\"", Str.concat(hex, Str.concat("\",\"baseline\":\"", Str.concat(hex, "\"}"))))
    singleSteer512 = Str.concat("{\"v\":1,\"id\":\"s1\",\"kind\":\"steer\",\"prompt\":\"", Str.concat(Str.repeat("p", 512), "\"}"))
    singleSteer513 = Str.concat("{\"v\":1,\"id\":\"s1\",\"kind\":\"steer\",\"prompt\":\"", Str.concat(Str.repeat("p", 513), "\"}"))
    oneItem = "{\"id\":\"s1\",\"kind\":\"steer\",\"prompt\":\"ok\"}"
    batch64 = Str.concat("{\"v\":1,\"actions\":[", Str.concat(List.join(List.map(List.range(0, 64), _ => oneItem), ","), "]}"))
    batch65 = Str.concat("{\"v\":1,\"actions\":[", Str.concat(List.join(List.map(List.range(0, 65), _ => oneItem), ","), "]}"))
    skipReasons = List.forall(["", "no-visible-difference", "need-another-scenario", "outside-my-goal"], r => isOkDecode(Str.concat("{\"v\":1,\"id\":\"k1\",\"kind\":\"skip\",\"card\":\"", Str.concat(hex, Str.concat("\",\"reason\":\"", Str.concat(r, "\"}"))))))
  } yield isOkDecode(singleAccept) && isOkDecode(singleSteer512) && decodeErr(singleSteer513) == "invalid-steer" && isOkDecode(batch64) && decodeErr(batch65) == "invalid-actions" && skipReasons && decodeErr(Str.concat("{\"v\":1,\"id\":\"k1\",\"kind\":\"skip\",\"card\":\"", Str.concat(hex, "\",\"reason\":\"bad\"}"))) == "invalid-reason" && decodeErr(Str.concat("{\"v\":1,\"id\":\"k1\",\"kind\":\"skip\",\"card\":\"", Str.concat(hex, "\",\"reason\":1}"))) == "invalid-reason" && decodeErr("{") == "invalid-json" && decodeErr("{\"v\":2,\"id\":\"s1\",\"kind\":\"steer\",\"prompt\":\"ok\"}") == "invalid-version" && decodeErr("{\"v\":\"1\",\"id\":\"s1\",\"kind\":\"steer\",\"prompt\":\"ok\"}") == "invalid-version" && decodeErr("[]") == "invalid-version" && decodeErr("{\"v\":1,\"actions\":1}") == "invalid-actions" && decodeErr("{\"v\":1,\"actions\":[1]}") == "expected-action-object" && decodeErr("{\"v\":1,\"id\":\"\",\"kind\":\"steer\",\"prompt\":\"ok\"}") == "invalid-action-id" && decodeErr("{\"v\":1,\"id\":1,\"kind\":\"steer\",\"prompt\":\"ok\"}") == "invalid-action-id" && decodeErr(Str.concat("{\"v\":1,\"id\":\"a1\",\"kind\":\"accept\",\"card\":\"", Str.concat(hex, "\"}"))) == "invalid-accept" && decodeErr("{\"v\":1,\"id\":\"r1\",\"kind\":\"reject\",\"card\":\"bad\"}") == "invalid-reject" && decodeErr(Str.concat("{\"v\":1,\"id\":\"r1\",\"kind\":\"reject\",\"card\":\"", Str.concat(hex, "\",\"baseline\":\"bad\"}"))) == "invalid-reject" && decodeErr(Str.concat("{\"v\":1,\"id\":\"r1\",\"kind\":\"reject\",\"card\":\"", Str.concat(hex, "\",\"baseline\":1}"))) == "invalid-reject" && decodeErr("{\"v\":1,\"id\":\"k1\",\"kind\":\"skip\",\"card\":\"bad\"}") == "invalid-skip" && decodeErr("{\"v\":1,\"id\":\"s1\",\"kind\":\"steer\",\"prompt\":\"   \"}") == "invalid-steer" && decodeErr("{\"v\":1,\"id\":\"s1\",\"kind\":\"steer\",\"prompt\":1}") == "invalid-steer" && decodeErr("{\"v\":1,\"id\":\"x1\",\"kind\":\"other\"}") == "invalid-kind" && decodeErr(Str.repeat("x", 262145)) == "payload-too-large" && decodeErr(Str.repeat("x", 262144)) == "invalid-json"

