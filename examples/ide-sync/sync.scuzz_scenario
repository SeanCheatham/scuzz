private def simPropose(ctx: IdeLoop.GenContext): IO[Result[String, IdeLoop.Candidate]] =
  if (ctx.steerPrompt == "err-empty") IO.pure(Result.Err("")) else if (ctx.steerPrompt == "err-msg") IO.pure(Result.Err("model-timeout")) else if (ctx.steerPrompt == "bad-path") IO.pure(Result.Ok(IdeLoop.Candidate("p-bad-path", "sim-qwen", [("src/Extra.scuzz", "disallowed")]))) else if (ctx.steerPrompt == "bad-empty") IO.pure(Result.Ok(IdeLoop.Candidate("p-bad-empty", "sim-qwen", []))) else if (ctx.steerPrompt == "unchanged") IO.pure(Result.Ok(IdeLoop.Candidate("p-same", "sim-qwen", [("src/Main.scuzz", "v0")]))) else if (ctx.steerPrompt == "dup") IO.pure(Result.Ok(IdeLoop.Candidate("p-dup", "sim-qwen", [("src/Main.scuzz", "v1-compact")]))) else if (ctx.steerPrompt == "no-diff") IO.pure(Result.Ok(IdeLoop.Candidate("p-nodiff", "sim-qwen", [("src/Main.scuzz", "UNVERIFIED:nodiff")]))) else if (ctx.steerPrompt == "incomplete") IO.pure(Result.Ok(IdeLoop.Candidate("p-incomp", "sim-qwen", [("src/Main.scuzz", "UNVERIFIED:incomplete")]))) else if (ctx.steerPrompt == "type-err") IO.pure(Result.Ok(IdeLoop.Candidate("p-type-err", "sim-qwen", [("src/Main.scuzz", "UNVERIFIED:type-error")]))) else if (ctx.steerPrompt == "race-base") IO.pure(Result.Ok(IdeLoop.Candidate("p-race-base", "sim-qwen", [("src/Main.scuzz", "v1-race-base")]))) else if (ctx.steerPrompt == "race-dirty") IO.pure(Result.Ok(IdeLoop.Candidate("p-race-dirty", "sim-qwen", [("src/Main.scuzz", "v1-race-dirty")]))) else if (ctx.steerPrompt == "broken-then-compact") if (List.isEmpty(ctx.notes)) IO.pure(Result.Ok(IdeLoop.Candidate("p-broken", "sim-qwen", [("src/Main.scuzz", "UNVERIFIED:type-error")]))) else if (Str.contains(ctx.prompt, "ship sync | steer: broken-then-compact | prefs: reject:p-alpha,skip:p-beta#need-another-scenario") && List.at(ctx.notes, 0).diagnostic == "static-type-error" && List.len(ctx.feedback) >= 4) IO.pure(Result.Ok(IdeLoop.Candidate("p-compact", "sim-qwen", [("src/Main.scuzz", "v1-compact")]))) else IO.pure(Result.Err("missing-folded-context")) else if (ctx.steerPrompt == "always-broken") if (ctx.steerAttempts == 0) IO.pure(Result.Ok(IdeLoop.Candidate("p-mutant", "sim-qwen", [("src/Main.scuzz", "UNVERIFIED:mutant")]))) else IO.pure(Result.Ok(IdeLoop.Candidate("p-regress", "sim-qwen", [("src/Main.scuzz", "UNVERIFIED:regressed")]))) else if (ctx.steerPrompt == "polish-after-bad") IO.pure(Result.Ok(IdeLoop.Candidate("p-polished", "sim-qwen", [("src/Main.scuzz", "v1-polished")]))) else if (ctx.steerPrompt == "extend-alpha") if (Str.contains(ctx.prompt, "ship sync | steer: extend-alpha | prefs: accept:p-alpha") && List.contains(ctx.sources, ("src/Main.scuzz", "alpha"))) IO.pure(Result.Ok(IdeLoop.Candidate("p-alpha-ext", "sim-qwen", [("src/Main.scuzz", "alpha-v2")]))) else IO.pure(Result.Err("missing-accept-context")) else if (ctx.steerPrompt == "crash-mid-steer") IO.pure(Result.Ok(IdeLoop.Candidate("p-recovered", "sim-qwen", [("src/Main.scuzz", "v1-recovered")]))) else if (ctx.steerPrompt == "steer-without-session") IO.pure(Result.Ok(IdeLoop.Candidate("p-steer-only", "sim-qwen", [("src/Main.scuzz", "v1-steer-only")]))) else if (List.contains(ctx.sources, ("src/Main.scuzz", "alpha"))) IO.pure(Result.Ok(IdeLoop.Candidate("p-alpha-ext", "sim-qwen", [("src/Main.scuzz", "alpha-v2")]))) else IO.pure(Result.Ok(IdeLoop.Candidate("p-polished", "sim-qwen", [("src/Main.scuzz", "v1-polished")])))

private def simVerify(root: String, _disk: List[(String, String)], after: List[(String, String)]): IO[IdeLoop.VerifyEvidence] =
  for {
    mainBody = List.getOrElse(List.map(after, f => f._2), List.indexOf(List.map(after, f => f._1), "src/Main.scuzz"), "")
    _ <- if (mainBody == "v1-race-base") Fs.write(Fs.join(root, "src/Main.scuzz"), "alpha") else if (mainBody == "v1-race-dirty") Fs.write(Fs.join(root, ".scuzz/ide/dirty.json"), "[\"src/Main.scuzz\"]") else IO.pure(())
    change = [Json.Obj([("section", Json.Str("a11y")), ("after", Json.Str(mainBody))])]
  } yield if (mainBody == "UNVERIFIED:type-error") IdeLoop.VerifyEvidence(false, "static-type-error", "", 0, "", "", [], 0, 0, 0) else if (mainBody == "UNVERIFIED:mutant") IdeLoop.VerifyEvidence(true, "", "idle", 0, "tl-a", "tl-b", change, 1, 0, 1) else if (mainBody == "UNVERIFIED:regressed") IdeLoop.VerifyEvidence(true, "", "idle", 0, "tl-a", "tl-b", change, 1, 1, 0) else if (mainBody == "UNVERIFIED:nodiff") IdeLoop.VerifyEvidence(true, "", "idle", 0, "tl-a", "tl-a", [], 0, 0, 0) else if (mainBody == "UNVERIFIED:incomplete") IdeLoop.VerifyEvidence(true, "", "idle", 0, "tl-a", "", change, 1, 0, 0) else IdeLoop.VerifyEvidence(true, "", "idle", 1, """# timeline a
""", Str.concat("# timeline b ", mainBody), change, 1, 0, 0)

private def summarizeGenFeed(body: String): String =
  Json.parse(body) match {
    case Result.Err(_) => "bad-json"
    case Result.Ok(doc) => for {
  cards = Json.arr(IdeSync.field(doc, "cards"))
  names = List.sort(List.map(cards, c => IdeSync.str(c, "proposal")))
  steers = List.map(Json.arr(IdeSync.field(doc, "steer")), s => IdeSync.str(s, "prompt"))
  base = IdeSync.str(doc, "baseline")
  allMatchBase = List.forall(cards, c => IdeSync.str(c, "baseline") == base && List.nonEmpty(Json.arr(IdeSync.field(c, "changes"))))
} yield if (!allMatchBase) "card-base-mismatch" else Str.concat("proposals=", Str.concat(List.join(names, ","), Str.concat(";steer=", List.join(steers, "|"))))
  }

