  _ <- Fs.write(Fs.join(root, ".scuzz/ide/session.json"), "{\"objective\":\"gate checks\",\"allowed\":[\"src/Main.scuzz\",\"../bad\",\"src/Main.scuzz\"]}")
  zero <- IdeLoop.crankRounds(root, 0, c => simPropose(c), v => simVerify(v.root, v.disk, v.after))
