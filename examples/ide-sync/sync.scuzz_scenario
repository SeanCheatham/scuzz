  cardPre = makeCard(cardGamma(), "p-pre-dup", 0, [("src/Extra.scuzz", "keep"), ("src/Main.scuzz", "v0")], [("src/Extra.scuzz", "keep"), ("src/Main.scuzz", "v1-compact")])
  _ <- writeCard(root, cardGamma(), cardPre)
  mixedRes <- IdeLoop.crankRounds(root, 3, c => simPropose(c), v => simVerify(v.root, v.disk, v.after))
  sOnlyRaw <- Fs.read(IdeSync.cardFile(root, List.at(mixedRes, 0).cardId))
  sOnlyDoc <- IdeSync.parseStored(sOnlyRaw, "s-only card")
