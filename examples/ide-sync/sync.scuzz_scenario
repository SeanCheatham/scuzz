def mintFreshToken(): IO[Unit] =
  IO.attempt(for {
  minted <- IdeSync.ensureToken("ws-token", "")
  reused <- IdeSync.ensureToken("ws-token", "")
  explicit <- IdeSync.ensureToken("ws-token", "explicit-token-123456")
  reusedExplicit <- IdeSync.ensureToken("ws-token", "")
  bad <- IO.attempt(IdeSync.ensureToken("ws-token", "short"))
  badRejected = bad match {
  case Result.Ok(_) => false
  case Result.Err(_) => true
}
  _ <- Fs.write("obs/summary.txt", if (minted == reused && IdeSync.validToken(minted) && explicit == "explicit-token-123456" && reusedExplicit == "explicit-token-123456" && badRejected) "token-minted-and-reused" else "token-mismatch")
} yield ()).map(_ => ())

