  server <- Fiber.fork(IdeSync.run("ws", 18787, token()))
  _ <- IO.ensure(for {
  b1 = Str.concat("{\"v\":1,\"id\":\"act-alpha\",\"kind\":\"accept\",\"card\":\"", Str.concat(cardAlpha(), Str.concat("\",\"baseline\":\"", Str.concat(baseZero(), "\"}"))))
  b2 = Str.concat("{\"v\":1,\"id\":\"act-beta-stale\",\"kind\":\"accept\",\"card\":\"", Str.concat(cardBeta(), Str.concat("\",\"baseline\":\"", Str.concat(baseZero(), "\"}"))))
