def offlineBatchReplay(): IO[Unit] =
  IO.attempt(for {
  a0 = Str.concat("{\"id\":\"b-missing\",\"kind\":\"reject\",\"card\":\"", Str.concat(cardMissing(), "\"}"))
  a1 = Str.concat("{\"id\":\"b-reject\",\"kind\":\"reject\",\"card\":\"", Str.concat(cardGamma(), "\"}"))
  a1dup = Str.concat("{\"id\":\"b-reject-other\",\"kind\":\"skip\",\"card\":\"", Str.concat(cardGamma(), "\"}"))
  a2 = Str.concat("{\"id\":\"b-skip\",\"kind\":\"skip\",\"card\":\"", Str.concat(cardBeta(), "\",\"reason\":\"need-another-scenario\"}"))
  a3 = "{\"id\":\"b-steer-1\",\"kind\":\"steer\",\"prompt\":\"  keep layout compact  \"}"
  a4 = Str.concat("{\"id\":\"b-accept\",\"kind\":\"accept\",\"card\":\"", Str.concat(cardAlpha(), Str.concat("\",\"baseline\":\"", Str.concat(baseZero(), "\"}"))))
  a5 = Str.concat("{\"id\":\"b-steer-2\",\"kind\":\"steer\",\"prompt\":\"add dark contrast\",\"baseline\":\"", Str.concat(baseAlpha(), "\"}"))
  batch = Str.concat("{\"v\":1,\"actions\":[", Str.concat(List.join([a0, a1, a1dup, a2, a3, a4, a5], ","), "]}"))
  _ <- callOnceAt("ws", 18787, token(), "POST", "/v1/ide/sync", IdeSync.authHeaders(token()), batch)
  recPath = Str.concat("ws/.scuzz/ide/records/", Str.concat(cardGamma(), ".json"))
  hit <- Fs.exists(recPath)
  _ <- if (hit == 0) IO.pure(()) else Fs.read(recPath).flatMap(raw => Json.parse(raw) match {
  case Result.Ok(j) => Fs.write("obs/gamma-decision.txt", Json.getStr(j, "decision", ""))
  case Result.Err(_) => Fs.write("obs/gamma-decision.txt", "bad")
})
} yield ()).map(_ => ())

