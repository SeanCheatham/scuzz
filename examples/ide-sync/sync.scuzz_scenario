  _ <- Fs.write(Fs.join(root, ".scuzz/ide/steer.json"), rawJson(Json.Obj([("v", Json.Int(1)), ("items", Json.Arr([Json.Obj([("seq", Json.Int(1)), ("id", Json.Str("s-rbase")), ("prompt", Json.Str("race-base")), ("baseline", Json.Str(baseZero())), ("status", Json.Str("queued")), ("attempts", Json.Int(0)), ("time", Json.Int(20))])]))])))
