  recPairs = List.map(recDocs, r => (IdeSync.str(r, "diagnostic"), IdeSync.str(r, "decision")))
  _ <- Fs.write(Fs.join(root, ".scuzz/ide/session.json"), "")
  _ <- Fs.write(Fs.join(root, ".scuzz/ide/steer.json"), "")
  idleRes <- IdeLoop.crankRounds(root, 2, c => simPropose(c), v => simVerify(v.root, v.disk, v.after))
  idleSteerAfter <- Fs.read(Fs.join(root, ".scuzz/ide/steer.json"))
