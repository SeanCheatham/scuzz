private def token(): String =
  "pairing-token-1234"

private def cardAlpha(): String =
  Str.repeat("a", 64)

private def cardBeta(): String =
  Str.repeat("b", 64)

private def cardGamma(): String =
  Str.repeat("c", 64)

private def cardNext(): String =
