private def rawJson(j: Json): String =
  Json.stringify(j) match {
    case Result.Ok(s) => s
    case Result.Err(e) => e
  }

private def rawPairsJson(files: List[(String, String)]): Json =
  Json.Arr(List.map(List.sort(List.map(files, f => f._1)), p => Json.Obj([("path", Json.Str(p)), ("content", Json.Str(List.getOrElse(List.map(files, f => f._2), List.indexOf(List.map(files, f => f._1), p), "")))])))

private def rawSetHash(files: List[(String, String)]): String =
  Hash.sha256(rawJson(rawPairsJson(files)))

private def rawApplyPaths(disk: List[(String, String)], props: List[(String, String)]): List[(String, String)] =
  List.concat(List.map(disk, d => (d._1, List.getOrElse(List.map(props, p => p._2), List.indexOf(List.map(props, p => p._1), d._1), d._2))), List.filter(props, p => !List.contains(List.map(disk, d => d._1), p._1)))

private def baseZero(): String =
  rawSetHash([("src/Main.scuzz", "v0")])

private def baseAlpha(): String =
  rawSetHash([("src/Main.scuzz", "alpha")])

private def baseBeta(): String =
  rawSetHash([("src/Extra.scuzz", "extra"), ("src/Main.scuzz", "beta")])

private def makeCard(id: String, name: String, flip: Int, baseFiles: List[(String, String)], propFiles: List[(String, String)]): String =
  for {
    a = rawSetHash(baseFiles)
    b = rawSetHash(rawApplyPaths(baseFiles, propFiles))
    work = Json.Obj([("label", Json.Str("idle")), ("delta", Json.Obj([("changes", Json.Arr([Json.Obj([("section", Json.Str("signals"))])]))]))])
    doc = Json.Obj([("v", Json.Int(1)), ("id", Json.Str(id)), ("proposal", Json.Str(name)), ("publication", Json.Str("{\"generator\":\"local\"}")), ("objective", Json.Str("ship sync")), ("baseline", rawPairsJson(baseFiles)), ("proposed", rawPairsJson(propFiles)), ("a", Json.Str(a)), ("b", Json.Str(b)), ("flip", Json.Int(flip)), ("started", Json.Int(1)), ("ready", Json.Int(2)), ("status", Json.Str("ready")), ("question", Json.Obj([("workload", Json.Str("idle")), ("step", Json.Int(0))])), ("evidence", Json.Obj([("workloads", Json.Arr([work]))]))])
  } yield rawJson(doc)

private def writeCard(root: String, id: String, body: String): IO[Unit] =
  for {
    dir = Fs.join(Fs.join(root, ".scuzz/ide/cards"), id)
    _ <- Fs.mkdirs(dir)
    _ <- Fs.write(Fs.join(dir, "card.json"), body)
  } yield ()

private def initWorkspace(root: String, src: String, tok: String): IO[Unit] =
  for {
    _ <- Fs.mkdirs(Fs.join(root, "src"))
    _ <- Fs.mkdirs(Fs.join(root, ".scuzz/ide/cards"))
    _ <- Fs.mkdirs(Fs.join(root, ".scuzz/ide/records"))
    _ <- Fs.mkdirs(Fs.join(root, ".scuzz/ide/sync/actions"))
    _ <- Fs.write(Fs.join(root, "scuzz.toml"), "[package]\nname = \"demo\"\n")
    _ <- Fs.write(Fs.join(root, "src/Main.scuzz"), src)
    _ <- Fs.write(Fs.join(root, ".scuzz/ide/session.json"), "{\"objective\":\"ship sync\"}")
    _ <- Fs.write(Fs.join(root, ".scuzz/ide/journal.json"), "")
    _ <- Fs.write(Fs.join(root, ".scuzz/ide/last.json"), "")
    _ <- Fs.write(Fs.join(root, ".scuzz/ide/steer.json"), "")
    _ <- Fs.write(Fs.join(root, ".scuzz/ide/dirty.json"), "")
    _ <- Fs.write(Fs.join(root, ".scuzz/ide/sync-token.txt"), tok)
  } yield ()

