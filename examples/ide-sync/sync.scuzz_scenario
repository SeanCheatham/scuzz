private def summarizeFeed(body: String): String =
  Json.parse(body) match {
    case Result.Err(_) => "bad-json"
    case Result.Ok(doc) => for {
  cards = List.map(Json.arr(IdeSync.field(doc, "cards")), c => Str.take(IdeSync.str(c, "id"), 4))
  steers = List.map(Json.arr(IdeSync.field(doc, "steer")), s => IdeSync.str(s, "prompt"))
  rev = Json.getInt(doc, "revision", -1)
  obj = IdeSync.str(doc, "objective")
  curOk = Json.getInt(doc, "v", 0) == 1 && IdeSync.validHex(IdeSync.str(doc, "cursor"))
} yield if (!curOk) "bad-cursor" else Str.concat("rev=", Str.concat(Str.fromInt(rev), Str.concat(";obj=", Str.concat(obj, Str.concat(";cards=", Str.concat(List.join(cards, ","), Str.concat(";steer=", List.join(steers, "|"))))))))
  }

private def summarizeRow(r: Json): String =
  for {
    kind = IdeSync.str(r, "kind")
    base = IdeSync.str(r, "baseline")
    baseTag = if (base == baseAlpha()) "@a" else if (base == baseBeta()) "@b" else if (base == baseZero()) "@0" else "@?"
    extra = if (kind == "skip") Str.concat("#", IdeSync.str(r, "reason")) else if (kind == "steer") Str.concat(Str.concat("#", Str.fromInt(Json.getInt(r, "seq", -1))), baseTag) else if (Json.has(r, "reason")) "#unexpected-reason" else ""
    ok = Json.getInt(r, "v", 0) == 1 && IdeSync.validHex(base)
  } yield if (!ok) "bad-row" else Str.concat(IdeSync.str(r, "id"), Str.concat(":", Str.concat(IdeSync.str(r, "status"), Str.concat(":", Str.concat(if (Json.getBool(r, "replayed", false)) "true" else "false", extra)))))

private def summarizePost(body: String): String =
  Json.parse(body) match {
    case Result.Err(_) => "bad-json"
    case Result.Ok(doc) => if (Json.getInt(doc, "v", 0) != 1) "bad-v" else List.join(List.map(Json.arr(IdeSync.field(doc, "results")), r => summarizeRow(r)), ",")
  }

private def callOnceAt(root: String, port: Int, serverToken: String, method: String, path: String, headers: Map[String, String], body: String): IO[Unit] =
  IO.attempt(for {
  server <- Fiber.fork(Net.serveOnce(port, req => IdeSync.handle(root, serverToken, req)))
  _ <- IO.ensure(for {
  url = Str.concat("http://127.0.0.1:", Str.concat(Str.fromInt(port), path))
  resp <- if (method == "GET") Net.httpGet(url, headers) else if (method == "DELETE") Net.httpDelete(url, headers) else Net.httpPost(url, headers, body)
  _ <- Fs.write("obs/status.txt", Str.fromInt(resp._1))
  _ <- if (resp._1 == 200) Fs.write("obs/summary.txt", if (method == "GET") summarizeFeed(resp._3) else summarizePost(resp._3)) else IO.pure(())
} yield (), Fiber.interrupt(server))
} yield ()).map(_ => ())

