def controlsStayAvailable(t: Timeline): Verdict =
  Verdict.and(Verdict.alwaysHas(t, "button:Reverse"), Verdict.alwaysHas(t, "button:Remove first"))

def sizeStaysValid(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalListLen(t, i, "items") >= 0 && Timeline.signalListLen(t, i, "items") <= 10000)

def reverseKeepsItems(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Reverse", pair => pair match {
  case (before, after) => Timeline.signalListLen(t, before, "items") == Timeline.signalListLen(t, after, "items") && Timeline.signalInt(t, after, "first") == Timeline.signalInt(t, before, "last") && Timeline.signalInt(t, after, "last") == Timeline.signalInt(t, before, "first")
})

def removeChangesSize(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Remove first", pair => pair match {
  case (before, after) => Timeline.signalListLen(t, after, "items") == (if (Timeline.signalListLen(t, before, "items") > 0) Timeline.signalListLen(t, before, "items") - 1 else 0)
})

oracle recordLabel(): Bool =
  itemTitle(Item(-4, "text")) == "Item -4"

oracle scalarLabels(): Bool =
  for {
    value = (-4, true, 2.5, "text")
    other = (0, false, -0.5, "")
  } yield s"${value._1} ${value._2} ${value._3} ${value._4}" == "-4 1 2.5 text" && s"${other._1} ${other._2} ${other._3} ${other._4}" == "0 0 -0.5 "

def startsWithAllItems(t: Timeline): Verdict =
  Verdict.every(t, i => i != 0 || Timeline.signalListLen(t, i, "items") == 10000 && Timeline.signalInt(t, i, "first") == 0 && Timeline.signalInt(t, i, "last") == 9999)

def detailsMatchItems(t: Timeline): Verdict =
  Verdict.every(t, i => (!Timeline.a11yHas(t, i, """text:Item 0
""") || Timeline.a11yHas(t, i, """text:Item 0
text:A short row.""")) && (!Timeline.a11yHas(t, i, """text:Item 1
""") || Timeline.a11yHas(t, i, """text:Item 1
text:This row has more text.""")) && (!Timeline.a11yHas(t, i, """text:Item 2
""") || Timeline.a11yHas(t, i, """text:Item 2
text:This row has several lines.""")))

