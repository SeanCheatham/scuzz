def parsePort(raw: String): Result[String, Hook.Port] =
  if (raw == "") Hook.port(8080) else Str.parseInt(Str.trim(raw)) match {
  case Result.Err(_) => Result.Err("Port must be 1..65535")
  case Result.Ok(value) => Hook.port(value)
}

def runConfigured(secret: String, portRaw: String, outputRaw: String): IO[Unit] =
  parsePort(portRaw) match {
    case Result.Err(message) => IO.fail(message)
    case Result.Ok(listenPort) => Hook.run(secret, listenPort, if (outputRaw == "") "webhook.json" else outputRaw)
  }

@main def main: IO[Unit] =
  for {
    secret <- Sys.getenv("SCUZZ_WEBHOOK_SECRET")
    port <- Sys.getenv("SCUZZ_WEBHOOK_PORT")
    output <- Sys.getenv("SCUZZ_WEBHOOK_OUTPUT")
    _ <- if (secret == "") IO.println("Set SCUZZ_WEBHOOK_SECRET to receive deliveries at /webhook. The default port is 8080. Run behind an HTTPS reverse proxy.") else runConfigured(secret.require(value => value != ""), port, output)
  } yield ()
