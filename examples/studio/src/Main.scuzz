law listLenNonNeg: Bool =
  Law.signalListLen(1) >= 0

law itemPastEndEmpty: Bool =
  Str.len(Law.signalListAt(1, Law.signalListLen(1))) == 0

law draftNonNeg: Bool =
  Str.len(Law.signalStr(0)) >= 0

law hasAdd: Bool =
  Law.a11yHas("button:Add")

law hasClear: Bool =
  Law.a11yHas("button:Clear")

law hasHome: Bool =
  Law.a11yHas("radio:Home")

law hasTasks: Bool =
  Law.a11yHas("radio:Tasks")

law hasProgress: Bool =
  Law.a11yHas("progress:")

law hasSwitch: Bool =
  Law.a11yHas("switch:On")

law hasChip: Bool =
  Law.a11yHas("chip:Pin")

law hasListTile: Bool =
  Law.a11yHas("listtile:")

law hasBadge: Bool =
  Law.a11yHas("badge:")

law hasCard: Bool =
  Law.a11yHas("card:")

law hasDivider: Bool =
  Law.a11yHas("divider:")

law hasExpansion: Bool =
  Law.a11yHas("expansion:")

law hasIconButton: Bool =
  Law.a11yHas("iconbutton:")

law hasVerticalDivider: Bool =
  Law.a11yHas("vdiv:")

law hasCircularProgress: Bool =
  Law.a11yHas("circular:")

law hasAvatar: Bool =
  Law.a11yHas("avatar:")

law hasCheckTile: Bool =
  Law.a11yHas("checktile:")

law hasSwitchTile: Bool =
  Law.a11yHas("switchtile:")

law hasRadioTile: Bool =
  Law.a11yHas("radiotile:")

law hasSegmented: Bool =
  Law.a11yHas("segmented:")

@main def main: IO[Unit] =
  Sys.getenv("SCUZZ_TODO_PATH").flatMap(envPath =>
    for {
      path = if (Str.len(envPath) == 0) "/tmp/scuzz_studio.txt" else envPath
      draft = Signal.str("")
      items = Signal.list([])
      page = Signal.int(0)
      count = Signal.int(0)
      level = Signal.int(40)
      live = Signal.int(0)
      pin = Signal.int(0)
      more = Signal.int(0)
      star = Signal.int(0)
      quiet = Signal.int(0)
      mode = Signal.int(0)
      seg = Signal.int(0)
      countLabel = Signal.map(count, n => s"count = $n")
      pageLabel = Signal.map(page, n => s"page = $n")
      text <- Fs.read(path).handleErrorWith(_ =>
  IO.pure("")
)
      loaded = Tasks.loadList(text)
      _ = Signal.setList(items, loaded)
      _ <- Ui.run(_ => View.column(View.grid(3, View.radio(page, 0, "Home"), View.bindText(pageLabel), View.radio(page, 1, "Tasks")), View.showWhen(page, 0, View.padding(8, View.column(View.aspectRatio(6, 1, View.background(Color.rgb(61, 126, 166), View.center(View.icon(43, Theme.accent())))), View.fraction(50, 0, View.background(Color.rgb(230, 240, 248), View.padding(4, View.icon(43, Theme.accent())))), View.fontSize(18, View.textColor(Color.rgb(20, 40, 60), View.text("Studio"))), View.bindText(countLabel), View.scrollH(View.button("+1", _ => Signal.set(count, Signal.get(count) + 1))), View.slider(level), View.progress(level), View.text("q or Esc quits")))), View.row(View.textField(draft, "item"), View.button("Add", _ => for {
  _ = Law.sometimes("tappedAdd")
  d = Str.trim(Signal.getStr(draft))
  n = Str.len(d)
} yield if (n == 0) () else for {
  xs = List.append(Signal.getList(items), d)
  _ = Signal.setList(items, xs)
} yield Signal.setStr(draft, "")), View.verticalDivider(), View.circularProgress(level), View.switch(live, "On"), View.badge(count, View.chip(pin, "Pin")), View.button("Rename", _ => for {
  xs = Signal.getList(items)
  ys = List.setAt(xs, 0, "oat milk")
} yield Signal.setList(items, ys))), View.expanded(View.scroll(View.card(View.column(View.divider(), View.avatar("S"), View.checkboxListTile(star, "Star"), View.switchListTile(quiet, "Quiet"), View.radioListTile(mode, 1, "Night"), View.segmented(seg, "List", "Grid"), View.expansionTile(more, "More", View.text("hint")), View.each(items, s => View.listTile(Tasks.itemLabel(s), View.row(View.iconButton("i", _ => Law.sometimes("tappedInfo")), View.button(if (Tasks.itemDone(s) == 1) "Undo" else "Done", _ => for {
  _ = Law.sometimes("tappedDone")
} yield Signal.setList(items, List.map(Signal.getList(items), x => if (x == s) Tasks.flipDone(x) else x))), View.button("Del", _ => Signal.setList(items, List.filter(Signal.getList(items), x => x != s)))))))))), View.button("Save", _ => for {
  xs = Signal.getList(items)
  body = Tasks.saveBody(xs)
  _ <- Fs.write(path, body)
} yield ()), View.button("Clear", _ => Signal.setList(items, [])))).require(listLenNonNeg).require(itemPastEndEmpty).require(draftNonNeg).require(hasAdd).require(hasClear).require(hasHome).require(hasTasks).require(hasProgress).require(hasSwitch).require(hasChip).require(hasListTile).require(hasBadge).require(hasCard).require(hasDivider).require(hasExpansion).require(hasIconButton).require(hasVerticalDivider).require(hasCircularProgress).require(hasAvatar).require(hasCheckTile).require(hasSwitchTile).require(hasRadioTile).require(hasSegmented).require(Signal.get(count) >= 0)
    } yield ()
  )
