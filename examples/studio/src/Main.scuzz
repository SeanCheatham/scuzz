private def setItems(items: Signal[List[Tasks.Item]], savedItems: Signal[List[Tasks.Item]], saving: Signal[Int], saveErr: Signal[Int], savedOnce: Signal[Int], saveStatus: Signal[String], next: List[Tasks.Item]): Unit =
  for {
    _ = Signal.set(items, next)
  } yield Signal.set(saveStatus, Tasks.resolveStatus(next, Signal.get(savedItems), Signal.get(saving), Signal.get(saveErr), Signal.get(savedOnce)))

@main def main: IO[Unit] =
  Sys.getenv("SCUZZ_TODO_PATH").flatMap(envPath => for {
  path = Tasks.resolvePath(envPath)
  draft = Signal.make("")
  page = Signal.make(0)
  homeTab = Signal.make(0)
  title = Signal.map(page, n => if (n == 0) "Studio" else if (n == 1) "Tasks" else "Preferences")
  count = Signal.make(0)
  level = Signal.make(40)
  live = Signal.make(0)
  pin = Signal.make(0)
  more = Signal.make(0)
  star = Signal.make(0)
  quiet = Signal.make(0)
  mode = Signal.make(0)
  seg = Signal.make(0)
  saving = Signal.make(0)
  saveErr = Signal.make(0)
  savedOnce = Signal.make(0)
  saveStatus = Signal.make("Ready")
  countLabel = Signal.map(count, n => s"count = $n")
  modeText = Signal.map(mode, m => Tasks.modeLabel(m))
  layoutText = Signal.map(seg, s => Tasks.layoutLabel(s))
  quietText = Signal.map(quiet, q => Tasks.quietLabel(q))
  initial <- Tasks.loadInitial(path)
  items = Signal.make(initial)
  savedItems = Signal.make(initial)
  _ <- Ui.run(_ => View.appShell(View.appBar(View.bindText(title), View.wrap([View.textButton("Open tasks", _ => Signal.set(page, 1)), View.outlinedButton("Settings", _ => Signal.set(page, 2))])), View.indexBook(page, View.column([View.section("home", "Home", View.tabs(homeTab, View.column([View.section("counter", "Counter", View.column([View.heading(2, View.text("Counter")), View.bindText(countLabel), View.wrap([View.button("+1", _ => Signal.set(count, Signal.get(count) + 1)), View.outlinedButton("Reset counter", _ => Signal.set(count, 0))]), View.text("Switch tabs or sections. The counter keeps its value.")])), View.section("status", "Status", View.column([View.heading(2, View.text("Status")), View.slider(level, "Volume", 0, 100, 1), View.progress(level, "Level"), View.bindText(quietText), View.text("The slider keeps its value when you switch tabs.")]))]))), View.section("tasks", "Tasks", View.column([View.wrap([View.maxSize(240, 0, View.textField(draft, "item")), View.button("Add", _ => for {
  _ = Property.sometimes("tappedAdd")
  d = Tasks.cleanLabel(Signal.get(draft))
} yield if (Str.len(d) == 0) () else for {
  xs = Tasks.addOpen(Signal.get(items), d)
  _ = setItems(items, savedItems, saving, saveErr, savedOnce, saveStatus, xs)
} yield Signal.set(draft, "")), View.button("Rename", _ => for {
  xs = Tasks.renameFirst(Signal.get(items), "oat milk")
} yield setItems(items, savedItems, saving, saveErr, savedOnce, saveStatus, xs))]), View.each(items, item => View.column([View.listTile(item.label, View.text(if (item.done == 1) "Done" else "Open")), View.wrap([View.button(if (item.done == 1) "Undo" else "Done", _ => for {
  _ = Property.sometimes("tappedDone")
  xs = List.map(Signal.get(items), x => if (x == item) Tasks.flipItem(x) else x)
} yield setItems(items, savedItems, saving, saveErr, savedOnce, saveStatus, xs)), View.button("Del", _ => for {
  _ = Property.sometimes("tappedDel")
  xs = List.filter(Signal.get(items), x => x != item)
} yield setItems(items, savedItems, saving, saveErr, savedOnce, saveStatus, xs))])])), View.wrap([View.button("Save", _ => if (Signal.get(saving) == 1) IO.pure(()) else for {
  _ = Property.sometimes("tappedSave")
  snap = Signal.get(items)
  _ = Signal.set(saving, 1)
  _ = Signal.set(saveErr, 0)
  _ = Signal.set(saveStatus, "Saving")
  saved <- IO.pure(()).flatMap(_ => Tasks.saveFile(path, snap))
} yield saved match {
  case Result.Ok(_) => for {
  _ = Property.sometimes("saveOk")
  _ = Signal.set(savedItems, snap)
  _ = Signal.set(savedOnce, 1)
  _ = Signal.set(saving, 0)
} yield Signal.set(saveStatus, Tasks.settledSaveStatus(Signal.get(items), snap))
  case Result.Err(_) => for {
  _ = Property.sometimes("saveFailed")
  _ = Signal.set(saving, 0)
  _ = Signal.set(saveErr, 1)
} yield Signal.set(saveStatus, "Save failed")
}), View.button("Clear", _ => for {
  _ = Property.sometimes("tappedClear")
} yield setItems(items, savedItems, saving, saveErr, savedOnce, saveStatus, []))]), View.bindText(saveStatus)])), View.section("preferences", "Preferences", View.column([View.divider(), View.unconstrainedBox(View.offstage(level, View.visibility(level, View.semantics("mark", View.tooltip("Sean", View.inkWell("face", _ => Signal.set(star, Tasks.toggleBit(Signal.get(star))), View.avatar("S"))))))), View.showWhen(mode, 0, View.theme(Theme.light(), View.card(View.column([View.bindText(modeText), View.bindText(layoutText), View.bindText(quietText)])))), View.showWhen(mode, 1, View.theme(Theme.dark(), View.card(View.column([View.bindText(modeText), View.bindText(layoutText), View.bindText(quietText)])))), View.checkboxListTile(star, "Star"), View.switchListTile(quiet, "Quiet"), View.radioListTile(mode, 1, "Night"), View.segmented(seg, "Layout", ["List", "Grid"]), View.fab("+", _ => Signal.set(level, Tasks.stepLevel(Signal.get(level)))), View.expansionTile(more, "More", View.column([View.text("Use these controls to adjust Studio defaults."), View.wrap([View.verticalDivider(), View.circularProgress(level, "Level"), View.switch(live, "On"), View.badge(count, View.chip(pin, "Pin"))]), View.wrap([View.iconButton("i", _ => Signal.set(pin, Tasks.toggleBit(Signal.get(pin)))), View.outlinedButton("Edit", _ => Signal.set(page, 1)), View.textButton("Kit", _ => for {
  _ = Signal.set(level, 40)
  _ = Signal.set(live, 0)
  _ = Signal.set(pin, 0)
  _ = Signal.set(star, 0)
  _ = Signal.set(quiet, 0)
  _ = Signal.set(mode, 0)
} yield Signal.set(seg, 0)), View.filterChip(star, "Tag"), View.choiceChip(mode, 0, "Day"), View.actionChip("Go", _ => Signal.set(live, 1)), View.inputChip(star, "In")])]))]))]))).require(Property.signalListLen("items") >= 0).require(Property.signalListLen("savedItems") >= 0).require(Str.len(Property.signalListAt("items", Property.signalListLen("items"))) == 0).require(Str.len(Property.signalStr("draft")) >= 0).require(Signal.get(count) >= 0).require(Signal.get(level) >= 0 && Signal.get(level) <= 100).require(Signal.get(saving) == 0 || Signal.get(saving) == 1).require(Signal.get(saveErr) == 0 || Signal.get(saveErr) == 1).require(Signal.get(savedOnce) == 0 || Signal.get(savedOnce) == 1))
} yield ())
