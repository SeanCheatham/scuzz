@main def main: IO[Unit] =
  Sys.getenv("SCUZZ_TODO_PATH").flatMap(envPath => for {
  path = if (Str.len(envPath) == 0) "/tmp/scuzz_studio.txt" else envPath
  draft = Signal.make("")
  page = Signal.make(0)
  homeTab = Signal.make(0)
  title = Signal.map(page, n => if (n == 0) "Studio" else if (n == 1) "Tasks" else "Preferences")
  count = Signal.make(0)
  level = Signal.make(40)
  live = Signal.make(0)
  pin = Signal.make(0)
  more = Signal.make(0)
  star = Signal.make(0)
  quiet = Signal.make(0)
  mode = Signal.make(0)
  seg = Signal.make(0)
  countLabel = Signal.map(count, n => s"count = $n")
  text <- Fs.read(path).handleErrorWith(_ => IO.pure(""))
  items = Signal.make(Tasks.loadItems(text))
  _ <- Ui.run(_ => View.appShell(View.appBar(View.bindText(title), View.wrap(View.textButton("Open tasks", _ => Signal.set(page, 1)), View.outlinedButton("Settings", _ => Signal.set(page, 2)))), View.indexBook(page, View.column(View.section("home", "Home", View.tabs(homeTab, View.column(View.section("counter", "Counter", View.column(View.heading(2, View.text("Counter")), View.bindText(countLabel), View.wrap(View.button("+1", _ => Signal.set(count, Signal.get(count) + 1)), View.outlinedButton("Reset counter", _ => Signal.set(count, 0))), View.text("Switch tabs or sections. The counter keeps its value."))), View.section("status", "Status", View.column(View.heading(2, View.text("Status")), View.slider(level), View.progress(level), View.text("The slider keeps its value when you switch tabs.")))))), View.section("tasks", "Tasks", View.column(View.wrap(View.maxSize(240, 0, View.textField(draft, "item")), View.button("Add", _ => for {
  _ = Property.sometimes("tappedAdd")
  d = Str.trim(Signal.get(draft))
  n = Str.len(d)
} yield if (n == 0) () else for {
  xs = List.append(Signal.get(items), Tasks.parseItem(d))
  _ = Signal.set(items, xs)
} yield Signal.set(draft, "")), View.verticalDivider(), View.circularProgress(level), View.switch(live, "On"), View.badge(count, View.chip(pin, "Pin")), View.button("Rename", _ => for {
  xs = Signal.get(items)
  ys = List.setAt(xs, 0, Item(0, "oat milk"))
} yield Signal.set(items, ys))), View.each(items, item => View.column(View.listTile(item.label, View.text(if (item.done == 1) "Done" else "Open")), View.wrap(View.iconButton("i", _ => ()), View.outlinedButton("Edit", _ => ()), View.textButton("Open", _ => ()), View.filterChip(star, "Tag"), View.choiceChip(mode, 0, "Day"), View.actionChip("Go", _ => ()), View.inputChip(star, "In"), View.button(if (item.done == 1) "Undo" else "Done", _ => for {
  _ = Property.sometimes("tappedDone")
} yield Signal.set(items, List.map(Signal.get(items), x => if (x == item) Tasks.flipItem(x) else x))), View.button("Del", _ => for {
  _ = Property.sometimes("tappedDel")
} yield Signal.set(items, List.filter(Signal.get(items), x => x != item)))))), View.button("Save", _ => for {
  xs = Signal.get(items)
  body = Tasks.saveItems(xs)
  _ <- Fs.write(path, body).handleErrorWith(_ => IO.pure(()))
} yield ()), View.button("Clear", _ => for {
  _ = Property.sometimes("tappedClear")
} yield Signal.set(items, [])))), View.section("preferences", "Preferences", View.column(View.divider(), View.unconstrainedBox(View.offstage(level, View.visibility(level, View.semantics("mark", View.placeholder(View.tooltip("Sean", View.inkWell("face", _ => (), View.avatar("S")))))))), View.checkboxListTile(star, "Star"), View.switchListTile(quiet, "Quiet"), View.radioListTile(mode, 1, "Night"), View.segmented(seg, "List", "Grid"), View.fab("+", _ => ()), View.expansionTile(more, "More", View.text("hint")))))))).require(Property.signalListLen("items") >= 0).require(Str.len(Property.signalListAt("items", Property.signalListLen("items"))) == 0).require(Str.len(Property.signalStr("draft")) >= 0).require(Signal.get(count) >= 0)
} yield ())
