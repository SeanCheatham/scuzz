def parseRoundTrip(s: String): Bool =
  Tasks.encodeItem(Tasks.parseItem(s)) == s

def flipTwice(s: String): Bool =
  Tasks.flipDone(Tasks.flipDone(s)) == s

def doneShowsUndo(t: Timeline): Verdict =
  Verdict.afterHit(t, "button:Done", "button:Undo")

def undoOnlyAfterDone(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "button:Undo") || Timeline.exists(t, j => j <= i && Timeline.lastHitHas(t, j, "button:Done")))

def clearEmpties(t: Timeline): Verdict =
  Verdict.or(Verdict.every(t, i => !Timeline.lastHitHas(t, i, "button:Clear")), Verdict.any(t, i => Timeline.lastHitHas(t, i, "button:Clear") && Timeline.exists(t, j => j >= i && !Timeline.a11yHas(t, j, "listtile:"))))

def delDropsOne(t: Timeline): Verdict =
  Verdict.every(t, i => i == 0 || !Timeline.lastHitHas(t, i, "button:Del") || Timeline.lastHitHas(t, i - 1, "button:Del") || Timeline.signalListLen(t, i, "items") == Timeline.signalListLen(t, i - 1, "items") - 1)

def rowsVanishOnlyAfterDelOrClear(t: Timeline): Verdict =
  Verdict.every(t, i => i == 0 || Timeline.signalListLen(t, i, "items") >= Timeline.signalListLen(t, i - 1, "items") || Timeline.lastHitHas(t, i, "button:Del") || Timeline.lastHitHas(t, i, "button:Clear"))

def parseHashRoundTrip(): Bool =
  Tasks.encodeItem(Tasks.parseItem("#milk")) == "#milk"

def parsePlainRoundTrip(): Bool =
  Tasks.encodeItem(Tasks.parseItem("milk")) == "milk"

def flipDoneTwice(): Bool =
  Tasks.flipDone(Tasks.flipDone("#milk")) == "#milk" && Tasks.flipDone(Tasks.flipDone("milk")) == "milk"

def itemStates(): Bool =
  Tasks.itemDone("#milk") == 1 && Tasks.itemDone("milk") == 0 && Tasks.itemLabel("#milk") == "milk"

def initialWidgets(t: Timeline): Verdict =
  Verdict.every(t, i => i != 0 || Timeline.a11yHas(t, i, "radio:Home=1") && Timeline.a11yHas(t, i, "radio:Tasks=0") && Timeline.a11yHas(t, i, "text:count = 0") && Timeline.a11yHas(t, i, "text:page = 0") && Timeline.a11yHas(t, i, "switch:On=0") && Timeline.a11yHas(t, i, "chip:Pin=0") && Timeline.a11yHas(t, i, "checktile:Star=0") && Timeline.a11yHas(t, i, "switchtile:Quiet=0") && Timeline.a11yHas(t, i, "radiotile:Night=0") && Timeline.a11yHas(t, i, "choicechip:Day=1") && Timeline.a11yHas(t, i, "segmented:0") && Timeline.a11yHas(t, i, "filterchip:Tag=0") && Timeline.a11yHas(t, i, "inputchip:In=0") && Timeline.a11yHas(t, i, "expansion:More=0"))

def plusOneIncrements(t: Timeline): Verdict =
  Verdict.every(t, i => i == 0 || !Timeline.lastHitHas(t, i, "button:+1") || Timeline.lastHitHas(t, i - 1, "button:+1") || Timeline.signalInt(t, i, "count") == Timeline.signalInt(t, i - 1, "count") + 1)

def countOnlyMovesOnPlusOne(t: Timeline): Verdict =
  Verdict.every(t, i => i == 0 || Timeline.signalInt(t, i, "count") == Timeline.signalInt(t, i - 1, "count") || Timeline.lastHitHas(t, i, "button:+1"))

def renameRenames(t: Timeline): Verdict =
  Verdict.every(t, i => i == 0 || !Timeline.lastHitHas(t, i, "button:Rename") || Timeline.lastHitHas(t, i - 1, "button:Rename") || Timeline.signalListLen(t, i - 1, "items") == 0 || Timeline.a11yHas(t, i, "listtile:oat"))

def addNeedsDraft(t: Timeline): Verdict =
  Verdict.every(t, i => i == 0 || !Timeline.lastHitHas(t, i, "button:Add") || Timeline.lastHitHas(t, i - 1, "button:Add") || !Timeline.signalStrHas(t, i - 1, "draft", "= \"\"") || Timeline.signalListLen(t, i, "items") == Timeline.signalListLen(t, i - 1, "items"))

def addGrowsWithDraft(t: Timeline): Verdict =
  Verdict.every(t, i => i == 0 || !Timeline.lastHitHas(t, i, "button:Add") || Timeline.lastHitHas(t, i - 1, "button:Add") || Timeline.signalStrHas(t, i - 1, "draft", "= \"\"") || Timeline.signalListLen(t, i, "items") == Timeline.signalListLen(t, i - 1, "items") + 1)

