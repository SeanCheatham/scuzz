def parseRoundTrip(s: String): Bool =
  Tasks.encodeItem(Tasks.parseItem(s)) == s

def flipTwice(s: String): Bool =
  Tasks.flipDone(Tasks.flipDone(s)) == s

def doneShowsUndo(t: Timeline): Verdict =
  Verdict.afterHit(t, "button:Done", "button:Undo")

def undoOnlyAfterDone(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "button:Undo") || Timeline.exists(t, j => j <= i && Timeline.lastHitHas(t, j, "button:Done")))

def clearEmpties(t: Timeline): Verdict =
  Verdict.or(Verdict.every(t, i => !Timeline.lastHitHas(t, i, "button:Clear")), Verdict.any(t, i => Timeline.lastHitHas(t, i, "button:Clear") && Timeline.exists(t, j => j >= i && !Timeline.a11yHas(t, j, "listtile:"))))

def delDropsOne(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Del", __tup => __tup match {
  case (before, after) => Timeline.signalListLen(t, after, "items") == Timeline.signalListLen(t, before, "items") - 1
})

def rowsVanishOnlyAfterDelOrClear(t: Timeline): Verdict =
  Verdict.stepEvery(t, __tup => __tup match {
  case (before, after) => Timeline.signalListLen(t, after, "items") >= Timeline.signalListLen(t, before, "items") || Timeline.lastHitHas(t, after, "button:Del") || Timeline.lastHitHas(t, after, "button:Clear")
})

def parseHashRoundTrip(): Bool =
  Tasks.encodeItem(Tasks.parseItem("#milk")) == "#milk"

def parsePlainRoundTrip(): Bool =
  Tasks.encodeItem(Tasks.parseItem("milk")) == "milk"

def flipDoneTwice(): Bool =
  Tasks.flipDone(Tasks.flipDone("#milk")) == "#milk" && Tasks.flipDone(Tasks.flipDone("milk")) == "milk"

def itemStates(): Bool =
  Tasks.itemDone("#milk") == 1 && Tasks.itemDone("milk") == 0 && Tasks.itemLabel("#milk") == "milk"

def addGrows(s: String): Bool =
  List.len(Tasks.addTo([], s)) == (if (Str.len(Str.trim(s)) == 0) 0 else 1)

def renameKeepsLen(s: String): Bool =
  List.len(Tasks.renameFirst(Item(0, "milk") :: [], s)) == 1

def deleteDrops(): Bool =
  List.isEmpty(Tasks.deleteLabel(Item(0, "milk") :: [], "milk"))

def flipToggles(): Bool =
  Tasks.flipLabel(Item(0, "milk") :: [], "milk") == Item(1, "milk") :: []

def clearDrops(): Bool =
  List.isEmpty(Tasks.clearAll(Item(0, "x") :: []))

def initialWidgets(t: Timeline): Verdict =
  Verdict.every(t, i => i != 0 || Timeline.a11yHas(t, i, "choicechip:Home=1") && Timeline.a11yHas(t, i, "choicechip:Tasks=0") && Timeline.a11yHas(t, i, "choicechip:Preferences=0") && Timeline.a11yHas(t, i, "text:count = 0") && Timeline.signalInt(t, i, "page") == 0)

def plusOneIncrements(t: Timeline): Verdict =
  Verdict.onHit(t, "button:+1", __tup => __tup match {
  case (before, after) => Timeline.signalInt(t, after, "count") == Timeline.signalInt(t, before, "count") + 1
})

def countOnlyMovesOnCounterActions(t: Timeline): Verdict =
  Verdict.stepEvery(t, __tup => __tup match {
  case (before, after) => Timeline.signalInt(t, after, "count") == Timeline.signalInt(t, before, "count") || Timeline.lastHitHas(t, after, "button:+1") || Timeline.lastHitHas(t, after, "outlined:Reset counter")
})

def renameRenames(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Rename", __tup => __tup match {
  case (before, after) => Timeline.signalListLen(t, before, "items") == 0 || Timeline.a11yHas(t, after, "listtile:oat")
})

def addNeedsDraft(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Add", __tup => __tup match {
  case (before, after) => !Timeline.signalStrHas(t, before, "draft", "") || Timeline.signalListLen(t, after, "items") == Timeline.signalListLen(t, before, "items")
})

def addGrowsWithDraft(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Add", __tup => __tup match {
  case (before, after) => Timeline.signalStrHas(t, before, "draft", "") || Timeline.signalListLen(t, after, "items") == Timeline.signalListLen(t, before, "items") + 1
})

