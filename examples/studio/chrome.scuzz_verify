def chrome(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, "choicechip:Home") && Timeline.a11yHas(t, i, "choicechip:Tasks") && Timeline.a11yHas(t, i, "choicechip:Preferences") && Timeline.a11yHas(t, i, "semantics:Index book"))

def activeSection(t: Timeline): Verdict =
  Verdict.every(t, i => if (Timeline.signalInt(t, i, "page") == 0) Timeline.a11yHas(t, i, "button:+1") && !Timeline.a11yHas(t, i, "button:Add") && !Timeline.a11yHas(t, i, "checktile:Star") else if (Timeline.signalInt(t, i, "page") == 1) Timeline.a11yHas(t, i, "button:Add") && Timeline.a11yHas(t, i, "button:Clear") && !Timeline.a11yHas(t, i, "button:+1") && !Timeline.a11yHas(t, i, "checktile:Star") else Timeline.a11yHas(t, i, "checktile:Star") && Timeline.a11yHas(t, i, "switchtile:Quiet") && !Timeline.a11yHas(t, i, "button:Add") && !Timeline.a11yHas(t, i, "button:+1"))

