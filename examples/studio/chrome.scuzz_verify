def chrome(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, "button:Add") && Timeline.a11yHas(t, i, "button:Clear") && Timeline.a11yHas(t, i, "radio:Home") && Timeline.a11yHas(t, i, "radio:Tasks") && Timeline.a11yHas(t, i, "switch:On") && Timeline.a11yHas(t, i, "chip:Pin") && Timeline.a11yHas(t, i, "badge:") && Timeline.a11yHas(t, i, "card:") && Timeline.a11yHas(t, i, "divider:") && Timeline.a11yHas(t, i, "expansion:") && Timeline.a11yHas(t, i, "vdiv:") && Timeline.a11yHas(t, i, "circular:") && Timeline.a11yHas(t, i, "avatar:") && Timeline.a11yHas(t, i, "checktile:") && Timeline.a11yHas(t, i, "switchtile:") && Timeline.a11yHas(t, i, "radiotile:") && Timeline.a11yHas(t, i, "segmented:") && Timeline.a11yHas(t, i, "fab:") && Timeline.a11yHas(t, i, "tooltip:") && Timeline.a11yHas(t, i, "placeholder:") && Timeline.a11yHas(t, i, "semantics:") && Timeline.a11yHas(t, i, "inkwell:") && Timeline.a11yHas(t, i, "visibility:") && Timeline.a11yHas(t, i, "offstage:") && Timeline.a11yHas(t, i, "unconstrained:"))

