def chrome(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, "choicechip:Home") && Timeline.a11yHas(t, i, "choicechip:Tasks") && Timeline.a11yHas(t, i, "choicechip:Preferences") && Timeline.a11yHas(t, i, "semantics:Index book"))

def activeSection(t: Timeline): Verdict =
  Verdict.every(t, i => if (Timeline.signalInt(t, i, "page") == 0) (if (Timeline.signalInt(t, i, "homeTab") == 0) Timeline.a11yHas(t, i, "button:+1") else Timeline.a11yHas(t, i, "tabpanel:Status")) && !Timeline.a11yHas(t, i, "button:Add") && !Timeline.a11yHas(t, i, "checktile:Star") else if (Timeline.signalInt(t, i, "page") == 1) Timeline.a11yHas(t, i, "button:Add") && Timeline.a11yHas(t, i, "button:Clear") && !Timeline.a11yHas(t, i, "button:+1") && !Timeline.a11yHas(t, i, "tabpanel:Status") && !Timeline.a11yHas(t, i, "checktile:Star") else Timeline.a11yHas(t, i, "checktile:Star") && Timeline.a11yHas(t, i, "switchtile:Quiet") && !Timeline.a11yHas(t, i, "button:Add") && !Timeline.a11yHas(t, i, "button:+1"))

def appBar(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, "appbar:App bar") && Timeline.a11yHas(t, i, "heading:1") && Timeline.a11yHas(t, i, "textbutton:Open tasks") && Timeline.a11yHas(t, i, "outlined:Settings"))

def activeTab(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "page") != 0 || (if (Timeline.signalInt(t, i, "homeTab") == 0) Timeline.a11yHas(t, i, "tabpanel:Counter") && !Timeline.a11yHas(t, i, "tabpanel:Status") else Timeline.a11yHas(t, i, "tabpanel:Status") && !Timeline.a11yHas(t, i, "button:+1")))

