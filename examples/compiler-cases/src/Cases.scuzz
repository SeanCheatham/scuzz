def bounded(seed: Int): Int =
  seed % 4096

def family(seed: Int): Int =
  bounded(seed) % 6

def input(seed: Int): Int =
  bounded(seed) / 6 % 17 - 8

def depth(seed: Int): Int =
  bounded(seed) / 102 % 3 + 1

def number(n: Int): String =
  if (n < 0) s"(0 - ${0 - n})" else Str.fromInt(n)

def model(seed: Int, levels: Int, x: Int): Int =
  if (levels == 0) x else for {
  value = model(seed / 4, levels - 1, x)
  amount = seed % 5 + 1
} yield (seed % 4) match {
  case 0 => value + amount
  case 1 => value - amount
  case 2 => if (value < 0) 0 - value else value
  case _ => value * 2
}

def expression(seed: Int, levels: Int): String =
  if (levels == 0) "x" else for {
  inner = expression(seed / 4, levels - 1)
  amount = Str.fromInt(seed % 5 + 1)
} yield (seed % 4) match {
  case 0 => s"($inner + $amount)"
  case 1 => s"(for { value = $inner } yield value - $amount)"
  case 2 => s"($inner match { case value if value < 0 => for { result = 0 - value } yield result case value => for { result = value } yield result })"
  case _ => s"((value: Int) => value * 2)($inner)"
}

def value(seed: Int): Int =
  model(bounded(seed) / 6, depth(seed), input(seed))

def result(seed: Int): String =
  family(seed) match {
    case 0 => s"match:${value(seed)}"
    case 1 => s"closure:${value(seed) + 3}"
    case 2 => s"box:${value(seed)}:1"
    case 3 => s"heap:${value(seed)}:${value(seed) + 1}"
    case 4 => s"list:${value(seed) * 3 + 3}"
    case _ => s"io:${value(seed)}"
  }

def output(seed: Int): String =
  if (family(seed) == 5) Str.concat(result(seed), ":2") else result(seed)

def body(seed: Int): String =
  for {
    expr = expression(bounded(seed) / 6, depth(seed))
    prefix = """def calculate(x: Int): Int =
  """
    calculation = Str.concat(prefix, Str.concat(expr, """

"""))
    code = family(seed) match {
  case 0 => "enum Packet:\n  case Wrap(value: Option[(Int, String)], skip: List[Int], unit: Unit)\n  case Empty\n\ndef f(x: Int): String =\n  Packet.Wrap(Some((calculate(x), \"match\")), [x, x + 1], ()) match {\n    case Packet.Wrap(Some((n, label)), _, (())) => s\"$label:$n\"\n    case _ => \"empty\"\n  }\n"
  case 1 => "def f(x: Int): String =\n  (x < 0) match {\n    case true => for {\n      n = calculate(x)\n      label = \"closure\"\n      add = (offset: Int) => s\"$label:${n + offset}\"\n      alias = add\n    } yield alias(3)\n    case false => for {\n      n = calculate(x)\n      label = \"closure\"\n      add = (offset: Int) => s\"$label:${n + offset}\"\n    } yield add(3)\n  }\n"
  case 2 => "type BoxMarker = Int\ntype BoxLabel = String\nrecord Box[T](marker: BoxMarker, label: BoxLabel, value: T)\n\ndef wrap[T](value: T): Box[T] =\n  Box(1, \"extra\", value)\n\ndef f(x: Int): String =\n  for {\n    box = wrap([s\"box:${calculate(x)}\", \"tail\"])\n    head :: tail = box.value\n    (text, size) = (head, List.len(tail))\n  } yield s\"$text:${size * box.marker}\"\n"
  case 3 => "def pair(x: Int): (List[Int], String) =\n  (List.map([calculate(x), calculate(x) + 1], n => n), \"heap\")\n\ndef f(x: Int): String =\n  s\"${pair(x)._2}:${List.at(pair(x)._1, 0)}:${List.at(pair(x)._1, 1)}\"\n"
  case 4 => "def sum(values: List[Int]): Int =\n  values match {\n    case head :: tail => head + sum(tail)\n    case [] => 0\n  }\n\ndef f(x: Int): String =\n  for {\n    n = calculate(x)\n    values = List.map([n, n + 1, n + 2], item => item)\n  } yield s\"list:${sum(values)}\"\n"
  case _ => "def f(x: Int): String =\n  s\"io:${calculate(x)}\"\n"
}
    emit = if (family(seed) == 5) "\ndef emit(x: Int): IO[Unit] =\n  IO.pure((f(x), [x, x + 1])).flatMap(pair => IO.println(s\"${pair._1}:${List.len(pair._2)}\"))\n" else """
def emit(x: Int): IO[Unit] =
  IO.println(f(x))
"""
  } yield Str.concat(calculation, Str.concat(Str.replace(Str.replace(code, "Packet", s"Packet${bounded(seed)}"), "Box", s"Box${bounded(seed)}"), emit))

def source(seed: Int): String =
  Str.concat(body(seed), s"\n@main def main: IO[Unit] =\n  emit(${number(input(seed))})\n")

def invalid(seed: Int): String =
  Str.concat(source(seed), (seed % 4) match {
  case 0 => """
def invalid(): String =
  1
"""
  case 1 => """
def invalid[T](value: T): T =
  1
"""
  case 2 => """
def invalid(): Int =
  List.len(1)
"""
  case _ => """
def invalid(): Int =
  ((text: String) => Str.len(text))(1)
"""
})

def checked(seed: Int): Bool =
  Check.check(source(seed)) == "[]"

def rejected(seed: Int): Bool =
  Str.contains(Check.check(invalid(seed)), "type error")

def roundtrip(seed: Int): Bool =
  for {
    original = source(seed)
    pretty = Parse.pretty(Parse.parse(Lexer.lex(original)))
    again = Parse.pretty(Parse.parse(Lexer.lex(pretty)))
    program = Eval.load([("Main", pretty)])
    got = Eval.show(Eval.callPure(program, "Main", "f", [Value.VInt(input(seed))]))
  } yield checked(seed) && pretty == again && Check.check(pretty) == "[]" && got == Eval.show(Value.VStr(result(seed)))

def evaluated(seed: Int): Bool =
  for {
    program = Eval.load([("Main", source(seed))])
    got = Eval.show(Eval.callPure(program, "Main", "f", [Value.VInt(input(seed))]))
  } yield checked(seed) && got == Eval.show(Value.VStr(result(seed)))

def coveragePair(i: Int): String =
  Str.concat(if (i / 2 == 0) "false" else "true", Str.concat(", ", if (i % 2 == 0) "false" else "true"))

def coveragePattern(kind: Int, i: Int): String =
  if (kind == 0) Str.concat("(", Str.concat(coveragePair(i), ")")) else if (kind == 1) Str.concat("Some((", Str.concat(coveragePair(i), "))")) else if (kind == 2) Str.concat("Flags.Bits(", Str.concat(coveragePair(i), ")")) else Str.concat("Result.Ok((", Str.concat(coveragePair(i), "))"))

def coverageArms(mask: Int, kind: Int, guarded: Bool, i: Int): String =
  if (i == 4) "" else Str.concat(if (mask % 2 == 0) "" else Str.concat("    case ", Str.concat(coveragePattern(kind, i), Str.concat(if (guarded) " if true" else "", Str.concat(" => ", Str.concat(Str.fromInt(i), """
"""))))), coverageArms(mask / 2, kind, guarded, i + 1))

def coverageSource(seed: Int): String =
  for {
    kind = seed / 16 % 4
    ty = if (kind == 0) "(Bool, Bool)" else if (kind == 1) "Option[(Bool, Bool)]" else if (kind == 2) "Flags" else "Result[String, (Bool, Bool)]"
    prefix = if (kind == 2) """enum Flags:
  case Bits(a: Bool, b: Bool)
  case Empty

""" else ""
    extra = if (kind == 0) "" else if (kind == 1) """    case None => 4
""" else if (kind == 2) """    case Flags.Empty => 4
""" else """    case Result.Err(_) => 4
"""
  } yield Str.concat(prefix, Str.concat("def select(value: ", Str.concat(ty, Str.concat("""): Int =
  value match {
""", Str.concat(coverageArms(seed % 16, kind, seed / 64 % 2 == 1, 0), Str.concat(extra, """  }

@main def main: IO[Unit] =
  IO.pure(())
"""))))))

def coverageChecked(seed: Int): Bool =
  for {
    result = Check.check(coverageSource(seed))
    complete = seed % 16 == 15 && seed / 64 % 2 == 0
  } yield if (complete) result == "[]" else Str.contains(result, if (seed % 16 == 0 && seed / 16 % 4 == 0) "match has no arms" else "non-exhaustive match on")

def caseSeeds(): List[Int] =
  List.flatMap([0, 102, 204], level => List.flatMap([0, 48, 96], arg => List.map([0, 1, 2, 3, 4, 5], kind => level + arg + kind)))

def exported(seed: Int): Json =
  Json.Obj([("seed", Json.Int(seed)), ("modules", moduleExport(seed)), ("family", Json.Int(family(seed))), ("input", Json.Int(input(seed))), ("body", Json.Str(body(seed))), ("source", Json.Str(source(seed))), ("invalid", Json.Str(invalid(seed))), ("result", Json.Str(result(seed))), ("output", Json.Str(output(seed)))])

def moduleA(): String =
  "record Box[T](value: T)\nrecord Marker()\nenum Choice[T]:\n  case Wrap(box: Box[T])\n  case End\ntype Payload = Choice[String]\ndef make(): Payload = Choice.Wrap(Box(\"alpha\"))\ndef read(c: Payload): Int =\n  c match {\n    case Choice.Wrap(Box(text)) => Str.len(text)\n    case Choice.End => 0\n  }\ndef shadow(Box: String): Int = Str.len(Box)\ndef call(x: String, y: String, z: String): String = Str.concat(x, Str.concat(y, z))\ndef score(m: Marker): Int = m.score(1)\ntrait Score:\n  def score(n: Int): Int\nimpl Score for Marker:\n  def score(n: Int): Int = n + 1\n"

def moduleB(seed: Int): String =
  Str.concat("""record Box[T](marker: String, value: T)
record Marker()
enum Choice[T]:
  case Wrap(marker: Int, box: Box[T])
  case End
type Payload = Choice[Int]
def make(): Payload = Choice.Wrap(""", Str.concat(Str.fromInt(seed), Str.concat(", Box(\"unused\", ", Str.concat(Str.fromInt(seed + 1), """))
def read(c: Payload): Int =
  c match {
    case Choice.Wrap(n, Box(_, value)) => n + value
    case Choice.End => 0
  }
def score(m: Marker): Int = m.score(1)
trait Score:
  def score(n: Int): Int
impl Score for Marker:
  def score(n: Int): Int = n + 2
"""))))

def moduleMain(): String =
  "import A.Box as First\nrecord Holder(value: Int)\nrecord Callbacks(run: List[String => String])\ndef forward(value: String): String = value\ndef callback(): String = List.at(Callbacks([call => forward(call)]).run, 0)(\"kept\")\ndef qualified(c: A.Choice[String]): Int =\n  c match {\n    case A.Choice.Wrap(A.Box(text)) => Str.len(text)\n    case A.Choice.End => 0\n  }\ndef imported(x: First[String]): String = x.value\ndef shadow(A: Holder): Int = A.value\ndef folded(): String = List.foldLeft([A.Box(\"a\"), A.Box(\"b\")], \"\", entry => Str.concat(entry._1, entry._2.value))\ndef result(): Int = Str.len(callback()) - 4 + Str.len(folded()) + A.read(A.make()) + B.read(B.make()) + qualified(A.make()) + Str.len(imported(First(\"abc\"))) + A.score(A.Marker()) + B.score(B.Marker())\n@main def main: IO[Unit] =\n  IO.println(Str.fromInt(result()))\n"

def moduleFiles(seed: Int, reverse: Bool): List[(String, String)] =
  List.concat(if (reverse) [("B", moduleB(seed)), ("A", moduleA())] else [("A", moduleA()), ("B", moduleB(seed))], [("Main", moduleMain())])

def moduleChecked(seed: Int): Bool =
  Check.checkFiles(moduleFiles(seed % 6, false)) == "[]" && Check.checkFiles(moduleFiles(seed % 6, true)) == "[]"

def moduleExport(seed: Int): Json =
  Json.Arr(List.map(moduleFiles(seed % 6, false), pair => Json.Arr([Json.Str(pair._1), Json.Str(pair._2)])))

@main def main: IO[Unit] =
  Json.stringify(Json.Arr(List.map(Cases.caseSeeds(), seed => Cases.exported(seed)))) match {
    case Result.Ok(text) => IO.println(text)
    case Result.Err(error) => IO.fail(error)
  }
