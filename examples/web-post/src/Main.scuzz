def sent(): String =
  "pong"

def externalUrl(): String =
  "https://example.com/live"

def rejected(message: String): Bool =
  Str.contains(message, "no stub for URL") || Str.contains(message, "non-loopback")

def loaded(response: (Int, Map[String, String], String)): String =
  response match {
    case (status, _, body) => s"web-post:${Str.fromInt(status)}:$body"
  }

def lineFor(sim: String, url: String): IO[String] =
  if (sim == "1" && url == "") IO.attempt(Net.httpPost(externalUrl(), Map.empty(), sent())).map(result => result match {
  case Result.Ok(_) => "web-post:live"
  case Result.Err(message) => if (rejected(message)) "sim:rejected" else message
}) else if (url == "") IO.pure("web-post:missing") else Net.httpPost(url, Map.empty(), sent()).map(response => loaded(response))

@main def main: IO[Unit] =
  for {
    sim <- Sys.getenv("SCUZZ_TESTRT")
    url <- Sys.getenv("SCUZZ_WEB_POST")
    line <- lineFor(sim, url)
    _ <- IO.println(line)
    _ <- if (url == "") IO.pure(()) else Ui.run(_ => View.column([View.text("Web post"), View.text(line)]))
  } yield ()
