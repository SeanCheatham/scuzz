oracle fmtHi(): Bool =
  Main.fmtDiff(Main.srcHi(), Main.wantHi())

oracle fmtPriv(): Bool =
  Main.fmtDiff(Main.srcPriv(), Main.wantPriv())

oracle fmtOra(): Bool =
  Main.lexKindAt("oracle hidden", 0) == 61 && Main.fmtDiff(Main.srcOra(), Main.wantOra()) && Main.fmtIdem(Main.srcOra())

oracle fmtHello(): Bool =
  Main.fmtDiff(Main.srcHello(), Main.wantHello())

oracle fmtAdd(): Bool =
  Main.fmtDiff(Main.srcAdd(), Main.wantAdd())

oracle fmtEnum(): Bool =
  Main.fmtDiff(Main.srcEnum(), Main.wantEnum())

oracle fmtOpt(): Bool =
  Main.fmtDiff(Main.srcOpt(), Main.wantOpt())

oracle fmtFor(): Bool =
  Main.fmtDiff(Main.srcFor(), Main.wantFor()) && Main.fmtDiff(Main.srcForIf(), Main.wantForIf()) && Main.fmtIdem(Main.srcForIf())

oracle fmtIf(): Bool =
  Main.fmtDiff(Main.srcIf(), Main.wantIf())

oracle fmtRec(): Bool =
  Main.fmtDiff(Main.srcRec(), Main.wantRec())

oracle fmtType(): Bool =
  Main.fmtDiff(Main.srcType(), Main.wantType())

oracle fmtImp(): Bool =
  Main.fmtDiff(Main.srcImp(), Main.wantImp())

oracle fmtTrait(): Bool =
  Main.fmtDiff(Main.srcTrait(), Main.wantTrait())

oracle fmtWhere(): Bool =
  Main.fmtDiff(Main.srcWhere(), Main.wantWhere())

oracle fmtFloat(): Bool =
  Main.fmtDiff(Main.srcFloat(), Main.wantFloat())

oracle fmtList(): Bool =
  Main.fmtDiff(Main.srcList(), Main.wantList())

oracle fmtTup(): Bool =
  Main.fmtDiff(Main.srcTup(), Main.wantTup())

oracle fmtGet(): Bool =
  Main.fmtDiff(Main.srcGet(), Main.wantGet())

oracle fmtPkg(): Bool =
  Main.fmtDiff(Main.srcPkg(), Main.wantPkg())

oracle fmtTriple(): Bool =
  Main.fmtDiff(Main.srcTriple(), Main.wantTriple())

oracle fmtCons(): Bool =
  Main.fmtDiff(Main.srcCons(), Main.wantCons()) && Main.fmtDiff(Main.srcConsL(), Main.wantConsL()) && Main.fmtIdem(Main.srcConsL()) && Main.fmtDiff(Main.srcConsEq(), Main.wantConsEq()) && Main.fmtIdem(Main.srcConsEq()) && Main.fmtDiff(Main.srcConsMul(), Main.wantConsMul()) && Main.fmtIdem(Main.srcConsMul())

oracle fmtGuard(): Bool =
  Main.fmtDiff(Main.srcGuard(), Main.wantGuard())

oracle fmtDefArg(): Bool =
  Main.fmtDiff(Main.srcDefArg(), Main.wantDefArg())

oracle fmtTDef(): Bool =
  Main.fmtDiff(Main.srcTDef(), Main.wantTDef())

oracle fmtNamed(): Bool =
  Main.fmtDiff(Main.srcNamed(), Main.wantNamed())

oracle fmtCopy(): Bool =
  Main.fmtDiff(Main.srcCopy(), Main.wantCopy())

oracle fmtOr(): Bool =
  Main.fmtDiff(Main.srcOr(), Main.wantOr())

oracle fmtBits(): Bool =
  Main.fmtDiff(Main.srcBits(), Main.wantBits())

oracle fmtHex(): Bool =
  Main.fmtDiff(Main.srcHex(), Main.wantHex()) && Main.fmtDiff(Main.srcAsc(), Main.wantAsc()) && Main.fmtDiff(Main.srcLamTy(), Main.wantLamTy()) && Main.format(Main.srcBinBad()) != Main.wantBinWrong()

oracle fmtIdemHi(): Bool =
  Main.fmtIdem(Main.srcHi())

oracle fmtIdemHello(): Bool =
  Main.fmtIdem(Main.srcHello())

oracle fmtIdemEnum(): Bool =
  Main.fmtIdem(Main.srcEnum())

oracle fmtIdemFor(): Bool =
  Main.fmtIdem(Main.srcFor())

oracle truncatedDefinitions(): Bool =
  Parse.hasParseError(Parse.parse(Lexer.lex("def setup(:"))) && Parse.hasParseError(Parse.parse(Lexer.lex("def value(): Int ="))) && Parse.hasParseError(Parse.parse(Lexer.lex("@main def main: IO[Unit] ="))) && Parse.hasParseError(Parse.parse(Lexer.lex("oracle hidden(n: Int): Bool ="))) && Parse.hasParseError(Parse.parse(Lexer.lex("private oracle hidden(): Bool = true"))) && !Parse.hasParseError(Parse.parse(Lexer.lex("private def hidden(): Bool = true")))

oracle truncatedOperands(): Bool =
  Parse.hasParseError(Parse.parse(Lexer.lex("def value(): Int = 1 +"))) && Parse.hasParseError(Parse.parse(Lexer.lex("def value(): Bool = true &&"))) && Parse.hasParseError(Parse.parse(Lexer.lex("def value(): Int = if (true) 1 else"))) && !Parse.hasParseError(Parse.parse(Lexer.lex("def value(): Int = 1")))

