  "enum Opt:\n  case Some(x: Int)\n  case None\n@main def main: IO[Unit] =\n  Opt.Some(0) match {\n    case Opt.Some(0 | 1) => IO.println(\"s\")\n    case Opt.Some(_) => IO.println(\"o\")\n    case Opt.None => IO.println(\"n\")\n  }"

def wantOr2(): String =
  "enum Opt:\n  case Some(x: Int)\n  case None\n\n@main def main: IO[Unit] =\n  Opt.Some(0) match {\n    case Opt.Some(0 | 1) => IO.println(\"s\")\n    case Opt.Some(_) => IO.println(\"o\")\n    case Opt.None => IO.println(\"n\")\n  }\n"

