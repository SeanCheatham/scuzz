def srcTDef(): String =
  """enum Opt[T]:
  case Some(x: T)
  case None
def getOrElse[T](o: Opt[T], default: T): T = o match {
  case Opt.Some(x) => x
  case Opt.None => default
}
@main def main: IO[Unit] = IO.println(Str.fromInt(getOrElse(Opt.Some(1), 0)))"""

def wantTDef(): String =
  """enum Opt[T]:
  case Some(x: T)
  case None

def getOrElse[T](o: Opt[T], default: T): T =
  o match {
    case Opt.Some(x) => x
    case Opt.None => default
  }

@main def main: IO[Unit] =
  IO.println(Str.fromInt(getOrElse(Opt.Some(1), 0)))
"""

