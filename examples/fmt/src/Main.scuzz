def srcOpt(): String =
  """enum Opt[T]:
  case Some(x: T)
  case None
def get(o: Opt[Int]): Int = o match {
    case Opt.Some(n) => n
    case Opt.None => 0
  }
@main def main: IO[Unit] = IO.println(Str.fromInt(get(Opt.Some(1))))"""

def wantOpt(): String =
  """enum Opt[T]:
  case Some(x: T)
  case None

def get(o: Opt[Int]): Int =
  o match {
    case Opt.Some(n) => n
    case Opt.None => 0
  }

@main def main: IO[Unit] =
  IO.println(Str.fromInt(get(Opt.Some(1))))
"""

