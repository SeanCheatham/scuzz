law countNonNeg: Bool =
  Law.signalInt(0) >= 0

law hasHome: Bool =
  Law.a11yHas("button:Home")

law hasOther: Bool =
  Law.a11yHas("button:Other")

@main def main: IO[Unit] =
  for {
    page = Signal.int(0)
    count = Signal.int(0)
    countLabel = Signal.map(count, n => s"count = $n")
    pageLabel = Signal.map(page, n => s"page = $n")
    _ <- Ui.run(_ => View.column(View.row(View.button("Home", _ => Signal.set(page, 0)), View.expanded(View.bindText(pageLabel)), View.button("Other", _ => Signal.set(page, 1))), View.showWhen(page, 0, View.padding(8, View.column(View.aspectRatio(6, 1, View.background(Color.rgb(61, 126, 166), View.center(View.icon(43, Theme.accent())))), View.fraction(50, 0, View.background(Color.rgb(230, 240, 248), View.padding(4, View.icon(43, Theme.accent())))), View.text("Home"), View.bindText(countLabel), View.button("+1", _ => Signal.set(count, Signal.get(count) + 1))))), View.showWhen(page, 1, View.expanded(View.align(2, 2, View.column(View.text("Other"), View.bindText(pageLabel)))))))
  } yield ()
