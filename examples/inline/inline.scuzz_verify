def countLabelFollowsValue(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, Str.concat("text:Count: ", Str.fromInt(Timeline.signalInt(t, i, "count")))))

def lastLabelFollowsValue(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, Str.concat("text:Last action: ", Str.fromInt(Timeline.signalInt(t, i, "last")))))

def addChangesCount(t: Timeline): Verdict =
  Verdict.onHit(t, "textbutton:add one", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "count") == Timeline.signalInt(t, before, "count") + 1 && Timeline.signalInt(t, after, "last") == 1
})

def resetClearsCount(t: Timeline): Verdict =
  Verdict.onHit(t, "textbutton:reset", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "count") == 0 && Timeline.signalInt(t, after, "last") == 2
})

def dialogFollowsState(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "open") != 0 == Timeline.a11yHas(t, i, "button:Close"))

def openShowsDialog(t: Timeline): Verdict =
  Verdict.onHit(t, "textbutton:open the details dialog across wrapped lines", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "open") == 1 && Timeline.signalInt(t, after, "last") == 3
})

def closeHidesDialog(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Close", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "open") == 0
})

def minimumKeepsItsKey(t: Timeline): Verdict =
  Verdict.onHit(t, "textbutton:Minimum", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "last") == -9223372036854775808
})

def maximumKeepsItsKey(t: Timeline): Verdict =
  Verdict.onHit(t, "textbutton:Maximum", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "last") == 9223372036854775807
})

def elidedActionsStayInactive(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "last") != 99 && Timeline.signalInt(t, i, "last") != 8 && !Timeline.a11yHas(t, i, "textbutton:Hidden action"))

def startsWithoutActions(t: Timeline): Verdict =
  Verdict.every(t, i => i != 0 || Timeline.signalInt(t, i, "count") == 0 && Timeline.signalInt(t, i, "last") == 0 && Timeline.signalInt(t, i, "open") == 0)

