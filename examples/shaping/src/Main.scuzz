@main def main: IO[Unit] =
  for {
    count = Signal.make(0)
    name = Signal.make("אב")
    showParagraphs = Signal.make(0)
    countText = Signal.map(count, n => s"Count: $n")
    valueText = Signal.map(name, value => s"Value: $value")
    lre = Hex.decode("e280aa")
    rle = Hex.decode("e280ab")
    rlo = Hex.decode("e280ae")
    pdf = Hex.decode("e280ac")
    rli = Hex.decode("e281a7")
    pdi = Hex.decode("e281a9")
    paragraphs = ["שלום ABCDEF אב", "WWWWWW אבגד AB", """שלום
ABCDEF אב""", s"${rle}WWWWWW ABCDEF אב${pdf}", s"${rli}WWWWWW ABCDEF אב${pdi}", s"${rlo}WWWWWW ABCDEF אב${pdf}", "שלום 12: AB אב!", "WWWWWW 12 אב AB!", s"WWWWWW AB${lre}CD${pdf}EF אב", "WWWWWW אב[ אבגדה ] AB"]
    paragraphAction = Text.action(17, Text.concat([Text.span("שלום "), Text.color(Color.rgb(22, 92, 160), Text.span("ABCDEF ")), Text.span("אב")]))
    _ <- Ui.run(_ => View.expanded(1, View.scroll(View.column([View.column([View.text("AV fi é"), View.fontSize(24, View.richText(Text.concat([Text.span("الس"), Text.color(Color.rgb(22, 92, 160), Text.span("لام")), Text.span(" عليكم")]))), View.fontSize(24, View.text("اب AB 12")), View.fontSize(24, View.text("ab אב 12")), View.richText(Text.bold(Text.span("لا"))), View.richText(Text.italic(Text.span("é fi"))), View.maxSize(80, 0, View.text("éééééééééé")), View.maxSize(60, 0, View.maxLines(1, View.ellipsis(View.richText(Text.span("éééééééééé"))))), View.actionText(Text.action(11, Text.concat([Text.span("تف"), Text.color(Color.rgb(22, 92, 160), Text.span("اصيل"))])), key => Signal.set(count, Signal.get(count) + key)), View.textField(name, "Name"), View.wrap([View.button("Set Arabic", _ => Signal.set(name, "لا")), View.button("Set Latin", _ => Signal.set(name, "AV fi é")), View.button("Add", _ => Signal.set(count, Signal.get(count) + 1))]), View.bindText(countText), View.bindText(valueText), View.sized(280, 48, View.scrollH(View.text(Str.repeat("M", 400)))), View.richText(Text.span("नमस्ते สวัสดี 中文漢字")), View.text("क्षि ปู่ 中文")]), View.expansionTile(showParagraphs, "Paragraphs", View.fontSize(18, View.column([View.column(List.map(paragraphs, source => View.maxSize(114, 0, View.text(source)))), View.maxSize(114, 0, View.maxLines(1, View.ellipsis(View.richText(Text.span("שלום עולם ארוך מאוד"))))), View.maxSize(114, 0, View.maxLines(1, View.ellipsis(View.text("אבגדהוזחטיכלמנסע סוף")))), View.maxSize(114, 0, View.actionText(paragraphAction, key => Signal.set(count, Signal.get(count) + key)))])))]))))
  } yield ()
