م""")), Text.span("ر")]), Text.concat([Text.bold(Text.span(s"${lro}م")), Text.span(s"ر${pdf}")]), Text.concat([Text.bold(Text.span(s"${lro}م")), Text.span(s"م${pdf}")]), Text.concat([Text.bold(Text.span(s"${rlo}Aم")), Text.span(s"ر${pdf}")]), Text.concat([Text.bold(Text.span("م")), Text.span(s"${rlo}ر${pdf}")]), Text.concat([Text.bold(Text.span("م")), Text.span(s"${rli}ر${pdi}")]), Text.concat([Text.bold(Text.span(s"${lro}مع")), Text.span(s"م${pdf}")]), Text.concat([Text.bold(Text.span(s"${lro}fiم")), Text.span(s"م${pdf}")]), Text.concat([Text.span("م"), Text.span(s"${rli}${pdi}ر")]), Text.concat([Text.bold(Text.span("م")), Text.span(s"${rli}${pdi}ر")])]
    joiningWrap = Text.concat([Text.bold(Text.span("م")), Text.span("ر")])
