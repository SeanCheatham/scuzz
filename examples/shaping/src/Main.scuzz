    joiningPairEllipsis = Text.concat([Text.bold(Text.span("م")), Text.span(Str.concat(Str.repeat("م", 9), "د"))])
    joiningAction = Text.action(31, Text.concat([Text.bold(Text.span("مح")), Text.span("مد")]))
