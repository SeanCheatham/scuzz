def cardsStayAvailable(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, "button:First") && Timeline.a11yHas(t, i, "button:Second") && Timeline.a11yHas(t, i, "button:Third"))

def selectionStaysValid(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "selected") >= 0 && Timeline.signalInt(t, i, "selected") <= 3)

def firstSelects(t: Timeline): Verdict =
  Verdict.onHit(t, "button:First", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "selected") == 1
})

def secondSelects(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Second", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "selected") == 2
})

def thirdSelects(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Third", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "selected") == 3
})

def startsUnselected(t: Timeline): Verdict =
  Verdict.every(t, i => i != 0 || Timeline.signalInt(t, i, "selected") == 0)

def pictureStaysAvailable(t: Timeline): Verdict =
  Verdict.alwaysHas(t, "image:Color sample")

