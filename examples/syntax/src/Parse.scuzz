enum Expr:
  case EInt(n: Int, off: Int)
  case EBool(b: Bool)
  case EStr(s: String, off: Int)
  case EVar(s: String, off: Int)
  case EHole
  case EUnit
  case EPrint(e: Expr, off: Int)
  case ECall(f: String, args: List[Expr], off: Int)
  case EMethod(recv: Expr, name: String, args: List[Expr], off: Int)
  case EField(recv: Expr, name: String, off: Int)
  case EBin(op: String, l: Expr, r: Expr, off: Int)
  case EUn(op: String, e: Expr, off: Int)
  case ELam(p: String, ty: String, body: Expr)
  case EIf(c: Expr, t: Expr, e: Expr, off: Int)
  case EMatch(s: Expr, arms: List[Arm], off: Int)
  case EFor(bs: List[Bind], body: Expr, off: Int)
  case EFloat(s: String, off: Int)
  case EInterp(s: String, parts: List[Expr], off: Int)
  case EList(xs: List[Expr])
  case ETuple(xs: List[Expr])
  case ENamed(name: String, e: Expr)
  case EAscribe(e: Expr, ty: String, off: Int)

record Param(name: String, ty: String, w: String, d: String)

record Fun(priv: Bool, ora: Bool, name: String, tparams: List[String], params: List[Param], ret: String, body: Expr, mod: String, off: Int)

record Arm(pat: String, g: String, body: Expr)

record Bind(draw: Bool, name: String, value: Expr)

record EnCase(name: String, fields: List[Param])

record En(isRec: Bool, name: String, tparams: List[String], cases: List[EnCase], mod: String, privateCtor: Bool)

record Alias(name: String, tparams: List[String], target: String, mod: String)

record Imp(mod: String, name: String, alias: String, owner: String)

record TrMethod(name: String, params: List[Param], ret: String)

record Tr(name: String, tparams: List[String], methods: List[TrMethod], mod: String)

record Im(tn: String, targs: List[String], forTy: String, methods: List[Fun], mod: String)

record Prog(pkg: String, enums: List[En], aliases: List[Alias], traits: List[Tr], impls: List[Im], imps: List[Imp], defs: List[Fun], main: String, body: Expr, mod: String)

record Toks(groups: List[List[List[SpTok]]], n: Int, bad: Int)

record ErrAt(off: Int, hint: String)

import Lexer.Tok
import Lexer.SpTok

def tokChunk(): Int =
  32

def tokGroup(): Int =
  tokChunk() * tokChunk()

def indexToks(toks: List[SpTok]): Toks =
  indexToksGo(toks, 0, [], [], 0, 0 - 1)

def indexToksGo(toks: List[SpTok], n: Int, cur: List[SpTok], acc: List[List[SpTok]], total: Int, bad: Int): Toks =
  if (List.isEmpty(toks)) indexToksDone(n, cur, acc, total, bad) else if (n >= tokChunk()) indexToksGo(toks, 0, [], List.reverse(cur) :: acc, total, bad) else indexToksGo(List.tail(toks), n + 1, List.at(toks, 0) :: cur, acc, total + 1, tokenBad(List.at(toks, 0), total, bad))

def tokenBad(t: SpTok, i: Int, bad: Int): Int =
  if (bad >= 0) bad else t.tok match {
  case Tok.Bad => i
  case _ => 0 - 1
}

def indexToksDone(n: Int, cur: List[SpTok], acc: List[List[SpTok]], total: Int, bad: Int): Toks =
  indexToksGroups(List.reverse(if (n == 0) acc else List.reverse(cur) :: acc), [], [], 0, total, bad)

def indexToksGroups(chunks: List[List[SpTok]], cur: List[List[SpTok]], acc: List[List[List[SpTok]]], n: Int, total: Int, bad: Int): Toks =
  if (List.isEmpty(chunks)) indexToksGroupsDone(cur, acc, n, total, bad) else if (n >= tokChunk()) indexToksGroups(chunks, [], List.reverse(cur) :: acc, 0, total, bad) else indexToksGroups(List.tail(chunks), List.at(chunks, 0) :: cur, acc, n + 1, total, bad)

def indexToksGroupsDone(cur: List[List[SpTok]], acc: List[List[List[SpTok]]], n: Int, total: Int, bad: Int): Toks =
  Toks(List.reverse(if (n == 0) acc else List.reverse(cur) :: acc), total, bad)

def _sp(toks: Toks, i: Int): SpTok =
  if (toks.n <= 0 || i < 0) SpTok(Tok.Eof, 0, "", 0) else _spAt(toks, if (i >= toks.n) toks.n - 1 else i)

def _spAt(toks: Toks, i: Int): SpTok =
  for {
    group = (i / tokGroup()).require(n => n >= 0 && n < List.len(toks.groups))
    chunks = List.at(toks.groups, group)
    chunk = (i % tokGroup() / tokChunk()).require(n => n >= 0 && n < List.len(chunks))
  } yield _spOff(List.at(chunks, chunk), i % tokChunk())

def _spOff(chunk: List[SpTok], i: Int): SpTok =
  List.at(chunk, i.require(n => n >= 0 && n < List.len(chunk)))

def _at(toks: Toks, i: Int): Tok =
  _sp(toks, i).tok

def _off(toks: Toks, i: Int): Int =
  _sp(toks, i).off

def spanOf(e: Expr): (String, Int) =
  ("", spanOffset(e))

def spanOffset(e: Expr): Int =
  e match {
    case Expr.EInt(_, off) => off
    case Expr.EFloat(_, off) => off
    case Expr.EStr(_, off) => off
    case Expr.EVar(_, off) => off
    case Expr.EPrint(_, off) => off
    case Expr.ECall(_, _, off) => off
    case Expr.EMethod(_, _, _, off) => off
    case Expr.EField(_, _, off) => off
    case Expr.EBin(_, _, _, off) => off
    case Expr.EUn(_, _, off) => off
    case Expr.EIf(_, _, _, off) => off
    case Expr.EMatch(_, _, off) => off
    case Expr.EFor(_, _, off) => off
    case Expr.EAscribe(_, _, off) => off
    case Expr.EInterp(_, _, off) => off
    case Expr.EList(items) => spanItemsOffset(items)
    case Expr.ETuple(items) => spanItemsOffset(items)
    case _ => 0 - 1
  }

def spanItemsOffset(items: List[Expr]): Int =
  if (List.isEmpty(items)) 0 - 1 else spanItemsNext(spanOffset(List.at(items, 0)), List.tail(items))

def spanItemsNext(off: Int, rest: List[Expr]): Int =
  if (off < 0) spanItemsOffset(rest) else off

def spanOff(e: Expr, alt: Int): Int =
  spanOr(spanOffset(e), alt)

def spanOr(off: Int, alt: Int): Int =
  if (off < 0) alt else off

def _is(toks: Toks, i: Int, t: Tok): Bool =
  Lexer.kind(_at(toks, i)) == Lexer.kind(t)

def _identOf(t: Tok): String =
  t match {
    case Tok.Ident(s) => s
    case _ => ""
  }

def _intOf(t: Tok): Int =
  t match {
    case Tok.Int(n) => n
    case _ => 0
  }

def _kit(s: String): Bool =
  s == "Str" || s == "List" || s == "IO" || s == "Map" || s == "Set" || s == "Builder" || s == "Oracle" || s == "Sys" || s == "Fs" || s == "Clock" || s == "Random" || s == "View" || s == "Signal" || s == "Ui" || s == "Json" || s == "Impurity" || s == "Net" || s == "Ref" || s == "Queue" || s == "Deferred" || s == "Fiber" || s == "Stream" || s == "Resource" || s == "Property" || s == "Float" || s == "Scenario"

def _joinComma(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else if (List.len(xs) == 1) List.at(xs, 0) else Str.concat(List.at(xs, 0), Str.concat(", ", _joinComma(List.tail(xs))))

def _joinTypes(toks: Toks, i: Int, acc: List[String]): (List[String], Int) =
  _joinTypes2(parseType(toks, i), toks, acc)

def _joinTypes2(p: (String, Int), toks: Toks, acc: List[String]): (List[String], Int) =
  p match {
    case (t, j) => if (t == "") ("" :: acc, j) else if (_is(toks, j, Tok.Comma)) _joinTypes(toks, j + 1, t :: acc) else (List.reverse(t :: acc), j)
  }

def _badTypes(ts: List[String]): Bool =
  List.isEmpty(ts) || List.contains(ts, "")

def parseType(toks: Toks, i: Int): (String, Int) =
  if (_is(toks, i, Tok.LParen)) parseTypeParen(toks, i + 1) else parseTypeArrow(toks, parseTypeApp(toks, i))

def parseTypeParen(toks: Toks, i: Int): (String, Int) =
  parseTypeParen2(_joinTypes(toks, i, []), toks)

def parseTypeParen2(p: (List[String], Int), toks: Toks): (String, Int) =
  p match {
    case (ts, j) => if (!_badTypes(ts) && _is(toks, j, Tok.RParen)) parseTypeArrow(toks, (_parenType(ts), j + 1)) else ("", j)
  }

def _parenType(ts: List[String]): String =
  if (List.len(ts) == 1) _keepFunParen(List.at(ts, 0)) else Str.concat("(", Str.concat(_joinComma(ts), ")"))

def _keepFunParen(t: String): String =
  if (Str.contains(t, " => ")) Str.concat("(", Str.concat(t, ")")) else t

def parseTypeApp(toks: Toks, i: Int): (String, Int) =
  if (_identOf(_at(toks, i)) == "") ("", i) else parseTypeName(toks, i + 1, _identOf(_at(toks, i)))

def parseTypeName(toks: Toks, i: Int, name: String): (String, Int) =
  parseTypeQualified(parseTypeQual(toks, i, name), toks)

def parseTypeQual(toks: Toks, i: Int, name: String): (String, Int) =
  if (_is(toks, i, Tok.Dot)) if (_identOf(_at(toks, i + 1)) == "") ("", i + 1) else parseTypeQual(toks, i + 2, Str.concat(name, Str.concat(".", _identOf(_at(toks, i + 1))))) else (name, i)

def parseTypeQualified(p: (String, Int), toks: Toks): (String, Int) =
  p match {
    case (name, j) => if (name == "") ("", j) else parseTypeBrack(toks, j, name)
  }

def parseTypeBrack(toks: Toks, i: Int, n: String): (String, Int) =
  if (_is(toks, i, Tok.LBracket)) parseTypeBrackClose(_joinTypes(toks, i + 1, []), n, toks) else (n, i)

def parseTypeBrackClose(p: (List[String], Int), n: String, toks: Toks): (String, Int) =
  p match {
    case (ts, j) => if (!_badTypes(ts) && _is(toks, j, Tok.RBracket)) (Str.concat(n, Str.concat("[", Str.concat(_joinComma(ts), "]"))), j + 1) else ("", j)
  }

def parseTypeArrow(toks: Toks, p: (String, Int)): (String, Int) =
  p match {
    case (left, i) => if (_is(toks, i, Tok.Arrow)) parseTypeArrow2(left, parseType(toks, i + 1)) else (left, i)
  }

def parseTypeArrow2(left: String, p: (String, Int)): (String, Int) =
  p match {
    case (right, j) => (if (left == "" || right == "") "" else Str.concat(left, Str.concat(" => ", right)), j)
  }

def parseExpr(toks: Toks, i: Int): (Expr, Int) =
  parseAscribe(parseOr(toks, i), toks)

def parseExprList(toks: List[SpTok], i: Int): (Expr, Int) =
  parseExprListGo(indexToks(toks), i)

def parseExprListGo(toks: Toks, i: Int): (Expr, Int) =
  if (toks.bad >= 0) (Expr.EVar("", _off(toks, toks.bad)), toks.n) else parseExprListEnd(parseExpr(toks, i), toks)

def parseExprListEnd(p: (Expr, Int), toks: Toks): (Expr, Int) =
  p match {
    case (e, j) => if (_is(toks, j, Tok.Eof)) p else (Expr.EVar("", _off(toks, j)), toks.n)
  }

def interpParts(s: String, i: Int, b: Builder, acc: List[Expr], base: Int): List[Expr] =
  if (i >= Str.len(s)) interpPartsEnd(b, acc) else interpPartsCh(s, i, b, acc, base, Str.charAt(s, i))

def interpPartsEnd(b: Builder, acc: List[Expr]): List[Expr] =
  interpPartsEndLit(Builder.result(b), acc)

def interpPartsEndLit(lit: String, acc: List[Expr]): List[Expr] =
  if (lit == "") List.reverse(acc) else List.reverse(Expr.EStr(lit, 0) :: acc)

def interpPartsCh(s: String, i: Int, b: Builder, acc: List[Expr], base: Int, c: Int): List[Expr] =
  if (c == 92 && i + 1 < Str.len(s)) interpParts(s, i + 2, Builder.append(b, Lexer._escStr(s, i + 1)), acc, base) else if (c == 36) interpPartsDollar(s, i, b, acc, base) else interpParts(s, i + 1, Builder.append(b, Str.slice(s, i, i + 1)), acc, base)

def interpPartsDollar(s: String, i: Int, b: Builder, acc: List[Expr], base: Int): List[Expr] =
  if (i + 1 >= Str.len(s)) interpParts(s, i + 1, Builder.append(b, "$"), acc, base) else interpPartsDollar2(s, i, b, acc, base, Str.charAt(s, i + 1))

def interpPartsDollar2(s: String, i: Int, b: Builder, acc: List[Expr], base: Int, n: Int): List[Expr] =
  if (n == 123) interpPartsBrace(s, i, b, acc, base) else if (isIdentStart(n)) interpPartsIdent(s, i + 1, b, acc, base) else interpParts(s, i + 1, Builder.append(b, "$"), acc, base)

def isIdentStart(c: Int): Bool =
  c == 95 || c >= 65 && c <= 90 || c >= 97 && c <= 122

def isIdentCont(c: Int): Bool =
  isIdentStart(c) || c >= 48 && c <= 57

def interpPartsIdent(s: String, i: Int, b: Builder, acc: List[Expr], base: Int): List[Expr] =
  interpPartsIdent2(s, i, i, b, acc, base)

def interpPartsIdent2(s: String, i: Int, start: Int, b: Builder, acc: List[Expr], base: Int): List[Expr] =
  if (i >= Str.len(s)) interpPartsFlush(b, Expr.EVar(Str.slice(s, start, i), base + start), acc, s, i, base) else if (isIdentCont(Str.charAt(s, i))) interpPartsIdent2(s, i + 1, start, b, acc, base) else interpPartsFlush(b, Expr.EVar(Str.slice(s, start, i), base + start), acc, s, i, base)

def interpPartsFlush(b: Builder, e: Expr, acc: List[Expr], s: String, i: Int, base: Int): List[Expr] =
  interpPartsFlushLit(Builder.result(b), e, acc, s, i, base)

def interpPartsFlushLit(lit: String, e: Expr, acc: List[Expr], s: String, i: Int, base: Int): List[Expr] =
  if (lit == "") interpParts(s, i, Builder.empty(), e :: acc, base) else interpParts(s, i, Builder.empty(), e :: Expr.EStr(lit, 0) :: acc, base)

def interpPartsBrace(s: String, i: Int, b: Builder, acc: List[Expr], base: Int): List[Expr] =
  interpPartsBrace2(s, interpCloseBrace(s, i + 2, 1), i, b, acc, base)

def interpCloseBrace(s: String, i: Int, depth: Int): Int =
  if (i >= Str.len(s) || depth <= 0) i else interpCloseBraceCh(s, i, depth, Str.charAt(s, i))

def interpCloseBraceCh(s: String, i: Int, depth: Int, c: Int): Int =
  if (c == 34) interpCloseBrace(s, Lexer._skipExprQuote(s, i), depth) else if (c == 123) interpCloseBrace(s, i + 1, depth + 1) else if (c == 125) interpCloseBrace(s, i + 1, depth - 1) else interpCloseBrace(s, i + 1, depth)

def interpPartsBrace2(s: String, j: Int, i: Int, b: Builder, acc: List[Expr], base: Int): List[Expr] =
  interpPartsBrace3(parseExprList(interpHoleToks(Str.slice(s, i + 2, j - 1), base + i + 2), 0), b, acc, s, j, base)

def interpHoleToks(s: String, base: Int): List[SpTok] =
  List.map(Lexer.lex(s), t => SpTok(t.tok, t.off + base, t.stem, t.column))

def interpPartsBrace3(p: (Expr, Int), b: Builder, acc: List[Expr], s: String, j: Int, base: Int): List[Expr] =
  p match {
    case (e, _) => interpPartsFlush(b, e, acc, s, j, base)
  }

def parseAscribe(p: (Expr, Int), toks: Toks): (Expr, Int) =
  p match {
    case (e, j) => if (_is(toks, j, Tok.Colon)) parseAscribeKeep(e, parseType(toks, j + 1), _off(toks, j)) else (e, j)
  }

def parseAscribeKeep(e: Expr, p: (String, Int), off: Int): (Expr, Int) =
  p match {
    case (ty, k) => (Expr.EAscribe(e, ty, spanOff(e, off)), k)
  }

def parseOr(toks: Toks, i: Int): (Expr, Int) =
  parseBinRest(toks, parseAnd(toks, i), "||")

def parseAnd(toks: Toks, i: Int): (Expr, Int) =
  parseBinRest(toks, parseBitOr(toks, i), "&&")

def parseBitOr(toks: Toks, i: Int): (Expr, Int) =
  parseBinRest(toks, parseBitXor(toks, i), "|")

def parseBitXor(toks: Toks, i: Int): (Expr, Int) =
  parseBinRest(toks, parseBitAnd(toks, i), "^")

def parseBitAnd(toks: Toks, i: Int): (Expr, Int) =
  parseBinRest(toks, parseCmp(toks, i), "&")

def parseCmp(toks: Toks, i: Int): (Expr, Int) =
  parseBinRest(toks, parseCons(toks, i), "==")

def parseCons(toks: Toks, i: Int): (Expr, Int) =
  parseConsRest(toks, parseShift(toks, i))

def parseShift(toks: Toks, i: Int): (Expr, Int) =
  parseBinRest(toks, parseAdd(toks, i), "<<")

def parseConsRest(toks: Toks, p: (Expr, Int)): (Expr, Int) =
  p match {
    case (e, i) => if (_is(toks, i, Tok.ColonColon)) parseConsRight(e, parseCons(toks, i + 1), _off(toks, i)) else (e, i)
  }

def parseConsRight(left: Expr, p: (Expr, Int), off: Int): (Expr, Int) =
  p match {
    case (r, j) => (Expr.EBin("::", left, r, spanOff(left, off)), j)
  }

def parseAdd(toks: Toks, i: Int): (Expr, Int) =
  parseBinRest(toks, parseMul(toks, i), "+")

def parseMul(toks: Toks, i: Int): (Expr, Int) =
  parseBinRest(toks, parseUnary(toks, i), "*")

def parseUnary(toks: Toks, i: Int): (Expr, Int) =
  if (_is(toks, i, Tok.Minus)) parseUnaryOp("-", parseUnary(toks, i + 1), _off(toks, i)) else if (_is(toks, i, Tok.Bang)) parseUnaryOp("!", parseUnary(toks, i + 1), _off(toks, i)) else if (_is(toks, i, Tok.Tilde)) parseUnaryOp("~", parseUnary(toks, i + 1), _off(toks, i)) else parsePost(toks, parseAtom(toks, i))

def parseUnaryOp(op: String, p: (Expr, Int), off: Int): (Expr, Int) =
  p match {
    case (e, j) => (Expr.EUn(op, e, off), j)
  }

def _opTok(t: Tok): String =
  t match {
    case Tok.Plus => "+"
    case Tok.Minus => "-"
    case Tok.Star => "*"
    case Tok.Slash => "/"
    case Tok.Percent => "%"
    case Tok.EqEq => "=="
    case Tok.BangEq => "!="
    case Tok.Lt => "<"
    case Tok.LtEq => "<="
    case Tok.Gt => ">"
    case Tok.GtEq => ">="
    case Tok.Amp => "&"
    case Tok.Pipe => "|"
    case Tok.Caret => "^"
    case Tok.Shl => "<<"
    case Tok.Shr => ">>"
    case Tok.AmpAmp => "&&"
    case Tok.PipePipe => "||"
    case _ => ""
  }

def _opLevel(op: String, want: String): Bool =
  if (want == "+") op == "+" || op == "-" else if (want == "*") op == "*" || op == "/" || op == "%" else if (want == "<<") op == "<<" || op == ">>" else if (want == "==") op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" else if (want == "&") op == "&" else if (want == "^") op == "^" else if (want == "|") op == "|" else if (want == "&&") op == "&&" else if (want == "||") op == "||" else false

def parseBinRest(toks: Toks, p: (Expr, Int), want: String): (Expr, Int) =
  p match {
    case (e, i) => parseBinRestOp(toks, e, i, want, _opTok(_at(toks, i)))
  }

def parseBinRestOp(toks: Toks, e: Expr, i: Int, want: String, op: String): (Expr, Int) =
  if (_opLevel(op, want)) parseBinRest(toks, parseBinNext(toks, e, i + 1, op, want, _off(toks, i)), want) else (e, i)

def parseBinNext(toks: Toks, left: Expr, i: Int, op: String, want: String, off: Int): (Expr, Int) =
  parseBinNext2(left, op, if (want == "*") parseUnary(toks, i) else if (want == "+") parseMul(toks, i) else if (want == "<<") parseAdd(toks, i) else if (want == "==") parseCons(toks, i) else if (want == "&") parseCmp(toks, i) else if (want == "^") parseBitAnd(toks, i) else if (want == "|") parseBitXor(toks, i) else if (want == "&&") parseBitOr(toks, i) else parseAnd(toks, i), off)

def parseBinNext2(left: Expr, op: String, p: (Expr, Int), off: Int): (Expr, Int) =
  p match {
    case (r, j) => (Expr.EBin(op, left, r, spanOff(left, off)), j)
  }

def parseAtom(toks: Toks, i: Int): (Expr, Int) =
  _at(toks, i) match {
    case Tok.Int(n) => (Expr.EInt(n, _off(toks, i)), i + 1)
    case Tok.True => (Expr.EBool(true), i + 1)
    case Tok.False => (Expr.EBool(false), i + 1)
    case Tok.Str(s) => (Expr.EStr(s, _off(toks, i)), i + 1)
    case Tok.Float(s) => (Expr.EFloat(s, _off(toks, i)), i + 1)
    case Tok.Interp(s) => (Expr.EInterp(s, interpParts(s, 0, Builder.empty(), [], _off(toks, i) + 2), _off(toks, i)), i + 1)
    case Tok.Underscore => parseHole(toks, i)
    case Tok.LParen => if (_is(toks, i + 1, Tok.RParen)) (Expr.EUnit, i + 2) else parseParen(toks, i + 1)
    case Tok.LBracket => parseList(toks, i)
    case Tok.Ident(s) => parseIdentAtom(toks, i, s)
    case Tok.If => parseIf(toks, i)
    case Tok.For => parseFor(toks, i)
    case Tok.Eof => (Expr.EVar("", _off(toks, i)), i + 1)
    case Tok.LBrace => if (_is(toks, i + 1, Tok.Case)) parseMatchLam(toks, i) else (Expr.EVar("", _off(toks, i)), i)
    case _ => (Expr.EVar("", _off(toks, i)), i)
  }

def parseMatchLam(toks: Toks, i: Int): (Expr, Int) =
  parseMatchLam2(parseMatch(toks, Expr.EVar("__p", _off(toks, i)), i, _off(toks, i)))

def parseMatchLam2(p: (Expr, Int)): (Expr, Int) =
  p match {
    case (e, j) => (Expr.ELam("__p", "", e), j)
  }

def parseIf(toks: Toks, i: Int): (Expr, Int) =
  if (_is(toks, i + 1, Tok.LParen)) parseIf2(parseExpr(toks, i + 2), toks, _off(toks, i)) else (Expr.EVar("", _off(toks, i + 1)), i + 1)

def parseIf2(p: (Expr, Int), toks: Toks, off: Int): (Expr, Int) =
  p match {
    case (c, j) => if (_is(toks, j, Tok.RParen)) parseIf3(c, parseExpr(toks, j + 1), toks, off) else (Expr.EVar("", _off(toks, j)), j)
  }

def parseIf3(c: Expr, p: (Expr, Int), toks: Toks, off: Int): (Expr, Int) =
  p match {
    case (t, j) => if (_is(toks, j, Tok.Else)) parseIf4(c, t, parseExpr(toks, j + 1), off) else (Expr.EIf(c, t, Expr.EUnit, off), j)
  }

def parseIf4(c: Expr, t: Expr, p: (Expr, Int), off: Int): (Expr, Int) =
  p match {
    case (e, j) => (Expr.EIf(c, t, e, off), j)
  }

def parseFor(toks: Toks, i: Int): (Expr, Int) =
  if (_is(toks, i + 1, Tok.LBrace)) parseForBinds(toks, i + 2, [], _off(toks, i)) else (Expr.EVar("", _off(toks, i + 1)), i + 1)

def parseForBinds(toks: Toks, i: Int, acc: List[Bind], off: Int): (Expr, Int) =
  if (_is(toks, i, Tok.RBrace)) parseForYield(toks, i + 1, List.reverse(acc), off) else if (i >= toks.n || _is(toks, i, Tok.Eof)) (Expr.EVar("", _off(toks, i)), toks.n) else parseForBindsNext(parseForOne(toks, i), toks, acc, off, i)

def parseForOne(toks: Toks, i: Int): (Bind, Int) =
  if (_is(toks, i, Tok.If)) parseForGuard(parseExpr(toks, i + 1)) else parseForPat(parsePat(toks, i), toks)

def parseForGuard(p: (Expr, Int)): (Bind, Int) =
  p match {
    case (cond, j) => (Bind(false, "__guard", cond), j)
  }

def parseForPat(p: (String, Int), toks: Toks): (Bind, Int) =
  p match {
    case (pat, j) => if (pat == "" || !_is(toks, j, Tok.LeftArrow) && !_is(toks, j, Tok.Eq)) (Bind(false, "", Expr.EVar("", _off(toks, j))), toks.n) else parseForOne3(pat, _is(toks, j, Tok.LeftArrow), parseExpr(toks, j + 1), toks)
  }

def parseForOne3(name: String, draw: Bool, p: (Expr, Int), toks: Toks): (Bind, Int) =
  p match {
    case (v, j) => parseForAsc(name, draw, parseArgAsc(v, toks, j))
  }

def parseForAsc(name: String, draw: Bool, p: (Expr, Int)): (Bind, Int) =
  p match {
    case (v, j) => (Bind(draw, name, v), j)
  }

def parseArgAsc(e: Expr, toks: Toks, i: Int): (Expr, Int) =
  if (_is(toks, i, Tok.Colon)) parseArgAsc2(e, parseType(toks, i + 1), _off(toks, i + 1)) else (e, i)

def parseArgAsc2(e: Expr, p: (String, Int), off: Int): (Expr, Int) =
  p match {
    case (ty, j) => if (ty == "") (Expr.EVar("", off), j) else (e, j)
  }

def parseForBindsNext(p: (Bind, Int), toks: Toks, acc: List[Bind], off: Int, prev: Int): (Expr, Int) =
  p match {
    case (b, j) => if (j <= prev) (Expr.EVar("", _off(toks, prev)), toks.n) else parseForBinds(toks, j, b :: acc, off)
  }

def parseForYield(toks: Toks, i: Int, bs: List[Bind], off: Int): (Expr, Int) =
  if (_is(toks, i, Tok.Yield)) parseForYield2(bs, parseExpr(toks, i + 1), off) else (Expr.EVar("", _off(toks, i)), i)

def parseForYield2(bs: List[Bind], p: (Expr, Int), off: Int): (Expr, Int) =
  p match {
    case (body, j) => (Expr.EFor(bs, body, off), j)
  }

def parseHole(toks: Toks, i: Int): (Expr, Int) =
  if (_is(toks, i + 1, Tok.Arrow)) parseLamBody(toks, i + 2, "_") else (Expr.EHole, i + 1)

def parseLamBody(toks: Toks, i: Int, p: String): (Expr, Int) =
  parseLamBody2(p, parseExpr(toks, i))

def parseLamBody2(p: String, q: (Expr, Int)): (Expr, Int) =
  q match {
    case (b, j) => (Expr.ELam(p, "", b), j)
  }

def parseParen(toks: Toks, i: Int): (Expr, Int) =
  parsePost(toks, parseParen2(parseExpr(toks, i), toks))

def parseParen2(p: (Expr, Int), toks: Toks): (Expr, Int) =
  p match {
    case (e, j) => if (_is(toks, j, Tok.Comma)) parseTupleLam(parseTupleRest(toks, j + 1, e :: []), toks) else parseOneLam(e, toks, j)
  }

def parseOneLam(e: Expr, toks: Toks, j: Int): (Expr, Int) =
  if (_is(toks, j, Tok.Colon)) parseOneLamTy(e, parseType(toks, j + 1), toks) else if (_is(toks, j, Tok.RParen) && _is(toks, j + 1, Tok.Arrow)) parseLamFromAsc(e, parseExpr(toks, j + 2)) else if (_is(toks, j, Tok.RParen)) (e, j + 1) else (Expr.EVar("", _off(toks, j)), j)

def parseLamFromAsc(e: Expr, q: (Expr, Int)): (Expr, Int) =
  e match {
    case Expr.EAscribe(inner, ty, off) => parseLamFrom(if (ty == "") Expr.EVar("", off) else inner, ty, q)
    case _ => parseLamFrom(e, "", q)
  }

def parseOneLamTy(e: Expr, p: (String, Int), toks: Toks): (Expr, Int) =
  p match {
    case (ty, j) => if (_is(toks, j, Tok.RParen) && _is(toks, j + 1, Tok.Arrow)) parseLamFrom(if (ty == "") Expr.EVar("", spanOff(e, 0)) else e, ty, parseExpr(toks, j + 2)) else parseOneLam(e, toks, j)
  }

def parseLamFrom(e: Expr, ty: String, q: (Expr, Int)): (Expr, Int) =
  q match {
    case (b, k) => if (parseErrorExpr(e)) (Expr.EVar("", spanOff(e, 0)), k) else e match {
  case Expr.EVar(s, _) => (Expr.ELam(s, ty, b), k)
  case _ => (Expr.ELam("__p", ty, Expr.EMatch(Expr.EVar("__p", 0), Arm(pretty0(e), "", b) :: [], 0)), k)
}
  }

def parenBind(e: Expr): String =
  e match {
    case Expr.EVar(s, _) => s
    case _ => "_"
  }

def parseTupleLam(p: (Expr, Int), toks: Toks): (Expr, Int) =
  p match {
    case (e, j) => if (_is(toks, j, Tok.Arrow)) parseTupLamBody(e, parseExpr(toks, j + 1)) else (e, j)
  }

def parseTupLamBody(patE: Expr, q: (Expr, Int)): (Expr, Int) =
  q match {
    case (b, k) => if (parseErrorExpr(patE)) (Expr.EVar("", spanOff(patE, 0)), k) else (Expr.ELam("__tup", "", Expr.EMatch(Expr.EVar("__tup", 0), Arm(tupPat(patE), "", b) :: [], 0)), k)
  }

def tupPat(e: Expr): String =
  e match {
    case Expr.ETuple(xs) => Str.concat("(", Str.concat(_joinComma(tupNames(xs)), ")"))
    case _ => "(_,_)"
  }

def tupNames(xs: List[Expr]): List[String] =
  if (List.isEmpty(xs)) [] else tupNames2(List.at(xs, 0), List.tail(xs))

def tupNames2(h: Expr, rest: List[Expr]): List[String] =
  parenBind(h) :: tupNames(rest)

def parseTupleRest(toks: Toks, i: Int, acc: List[Expr]): (Expr, Int) =
  parseTupleRest2(parseExpr(toks, i), toks, acc)

def parseTupleRest2(p: (Expr, Int), toks: Toks, acc: List[Expr]): (Expr, Int) =
  p match {
    case (e, j) => if (_is(toks, j, Tok.Comma)) parseTupleRest(toks, j + 1, e :: acc) else if (_is(toks, j, Tok.RParen)) (Expr.ETuple(List.reverse(e :: acc)), j + 1) else (Expr.EVar("", _off(toks, j)), j)
  }

def parseList(toks: Toks, i: Int): (Expr, Int) =
  if (_is(toks, i + 1, Tok.RBracket)) (Expr.EList([]), i + 2) else parseListElems(toks, i + 1, [])

def parseListElems(toks: Toks, i: Int, acc: List[Expr]): (Expr, Int) =
  parseListNext(parseExpr(toks, i), toks, acc)

def parseListNext(p: (Expr, Int), toks: Toks, acc: List[Expr]): (Expr, Int) =
  p match {
    case (e, j) => if (_is(toks, j, Tok.Comma)) parseListElems(toks, j + 1, e :: acc) else if (_is(toks, j, Tok.RBracket)) (Expr.EList(List.reverse(e :: acc)), j + 1) else (Expr.EVar("", _off(toks, j)), j)
  }

def parseIdentAtom(toks: Toks, i: Int, s: String): (Expr, Int) =
  if (_is(toks, i + 1, Tok.Arrow)) parseLamBody(toks, i + 2, s) else if (s == "IO" && _is(toks, i + 1, Tok.Dot)) parseIo(toks, i + 2, _off(toks, i)) else if (_kit(s) && _is(toks, i + 1, Tok.Dot)) parseKit(toks, i + 2, s, _off(toks, i)) else (Expr.EVar(s, _off(toks, i)), i + 1)

def parseIo(toks: Toks, i: Int, off: Int): (Expr, Int) =
  if (_identOf(_at(toks, i)) == "") (Expr.EVar("", _off(toks, i)), i) else parseIoArgs(toks, i + 1, _identOf(_at(toks, i)), off)

def parseIoArgs(toks: Toks, i: Int, m: String, off: Int): (Expr, Int) =
  parseIoArgs2(m, parseCallArgs(toks, i), off)

def parseIoArgs2(m: String, p: (List[Expr], Int), off: Int): (Expr, Int) =
  p match {
    case (args, j) => if (m == "println" && List.len(args) == 1) (Expr.EPrint(List.at(args, 0), off), j) else (Expr.ECall(Str.concat("IO.", m), args, off), j)
  }

def parseKit(toks: Toks, i: Int, kit: String, off: Int): (Expr, Int) =
  if (_identOf(_at(toks, i)) == "") (Expr.EVar("", _off(toks, i)), i) else parseKit2(kit, _identOf(_at(toks, i)), toks, i + 1, off)

def parseKit2(kit: String, m: String, toks: Toks, i: Int, off: Int): (Expr, Int) =
  parseKit3(Str.concat(kit, Str.concat(".", m)), parseCallArgs(toks, i), off)

def parseKit3(f: String, p: (List[Expr], Int), off: Int): (Expr, Int) =
  p match {
    case (args, j) => (Expr.ECall(f, args, off), j)
  }

def parseCallArgs(toks: Toks, i: Int): (List[Expr], Int) =
  if (_is(toks, i, Tok.LParen) && !forBindAfter(toks, i)) parseArgList(toks, i + 1, []) else ([], i)

def parseArgList(toks: Toks, i: Int, acc: List[Expr]): (List[Expr], Int) =
  if (_is(toks, i, Tok.RParen) && List.isEmpty(acc)) ([], i + 1) else parseArgListNext(parseArg(toks, i), toks, acc)

def parseArg(toks: Toks, i: Int): (Expr, Int) =
  _at(toks, i) match {
    case Tok.Ident(s) => if (_is(toks, i + 1, Tok.Eq)) parseNamed(s, parseExpr(toks, i + 2)) else parseExpr(toks, i)
    case _ => parseExpr(toks, i)
  }

def parseNamed(name: String, p: (Expr, Int)): (Expr, Int) =
  p match {
    case (e, j) => (Expr.ENamed(name, e), j)
  }

def parseArgListNext(p: (Expr, Int), toks: Toks, acc: List[Expr]): (List[Expr], Int) =
  p match {
    case (e, j) => parseArgListAsc(parseArgAsc(e, toks, j), toks, acc)
  }

def parseArgListAsc(p: (Expr, Int), toks: Toks, acc: List[Expr]): (List[Expr], Int) =
  p match {
    case (e, j) => parseArgListSep(e, j, toks, acc)
  }

def parseArgListSep(e: Expr, j: Int, toks: Toks, acc: List[Expr]): (List[Expr], Int) =
  if (_is(toks, j, Tok.LParen) && !forBindAfter(toks, j) || _is(toks, j, Tok.Dot) || _is(toks, j, Tok.Match)) parseArgListSep2(parsePost(toks, (e, j)), toks, acc) else if (_is(toks, j, Tok.Comma)) parseArgList(toks, j + 1, e :: acc) else if (_is(toks, j, Tok.RParen)) (List.reverse(e :: acc), j + 1) else (List.reverse(Expr.EVar("", _off(toks, j)) :: e :: acc), j)

def parseArgListSep2(p: (Expr, Int), toks: Toks, acc: List[Expr]): (List[Expr], Int) =
  p match {
    case (e, j) => parseArgListAsc(parseArgAsc(e, toks, j), toks, acc)
  }

def parsePost(toks: Toks, p: (Expr, Int)): (Expr, Int) =
  p match {
    case (e, i) => if (_is(toks, i, Tok.LParen) && !forBindAfter(toks, i)) parsePost(toks, parsePostCall(e, parseCallArgs(toks, i))) else if (_is(toks, i, Tok.Dot)) parsePost(toks, parsePostDot(toks, e, i + 1)) else if (_is(toks, i, Tok.Match)) parsePost(toks, parseMatch(toks, e, i + 1, spanOff(e, _off(toks, i)))) else (e, i)
  }

def forBindAfter(toks: Toks, i: Int): Bool =
  forBindAt(toks, afterParen(toks, i))

def forBindAt(toks: Toks, j: Int): Bool =
  _is(toks, j, Tok.Eq) || _is(toks, j, Tok.LeftArrow)

def afterParen(toks: Toks, i: Int): Int =
  if (_is(toks, i, Tok.LParen)) afterParenD(toks, i + 1, 1) else i

def afterParenD(toks: Toks, i: Int, d: Int): Int =
  if (d <= 0) i else if (i >= toks.n) i else afterParenTok(_at(toks, i), toks, i, d)

def afterParenTok(t: Tok, toks: Toks, i: Int, d: Int): Int =
  t match {
    case Tok.LParen => afterParenD(toks, i + 1, d + 1)
    case Tok.RParen => afterParenD(toks, i + 1, d - 1)
    case _ => afterParenD(toks, i + 1, d)
  }

def parseMatch(toks: Toks, e: Expr, i: Int, off: Int): (Expr, Int) =
  if (_is(toks, i, Tok.LBrace)) parseMatchArms(toks, e, i + 1, [], off) else (Expr.EVar("", _off(toks, i)), i)

def parseMatchArms(toks: Toks, e: Expr, i: Int, acc: List[Arm], off: Int): (Expr, Int) =
  if (_is(toks, i, Tok.RBrace)) (Expr.EMatch(e, List.reverse(acc), off), i + 1) else if (_is(toks, i, Tok.Case)) parseMatchArmsNext(parseMatchArm(toks, i + 1), toks, e, acc, off) else (Expr.EVar("", _off(toks, i)), i)

def parseMatchArm(toks: Toks, i: Int): (Arm, Int) =
  parseMatchArm2(parsePat(toks, i), toks)

def parseMatchArm2(p: (String, Int), toks: Toks): (Arm, Int) =
  p match {
    case (pat, j) => if (_is(toks, j, Tok.If)) parseMatchArmG(pat, parseExpr(toks, j + 1), toks) else if (_is(toks, j, Tok.Arrow)) parseMatchArm3(pat, "", parseExpr(toks, j + 1)) else (Arm("", "#parse", Expr.EVar("", _off(toks, j))), j)
  }

def parseMatchArmG(pat: String, p: (Expr, Int), toks: Toks): (Arm, Int) =
  p match {
    case (g, j) => if (_is(toks, j, Tok.Arrow)) parseMatchArm3(pat, if (parseErrorExpr(g)) "#parse" else pretty0(g), parseExpr(toks, j + 1)) else (Arm("", "#parse", Expr.EVar("", _off(toks, j))), j)
  }

def parseMatchArm3(pat: String, g: String, p: (Expr, Int)): (Arm, Int) =
  p match {
    case (body, j) => (Arm(pat, g, body), j)
  }

def parseMatchArmsNext(p: (Arm, Int), toks: Toks, e: Expr, acc: List[Arm], off: Int): (Expr, Int) =
  p match {
    case (a, j) => parseMatchArms(toks, e, j, a :: acc, off)
  }

def parsePat(toks: Toks, i: Int): (String, Int) =
  parsePatOr(parsePatCons(parsePatPrimary(toks, i), toks), toks)

def parsePatCons(p: (String, Int), toks: Toks): (String, Int) =
  p match {
    case (s, j) => if (_is(toks, j, Tok.ColonColon)) parsePatCons2(s, parsePat(toks, j + 1)) else (s, j)
  }

def parsePatCons2(left: String, p: (String, Int)): (String, Int) =
  p match {
    case (r, k) => if (left == "" || r == "") ("", k) else (Str.concat(left, Str.concat(" :: ", r)), k)
  }

def parsePatOr(p: (String, Int), toks: Toks): (String, Int) =
  p match {
    case (s, j) => if (_is(toks, j, Tok.Pipe)) parsePatOr2(s, parsePat(toks, j + 1), toks) else (s, j)
  }

def parsePatOr2(left: String, p: (String, Int), toks: Toks): (String, Int) =
  p match {
    case (r, k) => if (left == "" || r == "") ("", k) else parsePatOr((Str.concat(left, Str.concat(" | ", r)), k), toks)
  }

def parsePatPrimary(toks: Toks, i: Int): (String, Int) =
  _at(toks, i) match {
    case Tok.Underscore => ("_", i + 1)
    case Tok.Int(n) => (Str.fromInt(n), i + 1)
    case Tok.Minus => parsePatNeg(toks, i + 1)
    case Tok.True => ("true", i + 1)
    case Tok.False => ("false", i + 1)
    case Tok.Str(s) => (quote(s), i + 1)
    case Tok.Ident(s) => parsePatIdent(toks, i + 1, s)
    case Tok.LParen => parsePatTuple(toks, i)
    case Tok.LBracket => parsePatNil(toks, i)
    case _ => ("", i)
  }

def parsePatNil(toks: Toks, i: Int): (String, Int) =
  if (_is(toks, i + 1, Tok.RBracket)) ("[]", i + 2) else parsePatListRest(toks, i + 1, [])

def parsePatListRest(toks: Toks, i: Int, acc: List[String]): (String, Int) =
  parsePatListNext(parsePatPrimary(toks, i), toks, acc)

def parsePatListNext(p: (String, Int), toks: Toks, acc: List[String]): (String, Int) =
  p match {
    case (a, j) => if (a == "") ("", j) else if (_is(toks, j, Tok.Comma)) parsePatListRest(toks, j + 1, a :: acc) else if (_is(toks, j, Tok.RBracket)) (listPatOf(List.reverse(a :: acc)), j + 1) else ("", j)
  }

def listPatOf(xs: List[String]): String =
  if (List.isEmpty(xs)) "[]" else Str.concat(List.at(xs, 0), Str.concat(" :: ", listPatOf(List.tail(xs))))

def parsePatTuple(toks: Toks, i: Int): (String, Int) =
  parsePatCtorClose("", parsePatArgs(toks, i + 1, []))

def parsePatNeg(toks: Toks, i: Int): (String, Int) =
  if (_is(toks, i, Tok.Int(0))) (Str.concat("-", Str.fromInt(_intOf(_at(toks, i)))), i + 1) else ("", i)

def parsePatIdent(toks: Toks, i: Int, s: String): (String, Int) =
  if (_is(toks, i, Tok.At)) parsePatAs(s, parsePatPrimary(toks, i + 1)) else if (_is(toks, i, Tok.Dot)) parsePatQual(toks, i + 1, s) else if (_is(toks, i, Tok.LParen)) parsePatCtor(s, toks, i) else (s, i)

def parsePatAs(name: String, p: (String, Int)): (String, Int) =
  p match {
    case (inner, j) => if (inner == "") ("", j) else (Str.concat(name, Str.concat(" @ ", inner)), j)
  }

def parsePatQual(toks: Toks, i: Int, left: String): (String, Int) =
  if (_identOf(_at(toks, i)) == "") ("", i) else parsePatQual2(Str.concat(left, Str.concat(".", _identOf(_at(toks, i)))), toks, i + 1)

def parsePatQual2(q: String, toks: Toks, i: Int): (String, Int) =
  if (_is(toks, i, Tok.Dot)) parsePatQual(toks, i + 1, q) else if (_is(toks, i, Tok.LParen)) parsePatCtor(q, toks, i) else (q, i)

def parsePatCtor(q: String, toks: Toks, i: Int): (String, Int) =
  parsePatCtorClose(q, parsePatArgs(toks, i + 1, []))

def parsePatArgs(toks: Toks, i: Int, acc: List[String]): (List[String], Int) =
  if (_is(toks, i, Tok.RParen) && List.isEmpty(acc)) ([], i + 1) else parsePatArgsNext(parsePat(toks, i), toks, acc)

def parsePatArgsNext(p: (String, Int), toks: Toks, acc: List[String]): (List[String], Int) =
  p match {
    case (a, j) => if (a == "") ([""], j) else if (_is(toks, j, Tok.Eq)) parsePatArgsEq(a, parsePatPrimary(toks, j + 1), toks, acc) else if (_is(toks, j, Tok.Comma)) parsePatArgs(toks, j + 1, a :: acc) else if (_is(toks, j, Tok.RParen)) (List.reverse(a :: acc), j + 1) else ([""], j)
  }

def parsePatArgsEq(field: String, p: (String, Int), toks: Toks, acc: List[String]): (List[String], Int) =
  p match {
    case (rhs, k) => if (rhs == "") ([""], k) else if (_is(toks, k, Tok.Comma)) parsePatArgs(toks, k + 1, namedField(field, rhs) :: acc) else if (_is(toks, k, Tok.RParen)) (List.reverse(namedField(field, rhs) :: acc), k + 1) else ([""], k)
  }

def namedField(field: String, rhs: String): String =
  Str.concat(field, Str.concat(" = ", rhs))

def parsePatCtorClose(q: String, p: (List[String], Int)): (String, Int) =
  p match {
    case (args, j) => if (List.contains(args, "")) ("", j) else (Str.concat(q, Str.concat("(", Str.concat(_joinComma(args), ")"))), j)
  }

def parsePostCall(e: Expr, p: (List[Expr], Int)): (Expr, Int) =
  p match {
    case (args, j) => e match {
  case Expr.EVar(s, off) => (Expr.ECall(s, args, off), j)
  case _ => (Expr.EMethod(e, "apply", args, spanOff(e, 0)), j)
}
  }

def parsePostDot(toks: Toks, e: Expr, i: Int): (Expr, Int) =
  parsePostDotName(e, _identOf(_at(toks, i)), toks, i + 1)

def parsePostDotName(e: Expr, m: String, toks: Toks, i: Int): (Expr, Int) =
  if (_is(toks, i, Tok.LParen) && !forBindAfter(toks, i)) parsePostDot2(e, m, parseCallArgs(toks, i)) else if (_is(toks, i, Tok.LBrace) && _is(toks, i + 1, Tok.Case)) parsePostDot2(e, m, parseBraceArg(toks, i)) else (Expr.EField(e, m, spanOff(e, _off(toks, i - 1))), i)

def parseBraceArg(toks: Toks, i: Int): (List[Expr], Int) =
  parseBraceArg2(parseMatchLam(toks, i))

def parseBraceArg2(p: (Expr, Int)): (List[Expr], Int) =
  p match {
    case (e, j) => (e :: [], j)
  }

def parsePostDot2(e: Expr, m: String, p: (List[Expr], Int)): (Expr, Int) =
  p match {
    case (args, j) => (Expr.EMethod(e, m, args, spanOff(e, 0)), j)
  }

def parseParams(toks: Toks, i: Int): (List[Param], Int) =
  if (_is(toks, i, Tok.LParen)) parseParamList(toks, i + 1, []) else ([], i)

def parseParamList(toks: Toks, i: Int, acc: List[Param]): (List[Param], Int) =
  if (_is(toks, i, Tok.RParen) && List.isEmpty(acc)) ([], i + 1) else parseParamListNext(parseOneParam(toks, i), toks, acc)

def parseOneParam(toks: Toks, i: Int): (Param, Int) =
  if (_identOf(_at(toks, i)) == "") (Param("#parse", "", "", ""), i) else if (!_is(toks, i + 1, Tok.Colon)) (Param("#parse", "", "", ""), i + 1) else parseOneParam2(_identOf(_at(toks, i)), parseType(toks, i + 2), toks)

def parseOneParam2(name: String, p: (String, Int), toks: Toks): (Param, Int) =
  p match {
    case (ty, j) => parseOneParam3(name, ty, toks, j)
  }

def parseOneParam3(name: String, ty: String, toks: Toks, j: Int): (Param, Int) =
  if (_is(toks, j, Tok.Where)) parseOneParamW(name, ty, parseExpr(toks, j + 1), toks) else parseOneParamD(name, ty, "", toks, j)

def parseOneParamW(name: String, ty: String, p: (Expr, Int), toks: Toks): (Param, Int) =
  p match {
    case (e, k) => parseOneParamD(if (parseErrorExpr(e)) "#parse" else name, ty, pretty0(e), toks, k)
  }

def parseOneParamD(name: String, ty: String, w: String, toks: Toks, j: Int): (Param, Int) =
  if (_is(toks, j, Tok.Eq)) parseOneParamD2(name, ty, w, parseExpr(toks, j + 1)) else (Param(name, ty, w, ""), j)

def parseOneParamD2(name: String, ty: String, w: String, p: (Expr, Int)): (Param, Int) =
  p match {
    case (e, k) => (Param(if (parseErrorExpr(e)) "#parse" else name, ty, w, pretty0(e)), k)
  }

def parseParamListNext(p: (Param, Int), toks: Toks, acc: List[Param]): (List[Param], Int) =
  p match {
    case (par, j) => if (parseErrorParam(par)) (List.reverse(par :: acc), j) else if (_is(toks, j, Tok.Comma)) parseParamList(toks, j + 1, par :: acc) else if (_is(toks, j, Tok.RParen)) (List.reverse(par :: acc), j + 1) else (List.reverse(Param("#parse", "", "", "") :: par :: acc), j)
  }

def _badTParams(ts: List[String]): Bool =
  List.contains(ts, "") || List.contains(ts, "#parse")

def parseDef(toks: Toks, i: Int, priv: Bool, ora: Bool): (Fun, Int) =
  if (_identOf(_at(toks, i)) == "") (Fun(priv, ora, "#parse", [], [], "Unit", Expr.EUnit, "", _off(toks, i)), i) else parseDefName(priv, ora, _identOf(_at(toks, i)), toks, i + 1, _off(toks, i))

def parseDefName(priv: Bool, ora: Bool, name: String, toks: Toks, i: Int, off: Int): (Fun, Int) =
  if (_is(toks, i, Tok.Dot)) if (_identOf(_at(toks, i + 1)) == "") (Fun(priv, ora, "#parse", [], [], "Unit", Expr.EUnit, "", off), i + 1) else parseDefName(priv, ora, Str.concat(name, Str.concat(".", _identOf(_at(toks, i + 1)))), toks, i + 2, off) else parseDefTp(priv, ora, name, parseTParams(toks, i), toks, off)

def parseDefTp(priv: Bool, ora: Bool, name: String, p: (List[String], Int), toks: Toks, off: Int): (Fun, Int) =
  p match {
    case (ts, j) => if (_badTParams(ts)) (Fun(priv, ora, "#parse", [], [], "Unit", Expr.EUnit, "", off), j) else parseDef2(priv, ora, name, ts, parseParams(toks, j), toks, off)
  }

def parseDef2(priv: Bool, ora: Bool, name: String, ts: List[String], p: (List[Param], Int), toks: Toks, off: Int): (Fun, Int) =
  p match {
    case (params, j) => if (List.exists(params, par => parseErrorParam(par)) || !_is(toks, j, Tok.Colon)) (Fun(priv, ora, "#parse", ts, params, "", Expr.EUnit, "", off), j) else parseDef3(priv, ora, name, ts, params, parseType(toks, j + 1), toks, off)
  }

def parseDef3(priv: Bool, ora: Bool, name: String, ts: List[String], params: List[Param], p: (String, Int), toks: Toks, off: Int): (Fun, Int) =
  p match {
    case (ret, j) => if (ret == "" || !_is(toks, j, Tok.Eq)) (Fun(priv, ora, "#parse", ts, params, ret, Expr.EUnit, "", off), j) else parseDef4(priv, ora, name, ts, params, ret, parseExpr(toks, j + 1), off)
  }

def parseDef4(priv: Bool, ora: Bool, name: String, ts: List[String], params: List[Param], ret: String, p: (Expr, Int), off: Int): (Fun, Int) =
  p match {
    case (body, j) => (Fun(priv, ora, name, ts, params, ret, body, "", off), j)
  }

def parseMain(toks: Toks, i: Int): (String, Expr, Int) =
  if (_identOf(_at(toks, i)) == "" || !_is(toks, i + 1, Tok.Colon)) ("#parse", Expr.EVar("", _off(toks, i)), i) else parseMain2(_identOf(_at(toks, i)), parseType(toks, i + 2), toks)

def parseMain2(name: String, p: (String, Int), toks: Toks): (String, Expr, Int) =
  p match {
    case (ret, j) => if (ret == "" || !_is(toks, j, Tok.Eq)) ("#parse", Expr.EVar("", _off(toks, j)), j) else parseMain3(name, parseExpr(toks, j + 1))
  }

def parseMain3(name: String, p: (Expr, Int)): (String, Expr, Int) =
  p match {
    case (body, j) => (if (name == "") "#parse" else name, body, j)
  }

def parseTParams(toks: Toks, i: Int): (List[String], Int) =
  if (_is(toks, i, Tok.LBracket)) parseTParamList(toks, i + 1, []) else ([], i)

def parseTParamList(toks: Toks, i: Int, acc: List[String]): (List[String], Int) =
  if (_identOf(_at(toks, i)) == "") ("#parse" :: [], i) else parseTParamNext(_identOf(_at(toks, i)), toks, i + 1, acc)

def parseTParamNext(name: String, toks: Toks, i: Int, acc: List[String]): (List[String], Int) =
  if (_is(toks, i, Tok.Comma)) parseTParamList(toks, i + 1, name :: acc) else if (_is(toks, i, Tok.RBracket)) (List.reverse(name :: acc), i + 1) else ("#parse" :: [], i)

def parseEnum(toks: Toks, i: Int): (En, Int) =
  if (_identOf(_at(toks, i)) == "") (En(false, "", [], [], "", false), i) else parseEnumTp(_identOf(_at(toks, i)), parseTParams(toks, i + 1), toks)

def parseEnumTp(name: String, p: (List[String], Int), toks: Toks): (En, Int) =
  p match {
    case (ts, j) => if (_badTParams(ts) || !_is(toks, j, Tok.Colon)) (En(false, "", [], [], "", false), j) else parseEnumCases(name, ts, toks, j + 1, [])
  }

def parseEnumCases(name: String, ts: List[String], toks: Toks, i: Int, acc: List[EnCase]): (En, Int) =
  if (_is(toks, i, Tok.Case)) parseEnumCasesNext(parseEnumCase(toks, i + 1), name, ts, toks, acc, i) else (En(false, name, ts, List.reverse(acc), "", false), i)

def parseEnumCase(toks: Toks, i: Int): (EnCase, Int) =
  if (_identOf(_at(toks, i)) == "") (EnCase("", []), toks.n) else parseEnumCase2(_identOf(_at(toks, i)), toks, i + 1)

def parseEnumCase2(name: String, toks: Toks, i: Int): (EnCase, Int) =
  if (_is(toks, i, Tok.LParen)) parseEnumCase3(name, parseParamList(toks, i + 1, [])) else (EnCase(name, []), i)

def parseEnumCase3(name: String, p: (List[Param], Int)): (EnCase, Int) =
  p match {
    case (fs, j) => (EnCase(name, fs), j)
  }

def parseEnumCasesNext(p: (EnCase, Int), name: String, ts: List[String], toks: Toks, acc: List[EnCase], previous: Int): (En, Int) =
  p match {
    case (c, j) => if (j <= previous) (En(false, name, ts, List.reverse(acc), "", false), toks.n) else parseEnumCases(name, ts, toks, j, c :: acc)
  }

def parseRec(toks: Toks, i: Int): (En, Int) =
  if (_identOf(_at(toks, i)) == "") (En(true, "", [], [], "", false), i) else parseRecTp(_identOf(_at(toks, i)), parseTParams(toks, i + 1), toks)

def parseRecTp(name: String, p: (List[String], Int), toks: Toks): (En, Int) =
  p match {
    case (ts, j) => parseRecOpen(name, ts, _is(toks, j, Tok.Private), if (_is(toks, j, Tok.Private)) j + 1 else j, toks)
  }

def parseRecOpen(name: String, ts: List[String], privateCtor: Bool, i: Int, toks: Toks): (En, Int) =
  if (_badTParams(ts) || !_is(toks, i, Tok.LParen)) (En(true, "", [], [], "", false), i) else parseRecFields(name, ts, privateCtor, parseParamList(toks, i + 1, []))

def parseRecFields(name: String, ts: List[String], privateCtor: Bool, p: (List[Param], Int)): (En, Int) =
  p match {
    case (fs, j) => (En(true, name, ts, EnCase(name, fs) :: [], "", privateCtor), j)
  }

def parseAlias(toks: Toks, i: Int): (Alias, Int) =
  if (_identOf(_at(toks, i)) == "") (Alias("", [], "", ""), i) else parseAliasTp(_identOf(_at(toks, i)), parseTParams(toks, i + 1), toks)

def parseAliasTp(name: String, p: (List[String], Int), toks: Toks): (Alias, Int) =
  p match {
    case (ts, j) => if (_badTParams(ts) || !_is(toks, j, Tok.Eq)) (Alias("", [], "", ""), j) else parseAliasTarget(name, ts, parseType(toks, j + 1))
  }

def parseAliasTarget(name: String, ts: List[String], p: (String, Int)): (Alias, Int) =
  p match {
    case (ty, j) => (Alias(name, ts, ty, ""), j)
  }

def parseImport(toks: Toks, i: Int): (Imp, Int) =
  if (_identOf(_at(toks, i)) == "") (Imp("", "", "", ""), i) else if (!_is(toks, i + 1, Tok.Dot)) (Imp("", "", "", ""), i + 1) else parseImportName(_identOf(_at(toks, i)), toks, i + 2)

def parseImportName(mod: String, toks: Toks, i: Int): (Imp, Int) =
  if (_is(toks, i, Tok.Star)) (Imp(mod, "*", "", ""), i + 1) else if (_identOf(_at(toks, i)) == "") (Imp("", "", "", ""), i) else parseImportAs(mod, _identOf(_at(toks, i)), toks, i + 1)

def parseImportAs(mod: String, name: String, toks: Toks, i: Int): (Imp, Int) =
  if (_identOf(_at(toks, i)) == "as") if (_identOf(_at(toks, i + 1)) == "") (Imp("", "", "", ""), i + 1) else (Imp(mod, name, _identOf(_at(toks, i + 1)), ""), i + 2) else (Imp(mod, name, "", ""), i)

def parseTrait(toks: Toks, i: Int): (Tr, Int) =
  if (_identOf(_at(toks, i)) == "") (Tr("", [], [], ""), i) else parseTraitTp(_identOf(_at(toks, i)), parseTParams(toks, i + 1), toks)

def parseTraitTp(name: String, p: (List[String], Int), toks: Toks): (Tr, Int) =
  p match {
    case (ts, j) => if (_badTParams(ts) || !_is(toks, j, Tok.Colon)) (Tr("", [], [], ""), j) else parseTraitMeths(name, ts, toks, j + 1, [])
  }

def parseTraitMeth(toks: Toks, i: Int): (TrMethod, Int) =
  if (_identOf(_at(toks, i)) == "") (TrMethod("", [], ""), i) else parseTraitMeth2(_identOf(_at(toks, i)), parseParams(toks, i + 1), toks)

def parseTraitMeth2(name: String, p: (List[Param], Int), toks: Toks): (TrMethod, Int) =
  p match {
    case (params, j) => if (List.exists(params, par => parseErrorParam(par)) || !_is(toks, j, Tok.Colon)) (TrMethod("", params, ""), j) else parseTraitMeth3(name, params, parseType(toks, j + 1))
  }

def parseTraitMeth3(name: String, params: List[Param], p: (String, Int)): (TrMethod, Int) =
  p match {
    case (ret, j) => (TrMethod(if (ret == "") "" else name, params, ret), j)
  }

def parseTraitMeths(name: String, ts: List[String], toks: Toks, i: Int, acc: List[TrMethod]): (Tr, Int) =
  if (_is(toks, i, Tok.Def) && _sp(toks, i).column > 0) parseTraitMethsNext(parseTraitMeth(toks, i + 1), name, ts, toks, acc) else (Tr(name, ts, List.reverse(acc), ""), i)

def parseTraitMethsNext(p: (TrMethod, Int), name: String, ts: List[String], toks: Toks, acc: List[TrMethod]): (Tr, Int) =
  p match {
    case (m, j) => parseTraitMeths(name, ts, toks, j, m :: acc)
  }

def parseImplArgs(toks: Toks, i: Int): (List[String], Int) =
  if (_is(toks, i, Tok.LBracket)) parseImplArgsClose(_joinTypes(toks, i + 1, []), toks) else ([], i)

def parseImplArgsClose(p: (List[String], Int), toks: Toks): (List[String], Int) =
  p match {
    case (ts, j) => if (!_badTypes(ts) && _is(toks, j, Tok.RBracket)) (ts, j + 1) else ("" :: [], j)
  }

def parseImpl(toks: Toks, i: Int): (Im, Int) =
  if (_identOf(_at(toks, i)) == "") (Im("", [], "", [], ""), i) else parseImplName(parseTypeQual(toks, i + 1, _identOf(_at(toks, i))), toks)

def parseImplName(p: (String, Int), toks: Toks): (Im, Int) =
  p match {
    case (name, j) => if (name == "") (Im("", [], "", [], ""), j) else parseImpl2(name, parseImplArgs(toks, j), toks)
  }

def parseImpl2(tn: String, p: (List[String], Int), toks: Toks): (Im, Int) =
  p match {
    case (args, j) => if (List.contains(args, "") || !_is(toks, j, Tok.For)) (Im("", [], "", [], ""), j) else parseImplReceiver(tn, args, parseType(toks, j + 1), toks)
  }

def parseImplReceiver(tn: String, args: List[String], receiver: (String, Int), toks: Toks): (Im, Int) =
  receiver match {
    case (ty, j) => if (ty == "" || !_is(toks, j, Tok.Colon)) (Im("", [], "", [], ""), j) else parseImplMeths(tn, args, ty, toks, j + 1, [])
  }

def parseImplMeths(tn: String, args: List[String], forTy: String, toks: Toks, i: Int, acc: List[Fun]): (Im, Int) =
  if (_is(toks, i, Tok.Def) && _sp(toks, i).column > 0) parseImplMethsNext(parseDef(toks, i + 1, false, false), tn, args, forTy, toks, acc) else (Im(tn, args, forTy, List.reverse(acc), ""), i)

def parseImplMethsNext(p: (Fun, Int), tn: String, args: List[String], forTy: String, toks: Toks, acc: List[Fun]): (Im, Int) =
  p match {
    case (d, j) => parseImplMeths(tn, args, forTy, toks, j, d :: acc)
  }

def parseItems(toks: Toks, i: Int, enums: List[En], aliases: List[Alias], traits: List[Tr], impls: List[Im], imps: List[Imp], defs: List[Fun], main: String, body: Expr): Prog =
  if (i < toks.n && _is(toks, i, Tok.Private)) parseItemsPriv(toks, i, enums, aliases, traits, impls, imps, defs, main, body) else if (i < toks.n && _is(toks, i, Tok.Oracle)) parseItemsDef(toks, parseDef(toks, i + 1, false, true), enums, aliases, traits, impls, imps, defs, main, body) else parseItemsGo(toks, i, enums, aliases, traits, impls, imps, defs, main, body)

def parseItemsPriv(toks: Toks, i: Int, enums: List[En], aliases: List[Alias], traits: List[Tr], impls: List[Im], imps: List[Imp], defs: List[Fun], main: String, body: Expr): Prog =
  if (_is(toks, i + 1, Tok.Def)) parseItemsDef(toks, parseDef(toks, i + 2, true, false), enums, aliases, traits, impls, imps, defs, main, body) else parseItemsFail(toks, i + 1, enums, aliases, traits, impls, imps, defs, main, body)

def parseItemsGo(toks: Toks, i: Int, enums: List[En], aliases: List[Alias], traits: List[Tr], impls: List[Im], imps: List[Imp], defs: List[Fun], main: String, body: Expr): Prog =
  if (i >= toks.n) parseItemsFail(toks, toks.n - 1, enums, aliases, traits, impls, imps, defs, main, body) else if (_is(toks, i, Tok.Eof)) Prog("", List.reverse(enums), List.reverse(aliases), List.reverse(traits), List.reverse(impls), List.reverse(imps), List.reverse(defs), main, body, "") else if (_is(toks, i, Tok.Enum)) parseItemsEn(toks, parseEnum(toks, i + 1), enums, aliases, traits, impls, imps, defs, main, body) else if (_is(toks, i, Tok.Record)) parseItemsEn(toks, parseRec(toks, i + 1), enums, aliases, traits, impls, imps, defs, main, body) else if (_is(toks, i, Tok.TypeKw)) parseItemsAl(toks, parseAlias(toks, i + 1), enums, aliases, traits, impls, imps, defs, main, body) else if (_is(toks, i, Tok.Trait)) parseItemsTr(toks, parseTrait(toks, i + 1), enums, aliases, traits, impls, imps, defs, main, body) else if (_is(toks, i, Tok.Impl)) parseItemsIm(toks, parseImpl(toks, i + 1), enums, aliases, traits, impls, imps, defs, main, body) else if (_is(toks, i, Tok.Import)) parseItemsImp(toks, parseImport(toks, i + 1), enums, aliases, traits, impls, imps, defs, main, body) else if (_is(toks, i, Tok.Def)) parseItemsDef(toks, parseDef(toks, i + 1, false, false), enums, aliases, traits, impls, imps, defs, main, body) else if (_is(toks, i, Tok.AtMain)) if (!_is(toks, i + 1, Tok.Def)) parseItemsFail(toks, i + 1, enums, aliases, traits, impls, imps, defs, main, body) else parseItemsMain(toks, parseMain(toks, i + 2), enums, aliases, traits, impls, imps, defs, main, body, i) else parseItemsFail(toks, i, enums, aliases, traits, impls, imps, defs, main, body)

def parseItemsFail(toks: Toks, i: Int, enums: List[En], aliases: List[Alias], traits: List[Tr], impls: List[Im], imps: List[Imp], defs: List[Fun], main: String, body: Expr): Prog =
  Prog("", List.reverse(enums), List.reverse(aliases), List.reverse(traits), List.reverse(impls), List.reverse(imps), Fun(false, false, "#parse", [], [], "Unit", Expr.EUnit, "", _off(toks, i)) :: List.reverse(defs), main, body, "")

def parseItemsEn(toks: Toks, p: (En, Int), enums: List[En], aliases: List[Alias], traits: List[Tr], impls: List[Im], imps: List[Imp], defs: List[Fun], main: String, body: Expr): Prog =
  p match {
    case (en, j) => parseItems(toks, j, en :: enums, aliases, traits, impls, imps, defs, main, body)
  }

def parseItemsAl(toks: Toks, p: (Alias, Int), enums: List[En], aliases: List[Alias], traits: List[Tr], impls: List[Im], imps: List[Imp], defs: List[Fun], main: String, body: Expr): Prog =
  p match {
    case (a, j) => parseItems(toks, j, enums, a :: aliases, traits, impls, imps, defs, main, body)
  }

def parseItemsTr(toks: Toks, p: (Tr, Int), enums: List[En], aliases: List[Alias], traits: List[Tr], impls: List[Im], imps: List[Imp], defs: List[Fun], main: String, body: Expr): Prog =
  p match {
    case (t, j) => parseItems(toks, j, enums, aliases, t :: traits, impls, imps, defs, main, body)
  }

def parseItemsIm(toks: Toks, p: (Im, Int), enums: List[En], aliases: List[Alias], traits: List[Tr], impls: List[Im], imps: List[Imp], defs: List[Fun], main: String, body: Expr): Prog =
  p match {
    case (im, j) => parseItems(toks, j, enums, aliases, traits, im :: impls, imps, defs, main, body)
  }

def parseItemsImp(toks: Toks, p: (Imp, Int), enums: List[En], aliases: List[Alias], traits: List[Tr], impls: List[Im], imps: List[Imp], defs: List[Fun], main: String, body: Expr): Prog =
  p match {
    case (im, j) => parseItems(toks, j, enums, aliases, traits, impls, im :: imps, defs, main, body)
  }

def parseItemsDef(toks: Toks, p: (Fun, Int), enums: List[En], aliases: List[Alias], traits: List[Tr], impls: List[Im], imps: List[Imp], defs: List[Fun], main: String, body: Expr): Prog =
  p match {
    case (d, j) => parseItems(toks, j, enums, aliases, traits, impls, imps, d :: defs, main, body)
  }

def parseItemsMain(toks: Toks, p: (String, Expr, Int), enums: List[En], aliases: List[Alias], traits: List[Tr], impls: List[Im], imps: List[Imp], defs: List[Fun], main: String, body: Expr, i: Int): Prog =
  if (main != "") parseItemsFail(toks, i, enums, aliases, traits, impls, imps, defs, main, body) else p match {
  case (name, mainBody, j) => parseItems(toks, j, enums, aliases, traits, impls, imps, defs, name, mainBody)
}

def parsePkg(toks: Toks, i: Int): (String, Int) =
  if (_identOf(_at(toks, i)) == "") ("", i) else parsePkgRest(_identOf(_at(toks, i)), toks, i + 1)

def parsePkgRest(acc: String, toks: Toks, i: Int): (String, Int) =
  if (_is(toks, i, Tok.Dot)) if (_identOf(_at(toks, i + 1)) == "") ("", i + 1) else parsePkgRest(Str.concat(acc, Str.concat(".", _identOf(_at(toks, i + 1)))), toks, i + 2) else (acc, i)

def parse(toks: List[SpTok]): Prog =
  parseGo(indexToks(toks))

def parseGo(toks: Toks): Prog =
  if (toks.bad >= 0) parseItemsFail(toks, toks.bad, [], [], [], [], [], [], "", Expr.EVar("", 0)) else if (_is(toks, 0, Tok.Package)) parsePkgThen(parsePkg(toks, 1), toks) else parseItems(toks, 0, [], [], [], [], [], [], "", Expr.EVar("", 0))

def parsePkgThen(p: (String, Int), toks: Toks): Prog =
  p match {
    case (pkg, j) => if (pkg == "") parseItemsFail(toks, j, [], [], [], [], [], [], "", Expr.EVar("", 0)) else withPkg(pkg, parseItems(toks, j, [], [], [], [], [], [], "", Expr.EVar("", 0)))
  }

def withPkg(pkg: String, p: Prog): Prog =
  Prog(pkg, p.enums, p.aliases, p.traits, p.impls, p.imps, p.defs, p.main, p.body, "")

def _pad(n: Int): String =
  Str.repeat("  ", n)

def _esc1(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else _esc2(s, i, b, Str.charAt(s, i))

def _esc2(s: String, i: Int, b: Builder, c: Int): String =
  _esc1(s, i + 1, Builder.append(b, if (c == 10) "\\n" else if (c == 9) "\\t" else if (c == 34) "\\\"" else if (c == 92) "\\\\" else Str.slice(s, i, i + 1)))

def _hasChar(s: String, i: Int, c: Int): Bool =
  if (i >= Str.len(s)) false else if (Str.charAt(s, i) == c) true else _hasChar(s, i + 1, c)

def patternAlternativeAt(s: String, i: Int, depth: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 34) patternAlternativeAt(s, quotedEnd(s, i), depth) else if (Str.charAt(s, i) == 40) patternAlternativeAt(s, i + 1, depth + 1) else if (Str.charAt(s, i) == 41) patternAlternativeAt(s, i + 1, if (depth > 0) depth - 1 else 0) else if (depth == 0 && at3(s, i, 32, 124, 32)) i else patternAlternativeAt(s, i + 1, depth)

def at3(s: String, i: Int, a: Int, b: Int, c: Int): Bool =
  Str.charAt(s, i) == a && Str.charAt(s, i + 1) == b && Str.charAt(s, i + 2) == c

def quotedEnd(s: String, i: Int): Int =
  if (at3(s, i, 34, 34, 34)) quotedTripleEnd(s, i + 3) else quotedSingleEnd(s, i + 1)

def quotedSingleEnd(s: String, i: Int): Int =
  if (i >= Str.len(s)) Str.len(s) else if (Str.charAt(s, i) == 92) quotedSingleEnd(s, i + 2) else if (Str.charAt(s, i) == 34) i + 1 else quotedSingleEnd(s, i + 1)

def quotedTripleEnd(s: String, i: Int): Int =
  if (i >= Str.len(s)) Str.len(s) else if (at3(s, i, 34, 34, 34)) i + 3 else quotedTripleEnd(s, i + 1)

def quote(s: String): String =
  if (_hasChar(s, 0, 10) && !_hasChar(s, 0, 34)) Str.concat("\"\"\"", Str.concat(s, "\"\"\"")) else Str.concat("\"", Str.concat(_esc1(s, 0, Builder.empty()), "\""))

def pretty0(e: Expr): String =
  prettyExpr(e, 0)

def _commaExprs(xs: List[Expr]): String =
  if (List.isEmpty(xs)) "" else if (List.len(xs) == 1) pretty0(List.at(xs, 0)) else Str.concat(pretty0(List.at(xs, 0)), Str.concat(", ", _commaExprs(List.tail(xs))))

def prettyExpr(e: Expr, n: Int): String =
  e match {
    case Expr.EInt(k, _) => Str.concat(_pad(n), Str.fromInt(k))
    case Expr.EBool(b) => Str.concat(_pad(n), if (b) "true" else "false")
    case Expr.EStr(s, _) => Str.concat(_pad(n), quote(s))
    case Expr.EVar(s, _) => Str.concat(_pad(n), s)
    case Expr.EHole => Str.concat(_pad(n), "_")
    case Expr.EUnit => Str.concat(_pad(n), "()")
    case Expr.EPrint(inner, _) => Str.concat(_pad(n), Str.concat("IO.println(", Str.concat(pretty0(inner), ")")))
    case Expr.ECall(f, args, _) => Str.concat(_pad(n), Str.concat(f, Str.concat("(", Str.concat(_commaExprs(args), ")"))))
    case Expr.EMethod(recv, name, args, _) => Str.concat(_pad(n), prettyMethod(recv, name, args))
    case Expr.EField(recv, name, _) => Str.concat(_pad(n), Str.concat(_prettyRecv(recv), Str.concat(".", name)))
    case Expr.EBin(op, l, r, _) => Str.concat(_pad(n), prettyBin(op, l, r))
    case Expr.EUn(op, inner, _) => Str.concat(_pad(n), _prettyUnary(op, inner))
    case Expr.ELam(p, ty, body) => Str.concat(_pad(n), prettyLam(p, ty, body))
    case Expr.EIf(c, t, el, _) => Str.concat(_pad(n), Str.concat("if (", Str.concat(pretty0(c), Str.concat(") ", Str.concat(pretty0(t), Str.concat(" else ", pretty0(el)))))))
    case Expr.EMatch(s, arms, _) => Str.concat(_pad(n), Str.concat(_prettyRecv(s), Str.concat(""" match {
""", Str.concat(prettyArms(arms, n + 1), Str.concat(_pad(n), "}")))))
    case Expr.EFor(bs, body, _) => Str.concat(_pad(n), Str.concat("""for {
""", Str.concat(prettyBinds(bs, n + 1), Str.concat(_pad(n), Str.concat("} yield ", pretty0(body))))))
    case Expr.EFloat(s, _) => Str.concat(_pad(n), s)
    case Expr.EInterp(s, _, _) => Str.concat(_pad(n), Str.concat("s\"", Str.concat(s, "\"")))
    case Expr.EList(xs) => Str.concat(_pad(n), Str.concat("[", Str.concat(_commaExprs(xs), "]")))
    case Expr.ETuple(xs) => Str.concat(_pad(n), Str.concat("(", Str.concat(_commaExprs(xs), ")")))
    case Expr.ENamed(name, e) => Str.concat(_pad(n), Str.concat(name, Str.concat(" = ", pretty0(e))))
    case Expr.EAscribe(inner, ty, _) => Str.concat(_pad(n), Str.concat(prettyAsc(inner), Str.concat(": ", ty)))
  }

def prettyMethod(recv: Expr, name: String, args: List[Expr]): String =
  if (name == "apply") Str.concat(_prettyRecv(recv), Str.concat("(", Str.concat(_commaExprs(args), ")"))) else Str.concat(_prettyRecv(recv), Str.concat(".", Str.concat(name, Str.concat("(", Str.concat(_commaExprs(args), ")")))))

def prettyLam(p: String, ty: String, body: Expr): String =
  if (ty == "") Str.concat(p, Str.concat(" => ", pretty0(body))) else Str.concat("(", Str.concat(p, Str.concat(": ", Str.concat(ty, Str.concat(") => ", pretty0(body))))))

def prettyAsc(e: Expr): String =
  e match {
    case Expr.EBin(_, _, _, _) => _parenPretty(e)
    case Expr.EIf(_, _, _, _) => _parenPretty(e)
    case Expr.ELam(_, _, _) => _parenPretty(e)
    case Expr.EAscribe(_, _, _) => _parenPretty(e)
    case _ => pretty0(e)
  }

def prettyBin(op: String, l: Expr, r: Expr): String =
  if (op == "::") Str.concat(_prettyBinR(op, l), Str.concat(" :: ", _prettyBinL(op, r))) else Str.concat(_prettyBinL(op, l), Str.concat(" ", Str.concat(op, Str.concat(" ", _prettyBinR(op, r)))))

def binPrec(op: String): Int =
  if (op == "||") 1 else if (op == "&&") 2 else if (op == "|") 3 else if (op == "^") 4 else if (op == "&") 5 else if (op == "::") 7 else if (op == "<<" || op == ">>") 8 else if (op == "+" || op == "-") 9 else if (op == "*" || op == "/" || op == "%") 10 else 6

def _prettyUn(e: Expr): String =
  e match {
    case Expr.EBin(_, _, _, _) => Str.concat("(", Str.concat(pretty0(e), ")"))
    case Expr.EIf(_, _, _, _) => Str.concat("(", Str.concat(pretty0(e), ")"))
    case Expr.EMatch(_, _, _) => Str.concat("(", Str.concat(pretty0(e), ")"))
    case Expr.EFor(_, _, _) => Str.concat("(", Str.concat(pretty0(e), ")"))
    case Expr.EAscribe(_, _, _) => Str.concat("(", Str.concat(pretty0(e), ")"))
    case _ => pretty0(e)
  }

def _parenPretty(e: Expr): String =
  Str.concat("(", Str.concat(pretty0(e), ")"))

def _prettyUnary(op: String, e: Expr): String =
  e match {
    case Expr.EInt(n, _) => if (op == "-" && n == 0 - 9223372036854775807 - 1) Str.fromInt(n) else Str.concat(op, _prettyUn(e))
    case _ => Str.concat(op, _prettyUn(e))
  }

def _prettyBinL(op: String, e: Expr): String =
  e match {
    case Expr.EBin(o2, _, _, _) => if (binPrec(o2) < binPrec(op)) _parenPretty(e) else pretty0(e)
    case Expr.EIf(_, _, _, _) => _parenPretty(e)
    case Expr.EFor(_, _, _) => _parenPretty(e)
    case Expr.ELam(_, _, _) => _parenPretty(e)
    case Expr.EAscribe(_, _, _) => _parenPretty(e)
    case _ => pretty0(e)
  }

def _prettyBinR(op: String, e: Expr): String =
  e match {
    case Expr.EBin(o2, _, _, _) => if (binPrec(o2) <= binPrec(op)) _parenPretty(e) else pretty0(e)
    case Expr.EIf(_, _, _, _) => _parenPretty(e)
    case Expr.EFor(_, _, _) => _parenPretty(e)
    case Expr.ELam(_, _, _) => _parenPretty(e)
    case Expr.EAscribe(_, _, _) => _parenPretty(e)
    case _ => pretty0(e)
  }

def _prettyRecv(e: Expr): String =
  e match {
    case Expr.EBin(_, _, _, _) => _parenPretty(e)
    case Expr.EUn(_, _, _) => _parenPretty(e)
    case Expr.EIf(_, _, _, _) => _parenPretty(e)
    case Expr.EFor(_, _, _) => _parenPretty(e)
    case Expr.ELam(_, _, _) => _parenPretty(e)
    case Expr.EAscribe(_, _, _) => _parenPretty(e)
    case _ => pretty0(e)
  }

def prettyArm(a: Arm, n: Int): String =
  if (a.g == "") Str.concat(_pad(n), Str.concat("case ", Str.concat(a.pat, Str.concat(" => ", pretty0(a.body))))) else Str.concat(_pad(n), Str.concat("case ", Str.concat(a.pat, Str.concat(" if ", Str.concat(a.g, Str.concat(" => ", pretty0(a.body)))))))

def prettyArms(xs: List[Arm], n: Int): String =
  if (List.isEmpty(xs)) "" else Str.concat(prettyArm(List.at(xs, 0), n), Str.concat("""
""", prettyArms(List.tail(xs), n)))

def prettyBind(b: Bind, n: Int): String =
  if (b.name == "__guard") Str.concat(_pad(n), Str.concat("if ", Str.concat(pretty0(b.value), """
"""))) else Str.concat(_pad(n), Str.concat(b.name, Str.concat(if (b.draw) " <- " else " = ", Str.concat(pretty0(b.value), """
"""))))

def prettyBinds(xs: List[Bind], n: Int): String =
  if (List.isEmpty(xs)) "" else Str.concat(prettyBind(List.at(xs, 0), n), prettyBinds(List.tail(xs), n))

def _tparams(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else Str.concat("[", Str.concat(_joinComma(xs), "]"))

def prettyCase(c: EnCase): String =
  if (List.isEmpty(c.fields)) Str.concat("  case ", Str.concat(c.name, """
""")) else Str.concat("  case ", Str.concat(c.name, Str.concat("(", Str.concat(_commaParams(c.fields), """)
"""))))

def prettyCases(xs: List[EnCase]): String =
  if (List.isEmpty(xs)) "" else Str.concat(prettyCase(List.at(xs, 0)), prettyCases(List.tail(xs)))

def prettyEn(e: En): String =
  e match {
    case En(isRec, name, tparams, cases) => prettyEnHit(isRec, name, tparams, cases, e.privateCtor)
  }

def prettyEnHit(isRec: Bool, name: String, tparams: List[String], cases: List[EnCase], privateCtor: Bool): String =
  if (isRec) prettyRec(name, tparams, cases, privateCtor) else prettyEnum(name, tparams, cases)

def prettyRec(name: String, tparams: List[String], cases: List[EnCase], privateCtor: Bool): String =
  prettyRecHd(name, tparams, List.at(cases, 0), privateCtor)

def prettyRecHd(name: String, tparams: List[String], c: EnCase, privateCtor: Bool): String =
  c match {
    case EnCase(_, fields) => prettyRecFields(name, tparams, fields, privateCtor)
  }

def prettyRecFields(name: String, tparams: List[String], fields: List[Param], privateCtor: Bool): String =
  Str.concat("record ", Str.concat(name, Str.concat(_tparams(tparams), Str.concat(if (privateCtor) " private(" else "(", Str.concat(_commaParams(fields), """)
""")))))

def prettyEnum(name: String, tparams: List[String], cases: List[EnCase]): String =
  Str.concat("enum ", Str.concat(name, Str.concat(_tparams(tparams), Str.concat(""":
""", prettyCases(cases)))))

def prettyEnums(xs: List[En]): String =
  if (List.isEmpty(xs)) "" else Str.concat(prettyEn(List.at(xs, 0)), Str.concat("""
""", prettyEnums(List.tail(xs))))

def _paramStr(p: Param): String =
  _paramStrD(if (p.w == "") Str.concat(p.name, Str.concat(": ", p.ty)) else Str.concat(p.name, Str.concat(": ", Str.concat(p.ty, Str.concat(" where ", p.w)))), p.d)

def _paramStrD(base: String, d: String): String =
  if (d == "") base else Str.concat(base, Str.concat(" = ", d))

def _commaParams(xs: List[Param]): String =
  if (List.isEmpty(xs)) "" else if (List.len(xs) == 1) _paramStr(List.at(xs, 0)) else Str.concat(_paramStr(List.at(xs, 0)), Str.concat(", ", _commaParams(List.tail(xs))))

def funKw(d: Fun): String =
  if (d.ora) "oracle " else if (d.priv) "private def " else "def "

def prettyFun(d: Fun): String =
  Str.concat(funKw(d), Str.concat(d.name, Str.concat(_tparams(d.tparams), Str.concat("(", Str.concat(_commaParams(d.params), Str.concat("): ", Str.concat(d.ret, Str.concat(""" =
""", prettyExpr(d.body, 1)))))))))

def prettyDefs(ds: List[Fun]): String =
  if (List.isEmpty(ds)) "" else Builder.result(prettyDefsGo(ds, Builder.empty()))

def prettyDefsGo(ds: List[Fun], b: Builder): Builder =
  if (List.isEmpty(ds)) b else prettyDefsGo(List.tail(ds), Builder.append(Builder.append(b, prettyFun(List.at(ds, 0))), """

"""))

def prettyMain(name: String, body: Expr): String =
  if (name == "") "" else Str.concat("@main def ", Str.concat(name, Str.concat(""": IO[Unit] =
""", Str.concat(prettyExpr(body, 1), """
"""))))

def prettyAlias(a: Alias): String =
  Str.concat("type ", Str.concat(a.name, Str.concat(_tparams(a.tparams), Str.concat(" = ", Str.concat(a.target, """
""")))))

def prettyAliases(xs: List[Alias]): String =
  if (List.isEmpty(xs)) "" else Str.concat(prettyAlias(List.at(xs, 0)), prettyAliases(List.tail(xs)))

def prettyImp(im: Imp): String =
  if (im.alias == "") Str.concat("import ", Str.concat(im.mod, Str.concat(".", Str.concat(im.name, """
""")))) else Str.concat("import ", Str.concat(im.mod, Str.concat(".", Str.concat(im.name, Str.concat(" as ", Str.concat(im.alias, """
"""))))))

def prettyImps(xs: List[Imp], rest: Bool): String =
  if (List.isEmpty(xs)) "" else Str.concat(_prettyImpList(xs), if (rest) """
""" else "")

def _prettyImpList(xs: List[Imp]): String =
  if (List.isEmpty(xs)) "" else Str.concat(prettyImp(List.at(xs, 0)), _prettyImpList(List.tail(xs)))

def prettyTrMeth(m: TrMethod): String =
  Str.concat("  def ", Str.concat(m.name, Str.concat("(", Str.concat(_commaParams(m.params), Str.concat("): ", Str.concat(m.ret, """
"""))))))

def prettyTrMeths(xs: List[TrMethod]): String =
  if (List.isEmpty(xs)) "" else Str.concat(prettyTrMeth(List.at(xs, 0)), prettyTrMeths(List.tail(xs)))

def prettyTr(t: Tr): String =
  Str.concat("trait ", Str.concat(t.name, Str.concat(_tparams(t.tparams), Str.concat(""":
""", prettyTrMeths(t.methods)))))

def prettyTraits(xs: List[Tr]): String =
  if (List.isEmpty(xs)) "" else Str.concat(prettyTr(List.at(xs, 0)), Str.concat("""
""", prettyTraits(List.tail(xs))))

def prettyImplFun(d: Fun): String =
  Str.concat("  def ", Str.concat(d.name, Str.concat("(", Str.concat(_commaParams(d.params), Str.concat("): ", Str.concat(d.ret, Str.concat(""" =
""", Str.concat(prettyExpr(d.body, 2), """
"""))))))))

def prettyImplFuns(xs: List[Fun]): String =
  if (List.isEmpty(xs)) "" else Str.concat(prettyImplFun(List.at(xs, 0)), prettyImplFuns(List.tail(xs)))

def prettyImDef(im: Im): String =
  Str.concat("impl ", Str.concat(im.tn, Str.concat(_tparams(im.targs), Str.concat(" for ", Str.concat(im.forTy, Str.concat(""":
""", prettyImplFuns(im.methods)))))))

def prettyImpls(xs: List[Im]): String =
  if (List.isEmpty(xs)) "" else Str.concat(prettyImDef(List.at(xs, 0)), Str.concat("""
""", prettyImpls(List.tail(xs))))

def prettyPkg(pkg: String): String =
  if (pkg == "") "" else Str.concat("package ", Str.concat(pkg, """

"""))

def stampFun(mod: String, d: Fun): Fun =
  d match {
    case Fun(priv, ora, name, tparams, params, ret, body, _, off) => Fun(priv, ora, name, tparams, params, ret, body, mod, off)
  }

def stampFuns(mod: String, ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else stampFun(mod, List.at(ds, 0)) :: stampFuns(mod, List.tail(ds))

def stampDefs(mod: String, p: Prog): Prog =
  p match {
    case Prog(pkg, enums, aliases, traits, impls, imps, defs, main, body) => Prog(pkg, stampEns(mod, enums), List.map(aliases, a => Alias(a.name, a.tparams, a.target, mod)), List.map(traits, t => Tr(t.name, t.tparams, t.methods, mod)), List.map(impls, im => Im(im.tn, im.targs, im.forTy, stampFuns(mod, im.methods), mod)), List.map(imps, imp => Imp(imp.mod, imp.name, imp.alias, mod)), stampFuns(mod, defs), main, body, mod)
  }

def stampEns(mod: String, ens: List[En]): List[En] =
  if (List.isEmpty(ens)) ens else stampEn(mod, List.at(ens, 0)) :: stampEns(mod, List.tail(ens))

def stampEn(mod: String, en: En): En =
  En(en.isRec, en.name, en.tparams, en.cases, mod, en.privateCtor)

def noEn(): List[En] =
  []

def noAl(): List[Alias] =
  []

def noTr(): List[Tr] =
  []

def noIm(): List[Im] =
  []

def noImp(): List[Imp] =
  []

def noFun(): List[Fun] =
  []

def emptyProg(): Prog =
  Prog("", noEn(), noAl(), noTr(), noIm(), noImp(), noFun(), "", Expr.EUnit, "")

def optionEn(): En =
  En(false, "Option", "T" :: [], EnCase("None", []) :: EnCase("Some", Param("x", "T", "", "") :: []) :: [], "", false)

def builtins(ens: List[En]): List[En] =
  resultBuiltins(if (hasEnName(ens, "Option")) ens else optionEn() :: ens)

def resultBuiltins(ens: List[En]): List[En] =
  if (hasEnName(ens, "Result")) ens else En(false, "Result", "E" :: "A" :: [], EnCase("Err", Param("error", "E", "", "") :: []) :: EnCase("Ok", Param("value", "A", "", "") :: []) :: [], "", false) :: ens

def hasEnName(ens: List[En], name: String): Bool =
  if (List.isEmpty(ens)) false else hasEnName1(List.at(ens, 0), List.tail(ens), name)

def hasEnName1(h: En, rest: List[En], name: String): Bool =
  h match {
    case En(_, n, _, _) => n == name || hasEnName(rest, name)
  }

def merge(a: Prog, b: Prog): Prog =
  a match {
    case Prog(ap, ae, aa, at, ai, am, ad, an, ab) => merge2(ap, ae, aa, at, ai, am, ad, an, ab, a.mod, b)
  }

def merge2(ap: String, ae: List[En], aa: List[Alias], at: List[Tr], ai: List[Im], am: List[Imp], ad: List[Fun], an: String, ab: Expr, mainMod: String, b: Prog): Prog =
  b match {
    case Prog(bp, be, ba, bt, bi, bm, bd, bn, bb) => Prog(if (bp == "") ap else bp, List.concat(ae, be), List.concat(aa, ba), List.concat(at, bt), List.concat(ai, bi), List.concat(am, bm), List.concat(ad, bd), if (bn == "") an else bn, if (bn == "") ab else bb, if (bn == "") mainMod else b.mod)
  }

def parseFile(stem: String, src: String): Prog =
  stampDefs(stem, parse(Lexer.lexStem(src, stem)))

def parseFiles(files: List[(String, String)]): Prog =
  parseFiles2(files, emptyProg())

def parseFiles2(files: List[(String, String)], acc: Prog): Prog =
  if (List.isEmpty(files)) acc else parseFiles3(List.at(files, 0), List.tail(files), acc)

def parseFiles3(f: (String, String), rest: List[(String, String)], acc: Prog): Prog =
  f match {
    case (stem, src) => parseFiles2(rest, merge(acc, parseFile(stem, src)))
  }

def hasParseError(p: Prog): Bool =
  parseErrorDefs(p.defs) || List.exists(p.impls, im => im.tn == "" || im.forTy == "" || parseErrorDefs(im.methods)) || List.exists(p.imps, imp => imp.mod == "" || imp.name == "") || List.exists(p.enums, en => en.name == "" || !en.isRec && List.isEmpty(en.cases) || List.exists(en.cases, c => c.name == "" || List.exists(c.fields, p => parseErrorParam(p)))) || List.exists(p.aliases, alias => alias.name == "" || alias.target == "") || List.exists(p.traits, tr => tr.name == "" || List.exists(tr.methods, m => m.name == "" || m.ret == "" || List.exists(m.params, p => parseErrorParam(p)))) || p.main == "#parse" || p.main != "" && parseErrorExpr(p.body)

def parseErrorDefs(defs: List[Fun]): Bool =
  if (List.isEmpty(defs)) false else parseErrorDef(List.at(defs, 0)) || parseErrorDefs(List.tail(defs))

def parseErrorDef(d: Fun): Bool =
  d match {
    case Fun(_, _, name, _, _, _, _, _, _) => name == "#parse" || name == "" || d.ret == "" || List.exists(d.params, p => parseErrorParam(p)) || parseErrorExpr(d.body)
  }

def parseErrorParam(p: Param): Bool =
  p.name == "" || p.name == "#parse" || p.ty == ""

def tokHint(t: Tok): String =
  t match {
    case Tok.Colon => ":"
    case Tok.Eq => "="
    case Tok.Dot => "."
    case Tok.Arrow => "=>"
    case Tok.LeftArrow => "<-"
    case Tok.LParen => "("
    case Tok.RParen => ")"
    case Tok.LBrace => "{"
    case Tok.RBrace => "}"
    case Tok.LBracket => "["
    case Tok.RBracket => "]"
    case Tok.Case => "case"
    case Tok.Def => "def"
    case Tok.For => "for"
    case Tok.Yield => "yield"
    case Tok.Comma => ","
    case _ => "token"
  }

def vFail(toks: Toks, i: Int, hint: String): (Bool, Int, String) =
  (false, _off(toks, i), hint)

def vExpect(toks: Toks, i: Int, t: Tok): (Bool, Int, String) =
  if (_is(toks, i, t)) (true, i + 1, "") else vFail(toks, i, tokHint(t))

def vIdent(toks: Toks, i: Int): (Bool, Int, String) =
  if (_identOf(_at(toks, i)) != "") (true, i + 1, "") else vFail(toks, i, "identifier")

def vQualIdent(toks: Toks, i: Int): (Bool, Int, String) =
  vQualIdentNext(toks, vIdent(toks, i))

def vQualIdentNext(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint) else if (_is(toks, j, Tok.Dot)) vQualIdent(toks, j + 1) else (true, j, "")
  }

def vTParams(toks: Toks, i: Int): (Bool, Int, String) =
  if (_is(toks, i, Tok.LBracket)) vTParamList(toks, i + 1) else (true, i, "")

def vTParamList(toks: Toks, i: Int): (Bool, Int, String) =
  vTParamNext(toks, vIdent(toks, i))

def vTParamNext(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint) else if (_is(toks, j, Tok.Comma)) vTParamList(toks, j + 1) else vExpect(toks, j, Tok.RBracket)
  }

def vTypeList(toks: Toks, i: Int): (Bool, Int, String) =
  vTypeListNext(toks, vType(toks, i))

def vTypeListNext(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint) else if (_is(toks, j, Tok.Comma)) vTypeList(toks, j + 1) else (true, j, "")
  }

def vType(toks: Toks, i: Int): (Bool, Int, String) =
  if (_is(toks, i, Tok.LParen)) vTypeParen(toks, vTypeList(toks, i + 1)) else vTypeArrow(toks, vTypeApp(toks, i))

def vTypeParen(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint) else vTypeArrow(toks, vExpect(toks, j, Tok.RParen))
  }

def vTypeApp(toks: Toks, i: Int): (Bool, Int, String) =
  vTypeAppBrack(toks, vQualIdent(toks, i))

def vTypeAppBrack(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint) else if (_is(toks, j, Tok.LBracket)) vTypeBrack(toks, vTypeList(toks, j + 1)) else (true, j, "")
  }

def vTypeBrack(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint) else vExpect(toks, j, Tok.RBracket)
  }

def vTypeArrow(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, i, hint) => if (!ok) (false, i, hint) else if (_is(toks, i, Tok.Arrow)) vType(toks, i + 1) else (true, i, "")
  }

def vPat(toks: Toks, i: Int): (Bool, Int, String) =
  vPatOr(toks, vPatCons(toks, vPatPrimary(toks, i)))

def vPatCons(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint) else if (_is(toks, j, Tok.ColonColon)) vPat(toks, j + 1) else (true, j, "")
  }

def vPatOr(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint) else if (_is(toks, j, Tok.Pipe)) vPat(toks, j + 1) else (true, j, "")
  }

def vPatPrimary(toks: Toks, i: Int): (Bool, Int, String) =
  _at(toks, i) match {
    case Tok.Underscore => (true, i + 1, "")
    case Tok.Int(_) => (true, i + 1, "")
    case Tok.Minus => vExpect(toks, i + 1, Tok.Int(0))
    case Tok.True => (true, i + 1, "")
    case Tok.False => (true, i + 1, "")
    case Tok.Str(_) => (true, i + 1, "")
    case Tok.Ident(_) => vPatIdent(toks, i + 1)
    case Tok.LParen => vPatParen(toks, i + 1)
    case Tok.LBracket => if (_is(toks, i + 1, Tok.RBracket)) (true, i + 2, "") else vPatList(toks, i + 1)
    case _ => vFail(toks, i, "pattern")
  }

def vPatIdent(toks: Toks, i: Int): (Bool, Int, String) =
  if (_is(toks, i, Tok.At)) vPatPrimary(toks, i + 1) else if (_is(toks, i, Tok.Dot)) vPatQual(toks, vIdent(toks, i + 1)) else if (_is(toks, i, Tok.LParen)) vPatParen(toks, i + 1) else (true, i, "")

def vPatQual(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint) else if (_is(toks, j, Tok.Dot)) vPatQual(toks, vIdent(toks, j + 1)) else if (_is(toks, j, Tok.LParen)) vPatParen(toks, j + 1) else (true, j, "")
  }

def vPatParen(toks: Toks, i: Int): (Bool, Int, String) =
  if (_is(toks, i, Tok.RParen)) (true, i + 1, "") else vPatArgs(toks, i)

def vPatArgs(toks: Toks, i: Int): (Bool, Int, String) =
  vPatArgsNext(toks, vPat(toks, i))

def vPatArgsNext(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint) else if (_is(toks, j, Tok.Eq)) vPatArgsEq(toks, vPatPrimary(toks, j + 1)) else vPatArgsSep(toks, j)
  }

def vPatArgsEq(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, k, hint) => if (!ok) (false, k, hint) else vPatArgsSep(toks, k)
  }

def vPatArgsSep(toks: Toks, j: Int): (Bool, Int, String) =
  if (_is(toks, j, Tok.Comma)) vPatArgs(toks, j + 1) else vExpect(toks, j, Tok.RParen)

def vPatList(toks: Toks, i: Int): (Bool, Int, String) =
  vPatListNext(toks, vPatPrimary(toks, i))

def vPatListNext(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint) else if (_is(toks, j, Tok.Comma)) vPatList(toks, j + 1) else vExpect(toks, j, Tok.RBracket)
  }

def hasNl(src: String, a: Int, b: Int): Bool =
  if (a < 0) hasNl(src, 0, b) else if (a >= b || a >= Str.len(src)) false else if (Str.charAt(src, a) == 10) true else hasNl(src, a + 1, b)

def onNewLine(src: String, toks: Toks, k: Int): Bool =
  k > 0 && hasNl(src, _off(toks, k - 1), _off(toks, k))

def isColZeroLine(src: String, toks: Toks, k: Int): Bool =
  Lexer.columnAt(src, _off(toks, k) - 1, 0) == 0

def isIndentedDefLine(src: String, toks: Toks, k: Int): Bool =
  _is(toks, k, Tok.Def) && _sp(toks, k).column > 0 && (k == 0 || hasNl(src, _off(toks, k - 1), _off(toks, k)))

def _isSemi(src: String, toks: Toks, k: Int): Bool =
  _is(toks, k, Tok.Bad) && _off(toks, k) < Str.len(src) && Str.charAt(src, _off(toks, k)) == 59

def skipSemis(src: String, toks: Toks, k: Int): Int =
  if (_isSemi(src, toks, k)) skipSemis(src, toks, k + 1) else k

def addErr(off: Int, hint: String, acc: List[ErrAt]): List[ErrAt] =
  if (off < 0) acc else if (!List.isEmpty(acc) && off <= List.at(acc, 0).off) acc else ErrAt(off, hint) :: acc

def vLift(step: (Bool, Int, String), failHint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => (ok, j, if (ok) "" else if (hint == "") failHint else hint, acc)
  }

def vFail3(toks: Toks, i: Int, hint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  (false, _off(toks, i), hint, acc)

def vExpect3(toks: Toks, i: Int, t: Tok, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i, t)) (true, i + 1, "", acc) else vFail3(toks, i, tokHint(t), acc)

def isForBindStart(src: String, toks: Toks, k: Int): Bool =
  isForBindPat(src, toks, k, vPat(toks, k))

def isForBindPat(src: String, toks: Toks, k: Int, step: (Bool, Int, String)): Bool =
  step match {
    case (ok, m, hint) => ok && (_is(toks, m, Tok.LeftArrow) || _is(toks, m, Tok.Eq)) && !hasNl(src, _off(toks, k), _off(toks, m))
  }

def vTypeCtx(src: String, toks: Toks, i: Int, inFor: Bool): (Bool, Int, String) =
  if (inFor && onNewLine(src, toks, i) && isForBindStart(src, toks, i)) vFail(toks, i, "type") else vType(toks, i)

def vIdentCtx(src: String, toks: Toks, i: Int, inFor: Bool): (Bool, Int, String) =
  if (inFor && onNewLine(src, toks, i) && isForBindStart(src, toks, i)) vFail(toks, i, "identifier") else vIdent(toks, i)

def isLeadContTok(t: Tok): Bool =
  if (_opTok(t) != "") true else t match {
  case Tok.Dot => true
  case Tok.Comma => true
  case Tok.Colon => true
  case Tok.RParen => true
  case Tok.RBracket => true
  case Tok.Arrow => true
  case Tok.Else => true
  case Tok.Match => true
  case Tok.Where => true
  case Tok.Yield => true
  case _ => false
}

def isTrailContTok(t: Tok): Bool =
  if (_opTok(t) != "") true else t match {
  case Tok.Bang => true
  case Tok.Tilde => true
  case Tok.Dot => true
  case Tok.Comma => true
  case Tok.Colon => true
  case Tok.LParen => true
  case Tok.LBracket => true
  case Tok.Arrow => true
  case Tok.LeftArrow => true
  case Tok.Eq => true
  case Tok.Else => true
  case Tok.If => true
  case Tok.Where => true
  case Tok.Yield => true
  case _ => false
}

def isContLine(src: String, toks: Toks, k: Int): Bool =
  isLeadContTok(_at(toks, k)) || k > 0 && isTrailContTok(_at(toks, k - 1)) && !isForBindStart(src, toks, k) && !_is(toks, k, Tok.Case)

def findCloseBrace(toks: Toks, k: Int, c: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof)) 0 - 1 else _at(toks, k) match {
  case Tok.LBrace => findCloseBrace(toks, k + 1, c + 1)
  case Tok.RBrace => if (c == 1) k + 1 else findCloseBrace(toks, k + 1, c - 1)
  case _ => findCloseBrace(toks, k + 1, c)
}

def findCloseParen(toks: Toks, k: Int, p: Int, b: Int, c: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof)) 0 - 1 else _at(toks, k) match {
  case Tok.LParen => findCloseParen(toks, k + 1, p + 1, b, c)
  case Tok.RParen => if (p == 1) if (b == 0 && c == 0) k + 1 else 0 - 1 else findCloseParen(toks, k + 1, p - 1, b, c)
  case Tok.LBracket => findCloseParen(toks, k + 1, p, b + 1, c)
  case Tok.RBracket => findCloseParen(toks, k + 1, p, if (b > 0) b - 1 else 0, c)
  case Tok.LBrace => findCloseParen(toks, k + 1, p, b, c + 1)
  case Tok.RBrace => if (c > 0) findCloseParen(toks, k + 1, p, b, c - 1) else 0 - 1
  case _ => findCloseParen(toks, k + 1, p, b, c)
}

def findCloseBracket(toks: Toks, k: Int, p: Int, b: Int, c: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof)) 0 - 1 else _at(toks, k) match {
  case Tok.LBracket => findCloseBracket(toks, k + 1, p, b + 1, c)
  case Tok.RBracket => if (b == 1) if (p == 0 && c == 0) k + 1 else 0 - 1 else findCloseBracket(toks, k + 1, p, b - 1, c)
  case Tok.LParen => findCloseBracket(toks, k + 1, p + 1, b, c)
  case Tok.RParen => findCloseBracket(toks, k + 1, if (p > 0) p - 1 else 0, b, c)
  case Tok.LBrace => findCloseBracket(toks, k + 1, p, b, c + 1)
  case Tok.RBrace => if (c > 0) findCloseBracket(toks, k + 1, p, b, c - 1) else 0 - 1
  case _ => findCloseBracket(toks, k + 1, p, b, c)
}

def findNextComma(toks: Toks, k: Int, stopIdx: Int, errOff: Int, p: Int, b: Int, c: Int): Int =
  if (k >= stopIdx || k >= toks.n || _is(toks, k, Tok.Eof)) 0 - 1 else if (p == 0 && b == 0 && c == 0 && _is(toks, k, Tok.Comma) && _off(toks, k) >= errOff) k else _at(toks, k) match {
  case Tok.LParen => findNextComma(toks, k + 1, stopIdx, errOff, p + 1, b, c)
  case Tok.RParen => findNextComma(toks, k + 1, stopIdx, errOff, if (p > 0) p - 1 else 0, b, c)
  case Tok.LBracket => findNextComma(toks, k + 1, stopIdx, errOff, p, b + 1, c)
  case Tok.RBracket => findNextComma(toks, k + 1, stopIdx, errOff, p, if (b > 0) b - 1 else 0, c)
  case Tok.LBrace => findNextComma(toks, k + 1, stopIdx, errOff, p, b, c + 1)
  case Tok.RBrace => findNextComma(toks, k + 1, stopIdx, errOff, p, b, if (c > 0) c - 1 else 0)
  case _ => findNextComma(toks, k + 1, stopIdx, errOff, p, b, c)
}

def vExpr(src: String, toks: Toks, i: Int, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vAscribe(src, toks, vBin(src, toks, i, 0, inFor, acc), inFor)

def vAscribe(src: String, toks: Toks, step: (Bool, Int, String, List[ErrAt]), inFor: Bool): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) (false, j, hint, acc) else if (_is(toks, j, Tok.Colon)) vLift(vTypeCtx(src, toks, j + 1, inFor), "type", acc) else (true, j, "", acc)
  }

def vPrecWant(lvl: Int): String =
  if (lvl == 0) "||" else if (lvl == 1) "&&" else if (lvl == 2) "|" else if (lvl == 3) "^" else if (lvl == 4) "&" else if (lvl == 5) "==" else if (lvl == 7) "<<" else if (lvl == 8) "+" else "*"

def vBin(src: String, toks: Toks, i: Int, lvl: Int, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (lvl == 6) vCons(src, toks, i, inFor, acc) else if (lvl >= 9) vBinRest(src, toks, vUnary(src, toks, i, inFor, acc), 9, inFor) else vBinRest(src, toks, vBin(src, toks, i, lvl + 1, inFor, acc), lvl, inFor)

def vBinRest(src: String, toks: Toks, step: (Bool, Int, String, List[ErrAt]), lvl: Int, inFor: Bool): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) (false, j, hint, acc) else if (_opLevel(_opTok(_at(toks, j)), vPrecWant(lvl))) vBinRest(src, toks, if (lvl >= 9) vUnary(src, toks, j + 1, inFor, acc) else vBin(src, toks, j + 1, lvl + 1, inFor, acc), lvl, inFor) else (true, j, "", acc)
  }

def vCons(src: String, toks: Toks, i: Int, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vConsRest(src, toks, vBin(src, toks, i, 7, inFor, acc), inFor)

def vConsRest(src: String, toks: Toks, step: (Bool, Int, String, List[ErrAt]), inFor: Bool): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) (false, j, hint, acc) else if (_is(toks, j, Tok.ColonColon)) vCons(src, toks, j + 1, inFor, acc) else (true, j, "", acc)
  }

def vUnary(src: String, toks: Toks, i: Int, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i, Tok.Minus) || _is(toks, i, Tok.Bang) || _is(toks, i, Tok.Tilde)) vUnary(src, toks, i + 1, inFor, acc) else vPost(src, toks, vAtom(src, toks, i, inFor, acc), inFor)

def vAtom(src: String, toks: Toks, i: Int, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (inFor && onNewLine(src, toks, i) && isForBindStart(src, toks, i)) vFail3(toks, i, "expression", acc) else _at(toks, i) match {
  case Tok.Int(_) => (true, i + 1, "", acc)
  case Tok.True => (true, i + 1, "", acc)
  case Tok.False => (true, i + 1, "", acc)
  case Tok.Str(_) => (true, i + 1, "", acc)
  case Tok.Float(_) => (true, i + 1, "", acc)
  case Tok.Interp(s) => (true, i + 1, "", vInterp(src, s, 0, _off(toks, i) + 2, acc))
  case Tok.Underscore => if (_is(toks, i + 1, Tok.Arrow)) vExpr(src, toks, i + 2, inFor, acc) else (true, i + 1, "", acc)
  case Tok.LParen => if (_is(toks, i + 1, Tok.RParen)) (true, i + 2, "", acc) else vParenOpen(src, toks, i, inFor, acc)
  case Tok.LBracket => if (_is(toks, i + 1, Tok.RBracket)) (true, i + 2, "", acc) else vListOpen(src, toks, i, acc)
  case Tok.Ident(s) => vIdentAtom(src, toks, i, s, inFor, acc)
  case Tok.If => vIf(src, toks, i, inFor, acc)
  case Tok.For => vFor(src, toks, i, inFor, acc)
  case Tok.LBrace => if (_is(toks, i + 1, Tok.Case)) vMatch(src, toks, i, acc) else vBraceBlock(src, toks, i, acc)
  case _ => vFail3(toks, i, "expression", acc)
}

def vInterp(src: String, s: String, i: Int, base: Int, acc: List[ErrAt]): List[ErrAt] =
  if (i >= Str.len(s)) acc else if (Str.charAt(s, i) == 92 && i + 1 < Str.len(s)) vInterp(src, s, i + 2, base, acc) else if (Str.charAt(s, i) == 36 && i + 1 < Str.len(s) && Str.charAt(s, i + 1) == 123) vInterpBrace(src, s, i, interpCloseBrace(s, i + 2, 1), base, acc) else vInterp(src, s, i + 1, base, acc)

def vInterpBrace(src: String, s: String, i: Int, j: Int, base: Int, acc: List[ErrAt]): List[ErrAt] =
  vInterp(src, s, j, base, vHoleToks(src, indexToks(interpHoleToks(Str.slice(s, i + 2, j - 1), base + i + 2)), acc))

def vHoleToks(src: String, toks: Toks, acc: List[ErrAt]): List[ErrAt] =
  vHoleToksEnd(toks, vExpr(src, toks, 0, false, acc))

def vHoleToksEnd(toks: Toks, step: (Bool, Int, String, List[ErrAt])): List[ErrAt] =
  step match {
    case (ok, j, hint, acc) => if (!ok) addErr(j, hint, acc) else if (!_is(toks, j, Tok.Eof)) addErr(_off(toks, j), "}", acc) else if (toks.bad >= 0) addErr(_off(toks, toks.bad), "", acc) else acc
  }

def vIdentAtom(src: String, toks: Toks, i: Int, s: String, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i + 1, Tok.Arrow)) vExpr(src, toks, i + 2, inFor, acc) else if ((s == "IO" || _kit(s)) && _is(toks, i + 1, Tok.Dot)) vKitCall(src, toks, vIdentCtx(src, toks, i + 2, inFor), acc) else (true, i + 1, "", acc)

def vKitCall(src: String, toks: Toks, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint, acc) else if (_is(toks, j, Tok.LParen) && !forBindAfter(toks, j)) vArgOpen(src, toks, j + 1, acc) else (true, j, "", acc)
  }

def vParenOpen(src: String, toks: Toks, openIdx: Int, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vParen(src, toks, openIdx + 1, findCloseParen(toks, openIdx + 1, 1, 0, 0), vExpr(src, toks, openIdx + 1, false, acc), inFor)

def vParen(src: String, toks: Toks, elemStart: Int, closeIdx: Int, step: (Bool, Int, String, List[ErrAt]), inFor: Bool): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) vParenRecover(src, toks, elemStart, closeIdx, j, hint, inFor, acc) else if (_is(toks, j, Tok.Comma)) vTupleLam(src, toks, closeIdx, vTupleRest(src, toks, j + 1, closeIdx, acc), inFor) else vOneLam(src, toks, elemStart, closeIdx, j, inFor, acc)
  }

def vParenRecover(src: String, toks: Toks, elemStart: Int, closeIdx: Int, errOff: Int, hint: String, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (closeIdx < 0) (false, errOff, hint, acc) else vParenRecoverComma(src, toks, findNextComma(toks, elemStart, closeIdx - 1, errOff, 0, 0, 0), closeIdx, inFor, addErr(errOff, hint, acc))

def vParenRecoverComma(src: String, toks: Toks, commaIdx: Int, closeIdx: Int, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (commaIdx >= 0 && commaIdx + 1 < closeIdx - 1) vTupleLam(src, toks, closeIdx, vTupleRest(src, toks, commaIdx + 1, closeIdx, acc), inFor) else vParenAfterClose(src, toks, closeIdx, inFor, acc)

def vParenAfterClose(src: String, toks: Toks, closeIdx: Int, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, closeIdx, Tok.Arrow)) vExpr(src, toks, closeIdx + 1, inFor, acc) else (true, closeIdx, "", acc)

def vOneLam(src: String, toks: Toks, elemStart: Int, closeIdx: Int, j: Int, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, j, Tok.Colon)) vOneLamTy(src, toks, elemStart, closeIdx, vType(toks, j + 1), inFor, acc) else if (_is(toks, j, Tok.RParen) && _is(toks, j + 1, Tok.Arrow)) vExpr(src, toks, j + 2, inFor, acc) else if (_is(toks, j, Tok.RParen)) (true, j + 1, "", acc) else vParenRecover(src, toks, j, closeIdx, _off(toks, j), ")", inFor, acc)

def vOneLamTy(src: String, toks: Toks, elemStart: Int, closeIdx: Int, step: (Bool, Int, String), inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, k, hint) => if (!ok) vParenRecover(src, toks, elemStart, closeIdx, k, hint, inFor, acc) else vOneLam(src, toks, elemStart, closeIdx, k, inFor, acc)
  }

def vTupleRest(src: String, toks: Toks, i: Int, closeIdx: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vTupleRestNext(src, toks, i, closeIdx, vExpr(src, toks, i, false, acc))

def vTupleRestNext(src: String, toks: Toks, elemStart: Int, closeIdx: Int, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) vTupleRecover(src, toks, elemStart, closeIdx, j, hint, acc) else if (_is(toks, j, Tok.Comma)) vTupleRest(src, toks, j + 1, closeIdx, acc) else if (_is(toks, j, Tok.RParen)) (true, j + 1, "", acc) else vTupleRecover(src, toks, j, closeIdx, _off(toks, j), ")", acc)
  }

def vTupleRecover(src: String, toks: Toks, elemStart: Int, closeIdx: Int, errOff: Int, hint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (closeIdx < 0) (false, errOff, hint, acc) else vTupleRecoverComma(src, toks, findNextComma(toks, elemStart, closeIdx - 1, errOff, 0, 0, 0), closeIdx, addErr(errOff, hint, acc))

def vTupleRecoverComma(src: String, toks: Toks, commaIdx: Int, closeIdx: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (commaIdx >= 0 && commaIdx + 1 < closeIdx - 1) vTupleRest(src, toks, commaIdx + 1, closeIdx, acc) else (true, closeIdx, "", acc)

def vTupleLam(src: String, toks: Toks, closeIdx: Int, step: (Bool, Int, String, List[ErrAt]), inFor: Bool): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) (false, j, hint, acc) else if (_is(toks, j, Tok.Arrow)) vExpr(src, toks, j + 1, inFor, acc) else (true, j, "", acc)
  }

def vListOpen(src: String, toks: Toks, openIdx: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vListElems(src, toks, openIdx + 1, findCloseBracket(toks, openIdx + 1, 0, 1, 0), acc)

def vListElems(src: String, toks: Toks, i: Int, closeIdx: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vListNext(src, toks, i, closeIdx, vExpr(src, toks, i, false, acc))

def vListNext(src: String, toks: Toks, elemStart: Int, closeIdx: Int, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) vListRecover(src, toks, elemStart, closeIdx, j, hint, acc) else if (_is(toks, j, Tok.Comma)) vListElems(src, toks, j + 1, closeIdx, acc) else if (_is(toks, j, Tok.RBracket)) (true, j + 1, "", acc) else vListRecover(src, toks, j, closeIdx, _off(toks, j), "]", acc)
  }

def vListRecover(src: String, toks: Toks, elemStart: Int, closeIdx: Int, errOff: Int, hint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (closeIdx < 0) (false, errOff, hint, acc) else vListRecoverComma(src, toks, findNextComma(toks, elemStart, closeIdx - 1, errOff, 0, 0, 0), closeIdx, addErr(errOff, hint, acc))

def vListRecoverComma(src: String, toks: Toks, commaIdx: Int, closeIdx: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (commaIdx >= 0 && commaIdx + 1 < closeIdx - 1) vListElems(src, toks, commaIdx + 1, closeIdx, acc) else (true, closeIdx, "", acc)

def vIf(src: String, toks: Toks, i: Int, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (!_is(toks, i + 1, Tok.LParen)) vFail3(toks, i + 1, "(", acc) else vIfCond(src, toks, findCloseParen(toks, i + 2, 1, 0, 0), vExpr(src, toks, i + 2, false, acc), inFor)

def vIfCond(src: String, toks: Toks, closeIdx: Int, step: (Bool, Int, String, List[ErrAt]), inFor: Bool): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) vIfCondRecover(src, toks, closeIdx, j, hint, inFor, acc) else if (!_is(toks, j, Tok.RParen)) vIfCondRecover(src, toks, closeIdx, _off(toks, j), ")", inFor, acc) else vIfThen(src, toks, j + 1, vExpr(src, toks, j + 1, inFor, acc), inFor)
  }

def vIfCondRecover(src: String, toks: Toks, closeIdx: Int, errOff: Int, hint: String, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (closeIdx < 0) (false, errOff, hint, acc) else vIfThen(src, toks, closeIdx, vExpr(src, toks, closeIdx, inFor, addErr(errOff, hint, acc)), inFor)

def findSyncElse(src: String, toks: Toks, k: Int, errOff: Int, p: Int, b: Int, c: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof)) 0 - 1 else if (p == 0 && b == 0 && c == 0 && _is(toks, k, Tok.Else) && _off(toks, k) >= errOff) k else if (p == 0 && b == 0 && c == 0 && (_is(toks, k, Tok.RBrace) || _is(toks, k, Tok.Case) || _isSemi(src, toks, k) || isTopStart(src, toks, k) || isIndentedDefLine(src, toks, k))) 0 - 1 else _at(toks, k) match {
  case Tok.LParen => findSyncElse(src, toks, k + 1, errOff, p + 1, b, c)
  case Tok.RParen => if (p > 0) findSyncElse(src, toks, k + 1, errOff, p - 1, b, c) else 0 - 1
  case Tok.LBracket => findSyncElse(src, toks, k + 1, errOff, p, b + 1, c)
  case Tok.RBracket => if (b > 0) findSyncElse(src, toks, k + 1, errOff, p, b - 1, c) else 0 - 1
  case Tok.LBrace => findSyncElse(src, toks, k + 1, errOff, p, b, c + 1)
  case _ => findSyncElse(src, toks, k + 1, errOff, p, b, c)
}

def vIfThen(src: String, toks: Toks, thenStart: Int, step: (Bool, Int, String, List[ErrAt]), inFor: Bool): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, k, hint, acc) => if (!ok) vIfThenRecover(src, toks, findSyncElse(src, toks, thenStart, k, 0, 0, 0), k, hint, inFor, acc) else if (_is(toks, k, Tok.Else)) vExpr(src, toks, k + 1, inFor, acc) else (true, k, "", acc)
  }

def vIfThenRecover(src: String, toks: Toks, elseIdx: Int, errOff: Int, hint: String, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (elseIdx < 0) (false, errOff, hint, acc) else vExpr(src, toks, elseIdx + 1, inFor, addErr(errOff, hint, acc))

def vFor(src: String, toks: Toks, i: Int, inFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (!_is(toks, i + 1, Tok.LBrace)) vFail3(toks, i + 1, "{", acc) else vForBinds(src, toks, findCloseBrace(toks, i + 2, 1) >= 0, i + 2, inFor, acc)

def vForBinds(src: String, toks: Toks, hasClose: Bool, i: Int, outFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i, Tok.RBrace)) vForYield(src, toks, i + 1, outFor, acc) else if (i >= toks.n || _is(toks, i, Tok.Eof) || !hasClose && isTopStart(src, toks, i)) vFail3(toks, i, "}", acc) else if (_isSemi(src, toks, i)) vForBinds(src, toks, hasClose, skipSemis(src, toks, i + 1), outFor, addErr(_off(toks, i), "binding", acc)) else vForBindsNext(src, toks, hasClose, i, vForOne(src, toks, i, acc), outFor)

def vForBindsNext(src: String, toks: Toks, hasClose: Bool, bindStart: Int, step: (Bool, Int, String, List[ErrAt]), outFor: Bool): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (ok) vForBinds(src, toks, hasClose, j, outFor, acc) else vForBinds(src, toks, hasClose, syncForBind(src, toks, hasClose, bindStart, bindStart, j, 0), outFor, addErr(j, hint, acc))
  }

def syncForBind(src: String, toks: Toks, hasClose: Bool, bindStart: Int, k: Int, errOff: Int, c: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof)) k else if (c == 0 && _is(toks, k, Tok.RBrace)) k else if (!hasClose && c == 0 && k > bindStart && _off(toks, k) >= errOff && isTopStart(src, toks, k)) k else if (c == 0 && k > bindStart && _isSemi(src, toks, k) && _off(toks, k) >= errOff) skipSemis(src, toks, k + 1) else if (c == 0 && k > bindStart && onNewLine(src, toks, k) && (_off(toks, k) == errOff && isForBindStart(src, toks, k) || hasNl(src, errOff, _off(toks, k)) && !isContLine(src, toks, k))) k else _at(toks, k) match {
  case Tok.LBrace => syncForBind(src, toks, hasClose, bindStart, k + 1, errOff, c + 1)
  case Tok.RBrace => syncForBind(src, toks, hasClose, bindStart, k + 1, errOff, if (c > 0) c - 1 else 0)
  case _ => syncForBind(src, toks, hasClose, bindStart, k + 1, errOff, c)
}

def vForOne(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i, Tok.If)) vExpr(src, toks, i + 1, true, acc) else vForPat(src, toks, i, vPat(toks, i), acc)

def vForPat(src: String, toks: Toks, bindStart: Int, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint, acc) else if (_is(toks, j, Tok.LeftArrow) || _is(toks, j, Tok.Eq)) vForRhs(src, toks, vExpr(src, toks, j + 1, true, acc)) else if (hasNl(src, _off(toks, bindStart), _off(toks, j))) (true, j, "", addErr(_off(toks, bindStart), "=", acc)) else vFail3(toks, j, "=", acc)
  }

def vForRhs(src: String, toks: Toks, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) (false, j, hint, acc) else if (_is(toks, j, Tok.Colon)) vLift(vTypeCtx(src, toks, j + 1, true), "type", acc) else (true, j, "", acc)
  }

def vForYield(src: String, toks: Toks, i: Int, outFor: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i, Tok.Yield)) vExpr(src, toks, i + 1, outFor, acc) else vFail3(toks, i, "yield", acc)

def skipToNextLine(src: String, toks: Toks, k: Int, stopIdx: Int, lineOff: Int, c: Int): Int =
  if (k >= stopIdx || k >= toks.n || _is(toks, k, Tok.Eof)) k else if (c == 0 && hasNl(src, lineOff, _off(toks, k))) k else _at(toks, k) match {
  case Tok.LBrace => skipToNextLine(src, toks, k + 1, stopIdx, lineOff, c + 1)
  case Tok.RBrace => skipToNextLine(src, toks, k + 1, stopIdx, lineOff, if (c > 0) c - 1 else 0)
  case _ => skipToNextLine(src, toks, k + 1, stopIdx, lineOff, c)
}

def vBraceBlock(src: String, toks: Toks, openIdx: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vBraceBlockOpen(src, toks, openIdx, findCloseBrace(toks, openIdx + 1, 1), acc)

def vBraceBlockOpen(src: String, toks: Toks, openIdx: Int, closeIdx: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (closeIdx < 0) vFail3(toks, openIdx, "case", acc) else vBraceItems(src, toks, closeIdx - 1, skipToNextLine(src, toks, openIdx + 1, closeIdx - 1, _off(toks, openIdx), 0), addErr(_off(toks, openIdx), "case", acc))

def vBraceItems(src: String, toks: Toks, rbraceIdx: Int, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (i >= rbraceIdx) (true, rbraceIdx + 1, "", acc) else if (_isSemi(src, toks, i)) vBraceItems(src, toks, rbraceIdx, skipSemis(src, toks, i + 1), acc) else vBraceItemNext(src, toks, rbraceIdx, i, vBlockItem(src, toks, i, acc))

def vBraceItemNext(src: String, toks: Toks, rbraceIdx: Int, itemStart: Int, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) vBraceItems(src, toks, rbraceIdx, syncBlockItem(src, toks, rbraceIdx, itemStart, itemStart, j, 0), addErr(j, hint, acc)) else if (j >= rbraceIdx) (true, rbraceIdx + 1, "", acc) else if (_isSemi(src, toks, j)) vBraceItems(src, toks, rbraceIdx, skipSemis(src, toks, j + 1), acc) else if (onNewLine(src, toks, j)) vBraceItems(src, toks, rbraceIdx, j, acc) else vBraceItems(src, toks, rbraceIdx, syncBlockItem(src, toks, rbraceIdx, j, j, _off(toks, j), 0), addErr(_off(toks, j), "expression", acc))
  }

def vBlockItem(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i, Tok.If) && !_is(toks, i + 1, Tok.LParen)) vExpr(src, toks, i + 1, true, acc) else if (isForBindStart(src, toks, i)) vBlockBind(src, toks, vPat(toks, i), acc) else vExpr(src, toks, i, true, acc)

def vBlockBind(src: String, toks: Toks, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint, acc) else vForRhs(src, toks, vExpr(src, toks, j + 1, true, acc))
  }

def syncBlockItem(src: String, toks: Toks, rbraceIdx: Int, itemStart: Int, k: Int, errOff: Int, c: Int): Int =
  if (k >= rbraceIdx || k >= toks.n || _is(toks, k, Tok.Eof)) rbraceIdx else if (c == 0 && k > itemStart && _isSemi(src, toks, k) && _off(toks, k) >= errOff) skipSemis(src, toks, k + 1) else if (c == 0 && k > itemStart && onNewLine(src, toks, k) && (_off(toks, k) == errOff && isForBindStart(src, toks, k) || hasNl(src, errOff, _off(toks, k)) && !isContLine(src, toks, k))) k else _at(toks, k) match {
  case Tok.LBrace => syncBlockItem(src, toks, rbraceIdx, itemStart, k + 1, errOff, c + 1)
  case Tok.RBrace => syncBlockItem(src, toks, rbraceIdx, itemStart, k + 1, errOff, if (c > 0) c - 1 else 0)
  case _ => syncBlockItem(src, toks, rbraceIdx, itemStart, k + 1, errOff, c)
}

def vPost(src: String, toks: Toks, step: (Bool, Int, String, List[ErrAt]), inFor: Bool): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, i, hint, acc) => if (!ok) (false, i, hint, acc) else if (_is(toks, i, Tok.LParen) && !forBindAfter(toks, i)) vPost(src, toks, vArgOpen(src, toks, i + 1, acc), inFor) else if (_is(toks, i, Tok.Dot)) vPost(src, toks, vPostDot(src, toks, vIdentCtx(src, toks, i + 1, inFor), acc), inFor) else if (_is(toks, i, Tok.Match)) vPost(src, toks, vMatch(src, toks, i + 1, acc), inFor) else (true, i, "", acc)
  }

def vPostDot(src: String, toks: Toks, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint, acc) else if (_is(toks, j, Tok.LParen) && !forBindAfter(toks, j)) vArgOpen(src, toks, j + 1, acc) else if (_is(toks, j, Tok.LBrace) && _is(toks, j + 1, Tok.Case)) vMatch(src, toks, j, acc) else (true, j, "", acc)
  }

def vArgOpen(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i, Tok.RParen)) (true, i + 1, "", acc) else vArgList(src, toks, i, findCloseParen(toks, i, 1, 0, 0), acc)

def vArgList(src: String, toks: Toks, i: Int, closeIdx: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vArgListSep(src, toks, i, closeIdx, vArgTail(src, toks, vArgOne(src, toks, i, acc)))

def vArgOne(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_identOf(_at(toks, i)) != "" && _is(toks, i + 1, Tok.Eq)) vExpr(src, toks, i + 2, false, acc) else vExpr(src, toks, i, false, acc)

def vArgTail(src: String, toks: Toks, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) (false, j, hint, acc) else if (_is(toks, j, Tok.Colon)) vArgTail(src, toks, vLift(vType(toks, j + 1), "type", acc)) else if (_is(toks, j, Tok.LParen) && !forBindAfter(toks, j) || _is(toks, j, Tok.Dot) || _is(toks, j, Tok.Match)) vArgTail(src, toks, vPost(src, toks, (true, j, "", acc), false)) else (true, j, "", acc)
  }

def vArgListSep(src: String, toks: Toks, elemStart: Int, closeIdx: Int, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, k, hint, acc) => if (!ok) vArgRecover(src, toks, elemStart, closeIdx, k, hint, acc) else if (_is(toks, k, Tok.Comma)) vArgList(src, toks, k + 1, closeIdx, acc) else if (_is(toks, k, Tok.RParen)) (true, k + 1, "", acc) else vArgRecover(src, toks, k, closeIdx, _off(toks, k), ")", acc)
  }

def vArgRecover(src: String, toks: Toks, elemStart: Int, closeIdx: Int, errOff: Int, hint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (closeIdx < 0) (false, errOff, hint, acc) else vArgRecoverComma(src, toks, findNextComma(toks, elemStart, closeIdx - 1, errOff, 0, 0, 0), closeIdx, addErr(errOff, hint, acc))

def vArgRecoverComma(src: String, toks: Toks, commaIdx: Int, closeIdx: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (commaIdx >= 0 && commaIdx + 1 < closeIdx - 1) vArgList(src, toks, commaIdx + 1, closeIdx, acc) else (true, closeIdx, "", acc)

def vMatch(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (!_is(toks, i, Tok.LBrace)) vFail3(toks, i, "{", acc) else vMatchArms(src, toks, findCloseBrace(toks, i + 1, 1) >= 0, i + 1, acc)

def vMatchArms(src: String, toks: Toks, hasClose: Bool, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i, Tok.RBrace)) (true, i + 1, "", acc) else if (i >= toks.n || _is(toks, i, Tok.Eof) || !hasClose && isTopStart(src, toks, i)) vFail3(toks, i, "}", acc) else if (_is(toks, i, Tok.Case)) vMatchArmsNext(src, toks, hasClose, i, vMatchArm(src, toks, i + 1, acc)) else vMatchArms(src, toks, hasClose, syncMatchTrail(src, toks, hasClose, i, i + 1, _off(toks, i), 0), addErr(_off(toks, i), "case", acc))

def vMatchArmsNext(src: String, toks: Toks, hasClose: Bool, armIdx: Int, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) vMatchArms(src, toks, hasClose, syncMatchArm(src, toks, hasClose, armIdx, armIdx + 1, j, 0), addErr(j, hint, acc)) else if (_is(toks, j, Tok.RBrace) || _is(toks, j, Tok.Case)) vMatchArms(src, toks, hasClose, j, acc) else if (j >= toks.n || _is(toks, j, Tok.Eof) || !hasClose && isTopStart(src, toks, j)) vFail3(toks, j, "}", acc) else vMatchArms(src, toks, hasClose, syncMatchTrail(src, toks, hasClose, j, j + 1, _off(toks, j), 0), addErr(_off(toks, j), "case", acc))
  }

def syncMatchArm(src: String, toks: Toks, hasClose: Bool, armIdx: Int, k: Int, errOff: Int, c: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof)) k else if (c == 0 && _is(toks, k, Tok.RBrace)) k else if (!hasClose && c == 0 && _off(toks, k) >= errOff && isTopStart(src, toks, k)) k else if (c == 0 && _is(toks, k, Tok.Case) && (_off(toks, k) > errOff || hasNl(src, _off(toks, armIdx), _off(toks, k)))) k else _at(toks, k) match {
  case Tok.LBrace => syncMatchArm(src, toks, hasClose, armIdx, k + 1, errOff, c + 1)
  case Tok.RBrace => syncMatchArm(src, toks, hasClose, armIdx, k + 1, errOff, if (c > 0) c - 1 else 0)
  case _ => syncMatchArm(src, toks, hasClose, armIdx, k + 1, errOff, c)
}

def syncMatchTrail(src: String, toks: Toks, hasClose: Bool, startIdx: Int, k: Int, errOff: Int, c: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof)) k else if (c == 0 && _is(toks, k, Tok.RBrace)) k else if (!hasClose && c == 0 && _off(toks, k) >= errOff && isTopStart(src, toks, k)) k else if (c == 0 && _is(toks, k, Tok.Case) && (hasNl(src, _off(toks, startIdx), _off(toks, k)) || _off(toks, k) > errOff)) k else _at(toks, k) match {
  case Tok.LBrace => syncMatchTrail(src, toks, hasClose, startIdx, k + 1, errOff, c + 1)
  case Tok.RBrace => syncMatchTrail(src, toks, hasClose, startIdx, k + 1, errOff, if (c > 0) c - 1 else 0)
  case _ => syncMatchTrail(src, toks, hasClose, startIdx, k + 1, errOff, c)
}

def vMatchArm(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vMatchArmPat(src, toks, vPat(toks, i), acc)

def vMatchArmPat(src: String, toks: Toks, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint, acc) else if (_is(toks, j, Tok.If)) vMatchGuard(src, toks, vExpr(src, toks, j + 1, false, acc)) else vMatchBody(src, toks, j, acc)
  }

def vMatchGuard(src: String, toks: Toks, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) (false, j, hint, acc) else vMatchBody(src, toks, j, acc)
  }

def vMatchBody(src: String, toks: Toks, j: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, j, Tok.Arrow)) vExpr(src, toks, j + 1, false, acc) else vFail3(toks, j, "=>", acc)

def vParams(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i, Tok.LParen)) vParamOpen(src, toks, i + 1, acc) else (true, i, "", acc)

def vReqParams(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i, Tok.LParen)) vParamOpen(src, toks, i + 1, acc) else vFail3(toks, i, "(", acc)

def vParamOpen(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i, Tok.RParen)) (true, i + 1, "", acc) else vParamList(src, toks, i, findCloseParen(toks, i, 1, 0, 0), acc)

def vParamList(src: String, toks: Toks, i: Int, closeIdx: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vParamListNext(src, toks, i, closeIdx, vOneParam(src, toks, i, acc))

def vParamListNext(src: String, toks: Toks, paramStart: Int, closeIdx: Int, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) vParamRecover(src, toks, paramStart, closeIdx, j, hint, acc) else if (_is(toks, j, Tok.Comma)) vParamList(src, toks, j + 1, closeIdx, acc) else if (_is(toks, j, Tok.RParen)) (true, j + 1, "", acc) else vParamRecover(src, toks, j, closeIdx, _off(toks, j), ")", acc)
  }

def vParamRecover(src: String, toks: Toks, paramStart: Int, closeIdx: Int, errOff: Int, hint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (closeIdx < 0) (false, errOff, hint, acc) else vParamRecoverComma(src, toks, findNextComma(toks, paramStart, closeIdx - 1, errOff, 0, 0, 0), closeIdx, addErr(errOff, hint, acc))

def vParamRecoverComma(src: String, toks: Toks, commaIdx: Int, closeIdx: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (commaIdx >= 0 && commaIdx + 1 < closeIdx - 1) vParamList(src, toks, commaIdx + 1, closeIdx, acc) else (true, closeIdx, "", acc)

def vOneParam(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vOneParamName(src, toks, vIdent(toks, i), acc)

def vOneParamName(src: String, toks: Toks, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint, acc) else if (!_is(toks, j, Tok.Colon)) vFail3(toks, j, ":", acc) else vParamAfterTy(src, toks, vType(toks, j + 1), acc)
  }

def vParamAfterTy(src: String, toks: Toks, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint, acc) else if (_is(toks, j, Tok.Where)) vParamAfterW(src, toks, vExpr(src, toks, j + 1, false, acc)) else vParamDefault(src, toks, j, acc)
  }

def vParamAfterW(src: String, toks: Toks, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) (false, j, hint, acc) else vParamDefault(src, toks, j, acc)
  }

def vParamDefault(src: String, toks: Toks, j: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, j, Tok.Eq)) vExpr(src, toks, j + 1, false, acc) else (true, j, "", acc)

def findHeaderEq(src: String, toks: Toks, headStart: Int, k: Int, p: Int, b: Int, c: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof)) 0 - 1 else if (k > headStart && p == 0 && b == 0 && c == 0 && _is(toks, k, Tok.Eq)) k + 1 else if (k > headStart && p == 0 && b == 0 && c == 0 && (isTopStart(src, toks, k) || isIndentedDefLine(src, toks, k) || onNewLine(src, toks, k))) 0 - 1 else _at(toks, k) match {
  case Tok.LParen => findHeaderEq(src, toks, headStart, k + 1, p + 1, b, c)
  case Tok.RParen => findHeaderEq(src, toks, headStart, k + 1, if (p > 0) p - 1 else 0, b, c)
  case Tok.LBracket => findHeaderEq(src, toks, headStart, k + 1, p, b + 1, c)
  case Tok.RBracket => findHeaderEq(src, toks, headStart, k + 1, p, if (b > 0) b - 1 else 0, c)
  case Tok.LBrace => findHeaderEq(src, toks, headStart, k + 1, p, b, c + 1)
  case Tok.RBrace => findHeaderEq(src, toks, headStart, k + 1, p, b, if (c > 0) c - 1 else 0)
  case _ => findHeaderEq(src, toks, headStart, k + 1, p, b, c)
}

def findHeaderColon(src: String, toks: Toks, headStart: Int, k: Int, p: Int, b: Int, c: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof)) 0 - 1 else if (k > headStart && p == 0 && b == 0 && c == 0 && _is(toks, k, Tok.Colon)) k + 1 else if (k > headStart && p == 0 && b == 0 && c == 0 && (isTopStart(src, toks, k) || onNewLine(src, toks, k))) 0 - 1 else _at(toks, k) match {
  case Tok.LParen => findHeaderColon(src, toks, headStart, k + 1, p + 1, b, c)
  case Tok.RParen => findHeaderColon(src, toks, headStart, k + 1, if (p > 0) p - 1 else 0, b, c)
  case Tok.LBracket => findHeaderColon(src, toks, headStart, k + 1, p, b + 1, c)
  case Tok.RBracket => findHeaderColon(src, toks, headStart, k + 1, p, if (b > 0) b - 1 else 0, c)
  case Tok.LBrace => findHeaderColon(src, toks, headStart, k + 1, p, b, c + 1)
  case Tok.RBrace => findHeaderColon(src, toks, headStart, k + 1, p, b, if (c > 0) c - 1 else 0)
  case _ => findHeaderColon(src, toks, headStart, k + 1, p, b, c)
}

def isDeclEnd(inImpl: Bool, src: String, toks: Toks, j: Int): Bool =
  if (j >= toks.n || _is(toks, j, Tok.Eof)) true else if (isColZeroLine(src, toks, j)) true else if (inImpl) isIndentedDefLine(src, toks, j) else isTopTok(_at(toks, j))

def syncBodyStmt(inImpl: Bool, src: String, toks: Toks, stmtStart: Int, k: Int, errOff: Int, c: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof)) k else if (c == 0 && k > stmtStart && isDeclEnd(inImpl, src, toks, k)) k else if (c == 0 && k > stmtStart && _isSemi(src, toks, k) && _off(toks, k) >= errOff) skipSemis(src, toks, k + 1) else if (c == 0 && k > stmtStart && onNewLine(src, toks, k) && hasNl(src, errOff, _off(toks, k)) && !isContLine(src, toks, k)) k else _at(toks, k) match {
  case Tok.LBrace => syncBodyStmt(inImpl, src, toks, stmtStart, k + 1, errOff, c + 1)
  case Tok.RBrace => syncBodyStmt(inImpl, src, toks, stmtStart, k + 1, errOff, if (c > 0) c - 1 else 0)
  case _ => syncBodyStmt(inImpl, src, toks, stmtStart, k + 1, errOff, c)
}

def vDefBody(inImpl: Bool, src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vDefBodyStep(inImpl, src, toks, i, vExpr(src, toks, i, false, acc))

def vDefBodyStep(inImpl: Bool, src: String, toks: Toks, stmtStart: Int, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) vDefBodyAfterFail(inImpl, src, toks, syncBodyStmt(inImpl, src, toks, stmtStart, stmtStart, j, 0), addErr(j, hint, acc)) else if (isDeclEnd(inImpl, src, toks, j)) (true, j, "", acc) else if (_isSemi(src, toks, j)) vDefBodySemi(inImpl, src, toks, skipSemis(src, toks, j + 1), addErr(_off(toks, j), "", acc)) else if (onNewLine(src, toks, j)) vDefBodyExtra(inImpl, src, toks, j, acc) else vDefBodyAfterFail(inImpl, src, toks, syncBodyStmt(inImpl, src, toks, j, j, _off(toks, j), 0), addErr(_off(toks, j), "", acc))
  }

def vDefBodySemi(inImpl: Bool, src: String, toks: Toks, nextIdx: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (isDeclEnd(inImpl, src, toks, nextIdx)) (true, nextIdx, "", acc) else vDefBody(inImpl, src, toks, nextIdx, acc)

def vDefBodyAfterFail(inImpl: Bool, src: String, toks: Toks, nextIdx: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (isDeclEnd(inImpl, src, toks, nextIdx)) (true, nextIdx, "", acc) else vDefBody(inImpl, src, toks, nextIdx, acc)

def vDefBodyExtra(inImpl: Bool, src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (isDeclEnd(inImpl, src, toks, i)) (true, i, "", acc) else vDefExtraStep(inImpl, src, toks, i, vExpr(src, toks, i, false, []), acc)

def vDefExtraStep(inImpl: Bool, src: String, toks: Toks, stmtStart: Int, probe: (Bool, Int, String, List[ErrAt]), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  probe match {
    case (ok, j, hint, innerAcc) => if (!ok) vDefBodyAfterFail(inImpl, src, toks, syncBodyStmt(inImpl, src, toks, stmtStart, stmtStart, j, 0), addErr(j, hint, mergeRevAcc(innerAcc, acc))) else if (!List.isEmpty(innerAcc)) vDefExtraTail(inImpl, src, toks, j, mergeRevAcc(innerAcc, acc)) else if (isDeclEnd(inImpl, src, toks, j) || onNewLine(src, toks, j)) vDefBodyExtra(inImpl, src, toks, j, addErr(_off(toks, stmtStart), "expression", acc)) else vDefBodyAfterFail(inImpl, src, toks, syncBodyStmt(inImpl, src, toks, j, j, _off(toks, j), 0), addErr(_off(toks, j), "", acc))
  }

def vDefExtraTail(inImpl: Bool, src: String, toks: Toks, j: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (isDeclEnd(inImpl, src, toks, j)) (true, j, "", acc) else if (_isSemi(src, toks, j)) vDefBodySemi(inImpl, src, toks, skipSemis(src, toks, j + 1), addErr(_off(toks, j), "", acc)) else if (onNewLine(src, toks, j)) vDefBodyExtra(inImpl, src, toks, j, acc) else vDefBodyAfterFail(inImpl, src, toks, syncBodyStmt(inImpl, src, toks, j, j, _off(toks, j), 0), addErr(_off(toks, j), "", acc))

def mergeRevAcc(innerAcc: List[ErrAt], acc: List[ErrAt]): List[ErrAt] =
  mergeInOrder(List.reverse(innerAcc), acc)

def mergeInOrder(offs: List[ErrAt], acc: List[ErrAt]): List[ErrAt] =
  if (List.isEmpty(offs)) acc else mergeInOrder(List.tail(offs), addErr(List.at(offs, 0).off, List.at(offs, 0).hint, acc))

def vDefHeaderRecover(inImpl: Bool, src: String, toks: Toks, headStart: Int, errOff: Int, hint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vDefHeaderEq(inImpl, src, toks, findHeaderEq(src, toks, headStart, headStart, 0, 0, 0), errOff, hint, acc)

def vDefHeaderEq(inImpl: Bool, src: String, toks: Toks, bodyIdx: Int, errOff: Int, hint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (bodyIdx < 0) (false, errOff, hint, acc) else vDefBody(inImpl, src, toks, bodyIdx, addErr(errOff, hint, acc))

def vDef(inImpl: Bool, src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vDefTp(inImpl, src, toks, i, vQualIdent(toks, i), acc)

def vDefTp(inImpl: Bool, src: String, toks: Toks, headStart: Int, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) vDefHeaderRecover(inImpl, src, toks, headStart, j, hint, acc) else vDefParams(inImpl, src, toks, headStart, vTParams(toks, j), acc)
  }

def vDefParams(inImpl: Bool, src: String, toks: Toks, headStart: Int, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, k, hint) => if (!ok) vDefHeaderRecover(inImpl, src, toks, headStart, k, hint, acc) else vDefColon(inImpl, src, toks, headStart, vParams(src, toks, k, acc))
  }

def vDefColon(inImpl: Bool, src: String, toks: Toks, headStart: Int, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, m, hint, acc) => if (!ok) vDefHeaderRecover(inImpl, src, toks, headStart, m, hint, acc) else if (!_is(toks, m, Tok.Colon)) vDefHeaderRecover(inImpl, src, toks, headStart, _off(toks, m), ":", acc) else vDefEq(inImpl, src, toks, headStart, vType(toks, m + 1), acc)
  }

def vDefEq(inImpl: Bool, src: String, toks: Toks, headStart: Int, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, r, hint) => if (!ok) vDefHeaderRecover(inImpl, src, toks, headStart, r, hint, acc) else if (!_is(toks, r, Tok.Eq)) vFail3(toks, r, "=", acc) else vDefBody(inImpl, src, toks, r + 1, acc)
  }

def vMain(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (!_is(toks, i, Tok.Def)) vDefHeaderRecover(false, src, toks, i, _off(toks, i), "def", acc) else vMainColon(src, toks, i, vIdent(toks, i + 1), acc)

def vMainColon(src: String, toks: Toks, headStart: Int, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) vDefHeaderRecover(false, src, toks, headStart, j, hint, acc) else if (!_is(toks, j, Tok.Colon)) vDefHeaderRecover(false, src, toks, headStart, _off(toks, j), ":", acc) else vDefEq(false, src, toks, headStart, vType(toks, j + 1), acc)
  }

def vEnum(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vEnumTp(src, toks, i, vIdent(toks, i), acc)

def vEnumTp(src: String, toks: Toks, headStart: Int, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) vEnumHeaderRecover(src, toks, headStart, j, hint, acc) else vEnumColon(src, toks, headStart, vTParams(toks, j), acc)
  }

def vEnumColon(src: String, toks: Toks, headStart: Int, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, k, hint) => if (!ok) vEnumHeaderRecover(src, toks, headStart, k, hint, acc) else if (!_is(toks, k, Tok.Colon)) vFail3(toks, k, ":", acc) else if (!_is(toks, k + 1, Tok.Case)) vFail3(toks, k + 1, "case", acc) else vEnumCases(src, toks, k + 1, acc)
  }

def vEnumHeaderRecover(src: String, toks: Toks, headStart: Int, errOff: Int, hint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vEnumHeaderColon(src, toks, findHeaderColon(src, toks, headStart, headStart, 0, 0, 0), errOff, hint, acc)

def vEnumHeaderColon(src: String, toks: Toks, afterColon: Int, errOff: Int, hint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (afterColon < 0 || !_is(toks, afterColon, Tok.Case)) (false, errOff, hint, acc) else vEnumCases(src, toks, afterColon, addErr(errOff, hint, acc))

def vEnumCases(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (!_is(toks, i, Tok.Case) || isColZeroLine(src, toks, i)) (true, i, "", acc) else vEnumCaseName(src, toks, i, vIdent(toks, i + 1), acc)

def vEnumCaseName(src: String, toks: Toks, caseIdx: Int, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) vEnumCases(src, toks, syncEnumCase(src, toks, caseIdx + 1, j), addErr(j, hint, acc)) else vEnumCaseNext(src, toks, caseIdx, vParams(src, toks, j, acc))
  }

def vEnumCaseNext(src: String, toks: Toks, caseIdx: Int, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, k, hint, acc) => if (!ok) vEnumCases(src, toks, syncEnumCase(src, toks, caseIdx + 1, k), addErr(k, hint, acc)) else vEnumCases(src, toks, k, acc)
  }

def syncEnumCase(src: String, toks: Toks, k: Int, errOff: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof) || isColZeroLine(src, toks, k)) k else if (_is(toks, k, Tok.Case) && hasNl(src, errOff, _off(toks, k))) k else syncEnumCase(src, toks, k + 1, errOff)

def vRec(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vRecTp(src, toks, vIdent(toks, i), acc)

def vRecTp(src: String, toks: Toks, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint, acc) else vRecOpen(src, toks, vTParams(toks, j), acc)
  }

def vRecOpen(src: String, toks: Toks, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, k, hint) => if (!ok) (false, k, hint, acc) else vReqParams(src, toks, if (_is(toks, k, Tok.Private)) k + 1 else k, acc)
  }

def vAlias(toks: Toks, i: Int): (Bool, Int, String) =
  vAliasTp(toks, vIdent(toks, i))

def vAliasTp(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint) else vAliasEq(toks, vTParams(toks, j))
  }

def vAliasEq(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, k, hint) => if (!ok) (false, k, hint) else if (!_is(toks, k, Tok.Eq)) vFail(toks, k, "=") else vType(toks, k + 1)
  }

def vImport(toks: Toks, i: Int): (Bool, Int, String) =
  vImportDot(toks, vIdent(toks, i))

def vImportDot(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint) else if (!_is(toks, j, Tok.Dot)) vFail(toks, j, ".") else if (_is(toks, j + 1, Tok.Star)) (true, j + 2, "") else vImportAs(toks, vIdent(toks, j + 1))
  }

def vImportAs(toks: Toks, step: (Bool, Int, String)): (Bool, Int, String) =
  step match {
    case (ok, k, hint) => if (!ok) (false, k, hint) else if (_identOf(_at(toks, k)) == "as") vIdent(toks, k + 1) else (true, k, "")
  }

def vTrait(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vTraitTp(src, toks, i, vIdent(toks, i), acc)

def vTraitTp(src: String, toks: Toks, headStart: Int, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) vTraitHeaderRecover(src, toks, headStart, j, hint, acc) else vTraitColon(src, toks, headStart, vTParams(toks, j), acc)
  }

def vTraitColon(src: String, toks: Toks, headStart: Int, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, k, hint) => if (!ok) vTraitHeaderRecover(src, toks, headStart, k, hint, acc) else if (!_is(toks, k, Tok.Colon)) vFail3(toks, k, ":", acc) else vTraitMeths(src, toks, k + 1, acc)
  }

def vTraitHeaderRecover(src: String, toks: Toks, headStart: Int, errOff: Int, hint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vTraitHeaderColon(src, toks, findHeaderColon(src, toks, headStart, headStart, 0, 0, 0), errOff, hint, acc)

def vTraitHeaderColon(src: String, toks: Toks, afterColon: Int, errOff: Int, hint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (afterColon < 0) (false, errOff, hint, acc) else vTraitMeths(src, toks, afterColon, addErr(errOff, hint, acc))

def isTraitMemEnd(src: String, toks: Toks, j: Int): Bool =
  j >= toks.n || _is(toks, j, Tok.Eof) || isColZeroLine(src, toks, j) || isIndentedDefLine(src, toks, j) || onNewLine(src, toks, j)

def syncTraitMember(src: String, toks: Toks, k: Int, errOff: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof) || isColZeroLine(src, toks, k)) k else if (isIndentedDefLine(src, toks, k) && _off(toks, k) >= errOff) k else if (onNewLine(src, toks, k) && hasNl(src, errOff, _off(toks, k)) && !isLeadContTok(_at(toks, k))) k else syncTraitMember(src, toks, k + 1, errOff)

def vTraitMeths(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (i >= toks.n || _is(toks, i, Tok.Eof) || isColZeroLine(src, toks, i)) (true, i, "", acc) else if (_is(toks, i, Tok.Def) && _sp(toks, i).column > 0) vTraitMethsNext(src, toks, i, vTraitMeth(src, toks, i + 1, acc)) else vTraitMeths(src, toks, syncTraitMember(src, toks, i + 1, _off(toks, i)), addErr(_off(toks, i), "def", acc))

def vTraitMethsNext(src: String, toks: Toks, memIdx: Int, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) vTraitMeths(src, toks, syncTraitMember(src, toks, memIdx + 1, j), addErr(j, hint, acc)) else if (isTraitMemEnd(src, toks, j)) vTraitMeths(src, toks, j, acc) else vTraitMeths(src, toks, syncTraitMember(src, toks, j + 1, _off(toks, j)), addErr(_off(toks, j), "def", acc))
  }

def vTraitMeth(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vTraitMethParams(src, toks, vIdent(toks, i), acc)

def vTraitMethParams(src: String, toks: Toks, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) (false, j, hint, acc) else vTraitMethColon(toks, vParams(src, toks, j, acc))
  }

def vTraitMethColon(toks: Toks, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, k, hint, acc) => if (!ok) (false, k, hint, acc) else if (!_is(toks, k, Tok.Colon)) vFail3(toks, k, ":", acc) else vLift(vType(toks, k + 1), "type", acc)
  }

def vImpl(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vImplArgsStep(src, toks, i, vQualIdent(toks, i), acc)

def vImplArgsStep(src: String, toks: Toks, headStart: Int, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint) => if (!ok) vImplHeaderRecover(src, toks, headStart, j, hint, acc) else vImplFor(src, toks, headStart, vImplArgs(toks, j), acc)
  }

def vImplArgs(toks: Toks, i: Int): (Bool, Int, String) =
  if (_is(toks, i, Tok.LBracket)) vTypeBrack(toks, vTypeList(toks, i + 1)) else (true, i, "")

def vImplFor(src: String, toks: Toks, headStart: Int, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, k, hint) => if (!ok) vImplHeaderRecover(src, toks, headStart, k, hint, acc) else if (!_is(toks, k, Tok.For)) vImplHeaderRecover(src, toks, headStart, _off(toks, k), "for", acc) else vImplColon(src, toks, headStart, vType(toks, k + 1), acc)
  }

def vImplColon(src: String, toks: Toks, headStart: Int, step: (Bool, Int, String), acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, r, hint) => if (!ok) vImplHeaderRecover(src, toks, headStart, r, hint, acc) else if (!_is(toks, r, Tok.Colon)) vFail3(toks, r, ":", acc) else vImplMeths(src, toks, r + 1, acc)
  }

def vImplHeaderRecover(src: String, toks: Toks, headStart: Int, errOff: Int, hint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  vImplHeaderColon(src, toks, findHeaderColon(src, toks, headStart, headStart, 0, 0, 0), errOff, hint, acc)

def vImplHeaderColon(src: String, toks: Toks, afterColon: Int, errOff: Int, hint: String, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (afterColon < 0) (false, errOff, hint, acc) else vImplMeths(src, toks, afterColon, addErr(errOff, hint, acc))

def syncImplMember(src: String, toks: Toks, k: Int, errOff: Int, c: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof) || c == 0 && isColZeroLine(src, toks, k)) k else if (c == 0 && isIndentedDefLine(src, toks, k) && _off(toks, k) >= errOff) k else _at(toks, k) match {
  case Tok.LBrace => syncImplMember(src, toks, k + 1, errOff, c + 1)
  case Tok.RBrace => syncImplMember(src, toks, k + 1, errOff, if (c > 0) c - 1 else 0)
  case _ => syncImplMember(src, toks, k + 1, errOff, c)
}

def vImplMeths(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (i >= toks.n || _is(toks, i, Tok.Eof) || isColZeroLine(src, toks, i)) (true, i, "", acc) else if (_is(toks, i, Tok.Def) && _sp(toks, i).column > 0) vImplMethsNext(src, toks, i, vDef(true, src, toks, i + 1, acc)) else if (_is(toks, i, Tok.Private) && _is(toks, i + 1, Tok.Def)) vImplMethsNext(src, toks, i, vDef(true, src, toks, i + 2, addErr(_off(toks, i), "def", acc))) else vImplMeths(src, toks, syncImplMember(src, toks, i + 1, _off(toks, i), 0), addErr(_off(toks, i), "def", acc))

def vImplMethsNext(src: String, toks: Toks, memIdx: Int, step: (Bool, Int, String, List[ErrAt])): (Bool, Int, String, List[ErrAt]) =
  step match {
    case (ok, j, hint, acc) => if (!ok) vImplMeths(src, toks, syncImplMember(src, toks, memIdx + 1, j, 0), addErr(j, hint, acc)) else vImplMeths(src, toks, j, acc)
  }

def vItemOne(src: String, toks: Toks, i: Int, hasMain: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i, Tok.Private)) vItemPriv(src, toks, i, acc) else if (_is(toks, i, Tok.Oracle)) vDef(false, src, toks, i + 1, acc) else if (_is(toks, i, Tok.Enum)) vEnum(src, toks, i + 1, acc) else if (_is(toks, i, Tok.Record)) vRec(src, toks, i + 1, acc) else if (_is(toks, i, Tok.TypeKw)) vLift(vAlias(toks, i + 1), "identifier", acc) else if (_is(toks, i, Tok.Trait)) vTrait(src, toks, i + 1, acc) else if (_is(toks, i, Tok.Impl)) vImpl(src, toks, i + 1, acc) else if (_is(toks, i, Tok.Import)) vLift(vImport(toks, i + 1), ".", acc) else if (_is(toks, i, Tok.Def)) vDef(false, src, toks, i + 1, acc) else if (_is(toks, i, Tok.AtMain)) vItemMain(src, toks, i, hasMain, acc) else vFail3(toks, i, "declaration", acc)

def vItemPriv(src: String, toks: Toks, i: Int, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (_is(toks, i + 1, Tok.Def)) vDef(false, src, toks, i + 2, acc) else if (_is(toks, i + 1, Tok.Oracle)) vDef(false, src, toks, i + 2, addErr(_off(toks, i + 1), "def", acc)) else vFail3(toks, i + 1, "def", acc)

def vItemMain(src: String, toks: Toks, i: Int, hasMain: Bool, acc: List[ErrAt]): (Bool, Int, String, List[ErrAt]) =
  if (hasMain) vMain(src, toks, i + 1, addErr(_off(toks, i), "declaration", acc)) else vMain(src, toks, i + 1, acc)

def stepDepth(t: Tok, d: Int): Int =
  t match {
    case Tok.LParen => d + 1
    case Tok.LBracket => d + 1
    case Tok.LBrace => d + 1
    case Tok.RParen => if (d > 0) d - 1 else 0
    case Tok.RBracket => if (d > 0) d - 1 else 0
    case Tok.RBrace => if (d > 0) d - 1 else 0
    case _ => d
  }

def isTopTok(t: Tok): Bool =
  t match {
    case Tok.Def => true
    case Tok.Oracle => true
    case Tok.Private => true
    case Tok.Enum => true
    case Tok.Record => true
    case Tok.TypeKw => true
    case Tok.Trait => true
    case Tok.Impl => true
    case Tok.Import => true
    case Tok.AtMain => true
    case _ => false
  }

def isTopStart(src: String, toks: Toks, k: Int): Bool =
  isTopTok(_at(toks, k)) && Lexer.columnAt(src, _off(toks, k) - 1, 0) == 0

def syncTop(src: String, toks: Toks, itemStart: Int, k: Int, errByteOff: Int, d: Int): Int =
  if (k >= toks.n || _is(toks, k, Tok.Eof)) k else if (k > itemStart && _off(toks, k) >= errByteOff && d == 0 && isTopStart(src, toks, k)) k else syncTop(src, toks, itemStart, k + 1, errByteOff, stepDepth(_at(toks, k), d))

def vItemsStep(src: String, toks: Toks, i: Int, nextMain: Bool, step: (Bool, Int, String, List[ErrAt])): List[ErrAt] =
  step match {
    case (ok, j, hint, acc) => if (ok) vItemsCollect(src, toks, if (j <= i) i + 1 else j, nextMain, acc) else vItemsCollect(src, toks, syncTop(src, toks, i, i, j, 0), nextMain, addErr(j, hint, acc))
  }

def vItemsCollect(src: String, toks: Toks, i: Int, hasMain: Bool, acc: List[ErrAt]): List[ErrAt] =
  if (i >= toks.n || _is(toks, i, Tok.Eof)) parseErrorFinishList(toks, acc) else vItemsStep(src, toks, i, hasMain || _is(toks, i, Tok.AtMain), vItemOne(src, toks, i, hasMain, acc))

def vPkgCollect(src: String, toks: Toks, step: (Bool, Int, String)): List[ErrAt] =
  step match {
    case (ok, j, hint) => if (ok) vItemsCollect(src, toks, j, false, []) else vItemsCollect(src, toks, syncTop(src, toks, 0, 0, j, 0), false, ErrAt(j, hint) :: [])
  }

def parseErrorFinishList(toks: Toks, acc: List[ErrAt]): List[ErrAt] =
  if (!List.isEmpty(acc)) List.reverse(acc) else if (toks.bad >= 0) ErrAt(_off(toks, toks.bad), "") :: [] else []

def parseErrorToksList(src: String, toks: Toks): List[ErrAt] =
  if (_is(toks, 0, Tok.Package)) vPkgCollect(src, toks, vQualIdent(toks, 1)) else vItemsCollect(src, toks, 0, false, [])

def parseErrorNotes(src: String): List[ErrAt] =
  parseErrorToksList(src, indexToks(Lexer.lex(src)))

def noteOff(n: ErrAt): Int =
  n.off + 0

def noteOffs(xs: List[ErrAt]): List[Int] =
  if (List.isEmpty(xs)) [] else noteOff(List.at(xs, 0)) :: noteOffs(List.tail(xs))

def parseErrorOffs(src: String): List[Int] =
  noteOffs(parseErrorNotes(src))

def parseErrorOffFirst(offs: List[Int]): Int =
  if (List.isEmpty(offs)) 0 - 1 else List.at(offs, 0)

def parseErrorOff(src: String): Int =
  parseErrorOffFirst(parseErrorOffs(src))

def parseErrorHint(src: String, off: Int): String =
  noteHint(parseErrorNotes(src), off)

def noteHint(xs: List[ErrAt], off: Int): String =
  if (List.isEmpty(xs)) "" else if (List.at(xs, 0).off == off) List.at(xs, 0).hint else noteHint(List.tail(xs), off)

def parseErrorExpr(e: Expr): Bool =
  e match {
    case Expr.EVar(name, _) => name == ""
    case Expr.EPrint(value, _) => parseErrorExpr(value)
    case Expr.ECall(name, args, _) => name == "" || List.exists(args, arg => parseErrorExpr(arg))
    case Expr.EMethod(recv, name, args, _) => name == "" || parseErrorExpr(recv) || List.exists(args, arg => parseErrorExpr(arg))
    case Expr.EField(recv, name, _) => name == "" || parseErrorExpr(recv)
    case Expr.EBin(_, left, right, _) => parseErrorExpr(left) || parseErrorExpr(right)
    case Expr.EUn(_, value, _) => parseErrorExpr(value)
    case Expr.ELam(_, _, body) => parseErrorExpr(body)
    case Expr.EIf(cond, yes, no, _) => parseErrorExpr(cond) || parseErrorExpr(yes) || parseErrorExpr(no)
    case Expr.EMatch(value, arms, _) => parseErrorExpr(value) || List.exists(arms, arm => arm.pat == "" || arm.g == "#parse" || parseErrorExpr(arm.body))
    case Expr.EFor(binds, body, _) => List.exists(binds, bind => bind.name == "" || parseErrorExpr(bind.value)) || parseErrorExpr(body)
    case Expr.EInterp(_, parts, _) => List.exists(parts, part => parseErrorExpr(part))
    case Expr.EList(values) => List.exists(values, value => parseErrorExpr(value))
    case Expr.ETuple(values) => List.exists(values, value => parseErrorExpr(value))
    case Expr.ENamed(name, value) => name == "" || parseErrorExpr(value)
    case Expr.EAscribe(value, ty, _) => ty == "" || parseErrorExpr(value)
    case _ => false
  }

def pretty(p: Prog): String =
  Str.concat(prettyPkg(p.pkg), Str.concat(prettyEnums(p.enums), Str.concat(prettyAliases(p.aliases), Str.concat(prettyTraits(p.traits), Str.concat(prettyImpls(p.impls), Str.concat(prettyImps(p.imps, !(List.isEmpty(p.defs) && p.main == "")), Str.concat(prettyDefs(p.defs), prettyMain(p.main, p.body))))))))

