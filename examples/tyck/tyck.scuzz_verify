oracle tyckCore(): Bool =
  Main.tyckCore()

oracle tyckFlow(): Bool =
  Main.tyckFlow()

oracle tyckRes(): Bool =
  Main.tyckRes()

oracle tyckFail(): Bool =
  Main.tyckFail()

oracle tyckParse(): Bool =
  Main.tyckParse()

oracle tyckLam(): Bool =
  Main.tyckLam()

oracle tyckGenSeed(): Bool =
  Main.tyckGen(0)

oracle prettyRoundtrip(): Bool =
  Main.prettyIdem(0)

oracle tyckGenerated(n: Int where n >= 0): Bool =
  Main.tyckGen(n)

oracle prettyGenerated(n: Int where n >= 0): Bool =
  Main.prettyIdem(n)

oracle pureForArguments(): Bool =
  Main.pureForArguments()

oracle forBindTypes(): Bool =
  Main.forBindTypes()

oracle factsTier(): Bool =
  Main.factsTier()

oracle genericRecordFields(): Bool =
  Main.genericRecordFields()

oracle fieldBeforeTupleBinding(): Bool =
  Main.fieldBeforeTupleBinding()

oracle matchCoverage(seed: Int where seed >= 0 && seed < 128): Bool =
  Cases.coverageChecked(seed)

oracle closedPatternCoverage(): Bool =
  Main.closedPatternCoverage()

oracle moduleIdentity(): Bool =
  Main.moduleIdentity()

oracle resultBindings(): Bool =
  Main.resultBindings()

oracle resultFieldBindings(): Bool =
  Main.resultFieldBindings()

