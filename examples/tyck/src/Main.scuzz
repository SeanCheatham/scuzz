  if (Check.check("def right(): List[String] = Json.keys(Json.Obj([]))") != "[]") Str.concat("keysOk ", Check.check("def right(): List[String] = Json.keys(Json.Obj([]))")) else if (!rejects("def wrong(): List[Int] = Json.keys(Json.Obj([]))", "does not match declared")) Str.concat("keysMis ", Check.check("def wrong(): List[Int] = Json.keys(Json.Obj([]))")) else if (!rejects("def wrong(): List[Int] = Json.arr(Json.Arr([]))", "does not match declared")) Str.concat("arrMis ", Check.check("def wrong(): List[Int] = Json.arr(Json.Arr([]))")) else if (!rejects("def wrong(): List[Int] = Json.get(Json.Obj([]), \"a\")", "does not match declared")) Str.concat("getMis ", Check.check("def wrong(): List[Int] = Json.get(Json.Obj([]), \"a\")")) else if (!rejects("def wrong(): List[Int] = Json.at(Json.Arr([]), 0)", "does not match declared")) Str.concat("atMis ", Check.check("def wrong(): List[Int] = Json.at(Json.Arr([]), 0)")) else if (!rejects("def wrong(): List[Int] = Json.pairs(Json.Obj([]))", "does not match declared")) Str.concat("pairsMis ", Check.check("def wrong(): List[Int] = Json.pairs(Json.Obj([]))")) else if (!rejects("def wrong(): List[String] = Json.asInt(Json.Int(1))", "does not match declared")) Str.concat("asIntMis ", Check.check("def wrong(): List[String] = Json.asInt(Json.Int(1))")) else if (!rejects("def wrong(): Json = Json.Obj([1])", "arg type mismatch")) Str.concat("objMis ", Check.check("def wrong(): Json = Json.Obj([1])")) else if (!rejects("def wrong(): Json = Json.Arr([1])", "arg type mismatch")) Str.concat("arrCtorMis ", Check.check("def wrong(): Json = Json.Arr([1])")) else "jsonList-other"

def editorListTypes(): Bool =
  Check.check("def right(): IO[Unit] = Ui.setEditorDiagnostics([(1, 1)])") == "[]" && rejects("def wrong(): IO[Unit] = Ui.setEditorDiagnostics([\"a\"])", "arg type mismatch") && Check.check("def right(): IO[Unit] = Ui.setEditorTokens([1, 2])") == "[]" && rejects("def wrong(): IO[Unit] = Ui.setEditorTokens([\"a\"])", "arg type mismatch") && Check.check("def right(): IO[Unit] = Ui.setEditorInlays([(1, 0, \"x\")])") == "[]" && rejects("def wrong(): IO[Unit] = Ui.setEditorInlays([\"a\"])", "arg type mismatch") && Check.check("def right(): IO[Unit] = Ui.setEditorFolds([(1, 2)])") == "[]" && rejects("def wrong(): IO[Unit] = Ui.setEditorFolds([\"a\"])", "arg type mismatch")

def dumpEditorList(): String =
  if (Check.check("def right(): IO[Unit] = Ui.setEditorDiagnostics([(1, 1)])") != "[]") Str.concat("diagOk ", Check.check("def right(): IO[Unit] = Ui.setEditorDiagnostics([(1, 1)])")) else if (!rejects("def wrong(): IO[Unit] = Ui.setEditorDiagnostics([\"a\"])", "arg type mismatch")) Str.concat("diagMis ", Check.check("def wrong(): IO[Unit] = Ui.setEditorDiagnostics([\"a\"])")) else if (!rejects("def wrong(): IO[Unit] = Ui.setEditorTokens([\"a\"])", "arg type mismatch")) Str.concat("tokensMis ", Check.check("def wrong(): IO[Unit] = Ui.setEditorTokens([\"a\"])")) else if (!rejects("def wrong(): IO[Unit] = Ui.setEditorInlays([\"a\"])", "arg type mismatch")) Str.concat("inlaysMis ", Check.check("def wrong(): IO[Unit] = Ui.setEditorInlays([\"a\"])")) else if (!rejects("def wrong(): IO[Unit] = Ui.setEditorFolds([\"a\"])", "arg type mismatch")) Str.concat("foldsMis ", Check.check("def wrong(): IO[Unit] = Ui.setEditorFolds([\"a\"])")) else "editorList-other"

def propertyForceTypes(): Bool =
  Check.check("def right(): String = Property.force(IO.pure(\"x\"))") == "[]" && rejects("def wrong(): Int = Property.force(IO.pure(\"x\"))", "does not match declared") && Check.check("def right(): Unit = Property.force(IO.pure(()))") == "[]" && Check.check("def right(): Bool = Property.force(IO.pure(true))") == "[]" && rejects("def wrong(): Bool = Property.force(IO.pure(\"x\"))", "does not match declared")

def dumpPropertyForce(): String =
  if (Check.check("def right(): String = Property.force(IO.pure(\"x\"))") != "[]") Str.concat("forceOk ", Check.check("def right(): String = Property.force(IO.pure(\"x\"))")) else if (!rejects("def wrong(): Int = Property.force(IO.pure(\"x\"))", "does not match declared")) Str.concat("forceMis ", Check.check("def wrong(): Int = Property.force(IO.pure(\"x\"))")) else if (Check.check("def right(): Unit = Property.force(IO.pure(()))") != "[]") Str.concat("forceUnitOk ", Check.check("def right(): Unit = Property.force(IO.pure(()))")) else if (Check.check("def right(): Bool = Property.force(IO.pure(true))") != "[]") Str.concat("forceBoolOk ", Check.check("def right(): Bool = Property.force(IO.pure(true))")) else if (!rejects("def wrong(): Bool = Property.force(IO.pure(\"x\"))", "does not match declared")) Str.concat("forceBoolMis ", Check.check("def wrong(): Bool = Property.force(IO.pure(\"x\"))")) else "propertyForce-other"

def ioTypeCompatibility(): Bool =
  Type.eqStr("IO[Int]", "IO[String, Int]") && !Type.eqStr("IO[String]", "IO[String, Int]") && !Type.eqStr("IO[Int]", "IO[Int, String]") && !Type.eqStr("IO[String, Int]", "IO[Bool, Int]") && rejects("def wrong(x: IO[String]): IO[String, Int] = x", "does not match declared")

def tyckParse(): Bool =
  rejects(srcLeftover(), "unexpected token") && tyckDiff(srcBinBad(), wantBinBad()) && tyckDiff(srcHexX(), wantHexX()) && tyckDiff(srcAscOk(), wantAscOk()) && tyckDiff(srcAscMis(), wantAscMis())

def tyckClosed(): Bool =
  rejects(srcViewNope(), "unknown function View.nope") && rejects(srcViewArity(), "View.button expects") && rejects(srcSigGet(), "Signal.get arg type mismatch") && rejects(srcUiRun(), "Ui.run arg type mismatch") && rejects(srcIoNope(), "unknown function IO.notAKit") && Check.check(srcTimeoutOk()) == "[]" && rejects(srcTimeoutMis(), "IO.timeout arg type mismatch")

def tyckLam(): Bool =
  tyckDiff(srcLamAnn(), wantLamAnn()) && tyckDiff(srcLamMis(), wantLamMis()) && tyckDiff(srcLamArg(), wantLamArg()) && tyckDiff(srcFunBody(), wantFunBody()) && wantLamMis() != "[]" && wantLamArg() != "[]" && wantFunBody() != "[]" && funArrowTypes() && listAtPin() && listSibPin() && listSeekPin() && mapCollPin() && callPin() && joinPin() && mapKeyPin() && foldPin() && mapValPin() && predPin() && redPin() && setPredPin() && mapLamPin() && mapKeySlotPin() && byPin()

def listAtPin(): Bool =
  Check.check("""def right(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.println(Str.fromInt(List.at(xs, 0)))
    _ <- IO.println(Str.fromInt(List.at(xs, 0)))
  } yield ()
""") == "[]" && rejects("""def wrong(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.println(Str.fromInt(List.at(xs, 0)))
    _ <- IO.println(List.at(xs, 0))
  } yield ()
""", "expected String, got Int")

def listSibPin(): Bool =
  listSibOk("List.cons(1, xs)") && listSibBad("List.cons(1, xs)", "IO.println(List.at(xs, 0))", "expected String, got Int") && listSibBad("List.concat(xs, [1])", "IO.println(List.at(xs, 0))", "expected String, got Int") && listSibBad("1 :: xs", "IO.println(List.at(xs, 0))", "expected String, got Int") && listSibBad("List.getOrElse(xs, 0, \"x\")", "IO.println(Str.fromInt(List.at(xs, 0)))", "expected Int, got String")

def listSibOk(use: String): Bool =
  Check.check(listSibSrc("right", use, "IO.println(Str.fromInt(List.at(xs, 0)))")) == "[]"

def listSibBad(use: String, later: String, msg: String): Bool =
  rejects(listSibSrc("wrong", use, later), msg)

def listSibSrc(name: String, use: String, later: String): String =
  Str.concat("def ", Str.concat(name, Str.concat("""(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(""", Str.concat(use, Str.concat(""")
    _ <- """, Str.concat(later, """
  } yield ()
"""))))))

def listSeekPin(): Bool =
  listSibOk("List.setAt(xs, 0, 1)") && listSibBad("List.setAt(xs, 0, 1)", "IO.println(List.at(xs, 0))", "expected String, got Int") && listSibBad("List.setAt(xs, 0, \"x\")", "IO.println(Str.fromInt(List.at(xs, 0)))", "expected Int, got String") && listSibBad("List.contains(xs, 1)", "IO.println(List.at(xs, 0))", "expected String, got Int") && listSibBad("List.indexOf(xs, 1)", "IO.println(List.at(xs, 0))", "expected String, got Int") && listSibBad("List.lastIndexOf(xs, \"x\")", "IO.println(Str.fromInt(List.at(xs, 0)))", "expected Int, got String")

def mapCollPin(): Bool =
  Check.check("def right(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.set(m, \"a\", 1))\n    _ <- IO.println(Str.fromInt(Map.getOrElse(m, \"a\", 0)))\n  } yield ()\n") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.set(m, \"a\", 1))\n    _ <- IO.println(Map.getOrElse(m, \"a\", \"x\"))\n  } yield ()\n", "expected Int, got String") && Check.check("def right(): IO[Unit] =\n  for {\n    s = Set.empty()\n    _ <- IO.pure(Set.add(s, 1))\n    _ <- IO.println(if (Set.contains(s, 2)) \"y\" else \"n\")\n  } yield ()\n") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    s = Set.empty()\n    _ <- IO.pure(Set.add(s, 1))\n    _ <- IO.pure(Set.contains(s, \"x\"))\n  } yield ()\n", "expected Int, got String")

def callPin(): Bool =
  Check.check("""def take(xs: List[Int]): Int =
  List.at(xs, 0)
def right(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.println(Str.fromInt(take(xs)))
    _ <- IO.println(Str.fromInt(List.at(xs, 0)))
  } yield ()
""") == "[]" && rejects("""def take(xs: List[Int]): Int =
  List.at(xs, 0)
def wrong(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.println(Str.fromInt(take(xs)))
    _ <- IO.println(List.at(xs, 0))
  } yield ()
""", "expected String, got Int") && rejects("def put(m: Map[String, Int]): Int =\n  Map.getOrElse(m, \"a\", 0)\ndef wrong(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.println(Str.fromInt(put(m)))\n    _ <- IO.println(Map.getOrElse(m, \"a\", \"x\"))\n  } yield ()\n", "expected Int, got String") && rejects("def has(s: Set[Int]): Bool =\n  Set.contains(s, 1)\ndef wrong(): IO[Unit] =\n  for {\n    s = Set.empty()\n    _ <- IO.pure(has(s))\n    _ <- IO.pure(Set.contains(s, \"x\"))\n  } yield ()\n", "expected Int, got String")

def joinPin(): Bool =
  listSibOk("List.append(xs, 1)") && listSibBad("List.append(xs, 1)", "IO.println(List.at(xs, 0))", "expected String, got Int") && listSibBad("List.append(xs, \"x\")", "IO.println(Str.fromInt(List.at(xs, 0)))", "expected Int, got String") && listSibBad("List.intersperse(xs, 1)", "IO.println(List.at(xs, 0))", "expected String, got Int") && rejects("def wrong(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.union(m, Map.set(Map.empty(), \"a\", 1)))\n    _ <- IO.println(Map.getOrElse(m, \"a\", \"x\"))\n  } yield ()\n", "expected Int, got String") && rejects("def wrong(): IO[Unit] =\n  for {\n    s = Set.empty()\n    _ <- IO.pure(Set.union(s, Set.add(Set.empty(), 1)))\n    _ <- IO.pure(Set.contains(s, \"x\"))\n  } yield ()\n", "expected Int, got String")

def mapKeyPin(): Bool =
  Check.check("def right(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.contains(m, \"a\"))\n    _ <- IO.println(Str.fromInt(Map.getOrElse(m, \"a\", 0)))\n  } yield ()\n") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.contains(m, \"a\"))\n    _ <- IO.println(Str.fromInt(Map.getOrElse(m, 1, 0)))\n  } yield ()\n", "expected String, got Int") && rejects("def wrong(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.remove(m, \"a\"))\n    _ <- IO.println(Str.fromInt(Map.getOrElse(m, 1, 0)))\n  } yield ()\n", "expected String, got Int") && rejects("def wrong(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.get(m, \"a\"))\n    _ <- IO.println(Str.fromInt(Map.getOrElse(m, 1, 0)))\n  } yield ()\n", "expected String, got Int")

def foldPin(): Bool =
  Check.check("""def right(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.foldLeft(xs, 0, (acc, n) => acc + n))
    _ <- IO.println(Str.fromInt(List.at(xs, 0)))
  } yield ()
""") == "[]" && Check.check("""def right(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.foldLeft(xs, 0, (acc, n) => acc + 1))
    _ <- IO.println(List.at(xs, 0))
  } yield ()
""") == "[]" && rejects("""def wrong(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.foldLeft(xs, 0, (acc, n) => acc + n))
    _ <- IO.println(List.at(xs, 0))
  } yield ()
""", "expected String, got Int") && rejects("def wrong(): IO[Unit] =\n  for {\n    xs = List.empty()\n    _ <- IO.pure(List.foldRight(xs, \"!\", (x, acc) => Str.concat(x, acc)))\n    _ <- IO.println(Str.fromInt(List.at(xs, 0)))\n  } yield ()\n", "expected Int, got String") && rejects("""def wrong(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.scanLeft(xs, 0, (acc, n) => acc + n))
    _ <- IO.println(List.at(xs, 0))
  } yield ()
""", "expected String, got Int")

def mapValPin(): Bool =
  Check.check("def right(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.contains(m, \"a\"))\n    _ <- IO.pure(Map.set(m, \"a\", 1))\n    _ <- IO.println(Str.fromInt(Map.getOrElse(m, \"a\", 0)))\n  } yield ()\n") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.contains(m, \"a\"))\n    _ <- IO.pure(Map.set(m, \"a\", 1))\n    _ <- IO.println(Map.getOrElse(m, \"a\", \"x\"))\n  } yield ()\n", "expected Int, got String") && rejects("def wrong(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.contains(m, \"a\"))\n    _ <- IO.pure(Map.getOrElse(m, \"a\", \"x\"))\n    _ <- IO.println(Str.fromInt(Map.getOrElse(m, \"a\", 0)))\n  } yield ()\n", "expected String, got Int") && rejects("def wrong(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.contains(m, \"a\"))\n    _ <- IO.pure(Map.set(m, \"a\", 1))\n    _ <- IO.pure(Map.set(m, \"a\", \"x\"))\n  } yield ()\n", "expected Int, got String")

def predPin(): Bool =
  Check.check("""def right(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.map(xs, n => n + 1))
    _ <- IO.println(Str.fromInt(List.at(xs, 0)))
  } yield ()
""") == "[]" && Check.check("""def right(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.map(xs, n => n))
    _ <- IO.println(List.at(xs, 0))
  } yield ()
""") == "[]" && rejects("""def wrong(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.map(xs, n => n + 1))
    _ <- IO.println(List.at(xs, 0))
  } yield ()
""", "expected String, got Int") && rejects("def wrong(): IO[Unit] =\n  for {\n    xs = List.empty()\n    _ <- IO.pure(List.filter(xs, n => n == \"a\"))\n    _ <- IO.println(Str.fromInt(List.at(xs, 0)))\n  } yield ()\n", "expected Int, got String") && rejects("""def wrong(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.map(xs, n => Str.fromInt(n)))
    _ <- IO.println(List.at(xs, 0))
  } yield ()
""", "expected String, got Int") && rejects("""def wrong(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.map(xs, (n: String) => n))
    _ <- IO.println(Str.fromInt(List.at(xs, 0)))
  } yield ()
""", "expected Int, got String")

def redPin(): Bool =
  Check.check("""def right(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.reduceLeft(xs, (a, b) => a + 1))
    _ <- IO.println(Str.fromInt(List.at(xs, 0)))
  } yield ()
""") == "[]" && Check.check("""def right(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.reduceLeft(xs, (a, b) => a + b))
    _ <- IO.println(List.at(xs, 0))
  } yield ()
""") == "[]" && rejects("""def wrong(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.reduceLeft(xs, (a, b) => a + 1))
    _ <- IO.println(List.at(xs, 0))
  } yield ()
""", "expected String, got Int") && rejects("""def wrong(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.reduceRight(xs, (a, b) => Str.concat(a, b)))
    _ <- IO.println(Str.fromInt(List.at(xs, 0)))
  } yield ()
""", "expected Int, got String")

def setPredPin(): Bool =
  Check.check("""def right(): IO[Unit] =
  for {
    s = Set.empty()
    _ <- IO.pure(Set.filter(s, n => n > 0))
    _ <- IO.pure(Set.contains(s, 1))
  } yield ()
""") == "[]" && Check.check("def right(): IO[Unit] =\n  for {\n    s = Set.empty()\n    _ <- IO.pure(Set.filter(s, n => true))\n    _ <- IO.pure(Set.contains(s, \"x\"))\n  } yield ()\n") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    s = Set.empty()\n    _ <- IO.pure(Set.filter(s, n => n > 0))\n    _ <- IO.pure(Set.contains(s, \"x\"))\n  } yield ()\n", "expected Int, got String") && rejects("def wrong(): IO[Unit] =\n  for {\n    s = Set.empty()\n    _ <- IO.pure(Set.map(s, n => Str.fromInt(n)))\n    _ <- IO.pure(Set.contains(s, \"x\"))\n  } yield ()\n", "expected Int, got String") && rejects("def wrong(): IO[Unit] =\n  for {\n    s = Set.empty()\n    _ <- IO.pure(Set.exists(s, (n: String) => n == \"a\"))\n    _ <- IO.pure(Set.contains(s, 1))\n  } yield ()\n", "expected String, got Int")

def mapLamPin(): Bool =
  Check.check("def right(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.filter(m, v => v == 1))\n    _ <- IO.println(Str.fromInt(Map.getOrElse(m, \"a\", 0)))\n  } yield ()\n") == "[]" && Check.check("def right(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.filter(m, v => true))\n    _ <- IO.println(Map.getOrElse(m, \"a\", \"x\"))\n  } yield ()\n") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.filter(m, v => v == 1))\n    _ <- IO.println(Map.getOrElse(m, \"a\", \"x\"))\n  } yield ()\n", "expected Int, got String") && rejects("def wrong(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.contains(m, \"a\"))\n    _ <- IO.pure(Map.filter(m, v => v == 1))\n    _ <- IO.println(Str.fromInt(Map.getOrElse(m, 1, 0)))\n  } yield ()\n", "expected String, got Int")

def mapKeySlotPin(): Bool =
  Check.check("def right(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.filter(m, v => v == 1))\n    _ <- IO.pure(Map.contains(m, \"a\"))\n    _ <- IO.println(Str.fromInt(Map.getOrElse(m, \"a\", 0)))\n  } yield ()\n") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.filter(m, v => v == 1))\n    _ <- IO.pure(Map.contains(m, \"a\"))\n    _ <- IO.println(Str.fromInt(Map.getOrElse(m, 1, 0)))\n  } yield ()\n", "expected String, got Int") && rejects("def wrong(): IO[Unit] =\n  for {\n    m = Map.empty()\n    _ <- IO.pure(Map.filter(m, v => v == 1))\n    _ <- IO.pure(Map.set(m, \"a\", 1))\n    _ <- IO.println(Map.getOrElse(m, \"a\", \"x\"))\n  } yield ()\n", "expected Int, got String")

def byPin(): Bool =
  Check.check("""def right(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.sortBy(xs, n => n))
    _ <- IO.println(Str.fromInt(List.at(xs, 0)))
  } yield ()
""") == "[]" && Check.check("""def right(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.sortBy(xs, n => 1))
    _ <- IO.println(List.at(xs, 0))
  } yield ()
""") == "[]" && rejects("""def wrong(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.sortBy(xs, n => n))
    _ <- IO.println(List.at(xs, 0))
  } yield ()
""", "expected String, got Int") && rejects("""def wrong(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.sortBy(xs, n => Str.len(n)))
    _ <- IO.println(Str.fromInt(List.at(xs, 0)))
  } yield ()
""", "expected Int, got String") && rejects("""def wrong(): IO[Unit] =
  for {
    xs = List.empty()
    _ <- IO.pure(List.maxBy(xs, n => n + 1))
    _ <- IO.println(List.at(xs, 0))
  } yield ()
