def ioTypeCompatibility(): Bool =
  Type.eqStr("IO[Int]", "IO[String, Int]") && !Type.eqStr("IO[String]", "IO[String, Int]") && !Type.eqStr("IO[Int]", "IO[Int, String]") && !Type.eqStr("IO[String, Int]", "IO[Bool, Int]") && rejects("def wrong(x: IO[String]): IO[String, Int] = x", "does not match declared")

def tyckParse(): Bool =
  rejects(srcLeftover(), "unexpected token") && tyckDiff(srcBinBad(), wantBinBad()) && tyckDiff(srcHexX(), wantHexX()) && tyckDiff(srcAscOk(), wantAscOk()) && tyckDiff(srcAscMis(), wantAscMis())

def tyckClosed(): Bool =
  rejects(srcViewNope(), "unknown function View.nope") && rejects(srcViewArity(), "View.button expects") && rejects(srcSigGet(), "Signal.get arg type mismatch") && rejects(srcUiRun(), "Ui.run arg type mismatch") && rejects(srcIoNope(), "unknown function IO.notAKit") && Check.check(srcTimeoutOk()) == "[]" && rejects(srcTimeoutMis(), "IO.timeout arg type mismatch")

def tyckLam(): Bool =
  tyckDiff(srcLamAnn(), wantLamAnn()) && tyckDiff(srcLamMis(), wantLamMis()) && tyckDiff(srcLamArg(), wantLamArg()) && tyckDiff(srcFunBody(), wantFunBody()) && wantLamMis() != "[]" && wantLamArg() != "[]" && wantFunBody() != "[]"

def srcEitherOk(): String =
  "enum Either[L, R]:\n  case Left(x: L)\n  case Right(y: R)\ndef eitherNum(e: Either[Int, Int]): Int =\n  e match {\n    case Either.Left(n) | Either.Right(n) => n\n  }\ndef describeEither(e: Either[Int, String]): String =\n  e match {\n    case Either.Left(n) => Str.fromInt(n)\n    case Either.Right(s) => s\n  }\n@main def main: IO[Unit] =\n  IO.println(Str.concat(Str.fromInt(eitherNum(Either.Left(4))), describeEither(Either.Right(\"ok\"))))\n"

def srcEitherMis(): String =
  "enum Either[L, R]:\n  case Left(x: L)\n  case Right(y: R)\ndef eitherNum(e: Either[Int, Int]): Int =\n  e match {\n    case Either.Left(n) | Either.Right(n) => n\n  }\n@main def main: IO[Unit] =\n  IO.println(Str.fromInt(eitherNum(Either.Left(\"x\"))))\n"

def srcShowOk(): String =
  "trait Show:\n  def show(): String\nrecord Point(x: Int, y: Int)\nimpl Show for Point:\n  def show(): String =\n    \"p\"\n@main def main: IO[Unit] =\n  IO.println(Point(1, 2).show())\n"

def srcSelfGet(): String =
  """record Box[T](x: T)
def wrap[T](x: T): Box[T] =
  Box(x)
def get(): T =
  self.x
@main def main: IO[Unit] =
  IO.println(Str.fromInt(wrap(4).get()))
"""

def srcPhOk(): String =
  """def applyInt(f: Int => Int, n: Int): Int =
  f(n)
@main def main: IO[Unit] =
  IO.println(Str.fromInt(applyInt(_ + 1, 3)))
"""

def tyckAdt(): Bool =
  Type.eqStr("Either[Int]", "Either[Int, Int]") && Type.eqStr("Either[String]", "Either[Int, String]") && !Type.eqStr("Either[String]", "Either[Int, Int]") && Check.check(srcEitherOk()) == "[]" && rejects(srcEitherMis(), "eitherNum arg type mismatch") && Check.check(srcShowOk()) == "[]" && Check.check(srcSelfGet()) == "[]" && Check.check(srcPhOk()) == "[]" && tyckRecordBind()

def tyckRecordBind(): Bool =
  Check.check("""record Box(value: Int)
def get(b: Box): Int = b match { case Box(n) => n }
""") == "[]" && Check.check("""record Box(value: Int)
def get(b: Box): String = b match { case Box(n) => n }
""") != "[]" && Check.check("""record Inner(value: Int)
record Box(value: Inner)
def get(b: Box): Int = b match { case Box(p) => p.value }
""") == "[]"

