  IO.notAKit(1)
"""

def srcTimeoutOk(): String =
  "@main def main: IO[Unit] =\n  IO.timeout(50, IO.println(\"x\")).flatMap(_ => IO.pure(()))\n"

def srcTimeoutMis(): String =
  "@main def main: IO[Unit] =\n  IO.timeout(IO.println(\"x\"), 50).flatMap(_ => IO.pure(()))\n"

def tyckAny(): Bool =
  Kits.anyCount() == 0

def allOk(): Bool =
  tyckCore() && tyckFlow() && tyckRes() && tyckFail() && tyckParse() && tyckLam() && tyckAdt() && tyckClosed() && tyckAny()

def dumpFail(): String =
  if (!tyckCore()) "tyckCore" else if (!tyckFlow()) "tyckFlow" else if (!tyckRes()) "tyckRes" else if (!tyckFail()) dumpTyckFail() else if (!tyckParse()) "tyckParse" else if (!tyckLam()) "tyckLam" else if (!tyckAdt()) "tyckAdt" else if (!tyckClosed()) dumpClosed() else if (!tyckAny()) "tyckAny" else "other"

def dumpTyckFail(): String =
  if (!collectionTypes()) dumpListFilter() else if (!streamTypes()) dumpStream() else if (!flattenTypes()) dumpFlatten() else if (!foldTypes()) dumpFold() else if (!mapSetTypes()) dumpMapSet() else if (!zipTypes()) dumpZip() else if (!unfoldTypes()) dumpUnfold() else if (!listBuildTypes()) dumpListBuild() else if (!kitLookup()) "kitLookup" else if (!ioCombinators()) dumpIoComb() else "tyckFail"

def dumpIoComb(): String =
  if (Check.check("def right(): IO[String] = IO.timeout(50, IO.pure(\"x\"))") != "[]") Str.concat("timeoutOk ", Check.check("def right(): IO[String] = IO.timeout(50, IO.pure(\"x\"))")) else if (!rejects("def wrong(): IO[Int] = IO.timeout(50, IO.pure(\"x\"))", "does not match declared")) Str.concat("timeoutMis ", Check.check("def wrong(): IO[Int] = IO.timeout(50, IO.pure(\"x\"))")) else if (Check.check("def right(): IO[Int] = IO.race(IO.pure(1), IO.pure(2))") != "[]") Str.concat("raceOk ", Check.check("def right(): IO[Int] = IO.race(IO.pure(1), IO.pure(2))")) else if (!rejects("def wrong(): IO[Int] = IO.race(IO.pure(1), IO.pure(\"x\"))", "arg type mismatch")) Str.concat("raceMis ", Check.check("def wrong(): IO[Int] = IO.race(IO.pure(1), IO.pure(\"x\"))")) else if (Check.check("def right(): IO[(Int, String)] = IO.both(IO.pure(1), IO.pure(\"x\"))") != "[]") Str.concat("bothOk ", Check.check("def right(): IO[(Int, String)] = IO.both(IO.pure(1), IO.pure(\"x\"))")) else if (!rejects("def wrong(): IO[String] = IO.both(IO.pure(1), IO.pure(\"x\"))", "does not match declared")) Str.concat("bothMis ", Check.check("def wrong(): IO[String] = IO.both(IO.pure(1), IO.pure(\"x\"))")) else if (Check.check("def right(): IO[String] = IO.ensure(IO.pure(\"x\"), IO.pure(()))") != "[]") Str.concat("ensureOk ", Check.check("def right(): IO[String] = IO.ensure(IO.pure(\"x\"), IO.pure(()))")) else if (Check.check("def right(): IO[List[String]] = IO.foreach([\"a\"], x => IO.pure(Str.concat(x, \"!\")))") != "[]") Str.concat("foreachOk ", Check.check("def right(): IO[List[String]] = IO.foreach([\"a\"], x => IO.pure(Str.concat(x, \"!\")))")) else if (!rejects("def wrong(): IO[List[Int]] = IO.foreach([\"a\"], x => IO.pure(Str.concat(x, \"!\")))", "does not match declared")) Str.concat("foreachMis ", Check.check("def wrong(): IO[List[Int]] = IO.foreach([\"a\"], x => IO.pure(Str.concat(x, \"!\")))")) else if (Check.check("def right(): IO[Fiber[String]] = Fiber.fork(IO.pure(\"x\"))") != "[]") Str.concat("forkOk ", Check.check("def right(): IO[Fiber[String]] = Fiber.fork(IO.pure(\"x\"))")) else if (!rejects("def wrong(): IO[Fiber[Int]] = Fiber.fork(IO.pure(\"x\"))", "does not match declared")) Str.concat("forkMis ", Check.check("def wrong(): IO[Fiber[Int]] = Fiber.fork(IO.pure(\"x\"))")) else if (!bothUnpack()) Str.concat("bothUnpack ", Check.check("def wrong(): IO[Unit] =\n  for {\n    (_, n) <- IO.both(IO.pure(1), IO.pure(\"x\"))\n    _ <- IO.println(Str.fromInt(n))\n  } yield ()\n")) else if (!fiberJoin()) Str.concat("fiberJoin ", Check.check("def wrong(): IO[Unit] =\n  for {\n    f <- Fiber.fork(IO.pure(\"x\"))\n    n <- Fiber.join(f)\n    _ <- IO.println(Str.fromInt(n))\n  } yield ()\n")) else dumpRef()

def dumpClosed(): String =
  if (!rejects(srcViewNope(), "unknown function View.nope")) "viewNope" else if (!rejects(srcViewArity(), "View.button expects")) "viewArity" else if (!rejects(srcSigGet(), "Signal.get arg type mismatch")) "sigGet" else if (!rejects(srcUiRun(), "Ui.run arg type mismatch")) "uiRun" else if (!rejects(srcIoNope(), "unknown function IO.notAKit")) "ioNope" else if (Check.check(srcTimeoutOk()) != "[]") Str.concat("timeoutOk ", Check.check(srcTimeoutOk())) else if (!rejects(srcTimeoutMis(), "IO.timeout arg type mismatch")) Str.concat("timeoutMis ", Check.check(srcTimeoutMis())) else "closed-other"

def namedIoTypes(): Bool =
  Check.check("def right(io: IO[Int]): IO[String] = io.map(n => Str.fromInt(n))") == "[]" && rejects("def wrong(io: IO[Int]): IO[String] = io.map(n => n + 1)", "does not match declared") && rejects("def wrong(io: IO[Int]): IO[Int] = io.map(n => Str.len(n))", "type mismatch") && rejects("def wrong(io: IO[Int, Int]): IO[Int, Int] = io.flatMap(n => IO.fail(true))", "error") && rejects("def wrong(io: IO[Int, Int]): IO[Int] = io.handleErrorWith(e => IO.pure(Str.len(e)))", "type mismatch")

def signalTypes(): Bool =
  Check.check("""record State(n: Int)
def right(): Signal[String] = Signal.map(Signal.make(State(1)), s => Str.fromInt(s.n))""") == "[]" && rejects("def wrong(s: Signal[Int]): Unit = Signal.set(s, \"x\")", "type mismatch") && rejects("def wrong(s: Signal[Int]): Signal[String] = Signal.map(s, n => n + 1)", "does not match declared") && rejects("def wrong(s: Signal[Int]): Signal[Int] = Signal.map(s, (n: String) => Str.len(n))", "type mismatch")

def attemptTypes(): Bool =
  Type.show(Type.ioErr(Type.parse("IO[Result[Int, String]]"))) == "String" && Type.show(Type.ioOk(Type.parse("IO[Result[Int, String]]"))) == "Result[Int, String]" && Check.check("def right(io: IO[Int, String]): IO[Result[Int, String]] = IO.attempt(io)") == "[]" && rejects("def wrong(io: IO[Int, String]): IO[Result[String, String]] = IO.attempt(io)", "does not match declared") && rejects("def wrong(): IO[Result[Int, String]] = IO.attempt(3)", "type mismatch")

def kitLookup(): Bool =
  List.forall(Kits.allKits(), kit => Kits.find(kit.name) == kit) && !Kits.has("Missing.name") && Kits.ret("IO.timeout") == "IO[E, A]" && Kits.ret("IO.both") == "IO[E, (A, B)]" && Kits.ret("Fiber.join") == "IO[A]" && Kits.ret("Ref.of") == "IO[Ref[A]]" && Kits.ret("Ref.get") == "IO[A]" && Kits.ret("Fiber.interrupt") == "IO[Unit]" && Kits.ret("List.filter") == "List[A]" && Kits.ret("List.take") == "List[A]" && Kits.ret("Stream.emit") == "Stream[A]" && Kits.ret("Stream.compileToList") == "IO[List[A]]" && Kits.ret("Stream.flatten") == "Stream[A]" && Kits.ret("List.flatten") == "List[A]" && Kits.ret("List.foldLeft") == "B" && Kits.ret("Stream.fold") == "IO[B]" && Kits.ret("Map.set") == "Map[A, B]" && Kits.ret("Set.add") == "Set[A]" && Kits.ret("List.zip") == "List[(A, B)]" && Kits.ret("Stream.zip") == "Stream[(A, B)]" && Kits.ret("Stream.unfold") == "Stream[A]" && Kits.ret("Stream.iterate") == "Stream[A]" && Kits.ret("List.fill") == "List[A]" && Kits.ret("List.grouped") == "List[List[A]]"

def ioCombinators(): Bool =
  Check.check("def right(): IO[String] = IO.timeout(50, IO.pure(\"x\"))") == "[]" && rejects("def wrong(): IO[Int] = IO.timeout(50, IO.pure(\"x\"))", "does not match declared") && Check.check("def right(): IO[Int] = IO.race(IO.pure(1), IO.pure(2))") == "[]" && rejects("def wrong(): IO[Int] = IO.race(IO.pure(1), IO.pure(\"x\"))", "arg type mismatch") && Check.check("def right(): IO[(Int, String)] = IO.both(IO.pure(1), IO.pure(\"x\"))") == "[]" && rejects("def wrong(): IO[String] = IO.both(IO.pure(1), IO.pure(\"x\"))", "does not match declared") && Check.check("def right(): IO[String] = IO.ensure(IO.pure(\"x\"), IO.pure(()))") == "[]" && Check.check("def right(): IO[List[String]] = IO.foreach([\"a\"], x => IO.pure(Str.concat(x, \"!\")))") == "[]" && rejects("def wrong(): IO[List[Int]] = IO.foreach([\"a\"], x => IO.pure(Str.concat(x, \"!\")))", "does not match declared") && Check.check("def right(): IO[Fiber[String]] = Fiber.fork(IO.pure(\"x\"))") == "[]" && rejects("def wrong(): IO[Fiber[Int]] = Fiber.fork(IO.pure(\"x\"))", "does not match declared") && bothUnpack() && fiberJoin() && refTypes()

def bothUnpack(): Bool =
  Check.check("def right(): IO[Unit] =\n  for {\n    (_, s) <- IO.both(IO.pure(1), IO.pure(\"x\"))\n    _ <- IO.println(s)\n  } yield ()\n") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    (_, n) <- IO.both(IO.pure(1), IO.pure(\"x\"))\n    _ <- IO.println(Str.fromInt(n))\n  } yield ()\n", "type mismatch")

def fiberJoin(): Bool =
  Check.check("def right(): IO[Unit] =\n  for {\n    f <- Fiber.fork(IO.pure(\"x\"))\n    s <- Fiber.join(f)\n    _ <- IO.println(s)\n  } yield ()\n") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    f <- Fiber.fork(IO.pure(\"x\"))\n    n <- Fiber.join(f)\n    _ <- IO.println(Str.fromInt(n))\n  } yield ()\n", "type mismatch")

def refTypes(): Bool =
  Check.check("def right(): IO[Ref[String]] = Ref.of(\"x\")") == "[]" && rejects("def wrong(): IO[Ref[Int]] = Ref.of(\"x\")", "does not match declared") && Check.check("""def right(): IO[Int] =
  for {
    r <- Ref.of(1)
    n <- Ref.get(r)
  } yield n
""") == "[]" && rejects("""def wrong(): IO[String] =
  for {
    r <- Ref.of(1)
    s <- Ref.get(r)
  } yield s
""", "does not match declared") && Check.check("def right(): IO[Unit] =\n  for {\n    r <- Ref.of(\"x\")\n    _ <- Ref.set(r, \"y\")\n    s <- Ref.get(r)\n    _ <- IO.println(s)\n  } yield ()\n") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    r <- Ref.of(\"x\")\n    _ <- Ref.set(r, 1)\n  } yield ()\n", "type mismatch") && Check.check("""def right(): IO[Int] =
  for {
    r <- Ref.of(0)
    _ <- Ref.update(r, n => n + 1)
    n <- Ref.updateAndGet(r, n => n + 1)
  } yield n
""") == "[]" && rejects("""def wrong(): IO[Unit] =
  for {
    r <- Ref.of(0)
    _ <- Ref.update(r, n => Str.fromInt(n))
  } yield ()
""", "arg type mismatch")

def dumpRef(): String =
  if (Check.check("def right(): IO[Ref[String]] = Ref.of(\"x\")") != "[]") Str.concat("refOfOk ", Check.check("def right(): IO[Ref[String]] = Ref.of(\"x\")")) else if (!rejects("def wrong(): IO[Ref[Int]] = Ref.of(\"x\")", "does not match declared")) Str.concat("refOfMis ", Check.check("def wrong(): IO[Ref[Int]] = Ref.of(\"x\")")) else if (Check.check("""def right(): IO[Int] =
  for {
    r <- Ref.of(1)
    n <- Ref.get(r)
  } yield n
""") != "[]") Str.concat("refGetOk ", Check.check("""def right(): IO[Int] =
  for {
    r <- Ref.of(1)
    n <- Ref.get(r)
  } yield n
""")) else if (!rejects("""def wrong(): IO[String] =
  for {
    r <- Ref.of(1)
    s <- Ref.get(r)
  } yield s
""", "does not match declared")) Str.concat("refGetMis ", Check.check("""def wrong(): IO[String] =
  for {
    r <- Ref.of(1)
    s <- Ref.get(r)
  } yield s
""")) else if (Check.check("def right(): IO[Unit] =\n  for {\n    r <- Ref.of(\"x\")\n    _ <- Ref.set(r, \"y\")\n    s <- Ref.get(r)\n    _ <- IO.println(s)\n  } yield ()\n") != "[]") Str.concat("refSetOk ", Check.check("def right(): IO[Unit] =\n  for {\n    r <- Ref.of(\"x\")\n    _ <- Ref.set(r, \"y\")\n    s <- Ref.get(r)\n    _ <- IO.println(s)\n  } yield ()\n")) else if (!rejects("def wrong(): IO[Unit] =\n  for {\n    r <- Ref.of(\"x\")\n    _ <- Ref.set(r, 1)\n  } yield ()\n", "type mismatch")) Str.concat("refSetMis ", Check.check("def wrong(): IO[Unit] =\n  for {\n    r <- Ref.of(\"x\")\n    _ <- Ref.set(r, 1)\n  } yield ()\n")) else if (Check.check("""def right(): IO[Int] =
  for {
    r <- Ref.of(0)
    _ <- Ref.update(r, n => n + 1)
    n <- Ref.updateAndGet(r, n => n + 1)
  } yield n
""") != "[]") Str.concat("refUpdateOk ", Check.check("""def right(): IO[Int] =
  for {
    r <- Ref.of(0)
    _ <- Ref.update(r, n => n + 1)
    n <- Ref.updateAndGet(r, n => n + 1)
  } yield n
""")) else if (!rejects("""def wrong(): IO[Unit] =
  for {
    r <- Ref.of(0)
    _ <- Ref.update(r, n => Str.fromInt(n))
  } yield ()
""", "arg type mismatch")) Str.concat("refUpdateMis ", Check.check("""def wrong(): IO[Unit] =
  for {
    r <- Ref.of(0)
    _ <- Ref.update(r, n => Str.fromInt(n))
  } yield ()
""")) else "ioComb-other"

def resultTypes(): Bool =
  Check.check("def right(): Result[String, Int] = Result.Ok(1)") == "[]" && rejects("def wrong(): Result[String, Int] = Result.Ok(true)", "does not match declared") && Check.check("""record Problem(code: Int)
def value(r: Result[Problem, Int]): Int = r match {
  case Result.Err(e) => e.code
  case Result.Ok(n) => n
}""") == "[]" && rejects("""def wrong(r: Result[Int, String]): Int = r match {
  case Result.Err(e) => Str.len(e)
  case Result.Ok(s) => Str.len(s)
}""", "type mismatch")

def funLookup(): Bool =
  funLookupDefs(Parse.parseFiles(("A", """def pick(n: Int): Int = n
def skip(): Int = 0
def pick(s: String): String = s""") :: ("B", "def pick(): Bool = true") :: []).defs)

def funLookupDefs(defs: List[Fun]): Bool =
  List.map(Check.findFun(defs, "pick"), d => d.ret) == ["Int", "String", "Bool"] && List.map(Check.findFunMod(defs, "A", "pick"), d => d.ret) == ["Int", "String"] && List.isEmpty(Check.findFun(defs, "missing")) && List.isEmpty(Check.findFunMod(defs, "missing", "pick"))

def sourceOffsets(): Bool =
  List.map(List.range(0, 8), off => Check.lineCol("""aé

雪r
z""", off)) == [(1, 1), (1, 2), (1, 3), (2, 1), (3, 1), (3, 2), (3, 3), (4, 1)] && Check.lineCol("", 0) == (1, 1) && Check.lineCol("a", 5) == (1, 2)

@main def main: IO[Unit] =
  IO.println(if (allOk()) "tyck-ok" else Str.concat("tyck-bad ", dumpFail()))
