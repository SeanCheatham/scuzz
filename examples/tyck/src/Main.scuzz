def tyckDiff(src: String, want: String): Bool =
  if (want == "[]") Check.check(src) == "[]" else Str.contains(Check.check(src), jsonMsg(want))

def jsonMsg(w: String): String =
  jsonMsgGo(w, Str.indexOf(w, "\"message\":\""))

def jsonMsgGo(w: String, i: Int): String =
  if (i < 0) w else jsonMsgTake(w, i + 11)

def jsonMsgTake(w: String, i: Int): String =
  jsonMsgTake2(w, i, Str.indexOf(Str.slice(w, i, Str.len(w)), "\""))

def jsonMsgTake2(w: String, i: Int, j: Int): String =
  if (j < 0) Str.slice(w, i, Str.len(w)) else Str.slice(w, i, i + j)

