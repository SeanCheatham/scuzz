def genProg(n: Int): String =
  Str.concat("""def f(x: Int): Int =
  x + """, Str.concat(Str.fromInt(n % 8), """

@main def main: IO[Unit] =
  IO.println(Str.fromInt(f(1)))
"""))

def tyckGen(n: Int where n >= 0): Bool =
  Check.check(genProg(n)) == "[]"

def prettyIdem(n: Int where n >= 0): Bool =
  Parse.pretty(Parse.parse(Lexer.lex(genProg(n)))) == Parse.pretty(Parse.parse(Lexer.lex(Parse.pretty(Parse.parse(Lexer.lex(genProg(n)))))))

def tyckCore(): Bool =
  sourceOffsets() && funLookup() && tyckDiff(srcOk(), wantOk()) && tyckDiff(srcUnbound(), wantUnbound()) && tyckDiff(srcArith(), wantArith()) && tyckDiff(srcArity(), wantArity()) && tyckDiff(srcRet(), wantRet()) && tyckDiff(srcPrint(), wantPrint()) && tyckDiff(srcUnk(), wantUnk()) && tyckDiff(srcCmp(), wantCmp()) && tyckDiff(srcMainTy(), wantMainTy()) && tyckDiff(srcArg(), wantArg()) && tyckDiff(srcWatch(), wantWatch()) && tyckDiff(srcDup(), wantDup()) && tyckFiles()

def tyckFlow(): Bool =
  tyckDiff(srcUnBool(), wantUnBool()) && tyckDiff(srcIfMis(), wantIfMis()) && tyckDiff(srcMapHandle(), wantMapHandle()) && tyckDiff(srcJoinMis(), wantJoinMis()) && tyckDiff(srcNope(), wantNope()) && tyckDiff(srcStrUnk(), wantStrUnk()) && tyckDiff(srcStrConcatTy(), wantStrConcatTy()) && tyckDiff(srcSysExit(), wantSysExit())

def tyckRes(): Bool =
  tyckDiff(srcResArity(), wantResArity()) && tyckDiff(srcResDraw(), wantResDraw()) && tyckDiff(srcResLam(), wantResLam()) && tyckDiff(srcResUnk(), wantResUnk()) && tyckDiff(srcJsonUnk(), wantJsonUnk()) && tyckDiff(srcDefUnk(), wantDefUnk()) && tyckDiff(srcDefMis(), wantDefMis()) && tyckDiff(srcQueUnk(), wantQueUnk()) && tyckDiff(srcQueMis(), wantQueMis()) && tyckDiff(srcQueTake(), wantQueTake()) && tyckDiff(srcQuePay(), wantQuePay()) && tyckDiff(srcNetStr(), wantNetStr())

def rejects(src: String, msg: String): Bool =
  Str.contains(Check.check(src), msg)

def tyckFail(): Bool =
  tyckDiff(srcFailOk(), wantFailOk()) && rejects(srcFailMis(), "@main body must be IO[Unit]") && ioTypeArgs()

def ioTypeArgs(): Bool =
  genericTypeArgs() && ioTypeCompatibility() && namedIoTypes() && signalTypes() && attemptTypes() && kitLookup() && resultTypes() && ioCombinators()

def genericTypeArgs(): Bool =
  collectionTypes() && userTypeArgs() && streamTypes() && flattenTypes() && foldTypes() && mapSetTypes() && zipTypes() && unfoldTypes() && listBuildTypes()

def collectionTypes(): Bool =
  rejects("def wrong(): List[Int] = [1, \"x\"]", "list element") && rejects("def wrong(): List[Int] = [1, missing]", "unbound") && rejects("def wrong(): List[Int] = List.concat([1], [\"x\"])", "arg type mismatch") && rejects("def wrong(): List[String] = List.map([1], x => x + 1)", "does not match declared") && listFilterTypes()

def userTypeArgs(): Bool =
  rejects("def choose[A](x: A, y: A): A = x\ndef wrong(): Int = choose(1, \"x\")", "arg type mismatch") && Check.check("""def choose[A](x: A, y: A): A = x
def right(): Int = choose(1, 2)""") == "[]" && rejects("""def identity[A](x: A): A = x
def wrong(): String = identity(1)""", "does not match declared")

def listFilterTypes(): Bool =
  Check.check("def right(): List[String] = List.filter([\"a\", \"\"], x => Str.len(x) > 0)") == "[]" && rejects("def wrong(): List[Int] = List.filter([\"a\"], x => true)", "does not match declared") && rejects("def wrong(): List[String] = List.filter([\"a\"], n => n > 0)", "ordered compare") && Check.check("def right(): List[Int] = List.take([1, 2, 3], 2)") == "[]" && rejects("def wrong(): List[Int] = List.take([\"a\"], 1)", "does not match declared") && Check.check("def right(): List[String] = List.takeWhile([\"a\", \"\"], x => Str.len(x) > 0)") == "[]" && Check.check("def right(): List[String] = List.dropRight([\"a\", \"b\"], 1)") == "[]"

def dumpListFilter(): String =
  if (!rejects("def wrong(): List[Int] = [1, \"x\"]", "list element")) "listElem" else if (!rejects("def wrong(): List[Int] = List.concat([1], [\"x\"])", "arg type mismatch")) "listConcat" else if (!rejects("def wrong(): List[String] = List.map([1], x => x + 1)", "does not match declared")) "listMap" else if (Check.check("def right(): List[String] = List.filter([\"a\", \"\"], x => Str.len(x) > 0)") != "[]") Str.concat("filterOk ", Check.check("def right(): List[String] = List.filter([\"a\", \"\"], x => Str.len(x) > 0)")) else if (!rejects("def wrong(): List[Int] = List.filter([\"a\"], x => true)", "does not match declared")) Str.concat("filterMis ", Check.check("def wrong(): List[Int] = List.filter([\"a\"], x => true)")) else if (!rejects("def wrong(): List[String] = List.filter([\"a\"], n => n > 0)", "ordered compare")) Str.concat("filterPred ", Check.check("def wrong(): List[String] = List.filter([\"a\"], n => n > 0)")) else if (Check.check("def right(): List[Int] = List.take([1, 2, 3], 2)") != "[]") Str.concat("takeOk ", Check.check("def right(): List[Int] = List.take([1, 2, 3], 2)")) else if (!rejects("def wrong(): List[Int] = List.take([\"a\"], 1)", "does not match declared")) Str.concat("takeMis ", Check.check("def wrong(): List[Int] = List.take([\"a\"], 1)")) else "listFilter-other"

def streamTypes(): Bool =
  Check.check("def right(): IO[List[String]] = Stream.compileToList(Stream.emit(\"x\"))") == "[]" && rejects("def wrong(): IO[List[Int]] = Stream.compileToList(Stream.emit(\"x\"))", "does not match declared") && Check.check("def right(): IO[String] = Stream.head(Stream.emit(\"x\"))") == "[]" && rejects("def wrong(): IO[Int] = Stream.head(Stream.emit(\"x\"))", "does not match declared") && Check.check("def right(): IO[List[String]] = Stream.compileToList(Stream.filter(Stream.emits([\"a\", \"\"]), x => Str.len(x) > 0))") == "[]" && rejects("def wrong(): IO[List[String]] = Stream.compileToList(Stream.filter(Stream.emits([\"a\"]), n => n > 0))", "ordered compare") && Check.check("def right(): IO[List[Int]] = Stream.compileToList(Stream.map(Stream.emits([1, 2]), n => n + 1))") == "[]" && rejects("def wrong(): IO[List[String]] = Stream.compileToList(Stream.map(Stream.emits([1, 2]), n => n + 1))", "does not match declared") && rejects("def wrong(): IO[List[Int]] = Stream.compileToList(Stream.concat(Stream.emit(1), Stream.emit(\"x\")))", "arg type mismatch")

def dumpStream(): String =
  if (Check.check("def right(): IO[List[String]] = Stream.compileToList(Stream.emit(\"x\"))") != "[]") Str.concat("emitOk ", Check.check("def right(): IO[List[String]] = Stream.compileToList(Stream.emit(\"x\"))")) else if (!rejects("def wrong(): IO[List[Int]] = Stream.compileToList(Stream.emit(\"x\"))", "does not match declared")) Str.concat("emitMis ", Check.check("def wrong(): IO[List[Int]] = Stream.compileToList(Stream.emit(\"x\"))")) else if (Check.check("def right(): IO[String] = Stream.head(Stream.emit(\"x\"))") != "[]") Str.concat("headOk ", Check.check("def right(): IO[String] = Stream.head(Stream.emit(\"x\"))")) else if (!rejects("def wrong(): IO[Int] = Stream.head(Stream.emit(\"x\"))", "does not match declared")) Str.concat("headMis ", Check.check("def wrong(): IO[Int] = Stream.head(Stream.emit(\"x\"))")) else if (!rejects("def wrong(): IO[List[String]] = Stream.compileToList(Stream.filter(Stream.emits([\"a\"]), n => n > 0))", "ordered compare")) Str.concat("streamFilterPred ", Check.check("def wrong(): IO[List[String]] = Stream.compileToList(Stream.filter(Stream.emits([\"a\"]), n => n > 0))")) else if (!rejects("def wrong(): IO[List[String]] = Stream.compileToList(Stream.map(Stream.emits([1, 2]), n => n + 1))", "does not match declared")) Str.concat("streamMapMis ", Check.check("def wrong(): IO[List[String]] = Stream.compileToList(Stream.map(Stream.emits([1, 2]), n => n + 1))")) else if (!rejects("def wrong(): IO[List[Int]] = Stream.compileToList(Stream.concat(Stream.emit(1), Stream.emit(\"x\")))", "arg type mismatch")) Str.concat("streamConcatMis ", Check.check("def wrong(): IO[List[Int]] = Stream.compileToList(Stream.concat(Stream.emit(1), Stream.emit(\"x\")))")) else "stream-other"

def flattenTypes(): Bool =
  Check.check("def right(): List[String] = List.flatten([[\"a\", \"b\"], [\"c\"]])") == "[]" && rejects("def wrong(): List[Int] = List.flatten([[\"a\"]])", "does not match declared") && Check.check("def right(): List[String] = List.flatMap([\"a\"], x => [x, x])") == "[]" && rejects("def wrong(): List[Int] = List.flatMap([\"a\"], x => [x, x])", "does not match declared") && Check.check("def right(): IO[List[String]] = Stream.compileToList(Stream.flatten(Stream.emits([[\"a\", \"b\"], [\"c\"]])))") == "[]" && rejects("def wrong(): IO[List[Int]] = Stream.compileToList(Stream.flatten(Stream.emits([[\"a\"]])))", "does not match declared") && Check.check("def right(): IO[List[String]] = Stream.compileToList(Stream.flatMap(Stream.emits([\"a\"]), x => Stream.emit(x)))") == "[]" && rejects("def wrong(): IO[List[Int]] = Stream.compileToList(Stream.flatMap(Stream.emits([\"a\"]), x => Stream.emit(x)))", "does not match declared") && Check.check("def right(): IO[List[List[String]]] = Stream.compileToList(Stream.grouped(Stream.emits([\"a\", \"b\", \"c\"]), 2))") == "[]" && rejects("def wrong(): IO[List[String]] = Stream.compileToList(Stream.grouped(Stream.emits([\"a\", \"b\", \"c\"]), 2))", "does not match declared")

def dumpFlatten(): String =
