def srcIoFunApply(): String =
  """def apply(h: IO[Int] => String, io: IO[Int]): String =
  h(io)
"""

def srcIoFunMap(): String =
  """def wrong(h: IO[Int] => String): IO[Int] =
  h.map(n => n + 1)
"""

def srcIoFunFlat(): String =
  """def wrong(h: IO[Int] => String): IO[Int] =
  h.flatMap(n => IO.pure(n))
"""

def srcIoFunHandle(): String =
  """def wrong(h: IO[Int] => String): IO[Int] =
  h.handleErrorWith(e => IO.pure(0))
"""

def srcIoFunResMake(): String =
  """def wrong(h: IO[Int] => String): Resource[Int] =
  Resource.make(h, _ => IO.pure(()))
"""

def srcIoFunResUse(): String =
  """def wrong(h: Resource[Int] => String): IO[String] =
  Resource.use(h, n => IO.pure(Str.fromInt(n)))
"""

def signalTypes(): Bool =
  Check.check("""record State(n: Int)
def right(): Signal[String] = Signal.map(Signal.make(State(1)), s => Str.fromInt(s.n))""") == "[]" && rejects("def wrong(s: Signal[Int]): Unit = Signal.set(s, \"x\")", "type mismatch") && rejects("def wrong(s: Signal[Int]): Signal[String] = Signal.map(s, n => n + 1)", "does not match declared") && rejects("def wrong(s: Signal[Int]): Signal[Int] = Signal.map(s, (n: String) => Str.len(n))", "type mismatch")

def attemptTypes(): Bool =
  Type.show(Type.ioErr(Type.parse("IO[Result[Int, String]]"))) == "String" && Type.show(Type.ioOk(Type.parse("IO[Result[Int, String]]"))) == "Result[Int, String]" && Check.check("def right(io: IO[Int, String]): IO[Result[Int, String]] = IO.attempt(io)") == "[]" && rejects("def wrong(io: IO[Int, String]): IO[Result[String, String]] = IO.attempt(io)", "does not match declared") && rejects("def wrong(): IO[Result[Int, String]] = IO.attempt(3)", "type mismatch")

def kitLookup(): Bool =
  List.forall(Kits.allKits(), kit => Kits.find(kit.name) == kit) && !Kits.has("Missing.name") && Kits.ret("IO.timeout") == "IO[E, A]" && Kits.ret("IO.both") == "IO[E, (A, B)]" && Kits.ret("Fiber.join") == "IO[A]" && Kits.ret("Ref.of") == "IO[Ref[A]]" && Kits.ret("Ref.get") == "IO[A]" && Kits.ret("Fiber.interrupt") == "IO[Unit]" && Kits.ret("List.filter") == "List[A]" && Kits.ret("List.take") == "List[A]" && Kits.ret("Stream.emit") == "Stream[A]" && Kits.ret("Stream.compileToList") == "IO[List[A]]" && Kits.ret("Stream.flatten") == "Stream[A]" && Kits.ret("List.flatten") == "List[A]" && Kits.ret("List.foldLeft") == "B" && Kits.ret("Stream.fold") == "IO[B]" && Kits.ret("Map.set") == "Map[A, B]" && Kits.ret("Set.add") == "Set[A]" && Kits.ret("List.zip") == "List[(A, B)]" && Kits.ret("Stream.zip") == "Stream[(A, B)]" && Kits.ret("Stream.unfold") == "Stream[A]" && Kits.ret("Stream.iterate") == "Stream[A]" && Kits.ret("List.fill") == "List[A]" && Kits.ret("List.grouped") == "List[List[A]]" && Kits.ret("Map.keys") == "List[A]" && Kits.ret("Map.mapValues") == "Map[A, C]" && Kits.ret("Stream.zipWith") == "Stream[C]" && Kits.ret("List.init") == "List[A]" && Kits.ret("List.toSet") == "Set[A]" && Kits.ret("List.groupBy") == "Map[B, List[A]]" && Kits.ret("Stream.interleave") == "Stream[A]" && Kits.ret("Stream.evalTap") == "Stream[A]" && Kits.ret("Stream.takeRight") == "Stream[A]" && Kits.ret("List.inits") == "List[List[A]]" && Kits.ret("List.sort") == "List[A]" && Kits.ret("List.max") == "A" && Kits.ret("List.toMap") == "Map[A, B]" && Kits.ret("List.setAt") == "List[A]" && Kits.ret("List.diff") == "List[A]" && Kits.ret("List.span") == "List[List[A]]" && Kits.ret("List.transpose") == "List[List[A]]" && Kits.ret("List.splitAt") == "List[List[A]]" && Kits.ret("List.slice") == "List[A]" && Kits.ret("List.patch") == "List[A]" && Kits.ret("List.indexOfSlice") == "Int" && Kits.ret("Set.union") == "Set[A]" && Kits.ret("Set.intersect") == "Set[A]" && Kits.ret("Set.diff") == "Set[A]" && Kits.ret("Stream.changes") == "Stream[A]" && Kits.ret("Stream.exists") == "IO[Bool]" && Kits.ret("List.find") == "List[A]" && Kits.ret("List.exists") == "Bool" && Kits.ret("Map.exists") == "Bool" && Kits.ret("Set.exists") == "Bool" && Kits.ret("List.sum") == "Int" && Kits.ret("List.product") == "Int" && Kits.ret("Json.keys") == "List[String]" && Kits.ret("Json.arr") == "List[Json]" && Kits.ret("Json.get") == "List[Json]" && Kits.ret("Json.at") == "List[Json]" && Kits.ret("Json.pairs") == "List[(String, Json)]" && Kits.ret("Json.asInt") == "List[Int]" && List.at(Kits.kitParamsOf(Kits.find("Ui.setEditorDiagnostics")), 0) == "List[(Int, Int)]" && List.at(Kits.kitParamsOf(Kits.find("Ui.setEditorTokens")), 0) == "List[Int]" && List.at(Kits.kitParamsOf(Kits.find("Ui.setEditorInlays")), 0) == "List[(Int, Int, String)]" && List.at(Kits.kitParamsOf(Kits.find("Ui.setEditorFolds")), 0) == "List[(Int, Int)]" && Kits.ret("Property.force") == "A" && List.at(Kits.kitParamsOf(Kits.find("Property.force")), 0) == "IO[A]"

def ioCombinators(): Bool =
  Check.check("def right(): IO[String] = IO.timeout(50, IO.pure(\"x\"))") == "[]" && rejects("def wrong(): IO[Int] = IO.timeout(50, IO.pure(\"x\"))", "does not match declared") && Check.check("def right(): IO[Int] = IO.race(IO.pure(1), IO.pure(2))") == "[]" && rejects("def wrong(): IO[Int] = IO.race(IO.pure(1), IO.pure(\"x\"))", "arg type mismatch") && Check.check("def right(): IO[(Int, String)] = IO.both(IO.pure(1), IO.pure(\"x\"))") == "[]" && rejects("def wrong(): IO[String] = IO.both(IO.pure(1), IO.pure(\"x\"))", "does not match declared") && Check.check("def right(): IO[String] = IO.ensure(IO.pure(\"x\"), IO.pure(()))") == "[]" && Check.check("def right(): IO[List[String]] = IO.foreach([\"a\"], x => IO.pure(Str.concat(x, \"!\")))") == "[]" && rejects("def wrong(): IO[List[Int]] = IO.foreach([\"a\"], x => IO.pure(Str.concat(x, \"!\")))", "does not match declared") && Check.check("def right(): IO[Fiber[String]] = Fiber.fork(IO.pure(\"x\"))") == "[]" && rejects("def wrong(): IO[Fiber[Int]] = Fiber.fork(IO.pure(\"x\"))", "does not match declared") && bothUnpack() && fiberJoin() && refTypes() && queueHandleTypes()

def bothUnpack(): Bool =
  Check.check("def right(): IO[Unit] =\n  for {\n    (_, s) <- IO.both(IO.pure(1), IO.pure(\"x\"))\n    _ <- IO.println(s)\n  } yield ()\n") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    (_, n) <- IO.both(IO.pure(1), IO.pure(\"x\"))\n    _ <- IO.println(Str.fromInt(n))\n  } yield ()\n", "type mismatch")

def fiberJoin(): Bool =
  Check.check("def right(): IO[Unit] =\n  for {\n    f <- Fiber.fork(IO.pure(\"x\"))\n    s <- Fiber.join(f)\n    _ <- IO.println(s)\n  } yield ()\n") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    f <- Fiber.fork(IO.pure(\"x\"))\n    n <- Fiber.join(f)\n    _ <- IO.println(Str.fromInt(n))\n  } yield ()\n", "type mismatch")

def refTypes(): Bool =
  Check.check("def right(): IO[Ref[String]] = Ref.of(\"x\")") == "[]" && rejects("def wrong(): IO[Ref[Int]] = Ref.of(\"x\")", "does not match declared") && Check.check("""def right(): IO[Int] =
  for {
    r <- Ref.of(1)
    n <- Ref.get(r)
  } yield n
""") == "[]" && rejects("""def wrong(): IO[String] =
  for {
    r <- Ref.of(1)
    s <- Ref.get(r)
  } yield s
""", "does not match declared") && Check.check("def right(): IO[Unit] =\n  for {\n    r <- Ref.of(\"x\")\n    _ <- Ref.set(r, \"y\")\n    s <- Ref.get(r)\n    _ <- IO.println(s)\n  } yield ()\n") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    r <- Ref.of(\"x\")\n    _ <- Ref.set(r, 1)\n  } yield ()\n", "type mismatch") && Check.check("""def right(): IO[Int] =
  for {
    r <- Ref.of(0)
    _ <- Ref.update(r, n => n + 1)
    n <- Ref.updateAndGet(r, n => n + 1)
  } yield n
""") == "[]" && rejects("""def wrong(): IO[Unit] =
  for {
    r <- Ref.of(0)
    _ <- Ref.update(r, n => Str.fromInt(n))
  } yield ()
""", "arg type mismatch")

def queueHandleTypes(): Bool =
  Check.check("""def right(): IO[Unit] =
  for {
    q <- Queue.unbounded()
    _ <- Queue.offer(q, 1)
    n <- Queue.take(q)
    _ <- IO.println(Str.fromInt(n))
  } yield ()
""") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    q <- Queue.unbounded()\n    _ <- Queue.offer(q, 1)\n    _ <- Queue.offer(q, \"x\")\n  } yield ()\n", "arg type mismatch") && Check.check("""def right(): IO[Unit] =
  for {
    d <- Deferred.empty()
    _ <- Deferred.complete(d, 1)
    n <- Deferred.get(d)
    _ <- IO.println(Str.fromInt(n))
  } yield ()
""") == "[]" && rejects("def wrong(): IO[Unit] =\n  for {\n    d <- Deferred.empty()\n    _ <- Deferred.complete(d, 1)\n    _ <- Deferred.complete(d, \"x\")\n  } yield ()\n", "arg type mismatch")

def dumpQueueHandle(): String =
  if (Check.check("""def right(): IO[Unit] =
  for {
    q <- Queue.unbounded()
    _ <- Queue.offer(q, 1)
    n <- Queue.take(q)
    _ <- IO.println(Str.fromInt(n))
  } yield ()
""") != "[]") Str.concat("queueOfferOk ", Check.check("""def right(): IO[Unit] =
  for {
    q <- Queue.unbounded()
    _ <- Queue.offer(q, 1)
    n <- Queue.take(q)
    _ <- IO.println(Str.fromInt(n))
  } yield ()
""")) else if (!rejects("def wrong(): IO[Unit] =\n  for {\n    q <- Queue.unbounded()\n    _ <- Queue.offer(q, 1)\n    _ <- Queue.offer(q, \"x\")\n  } yield ()\n", "arg type mismatch")) Str.concat("queueOfferMis ", Check.check("def wrong(): IO[Unit] =\n  for {\n    q <- Queue.unbounded()\n    _ <- Queue.offer(q, 1)\n    _ <- Queue.offer(q, \"x\")\n  } yield ()\n")) else if (Check.check("""def right(): IO[Unit] =
  for {
    d <- Deferred.empty()
    _ <- Deferred.complete(d, 1)
    n <- Deferred.get(d)
    _ <- IO.println(Str.fromInt(n))
  } yield ()
""") != "[]") Str.concat("defCompleteOk ", Check.check("""def right(): IO[Unit] =
  for {
    d <- Deferred.empty()
    _ <- Deferred.complete(d, 1)
    n <- Deferred.get(d)
    _ <- IO.println(Str.fromInt(n))
  } yield ()
""")) else if (!rejects("def wrong(): IO[Unit] =\n  for {\n    d <- Deferred.empty()\n    _ <- Deferred.complete(d, 1)\n    _ <- Deferred.complete(d, \"x\")\n  } yield ()\n", "arg type mismatch")) Str.concat("defCompleteMis ", Check.check("def wrong(): IO[Unit] =\n  for {\n    d <- Deferred.empty()\n    _ <- Deferred.complete(d, 1)\n    _ <- Deferred.complete(d, \"x\")\n  } yield ()\n")) else "queueHandle-other"

def dumpRef(): String =
  if (Check.check("def right(): IO[Ref[String]] = Ref.of(\"x\")") != "[]") Str.concat("refOfOk ", Check.check("def right(): IO[Ref[String]] = Ref.of(\"x\")")) else if (!rejects("def wrong(): IO[Ref[Int]] = Ref.of(\"x\")", "does not match declared")) Str.concat("refOfMis ", Check.check("def wrong(): IO[Ref[Int]] = Ref.of(\"x\")")) else if (Check.check("""def right(): IO[Int] =
  for {
    r <- Ref.of(1)
    n <- Ref.get(r)
  } yield n
""") != "[]") Str.concat("refGetOk ", Check.check("""def right(): IO[Int] =
  for {
    r <- Ref.of(1)
    n <- Ref.get(r)
  } yield n
""")) else if (!rejects("""def wrong(): IO[String] =
  for {
    r <- Ref.of(1)
    s <- Ref.get(r)
  } yield s
""", "does not match declared")) Str.concat("refGetMis ", Check.check("""def wrong(): IO[String] =
  for {
    r <- Ref.of(1)
    s <- Ref.get(r)
  } yield s
""")) else if (Check.check("def right(): IO[Unit] =\n  for {\n    r <- Ref.of(\"x\")\n    _ <- Ref.set(r, \"y\")\n    s <- Ref.get(r)\n    _ <- IO.println(s)\n  } yield ()\n") != "[]") Str.concat("refSetOk ", Check.check("def right(): IO[Unit] =\n  for {\n    r <- Ref.of(\"x\")\n    _ <- Ref.set(r, \"y\")\n    s <- Ref.get(r)\n    _ <- IO.println(s)\n  } yield ()\n")) else if (!rejects("def wrong(): IO[Unit] =\n  for {\n    r <- Ref.of(\"x\")\n    _ <- Ref.set(r, 1)\n  } yield ()\n", "type mismatch")) Str.concat("refSetMis ", Check.check("def wrong(): IO[Unit] =\n  for {\n    r <- Ref.of(\"x\")\n    _ <- Ref.set(r, 1)\n  } yield ()\n")) else if (Check.check("""def right(): IO[Int] =
  for {
    r <- Ref.of(0)
    _ <- Ref.update(r, n => n + 1)
    n <- Ref.updateAndGet(r, n => n + 1)
  } yield n
""") != "[]") Str.concat("refUpdateOk ", Check.check("""def right(): IO[Int] =
  for {
    r <- Ref.of(0)
    _ <- Ref.update(r, n => n + 1)
    n <- Ref.updateAndGet(r, n => n + 1)
  } yield n
""")) else if (!rejects("""def wrong(): IO[Unit] =
  for {
    r <- Ref.of(0)
    _ <- Ref.update(r, n => Str.fromInt(n))
  } yield ()
""", "arg type mismatch")) Str.concat("refUpdateMis ", Check.check("""def wrong(): IO[Unit] =
  for {
    r <- Ref.of(0)
    _ <- Ref.update(r, n => Str.fromInt(n))
  } yield ()
""")) else "ioComb-other"

def resultTypes(): Bool =
  Check.check("def right(): Result[String, Int] = Result.Ok(1)") == "[]" && rejects("def wrong(): Result[String, Int] = Result.Ok(true)", "does not match declared") && Check.check("""record Problem(code: Int)
def value(r: Result[Problem, Int]): Int = r match {
  case Result.Err(e) => e.code
  case Result.Ok(n) => n
}""") == "[]" && rejects("""def wrong(r: Result[Int, String]): Int = r match {
  case Result.Err(e) => Str.len(e)
  case Result.Ok(s) => Str.len(s)
}""", "type mismatch")

def unaryNumTypes(): Bool =
  Check.check("def right(): Float = -1.5") == "[]" && Check.check("def right(n: Float): Float = -n") == "[]" && Check.check("def right(): Int = -1") == "[]" && rejects("def wrong(): Bool = -true", "expected Int or Float, got Bool")

def lambdaApplyTypes(): Bool =
  rejects("@main def main: IO[Unit] =\n  for {\n    f = (n => n + 1)\n    _ <- IO.println(Str.fromInt(f(\"s\")))\n  } yield ()\n", "arithmetic needs Int or Float, got String and Int") && Check.check("""@main def main: IO[Unit] =
  for {
    f = ((n: Int) => n + 1)
    _ <- IO.println(Str.fromInt(f(1)))
  } yield ()
""") == "[]" && rejects("@main def main: IO[Unit] =\n  for {\n    f = ((n: Int) => n + 1)\n    _ <- IO.println(Str.fromInt(f(\"s\")))\n  } yield ()\n", "apply arg type mismatch: expected Int, got String") && Check.check("""@main def main: IO[Unit] =
  for {
    f = (n => n)
    _ <- IO.println(Str.fromInt(f(1)))
  } yield ()
""") == "[]" && Check.check("@main def main: IO[Unit] =\n  for {\n    f = ((n: String) => n)\n    _ <- IO.println(f(\"s\"))\n  } yield ()\n") == "[]" && Check.check("def right(): Int = (n => n + 1)(1)") == "[]" && rejects("def wrong(): Int = (n => n + 1)(\"s\")", "arithmetic needs Int or Float") && lamPinTypes()

def lamPinTypes(): Bool =
  Check.check("""@main def main: IO[Unit] =
  for {
    f = (n => n)
    g = m => f(m)
    _ <- IO.println(Str.fromInt(f(1)))
  } yield ()
""") == "[]" && rejects("@main def main: IO[Unit] =\n  for {\n    f = (n => n)\n    _ <- IO.println(Str.fromInt(f(1)))\n    _ <- IO.println(f(\"s\"))\n  } yield ()\n", "apply arg type mismatch: expected Int, got String") && Check.check("@main def main: IO[Unit] =\n  for {\n    f = (n => n)\n    f = \"s\"\n    _ <- IO.println(f)\n  } yield ()\n") == "[]" && Check.check("@main def main: IO[Unit] =\n  for {\n    f = (n => n)\n    g = f => Str.concat(f, \"x\")\n    _ <- IO.println(g(\"a\"))\n  } yield ()\n") == "[]" && lamPinTypes2()

def lamPinTypes2(): Bool =
  Check.check("""@main def main: IO[Unit] =
  for {
    f = n => n + 1
    _ <- IO.foreach([1, 2], x => IO.println(Str.fromInt(f(x))))
  } yield ()
""") == "[]" && Check.check("@main def main: IO[Unit] =\n  for {\n    f = (p => p)\n    t = f(1, \"s\")\n    _ <- IO.println(t._2)\n  } yield ()\n") == "[]" && Check.check("""@main def main: IO[Unit] =
  for {
    f = (n => n)
    _ <- IO.println(Str.fromInt(f.apply(7)))
  } yield ()
""") == "[]" && rejects("@main def main: IO[Unit] =\n  for {\n    f = (n => List.isEmpty(n))\n    _ <- IO.println(if (f([1])) \"e\" else \"n\")\n    _ <- IO.println(if (f([\"s\"])) \"e\" else \"n\")\n  } yield ()\n", "apply arg type mismatch: expected List[Int], got List[String]") && lamPinTypes3()

def lamPinTypes3(): Bool =
  Check.check("""@main def main: IO[Unit] =
  for {
    f = (n => n)
    g = f
    h = g
    _ <- IO.println(Str.fromInt(h(1)))
  } yield ()
""") == "[]" && rejects("@main def main: IO[Unit] =\n  for {\n    f = (n => n)\n    g = f\n    _ <- IO.println(Str.fromInt(g(1)))\n    _ <- IO.println(g(\"s\"))\n  } yield ()\n", "apply arg type mismatch: expected Int, got String") && Check.check("def use[A](x: A): IO[Unit] =\n  for {\n    f = (n => n)\n    y = f(x)\n    _ <- IO.println(\"x\")\n  } yield ()\n") == "[]" && Check.check("@main def main: IO[Unit] =\n  for {\n    f = (n => Str.concat(n, \"!\"))\n    _ <- IO.println(if (true) f(\"a\") else f(\"b\"))\n    x = 1\n    _ <- IO.println(x match {\n      case 1 => f(\"c\")\n      case _ => \"d\"\n    })\n  } yield ()\n") == "[]"

def nestedPatTypes(): Bool =
  Check.check("""enum Inner:
  case Good(v: Int)
enum Outer:
  case Wrap(a: Inner, b: Int)
def right(o: Outer): Int = o match {
  case Outer.Wrap(Inner.Good(n), b) => n
  case _ => 0
}""") == "[]" && Check.check("""enum Box2:
  case P(p: (Int, Int))
def right(b: Box2): Int = b match {
  case Box2.P((n, m)) => n + m
  case _ => 0
}""") == "[]" && Check.check("""def right(p: (Result[String, Int], Int)): Int = p match {
  case (Result.Ok(n), m) => n + m
  case _ => 0
}""") == "[]" && Check.check("""def right(p: (List[Int], Int)): Int = p match {
  case (x :: _, n) => x + n
  case _ => 0
}""") == "[]" && Check.check("""enum Opt:
  case Some(value: Int)
  case None
def right(o: Opt): Int = o match {
  case Opt.Some(n @ 0) => n
  case _ => 0
}""") == "[]" && Check.check("""enum Opt:
  case Some(value: Int)
  case None
enum W:
  case V(o: Opt, n: Int)
def right(w: W): Int = w match {
  case W.V(Opt.None, _) => 100
  case _ => 0
}""") == "[]" && Check.check("""enum W:
  case V(n: Int, m: Int)
def right(w: W): Int = w match {
  case W.V(1, _) => 1
  case _ => 0
}""") == "[]" && Check.check("""enum BoxL:
  case L(xs: List[Int])
def right(b: BoxL): Int = b match {
  case BoxL.L(x :: _) => x
  case BoxL.L(_) => 0
}""") == "[]" && Check.check("""enum Opt:
  case Some(value: Int)
  case None
def right(o: Opt): Int = o match {
  case Opt.Some(0) => 100
  case Opt.Some(n) => n
  case Opt.None => 0 - 1
}""") == "[]" && Check.check("""def right(p: ((Int, Int), Int)): Int = p match {
  case ((1, _), n) => n
  case ((a, b), n) => a + b + n
}""") == "[]" && Check.check("""enum BoxL:
  case L(xs: List[Int])
def right(b: BoxL): Int = b match {
  case BoxL.L([]) => 1
  case _ => 0
}""") == "[]"

def queueRefineTypes(): Bool =
  Check.check("""@main def main: IO[Unit] =
  for {
    q <- Queue.unbounded()
    _ <- IO.both(Queue.offer(q, 1), IO.pure(()))
    n <- Queue.take(q)
    _ <- IO.println(Str.fromInt(n))
  } yield ()
""") == "[]" && rejects("""@main def main: IO[Unit] =
  for {
    q <- Queue.unbounded()
    _ <- IO.both(Queue.offer(q, 1), IO.pure(()))
    s <- Queue.take(q)
    _ <- IO.println(s)
  } yield ()
""", "expected String, got Int") && rejects("""@main def main: IO[Unit] =
  for {
    q <- Queue.unbounded()
    _ <- IO.foreach([1], x => Queue.offer(q, 2))
    s <- Queue.take(q)
    _ <- IO.println(s)
  } yield ()
""", "expected String, got Int") && Check.check("""@main def main: IO[Unit] =
  for {
    q <- Queue.unbounded()
    _ <- IO.foreach([1], x => Queue.offer(q, 2))
    n <- Queue.take(q)
    _ <- IO.println(Str.fromInt(n))
  } yield ()
""") == "[]" && rejects("@main def main: IO[Unit] =\n  for {\n    d <- Deferred.empty()\n    _ <- IO.both(Deferred.complete(d, \"x\"), IO.pure(()))\n    n <- Deferred.get(d)\n    _ <- IO.println(Str.fromInt(n + 1))\n  } yield ()\n", "arithmetic needs Int or Float") && Check.check("""@main def main: IO[Unit] =
  for {
    q <- Queue.unbounded()
    _ <- if (true) Queue.offer(q, 1) else IO.pure(())
    n <- Queue.take(q)
    _ <- IO.println(Str.fromInt(n))
  } yield ()
""") == "[]"

def queueLambdaPinTypes(): Bool =
  Check.check("""@main def main: IO[Unit] =
  for {
    q <- Queue.unbounded()
    _ <- IO.foreach([q], x => Queue.offer(x, 1))
    n <- Queue.take(q)
    _ <- IO.println(Str.fromInt(n))
  } yield ()
""") == "[]" && rejects("""@main def main: IO[Unit] =
  for {
    q <- Queue.unbounded()
    _ <- IO.foreach([q], x => Queue.offer(x, 1))
    s <- Queue.take(q)
    _ <- IO.println(s)
  } yield ()
""", "expected String, got Int") && Check.check("""@main def main: IO[Unit] =
  for {
    q <- Queue.unbounded()
    _ <- [q].map(x => Queue.offer(x, 1))
    n <- Queue.take(q)
    _ <- IO.println(Str.fromInt(n))
  } yield ()
""") == "[]" && rejects("""@main def main: IO[Unit] =
  for {
    q <- Queue.unbounded()
    _ <- [q].map(x => Queue.offer(x, 1))
    s <- Queue.take(q)
    _ <- IO.println(s)
  } yield ()
""", "expected String, got Int") && Check.check("""@main def main: IO[Unit] =
  for {
    d <- Deferred.empty()
    _ <- IO.foreachDiscard([d], x => Deferred.complete(x, 1))
    n <- Deferred.get(d)
    _ <- IO.println(Str.fromInt(n))
  } yield ()
""") == "[]" && rejects("""@main def main: IO[Unit] =
  for {
    d <- Deferred.empty()
    _ <- IO.foreach([d], x => Deferred.complete(x, 1))
    s <- Deferred.get(d)
    _ <- IO.println(s)
  } yield ()
""", "expected String, got Int")

def emptyCtorTypes(): Bool =
  Check.check("def right(): Map[String, Int] = Map.set(Map.empty(), \"a\", 1)") == "[]" && rejects("def wrong(): Map[String, String] = Map.set(Map.empty(), \"a\", 1)", "does not match declared") && Check.check("def right(m: Map[String, Int]): Map[String, Int] = Map.set(m, \"b\", 2)") == "[]" && rejects("def wrong(m: Map[String, Int]): Map[String, Int] = Map.set(m, 1, 2)", "Map.set arg type mismatch: expected String, got Int") && rejects("def wrong(m: Map[String, Int]): Map[String, Int] = Map.set(m, \"b\", \"x\")", "Map.set arg type mismatch: expected Int, got String") && Check.check("def right(m: Map[String, Int]): Option[Int] = Map.get(m, \"k\")") == "[]" && rejects("def wrong(m: Map[String, Int]): Option[Int] = Map.get(m, 1)", "Map.get arg type mismatch: expected String, got Int") && Check.check("def right(m: Map[String, Int]): Int = Map.getOrElse(m, \"k\", 0)") == "[]" && rejects("def wrong(m: Map[String, Int]): Int = Map.getOrElse(m, \"k\", \"x\")", "Map.getOrElse arg type mismatch: expected Int, got String") && Check.check("def right(): Set[Int] = Set.add(Set.empty(), 1)") == "[]" && rejects("def wrong(): Set[String] = Set.add(Set.empty(), 1)", "does not match declared") && rejects("def wrong(s: Set[Int]): Bool = Set.contains(s, \"x\")", "Set.contains arg type mismatch: expected Int, got String") && rejects("def wrong(a: Set[Int], b: Set[String]): Set[Int] = Set.union(a, b)", "Set.union arg type mismatch: expected Set[Int], got Set[String]") && Check.check("def right(xs: List[Int]): List[Int] = List.cons(1, xs)") == "[]" && rejects("def wrong(xs: List[Int]): List[String] = List.cons(\"s\", xs)", "List.cons arg type mismatch: expected List[String], got List[Int]") && Check.check("def right(): List[Int] = List.cons(1, List.empty())") == "[]"

def matchArmTypes(): Bool =
  Check.check("""enum E:
  case A
  case B
def right(e: E): Int = e match {
  case E.A => 1
  case E.B => 2
}""") == "[]" && rejects("enum E:\n  case A\n  case B\ndef wrong(e: E): Int = e match {\n  case E.A => 1\n  case E.B => \"x\"\n}", "type mismatch: expected Int, got String") && rejects("""enum E:
  case A
  case B
def wrong(e: E): Int = e match {
  case E.A => 1
  case E.B => nope
}""", "unbound variable nope")

def expectedLamTypes(): Bool =
  Check.check("""def apply(f: Int => String): String = f(1)
def right(): String = apply(n => Str.fromInt(n))
@main def main: IO[Unit] = IO.println(right())
""") == "[]" && rejects("""def apply(f: Int => String): String = f(1)
def wrong(): String = apply(n => n)
""", "apply arg type mismatch: expected Int => String, got Int => Int") && Check.check("""def apply(f: Int => String): String = f(1)
def right(): String = apply((n: Int) => Str.fromInt(n))
""") == "[]" && rejects("""def apply(f: Int => String): String = f(1)
def wrong(): String = apply((s: String) => s)
""", "lambda arg type mismatch: expected Int, got String") && Check.check("""def applyBoth(f: Int => Int, g: String => String): Int = f(1)
def right(): Int = applyBoth(n => n + 1, s => s)
""") == "[]" && rejects("""def applyBoth(f: Int => Int, g: String => String): Int = f(1)
def wrong(): Int = applyBoth(n => n + 1, s => 1)
""", "applyBoth arg type mismatch: expected String => String, got String => Int") && Check.check("def right(): Int => String = n => Str.fromInt(n)") == "[]" && rejects("def wrong(): Int => String = n => n", "def wrong body Int => Int does not match declared Int => String")

def funLookup(): Bool =
  funLookupDefs(Parse.parseFiles(("A", """def pick(n: Int): Int = n
def skip(): Int = 0
def pick(s: String): String = s""") :: ("B", "def pick(): Bool = true") :: []).defs)

def funLookupDefs(defs: List[Fun]): Bool =
  List.map(Check.findFun(defs, "pick"), d => d.ret) == ["Int", "String", "Bool"] && List.map(Check.findFunMod(defs, "A", "pick"), d => d.ret) == ["Int", "String"] && List.map(Check.ftabGetMod(Check.ftabOf(defs), "A", "pick"), d => d.ret) == ["Int", "String"] && List.isEmpty(Check.findFun(defs, "missing")) && List.isEmpty(Check.findFunMod(defs, "missing", "pick")) && List.isEmpty(Check.ftabGetMod(Check.ftabOf(defs), "missing", "pick"))

def sourceOffSrc(): String =
  """aé

雪r
z"""

def sourceOffsets(): Bool =
  List.map(List.range(0, 8), off => Check.lineCol(sourceOffSrc(), off)) == [(1, 1), (1, 2), (1, 3), (2, 1), (3, 1), (3, 2), (3, 3), (4, 1)] && Check.lineCol("", 0) == (1, 1) && Check.lineCol("a", 5) == (1, 2) && Check.lineIndex(sourceOffSrc()) == [0, 3, 4, 7] && Check.lineIndex("") == [0] && Check.lineIndex("a") == [0] && Check.startsOf(Check.fileIndex(("Main", sourceOffSrc()) :: []), "Main") == [0, 3, 4, 7] && Check.startsOf(Check.fileIndex(("Main", "a") :: []), "") == [0]

def factsSrc(): String =
  """oracle fact(): Bool =
  true

oracle gen(n: Int where n >= 0): Bool =
  n == n
"""

def factsTier(): Bool =
  Str.contains(Verify.seeds(factsSrc()), "drive fact") && Str.contains(Verify.seeds(factsSrc()), "drive gen ") && factsSearch(0) && factsSearch(1) && factsSearch(7) && Verify.generatedDrive(Verify.parseVerify("""oracle fact(): Bool =
  true
"""), Verify.noEn(), 0) == ""

def factsSearch(seed: Int): Bool =
  Str.startsWith(Verify.generatedDrive(Verify.parseVerify(factsSrc()), Verify.noEn(), seed), "drive gen ")

def pureForArguments(): Bool =
  Check.check("""def accept(b: Bool): Bool = b
def right(): Bool = accept(for { x = true } yield x)""") == "[]" && rejects("""def accept(b: Bool): Bool = b
def wrong(): Bool = accept(for { x = 1 } yield x)""", "expected Bool, got Int") && rejects("""def accept(b: Bool): Bool = b
def wrong(): Bool = accept(for { x <- IO.pure(true) } yield x)""", "expected Bool, got IO[Bool]")

def forBindTypes(): Bool =
  Check.check("""enum Opt:
  case Some(n: Int)
  case None

def right(o: Opt): Int =
  for {
    Opt.Some(n) = o
    (a, b) = (n, 1)
  } yield a + b
""") == "[]" && rejects("""enum Opt:
  case Some(n: Int)
  case None

def wrong(o: Opt): Int =
  for {
    Opt.Some(n) = o
  } yield Str.len(n)
""", "type mismatch")

def genericRecordFields(): Bool =
  Check.check("record Holder[A](item: A)\ndef right(): List[String] = List.flatMap([Holder([\"a\"])], holder => holder.item)") == "[]" && rejects("""record Holder[A](item: A)
def wrong(holder: Holder[String]): Int = holder.item""", "does not match declared") && Check.check("""record Holder[A](item: A)
def right(holder: Holder[Int]): Int = holder.item + 1""") == "[]"

@main def main: IO[Unit] =
  IO.println(if (allOk()) "tyck-ok" else Str.concat("tyck-bad ", dumpFail()))
