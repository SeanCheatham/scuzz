oracle internInterpLit(): Bool =
  Main.internInterpLit()

oracle viewEqShows(): Bool =
  Main.viewEqShows()

oracle rewriteInterpLit(): Bool =
  Main.rewriteInterpLit()

oracle internOrder(): Bool =
  Main.internOrder()

oracle irHi(): Bool =
  Main.irDiff(Main.srcHi(), Main.wantHi())

oracle irSum(): Bool =
  Main.irDiff(Main.srcSum(), Main.wantSum())

oracle irAdd(): Bool =
  Main.irDiff(Main.srcAdd(), Main.wantAdd())

oracle irCheckedHi(): Bool =
  Main.irChecked(Main.srcHi())

oracle irCheckedSum(): Bool =
  Main.irChecked(Main.srcSum())

oracle irCheckedAdd(): Bool =
  Main.irChecked(Main.srcAdd())

oracle irHello(): Bool =
  Main.irDiff(Main.srcHello(), Main.wantHello())

oracle irCheckedHello(): Bool =
  Main.irChecked(Main.srcHello())

oracle irFullHello(): Bool =
  Emit.emitFull(Main.srcHello()) == Str.concat(Emit.preamble(), Main.wantHello())

oracle generatedSeed(): Bool =
  Main.irGenerated(0)

oracle irGenerated(n: Int where n >= 0): Bool =
  Main.irGenerated(n)

oracle reloadCaptureOrder(): Bool =
  Main.reloadCaptureOrder()

oracle reloadCaptureType(): Bool =
  Main.reloadCaptureType()

oracle reloadRecordLayout(): Bool =
  Main.reloadRecordLayout()

oracle contInCtor(): Bool =
  Main.contInCtor()

oracle evAdd(): Bool =
  Main.evAdd()

oracle evTco(): Bool =
  Main.evTco()

oracle evTcoMatch(): Bool =
  Main.evTcoMatch()

oracle evGenerated(n: Int where n >= 0): Bool =
  Main.evGenerated(n)

oracle evMatch(): Bool =
  Main.evMatch()

oracle evKitsCovered(): Bool =
  Main.evKitsCovered()

oracle evLookup(): Bool =
  Main.evLookup()

oracle evMaps(): Bool =
  Main.evMapModel(0) && Main.evMapModel(1) && Main.evMapModel(2)

oracle evConstructors(): Bool =
  Main.evConstructors()

oracle evModules(seed: Int where seed >= 0 && seed < 6): Bool =
  Main.evModules(seed)

oracle evModule0(): Bool =
  Main.evModules(0)

oracle evModule1(): Bool =
  Main.evModules(1)

oracle evModule2(): Bool =
  Main.evModules(2)

oracle evModule3(): Bool =
  Main.evModules(3)

oracle evModule4(): Bool =
  Main.evModules(4)

oracle evModule5(): Bool =
  Main.evModules(5)

oracle boundCallback(): Bool =
  Main.irBoundCallback()

