@main def main: IO[Unit] =
  for {
    name = Signal.make("")
    updates = Signal.make(0)
    volume = Signal.make(50)
    temperature = Signal.make(-15)
    precise = Signal.make(9223372036854775806)
    plan = Signal.make(1)
    notes = Signal.make("")
    submitted = Signal.make(0)
    dialog = Signal.make(0)
    confirm = Signal.make(0)
    dialogName = Signal.make("")
    nameText = Signal.map(name, n => s"Name: $n")
    volumeText = Signal.map(volume, n => s"Volume: $n")
    completion = Signal.map(volume, n => n * 2 - 50)
    temperatureText = Signal.map(temperature, n => s"Temperature: $n °C")
    preciseText = Signal.map(precise, n => s"Precise count: $n")
    status = Signal.map(submitted, n => if (n == 0) "Ready" else "Submitted")
    _ <- Ui.run(_ => View.stack([View.expanded(1, View.scroll(View.column([View.textField(name, "Name"), View.bindText(nameText), View.checkbox(updates, "Updates"), View.slider(volume, "Volume", 0, 100, 1), View.bindText(volumeText), View.radioGroup("Plan", View.row([View.radio(plan, 1, "Basic"), View.radio(plan, 2, "Pro")])), View.editor(notes), View.button("Submit", _ => Signal.set(submitted, 1)), View.bindText(status), View.button("Open", _ => Signal.set(dialog, 1)), View.slider(temperature, "Temperature (°C)", -60, 120, 3), View.bindText(temperatureText), View.slider(precise, Str.concat("Precise ", "count"), 9223372036854775797, 9223372036854775807, 1), View.bindText(preciseText), View.progress(completion, "Linear completion"), View.circularProgress(completion, "Circular completion"), View.visibility(updates, View.progress(completion, "Optional completion")), View.excludeSemantics(View.progress(completion, "Private completion"))]))), View.overlay(dialog, "Edit details", View.stack([View.center(View.maxSize(480, 300, View.card(View.column([View.heading(2, View.text("Edit details")), View.text("Enter a name, then review the details."), View.textField(dialogName, "Dialog"), View.button("Review details", _ => Signal.set(confirm, 1)), View.button("Close", _ => Signal.set(dialog, 0))])))), View.overlay(confirm, "Confirm details", View.center(View.maxSize(400, 180, View.card(View.column([View.text("Check the name before you continue."), View.button("Back", _ => Signal.set(confirm, 0))])))))]))]))
  } yield ()
