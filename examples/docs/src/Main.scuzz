import Manual.Topic
import Manual.Block

def paragraph(text: String): View =
  View.padding(8, View.maxSize(760, 0, View.text(text)))

def code(text: String): View =
  View.code(text)

def blockView(b: Block): View =
  b match {
    case Block.Para(text) => paragraph(text)
    case Block.Code(text) => code(text)
    case Block.Cmd(text) => code(text)
  }

def stackViews(xs: List[View]): View =
  if (List.isEmpty(xs)) View.text("") else if (List.len(xs) == 1) List.at(xs, 0) else View.column(List.at(xs, 0), stackViews(List.tail(xs)))

def blocksColumn(xs: List[Block]): View =
  stackViews(List.map(xs, b => blockView(b)))

def liveCounter(count: Signal[Int]): View =
  View.column(View.heading(2, View.text("Try a Signal")), View.bindText(Signal.map(count, n => Str.concat("Count: ", Str.fromInt(n)))), View.wrap(View.button("Add one", _ => Signal.set(count, Signal.get(count) + 1)), View.outlinedButton("Reset", _ => Signal.set(count, 0))), paragraph("Choose a section in the index. The example keeps its state when you switch pages."))

def guiLive(tab: Signal[Int], draft: Signal[String], notes: Signal[String]): View =
  View.maxSize(0, 520, View.tabs(tab, View.column(View.section("live", "Live example", View.column(View.heading(2, View.text("Try text input")), paragraph("Type text, then switch tabs or sections. Your text stays in the Signals."), View.textField(draft, "Your text"), View.bindText(Signal.map(draft, text => Str.concat("You typed: ", text))), View.editor(notes), View.bindText(Signal.map(notes, text => Str.concat("Notes: ", text))))), View.section("source", "Source", code("@main def main: IO[Unit] =\n  for {\n    draft = Signal.make(\"\")\n    notes = Signal.make(\"\")\n    _ <- Ui.run(_ => View.column(\n      View.textField(draft, \"Your text\"),\n      View.bindText(Signal.map(draft, text =>\n        Str.concat(\"You typed: \" , text))),\n      View.editor(notes),\n      View.bindText(Signal.map(notes, text =>\n        Str.concat(\"Notes: \" , text)))))\n  } yield ()")))))

def topicAt(i: Int): Topic =
  List.at(Manual.topics(), i)

def titleAt(n: Int): String =
  if (n < 0 || n >= List.len(Manual.topics())) "Docs" else topicAt(n).title

def startSection(count: Signal[Int]): View =
  View.section(topicAt(0).id, topicAt(0).title, View.column(blocksColumn(topicAt(0).blocks), liveCounter(count)))

def guiSection(tab: Signal[Int], draft: Signal[String], notes: Signal[String]): View =
  View.section(topicAt(3).id, topicAt(3).title, View.column(blocksColumn(topicAt(3).blocks), guiLive(tab, draft, notes)))

def plainSection(i: Int): View =
  View.section(topicAt(i).id, topicAt(i).title, blocksColumn(topicAt(i).blocks))

@main def main: IO[Unit] =
  for {
    page = Signal.make(0)
    guiTab = Signal.make(0)
    title = Signal.map(page, n => titleAt(n))
    count = Signal.make(0)
    draft = Signal.make("")
    notes = Signal.make("")
    _ <- Ui.setTitle("Scuzz Docs")
    _ <- Ui.run(_ => View.appShell(View.appBar(View.bindText(title), View.wrap(View.textButton("Get started", _ => Signal.set(page, 1)), View.outlinedButton("Try GUI", _ => Signal.set(page, 3)))), View.indexBook(page, View.column(startSection(count), plainSection(1), plainSection(2), guiSection(guiTab, draft, notes), plainSection(4), plainSection(5), plainSection(6), plainSection(7), plainSection(8), plainSection(9), plainSection(10)))))
  } yield ()
