def mainStartsOnIntro(t: Timeline): Verdict =
  Verdict.every(t, i => i != 0 || Timeline.signalInt(t, i, "step") == 0 && Timeline.signalInt(t, i, "fileTab") == 0 && Timeline.signalInt(t, i, "howFail") == 0 && Timeline.signalInt(t, i, "howPass") == 0 && Timeline.signalInt(t, i, "runReady") == 0 && Timeline.signalInt(t, i, "viewReady") == 0 && Timeline.signalInt(t, i, "checkReady") == 0 && Timeline.signalInt(t, i, "countReady") == 0 && Timeline.signalInt(t, i, "searchReady") == 0 && Timeline.signalInt(t, i, "coverShown") == 0 && Timeline.signalInt(t, i, "coverTotal") == 0 && Timeline.signalInt(t, i, "coverPlaying") == 0 && Timeline.signalStrHas(t, i, "tryOut", "") && Timeline.signalStrHas(t, i, "checkOut", "") && Timeline.signalStrHas(t, i, "viewDiags", "") && Timeline.signalStrHas(t, i, "stateDiags", "") && Timeline.signalStrHas(t, i, "howCamp", "Press Fuzz") && Timeline.signalStrHas(t, i, "trySrc", "n = inc(0)") && Timeline.signalStrHas(t, i, "tryVer", "") && Timeline.signalListLen(t, i, "viewMounted") == 1 && Timeline.signalListLen(t, i, "stateMounted") == 1 && !Timeline.a11yHas(t, i, "outlined:Back"))

def headingIsExposed(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, "heading:1"))

def appBarStaysVisible(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, "appbar:App bar") && !Timeline.a11yHas(t, i, "textbutton:Get started") && !Timeline.a11yHas(t, i, "outlined:Try GUI"))

def stripStays(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, "tab:Intro") && Timeline.a11yHas(t, i, "tab:Run") && Timeline.a11yHas(t, i, "tab:View") && Timeline.a11yHas(t, i, "tab:Check") && Timeline.a11yHas(t, i, "tab:State") && Timeline.a11yHas(t, i, "tab:Search") && Timeline.a11yHas(t, i, "tab:Cover") && Timeline.a11yHas(t, i, "tab:Mutation"))

def noIndexBook(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "semantics:Index book") && !Timeline.a11yHas(t, i, "choicechip:Start") && !Timeline.a11yHas(t, i, "text:Choose a topic") && !Timeline.a11yHas(t, i, "breadcrumb:Breadcrumb"))

def activeStage(t: Timeline): Verdict =
  Verdict.every(t, i => if (Timeline.signalInt(t, i, "step") == 0) Timeline.a11yHas(t, i, "text:This walkthrough grows one Counter. Press Continue.") && Timeline.a11yHas(t, i, "button:Continue") && !Timeline.a11yHas(t, i, "button:Run") && !Timeline.a11yHas(t, i, "button:Add one") && !Timeline.a11yHas(t, i, "button:Fuzz") else if (Timeline.signalInt(t, i, "step") == 1) Timeline.a11yHas(t, i, "button:Run") && Timeline.a11yHas(t, i, "editor:editor") && !Timeline.a11yHas(t, i, "button:Add one") && !Timeline.a11yHas(t, i, "button:Fuzz") && !Timeline.a11yHas(t, i, "button:Check") else if (Timeline.signalInt(t, i, "step") == 2) Timeline.a11yHas(t, i, "button:Run") && Timeline.a11yHas(t, i, "editor:editor") && !Timeline.a11yHas(t, i, "button:Add one") && !Timeline.a11yHas(t, i, "button:Fuzz") else if (Timeline.signalInt(t, i, "step") == 3) Timeline.a11yHas(t, i, "button:Check") && Timeline.a11yHas(t, i, "text:A claim reads a Timeline") && Timeline.a11yHas(t, i, "semantics:seed 0") && Timeline.a11yHas(t, i, "semantics:seed 128") && Timeline.a11yHas(t, i, "text:first=R fail") && Timeline.a11yHas(t, i, "text:first=L pass") && !Timeline.a11yHas(t, i, "button:Fuzz") && !Timeline.a11yHas(t, i, "button:Add one") else if (Timeline.signalInt(t, i, "step") == 4) Timeline.a11yHas(t, i, "button:Run") && Timeline.a11yHas(t, i, "editor:editor") && !Timeline.a11yHas(t, i, "button:Add one") && !Timeline.a11yHas(t, i, "button:Fuzz") else if (Timeline.signalInt(t, i, "step") == 5) Timeline.a11yHas(t, i, "button:Fuzz") && Timeline.a11yHas(t, i, "text:Campaign") && Timeline.a11yHas(t, i, s"chip:fail=${Timeline.signalInt(t, i, "howFail")}") && Timeline.a11yHas(t, i, s"chip:pass=${Timeline.signalInt(t, i, "howPass")}") else if (Timeline.signalInt(t, i, "step") == 6) Timeline.a11yHas(t, i, "text:Paint reached lines") && Timeline.a11yHas(t, i, "text:hits ") && Timeline.signalInt(t, i, "coverShown") > 0 == Timeline.a11yHas(t, i, "semantics:cover-hit") && !Timeline.a11yHas(t, i, "semantics:seed 0") && !Timeline.a11yHas(t, i, "text:mutant ") else Timeline.a11yHas(t, i, "text:live ") && Timeline.a11yHas(t, i, "text:mutant ") && Timeline.a11yHas(t, i, "text:- ") && Timeline.a11yHas(t, i, "text:+ ") && Timeline.a11yHas(t, i, "text:incAdds reject") && Timeline.a11yHas(t, i, "link:Scuzz on GitHub"))

def trailStays(t: Timeline): Verdict =
  Verdict.every(t, i => if (Timeline.signalInt(t, i, "step") == 0) Timeline.a11yHas(t, i, "text:Intro 1/8") else if (Timeline.signalInt(t, i, "step") == 1) Timeline.a11yHas(t, i, "text:Run 2/8") else if (Timeline.signalInt(t, i, "step") == 2) Timeline.a11yHas(t, i, "text:View 3/8") else if (Timeline.signalInt(t, i, "step") == 3) Timeline.a11yHas(t, i, "text:Check 4/8") else if (Timeline.signalInt(t, i, "step") == 4) Timeline.a11yHas(t, i, "text:State 5/8") else if (Timeline.signalInt(t, i, "step") == 5) Timeline.a11yHas(t, i, "text:Search 6/8") else if (Timeline.signalInt(t, i, "step") == 6) Timeline.a11yHas(t, i, "text:Cover 7/8") else Timeline.a11yHas(t, i, "text:Mutation 8/8"))

private def isRunStarterSrc(t: Timeline, i: Int): Bool =
  Timeline.signalStrHas(t, i, "trySrc", "n = inc(0)") && Timeline.signalStrHas(t, i, "trySrc", "IO.println(Str.fromInt(n))") && !Timeline.signalStrHas(t, i, "trySrc", "View.column")

private def isViewStarterSrc(t: Timeline, i: Int): Bool =
  Timeline.signalStrHas(t, i, "trySrc", "View.text(\"Clicks: 0\")") && Timeline.signalStrHas(t, i, "trySrc", "IO.println(Str.fromInt(inc(0)))") && !Timeline.signalStrHas(t, i, "trySrc", "clicks = Signal.make(0)")

private def isSignalStarterSrc(t: Timeline, i: Int): Bool =
  Timeline.signalStrHas(t, i, "trySrc", "clicks = Signal.make(0)") && Timeline.signalStrHas(t, i, "trySrc", "Clicks: $n")

private def hasStarterSrc(t: Timeline, i: Int): Bool =
  isRunStarterSrc(t, i) || isViewStarterSrc(t, i) || isSignalStarterSrc(t, i)

private def isEmptyStarterVer(t: Timeline, i: Int): Bool =
  Timeline.signalStrHas(t, i, "tryVer", "")

private def isCheckStarterVer(t: Timeline, i: Int): Bool =
  Timeline.signalStrHas(t, i, "tryVer", "oracle incAdds(n: Int): Bool =") && Timeline.signalStrHas(t, i, "tryVer", "Main.inc(n) == n + 1") && !Timeline.signalStrHas(t, i, "tryVer", "oracle hidden")

private def isSearchStarterVer(t: Timeline, i: Int): Bool =
  Timeline.signalStrHas(t, i, "tryVer", "oracle incAdds(n: Int): Bool =") && Timeline.signalStrHas(t, i, "tryVer", "if (n == 3) false else true")

private def hasStarterVer(t: Timeline, i: Int): Bool =
  isEmptyStarterVer(t, i) || isCheckStarterVer(t, i) || isSearchStarterVer(t, i)

private def starterMatchesStage(t: Timeline, i: Int): Bool =
  for {
    st = Timeline.signalInt(t, i, "step")
    srcOk = !hasStarterSrc(t, i) || (if (st <= 1) isRunStarterSrc(t, i) else if (st <= 3) isViewStarterSrc(t, i) else isSignalStarterSrc(t, i))
    verOk = !hasStarterVer(t, i) || (if (st < 3) isEmptyStarterVer(t, i) else if (st <= 4) isCheckStarterVer(t, i) else isSearchStarterVer(t, i))
  } yield srcOk && verOk

def stageStartersSyncAndKeepEdits(t: Timeline): Verdict =
  Verdict.and(Verdict.every(t, i => starterMatchesStage(t, i)), Verdict.stepEvery(t, __tup => __tup match {
  case (before, after) => Timeline.signalInt(t, after, "step") == Timeline.signalInt(t, before, "step") || hasStarterSrc(t, after) == hasStarterSrc(t, before) && hasStarterVer(t, after) == hasStarterVer(t, before)
}))

def viewAndStatePreviewsStayIsolated(t: Timeline): Verdict =
  Verdict.and(Verdict.every(t, i => Timeline.signalInt(t, i, "step") != 2 || !isViewStarterSrc(t, i) || !Timeline.a11yHas(t, i, "text:Clicks: 1")), Verdict.stepEvery(t, __tup => __tup match {
  case (before, after) => Timeline.signalInt(t, after, "step") == Timeline.signalInt(t, before, "step") || Timeline.signalInt(t, after, "runReady") == Timeline.signalInt(t, before, "runReady") && Timeline.signalInt(t, after, "viewReady") == Timeline.signalInt(t, before, "viewReady") && Timeline.signalInt(t, after, "checkReady") == Timeline.signalInt(t, before, "checkReady") && Timeline.signalInt(t, after, "countReady") == Timeline.signalInt(t, before, "countReady") && Timeline.signalInt(t, after, "searchReady") == Timeline.signalInt(t, before, "searchReady") && Timeline.signalListLen(t, after, "viewMounted") == Timeline.signalListLen(t, before, "viewMounted") && Timeline.signalListLen(t, after, "stateMounted") == Timeline.signalListLen(t, before, "stateMounted")
}))

def countChangesOnlyWithControls(t: Timeline): Verdict =
  Verdict.stepEvery(t, __tup => __tup match {
  case (before, after) => !Timeline.a11yHas(t, after, "text:Clicks: 1") || Timeline.a11yHas(t, before, "text:Clicks: 1") || Timeline.lastHitHas(t, after, "button:+1") || Timeline.signalInt(t, before, "step") != 4 && Timeline.signalInt(t, after, "step") == 4
})

private def checkRunStage1(t: Timeline, before: Int, after: Int): Bool =
  for {
    starterOk = !isRunStarterSrc(t, after) || Timeline.signalInt(t, after, "runReady") == 1 && Timeline.a11yHas(t, after, "text:1") && Timeline.a11yHas(t, after, "button:Continue")
    badPrint = !Timeline.signalStrHas(t, after, "trySrc", "IO.println(1)") || Timeline.signalStrHas(t, after, "tryOut", "error:") && Timeline.a11yHas(t, after, "error:") && Timeline.signalInt(t, after, "runReady") == 0 && !Timeline.a11yHas(t, after, "button:Continue")
    gatedOk = Timeline.signalInt(t, after, "runReady") == 1 == Timeline.a11yHas(t, after, "button:Continue")
    isolated = Timeline.signalInt(t, after, "checkReady") == Timeline.signalInt(t, before, "checkReady") && Timeline.signalInt(t, after, "viewReady") == Timeline.signalInt(t, before, "viewReady") && Timeline.signalInt(t, after, "countReady") == Timeline.signalInt(t, before, "countReady")
  } yield starterOk && badPrint && gatedOk && isolated

private def checkRunStage2(t: Timeline, before: Int, after: Int): Bool =
  for {
    okBranch = Timeline.signalInt(t, after, "viewReady") == 1 && Timeline.signalStrHas(t, after, "viewDiags", "ok") && !Timeline.signalStrHas(t, after, "viewDiags", "error:") && Timeline.signalListLen(t, after, "viewMounted") == 1 && Timeline.a11yHas(t, after, "button:Continue")
    errBranch = Timeline.signalInt(t, after, "viewReady") == 0 && (Timeline.signalStrHas(t, after, "viewDiags", "error:") || Timeline.signalStrHas(t, after, "viewDiags", "eval:")) && (Timeline.a11yHas(t, after, "error:") || Timeline.a11yHas(t, after, "eval:")) && Timeline.signalListLen(t, after, "viewMounted") == 0 && !Timeline.a11yHas(t, after, "button:Continue")
    isolated = Timeline.signalInt(t, after, "countReady") == Timeline.signalInt(t, before, "countReady") && Timeline.signalListLen(t, after, "stateMounted") == Timeline.signalListLen(t, before, "stateMounted")
  } yield (okBranch || errBranch) && isolated

private def checkRunStage4(t: Timeline, before: Int, after: Int): Bool =
  for {
    okBranch = Timeline.signalStrHas(t, after, "stateDiags", "ok") && !Timeline.signalStrHas(t, after, "stateDiags", "error:") && Timeline.signalListLen(t, after, "stateMounted") == 1 && (!isSignalStarterSrc(t, after) || Timeline.signalInt(t, after, "countReady") == 0 && Timeline.a11yHas(t, after, "text:Clicks: 0") && !Timeline.a11yHas(t, after, "button:Continue"))
    errBranch = (Timeline.signalStrHas(t, after, "stateDiags", "error:") || Timeline.signalStrHas(t, after, "stateDiags", "eval:")) && (Timeline.a11yHas(t, after, "error:") || Timeline.a11yHas(t, after, "eval:")) && Timeline.signalListLen(t, after, "stateMounted") == 0 && Timeline.signalInt(t, after, "countReady") == 0 && !Timeline.a11yHas(t, after, "button:Continue")
    isolated = Timeline.signalInt(t, after, "viewReady") == Timeline.signalInt(t, before, "viewReady") && Timeline.signalListLen(t, after, "viewMounted") == Timeline.signalListLen(t, before, "viewMounted")
  } yield (okBranch || errBranch) && isolated

private def checkRunHit(t: Timeline, before: Int, after: Int): Bool =
  if (Timeline.signalInt(t, before, "step") == 1) checkRunStage1(t, before, after) else if (Timeline.signalInt(t, before, "step") == 2) checkRunStage2(t, before, after) else checkRunStage4(t, before, after)

def runShowsIncOrDiag(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Run", pair => pair match {
  case (before, after) => checkRunHit(t, before, after)
})

def viewMountsClicks(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "step") != 2 || Timeline.signalInt(t, i, "viewReady") != 1 || Timeline.a11yHas(t, i, "text:Clicks: ") && Timeline.a11yHas(t, i, "button:+1") && (Timeline.signalStrHas(t, i, "trySrc", "Clicks: $n") || Timeline.a11yHas(t, i, "text:Clicks: 0")))

def tryRunKeepsOk(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.lastHitHas(t, i, "button:Run") || (if (Timeline.signalInt(t, i, "step") == 2) Timeline.signalInt(t, i, "viewReady") == 1 || !Timeline.signalStrHas(t, i, "trySrc", "View.column") else if (Timeline.signalInt(t, i, "step") == 4) Timeline.signalStrHas(t, i, "stateDiags", "ok") || !Timeline.signalStrHas(t, i, "trySrc", "View.column") else true))

def tryRunMountsFresh(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.lastHitHas(t, i, "button:Run") || Timeline.signalInt(t, i, "step") != 4 || !Timeline.signalStrHas(t, i, "stateDiags", "ok") || !Timeline.signalStrHas(t, i, "trySrc", "clicks = Signal.make(0)") || Timeline.a11yHas(t, i, "text:Clicks: 0") && Timeline.signalInt(t, i, "countReady") == 0)

def tryPlusOneCounts(t: Timeline): Verdict =
  Verdict.onHit(t, "button:+1", pair => pair match {
  case (before, after) => if (Timeline.signalInt(t, before, "step") == 2 && !Timeline.signalStrHas(t, after, "trySrc", "Clicks: $n")) Timeline.a11yHas(t, after, "text:Clicks: 0") && Timeline.signalInt(t, after, "countReady") == Timeline.signalInt(t, before, "countReady") else !Timeline.a11yHas(t, before, "text:Clicks: 0") || !Timeline.signalStrHas(t, after, "trySrc", "Clicks: $n") || Timeline.a11yHas(t, after, "text:Clicks: 1") && (Timeline.signalInt(t, before, "step") != 4 || Timeline.signalInt(t, after, "countReady") == 1)
})

private def checkOracleHit(t: Timeline, before: Int, after: Int): Bool =
  for {
    validInc = Timeline.signalStrHas(t, after, "tryVer", "Main.inc(n) == n + 1") && Timeline.signalStrHas(t, after, "tryVer", "oracle incAdds(n: Int): Bool =")
    badType = Timeline.signalStrHas(t, after, "tryVer", "oracle incAdds(n: Int): Int = n")
    okBranch = Timeline.signalInt(t, after, "checkReady") == 1 && !Timeline.signalStrHas(t, after, "checkOut", "error:") && Timeline.a11yHas(t, after, "text:true") && Timeline.a11yHas(t, after, "button:Continue")
    errBranch = Timeline.signalInt(t, after, "checkReady") == 0 && !Timeline.a11yHas(t, after, "button:Continue") && (Timeline.signalStrHas(t, after, "checkOut", "error:") || Timeline.signalStrHas(t, after, "checkOut", "fail ") || Timeline.signalStrHas(t, after, "checkOut", "no oracle ") || Timeline.signalStrHas(t, after, "checkOut", "is not an oracle"))
    isolated = Timeline.signalInt(t, after, "runReady") == Timeline.signalInt(t, before, "runReady")
  } yield (!validInc || !Timeline.signalStrHas(t, after, "trySrc", "n + 1") || okBranch) && (!badType || Timeline.signalStrHas(t, after, "checkOut", "error:") && Timeline.a11yHas(t, after, "error:") && !Timeline.a11yHas(t, after, "button:Continue")) && (okBranch || errBranch) && isolated

def checkShowsTrueOrDiag(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Check", pair => pair match {
  case (before, after) => checkOracleHit(t, before, after)
})

def checkShowsFilesAndTabs(t: Timeline): Verdict =
  Verdict.and(Verdict.every(t, i => (Timeline.signalInt(t, i, "fileTab") == 0 || Timeline.signalInt(t, i, "fileTab") == 1) && (Timeline.signalInt(t, i, "step") != 3 && Timeline.signalInt(t, i, "step") != 5 || Timeline.a11yHas(t, i, "tab:Main.scuzz") && Timeline.a11yHas(t, i, "tab:count.scuzz_verify"))), Verdict.and(Verdict.onHit(t, "tab:Main.scuzz", pair => pair match {
  case (_, after) => Timeline.signalInt(t, after, "fileTab") == 0
}), Verdict.onHit(t, "tab:count.scuzz_verify", pair => pair match {
  case (_, after) => Timeline.signalInt(t, after, "fileTab") == 1
})))

def codeHasCopyControl(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "step") != 3 || Timeline.a11yHas(t, i, "outlined:Copy") || Timeline.a11yHas(t, i, "outlined:Copied"))

private def checkSearchStateAt(t: Timeline, i: Int): Bool =
  for {
    fail = Timeline.signalInt(t, i, "howFail")
    pass = Timeline.signalInt(t, i, "howPass")
    ready = Timeline.signalInt(t, i, "searchReady")
    bitsOk = (fail == 0 || fail == 1) && (pass == 0 || pass == 1) && (ready == 0 || ready == 1)
    stageOk = Timeline.signalInt(t, i, "step") != 5 || fail == 1 == Timeline.a11yHas(t, i, "text:Fail filter: ") && pass == 1 == Timeline.a11yHas(t, i, "text:Pass filter: ") && Timeline.a11yHas(t, i, "button:Continue") == (ready == 1)
  } yield bitsOk && stageOk

private def checkFuzzHit(t: Timeline, after: Int): Bool =
  for {
    starterFail = Timeline.signalStrHas(t, after, "tryVer", "if (n == 3) false else true") && Timeline.signalStrHas(t, after, "trySrc", "n + 1")
    fixedPass = Timeline.signalStrHas(t, after, "tryVer", "oracle hidden(n: Int): Bool = Main.inc(n) > n") && Timeline.signalStrHas(t, after, "trySrc", "n + 1")
    syntaxBroken = Timeline.signalStrHas(t, after, "tryVer", "oracle hidden(") && !Timeline.signalStrHas(t, after, "tryVer", "Bool")
    passBranch = Timeline.signalInt(t, after, "searchReady") == 1 && !Timeline.signalStrHas(t, after, "howCamp", "fail ") && Timeline.signalStrHas(t, after, "howCamp", "pass") && Timeline.a11yHas(t, after, "text:pass") && Timeline.a11yHas(t, after, "text:hidden stayed true for 0 through 8.") && Timeline.signalInt(t, after, "howFail") == 0 && Timeline.signalInt(t, after, "howPass") == 1 && Timeline.a11yHas(t, after, "chip:fail=0") && Timeline.a11yHas(t, after, "chip:pass=1") && Timeline.a11yHas(t, after, "text:Pass filter: 9 inputs passed (0..8).") && Timeline.a11yHas(t, after, "button:Continue")
    failBranch = Timeline.signalInt(t, after, "searchReady") == 1 && Timeline.signalStrHas(t, after, "howCamp", "fail ") && Timeline.a11yHas(t, after, "text:hidden returned false at that argument.") && Timeline.signalInt(t, after, "howFail") == 1 && Timeline.signalInt(t, after, "howPass") == 0 && Timeline.a11yHas(t, after, "chip:fail=1") && Timeline.a11yHas(t, after, "chip:pass=0") && Timeline.a11yHas(t, after, "text:Fail filter: counterexample ") && Timeline.a11yHas(t, after, "button:Continue")
    diagBranch = Timeline.signalInt(t, after, "searchReady") == 0 && (Timeline.signalStrHas(t, after, "howCamp", "error:") || Timeline.signalStrHas(t, after, "howCamp", "no oracle ") || Timeline.signalStrHas(t, after, "howCamp", "is not an oracle")) && Timeline.a11yHas(t, after, "text:Check failed. Fix the snippet and press Fuzz.") && Timeline.signalInt(t, after, "howFail") == 0 && Timeline.signalInt(t, after, "howPass") == 0 && Timeline.a11yHas(t, after, "chip:fail=0") && Timeline.a11yHas(t, after, "chip:pass=0") && !Timeline.a11yHas(t, after, "button:Continue")
  } yield (!starterFail || failBranch && Timeline.signalStrHas(t, after, "howCamp", "fail hidden 3") && Timeline.a11yHas(t, after, "text:fail hidden 3")) && (!fixedPass || passBranch) && (!syntaxBroken || diagBranch && Timeline.signalStrHas(t, after, "howCamp", "error:") && Timeline.a11yHas(t, after, "error:")) && (passBranch || failBranch || diagBranch)

def searchCampaignAndOutcomes(t: Timeline): Verdict =
  Verdict.and(Verdict.every(t, i => checkSearchStateAt(t, i)), Verdict.onHit(t, "button:Fuzz", pair => pair match {
  case (_, after) => checkFuzzHit(t, after)
}))

def searchFilterChipsToggle(t: Timeline): Verdict =
  Verdict.and(Verdict.onHit(t, "chip:fail", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "howFail") != Timeline.signalInt(t, before, "howFail") && Timeline.signalInt(t, after, "howPass") == Timeline.signalInt(t, before, "howPass") && Timeline.signalInt(t, after, "howFail") == 1 == Timeline.a11yHas(t, after, "text:Fail filter: ")
}), Verdict.onHit(t, "chip:pass", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "howPass") != Timeline.signalInt(t, before, "howPass") && Timeline.signalInt(t, after, "howFail") == Timeline.signalInt(t, before, "howFail") && Timeline.signalInt(t, after, "howPass") == 1 == Timeline.a11yHas(t, after, "text:Pass filter: ")
}))

def continueGatesAndSteps(t: Timeline): Verdict =
  Verdict.and(Verdict.every(t, i => (Timeline.signalInt(t, i, "step") != 1 || Timeline.signalInt(t, i, "runReady") == 1 == Timeline.a11yHas(t, i, "button:Continue")) && (Timeline.signalInt(t, i, "step") != 2 || Timeline.signalInt(t, i, "viewReady") == 1 == Timeline.a11yHas(t, i, "button:Continue")) && (Timeline.signalInt(t, i, "step") != 3 || Timeline.signalInt(t, i, "checkReady") == 1 == Timeline.a11yHas(t, i, "button:Continue")) && (Timeline.signalInt(t, i, "step") != 4 || Timeline.signalInt(t, i, "countReady") == 1 == Timeline.a11yHas(t, i, "button:Continue") && Timeline.signalInt(t, i, "countReady") == 0 == Timeline.a11yHas(t, i, "text:Press Run, tap +1, then Continue.")) && (Timeline.signalInt(t, i, "step") != 5 || Timeline.signalInt(t, i, "searchReady") == 1 == Timeline.a11yHas(t, i, "button:Continue"))), Verdict.onHit(t, "button:Continue", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "step") == Timeline.signalInt(t, before, "step") + 1
}))

def stateUnlocksContinue(t: Timeline): Verdict =
  Verdict.every(t, i => (Timeline.signalInt(t, i, "countReady") == 0 || Timeline.signalInt(t, i, "countReady") == 1) && (!Timeline.lastHitHas(t, i, "button:+1") || Timeline.signalInt(t, i, "step") != 4 || !Timeline.a11yHas(t, i, "text:Clicks: 1") || Timeline.signalInt(t, i, "countReady") == 1 && Timeline.a11yHas(t, i, "button:Continue")))

private def checkBackHit(t: Timeline, before: Int, after: Int): Bool =
  for {
    prevStep = Timeline.signalInt(t, before, "step")
    nextStep = Timeline.signalInt(t, after, "step")
    stepOk = prevStep > 0 && nextStep == prevStep - 1
    searchKept = Timeline.signalInt(t, after, "howFail") == Timeline.signalInt(t, before, "howFail") && Timeline.signalInt(t, after, "howPass") == Timeline.signalInt(t, before, "howPass")
    stateKept = Timeline.signalInt(t, after, "countReady") == Timeline.signalInt(t, before, "countReady") && (nextStep != 4 || Timeline.signalInt(t, after, "countReady") != 1 || Timeline.a11yHas(t, after, "button:Continue"))
    gatesKept = Timeline.signalInt(t, after, "runReady") == Timeline.signalInt(t, before, "runReady") && Timeline.signalInt(t, after, "viewReady") == Timeline.signalInt(t, before, "viewReady") && Timeline.signalInt(t, after, "checkReady") == Timeline.signalInt(t, before, "checkReady")
  } yield stepOk && searchKept && stateKept && gatesKept

def backNavigatesAndPreservesState(t: Timeline): Verdict =
  Verdict.and(Verdict.every(t, i => Timeline.signalInt(t, i, "step") > 0 == Timeline.a11yHas(t, i, "outlined:Back")), Verdict.onHit(t, "outlined:Back", pair => pair match {
  case (before, after) => checkBackHit(t, before, after)
}))

private def checkCoverStateAt(t: Timeline, i: Int): Bool =
  for {
    shown = Timeline.signalInt(t, i, "coverShown")
    total = Timeline.signalInt(t, i, "coverTotal")
    playing = Timeline.signalInt(t, i, "coverPlaying")
    boundsOk = (playing == 0 || playing == 1) && shown >= 0 && shown <= total
    stageOk = Timeline.signalInt(t, i, "step") != 6 || total > 0 && shown > 0 == Timeline.a11yHas(t, i, "semantics:cover-hit") && Timeline.a11yHas(t, i, "text:hits ") && Timeline.a11yHas(t, i, "button:Play hits")
  } yield boundsOk && stageOk

private def checkPlayHitsHit(t: Timeline, before: Int, after: Int): Bool =
  if (Timeline.signalInt(t, before, "coverPlaying") == 1) true else for {
  last = Timeline.len(t) - 1
  slept = Timeline.exists(t, k => k >= after && Timeline.effectHas(t, k, "io.sleep ms=160"))
  settled = Timeline.signalInt(t, last, "coverPlaying") == 0 && (Timeline.signalInt(t, last, "step") != 6 || Timeline.signalInt(t, last, "coverShown") == Timeline.signalInt(t, last, "coverTotal") && Timeline.a11yHas(t, last, "semantics:cover-hit"))
} yield Timeline.signalInt(t, after, "coverPlaying") == 1 && Timeline.signalInt(t, after, "coverShown") == 0 && !Timeline.a11yHas(t, after, "semantics:cover-hit") && Timeline.a11yHas(t, after, "text:hits 0/") && slept && settled

def coverPaintsAndReplaysHits(t: Timeline): Verdict =
  Verdict.and(Verdict.every(t, i => checkCoverStateAt(t, i)), Verdict.onHit(t, "button:Play hits", pair => pair match {
  case (before, after) => checkPlayHitsHit(t, before, after)
}))

def checkShowsClaim(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "step") != 3 || Timeline.a11yHas(t, i, "text:A claim is a function from Timeline to Verdict.") && Timeline.a11yHas(t, i, "text:A usual test names one input and one expected output.") && Timeline.a11yHas(t, i, "text:A claim names a rule.") && Timeline.a11yHas(t, i, "text:The rule must hold for a recorded run.") && Timeline.a11yHas(t, i, "text:You write the claim once.") && Timeline.a11yHas(t, i, "text:Scuzz chooses the seeds.") && Timeline.a11yHas(t, i, "text:Each seed is one schedule.") && Timeline.a11yHas(t, i, "text:Scuzz records that schedule as a Timeline.") && Timeline.a11yHas(t, i, "text:The claim reads that timeline after the run.") && Timeline.a11yHas(t, i, "text:The claim does not sit inside the program.") && Timeline.a11yHas(t, i, "text:The claim returns pass or fail.") && Timeline.a11yHas(t, i, "text:The program offers L and R.") && Timeline.a11yHas(t, i, "text:The two offers race.") && Timeline.a11yHas(t, i, "text:order.scuzz_verify") && Timeline.a11yHas(t, i, "def leftFirst(t: Timeline): Verdict =") && Timeline.a11yHas(t, i, "Timeline.signalInt(t, Timeline.len(t) - 1, \"order\") == 1") && Timeline.a11yHas(t, i, "text:leftFirst: L must win") && Timeline.a11yHas(t, i, "text:Seed 0 fails.") && Timeline.a11yHas(t, i, "text:R won on seed 0.") && Timeline.a11yHas(t, i, "text:The rule says L must win.") && Timeline.a11yHas(t, i, "text:Seed 128 passes.") && Timeline.a11yHas(t, i, "text:L won on seed 128.") && Timeline.a11yHas(t, i, "text:first=L pass") && Timeline.a11yHas(t, i, "text:first=R fail"))

def mutantShowsDiff(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "step") != 7 || Timeline.a11yHas(t, i, "text:live source") && Timeline.a11yHas(t, i, "text:mutant source") && Timeline.a11yHas(t, i, "text:- ") && Timeline.a11yHas(t, i, "text:+ ") && Timeline.a11yHas(t, i, "text:incAdds reject"))

def viewListSignalsHoldStageViews(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalListLen(t, i, "viewMounted") == (if (Timeline.signalStrHas(t, i, "viewDiags", "error:") || Timeline.signalStrHas(t, i, "viewDiags", "eval:")) 0 else 1) && Timeline.signalListLen(t, i, "stateMounted") == (if (Timeline.signalStrHas(t, i, "stateDiags", "error:") || Timeline.signalStrHas(t, i, "stateDiags", "eval:")) 0 else 1) && Timeline.signalListLen(t, i, "claimBody") == (if (Timeline.signalInt(t, i, "step") == 3) 1 else 0) && Timeline.signalListLen(t, i, "coverBody") == (if (Timeline.signalInt(t, i, "step") == 6) 1 else 0) && Timeline.signalListLen(t, i, "mutBody") == (if (Timeline.signalInt(t, i, "step") == 7) 1 else 0))

