def handshakeFails(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "cases") || Timeline.fileTextIs(t, i, "handshake.txt", "Net.httpGet: TLS failed"))

def trustFails(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "cases") || Timeline.fileTextIs(t, i, "trust.txt", "Net.httpGet: certificate rejected"))

