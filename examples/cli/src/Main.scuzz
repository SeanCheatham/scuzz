def a1(a: String): List[String] =
  a :: ([]: List[String])

def a2(a: String, b: String): List[String] =
  a :: b :: ([]: List[String])

def a3(a: String, b: String, c: String): List[String] =
  a :: b :: c :: ([]: List[String])

def a4(a: String, b: String, c: String, d: String): List[String] =
  a :: b :: c :: d :: ([]: List[String])

def srcHi(): String =
  "@main def main: IO[Unit] = IO.println(\"Hi\")"

def wantHi(): String =
  "@main def main: IO[Unit] =\n  IO.println(\"Hi\")\n"

def wantUnrec(): String =
  """error: unrecognized subcommand 'nope'

Usage: scuzz [OPTIONS] <COMMAND>

For more information, try '--help'.
"""

def wantUnexp(): String =
  """error: unexpected argument '--nope' found

  tip: to pass '--nope' as a value, use '-- --nope'

Usage: scuzz fmt [OPTIONS] [PATH]

For more information, try '--help'.
"""

def wantJsonOnly(): String =
  """scuzz error: --message-format=json applies to `scuzz check` only
"""

def wantMissName(): String =
  """error: the following required arguments were not provided:
  <NAME>

Usage: scuzz new <NAME>

For more information, try '--help'.
"""

def wantNeedIter(): String =
  """error: a value is required for '--iterations <ITERATIONS>' but none was supplied

For more information, try '--help'.
"""

def srcIrHi(): String =
  "@main def main: IO[Unit] =\n  IO.println(\"Hi\")\n"

def wantIrHi(): String =
  "@.str0 = private unnamed_addr constant [3 x i8] c\"Hi\\00\", align 1\n\ndefine i32 @main(i32 %argc, ptr %argv) {\nentry:\n  %build_gep = getelementptr inbounds [3 x i8], ptr @.str0, i64 0, i64 0\n  %build_ss = call ptr @sz_string_from_cstr(ptr %build_gep)\n  %build_io = call ptr @sz_io_println(ptr %build_ss)\n  call void @sz_release(ptr %build_ss)\n  %rc = call i32 @sz_runtime_main_args(ptr %build_io, i32 %argc, ptr %argv)\n  ret i32 %rc\n}"

def srcTyUnbound(): String =
  """@main def main: IO[Unit] =
  IO.println(nope)
"""

def wantTyUnbound(): String =
  "[{\"severity\":\"error\",\"message\":\"type error: unbound variable nope\",\"file\":\"t/src/Main.scuzz\",\"line\":2,\"column\":14,\"end_line\":2,\"end_column\":18}]"

def tomlHello(): String =
  "[package]\nname = \"hello\"\nversion = \"0.1.0\"\ndescription = \"IO hello world\"\n"

def tomlCli(): String =
  "[package]\nname = \"cli\"\nversion = \"0.1.0\"\n\n[dependencies]\nsyntax = { path = \"../syntax\" }\ncompiler = { path = \"../compiler\" }\n"

def tomlPlugins(): String =
  "[package]\nname = \"app\"\n[plugins]\nx = 1\n"

def wantPlugins(): String =
  "unknown scuzz.toml table [plugins]; known tables: package, dependencies, ui"

def tomlLicense(): String =
  "[package]\nname = \"app\"\nlicense = \"MIT\"\n"

def wantLicense(): String =
  "unknown scuzz.toml key `license` in [package]; known keys: name, version, description"

def tomlStrDep(): String =
  "[package]\nname = \"app\"\n[dependencies]\nshared = \"../shared\"\n"

def wantStrDep(): String =
  "string dependencies are unsupported; use `{ path = \"...\" }`"

def tomlGit(): String =
  "[package]\nname = \"app\"\n[dependencies]\nshared = { git = \"https://example.com/x.git\" }\n"

def wantGit(): String =
  "unsupported dependency key `git`; only `path` is supported in v0"

def tomlNoName(): String =
  "[package]\nversion = \"0.1.0\"\n"

def wantNoName(): String =
  "missing field `name`"

def tomlEmptyPath(): String =
  "[package]\nname = \"app\"\n[dependencies]\nshared = { path = \"\" }\n"

def wantEmptyPath(): String =
  "dependency path must not be empty"

def tomlNeedPath(): String =
  "[package]\nname = \"app\"\n[dependencies]\nshared = { }\n"

def wantNeedPathToml(): String =
  "dependency requires `path = \"...\"`"

def wantLink(): String =
  "clang -Wno-override-module build/hello.ll crates/runtime/build/libscuzz_rt.a -lpthread -o build/hello"

def wantHumanUnbound(): String =
  "t/src/Main.scuzz:2:14: error: type error: unbound variable nope"

def verifyOk(): Bool =
  Cli.runCmd(Cli.parse(a2("check", "--message-format=json")), srcTyUnbound()) == wantTyUnbound() && Cli.runCmd(Cli.parse(a1("check")), srcTyUnbound()) == wantHumanUnbound() && Cli.runCmd(Cli.parse(a1("check")), srcIrHi()) == "scuzz check ok" && Cli.runCmd(Cli.parse(a1("fmt")), srcHi()) == wantHi()

def driveOk(): Bool =
  Drive.showMan(Manifest.parse(tomlHello())) == "name=hello ver=0.1.0 ui=false deps=0" && Drive.showMan(Manifest.parse(tomlCli())) == "name=cli ver=0.1.0 ui=false deps=2" && Drive.showMan(Manifest.parse(tomlPlugins())) == Str.concat("err:", wantPlugins()) && Drive.showMan(Manifest.parse(tomlLicense())) == Str.concat("err:", wantLicense()) && Drive.showMan(Manifest.parse(tomlStrDep())) == Str.concat("err:", wantStrDep()) && Drive.showMan(Manifest.parse(tomlGit())) == Str.concat("err:", wantGit()) && Drive.showMan(Manifest.parse(tomlNoName())) == Str.concat("err:", wantNoName()) && Drive.showMan(Manifest.parse(tomlEmptyPath())) == Str.concat("err:", wantEmptyPath()) && Drive.showMan(Manifest.parse(tomlNeedPath())) == Str.concat("err:", wantNeedPathToml()) && Drive.compileSrc(srcIrHi()).ok && Drive.compileSrc(srcIrHi()).ir == wantIrHi() && !Drive.compileSrc(srcTyUnbound()).ok && Drive.compileSrc(srcTyUnbound()).diags == wantTyUnbound() && Drive.compileSrc(srcIrHi()).ir == Drive.compileSrc(srcIrHi()).ir && Drive.linkLine("clang", Drive.llName("build", "hello"), "crates/runtime/build/libscuzz_rt.a", Drive.exeName("build", "hello")) == wantLink() && Drive.missToml("/tmp/empty") == "missing scuzz.toml in /tmp/empty"

def cliDiff(got: String, want: String): Bool =
  got == want

def cliIdem(args: List[String]): Bool =
  Cli.show(Cli.parse(args)) == Cli.show(Cli.parse(args))

def allOk(): Bool =
  cliDiff(Cli.render(Cli.parse(a1("--help"))), Help.helpRoot()) && cliDiff(Cli.render(Cli.parse(a2("fmt", "--help"))), Help.helpFmt()) && cliDiff(Cli.render(Cli.parse(a2("check", "--help"))), Help.helpCheck()) && cliDiff(Cli.render(Cli.parse(a2("build", "--help"))), Help.helpBuild()) && cliDiff(Cli.render(Cli.parse(a2("run", "--help"))), Help.helpRun()) && cliDiff(Cli.render(Cli.parse(a2("fuzz", "--help"))), Help.helpFuzz()) && cliDiff(Cli.render(Cli.parse(a2("new", "--help"))), Help.helpNew()) && cliDiff(Cli.render(Cli.parse(a1("-V"))), """scuzz 0.1.0
""") && cliDiff(Cli.show(Cli.parse(a1("fmt"))), "fmt path=. check=false") && cliDiff(Cli.show(Cli.parse(a2("fmt", "--check"))), "fmt path=. check=true") && cliDiff(Cli.show(Cli.parse(a3("fmt", "--check", "examples/hello"))), "fmt path=examples/hello check=true") && cliDiff(Cli.show(Cli.parse(a2("check", "examples/kernel"))), "check path=examples/kernel json=false") && cliDiff(Cli.show(Cli.parse(a2("check", "--message-format=json"))), "check path=. json=true") && cliDiff(Cli.show(Cli.parse(a2("--message-format=json", "check"))), "check path=. json=true") && cliDiff(Cli.show(Cli.parse(a3("build", "--full", "examples/hello"))), "build path=examples/hello out=build full=true verify=false") && cliDiff(Cli.show(Cli.parse(a3("run", "--headless", "examples/studio"))), "run path=examples/studio out=build headless=true watch=false script= dump=") && cliDiff(Cli.show(Cli.parse(a3("fuzz", "--iterations", "16"))), "fuzz path=. iterations=16 seed=42 replay= oracles=false noFailFast=false minimize=false relate=false") && cliDiff(Cli.show(Cli.parse(a4("fuzz", "--iterations", "0", "examples/counter"))), "fuzz path=examples/counter iterations=0 seed=42 replay= oracles=false noFailFast=false minimize=false relate=false") && cliDiff(Cli.show(Cli.parse(a3("new", "myapp", "--ui"))), "new name=myapp path=. ui=true") && cliDiff(Cli.show(Cli.parse(a2("package", "--target=ios"))), "package path=. out=build target=ios") && cliDiff(Cli.show(Cli.parse(a2("ide", "--headless"))), "ide path=. out=build headless=true") && cliDiff(Cli.render(Cli.parse(a1("nope"))), wantUnrec()) && cliDiff(Cli.render(Cli.parse(a2("fmt", "--nope"))), wantUnexp()) && cliDiff(Cli.render(Cli.parse(a2("--message-format=json", "fmt"))), wantJsonOnly()) && cliDiff(Cli.render(Cli.parse(a1("new"))), wantMissName()) && cliDiff(Cli.render(Cli.parse(a2("fuzz", "--iterations"))), wantNeedIter()) && cliDiff(Cli.render(Cli.parse([]: List[String])), Help.helpRoot()) && cliDiff(Cli.fmtSrc(srcHi()), wantHi()) && cliIdem(a1("fmt")) && cliIdem(a2("fuzz", "--oracles")) && driveOk() && verifyOk()

@main def main: IO[Unit] =
  IO.println(if (allOk()) "cli-ok" else "cli-bad")
