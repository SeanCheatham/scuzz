def noArgs(): List[String] =
  []

def a1(a: String): List[String] =
  a :: noArgs()

def a2(a: String, b: String): List[String] =
  a :: b :: noArgs()

def a3(a: String, b: String, c: String): List[String] =
  a :: b :: c :: noArgs()

def a4(a: String, b: String, c: String, d: String): List[String] =
  a :: b :: c :: d :: noArgs()

def srcHi(): String =
  "@main def main: IO[Unit] = IO.println(\"Hi\")"

def wantHi(): String =
  "@main def main: IO[Unit] =\n  IO.println(\"Hi\")\n"

def wantUnrec(): String =
  """error: unrecognized subcommand 'nope'

Usage: scuzz [OPTIONS] <COMMAND>

For more information, try '--help'.
"""

