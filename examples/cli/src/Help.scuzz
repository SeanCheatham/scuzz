def helpTest(): String =
  """Run tests: Headless structural goldens for [ui] packages; IO smoke (TESTRT exit 0) otherwise

Usage: scuzz test [OPTIONS] [PATH]

Arguments:
  [PATH]  [default: .]

Options:
      --update
          Write Headless dumps into goldens/
      --pixels
          Also compare PNG goldens
      --differential
          Compare structural dumps across Skia backends
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
  -h, --help
          Print help

Examples:
  scuzz test
  scuzz test --update
  scuzz test examples/hello
"""

