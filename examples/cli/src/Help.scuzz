def helpRoot(): String =
  "Scuzz Lang CLI\n\nUsage: scuzz [OPTIONS] <COMMAND>\n\nCommands:\n  build    Compile a Scuzz Lang project to a native executable (LLVM)\n  run      Build and run a Scuzz Lang project\n  watch    Watch sources and rebuild on change (compile loop, not hot reload)\n  check    Format-verify src/ + parse + typecheck (the linter; no codegen / link). JSON with --message-format=json\n  eval     Run an IO-only project on the evaluator (typecheck, then interpret; no codegen / link)\n  lsp      Language server wrapping `scuzz check` JSON diagnostics (stdin/stdout LSP)\n  fmt      Format Scuzz Lang sources under src/\n  fuzz     Search in-source properties, drivers, and [taps] events under TestRuntime; mix coverage-guided search and mutation\n  new      Create a new Scuzz Lang project\n  ide      Launch the bundled Scuzz IDE (`[ui]` package in the SDK)\n  devices  List available iOS simulators\n  exec     Send inject ops to a live session started by `scuzz run`\n  package  Package a project for Linux, macOS, Android, iOS, or web\n  docs     Print the technical manual, or one topic, or a kit row\n  help     Print this message or the help of the given subcommand(s)\n\nOptions:\n      --message-format <MESSAGE_FORMAT>\n          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]\n  -h, --help\n          Print help\n  -V, --version\n          Print version\n\nExamples:\n  scuzz new myapp --ui\n  scuzz check\n  scuzz docs verify\n  scuzz fuzz --iterations 0\n  scuzz run --target headless --exec \"\"\n\nSee: scuzz docs start\n"

def helpEv(): String =
  """Run an IO-only project on the evaluator (typecheck, then interpret; no codegen / link)

Usage: scuzz eval [OPTIONS] [PATH]

Arguments:
  [PATH]  [default: .]

Options:
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
  -h, --help
          Print help

Examples:
  scuzz eval examples/hello

See: scuzz docs commands
"""

def helpFmt(): String =
  """Format Scuzz Lang sources under src/

Usage: scuzz fmt [OPTIONS] [PATH]

Arguments:
  [PATH]  [default: .]

Options:
      --check
          Check only (nonzero exit if files need reformat)
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
  -h, --help
          Print help

Examples:
  scuzz fmt
  scuzz fmt --check
  scuzz fmt examples/hello

See: scuzz docs commands
"""

def helpCheck(): String =
  """Format-verify src/ + parse + typecheck (the linter; no codegen / link). JSON with --message-format=json

Usage: scuzz check [OPTIONS] [PATH]

Arguments:
  [PATH]  [default: .]

Options:
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
  -h, --help
          Print help

Examples:
  scuzz check
  scuzz check examples/kernel
  scuzz check --message-format=json

See: scuzz docs commands
"""

def helpBuild(): String =
  """Compile a Scuzz Lang project to a native executable (LLVM)

Usage: scuzz build [OPTIONS] [PATH]

Arguments:
  [PATH]  Project directory containing scuzz.toml [default: .]

Options:
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
      --out-dir <OUT_DIR>
          Output directory [default: build]
      --full
          Force a full rebuild (ignore incremental fingerprint)
      --verify
          Apply `*.scuzz_scenario` / `*.scuzz_verify` + residual `.require` / `where` (TestRuntime / fuzz graph)
  -h, --help
          Print help

Examples:
  scuzz build
  scuzz build --full examples/hello
  scuzz build --verify examples/counter

See: scuzz docs commands
"""

def helpRun(): String =
  "Build and run a Scuzz Lang project\n\nUsage: scuzz run [OPTIONS] [PATH]\n\nArguments:\n  [PATH]  [default: .]\n\nOptions:\n      --target <TARGET>\n          Platform to run: linux or macos (must match the host), headless (host build, no display), android (host shell), or ios (simulator; see scuzz devices). Overrides [ui].default_runtime. A package without [ui] accepts only the host platform\n      --device <DEVICE>\n          iOS simulator name or ID (see scuzz devices)\n      --exec <OPS>\n          Finite ops program played after the first pump; the run quiesces and exits when it finishes. Inline JSON when the value starts with '{' or '['; anything else is a path to an inject document (schema v=1). An empty value mounts, paints, and exits\n      --snapshot-out <PATH>\n          PNG snapshot path at finish (headless default: build/snapshot.png)\n      --dump <PATH>\n          Structural dump path at finish (SCUZZ_FUZZ_DUMP)\n      --watch\n          Keep running; host and iOS UI hot-reload Views; IO-only reruns. Rejects --exec, --snapshot-out, and --dump\n      --out-dir <OUT_DIR>\n          [default: build]\n      --message-format <MESSAGE_FORMAT>\n          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]\n  -h, --help\n          Print help\n\nWithout --exec a [ui] run stays live: every runtime watches build/inject.json and rewrites build/debug.json. Drive a live session with `scuzz exec`. Headless exits on a quit op or signal.\n\nExamples:\n  scuzz run\n  scuzz run --target headless --exec \"\"\n  scuzz run --target headless --exec '[{\"v\":1,\"kind\":\"inject\",\"events\":[{\"op\":\"tap\",\"id\":\"button:+1\"}]}]'\n  scuzz run --exec examples/studio/build/record.json --dump examples/studio/build/session.json examples/studio\n  scuzz run --watch --target headless\n  scuzz run --target ios --watch\n  scuzz run --target ios --device \"iPhone 17\"\n\nSee: scuzz docs commands\n"

def helpDevices(): String =
  """List available iOS simulators

Usage: scuzz devices

The list includes simulator IDs, names, runtime versions, and boot states.
Use a name or ID with scuzz run --target ios --device DEVICE.
Xcode and an iOS simulator runtime are required.

See: scuzz docs ios
"""

def helpFuzz(): String =
  """Probe the live graph under TestRuntime, then replay corpus and seeds, then search, then mutation

Usage: scuzz fuzz [OPTIONS] [PATH]

Arguments:
  [PATH]  [default: .]

Options:
      --iterations <ITERATIONS>
          Iteration budget. Search then mutation. `0` replays corpus/ only [default: 32]
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
      --seed <SEED>
          Deterministic LCG seed [default: 42]
      --replay <REPLAY>
          Replay a repro.toml (events + optional schedule_seed / pct_d / pct_k + optional fault_seed)
      --oracles
          Mutate residual Property.check / Property.assert / .require predicates
      --no-fail-fast
          Finish search and still mutate after the first search failure
      --relate
          Judge (Timeline, Timeline) => Verdict relation claims: replay each corpus entry under its own and a perturbed schedule, then exit
      --differential
          Compare live structural dumps across Skia backends (skia, sk_sw, gpu)
  -h, --help
          Print help

Examples:
  scuzz fuzz --iterations 16
  scuzz fuzz --iterations 16 examples/counter
  scuzz fuzz --iterations 0
  scuzz fuzz --oracles examples/counter
  scuzz fuzz --replay build/fuzz/repro.toml
  scuzz fuzz --no-fail-fast --iterations 8 examples/bad-example
  scuzz fuzz --differential --iterations 0 examples/counter

See: scuzz docs verify
"""

def helpNew(): String =
  """Create a new Scuzz Lang project

Usage: scuzz new [OPTIONS] <NAME>

Arguments:
  <NAME>  

Options:
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
      --path <PATH>
          [default: .]
      --ui
          Scaffold a Headless UI sample instead of an IO hello
  -h, --help
          Print help

Examples:
  scuzz new mycli
  scuzz new myapp --ui
  scuzz new myapp --ui --path /tmp

See: scuzz docs start
"""

