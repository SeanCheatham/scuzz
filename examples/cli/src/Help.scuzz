def helpPkg(): String =
  """Package a project for host, Android, iOS, or web

Usage: scuzz package [OPTIONS] [PATH]

Arguments:
  [PATH]  [default: .]

Options:
      --target <TARGET>
          host, android, ios, web, or all [default: host]
      --out-dir <OUT_DIR>
          [default: build]
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
  -h, --help
          Print help

Examples:
  scuzz package --target host
  scuzz package --target android examples/counter
  scuzz package --target web examples/docs

See: scuzz docs web
"""

def helpDocs(): String =
  """Print the technical manual, or one topic, or a kit row

Usage: scuzz docs [TOPIC]
       scuzz docs kits
       scuzz docs kit <Name.op>

Arguments:
  [TOPIC]  Topic id. Omit to list topics.

Options:
  -h, --help
          Print help

Examples:
  scuzz docs
  scuzz docs verify
  scuzz docs kits
  scuzz docs kit Str.len

See: scuzz docs start
"""

