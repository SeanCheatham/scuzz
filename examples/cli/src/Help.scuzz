def helpExec(): String =
  """Send inject ops to a live session started by `scuzz run`

Usage: scuzz exec [OPTIONS] [PATH] OP [ARGS...]

Arguments:
  [PATH]       Package path of the running app [default: .]
  OP [ARGS...]  Ops played in order: tap N | tap id:KEY | xy X Y | text S | type S | key K |
               scroll DY | pump K | backspace K | snapshot PATH | dump | reload | quit

Options:
      --out-dir <OUT_DIR>
          Out dir of the running app [default: build]
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
  -h, --help
          Print help

Writes one inject document (schema v=1) to <out-dir>/inject.json. The live session plays it on the next pump. Read the session back from <out-dir>/debug.json; snapshot writes a PNG.

Examples:
  scuzz exec examples/counter tap id:button:+1
  scuzz exec . type hello snapshot build/typed.png
  scuzz exec . dump
  scuzz exec . quit

See: scuzz docs commands
"""

def helpPkg(): String =
  """Package a project for Linux, macOS, Android, iOS, or web

Usage: scuzz package [OPTIONS] [PATH]

Arguments:
  [PATH]  [default: .]

Options:
      --target <TARGET>
          linux, macos, android, ios, web, or all [default: the host platform]
      --out-dir <OUT_DIR>
          [default: build]
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
  -h, --help
          Print help

Examples:
  scuzz package
  scuzz package --target linux
  scuzz package --target android examples/counter
  scuzz package --target web examples/docs

See: scuzz docs web
"""

