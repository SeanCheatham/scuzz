def helpRoot(): String =
  """Scuzz Lang CLI

Usage: scuzz [OPTIONS] <COMMAND>

Commands:
  build    Compile a Scuzz Lang project to a native executable (LLVM)
  run      Build and run a Scuzz Lang project
  watch    Watch sources and rebuild on change (compile loop, not hot reload)
  check    Format-verify src/ + parse + typecheck (the linter; no codegen / link). JSON with --message-format=json
  lsp      Language server wrapping `scuzz check` JSON diagnostics (stdin/stdout LSP)
  fmt      Format Scuzz Lang sources under src/
  fuzz     Search in-source properties, drivers, and [taps] events under TestRuntime; mix coverage-guided search and mutation
  new      Create a new Scuzz Lang project
  ide      Launch the bundled Scuzz IDE (`[ui]` package in the SDK)
  package  Package a project for host, Android, iOS, or web
  docs     Print the technical manual, or one topic, or a kit row
  help     Print this message or the help of the given subcommand(s)

Options:
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
  -h, --help
          Print help
  -V, --version
          Print version

Examples:
  scuzz new myapp --ui
  scuzz check
  scuzz docs verify
  scuzz fuzz --iterations 0
  scuzz run --headless

See: scuzz docs start
"""

def helpFmt(): String =
  """Format Scuzz Lang sources under src/

Usage: scuzz fmt [OPTIONS] [PATH]

Arguments:
  [PATH]  [default: .]

Options:
      --check
          Check only (nonzero exit if files need reformat)
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
  -h, --help
          Print help

Examples:
  scuzz fmt
  scuzz fmt --check
  scuzz fmt examples/hello

See: scuzz docs commands
"""

def helpCheck(): String =
  """Format-verify src/ + parse + typecheck (the linter; no codegen / link). JSON with --message-format=json

Usage: scuzz check [OPTIONS] [PATH]

Arguments:
  [PATH]  [default: .]

Options:
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
  -h, --help
          Print help

Examples:
  scuzz check
  scuzz check examples/kernel
  scuzz check --message-format=json

See: scuzz docs commands
"""

def helpBuild(): String =
  """Compile a Scuzz Lang project to a native executable (LLVM)

Usage: scuzz build [OPTIONS] [PATH]

Arguments:
  [PATH]  Project directory containing scuzz.toml [default: .]

Options:
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
      --out-dir <OUT_DIR>
          Output directory [default: build]
      --full
          Force a full rebuild (ignore incremental fingerprint)
      --verify
          Apply `*.scuzz_scenario` / `*.scuzz_verify` + residual `.require` / `where` (TestRuntime / fuzz graph)
  -h, --help
          Print help

Examples:
  scuzz build
  scuzz build --full examples/hello
  scuzz build --verify examples/counter

See: scuzz docs commands
"""

def helpRun(): String =
  """Build and run a Scuzz Lang project

Usage: scuzz run [OPTIONS] [PATH]

Arguments:
  [PATH]  [default: .]

Options:
      --headless
          Force Headless UiRuntime (overrides [ui].default_runtime; no display needed)
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
      --out-dir <OUT_DIR>
          [default: build]
      --watch
          Keep running; [ui] hot-reloads the View tree; IO-only kills and reruns on source change
      --script <PATH>
          Inject document path (SCUZZ_UI_SCRIPT); JSON schema v=1; played after the first pump
      --dump <PATH>
          Structural dump path at finish (SCUZZ_FUZZ_DUMP)
  -h, --help
          Print help

Examples:
  scuzz run
  scuzz run --headless
  scuzz run examples/studio
  scuzz run --headless --script examples/studio/build/record.json --dump examples/studio/build/debug.json examples/studio
  scuzz run --watch --headless

See: scuzz docs commands
"""

def helpFuzz(): String =
  """Probe the live graph under TestRuntime, then replay corpus and seeds, then search, then mutation

Usage: scuzz fuzz [OPTIONS] [PATH]

Arguments:
  [PATH]  [default: .]

Options:
      --iterations <ITERATIONS>
          Iteration budget. Search then mutation. `0` replays corpus/ only [default: 32]
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
      --seed <SEED>
          Deterministic LCG seed [default: 42]
      --replay <REPLAY>
          Replay a repro.toml (events + optional schedule_seed / pct_d / pct_k + optional fault_seed)
      --oracles
          Mutate residual Property.check / Property.assert / .require predicates
      --no-fail-fast
          Finish search and still mutate after the first search failure
      --relate
          Judge (Timeline, Timeline) => Verdict relation claims: replay each corpus entry under its own and a perturbed schedule, then exit
      --differential
          Compare live structural dumps across Skia backends (skia, sk_sw, gpu)
  -h, --help
          Print help

Examples:
  scuzz fuzz --iterations 16
  scuzz fuzz --iterations 16 examples/counter
  scuzz fuzz --iterations 0
  scuzz fuzz --oracles examples/counter
  scuzz fuzz --replay build/fuzz/repro.toml
  scuzz fuzz --no-fail-fast --iterations 8 examples/bad-example
  scuzz fuzz --differential --iterations 0 examples/counter

See: scuzz docs verify
"""

def helpNew(): String =
  """Create a new Scuzz Lang project

Usage: scuzz new [OPTIONS] <NAME>

Arguments:
  <NAME>  

Options:
      --message-format <MESSAGE_FORMAT>
          Diagnostic format: human (default) or json (`scuzz check` only) [default: human] [possible values: human, json]
      --path <PATH>
          [default: .]
      --ui
          Scaffold a Headless UI sample instead of an IO hello
  -h, --help
          Print help

Examples:
  scuzz new mycli
  scuzz new myapp --ui
  scuzz new myapp --ui --path /tmp

See: scuzz docs start
"""

