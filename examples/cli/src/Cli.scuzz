enum Cmd:
  case Help(topic: String)
  case Version
  case Fail(msg: String)
  case Fmt(path: String, check: Bool)
  case Check(path: String, json: Bool)
  case Eval(path: String, probe: Bool)
  case Build(path: String, outDir: String, full: Bool, verify: Bool)
  case Run(path: String, outDir: String, target: String, watch: Bool, exec: String, hasExec: Bool, dump: String, snap: String, device: String)
  case Devices
  case Watch(path: String, outDir: String)
  case Lsp(path: String)
  case Fuzz(path: String, iterations: Int, seed: Int, replay: String, oracles: Bool, noFailFast: Bool, relate: Bool, differential: Bool, live: Bool, asan: Bool, session: Bool)
  case Diff(path: String, rev: String, iterations: Int, seed: Int, json: Bool)
  case New(name: String, path: String, ui: Bool)
  case Ide(path: String, outDir: String, target: String)
  case Exec(path: String, outDir: String, ops: List[String])
  case Package(path: String, outDir: String, target: String)
  case Docs(mode: String, arg: String)

import Parse.Prog
import Manifest.Man

def arg(xs: List[String], i: Int): String =
  if (i < 0 || i >= List.len(xs)) "" else List.at(xs, i)

def yn(b: Bool): String =
  if (b) "true" else "false"

def isFlag(s: String): Bool =
  Str.startsWith(s, "-") && s != "-"

def isHelp(s: String): Bool =
  s == "-h" || s == "--help"

def isVer(s: String): Bool =
  s == "-V" || s == "--version"

def isCmd(s: String): Bool =
  s == "devices" || s == "build" || s == "run" || s == "watch" || s == "check" || s == "eval" || s == "lsp" || s == "fmt" || s == "fuzz" || s == "diff" || s == "new" || s == "ide" || s == "exec" || s == "package" || s == "docs" || s == "help"

def unrec(name: String): String =
  Str.concat("error: unrecognized subcommand '", Str.concat(name, """'

Usage: scuzz [OPTIONS] <COMMAND>

For more information, try '--help'.
"""))

def unexp(flag: String, usage: String): String =
  Str.concat("error: unexpected argument '", Str.concat(flag, Str.concat("""' found

  tip: to pass '""", Str.concat(flag, Str.concat("' as a value, use '-- ", Str.concat(flag, Str.concat("""'

Usage: """, Str.concat(usage, """

For more information, try '--help'.
"""))))))))

def needVal(name: String): String =
  if (name == "--message-format") """error: a value is required for '--message-format <MESSAGE_FORMAT>' but none was supplied
  [possible values: human, json]

For more information, try '--help'.
""" else if (name == "--iterations") """error: a value is required for '--iterations <ITERATIONS>' but none was supplied

For more information, try '--help'.
""" else Str.concat("error: a value is required for '", Str.concat(name, """' but none was supplied

For more information, try '--help'.
"""))

def badFmt(v: String): String =
  Str.concat("error: invalid value '", Str.concat(v, """' for '--message-format <MESSAGE_FORMAT>'
  [possible values: human, json]

For more information, try '--help'.
"""))

def jsonOnly(): String =
  """scuzz error: --message-format=json applies to `scuzz check` and `scuzz diff` only
"""

def missName(): String =
  """error: the following required arguments were not provided:
  <NAME>

Usage: scuzz new <NAME>

For more information, try '--help'.
"""

def missCmd(): String =
  Help.helpRoot()

def extraArg(a: String, usage: String): String =
  Str.concat("error: unexpected argument '", Str.concat(a, Str.concat("""' found

Usage: """, Str.concat(usage, """

For more information, try '--help'.
"""))))

def badInt(name: String, v: String): String =
  Str.concat("error: invalid value '", Str.concat(v, Str.concat("' for '", Str.concat(name, """'

For more information, try '--help'.
"""))))

def relateOnly(): String =
  """error: --relate does not accept --iterations, --seed, --replay, --oracles, or --no-fail-fast

Usage: scuzz fuzz [OPTIONS] [PATH]

For more information, try '--help'.
"""

def liveOnly(): String =
  """error: --live replays on the loopback transport. Pass --replay or --iterations 0. It does not accept --relate, --differential, --oracles, or --no-fail-fast

Usage: scuzz fuzz [OPTIONS] [PATH]

For more information, try '--help'.
"""

def sessionOnly(): String =
  """error: --session replays URLSession certificate checks and TLS errors on loopback. Pass --replay or --iterations 0. It does not accept --live, --asan, --relate, --differential, --oracles, or --no-fail-fast

Usage: scuzz fuzz [OPTIONS] [PATH]

For more information, try '--help'.
"""

def asanOnly(): String =
  """error: --asan replays on the compiled engine under AddressSanitizer. Pass --replay or --iterations 0. It does not accept --relate, --differential, --oracles, or --no-fail-fast

Usage: scuzz fuzz [OPTIONS] [PATH]

For more information, try '--help'.
"""

def badName(name: String): String =
  Str.concat("error: invalid project name '", Str.concat(name, """'; use [A-Za-z_][A-Za-z0-9_-]*

For more information, try '--help'.
"""))

def missIde(): String =
  "scuzz ide: editor package not found (set SCUZZ_IDE, or SCUZZ_HOME/ide, or run from a checkout with examples/editor)"

def existNew(dir: String): String =
  Str.concat("scuzz new: ", Str.concat(Drive.joinSlash(dir, "scuzz.toml"), " already exists"))

def orDot(path: String): String =
  if (path == "") "." else path

def isDigits(s: String): Bool =
  s != "" && Manifest.allDigits(s, 0)

def parseFlagNat(s: String): (Bool, Int) =
  if (!isDigits(s)) (false, 0) else parseFlagNatGot(s, Str.toInt(s, 0))

def parseFlagNatGot(s: String, n: Int): (Bool, Int) =
  if (Str.fromInt(n) != s) (false, 0) else (true, n)

def parseFlagInt(s: String): (Bool, Int) =
  if (s == "") (false, 0) else if (Str.charAt(s, 0) == 45) parseFlagNeg(s) else parseFlagNat(s)

def parseFlagNeg(s: String): (Bool, Int) =
  if (Str.len(s) < 2) (false, 0) else parseFlagNegRest(s, Str.slice(s, 1, Str.len(s)))

def parseFlagNegRest(s: String, rest: String): (Bool, Int) =
  if (!isDigits(rest)) (false, 0) else parseFlagNegGot(s, Str.toInt(s, 0))

def parseFlagNegGot(s: String, n: Int): (Bool, Int) =
  if (Str.fromInt(n) != s) (false, 0) else (true, n)

def showFlagNat(s: String): String =
  showFlagGot(parseFlagNat(s))

def showFlagInt(s: String): String =
  showFlagGot(parseFlagInt(s))

def showFlagGot(p: (Bool, Int)): String =
  p match {
    case (ok, n) => if (!ok) "fail" else Str.fromInt(n)
  }

def resolveIdeDir(ideEnv: String, homeIde: String, checkout: String): String =
  if (ideEnv != "") ideEnv else if (homeIde != "") homeIde else checkout

def runExtra(path: String): String =
  Str.concat(" ", Drive.shQuote(orDot(path)))

def okPkgName(s: String): Bool =
  s != "" && okNameStart(Str.charAt(s, 0)) && okNameRest(s, 1)

def okNameStart(c: Int): Bool =
  c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95

def okNameRest(s: String, i: Int): Bool =
  if (i >= Str.len(s)) true else okNameChar(Str.charAt(s, i)) && okNameRest(s, i + 1)

def okNameChar(c: Int): Bool =
  okNameStart(c) || c >= 48 && c <= 57 || c == 45

def fuzzHasCamp(args: List[String], i: Int): Bool =
  if (i >= List.len(args)) false else fuzzCampTok(arg(args, i)) || fuzzHasCamp(args, i + 1)

def fuzzCampTok(a: String): Bool =
  a == "--oracles" || a == "--no-fail-fast" || a == "--iterations" || flagPref(a, "--iterations") || a == "--seed" || flagPref(a, "--seed") || a == "--replay" || flagPref(a, "--replay")

def flagPref(a: String, name: String): Bool =
  Str.startsWith(a, Str.concat(name, "="))

def takeVal(args: List[String], i: Int, name: String): (String, Int) =
  takeVal2(args, i, name, arg(args, i))

def takeVal2(args: List[String], i: Int, name: String, a: String): (String, Int) =
  if (flagPref(a, name)) (Str.slice(a, Str.len(name) + 1, Str.len(a)), i + 1) else if (a == name) takeVal3(args, i + 1) else ("", 0 - 2)

def takeVal3(args: List[String], j: Int): (String, Int) =
  if (j >= List.len(args)) ("", 0 - 1) else (arg(args, j), j + 1)

def helpOf(topic: String): String =
  if (topic == "" || topic == "help") Help.helpRoot() else if (topic == "fmt") Help.helpFmt() else if (topic == "check") Help.helpCheck() else if (topic == "eval") Help.helpEv() else if (topic == "build") Help.helpBuild() else if (topic == "run") Help.helpRun() else if (topic == "devices") Help.helpDevices() else if (topic == "fuzz") Help.helpFuzz() else if (topic == "diff") Help.helpDiff() else if (topic == "new") Help.helpNew() else if (topic == "lsp") Help.helpLsp() else if (topic == "watch") Help.helpWatch() else if (topic == "ide") Help.helpIde() else if (topic == "exec") Help.helpExec() else if (topic == "package") Help.helpPkg() else if (topic == "docs") Help.helpDocs() else unrec(topic)

def show(c: Cmd): String =
  c match {
    case Cmd.Help(t) => Str.concat("help:", t)
    case Cmd.Version => "version"
    case Cmd.Fail(m) => Str.concat("fail:", m)
    case Cmd.Fmt(path, check) => Str.concat("fmt path=", Str.concat(path, Str.concat(" check=", yn(check))))
    case Cmd.Check(path, json) => Str.concat("check path=", Str.concat(path, Str.concat(" json=", yn(json))))
    case Cmd.Eval(path, probe) => Str.concat("eval path=", Str.concat(path, Str.concat(" probe=", yn(probe))))
    case Cmd.Build(path, outDir, full, verify) => Str.concat("build path=", Str.concat(path, Str.concat(" out=", Str.concat(outDir, Str.concat(" full=", Str.concat(yn(full), Str.concat(" verify=", yn(verify))))))))
    case Cmd.Run(path, outDir, target, watch, exec, hasExec, dump, snap, device) => Str.concat("run path=", Str.concat(path, Str.concat(" out=", Str.concat(outDir, Str.concat(" target=", Str.concat(target, Str.concat(" watch=", Str.concat(yn(watch), Str.concat(" exec=", Str.concat(exec, Str.concat(" hasExec=", Str.concat(yn(hasExec), Str.concat(" dump=", Str.concat(dump, Str.concat(" snap=", Str.concat(snap, Str.concat(" device=", device)))))))))))))))))
    case Cmd.Devices => "devices"
    case Cmd.Watch(path, outDir) => Str.concat("watch path=", Str.concat(path, Str.concat(" out=", outDir)))
    case Cmd.Lsp(path) => Str.concat("lsp path=", path)
    case Cmd.Fuzz(path, iterations, seed, replay, oracles, noFailFast, relate, differential, live, asan, session) => Str.concat("fuzz path=", Str.concat(path, Str.concat(" iterations=", Str.concat(Str.fromInt(iterations), Str.concat(" seed=", Str.concat(Str.fromInt(seed), Str.concat(" replay=", Str.concat(replay, Str.concat(" oracles=", Str.concat(yn(oracles), Str.concat(" noFailFast=", Str.concat(yn(noFailFast), Str.concat(" relate=", Str.concat(yn(relate), Str.concat(" differential=", Str.concat(yn(differential), Str.concat(" live=", Str.concat(yn(live), Str.concat(" asan=", Str.concat(yn(asan), Str.concat(" session=", yn(session))))))))))))))))))))))
    case Cmd.Diff(path, rev, iterations, seed, json) => Str.concat("diff path=", Str.concat(path, Str.concat(" rev=", Str.concat(rev, Str.concat(" iterations=", Str.concat(Str.fromInt(iterations), Str.concat(" seed=", Str.concat(Str.fromInt(seed), Str.concat(" json=", yn(json))))))))))
    case Cmd.New(name, path, ui) => Str.concat("new name=", Str.concat(name, Str.concat(" path=", Str.concat(path, Str.concat(" ui=", yn(ui))))))
    case Cmd.Ide(path, outDir, target) => Str.concat("ide path=", Str.concat(path, Str.concat(" out=", Str.concat(outDir, Str.concat(" target=", target)))))
    case Cmd.Exec(path, outDir, ops) => Str.concat("exec path=", Str.concat(path, Str.concat(" out=", Str.concat(outDir, Str.concat(" ops=", joinOps(ops))))))
    case Cmd.Package(path, outDir, target) => Str.concat("package path=", Str.concat(path, Str.concat(" out=", Str.concat(outDir, Str.concat(" target=", target)))))
    case Cmd.Docs(mode, arg) => Str.concat("docs mode=", Str.concat(mode, Str.concat(" arg=", arg)))
  }

def render(c: Cmd): String =
  c match {
    case Cmd.Help(t) => helpOf(t)
    case Cmd.Version => Version.line()
    case Cmd.Fail(m) => m
    case Cmd.Docs(mode, arg) => docsOut(mode, arg)
    case _ => show(c)
  }

def gateJson(c: Cmd, json: Bool): Cmd =
  if (!json) c else c match {
  case Cmd.Check(path, _) => Cmd.Check(path, true)
  case Cmd.Diff(path, rev, iterations, seed, _) => Cmd.Diff(path, rev, iterations, seed, true)
  case Cmd.Help(_) => c
  case Cmd.Version => c
  case Cmd.Fail(_) => c
  case _ => Cmd.Fail(jsonOnly())
}

def parse(args: List[String]): Cmd =
  parseAt(args, 0, false)

def parseAt(args: List[String], i: Int, json: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Fail(missCmd()), json) else parseTok(args, i, json, arg(args, i))

def parseTok(args: List[String], i: Int, json: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help(""), json) else if (isVer(a)) gateJson(Cmd.Version, json) else if (a == "--message-format" || flagPref(a, "--message-format")) parseMsg(args, i) else if (a == "help") parseHelp(args, i + 1, json) else if (isCmd(a)) parseCmd(args, a, i + 1, json) else if (isFlag(a)) gateJson(Cmd.Fail(unexp(a, "scuzz [OPTIONS] <COMMAND>")), json) else gateJson(Cmd.Fail(unrec(a)), json)

def parseMsg(args: List[String], i: Int): Cmd =
  parseMsg2(takeVal(args, i, "--message-format"), args)

def parseMsg2(p: (String, Int), args: List[String]): Cmd =
  p match {
    case (_, n) => if (n == 0 - 1) Cmd.Fail(needVal("--message-format")) else if (n == 0 - 2) Cmd.Fail(unexp(arg(args, 0), "scuzz [OPTIONS] <COMMAND>")) else parseMsg3(p._1, args, p._2)
  }

def parseMsg3(v: String, args: List[String], j: Int): Cmd =
  if (v == "json") parseAt(args, j, true) else if (v == "human") parseAt(args, j, false) else Cmd.Fail(badFmt(v))

def parseHelp(args: List[String], i: Int, json: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Help(""), json) else if (isCmd(arg(args, i)) || arg(args, i) == "") gateJson(Cmd.Help(arg(args, i)), json) else gateJson(Cmd.Fail(unrec(arg(args, i))), json)

def parseCmd(args: List[String], cmd: String, i: Int, json: Bool): Cmd =
  if (cmd == "devices") parseDevices(args, i, json) else if (cmd == "fmt") parseFmt(args, i, json, "", false) else if (cmd == "check") parseCheck(args, i, json, "") else if (cmd == "eval") parseEv(args, i, json, "", false) else if (cmd == "build") parseBuild(args, i, json, "", "build", false, false) else if (cmd == "run") parseRun(args, i, json, "", "build", "", false, "", false, "", "", "") else if (cmd == "watch") parseWatch(args, i, json, "", "build") else if (cmd == "lsp") parseLsp(args, i, json, "") else if (cmd == "fuzz") parseFuzz(args, i, json, "", 32, 42, "", false, false, false, false, false, false, false) else if (cmd == "diff") parseDiff(args, i, json, "", "", 0, 42) else if (cmd == "new") parseNew(args, i, json, "", ".", false) else if (cmd == "ide") parseIde(args, i, json, "", "build", "") else if (cmd == "exec") parseExec(args, i, json, "", "build", []) else if (cmd == "docs") parseDocs(args, i, json) else parsePkg(args, i, json, "", "build", "")

def parseDocs(args: List[String], i: Int, json: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Docs("list", ""), json) else parseDocsTok(args, i, json, arg(args, i))

def parseDocsTok(args: List[String], i: Int, json: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("docs"), json) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz docs [TOPIC]")) else if (a == "kits") parseDocsEnd(args, i + 1, json, "kits", "") else if (a == "kit") parseDocsKit(args, i + 1, json) else parseDocsEnd(args, i + 1, json, "topic", a)

def parseDocsKit(args: List[String], i: Int, json: Bool): Cmd =
  if (i >= List.len(args)) Cmd.Fail(needVal("kit")) else if (isFlag(arg(args, i))) Cmd.Fail(unexp(arg(args, i), "scuzz docs kit <Name.op>")) else parseDocsEnd(args, i + 1, json, "kit", arg(args, i))

def parseDocsEnd(args: List[String], i: Int, json: Bool, mode: String, topic: String): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Docs(mode, topic), json) else Cmd.Fail(extraArg(arg(args, i), "scuzz docs [TOPIC]"))

def docsOut(mode: String, topic: String): String =
  if (mode == "list") Manual.renderList() else if (mode == "kits") Kits.formatAll() else if (mode == "kit") docsKit(topic) else Manual.renderTopic(topic)

def docsKit(name: String): String =
  if (Kits.formatName(name) == "") Str.concat("scuzz docs: unknown kit '", Str.concat(name, """'
""")) else Str.concat(Kits.formatName(name), """
""")

def docsUnknown(mode: String, topic: String): Bool =
  mode == "topic" && !Manual.hasTopic(topic) || mode == "kit" && Kits.formatName(topic) == ""

def parseFmt(args: List[String], i: Int, json: Bool, path: String, check: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Fmt(orDot(path), check), json) else parseFmtTok(args, i, json, path, check, arg(args, i))

def parseFmtTok(args: List[String], i: Int, json: Bool, path: String, check: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("fmt"), json) else if (a == "--check") parseFmt(args, i + 1, json, path, true) else if (a == "--message-format" || flagPref(a, "--message-format")) parseFmtMsg(takeVal(args, i, "--message-format"), args, path, check) else if (a == "--") parseFmtPos(args, i + 1, json, path, check) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz fmt [OPTIONS] [PATH]")) else if (path != "") Cmd.Fail(extraArg(a, "scuzz fmt [OPTIONS] [PATH]")) else parseFmt(args, i + 1, json, a, check)

def parseFmtMsg(p: (String, Int), args: List[String], path: String, check: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(if (n == 0 - 1) needVal("--message-format") else unexp(arg(args, 0), "scuzz fmt [OPTIONS] [PATH]")) else if (v == "json") parseFmt(args, n, true, path, check) else if (v == "human") parseFmt(args, n, false, path, check) else Cmd.Fail(badFmt(v))
  }

def parseFmtPos(args: List[String], i: Int, json: Bool, path: String, check: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Fmt(orDot(path), check), json) else if (path != "") Cmd.Fail(extraArg(arg(args, i), "scuzz fmt [OPTIONS] [PATH]")) else parseFmt(args, i + 1, json, arg(args, i), check)

def parseCheck(args: List[String], i: Int, json: Bool, path: String): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Check(orDot(path), json), json) else parseCheckTok(args, i, json, path, arg(args, i))

def parseCheckTok(args: List[String], i: Int, json: Bool, path: String, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("check"), json) else if (a == "--message-format" || flagPref(a, "--message-format")) parseCheckMsg(takeVal(args, i, "--message-format"), args, path) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz check [OPTIONS] [PATH]")) else if (path != "") Cmd.Fail(extraArg(a, "scuzz check [OPTIONS] [PATH]")) else parseCheck(args, i + 1, json, a)

def parseCheckMsg(p: (String, Int), args: List[String], path: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(if (n == 0 - 1) needVal("--message-format") else unexp(arg(args, 0), "scuzz check [OPTIONS] [PATH]")) else if (v == "json") parseCheck(args, n, true, path) else if (v == "human") parseCheck(args, n, false, path) else Cmd.Fail(badFmt(v))
  }

def parseEv(args: List[String], i: Int, json: Bool, path: String, probe: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Eval(orDot(path), probe), json) else parseEvTok(args, i, json, path, probe, arg(args, i))

def parseEvTok(args: List[String], i: Int, json: Bool, path: String, probe: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("eval"), json) else if (a == "--probe") parseEv(args, i + 1, json, path, true) else if (a == "--message-format" || flagPref(a, "--message-format")) parseEvMsg(takeVal(args, i, "--message-format"), args, path, probe) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz eval [OPTIONS] [PATH]")) else if (path != "") Cmd.Fail(extraArg(a, "scuzz eval [OPTIONS] [PATH]")) else parseEv(args, i + 1, json, a, probe)

def parseEvMsg(p: (String, Int), args: List[String], path: String, probe: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(if (n == 0 - 1) needVal("--message-format") else unexp(arg(args, 0), "scuzz eval [OPTIONS] [PATH]")) else if (v == "json") parseEv(args, n, true, path, probe) else if (v == "human") parseEv(args, n, false, path, probe) else Cmd.Fail(badFmt(v))
  }

def parseBuild(args: List[String], i: Int, json: Bool, path: String, outDir: String, full: Bool, verify: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Build(orDot(path), outDir, full, verify), json) else parseBuildTok(args, i, json, path, outDir, full, verify, arg(args, i))

def parseBuildTok(args: List[String], i: Int, json: Bool, path: String, outDir: String, full: Bool, verify: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("build"), json) else if (a == "--full") parseBuild(args, i + 1, json, path, outDir, true, verify) else if (a == "--verify") parseBuild(args, i + 1, json, path, outDir, full, true) else if (a == "--out-dir" || flagPref(a, "--out-dir")) parseBuildOut(takeVal(args, i, "--out-dir"), args, json, path, full, verify) else if (a == "--message-format" || flagPref(a, "--message-format")) parseBuildMsg(takeVal(args, i, "--message-format"), args, path, outDir, full, verify) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz build [OPTIONS] [PATH]")) else if (path != "") Cmd.Fail(extraArg(a, "scuzz build [OPTIONS] [PATH]")) else parseBuild(args, i + 1, json, a, outDir, full, verify)

def parseBuildOut(p: (String, Int), args: List[String], json: Bool, path: String, full: Bool, verify: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--out-dir")) else parseBuild(args, n, json, path, v, full, verify)
  }

def parseBuildMsg(p: (String, Int), args: List[String], path: String, outDir: String, full: Bool, verify: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseBuild(args, n, true, path, outDir, full, verify) else if (v == "human") parseBuild(args, n, false, path, outDir, full, verify) else Cmd.Fail(badFmt(v))
  }

def okRunTarget(t: String): Bool =
  t == "" || t == "headless" || t == "linux" || t == "macos" || t == "android" || t == "ios"

def badRunTarget(t: String): String =
  Str.concat("error: invalid value '", Str.concat(t, """' for '--target <TARGET>'
  [possible values: linux, macos, headless, android, ios]

For more information, try '--help'.
"""))

def parseRun(args: List[String], i: Int, json: Bool, path: String, outDir: String, target: String, watch: Bool, exec: String, hasExec: Bool, dump: String, snap: String, device: String): Cmd =
  if (i >= List.len(args)) runDone(json, path, outDir, target, watch, exec, hasExec, dump, snap, device) else parseRunTok(args, i, json, path, outDir, target, watch, exec, hasExec, dump, snap, device, arg(args, i))

def runDone(json: Bool, path: String, outDir: String, target: String, watch: Bool, exec: String, hasExec: Bool, dump: String, snap: String, device: String): Cmd =
  if (!okRunTarget(target)) Cmd.Fail(badRunTarget(target)) else gateJson(runCommand(path, outDir, target, watch, exec, hasExec, dump, snap, device), json)

def parseRunTok(args: List[String], i: Int, json: Bool, path: String, outDir: String, target: String, watch: Bool, exec: String, hasExec: Bool, dump: String, snap: String, device: String, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("run"), json) else if (a == "--watch") parseRun(args, i + 1, json, path, outDir, target, true, exec, hasExec, dump, snap, device) else if (a == "--target" || flagPref(a, "--target")) parseRunTarget(takeVal(args, i, "--target"), args, json, path, outDir, watch, exec, hasExec, dump, snap, device) else if (a == "--device" || flagPref(a, "--device")) parseRunDevice(takeVal(args, i, "--device"), args, json, path, outDir, target, watch, exec, hasExec, dump, snap) else if (a == "--out-dir" || flagPref(a, "--out-dir")) parseRunOut(takeVal(args, i, "--out-dir"), args, json, path, target, watch, exec, hasExec, dump, snap, device) else if (a == "--exec" || flagPref(a, "--exec")) parseRunExec(takeVal(args, i, "--exec"), args, json, path, outDir, target, watch, dump, snap, device) else if (a == "--dump" || flagPref(a, "--dump")) parseRunDump(takeVal(args, i, "--dump"), args, json, path, outDir, target, watch, exec, hasExec, snap, device) else if (a == "--snapshot-out" || flagPref(a, "--snapshot-out")) parseRunSnap(takeVal(args, i, "--snapshot-out"), args, json, path, outDir, target, watch, exec, hasExec, dump, device) else if (a == "--message-format" || flagPref(a, "--message-format")) parseRunMsg(takeVal(args, i, "--message-format"), args, path, outDir, target, watch, exec, hasExec, dump, snap, device) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz run [OPTIONS] [PATH]")) else if (path != "") Cmd.Fail(extraArg(a, "scuzz run [OPTIONS] [PATH]")) else parseRun(args, i + 1, json, a, outDir, target, watch, exec, hasExec, dump, snap, device)

def parseRunTarget(p: (String, Int), args: List[String], json: Bool, path: String, outDir: String, watch: Bool, exec: String, hasExec: Bool, dump: String, snap: String, device: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--target")) else parseRun(args, n, json, path, outDir, v, watch, exec, hasExec, dump, snap, device)
  }

def parseRunDevice(p: (String, Int), args: List[String], json: Bool, path: String, outDir: String, target: String, watch: Bool, exec: String, hasExec: Bool, dump: String, snap: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--device")) else parseRun(args, n, json, path, outDir, target, watch, exec, hasExec, dump, snap, v)
  }

def parseRunOut(p: (String, Int), args: List[String], json: Bool, path: String, target: String, watch: Bool, exec: String, hasExec: Bool, dump: String, snap: String, device: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--out-dir")) else parseRun(args, n, json, path, v, target, watch, exec, hasExec, dump, snap, device)
  }

def parseRunExec(p: (String, Int), args: List[String], json: Bool, path: String, outDir: String, target: String, watch: Bool, dump: String, snap: String, device: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--exec")) else parseRun(args, n, json, path, outDir, target, watch, v, true, dump, snap, device)
  }

def parseRunDump(p: (String, Int), args: List[String], json: Bool, path: String, outDir: String, target: String, watch: Bool, exec: String, hasExec: Bool, snap: String, device: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--dump")) else parseRun(args, n, json, path, outDir, target, watch, exec, hasExec, v, snap, device)
  }

def parseRunSnap(p: (String, Int), args: List[String], json: Bool, path: String, outDir: String, target: String, watch: Bool, exec: String, hasExec: Bool, dump: String, device: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--snapshot-out")) else parseRun(args, n, json, path, outDir, target, watch, exec, hasExec, dump, v, device)
  }

def parseRunMsg(p: (String, Int), args: List[String], path: String, outDir: String, target: String, watch: Bool, exec: String, hasExec: Bool, dump: String, snap: String, device: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseRun(args, n, true, path, outDir, target, watch, exec, hasExec, dump, snap, device) else if (v == "human") parseRun(args, n, false, path, outDir, target, watch, exec, hasExec, dump, snap, device) else Cmd.Fail(badFmt(v))
  }

def runCommand(path: String, outDir: String, target: String, watch: Bool, exec: String, hasExec: Bool, dump: String, snap: String, device: String): Cmd =
  if (target == "ios" && (hasExec || dump != "" || snap != "")) Cmd.Fail("error: --target ios does not accept --exec, --snapshot-out, or --dump. Use the host headless path for replay.") else if (target != "ios" && device != "") Cmd.Fail("error: --device needs --target ios. List simulators with scuzz devices.") else Cmd.Run(orDot(path), outDir, target, watch, exec, hasExec, dump, snap, device)

def parseDevices(args: List[String], i: Int, json: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Devices, json) else if (isHelp(arg(args, i)) && i + 1 == List.len(args)) gateJson(Cmd.Help("devices"), json) else Cmd.Fail(unexp(arg(args, i), "scuzz devices"))

def parseWatch(args: List[String], i: Int, json: Bool, path: String, outDir: String): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Watch(orDot(path), outDir), json) else parseWatchTok(args, i, json, path, outDir, arg(args, i))

def parseWatchTok(args: List[String], i: Int, json: Bool, path: String, outDir: String, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("watch"), json) else if (a == "--out-dir" || flagPref(a, "--out-dir")) parseWatchOut(takeVal(args, i, "--out-dir"), args, json, path) else if (a == "--message-format" || flagPref(a, "--message-format")) parseWatchMsg(takeVal(args, i, "--message-format"), args, path, outDir) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz watch [OPTIONS] [PATH]")) else if (path != "") Cmd.Fail(extraArg(a, "scuzz watch [OPTIONS] [PATH]")) else parseWatch(args, i + 1, json, a, outDir)

def parseWatchOut(p: (String, Int), args: List[String], json: Bool, path: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--out-dir")) else parseWatch(args, n, json, path, v)
  }

def parseWatchMsg(p: (String, Int), args: List[String], path: String, outDir: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseWatch(args, n, true, path, outDir) else if (v == "human") parseWatch(args, n, false, path, outDir) else Cmd.Fail(badFmt(v))
  }

def parseLsp(args: List[String], i: Int, json: Bool, path: String): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Lsp(orDot(path)), json) else parseLspTok(args, i, json, path, arg(args, i))

def parseLspTok(args: List[String], i: Int, json: Bool, path: String, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("lsp"), json) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz lsp [OPTIONS] [PATH]")) else if (path != "") Cmd.Fail(extraArg(a, "scuzz lsp [OPTIONS] [PATH]")) else parseLsp(args, i + 1, json, a)

def parseFuzz(args: List[String], i: Int, json: Bool, path: String, iterations: Int, seed: Int, replay: String, oracles: Bool, noFailFast: Bool, relate: Bool, differential: Bool, live: Bool, asan: Bool, session: Bool): Cmd =
  if (i >= List.len(args)) fuzzDone(args, json, path, iterations, seed, replay, oracles, noFailFast, relate, differential, live, asan, session) else parseFuzzTok(args, i, json, path, iterations, seed, replay, oracles, noFailFast, relate, differential, live, asan, session, arg(args, i))

def liveBad(iterations: Int, replay: String, oracles: Bool, noFailFast: Bool, relate: Bool, differential: Bool): Bool =
  relate || differential || oracles || noFailFast || iterations != 0 && replay == ""

def fuzzDone(args: List[String], json: Bool, path: String, iterations: Int, seed: Int, replay: String, oracles: Bool, noFailFast: Bool, relate: Bool, differential: Bool, live: Bool, asan: Bool, session: Bool): Cmd =
  if (session && (live || asan || liveBad(iterations, replay, oracles, noFailFast, relate, differential))) Cmd.Fail(sessionOnly()) else if (live && liveBad(iterations, replay, oracles, noFailFast, relate, differential)) Cmd.Fail(liveOnly()) else if (asan && liveBad(iterations, replay, oracles, noFailFast, relate, differential)) Cmd.Fail(asanOnly()) else if (relate && (fuzzHasCamp(args, 0) || differential)) Cmd.Fail(relateOnly()) else gateJson(Cmd.Fuzz(orDot(path), iterations, seed, replay, oracles, noFailFast, relate, differential, live, asan, session), json)

def parseFuzzTok(args: List[String], i: Int, json: Bool, path: String, iterations: Int, seed: Int, replay: String, oracles: Bool, noFailFast: Bool, relate: Bool, differential: Bool, live: Bool, asan: Bool, session: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("fuzz"), json) else if (a == "--oracles") parseFuzz(args, i + 1, json, path, iterations, seed, replay, true, noFailFast, relate, differential, live, asan, session) else if (a == "--no-fail-fast") parseFuzz(args, i + 1, json, path, iterations, seed, replay, oracles, true, relate, differential, live, asan, session) else if (a == "--relate") parseFuzz(args, i + 1, json, path, iterations, seed, replay, oracles, noFailFast, true, differential, live, asan, session) else if (a == "--differential") parseFuzz(args, i + 1, json, path, iterations, seed, replay, oracles, noFailFast, relate, true, live, asan, session) else if (a == "--live") parseFuzz(args, i + 1, json, path, iterations, seed, replay, oracles, noFailFast, relate, differential, true, asan, session) else if (a == "--asan") parseFuzz(args, i + 1, json, path, iterations, seed, replay, oracles, noFailFast, relate, differential, live, true, session) else if (a == "--session") parseFuzz(args, i + 1, json, path, iterations, seed, replay, oracles, noFailFast, relate, differential, live, asan, true) else if (a == "--iterations" || flagPref(a, "--iterations")) parseFuzzIter(takeVal(args, i, "--iterations"), args, json, path, seed, replay, oracles, noFailFast, relate, differential, live, asan, session) else if (a == "--seed" || flagPref(a, "--seed")) parseFuzzSeed(takeVal(args, i, "--seed"), args, json, path, iterations, replay, oracles, noFailFast, relate, differential, live, asan, session) else if (a == "--replay" || flagPref(a, "--replay")) parseFuzzReplay(takeVal(args, i, "--replay"), args, json, path, iterations, seed, oracles, noFailFast, relate, differential, live, asan, session) else if (a == "--message-format" || flagPref(a, "--message-format")) parseFuzzMsg(takeVal(args, i, "--message-format"), args, path, iterations, seed, replay, oracles, noFailFast, relate, differential, live, asan, session) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz fuzz [OPTIONS] [PATH]")) else if (path != "") Cmd.Fail(extraArg(a, "scuzz fuzz [OPTIONS] [PATH]")) else parseFuzz(args, i + 1, json, a, iterations, seed, replay, oracles, noFailFast, relate, differential, live, asan, session)

def parseFuzzIter(p: (String, Int), args: List[String], json: Bool, path: String, seed: Int, replay: String, oracles: Bool, noFailFast: Bool, relate: Bool, differential: Bool, live: Bool, asan: Bool, session: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--iterations")) else parseFuzzIterGot(parseFlagNat(v), v, n, args, json, path, seed, replay, oracles, noFailFast, relate, differential, live, asan, session)
  }

def parseFuzzIterGot(p: (Bool, Int), v: String, n: Int, args: List[String], json: Bool, path: String, seed: Int, replay: String, oracles: Bool, noFailFast: Bool, relate: Bool, differential: Bool, live: Bool, asan: Bool, session: Bool): Cmd =
  p match {
    case (ok, it) => if (!ok) Cmd.Fail(badInt("--iterations", v)) else parseFuzz(args, n, json, path, it, seed, replay, oracles, noFailFast, relate, differential, live, asan, session)
  }

def parseFuzzSeed(p: (String, Int), args: List[String], json: Bool, path: String, iterations: Int, replay: String, oracles: Bool, noFailFast: Bool, relate: Bool, differential: Bool, live: Bool, asan: Bool, session: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--seed")) else parseFuzzSeedGot(parseFlagInt(v), v, n, args, json, path, iterations, replay, oracles, noFailFast, relate, differential, live, asan, session)
  }

def parseFuzzSeedGot(p: (Bool, Int), v: String, n: Int, args: List[String], json: Bool, path: String, iterations: Int, replay: String, oracles: Bool, noFailFast: Bool, relate: Bool, differential: Bool, live: Bool, asan: Bool, session: Bool): Cmd =
  p match {
    case (ok, seed) => if (!ok) Cmd.Fail(badInt("--seed", v)) else parseFuzz(args, n, json, path, iterations, seed, replay, oracles, noFailFast, relate, differential, live, asan, session)
  }

def parseFuzzReplay(p: (String, Int), args: List[String], json: Bool, path: String, iterations: Int, seed: Int, oracles: Bool, noFailFast: Bool, relate: Bool, differential: Bool, live: Bool, asan: Bool, session: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--replay")) else parseFuzz(args, n, json, path, iterations, seed, v, oracles, noFailFast, relate, differential, live, asan, session)
  }

def parseFuzzMsg(p: (String, Int), args: List[String], path: String, iterations: Int, seed: Int, replay: String, oracles: Bool, noFailFast: Bool, relate: Bool, differential: Bool, live: Bool, asan: Bool, session: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseFuzz(args, n, true, path, iterations, seed, replay, oracles, noFailFast, relate, differential, live, asan, session) else if (v == "human") parseFuzz(args, n, false, path, iterations, seed, replay, oracles, noFailFast, relate, differential, live, asan, session) else Cmd.Fail(badFmt(v))
  }

def parseDiff(args: List[String], i: Int, json: Bool, rev: String, path: String, iterations: Int, seed: Int): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Diff(orDot(path), if (rev == "") "HEAD" else rev, iterations, seed, json), json) else parseDiffTok(args, i, json, rev, path, iterations, seed, arg(args, i))

def parseDiffTok(args: List[String], i: Int, json: Bool, rev: String, path: String, iterations: Int, seed: Int, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("diff"), json) else if (a == "--iterations" || flagPref(a, "--iterations")) parseDiffNum(takeVal(args, i, "--iterations"), "--iterations", args, json, rev, path, iterations, seed) else if (a == "--seed" || flagPref(a, "--seed")) parseDiffNum(takeVal(args, i, "--seed"), "--seed", args, json, rev, path, iterations, seed) else if (a == "--message-format" || flagPref(a, "--message-format")) parseDiffMsg(takeVal(args, i, "--message-format"), args, rev, path, iterations, seed) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz diff [OPTIONS] [REV] [PATH]")) else if (path != "") Cmd.Fail(extraArg(a, "scuzz diff [OPTIONS] [REV] [PATH]")) else if (rev != "") parseDiff(args, i + 1, json, rev, a, iterations, seed) else parseDiff(args, i + 1, json, a, path, iterations, seed)

def parseDiffNum(p: (String, Int), name: String, args: List[String], json: Bool, rev: String, path: String, iterations: Int, seed: Int): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal(name)) else parseDiffNumGot(if (name == "--seed") parseFlagInt(v) else parseFlagNat(v), name, v, n, args, json, rev, path, iterations, seed)
  }

def parseDiffNumGot(p: (Bool, Int), name: String, v: String, n: Int, args: List[String], json: Bool, rev: String, path: String, iterations: Int, seed: Int): Cmd =
  p match {
    case (ok, k) => if (!ok) Cmd.Fail(badInt(name, v)) else if (name == "--seed") parseDiff(args, n, json, rev, path, iterations, k) else parseDiff(args, n, json, rev, path, k, seed)
  }

def parseDiffMsg(p: (String, Int), args: List[String], rev: String, path: String, iterations: Int, seed: Int): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseDiff(args, n, true, rev, path, iterations, seed) else if (v == "human") parseDiff(args, n, false, rev, path, iterations, seed) else Cmd.Fail(badFmt(v))
  }

def parseNew(args: List[String], i: Int, json: Bool, name: String, path: String, ui: Bool): Cmd =
  if (i >= List.len(args)) newDone(json, name, path, ui) else parseNewTok(args, i, json, name, path, ui, arg(args, i))

def newDone(json: Bool, name: String, path: String, ui: Bool): Cmd =
  if (name == "") Cmd.Fail(missName()) else if (!okPkgName(name)) Cmd.Fail(badName(name)) else gateJson(Cmd.New(name, path, ui), json)

def parseNewTok(args: List[String], i: Int, json: Bool, name: String, path: String, ui: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("new"), json) else if (a == "--ui") parseNew(args, i + 1, json, name, path, true) else if (a == "--path" || flagPref(a, "--path")) parseNewPath(takeVal(args, i, "--path"), args, json, name, ui) else if (a == "--message-format" || flagPref(a, "--message-format")) parseNewMsg(takeVal(args, i, "--message-format"), args, name, path, ui) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz new [OPTIONS] <NAME>")) else if (name != "") Cmd.Fail(extraArg(a, "scuzz new [OPTIONS] <NAME>")) else parseNew(args, i + 1, json, a, path, ui)

def parseNewPath(p: (String, Int), args: List[String], json: Bool, name: String, ui: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--path")) else parseNew(args, n, json, name, v, ui)
  }

def parseNewMsg(p: (String, Int), args: List[String], name: String, path: String, ui: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseNew(args, n, true, name, path, ui) else if (v == "human") parseNew(args, n, false, name, path, ui) else Cmd.Fail(badFmt(v))
  }

def parseIde(args: List[String], i: Int, json: Bool, path: String, outDir: String, target: String): Cmd =
  if (i >= List.len(args)) ideDone(json, path, outDir, target) else parseIdeTok(args, i, json, path, outDir, target, arg(args, i))

def ideDone(json: Bool, path: String, outDir: String, target: String): Cmd =
  if (!okRunTarget(target)) Cmd.Fail(badRunTarget(target)) else gateJson(Cmd.Ide(orDot(path), outDir, target), json)

def parseIdeTok(args: List[String], i: Int, json: Bool, path: String, outDir: String, target: String, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("ide"), json) else if (a == "--target" || flagPref(a, "--target")) parseIdeTarget(takeVal(args, i, "--target"), args, json, path, outDir) else if (a == "--out-dir" || flagPref(a, "--out-dir")) parseIdeOut(takeVal(args, i, "--out-dir"), args, json, path, target) else if (a == "--message-format" || flagPref(a, "--message-format")) parseIdeMsg(takeVal(args, i, "--message-format"), args, path, outDir, target) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz ide [OPTIONS] [PATH]")) else if (path != "") Cmd.Fail(extraArg(a, "scuzz ide [OPTIONS] [PATH]")) else parseIde(args, i + 1, json, a, outDir, target)

def parseIdeTarget(p: (String, Int), args: List[String], json: Bool, path: String, outDir: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--target")) else parseIde(args, n, json, path, outDir, v)
  }

def parseIdeOut(p: (String, Int), args: List[String], json: Bool, path: String, target: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--out-dir")) else parseIde(args, n, json, path, v, target)
  }

def parseIdeMsg(p: (String, Int), args: List[String], path: String, outDir: String, target: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseIde(args, n, true, path, outDir, target) else if (v == "human") parseIde(args, n, false, path, outDir, target) else Cmd.Fail(badFmt(v))
  }

def isExecOp(s: String): Bool =
  s == "tap" || s == "xy" || s == "text" || s == "type" || s == "key" || s == "scroll" || s == "pump" || s == "backspace" || s == "snapshot" || s == "dump" || s == "reload" || s == "quit"

def parseExec(args: List[String], i: Int, json: Bool, path: String, outDir: String, ops: List[String]): Cmd =
  if (i >= List.len(args)) execDone(json, path, outDir, List.reverse(ops)) else parseExecTok(args, i, json, path, outDir, ops, arg(args, i))

def parseExecTok(args: List[String], i: Int, json: Bool, path: String, outDir: String, ops: List[String], a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("exec"), json) else if (a == "--out-dir" || flagPref(a, "--out-dir")) parseExecOut(takeVal(args, i, "--out-dir"), args, json, path, ops) else if (a == "--message-format" || flagPref(a, "--message-format")) parseExecMsg(takeVal(args, i, "--message-format"), args, path, outDir, ops) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz exec [OPTIONS] [PATH] OP [ARGS...]")) else if (!List.isEmpty(ops)) parseExec(args, i + 1, json, path, outDir, a :: ops) else if (isExecOp(a)) parseExec(args, i + 1, json, path, outDir, a :: ops) else if (path != "") Cmd.Fail(extraArg(a, "scuzz exec [OPTIONS] [PATH] OP [ARGS...]")) else parseExec(args, i + 1, json, a, outDir, ops)

def parseExecOut(p: (String, Int), args: List[String], json: Bool, path: String, ops: List[String]): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--out-dir")) else parseExec(args, n, json, path, v, ops)
  }

def parseExecMsg(p: (String, Int), args: List[String], path: String, outDir: String, ops: List[String]): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseExec(args, n, true, path, outDir, ops) else if (v == "human") parseExec(args, n, false, path, outDir, ops) else Cmd.Fail(badFmt(v))
  }

def execDone(json: Bool, path: String, outDir: String, ops: List[String]): Cmd =
  if (List.isEmpty(ops)) Cmd.Fail("""error: the following required arguments were not provided:
  <OP>

Usage: scuzz exec [OPTIONS] [PATH] OP [ARGS...]

For more information, try '--help'.
""") else gateJson(Cmd.Exec(orDot(path), outDir, ops), json)

def joinOps(ops: List[String]): String =
  if (List.isEmpty(ops)) "" else Str.concat(List.at(ops, 0), if (List.isEmpty(List.tail(ops))) "" else Str.concat(";", joinOps(List.tail(ops))))

def execNum(s: String): Bool =
  isDigits(s) || Str.len(s) > 1 && Str.charAt(s, 0) == 45 && isDigits(Str.slice(s, 1, Str.len(s)))

def execArgErr(op: String): (Bool, String) =
  (false, Str.concat("scuzz exec: bad args for op '", Str.concat(op, "'")))

def execOps(ops: List[String]): (Bool, String) =
  if (List.isEmpty(ops)) (false, "scuzz exec: no ops") else execOpsGo(ops, "")

def execOpsGo(ops: List[String], acc: String): (Bool, String) =
  if (List.isEmpty(ops)) (true, acc) else execOpAt(List.at(ops, 0), List.tail(ops), acc)

def execEv(acc: String, ev: String, rest: List[String]): (Bool, String) =
  execOpsGo(rest, if (acc == "") ev else Str.concat(acc, Str.concat(",", ev)))

def execOpAt(op: String, rest: List[String], acc: String): (Bool, String) =
  if (op == "tap") execTap(rest, acc) else if (op == "xy") execXy(rest, acc) else if (op == "text") execStr1(op, "value", rest, acc) else if (op == "type") execStr1(op, "value", rest, acc) else if (op == "key") execStr1(op, "key", rest, acc) else if (op == "scroll") execNum1(op, "dy", rest, acc) else if (op == "pump") execNum1(op, "k", rest, acc) else if (op == "backspace") execNum1(op, "count", rest, acc) else if (op == "snapshot") execStr1(op, "path", rest, acc) else if (op == "dump") execEv(acc, "{\"op\":\"dump\"}", rest) else if (op == "reload") execEv(acc, "{\"op\":\"reload\"}", rest) else if (op == "quit") execEv(acc, "{\"op\":\"quit\"}", rest) else (false, Str.concat("scuzz exec: unknown op '", Str.concat(op, "'")))

def execTap(rest: List[String], acc: String): (Bool, String) =
  if (List.isEmpty(rest)) execArgErr("tap") else execTapGot(List.at(rest, 0), List.tail(rest), acc)

def execTapGot(v: String, rest: List[String], acc: String): (Bool, String) =
  if (isDigits(v)) execEv(acc, Str.concat("{\"op\":\"tap\",\"i\":", Str.concat(v, "}")), rest) else if (Str.startsWith(v, "id:")) execEv(acc, Str.concat("{\"op\":\"tap\",\"id\":", Str.concat(Check.jsonStr(Str.slice(v, 3, Str.len(v))), "}")), rest) else execArgErr("tap")

def execXy(rest: List[String], acc: String): (Bool, String) =
  if (List.len(rest) < 2) execArgErr("xy") else execXyGot(List.at(rest, 0), List.at(rest, 1), List.tail(List.tail(rest)), acc)

def execXyGot(x: String, y: String, rest: List[String], acc: String): (Bool, String) =
  if (execNum(x) && execNum(y)) execEv(acc, Str.concat("{\"op\":\"xy\",\"x\":", Str.concat(x, Str.concat(",\"y\":", Str.concat(y, "}")))), rest) else execArgErr("xy")

def execStr1(op: String, key: String, rest: List[String], acc: String): (Bool, String) =
  if (List.isEmpty(rest)) execArgErr(op) else execEv(acc, Str.concat("{\"op\":", Str.concat(Check.jsonStr(op), Str.concat(",", Str.concat(Check.jsonStr(key), Str.concat(":", Str.concat(Check.jsonStr(List.at(rest, 0)), "}")))))), List.tail(rest))

def execNum1(op: String, key: String, rest: List[String], acc: String): (Bool, String) =
  if (List.isEmpty(rest) || !execNum(List.at(rest, 0))) execArgErr(op) else execEv(acc, Str.concat("{\"op\":\"", Str.concat(op, Str.concat("\",\"", Str.concat(key, Str.concat("\":", Str.concat(List.at(rest, 0), "}")))))), List.tail(rest))

def parsePkg(args: List[String], i: Int, json: Bool, path: String, outDir: String, target: String): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Package(orDot(path), outDir, target), json) else parsePkgTok(args, i, json, path, outDir, target, arg(args, i))

def parsePkgTok(args: List[String], i: Int, json: Bool, path: String, outDir: String, target: String, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("package"), json) else if (a == "--target" || flagPref(a, "--target")) parsePkgTarget(takeVal(args, i, "--target"), args, json, path, outDir) else if (a == "--out-dir" || flagPref(a, "--out-dir")) parsePkgOut(takeVal(args, i, "--out-dir"), args, json, path, target) else if (a == "--message-format" || flagPref(a, "--message-format")) parsePkgMsg(takeVal(args, i, "--message-format"), args, path, outDir, target) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz package [OPTIONS] [PATH]")) else if (path != "") Cmd.Fail(extraArg(a, "scuzz package [OPTIONS] [PATH]")) else parsePkg(args, i + 1, json, a, outDir, target)

def parsePkgTarget(p: (String, Int), args: List[String], json: Bool, path: String, outDir: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--target")) else parsePkgTargetVal(v, n, args, json, path, outDir)
  }

def parsePkgTargetVal(v: String, n: Int, args: List[String], json: Bool, path: String, outDir: String): Cmd =
  if (v == "linux" || v == "macos" || v == "android" || v == "ios" || v == "web" || v == "all") parsePkg(args, n, json, path, outDir, v) else Cmd.Fail(Drive.badTarget(v))

def parsePkgOut(p: (String, Int), args: List[String], json: Bool, path: String, target: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--out-dir")) else parsePkg(args, n, json, path, v, target)
  }

def parsePkgMsg(p: (String, Int), args: List[String], path: String, outDir: String, target: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parsePkg(args, n, true, path, outDir, target) else if (v == "human") parsePkg(args, n, false, path, outDir, target) else Cmd.Fail(badFmt(v))
  }

def fmtSrc(src: String): String =
  fmtParsed(src, Parse.parse(Lexer.lex(src)))

def fmtParsed(src: String, p: Prog): String =
  if (Parse.hasParseError(p)) src else Parse.pretty(p)

def runCmd(c: Cmd, src: String): String =
  c match {
    case Cmd.Check(_, json) => if (json) Check.check(src) else Check.human(src)
    case Cmd.Fmt(_, _) => fmtSrc(src)
    case Cmd.Fuzz(_, it, seed, _, _, _, _, _, _, _, _) => Verify.fuzzOut(it, seed, 0, 0, 0, 0)
    case Cmd.Build(_, outDir, _, _) => Drive.showPkg(Drive.compilePkg("[package]\nname = \"hello\"\nversion = \"0.1.0\"\n", src, outDir, "clang", "crates/runtime/build/libscuzz_rt.a"))
    case _ => render(c)
  }

def dispatch(c: Cmd): IO[Unit] =
  c match {
    case Cmd.Build(path, outDir, full, verify) => dispatchBuild(path, outDir, full, verify)
    case Cmd.Run(path, outDir, target, watch, exec, hasExec, dump, snap, device) => if (target == "ios") Ios.run(path, pkgOut(path, outDir), device, watch) else dispatchRunCmd(path, outDir, target, watch, exec, hasExec, dump, snap)
    case Cmd.Devices => Ios.devices()
    case Cmd.Watch(path, outDir) => dispatchWatch(path, outDir)
    case Cmd.Check(path, json) => Drive.checkDir(path, json)
    case Cmd.Eval(path, probe) => if (probe) Drive.evProbeDir(path) else Drive.evDir(path)
    case Cmd.Fmt(path, check) => dispatchFmt(path, check)
    case Cmd.New(name, path, ui) => dispatchNew(name, path, ui)
    case Cmd.Package(path, outDir, target) => dispatchPkg(path, outDir, target)
    case Cmd.Fuzz(path, it, seed, replay, oracles, noFailFast, relate, differential, live, asan, session) => dispatchFuzz(path, it, seed, replay, relate, noFailFast, oracles, differential, live, asan, session)
    case Cmd.Diff(path, rev, it, seed, json) => dispatchDiff(path, rev, it, seed, json)
    case Cmd.Ide(path, outDir, target) => dispatchIde(path, outDir, target)
    case Cmd.Exec(path, outDir, ops) => dispatchExec(path, outDir, ops)
    case Cmd.Lsp(path) => Lsp.run(path)
    case Cmd.Docs(mode, topic) => dispatchDocs(mode, topic)
    case Cmd.Help(t) => IO.println(helpOf(t))
    case Cmd.Version => IO.println(Version.banner())
    case Cmd.Fail(m) => IO.println(m).flatMap(_ => IO.fail("scuzz"))
  }

def dispatchDocs(mode: String, topic: String): IO[Unit] =
  if (docsUnknown(mode, topic)) IO.println(docsOut(mode, topic)).flatMap(_ => IO.fail("scuzz")) else IO.println(docsOut(mode, topic))

def dispatchPkg(path: String, outDir: String, target: String): IO[Unit] =
  Drive.hostMac().flatMap(mac => dispatchPkgHost(path, outDir, target, mac))

def dispatchPkgHost(path: String, outDir: String, target: String, mac: Bool): IO[Unit] =
  if (target == "linux" && mac || target == "macos" && !mac) IO.println(Drive.hostMismatch(target, mac)).flatMap(_ => IO.fail("package")) else Drive.pkgDir(path, if (Str.startsWith(outDir, "/")) outDir else Drive.joinSlash(path, outDir), if (target == "") Drive.hostTarget(mac) else target)

def dispatchFuzz(path: String, it: Int, seed: Int, replay: String, relate: Bool, noFailFast: Bool, oracles: Bool, differential: Bool, live: Bool, asan: Bool, session: Bool): IO[Unit] =
  Fs.mkdirs(Drive.joinSlash(path, "build")).flatMap(_ => dispatchFuzz2(path, it, seed, replay, relate, noFailFast, oracles, differential, live, asan, session))

def dispatchFuzz2(path: String, it: Int, seed: Int, replay: String, relate: Bool, noFailFast: Bool, oracles: Bool, differential: Bool, live: Bool, asan: Bool, session: Bool): IO[Unit] =
  if (relate) Drive.fuzzRelate(path, Drive.joinSlash(path, "build")) else Drive.fuzzDir(path, Drive.joinSlash(path, "build"), it, seed, replay, noFailFast, oracles, differential, live, asan, session)

def dispatchDiff(path: String, rev: String, it: Int, seed: Int, json: Bool): IO[Unit] =
  Fs.exists(Drive.joinSlash(rev, "scuzz.toml")).flatMap(pkg => if (path == "." && pkg != 0) Diff.diffDir(rev, "HEAD", it, seed, json) else Diff.diffDir(path, rev, it, seed, json))

def dispatchIde(path: String, outDir: String, target: String): IO[Unit] =
  Sys.getenv("SCUZZ_IDE").flatMap(ide => Sys.getenv("SCUZZ_HOME").flatMap(home => dispatchIdeEnv(path, outDir, target, ide, home)))

def dispatchIdeEnv(path: String, outDir: String, target: String, ide: String, home: String): IO[Unit] =
  homeIdeOf(home).flatMap(homeIde => Fs.exists("examples/editor/scuzz.toml").flatMap(co => dispatchIdeGot(path, outDir, target, resolveIdeDir(ide, homeIde, if (co != 0) "examples/editor" else ""))))

def homeIdeOf(home: String): IO[String] =
  if (home == "") IO.pure("") else Fs.exists(Drive.joinSlash(Drive.joinSlash(home, "ide"), "scuzz.toml")).flatMap(hit => IO.pure(if (hit != 0) Drive.joinSlash(home, "ide") else ""))

def dispatchIdeGot(path: String, outDir: String, target: String, ideDir: String): IO[Unit] =
  if (ideDir == "") IO.println(missIde()).flatMap(_ => IO.fail("scuzz")) else Fs.exists(Drive.joinSlash(ideDir, "scuzz.toml")).flatMap(hit => if (hit != 0) dispatchRun(ideDir, outDir, target, "", false, "", "", runExtra(path)) else IO.println(missIde()).flatMap(_ => IO.fail("scuzz")))

def dispatchBuild(path: String, outDir: String, full: Bool, verify: Bool): IO[Unit] =
  dispatchBuildOut(path, pkgOut(path, outDir), full, verify)

def dispatchBuildOut(path: String, out: String, full: Bool, verify: Bool): IO[Unit] =
  Fs.mkdirs(out).flatMap(_ => if (verify) dispatchBuildVerify(path, out) else Drive.emitDir(path, out, full))

def dispatchBuildVerify(path: String, out: String): IO[Unit] =
  Drive.fuzzCollect(path).flatMap(files => Drive.emitDirAlways(path, out, files))

def dispatchRunCmd(path: String, outDir: String, target: String, watch: Bool, exec: String, hasExec: Bool, dump: String, snap: String): IO[Unit] =
  if (watch && (hasExec || dump != "" || snap != "")) IO.println("scuzz run --watch does not accept --exec, --snapshot-out, or --dump. Run without --watch: scuzz run --target headless --exec PATH --dump PATH") else if (watch) dispatchRunWatch(path, outDir, target) else dispatchRun(path, outDir, target, exec, hasExec, dump, snap, "")

def dispatchExec(path: String, outDir: String, ops: List[String]): IO[Unit] =
  Fs.read(Drive.joinSlash(path, "scuzz.toml")).flatMap(toml => dispatchExecMan(path, pkgOut(path, outDir), ops, Manifest.parse(toml)))

def dispatchExecMan(path: String, out: String, ops: List[String], m: Man): IO[Unit] =
  Drive.manNeed(m).flatMap(_ => if (!m.hasUi) IO.println(Str.concat("scuzz exec: ", Str.concat(path, " has no [ui] table"))).flatMap(_ => IO.fail("exec")) else dispatchExecWrite(out, ops))

def dispatchExecWrite(out: String, ops: List[String]): IO[Unit] =
  execOps(ops) match {
    case (ok, body) => if (!ok) IO.println(body).flatMap(_ => IO.fail("exec")) else Fs.mkdirs(out).flatMap(_ => Fs.write(Drive.joinSlash(out, "inject.json"), Str.concat("{\"v\":1,\"kind\":\"inject\",\"events\":[", Str.concat(body, """]}
"""))).flatMap(_ => IO.println(Str.concat("scuzz exec: wrote ", Drive.joinSlash(out, "inject.json")))))
  }

def dispatchWatch(path: String, outDir: String): IO[Unit] =
  IO.println(Str.concat("scuzz watch ", Str.concat(path, " (rebuild on change; not hot reload)"))).flatMap(_ => watchBuild(path, pkgOut(path, outDir)))

def watchBuild(path: String, out: String): IO[Unit] =
  Fs.mkdirs(out).flatMap(_ => Drive.emitDir(path, out, false).flatMap(_ => IO.sleep(400).flatMap(_ => watchBuild(path, out))))

def dispatchRunWatch(path: String, outDir: String, target: String): IO[Unit] =
  Fs.read(Drive.joinSlash(path, "scuzz.toml")).flatMap(toml => dispatchRunWatchMan(path, pkgOut(path, outDir), target, Manifest.parse(toml)))

def dispatchRunWatchMan(path: String, out: String, target: String, m: Man): IO[Unit] =
  Drive.manNeed(m).flatMap(_ => if (m.hasUi) watchUi(path, out, target, m.name) else watchIo(path, out, m.name))

def watchIo(path: String, out: String, name: String): IO[Unit] =
  IO.println(Str.concat("scuzz run --watch ", Str.concat(path, " (rebuild and rerun on source change; kills a still-running process; not hot reload)"))).flatMap(_ => Fs.mkdirs(out).flatMap(_ => Drive.emitDir(path, out, false).flatMap(_ => Drive.linkOnly(false, name, out).flatMap(_ => watchIoLoop(path, out, name)))))

def watchIoLoop(path: String, out: String, name: String): IO[Unit] =
  Sys.spawn(Drive.shQuote(Drive.exeName(out, name))).flatMap(pid => watchIoPoll(path, out, name, pid))

def watchIoPoll(path: String, out: String, name: String, pid: Int): IO[Unit] =
  Fs.read(Drive.fpPath(path)).handleErrorWith(_ => IO.pure("")).flatMap(old => watchIoDrain(pid).flatMap(_ => watchIoTick(path, out, name, pid, old)))

def watchIoDrain(pid: Int): IO[Unit] =
  IO.timeout(400, Sys.childRead(pid, 4096)).flatMap(s => Sys.write(s).flatMap(_ => watchIoDrainMore(pid, s))).handleErrorWith(_ => IO.pure(()))

def watchIoDrainMore(pid: Int, s: String): IO[Unit] =
  if (Str.byteLen(s) < 4096) IO.pure(()) else IO.timeout(50, Sys.childRead(pid, 4096)).flatMap(t => Sys.write(t).flatMap(_ => watchIoDrainMore(pid, t))).handleErrorWith(_ => IO.pure(()))

def watchIoTick(path: String, out: String, name: String, pid: Int, old: String): IO[Unit] =
  Drive.emitDir(path, out, false).flatMap(_ => Fs.read(Drive.fpPath(path)).handleErrorWith(_ => IO.pure("")).flatMap(now => watchIoTick2(path, out, name, pid, old, now)))

def watchIoTick2(path: String, out: String, name: String, pid: Int, old: String, now: String): IO[Unit] =
  Sys.alive(pid).flatMap(live => watchIoTick3(path, out, name, pid, old, now, live))

def watchIoTick3(path: String, out: String, name: String, pid: Int, old: String, now: String, live: Int): IO[Unit] =
  if (now != old) Sys.kill(pid).flatMap(_ => Drive.linkOnly(false, name, out).flatMap(_ => watchIoLoop(path, out, name))) else if (live == 0) watchIoIdle(path, out, name) else watchIoPoll(path, out, name, pid)

def watchIoIdle(path: String, out: String, name: String): IO[Unit] =
  Fs.read(Drive.fpPath(path)).handleErrorWith(_ => IO.pure("")).flatMap(old => IO.sleep(400).flatMap(_ => Drive.emitDir(path, out, false).flatMap(_ => Fs.read(Drive.fpPath(path)).handleErrorWith(_ => IO.pure("")).flatMap(now => watchIoIdle2(path, out, name, old, now)))))

def watchIoIdle2(path: String, out: String, name: String, old: String, now: String): IO[Unit] =
  if (now != old) Drive.linkOnly(false, name, out).flatMap(_ => watchIoLoop(path, out, name)) else watchIoIdle(path, out, name)

def watchUi(path: String, out: String, target: String, name: String): IO[Unit] =
  IO.println(Str.concat("scuzz run --watch ", Str.concat(path, " (hot reload). Enter r to rebuild and restart. Enter q to stop."))).flatMap(_ => Fs.mkdirs(out).flatMap(_ => watchUiBoot(path, out, target, name, 0)))

def watchUiBoot(path: String, out: String, target: String, name: String, gen: Int): IO[Unit] =
  Drive.emitDir(path, out, false).flatMap(_ => Drive.linkOnly(true, name, out).flatMap(_ => Drive.linkReload(Drive.llName(out, name), out, false).flatMap(_ => Fs.write(Drive.joinSlash(out, "reload.stamp"), "0").flatMap(_ => watchUiSpawn(path, out, target, name, gen)))))

def watchUiSpawn(path: String, out: String, target: String, name: String, gen: Int): IO[Unit] =
  Fs.read(Drive.joinSlash(path, "scuzz.toml")).flatMap(toml => Sys.getenv("SCUZZ_HOME").flatMap(home => Sys.spawn(watchUiCommand(home, out, target, toml, name)).flatMap(pid => IO.ensure(watchUiPoll(path, out, target, name, gen, pid, ""), watchUiStop(pid)).flatMap(restart => if (restart) watchUiBoot(path, out, target, name, 0) else IO.pure(())))))

def watchUiCommand(home: String, out: String, target: String, toml: String, name: String): String =
  Str.concat(watchUiEnv(out, target, toml), Str.concat("bash ", Str.concat(Drive.shQuote(Drive.crateAt(home, "crates/embedder-desktop/run_watch.sh")), Str.concat(" ", Drive.shQuote(Drive.exeName(out, name))))))

def watchUiStop(pid: Int): IO[Unit] =
  Sys.childWrite(pid, """quit
""").handleErrorWith(_ => IO.pure(())).flatMap(_ => Sys.childClose(pid).handleErrorWith(_ => IO.pure(())).flatMap(_ => IO.timeout(5000, watchUiStopped(pid)).handleErrorWith(_ => Sys.kill(pid))))

def watchUiStopped(pid: Int): IO[Unit] =
  Sys.alive(pid).flatMap(alive => if (alive == 0) IO.pure(()) else IO.sleep(20).flatMap(_ => watchUiStopped(pid)))

def watchUiEnv(out: String, target: String, toml: String): String =
  Str.concat(Drive.runEnvOf(out, target, "", toml), Str.concat("SCUZZ_UI_RELOAD_STAMP=", Str.concat(Drive.shQuote(Drive.joinSlash(out, "reload.stamp")), Str.concat(" SCUZZ_UI_RELOAD_CODE=", Str.concat(Drive.shQuote(Drive.joinSlash(out, "reload.dylib")), Str.concat(" SCUZZ_UI_DEBUG_DUMP=", Str.concat(Drive.shQuote(Drive.joinSlash(out, "debug.json")), Str.concat(" SCUZZ_UI_INJECT=", Str.concat(Drive.shQuote(Drive.joinSlash(out, "inject.json")), Str.concat(" SCUZZ_UI_RECORD=", Str.concat(Drive.shQuote(Drive.joinSlash(out, "record.json")), " ")))))))))))

def watchUiPoll(path: String, out: String, target: String, name: String, gen: Int, pid: Int, hold: String): IO[Bool] =
  Sys.alive(pid).flatMap(alive => if (alive == 0) IO.pure(false) else IO.timeout(10, Sys.readLine()).handleErrorWith(_ => IO.pure("")).flatMap(command => watchUiControl(path, out, target, name, gen, pid, hold, Str.trim(command))))

def watchUiControl(path: String, out: String, target: String, name: String, gen: Int, pid: Int, hold: String, command: String): IO[Bool] =
  if (command == "q") IO.pure(false) else if (command == "r") watchUiCompile(path, out).flatMap(ok => if (!ok) watchUiHold(path, out, target, name, gen, pid) else watchUiLink(name, out).flatMap(linked => if (linked) IO.pure(true) else watchUiPoll(path, out, target, name, gen, pid, ""))) else Drive.srcText(path).flatMap(text => watchUiSame(path, out, target, name, gen, pid, hold, text))

def watchUiHold(path: String, out: String, target: String, name: String, gen: Int, pid: Int): IO[Bool] =
  Drive.srcText(path).flatMap(text => watchUiPoll(path, out, target, name, gen, pid, text))

def watchUiSame(path: String, out: String, target: String, name: String, gen: Int, pid: Int, hold: String, text: String): IO[Bool] =
  if (hold != "" && text == hold) watchIoDrain(pid).flatMap(_ => watchUiPoll(path, out, target, name, gen, pid, hold)) else Fs.read(Drive.fpPath(path)).handleErrorWith(_ => IO.pure("")).flatMap(old => watchIoDrain(pid).flatMap(_ => watchUiTick(path, out, target, name, gen, pid, old, text)))

def watchUiTick(path: String, out: String, target: String, name: String, gen: Int, pid: Int, old: String, text: String): IO[Bool] =
  watchUiCompile(path, out).flatMap(ok => if (!ok) watchUiPoll(path, out, target, name, gen, pid, text) else Fs.read(Drive.fpPath(path)).handleErrorWith(_ => IO.pure("")).flatMap(now => watchUiTick2(path, out, target, name, gen, pid, old, now)))

def watchUiCompile(path: String, out: String): IO[Bool] =
  Drive.emitDir(path, out, false).map(_ => true).handleErrorWith(_ => IO.println("Build fails. Fix the source and retry.").map(_ => false))

def watchUiTick2(path: String, out: String, target: String, name: String, gen: Int, pid: Int, old: String, now: String): IO[Bool] =
  Sys.alive(pid).flatMap(live => watchUiTick3(path, out, target, name, gen, pid, old, now, live))

def watchUiTick3(path: String, out: String, target: String, name: String, gen: Int, pid: Int, old: String, now: String, live: Int): IO[Bool] =
  if (live == 0) IO.pure(false) else if (now != old) watchUiReload(path, out, target, name, gen + 1, pid) else watchUiPoll(path, out, target, name, gen, pid, "")

def watchUiReload(path: String, out: String, target: String, name: String, gen: Int, pid: Int): IO[Bool] =
  watchUiLink(name, out).flatMap(ok => if (!ok) watchUiPoll(path, out, target, name, gen - 1, pid, "") else Fs.write(Drive.joinSlash(out, "reload.stamp"), Str.concat(Str.fromInt(gen), """
""")).flatMap(_ => IO.println(Str.concat("scuzz: view reload stamp ", Str.fromInt(gen))).flatMap(_ => watchUiPoll(path, out, target, name, gen, pid, ""))))

def watchUiLink(name: String, out: String): IO[Bool] =
  Drive.linkOnly(true, name, out).flatMap(_ => Drive.linkReload(Drive.llName(out, name), out, false)).map(_ => true).handleErrorWith(_ => IO.println("Reload fails. Fix the source and retry.").map(_ => false))

def dispatchRun(path: String, outDir: String, target: String, exec: String, hasExec: Bool, dump: String, snap: String, extra: String): IO[Unit] =
  dispatchRunOut(path, pkgOut(path, outDir), target, exec, hasExec, dump, snap, extra)

def pkgOut(path: String, outDir: String): String =
  if (Str.startsWith(outDir, "/")) outDir else Drive.joinSlash(path, outDir)

def dispatchRunOut(path: String, out: String, target: String, exec: String, hasExec: Bool, dump: String, snap: String, extra: String): IO[Unit] =
  Fs.mkdirs(out).flatMap(_ => Fs.read(Drive.joinSlash(path, "scuzz.toml")).flatMap(toml => Drive.hostMac().flatMap(mac => dispatchRunCheck(path, out, target, exec, hasExec, dump, snap, extra, toml, Manifest.parse(toml), mac))))

def dispatchRunCheck(path: String, out: String, target: String, exec: String, hasExec: Bool, dump: String, snap: String, extra: String, toml: String, m: Man, mac: Bool): IO[Unit] =
  Drive.manNeed(m).flatMap(_ => dispatchRunGate(path, out, target, exec, hasExec, dump, snap, extra, toml, m, mac))

def dispatchRunGate(path: String, out: String, target: String, exec: String, hasExec: Bool, dump: String, snap: String, extra: String, toml: String, m: Man, mac: Bool): IO[Unit] =
  if (target == "linux" && mac || target == "macos" && !mac) IO.println(Drive.hostMismatch(target, mac)).flatMap(_ => IO.fail("run")) else if (!m.hasUi && target != "" && target != "linux" && target != "macos") IO.println(Str.concat("scuzz run --target ", Str.concat(target, ": package has no [ui] table"))).flatMap(_ => IO.fail("run")) else dispatchRunExec(path, out, target, exec, hasExec, dump, snap, extra, toml)

def execInline(s: String): Bool =
  s == "" || Str.startsWith(s, "{") || Str.startsWith(s, "[")

def execDoc(s: String): String =
  if (s == "") "{\"v\":1,\"kind\":\"inject\",\"events\":[]}\n" else Str.concat(s, """
""")

def dispatchRunExec(path: String, out: String, target: String, exec: String, hasExec: Bool, dump: String, snap: String, extra: String, toml: String): IO[Unit] =
  if (hasExec && execInline(exec)) Fs.write(Drive.joinSlash(out, "exec.json"), execDoc(exec)).flatMap(_ => dispatchRunEnv(path, out, runEnvOf(out, target, Drive.joinSlash(out, "exec.json"), hasExec, dump, snap, toml), extra)) else dispatchRunEnv(path, out, runEnvOf(out, target, exec, hasExec, dump, snap, toml), extra)

def dispatchRunEnv(path: String, out: String, env: String, extra: String): IO[Unit] =
  Drive.runDir(path, out, env, extra)

def runEnvOf(out: String, target: String, script: String, hasExec: Bool, dump: String, snap: String, toml: String): String =
  Str.concat(Drive.runEnvOf(out, target, snap, toml), Str.concat(runChannelEnv(out, target, hasExec, toml), Str.concat(if (script == "") "" else Str.concat("SCUZZ_UI_SCRIPT=", Str.concat(Drive.shQuote(script), " ")), if (dump == "") "" else Str.concat("SCUZZ_FUZZ_DUMP=", Str.concat(Drive.shQuote(dump), " ")))))

def runChannelEnv(out: String, target: String, hasExec: Bool, toml: String): String =
  runChannelMan(out, target, hasExec, Manifest.parse(toml))

def runChannelMan(out: String, target: String, hasExec: Bool, m: Man): String =
  if (hasExec || !m.hasUi) "" else Str.concat(runRecordEnv(out, target, m), Str.concat("SCUZZ_UI_DEBUG_DUMP=", Str.concat(Drive.shQuote(Drive.joinSlash(out, "debug.json")), Str.concat(" SCUZZ_UI_INJECT=", Str.concat(Drive.shQuote(Drive.joinSlash(out, "inject.json")), Str.concat(" ", runServeEnv(target, m)))))))

def runServeEnv(target: String, m: Man): String =
  if (uiKindOf(target, m) == "headless") "SCUZZ_UI_SERVE=1 " else ""

def runRecordEnv(out: String, target: String, m: Man): String =
  if (uiKindOf(target, m) == "headless") "" else Str.concat("SCUZZ_UI_RECORD=", Str.concat(Drive.shQuote(Drive.joinSlash(out, "record.json")), " "))

def uiKindOf(target: String, m: Man): String =
  Drive.uiEnvKind(target, Manifest.uiRuntime(Manifest.manUi(m)))

def dispatchFmt(path: String, check: Bool): IO[Unit] =
  Fs.list(Drive.joinSlash(path, "src")).flatMap(_ => fmtDir(path, "", check).flatMap(dirty => fmtDone(check, dirty)))

def fmtDir(dir: String, rel: String, check: Bool): IO[Int] =
  Fs.list(dir).flatMap(ents => fmtEntries(dir, rel, check, ents, 0))

def fmtEntries(dir: String, rel: String, check: Bool, ents: List[(String, Bool)], dirty: Int): IO[Int] =
  if (List.isEmpty(ents)) IO.pure(dirty) else fmtEntry(dir, rel, check, List.at(ents, 0)).flatMap(n => fmtEntries(dir, rel, check, List.tail(ents), dirty + n))

def fmtEntry(dir: String, rel: String, check: Bool, ent: (String, Bool)): IO[Int] =
  ent match {
    case (name, isDir) => if (isDir) if (Drive.skipWalk(name)) IO.pure(0) else fmtDir(Drive.joinSlash(dir, name), Drive.joinRel(rel, name), check) else if (fmtSource(rel, name)) Fs.read(Drive.joinSlash(dir, name)).flatMap(src => fmtOnePath(check, Drive.joinSlash(dir, name), src)) else IO.pure(0)
  }

def fmtSource(rel: String, name: String): Bool =
  Drive.isVerify(name) || Drive.isScenario(name) || rel == "src" && Drive.isScuzz(name)

def fmtOnePath(check: Bool, path: String, src: String): IO[Int] =
  if (Parse.hasParseError(Parse.parse(Lexer.lex(src)))) IO.println(Str.concat(path, ": parse error; source is unchanged")).flatMap(_ => IO.fail("fmt")) else fmtOneGot(check, path, src, fmtSrc(src))

def fmtOneGot(check: Bool, path: String, src: String, pretty: String): IO[Int] =
  if (pretty == src) IO.pure(0) else fmtOneDirty(check, path, pretty)

def fmtOneDirty(check: Bool, path: String, pretty: String): IO[Int] =
  if (check) fmtOneWould(path) else fmtOneWrite(path, pretty)

def fmtOneWould(path: String): IO[Int] =
  IO.println(Str.concat("would reformat ", path)).flatMap(_ => IO.pure(1))

def fmtOneWrite(path: String, pretty: String): IO[Int] =
  Fs.write(path, pretty).flatMap(_ => fmtOneWrote(path))

def fmtOneWrote(path: String): IO[Int] =
  IO.println(Str.concat("formatted ", path)).flatMap(_ => IO.pure(1))

def fmtDone(check: Bool, dirty: Int): IO[Unit] =
  if (check && dirty > 0) IO.println(Str.concat(Str.fromInt(dirty), " file(s) need formatting")).flatMap(_ => IO.fail("scuzz fmt")) else IO.println("scuzz fmt ok")

def newTomlUi(name: String): String =
  Str.concat("[package]\nname = \"", Str.concat(name, Str.concat("\"\nversion = \"0.1.0\"\n\n[ui]\ndefault_runtime = \"headless\"\nheadless_size = [200, 120]\nheadless_scale = 1.0\nbundle_id = \"dev.scuzz.", Str.concat(name, "\"\n"))))

def newTomlIo(name: String): String =
  Str.concat("[package]\nname = \"", Str.concat(name, "\"\nversion = \"0.1.0\"\n"))

def newMainUi(): String =
  "def bump(n: Int): Int =\n  n + 1\n\n@main def main: IO[Unit] =\n  for {\n    count = Signal.make(0)\n    label = Signal.map(count, n => s\"count = $n\")\n    _ <- Ui.run(_ => View.column(View.text(\"Counter\"), View.bindText(label), View.row(View.button(\"+1\", _ => Signal.set(count, Signal.get(count) + 1)))))\n  } yield ()\n"

def newMainIo(): String =
  "def greet(): String =\n  \"Hello, Scuzz!\"\n\n@main def main: IO[Unit] =\n  IO.println(greet()).flatMap(_ => IO.println(\"ready.\"))\n"

def newVerifyUi(): String =
  "def alwaysShowsCounter(t: Timeline): Verdict =\n  Verdict.alwaysHas(t, \"text:Counter\")\n\ndef afterPlusShowsCount(t: Timeline): Verdict =\n  Verdict.afterHit(t, \"button:+1\", \"text:count = 1\")\n\noracle bumpOnce(n: Int): Bool =\n  if (Main.bump(n) == n + 1) true else false\n\n"

def newVerifyIo(): String =
  "oracle greetFact(): Bool =\n  Main.greet() == \"Hello, Scuzz!\"\n\n"

def newCorpusUi(): String =
  "[fuzz]\nevents = [\"tap button:+1\"]\n"

def writeNew(dir: String, name: String, ui: Bool): IO[Unit] =
  Fs.write(Drive.joinSlash(dir, "scuzz.toml"), if (ui) newTomlUi(name) else newTomlIo(name)).flatMap(_ => writeNewMain(dir, name, ui))

def dispatchNew(name: String, path: String, ui: Bool): IO[Unit] =
  dispatchNewDir(Drive.joinSlash(path, name), name, ui)

def dispatchNewDir(dir: String, name: String, ui: Bool): IO[Unit] =
  Fs.exists(Drive.joinSlash(dir, "scuzz.toml")).flatMap(hit => if (hit != 0) IO.println(existNew(dir)).flatMap(_ => IO.fail("scuzz")) else Fs.mkdirs(Drive.joinSlash(dir, "src")).flatMap(_ => writeNew(dir, name, ui)))

def writeNewMain(dir: String, name: String, ui: Bool): IO[Unit] =
  Fs.write(Drive.joinSlash(Drive.joinSlash(dir, "src"), "Main.scuzz"), if (ui) newMainUi() else newMainIo()).flatMap(_ => writeNewVerify(dir, name, ui))

def writeNewVerify(dir: String, name: String, ui: Bool): IO[Unit] =
  Fs.write(Drive.joinSlash(dir, Str.concat(name, ".scuzz_verify")), if (ui) newVerifyUi() else newVerifyIo()).flatMap(_ => writeNewCorpus(dir, ui))

def writeNewCorpus(dir: String, ui: Bool): IO[Unit] =
  if (ui) Fs.mkdirs(Drive.joinSlash(dir, "corpus")).flatMap(_ => Fs.write(Drive.joinSlash(Drive.joinSlash(dir, "corpus"), "plus.toml"), newCorpusUi()).flatMap(_ => printNew(dir, true))) else printNew(dir, false)

def printNew(dir: String, ui: Bool): IO[Unit] =
  IO.println(if (ui) Str.concat("created ", Str.concat(dir, " (ui) - next: scuzz fuzz --iterations 0 && scuzz run --target headless --exec \"\"")) else Str.concat("created ", Str.concat(dir, " - next: scuzz fuzz --iterations 0 && scuzz run")))

