enum Cmd:
  case Help(topic: String)
  case Version
  case Fail(msg: String)
  case Fmt(path: String, check: Bool)
  case Check(path: String, json: Bool)
  case Build(path: String, outDir: String, full: Bool, verify: Bool)
  case Run(path: String, outDir: String, headless: Bool, watch: Bool, script: String, dump: String)
  case Watch(path: String, outDir: String)
  case Test(path: String, update: Bool, pixels: Bool, differential: Bool)
  case Lsp(path: String)
  case Fuzz(path: String, iterations: Int, seed: Int, replay: String, oracles: Bool, noFailFast: Bool, minimize: Bool, relate: Bool)
  case New(name: String, path: String, ui: Bool)
  case Ide(path: String, outDir: String, headless: Bool)
  case Package(path: String, outDir: String, target: String)

def arg(xs: List[String], i: Int): String =
  if (i < 0 || i >= List.len(xs)) "" else List.at(xs, i)

def yn(b: Bool): String =
  if (b) "true" else "false"

def isFlag(s: String): Bool =
  Str.startsWith(s, "-") && s != "-"

def isHelp(s: String): Bool =
  s == "-h" || s == "--help"

def isVer(s: String): Bool =
  s == "-V" || s == "--version"

def isCmd(s: String): Bool =
  s == "build" || s == "run" || s == "watch" || s == "test" || s == "check" || s == "lsp" || s == "fmt" || s == "fuzz" || s == "new" || s == "ide" || s == "package" || s == "help"

def unrec(name: String): String =
  Str.concat("error: unrecognized subcommand '", Str.concat(name, """'

Usage: scuzz [OPTIONS] <COMMAND>

For more information, try '--help'.
"""))

def unexp(flag: String, usage: String): String =
  Str.concat("error: unexpected argument '", Str.concat(flag, Str.concat("""' found

  tip: to pass '""", Str.concat(flag, Str.concat("' as a value, use '-- ", Str.concat(flag, Str.concat("""'

Usage: """, Str.concat(usage, """

For more information, try '--help'.
"""))))))))

def needVal(name: String): String =
  if (name == "--message-format") """error: a value is required for '--message-format <MESSAGE_FORMAT>' but none was supplied
  [possible values: human, json]

For more information, try '--help'.
""" else if (name == "--iterations") """error: a value is required for '--iterations <ITERATIONS>' but none was supplied

For more information, try '--help'.
""" else Str.concat("error: a value is required for '", Str.concat(name, """' but none was supplied

For more information, try '--help'.
"""))

def badFmt(v: String): String =
  Str.concat("error: invalid value '", Str.concat(v, """' for '--message-format <MESSAGE_FORMAT>'
  [possible values: human, json]

For more information, try '--help'.
"""))

def jsonOnly(): String =
  """scuzz error: --message-format=json applies to `scuzz check` only
"""

def missName(): String =
  """error: the following required arguments were not provided:
  <NAME>

Usage: scuzz new <NAME>

For more information, try '--help'.
"""

def missCmd(): String =
  Help.helpRoot()

def flagPref(a: String, name: String): Bool =
  Str.startsWith(a, Str.concat(name, "="))

def takeVal(args: List[String], i: Int, name: String): (String, Int) =
  takeVal2(args, i, name, arg(args, i))

def takeVal2(args: List[String], i: Int, name: String, a: String): (String, Int) =
  if (flagPref(a, name)) (Str.slice(a, Str.len(name) + 1, Str.len(a)), i + 1) else if (a == name) takeVal3(args, i + 1) else ("", 0 - 2)

def takeVal3(args: List[String], j: Int): (String, Int) =
  if (j >= List.len(args)) ("", 0 - 1) else (arg(args, j), j + 1)

def helpOf(topic: String): String =
  if (topic == "" || topic == "help") Help.helpRoot() else if (topic == "fmt") Help.helpFmt() else if (topic == "check") Help.helpCheck() else if (topic == "build") Help.helpBuild() else if (topic == "run") Help.helpRun() else if (topic == "fuzz") Help.helpFuzz() else if (topic == "new") Help.helpNew() else unrec(topic)

def show(c: Cmd): String =
  c match {
    case Cmd.Help(t) => Str.concat("help:", t)
    case Cmd.Version => "version"
    case Cmd.Fail(m) => Str.concat("fail:", m)
    case Cmd.Fmt(path, check) => Str.concat("fmt path=", Str.concat(path, Str.concat(" check=", yn(check))))
    case Cmd.Check(path, json) => Str.concat("check path=", Str.concat(path, Str.concat(" json=", yn(json))))
    case Cmd.Build(path, outDir, full, verify) => Str.concat("build path=", Str.concat(path, Str.concat(" out=", Str.concat(outDir, Str.concat(" full=", Str.concat(yn(full), Str.concat(" verify=", yn(verify))))))))
    case Cmd.Run(path, outDir, headless, watch, script, dump) => Str.concat("run path=", Str.concat(path, Str.concat(" out=", Str.concat(outDir, Str.concat(" headless=", Str.concat(yn(headless), Str.concat(" watch=", Str.concat(yn(watch), Str.concat(" script=", Str.concat(script, Str.concat(" dump=", dump)))))))))))
    case Cmd.Watch(path, outDir) => Str.concat("watch path=", Str.concat(path, Str.concat(" out=", outDir)))
    case Cmd.Test(path, update, pixels, differential) => Str.concat("test path=", Str.concat(path, Str.concat(" update=", Str.concat(yn(update), Str.concat(" pixels=", Str.concat(yn(pixels), Str.concat(" differential=", yn(differential))))))))
    case Cmd.Lsp(path) => Str.concat("lsp path=", path)
    case Cmd.Fuzz(path, iterations, seed, replay, oracles, noFailFast, minimize, relate) => Str.concat("fuzz path=", Str.concat(path, Str.concat(" iterations=", Str.concat(Str.fromInt(iterations), Str.concat(" seed=", Str.concat(Str.fromInt(seed), Str.concat(" replay=", Str.concat(replay, Str.concat(" oracles=", Str.concat(yn(oracles), Str.concat(" noFailFast=", Str.concat(yn(noFailFast), Str.concat(" minimize=", Str.concat(yn(minimize), Str.concat(" relate=", yn(relate))))))))))))))))
    case Cmd.New(name, path, ui) => Str.concat("new name=", Str.concat(name, Str.concat(" path=", Str.concat(path, Str.concat(" ui=", yn(ui))))))
    case Cmd.Ide(path, outDir, headless) => Str.concat("ide path=", Str.concat(path, Str.concat(" out=", Str.concat(outDir, Str.concat(" headless=", yn(headless))))))
    case Cmd.Package(path, outDir, target) => Str.concat("package path=", Str.concat(path, Str.concat(" out=", Str.concat(outDir, Str.concat(" target=", target)))))
  }

def render(c: Cmd): String =
  c match {
    case Cmd.Help(t) => helpOf(t)
    case Cmd.Version => """scuzz 0.2.0
"""
    case Cmd.Fail(m) => m
    case _ => show(c)
  }

def gateJson(c: Cmd, json: Bool): Cmd =
  if (!json) c else c match {
  case Cmd.Check(path, _) => Cmd.Check(path, true)
  case Cmd.Help(_) => c
  case Cmd.Version => c
  case Cmd.Fail(_) => c
  case _ => Cmd.Fail(jsonOnly())
}

def parse(args: List[String]): Cmd =
  parseAt(args, 0, false)

def parseAt(args: List[String], i: Int, json: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Fail(missCmd()), json) else parseTok(args, i, json, arg(args, i))

def parseTok(args: List[String], i: Int, json: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help(""), json) else if (isVer(a)) gateJson(Cmd.Version, json) else if (a == "--message-format" || flagPref(a, "--message-format")) parseMsg(args, i) else if (a == "help") parseHelp(args, i + 1, json) else if (isCmd(a)) parseCmd(args, a, i + 1, json) else if (isFlag(a)) gateJson(Cmd.Fail(unexp(a, "scuzz [OPTIONS] <COMMAND>")), json) else gateJson(Cmd.Fail(unrec(a)), json)

def parseMsg(args: List[String], i: Int): Cmd =
  parseMsg2(takeVal(args, i, "--message-format"), args)

def parseMsg2(p: (String, Int), args: List[String]): Cmd =
  p match {
    case (_, n) => if (n == 0 - 1) Cmd.Fail(needVal("--message-format")) else if (n == 0 - 2) Cmd.Fail(unexp(arg(args, 0), "scuzz [OPTIONS] <COMMAND>")) else parseMsg3(p._1, args, p._2)
  }

def parseMsg3(v: String, args: List[String], j: Int): Cmd =
  if (v == "json") parseAt(args, j, true) else if (v == "human") parseAt(args, j, false) else Cmd.Fail(badFmt(v))

def parseHelp(args: List[String], i: Int, json: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Help(""), json) else if (isCmd(arg(args, i)) || arg(args, i) == "") gateJson(Cmd.Help(arg(args, i)), json) else gateJson(Cmd.Fail(unrec(arg(args, i))), json)

def parseCmd(args: List[String], cmd: String, i: Int, json: Bool): Cmd =
  if (cmd == "fmt") parseFmt(args, i, json, ".", false) else if (cmd == "check") parseCheck(args, i, json, ".") else if (cmd == "build") parseBuild(args, i, json, ".", "build", false, false) else if (cmd == "run") parseRun(args, i, json, ".", "build", false, false, "", "") else if (cmd == "watch") parseWatch(args, i, json, ".", "build") else if (cmd == "test") parseTest(args, i, json, ".", false, false, false) else if (cmd == "lsp") parseLsp(args, i, json, ".") else if (cmd == "fuzz") parseFuzz(args, i, json, ".", 32, 42, "", false, false, false, false) else if (cmd == "new") parseNew(args, i, json, "", ".", false) else if (cmd == "ide") parseIde(args, i, json, ".", "build", false) else parsePkg(args, i, json, ".", "build", "host")

def parseFmt(args: List[String], i: Int, json: Bool, path: String, check: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Fmt(path, check), json) else parseFmtTok(args, i, json, path, check, arg(args, i))

def parseFmtTok(args: List[String], i: Int, json: Bool, path: String, check: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("fmt"), json) else if (a == "--check") parseFmt(args, i + 1, json, path, true) else if (a == "--message-format" || flagPref(a, "--message-format")) parseFmtMsg(takeVal(args, i, "--message-format"), args, path, check) else if (a == "--") parseFmtPos(args, i + 1, json, path, check) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz fmt [OPTIONS] [PATH]")) else parseFmt(args, i + 1, json, a, check)

def parseFmtMsg(p: (String, Int), args: List[String], path: String, check: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(if (n == 0 - 1) needVal("--message-format") else unexp(arg(args, 0), "scuzz fmt [OPTIONS] [PATH]")) else if (v == "json") parseFmt(args, n, true, path, check) else if (v == "human") parseFmt(args, n, false, path, check) else Cmd.Fail(badFmt(v))
  }

def parseFmtPos(args: List[String], i: Int, json: Bool, path: String, check: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Fmt(path, check), json) else parseFmt(args, i + 1, json, arg(args, i), check)

def parseCheck(args: List[String], i: Int, json: Bool, path: String): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Check(path, json), json) else parseCheckTok(args, i, json, path, arg(args, i))

def parseCheckTok(args: List[String], i: Int, json: Bool, path: String, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("check"), json) else if (a == "--message-format" || flagPref(a, "--message-format")) parseCheckMsg(takeVal(args, i, "--message-format"), args, path) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz check [OPTIONS] [PATH]")) else parseCheck(args, i + 1, json, a)

def parseCheckMsg(p: (String, Int), args: List[String], path: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(if (n == 0 - 1) needVal("--message-format") else unexp(arg(args, 0), "scuzz check [OPTIONS] [PATH]")) else if (v == "json") parseCheck(args, n, true, path) else if (v == "human") parseCheck(args, n, false, path) else Cmd.Fail(badFmt(v))
  }

def parseBuild(args: List[String], i: Int, json: Bool, path: String, outDir: String, full: Bool, verify: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Build(path, outDir, full, verify), json) else parseBuildTok(args, i, json, path, outDir, full, verify, arg(args, i))

def parseBuildTok(args: List[String], i: Int, json: Bool, path: String, outDir: String, full: Bool, verify: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("build"), json) else if (a == "--full") parseBuild(args, i + 1, json, path, outDir, true, verify) else if (a == "--verify") parseBuild(args, i + 1, json, path, outDir, full, true) else if (a == "--out-dir" || flagPref(a, "--out-dir")) parseBuildOut(takeVal(args, i, "--out-dir"), args, json, path, full, verify) else if (a == "--message-format" || flagPref(a, "--message-format")) parseBuildMsg(takeVal(args, i, "--message-format"), args, path, outDir, full, verify) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz build [OPTIONS] [PATH]")) else parseBuild(args, i + 1, json, a, outDir, full, verify)

def parseBuildOut(p: (String, Int), args: List[String], json: Bool, path: String, full: Bool, verify: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--out-dir")) else parseBuild(args, n, json, path, v, full, verify)
  }

def parseBuildMsg(p: (String, Int), args: List[String], path: String, outDir: String, full: Bool, verify: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseBuild(args, n, true, path, outDir, full, verify) else if (v == "human") parseBuild(args, n, false, path, outDir, full, verify) else Cmd.Fail(badFmt(v))
  }

def parseRun(args: List[String], i: Int, json: Bool, path: String, outDir: String, headless: Bool, watch: Bool, script: String, dump: String): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Run(path, outDir, headless, watch, script, dump), json) else parseRunTok(args, i, json, path, outDir, headless, watch, script, dump, arg(args, i))

def parseRunTok(args: List[String], i: Int, json: Bool, path: String, outDir: String, headless: Bool, watch: Bool, script: String, dump: String, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("run"), json) else if (a == "--headless") parseRun(args, i + 1, json, path, outDir, true, watch, script, dump) else if (a == "--watch") parseRun(args, i + 1, json, path, outDir, headless, true, script, dump) else if (a == "--out-dir" || flagPref(a, "--out-dir")) parseRunOut(takeVal(args, i, "--out-dir"), args, json, path, headless, watch, script, dump) else if (a == "--script" || flagPref(a, "--script")) parseRunScript(takeVal(args, i, "--script"), args, json, path, outDir, headless, watch, dump) else if (a == "--dump" || flagPref(a, "--dump")) parseRunDump(takeVal(args, i, "--dump"), args, json, path, outDir, headless, watch, script) else if (a == "--message-format" || flagPref(a, "--message-format")) parseRunMsg(takeVal(args, i, "--message-format"), args, path, outDir, headless, watch, script, dump) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz run [OPTIONS] [PATH]")) else parseRun(args, i + 1, json, a, outDir, headless, watch, script, dump)

def parseRunOut(p: (String, Int), args: List[String], json: Bool, path: String, headless: Bool, watch: Bool, script: String, dump: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--out-dir")) else parseRun(args, n, json, path, v, headless, watch, script, dump)
  }

def parseRunScript(p: (String, Int), args: List[String], json: Bool, path: String, outDir: String, headless: Bool, watch: Bool, dump: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--script")) else parseRun(args, n, json, path, outDir, headless, watch, v, dump)
  }

def parseRunDump(p: (String, Int), args: List[String], json: Bool, path: String, outDir: String, headless: Bool, watch: Bool, script: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--dump")) else parseRun(args, n, json, path, outDir, headless, watch, script, v)
  }

def parseRunMsg(p: (String, Int), args: List[String], path: String, outDir: String, headless: Bool, watch: Bool, script: String, dump: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseRun(args, n, true, path, outDir, headless, watch, script, dump) else if (v == "human") parseRun(args, n, false, path, outDir, headless, watch, script, dump) else Cmd.Fail(badFmt(v))
  }

def parseWatch(args: List[String], i: Int, json: Bool, path: String, outDir: String): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Watch(path, outDir), json) else parseWatchTok(args, i, json, path, outDir, arg(args, i))

def parseWatchTok(args: List[String], i: Int, json: Bool, path: String, outDir: String, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("watch"), json) else if (a == "--out-dir" || flagPref(a, "--out-dir")) parseWatchOut(takeVal(args, i, "--out-dir"), args, json, path) else if (a == "--message-format" || flagPref(a, "--message-format")) parseWatchMsg(takeVal(args, i, "--message-format"), args, path, outDir) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz watch [OPTIONS] [PATH]")) else parseWatch(args, i + 1, json, a, outDir)

def parseWatchOut(p: (String, Int), args: List[String], json: Bool, path: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--out-dir")) else parseWatch(args, n, json, path, v)
  }

def parseWatchMsg(p: (String, Int), args: List[String], path: String, outDir: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseWatch(args, n, true, path, outDir) else if (v == "human") parseWatch(args, n, false, path, outDir) else Cmd.Fail(badFmt(v))
  }

def parseTest(args: List[String], i: Int, json: Bool, path: String, update: Bool, pixels: Bool, differential: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Test(path, update, pixels, differential), json) else parseTestTok(args, i, json, path, update, pixels, differential, arg(args, i))

def parseTestTok(args: List[String], i: Int, json: Bool, path: String, update: Bool, pixels: Bool, differential: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("test"), json) else if (a == "--update") parseTest(args, i + 1, json, path, true, pixels, differential) else if (a == "--pixels") parseTest(args, i + 1, json, path, update, true, differential) else if (a == "--differential") parseTest(args, i + 1, json, path, update, pixels, true) else if (a == "--message-format" || flagPref(a, "--message-format")) parseTestMsg(takeVal(args, i, "--message-format"), args, path, update, pixels, differential) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz test [OPTIONS] [PATH]")) else parseTest(args, i + 1, json, a, update, pixels, differential)

def parseTestMsg(p: (String, Int), args: List[String], path: String, update: Bool, pixels: Bool, differential: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseTest(args, n, true, path, update, pixels, differential) else if (v == "human") parseTest(args, n, false, path, update, pixels, differential) else Cmd.Fail(badFmt(v))
  }

def parseLsp(args: List[String], i: Int, json: Bool, path: String): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Lsp(path), json) else parseLspTok(args, i, json, path, arg(args, i))

def parseLspTok(args: List[String], i: Int, json: Bool, path: String, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("lsp"), json) else if (a == "--message-format" || flagPref(a, "--message-format")) parseLspMsg(takeVal(args, i, "--message-format"), args, path) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz lsp [OPTIONS] [PATH]")) else parseLsp(args, i + 1, json, a)

def parseLspMsg(p: (String, Int), args: List[String], path: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseLsp(args, n, true, path) else if (v == "human") parseLsp(args, n, false, path) else Cmd.Fail(badFmt(v))
  }

def parseFuzz(args: List[String], i: Int, json: Bool, path: String, iterations: Int, seed: Int, replay: String, oracles: Bool, noFailFast: Bool, minimize: Bool, relate: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Fuzz(path, iterations, seed, replay, oracles, noFailFast, minimize, relate), json) else parseFuzzTok(args, i, json, path, iterations, seed, replay, oracles, noFailFast, minimize, relate, arg(args, i))

def parseFuzzTok(args: List[String], i: Int, json: Bool, path: String, iterations: Int, seed: Int, replay: String, oracles: Bool, noFailFast: Bool, minimize: Bool, relate: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("fuzz"), json) else if (a == "--oracles") parseFuzz(args, i + 1, json, path, iterations, seed, replay, true, noFailFast, minimize, relate) else if (a == "--no-fail-fast") parseFuzz(args, i + 1, json, path, iterations, seed, replay, oracles, true, minimize, relate) else if (a == "--minimize-corpus") parseFuzz(args, i + 1, json, path, iterations, seed, replay, oracles, noFailFast, true, relate) else if (a == "--relate") parseFuzz(args, i + 1, json, path, iterations, seed, replay, oracles, noFailFast, minimize, true) else if (a == "--iterations" || flagPref(a, "--iterations")) parseFuzzIter(takeVal(args, i, "--iterations"), args, json, path, seed, replay, oracles, noFailFast, minimize, relate) else if (a == "--seed" || flagPref(a, "--seed")) parseFuzzSeed(takeVal(args, i, "--seed"), args, json, path, iterations, replay, oracles, noFailFast, minimize, relate) else if (a == "--replay" || flagPref(a, "--replay")) parseFuzzReplay(takeVal(args, i, "--replay"), args, json, path, iterations, seed, oracles, noFailFast, minimize, relate) else if (a == "--message-format" || flagPref(a, "--message-format")) parseFuzzMsg(takeVal(args, i, "--message-format"), args, path, iterations, seed, replay, oracles, noFailFast, minimize, relate) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz fuzz [OPTIONS] [PATH]")) else parseFuzz(args, i + 1, json, a, iterations, seed, replay, oracles, noFailFast, minimize, relate)

def parseFuzzIter(p: (String, Int), args: List[String], json: Bool, path: String, seed: Int, replay: String, oracles: Bool, noFailFast: Bool, minimize: Bool, relate: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--iterations")) else parseFuzz(args, n, json, path, Str.toInt(v, 32), seed, replay, oracles, noFailFast, minimize, relate)
  }

def parseFuzzSeed(p: (String, Int), args: List[String], json: Bool, path: String, iterations: Int, replay: String, oracles: Bool, noFailFast: Bool, minimize: Bool, relate: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--seed")) else parseFuzz(args, n, json, path, iterations, Str.toInt(v, 42), replay, oracles, noFailFast, minimize, relate)
  }

def parseFuzzReplay(p: (String, Int), args: List[String], json: Bool, path: String, iterations: Int, seed: Int, oracles: Bool, noFailFast: Bool, minimize: Bool, relate: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--replay")) else parseFuzz(args, n, json, path, iterations, seed, v, oracles, noFailFast, minimize, relate)
  }

def parseFuzzMsg(p: (String, Int), args: List[String], path: String, iterations: Int, seed: Int, replay: String, oracles: Bool, noFailFast: Bool, minimize: Bool, relate: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseFuzz(args, n, true, path, iterations, seed, replay, oracles, noFailFast, minimize, relate) else if (v == "human") parseFuzz(args, n, false, path, iterations, seed, replay, oracles, noFailFast, minimize, relate) else Cmd.Fail(badFmt(v))
  }

def parseNew(args: List[String], i: Int, json: Bool, name: String, path: String, ui: Bool): Cmd =
  if (i >= List.len(args)) if (name == "") Cmd.Fail(missName()) else gateJson(Cmd.New(name, path, ui), json) else parseNewTok(args, i, json, name, path, ui, arg(args, i))

def parseNewTok(args: List[String], i: Int, json: Bool, name: String, path: String, ui: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("new"), json) else if (a == "--ui") parseNew(args, i + 1, json, name, path, true) else if (a == "--path" || flagPref(a, "--path")) parseNewPath(takeVal(args, i, "--path"), args, json, name, ui) else if (a == "--message-format" || flagPref(a, "--message-format")) parseNewMsg(takeVal(args, i, "--message-format"), args, name, path, ui) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz new [OPTIONS] <NAME>")) else parseNew(args, i + 1, json, a, path, ui)

def parseNewPath(p: (String, Int), args: List[String], json: Bool, name: String, ui: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--path")) else parseNew(args, n, json, name, v, ui)
  }

def parseNewMsg(p: (String, Int), args: List[String], name: String, path: String, ui: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseNew(args, n, true, name, path, ui) else if (v == "human") parseNew(args, n, false, name, path, ui) else Cmd.Fail(badFmt(v))
  }

def parseIde(args: List[String], i: Int, json: Bool, path: String, outDir: String, headless: Bool): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Ide(path, outDir, headless), json) else parseIdeTok(args, i, json, path, outDir, headless, arg(args, i))

def parseIdeTok(args: List[String], i: Int, json: Bool, path: String, outDir: String, headless: Bool, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("ide"), json) else if (a == "--headless") parseIde(args, i + 1, json, path, outDir, true) else if (a == "--out-dir" || flagPref(a, "--out-dir")) parseIdeOut(takeVal(args, i, "--out-dir"), args, json, path, headless) else if (a == "--message-format" || flagPref(a, "--message-format")) parseIdeMsg(takeVal(args, i, "--message-format"), args, path, outDir, headless) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz ide [OPTIONS] [PATH]")) else parseIde(args, i + 1, json, a, outDir, headless)

def parseIdeOut(p: (String, Int), args: List[String], json: Bool, path: String, headless: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--out-dir")) else parseIde(args, n, json, path, v, headless)
  }

def parseIdeMsg(p: (String, Int), args: List[String], path: String, outDir: String, headless: Bool): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parseIde(args, n, true, path, outDir, headless) else if (v == "human") parseIde(args, n, false, path, outDir, headless) else Cmd.Fail(badFmt(v))
  }

def parsePkg(args: List[String], i: Int, json: Bool, path: String, outDir: String, target: String): Cmd =
  if (i >= List.len(args)) gateJson(Cmd.Package(path, outDir, target), json) else parsePkgTok(args, i, json, path, outDir, target, arg(args, i))

def parsePkgTok(args: List[String], i: Int, json: Bool, path: String, outDir: String, target: String, a: String): Cmd =
  if (isHelp(a)) gateJson(Cmd.Help("package"), json) else if (a == "--target" || flagPref(a, "--target")) parsePkgTarget(takeVal(args, i, "--target"), args, json, path, outDir) else if (a == "--out-dir" || flagPref(a, "--out-dir")) parsePkgOut(takeVal(args, i, "--out-dir"), args, json, path, target) else if (a == "--message-format" || flagPref(a, "--message-format")) parsePkgMsg(takeVal(args, i, "--message-format"), args, path, outDir, target) else if (isFlag(a)) Cmd.Fail(unexp(a, "scuzz package [OPTIONS] [PATH]")) else parsePkg(args, i + 1, json, a, outDir, target)

def parsePkgTarget(p: (String, Int), args: List[String], json: Bool, path: String, outDir: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--target")) else parsePkg(args, n, json, path, outDir, v)
  }

def parsePkgOut(p: (String, Int), args: List[String], json: Bool, path: String, target: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--out-dir")) else parsePkg(args, n, json, path, v, target)
  }

def parsePkgMsg(p: (String, Int), args: List[String], path: String, outDir: String, target: String): Cmd =
  p match {
    case (v, n) => if (n < 0) Cmd.Fail(needVal("--message-format")) else if (v == "json") parsePkg(args, n, true, path, outDir, target) else if (v == "human") parsePkg(args, n, false, path, outDir, target) else Cmd.Fail(badFmt(v))
  }

def fmtSrc(src: String): String =
  Parse.pretty(Parse.parse(Lexer.lex(src)))

def runCmd(c: Cmd, src: String): String =
  c match {
    case Cmd.Check(_, json) => if (json) Check.check(src) else Check.human(src)
    case Cmd.Fmt(_, _) => fmtSrc(src)
    case Cmd.Test(_, _, _, _) => Verify.testOut(Check.check(src) == "[]")
    case Cmd.Fuzz(_, it, seed, _, _, _, _, _) => Verify.fuzzOut(it, seed, 0, 0, 0)
    case Cmd.Build(_, outDir, _, _) => Drive.showPkg(Drive.compilePkg("[package]\nname = \"hello\"\nversion = \"0.1.0\"\n", src, outDir, "clang", "crates/runtime/build/libscuzz_rt.a"))
    case _ => render(c)
  }

def dispatch(c: Cmd): IO[Unit] =
  c match {
    case Cmd.Build(path, outDir, _, _) => dispatchBuild(path, outDir)
    case Cmd.Run(path, outDir, headless, _, _, _) => dispatchRun(path, outDir, headless)
    case Cmd.Check(path, json) => Drive.checkDir(path, json)
    case Cmd.Fmt(path, check) => dispatchFmt(path, check)
    case Cmd.Test(path, _, _, _) => dispatchTest(path)
    case Cmd.New(name, path, ui) => dispatchNew(name, path, ui)
    case Cmd.Help(t) => IO.println(helpOf(t))
    case Cmd.Version => IO.println("scuzz 0.2.0")
    case Cmd.Fail(m) => IO.println(m)
    case _ => IO.println(show(c))
  }

def dispatchBuild(path: String, outDir: String): IO[Unit] =
  Fs.mkdirs(outDir).flatMap(_ => Drive.emitDir(path, outDir))

def dispatchRun(path: String, outDir: String, headless: Bool): IO[Unit] =
  Fs.mkdirs(outDir).flatMap(_ => Drive.runDir(path, outDir, if (headless) Drive.headlessEnv() else ""))

def dispatchTest(path: String): IO[Unit] =
  Fs.mkdirs(Drive.joinSlash(path, "build")).flatMap(_ => Drive.testDir(path, Drive.joinSlash(path, "build")))

def dispatchFmt(path: String, check: Bool): IO[Unit] =
  Fs.list(Drive.joinSlash(path, "src")).flatMap(ents => Drive.readSrcFiles(Drive.joinSlash(path, "src"), ents).flatMap(files => fmtFiles(path, check, files, 0)))

def fmtFiles(dir: String, check: Bool, files: List[(String, String)], dirty: Int): IO[Unit] =
  if (List.isEmpty(files)) fmtDone(check, dirty) else fmtFilesGo(dir, check, List.head(files), files, dirty)

def fmtFilesGo(dir: String, check: Bool, h: (String, String), files: List[(String, String)], dirty: Int): IO[Unit] =
  fmtOne(dir, check, h).flatMap(n => fmtFiles(dir, check, List.tail(files), dirty + n))

def fmtOne(dir: String, check: Bool, h: (String, String)): IO[Int] =
  h match {
    case (stem, src) => fmtOnePath(check, Drive.joinSlash(Drive.joinSlash(dir, "src"), Str.concat(stem, ".scuzz")), src)
  }

def fmtOnePath(check: Bool, path: String, src: String): IO[Int] =
  fmtOneGot(check, path, src, fmtSrc(src))

def fmtOneGot(check: Bool, path: String, src: String, pretty: String): IO[Int] =
  if (pretty == src) IO.pure(0) else if (check) IO.println(Str.concat("would reformat ", path)).map(_ => 1) else Fs.write(path, pretty).flatMap(_ => IO.println(Str.concat("formatted ", path)).map(_ => 1))

def fmtDone(check: Bool, dirty: Int): IO[Unit] =
  if (check && dirty > 0) IO.println(Str.concat(Str.fromInt(dirty), " file(s) need formatting")).flatMap(_ => IO.fail("scuzz fmt")) else IO.println("scuzz fmt ok")

def newTomlUi(name: String): String =
  Str.concat("[package]\nname = \"", Str.concat(name, Str.concat("\"\nversion = \"0.1.0\"\n\n[ui]\ndefault_runtime = \"headless\"\nheadless_size = [200, 120]\nheadless_scale = 1.0\nbundle_id = \"dev.scuzz.", Str.concat(name, "\"\n"))))

def newTomlIo(name: String): String =
  Str.concat("[package]\nname = \"", Str.concat(name, "\"\nversion = \"0.1.0\"\n"))

def newMainUi(): String =
  """@main def main: IO[Unit] =
  for {
    count = Signal.int(0)
    label = Signal.map(count, n => s"count = $n")
    _ <- Ui.run(_ => View.column(
      View.text("Counter"),
      View.bindText(label),
      View.row(View.button("+1", _ => Signal.set(count, Signal.get(count) + 1)))
    ))
  } yield ()
"""

def newMainIo(): String =
  """@main def main: IO[Unit] =
  IO.println("Hello, Scuzz!").flatMap(_ => IO.println("ready."))
"""

def dispatchNew(name: String, path: String, ui: Bool): IO[Unit] =
  dispatchNewDir(Drive.joinSlash(path, name), name, ui)

def dispatchNewDir(dir: String, name: String, ui: Bool): IO[Unit] =
  Fs.mkdirs(Drive.joinSlash(dir, "src")).flatMap(_ => writeNew(dir, name, ui))

def writeNew(dir: String, name: String, ui: Bool): IO[Unit] =
  Fs.write(Drive.joinSlash(dir, "scuzz.toml"), if (ui) newTomlUi(name) else newTomlIo(name)).flatMap(_ => writeNewMain(dir, name, ui))

def writeNewMain(dir: String, name: String, ui: Bool): IO[Unit] =
  Fs.write(Drive.joinSlash(Drive.joinSlash(dir, "src"), "Main.scuzz"), if (ui) newMainUi() else newMainIo()).flatMap(_ => IO.println(if (ui) Str.concat("created ", Str.concat(dir, " (ui) — next: scuzz test --update && scuzz test && scuzz run --headless")) else Str.concat("created ", Str.concat(dir, " — next: scuzz test && scuzz run"))))


