oracle generationSteerAndPreferences(): Bool =
  for {
    prefAccept = Json.Obj([("kind", Json.Str("preference")), ("decision", Json.Str("accept")), ("proposal", Json.Str("p-acc")), ("reason", Json.Str(""))])
    prefSkip = Json.Obj([("kind", Json.Str("preference")), ("decision", Json.Str("skip")), ("proposal", Json.Str("p-skip")), ("reason", Json.Str("need-another-scenario"))])
    steer = Json.Obj([("kind", Json.Str("steer")), ("id", Json.Str("s1")), ("prompt", Json.Str("add reset button"))])
    request = Json.Obj([("objective", Json.Str("Build counter")), ("sources", Proposal.pairsJson([("src/Main.scuzz", "before")])), ("allowed", Json.Arr([Json.Str("src/Main.scuzz")])), ("checks", Json.Arr([])), ("feedback", Json.Arr([prefAccept, prefSkip, steer]))])
    msgs = Json.arr(Generate.messages(request))
    userContent = Proposal.str(List.at(msgs, 1), "content")
  } yield List.len(msgs) == 2 && Str.contains(userContent, "Follow this mobile steer prompt: add reset button") && Str.contains(userContent, "accept:p-acc") && Str.contains(userContent, "skip:p-skip (need-another-scenario)")

