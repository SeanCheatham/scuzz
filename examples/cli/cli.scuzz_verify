def cliHelp(): Bool =
  Main.cliDiff(Cli.render(Cli.parse(Main.a1("--help"))), Help.helpRoot())

def cliFmtHelp(): Bool =
  Main.cliDiff(Cli.render(Cli.parse(Main.a2("fmt", "--help"))), Help.helpFmt())

def cliCheckHelp(): Bool =
  Main.cliDiff(Cli.render(Cli.parse(Main.a2("check", "--help"))), Help.helpCheck())

def cliFmtArgs(): Bool =
  Main.cliDiff(Cli.show(Cli.parse(Main.a3("fmt", "--check", "examples/hello"))), "fmt path=examples/hello check=true")

def cliJsonCheck(): Bool =
  Main.cliDiff(Cli.show(Cli.parse(Main.a2("--message-format=json", "check"))), "check path=. json=true")

def cliUnrec(): Bool =
  Main.cliDiff(Cli.render(Cli.parse(Main.a1("nope"))), Main.wantUnrec())

def cliUnexp(): Bool =
  Main.cliDiff(Cli.render(Cli.parse(Main.a2("fmt", "--nope"))), Main.wantUnexp())

def cliJsonOnly(): Bool =
  Main.cliDiff(Cli.render(Cli.parse(Main.a2("--message-format=json", "fmt"))), Main.wantJsonOnly())

def cliFuzz(): Bool =
  Main.cliDiff(Cli.show(Cli.parse(Main.a3("fuzz", "--iterations", "16"))), "fuzz path=. iterations=16 seed=42 replay= oracles=false noFailFast=false minimize=false relate=false")

def cliFmtSrc(): Bool =
  Main.cliDiff(Cli.fmtSrc(Main.srcHi()), Main.wantHi())

def cliIdemFmt(): Bool =
  Main.cliIdem(Main.a1("fmt"))

def drvHello(): Bool =
  Drive.showMan(Manifest.parse(Main.tomlHello())) == "name=hello ver=0.1.0 ui=false deps=0"

def drvPlugins(): Bool =
  Drive.showMan(Manifest.parse(Main.tomlPlugins())) == Str.concat("err:", Main.wantPlugins())

def drvIr(): Bool =
  Drive.compileSrc(Main.srcIrHi()).ir == Main.wantIrHi()

def drvTyck(): Bool =
  Drive.compileSrc(Main.srcTyUnbound()).diags == Main.wantTyUnbound()

def drvLink(): Bool =
  Drive.linkLine("clang", Drive.llName("build", "hello"), "crates/runtime/build/libscuzz_rt.a", Drive.exeName("build", "hello")) == Main.wantLink()

def drvLinkUi(): Bool =
  Drive.linkLineHost(true, false, "clang", "a.ll", "rt.a", "app", ".", false) == Main.wantLinkUi()

def drvLinkMacUi(): Bool =
  Drive.linkLineHost(true, true, "clang", "a.ll", "rt.a", "app", ".", false) == Main.wantLinkMacUi()

def drvIdem(): Bool =
  Drive.compileSrc(Main.srcIrHi()).ir == Drive.compileSrc(Main.srcIrHi()).ir

def verJson(): Bool =
  Cli.runCmd(Cli.parse(Main.a2("check", "--message-format=json")), Main.srcTyUnbound()) == Main.wantTyUnbound()

def verHuman(): Bool =
  Cli.runCmd(Cli.parse(Main.a1("check")), Main.srcTyUnbound()) == Main.wantHumanUnbound()

def verOk(): Bool =
  Cli.runCmd(Cli.parse(Main.a1("check")), Main.srcIrHi()) == "scuzz check ok"

def campSeeds(): Bool =
  Verify.seeds(Main.srcAddVerify()) == Main.wantAddSeeds()

def campWrap(): Bool =
  Verify.wrapSrc("bump", Main.srcBumpVerify()) == Main.wantWrapBump()

def campFuzz0(): Bool =
  Verify.fuzzOut(0, 42, 0, 0, 0, 0) == Main.wantFuzzHello0()

def campEvents(): Bool =
  Verify.nls(Verify.parseEvents(Main.srcBumpRepro())) == Main.wantBumpEvents()

def campTest(): Bool =
  Cli.runCmd(Cli.parse(Main.a1("test")), Main.srcIrHi()) == Main.wantTestOk()

def campEmpty(): Bool =
  Verify.checkVerify("", "bad-intent/empty.scuzz_verify") == Main.wantEmptyVerify()

def drvPkg(): Bool =
  Drive.showPkg(Drive.compilePkg(Main.tomlHello(), Main.srcIrHi(), "build", "clang", "crates/runtime/build/libscuzz_rt.a")) == Main.wantPkg()

def drvFiles(): Bool =
  Drive.showPkg(Drive.compileFiles(Main.tomlHello(), ("Main", Main.srcIrHi()) :: Manifest.noPairs(), "build", "clang", "crates/runtime/build/libscuzz_rt.a")) == Main.wantPkg()

