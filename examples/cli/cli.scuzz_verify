  } yield List.contains(Generate.anchors(request, "src/Main.scuzz"), "unique") && !List.contains(Generate.anchors(request, "src/Main.scuzz"), "same") && List.contains(Generate.anchors(request, "src/Main.scuzz"), """same
unique""") && Generate.anchors(request, "src/New.scuzz") == [""] && Proposal.str(Generate.schema(request), "type") == "object" && List.contains(Json.keys(Proposal.field(Generate.schema(request), "properties")), "edits")

oracle generationRepairSources(): Bool =
  for {
    baseline = [("src/Main.scuzz", "before"), ("src/Other.scuzz", "keep")]
    failed = [("src/Main.scuzz", """candidate
line two
line three
line four
""")]
    request = Json.Obj([("sources", Proposal.pairsJson(baseline)), ("allowed", Json.Arr([Json.Str("src/Main.scuzz"), Json.Str("src/Other.scuzz")])), ("feedback", Json.Arr([Json.Obj([("decision", Json.Str("candidate-failed")), ("source", Proposal.pairsJson(failed))])]))])
    blocked = Json.set(request, "feedback", Json.Arr([Json.Obj([("decision", Json.Str("candidate-failed")), ("source", Proposal.pairsJson([("src/Unsafe.scuzz", "outside")]))])]))
  } yield List.contains(Generate.workingSources(request), List.at(failed, 0)) && List.contains(Generate.workingSources(request), ("src/Other.scuzz", "keep")) && Generate.workingSources(blocked) == baseline && List.contains(Generate.anchors(request, "src/Main.scuzz"), List.at(failed, 0)._2)

