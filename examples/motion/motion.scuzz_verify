def positionAddChangesCount(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Position add", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "positionCount") == Timeline.signalInt(t, before, "positionCount") + 1
