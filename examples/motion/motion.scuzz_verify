def scaleLabelsFollowValues(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "scaleShown") == 0 || Timeline.a11yHas(t, i, s"text:Scale target: ${Timeline.signalInt(t, i, "scaleValue")}") && Timeline.a11yHas(t, i, s"text:Scale count: ${Timeline.signalInt(t, i, "scaleCount")}"))

def scaleTargetFollowsSignal(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "scaleShown") == 0 || Timeline.signalInt(t, i, "scaleVisible") == 0 || Timeline.a11yHas(t, i, Str.concat("target:scale:Scale bounds=", Str.concat(Str.fromInt(Timeline.signalInt(t, i, "scaleValue")), """
