def positionLabelsFollowValues(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "positionShown") == 0 || Timeline.a11yHas(t, i, Str.concat("text:X target: ", Str.fromInt(Timeline.signalInt(t, i, "positionX")))) && Timeline.a11yHas(t, i, Str.concat("text:Y target: ", Str.fromInt(Timeline.signalInt(t, i, "positionY")))) && Timeline.a11yHas(t, i, Str.concat("text:Position count: ", Str.fromInt(Timeline.signalInt(t, i, "positionCount")))))

def positionTargetFollowsSignals(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "positionShown") == 0 || Timeline.signalInt(t, i, "positionVisible") == 0 || Timeline.a11yHas(t, i, Str.concat("target:position:Position bounds=", Str.concat(Str.fromInt(Timeline.signalInt(t, i, "positionX")), Str.concat(",", Str.concat(Str.fromInt(Timeline.signalInt(t, i, "positionY")), """
"""))))))

def reducedPositionHasNoPendingPumps(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "positionShown") == 0 || Timeline.signalInt(t, i, "positionVisible") == 0 || Timeline.signalInt(t, i, "reduced") == 0 || Timeline.a11yHas(t, i, """pumps:position:Position bounds=0
"""))

def settledPositionKeepsInput(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "positionShown") == 0 || Timeline.signalInt(t, i, "positionVisible") == 0 || !Timeline.a11yHas(t, i, """pumps:position:Position bounds=0
""") || Timeline.signalInt(t, i, "positionX") > 200 || Timeline.signalInt(t, i, "positionY") > 160 || Timeline.a11yHas(t, i, "textfield:Position name"))

def scaleStartsReady(t: Timeline): Verdict =
  Verdict.every(t, i => i != 0 || Timeline.signalInt(t, i, "scaleValue") == 100 && Timeline.signalInt(t, i, "scaleShown") == 0 && Timeline.signalInt(t, i, "scaleVisible") == 1 && Timeline.signalInt(t, i, "scaleCount") == 0 && Timeline.signalStrHas(t, i, "scaleName", "Retained scale input"))

def growSetsScale(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Grow scale", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "scaleValue") == 200
