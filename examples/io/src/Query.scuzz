private def printKeys(j: Json): IO[Unit] =
  IO.println(Str.concat("keys:", List.join(Json.keys(j), ",")))

private def printInt(j: Json, key: String): IO[Unit] =
  IO.println(s"int:$key:${Str.fromInt(Json.getInt(j, key, -1))}")

private def printHas(j: Json, key: String): IO[Unit] =
  IO.println(Str.concat(s"has:$key:", if (Json.has(j, key)) "1" else "0"))

private def printArr(j: Json): IO[Unit] =
  IO.println(s"arr:${Str.fromInt(List.len(Json.arr(j)))}")

private def printAt(j: Json, i: Int): IO[Unit] =
  IO.println(s"at:${Str.fromInt(i)}:${Str.fromInt(List.len(Json.at(j, i)))}")

private def printMerge(a: Json, b: Json): IO[Unit] =
  for {
    m = Json.merge(a, b)
    _ <- IO.println(if (Json.isObj(m)) "merge:obj" else "merge:other")
    _ <- IO.println(s"mergeN:${Str.fromInt(Json.getInt(m, "n", 0))}")
  } yield ()

private def printSet(j: Json): IO[Unit] =
  for {
    s = Json.set(j, "n", Json.Int(8))
    r = Json.remove(s, "ok")
    _ <- IO.println(s"setN:${Str.fromInt(Json.getInt(s, "n", 0))}")
    _ <- IO.println(Str.concat("setHasOk:", if (Json.has(r, "ok")) "1" else "0"))
  } yield ()

private def printArrWrite(): IO[Unit] =
  for {
    a = Json.append(Json.Null(), Json.Int(1))
    p = Json.prepend(a, Json.Int(0))
    u = Json.setAt(p, 1, Json.Int(9))
    d = Json.dropAt(u, 0)
    _ <- IO.println(s"arrW:${Str.fromInt(List.len(Json.arr(d)))}")
    at0 = Json.at(d, 0)
    j0 = List.head(at0) match {
  case Option.Some(j) => j
  case Option.None => Json.Null()
}
    _ <- IO.println(s"arrW0:${Str.fromInt(Json.intOr(j0, -1))}")
  } yield ()

private def printFloat(): IO[Unit] =
  IO.println(if (Json.floatOr(Json.Float(1.5), 0.0) > 0.0) "float:pos" else "float:z")

private def printIsFloat(src: String, label: String): IO[Unit] =
  Json.parse(src) match {
    case Result.Err(_) => IO.println(Str.concat(label, ":err"))
    case Result.Ok(j) => IO.println(Str.concat(label, if (Json.isFloat(j)) ":1" else ":0"))
  }

private def printGetIntSrc(src: String, label: String): IO[Unit] =
  Json.parse(src) match {
    case Result.Err(_) => IO.println(Str.concat(label, ":err"))
    case Result.Ok(j) => IO.println(s"$label:${Str.fromInt(Json.getInt(j, "n", -1))}")
  }

private def printGetFloatSrc(src: String, label: String): IO[Unit] =
  Json.parse(src) match {
    case Result.Err(_) => IO.println(Str.concat(label, ":err"))
    case Result.Ok(j) => IO.println(if (Json.getFloat(j, "n", -1.0) > 0.5) Str.concat(label, ":pos") else Str.concat(label, ":z"))
  }

private def coerceKit(): IO[Unit] =
  for {
    _ <- printIsFloat("1.5", "isFloat15")
    _ <- printIsFloat("1", "isFloat1")
    _ <- printGetIntSrc("{\"n\":1.0}", "getInt10")
    _ <- printGetIntSrc("{\"n\":1e2}", "getInt1e2")
    _ <- printGetFloatSrc("{\"n\":1}", "getFloat1")
  } yield ()

private def printStr(j: Json, key: String): IO[Unit] =
  IO.println(Str.concat(s"str:$key:", Json.getStr(j, key, "")))

private def printBool(j: Json, key: String): IO[Unit] =
  IO.println(Str.concat(s"bool:$key:", if (Json.getBool(j, key, false)) "1" else "0"))

private def printTags(j: Json): IO[Unit] =
  for {
    _ <- IO.println(Str.concat("null:", if (Json.isNull(j)) "1" else "0"))
    _ <- IO.println(Str.concat("obj:", if (Json.isObj(j)) "1" else "0"))
    _ <- IO.println(Str.concat("arr:", if (Json.isArr(j)) "1" else "0"))
  } yield ()

private def objKitOk(j: Json): IO[Unit] =
  for {
    _ <- printKeys(j)
    _ <- printInt(j, "n")
    _ <- printInt(j, "missing")
    _ <- printHas(j, "ok")
    _ <- printHas(j, "missing")
    _ <- printStr(j, "s")
    _ <- printBool(j, "ok")
    _ <- IO.println(Str.concat("isBool:", if (Json.isBool(j)) "1" else "0"))
    _ <- IO.println(if (Json.getFloat(j, "x", 0.0) > 1.0) "getFloat:pos" else "getFloat:z")
    _ <- printTags(j)
    _ <- printArr(j)
    got = Json.get(j, "xs")
    _ <- IO.println(s"getXs:${Str.fromInt(List.len(got))}")
    inner = List.head(got) match {
  case Option.Some(j) => j
  case Option.None => Json.Null()
}
    _ <- printArr(inner)
    _ <- printAt(inner, 1)
    _ <- printAt(inner, 9)
    pairs = Json.pairs(j)
    _ <- IO.println(s"pairs:${Str.fromInt(List.len(pairs))}")
    _ <- printSet(j)
    _ <- printFloat()
  } yield ()

private def objKit(): IO[Unit] =
  Json.parse("{\"n\":1,\"ok\":true,\"s\":\"hi\",\"x\":1.5,\"xs\":[2,3]}") match {
    case Result.Err(_) => IO.println("query:err")
    case Result.Ok(j) => objKitOk(j)
  }

private def mergeKit(): IO[Unit] =
  Json.parse("{\"n\":1}") match {
    case Result.Err(_) => IO.println("merge:err")
    case Result.Ok(a) => Json.parse("{\"n\":9,\"k\":2}") match {
  case Result.Err(_) => IO.println("merge:err")
  case Result.Ok(b) => printMerge(a, b)
}
  }

private def missKit(): IO[Unit] =
  for {
    _ <- printKeys(Json.Null())
    _ <- printArr(Json.Null())
    _ <- printAt(Json.Null(), 0)
    _ <- printHas(Json.Null(), "a")
    _ <- IO.println(Str.concat("asInt:", Str.fromInt(List.len(Json.asInt(Json.Null())))))
    _ <- IO.println(Str.concat("asFloat:", Str.fromInt(List.len(Json.asFloat(Json.Float(1.5))))))
    _ <- IO.println(Str.concat("asFloatMiss:", Str.fromInt(List.len(Json.asFloat(Json.Null())))))
  } yield ()

private def parseErr(): IO[Unit] =
  Json.parse("{") match {
    case Result.Err(_) => IO.println("parse:err")
    case Result.Ok(_) => IO.println("parse:ok")
  }

def run(): IO[Unit] =
  for {
    _ <- objKit()
    _ <- mergeKit()
    _ <- missKit()
    _ <- parseErr()
    _ <- printArrWrite()
    _ <- coerceKit()
  } yield ()

