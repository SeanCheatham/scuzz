def composePayloads(n: Int): IO[Unit] =
  Flow.composition(n % 10000).flatMap(_ => Flow.recoverInt(n % 10000)).flatMap(_ => Flow.recoverRecord(n % 10000)).flatMap(_ => Flow.recoverEnum(n % 10000)).flatMap(_ => Flow.copyPayload(n % 10000, n > 0, 1.5, Str.fromInt(n))).flatMap(_ => Impurity.runKit()).flatMap(_ => Server.runHttp())
