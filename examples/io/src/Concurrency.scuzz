def run(): IO[Unit] =
  for {
    r <- Ref.of("x")
    _ <- Ref.set(r, "ref-ok")
    v <- Ref.get(r)
    _ <- IO.println(s"ref:$v")
    q <- Queue.unbounded()
    _ <- IO.both(Queue.take(q), Queue.offer(q, "parked"))
    _ = Law.sometimes("queueParked")
    _ <- IO.println("queue-ok")
    d <- Deferred.empty()
    _ <- IO.both(Deferred.get(d), Deferred.complete(d, "go"))
    _ <- IO.println("deferred-ok")
    _ <- IO.race(IO.sleep(50), IO.println("race-fast"))
    f <- Fiber.fork(IO.pure("fork-ok"))
    got <- Fiber.join(f)
    _ <- IO.println(got)
    g <- Fiber.fork(IO.sleep(50))
    _ <- Fiber.interrupt(g)
    _ <- Fiber.join(g).handleErrorWith(_ =>
  IO.println("interrupted")
)
    n <- IO.repeatN(2, IO.pure("repeat-ok"))
    _ <- IO.println(n)
    t <- IO.retryN(1, IO.pure("retry-ok"))
    _ <- IO.println(t)
    h <- Fiber.fork(IO.forever(IO.sleep(50)))
    _ <- Fiber.interrupt(h)
    _ <- Fiber.join(h).handleErrorWith(_ =>
  IO.println("forever-stopped")
)
    xs <- IO.foreach(["a", "b"], x => IO.pure(Str.concat(x, "!")))
    _ <- IO.println(s"foreach:${List.join(xs, ",")}")
    ns <- IO.foreach([1, 2], n => IO.pure(n + 1))
    _ <- IO.println(s"foreachN:${Str.fromInt(List.head(ns))}")
    _ <- IO.foreachDiscard(["k"], x => IO.println(s"each:$x"))
    _ <- IO.when(true, IO.println("when:y"))
    _ <- IO.unless(true, IO.fail("unless-skip"))
    _ <- IO.unless(false, IO.println("unless:y"))
    c <- Ref.of(0)
    _ <- Ref.update(c, n => n + 1)
    n <- Ref.updateAndGet(c, n => n + 1)
    _ <- IO.println(s"refN:${Str.fromInt(n)}")
    iq <- Queue.unbounded(): IO[Queue[Int]]
    _ <- Queue.offer(iq, 7)
    k <- Queue.take(iq)
    _ <- IO.println(s"queueN:${Str.fromInt(k)}")
    id <- Deferred.empty(): IO[Deferred[Int]]
    _ <- Deferred.complete(id, 8)
    g <- Deferred.get(id)
    _ <- IO.println(s"defN:${Str.fromInt(g)}")
    nf <- Fiber.fork(IO.pure(9))
    nj <- Fiber.join(nf)
    _ <- IO.println(s"forkN:${Str.fromInt(nj)}")
    _ <- IO.println("done")
  } yield ()

