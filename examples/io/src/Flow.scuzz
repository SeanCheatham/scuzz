def run(): IO[Unit] =
  for {
    s = Stream.concat(Stream.evalMap(Stream.emits(["a", "b"]), x => IO.pure(Str.concat(x, "!"))), Stream.eval(IO.pure("c")))
    xs <- Stream.compileToList(s)
    _ <- IO.println(List.join(xs, ","))
    _ <- Stream.drain(Stream.evalMap(Stream.emit("d"), x => IO.println(s"drain:$x")))
    taken <- Stream.compileToList(Stream.take(Stream.emits(["x", "y", "z"]), 2))
    _ <- IO.println(Str.concat("take:", List.join(taken, ",")))
    dropped <- Stream.compileToList(Stream.drop(Stream.emits(["x", "y", "z"]), 1))
    _ <- IO.println(Str.concat("drop:", List.join(dropped, ",")))
    filtered <- Stream.compileToList(Stream.filter(Stream.emits(["a", "", "b"]), x => Str.len(x) > 0))
    _ <- IO.println(Str.concat("filter:", List.join(filtered, ",")))
    mapped <- Stream.compileToList(Stream.map(Stream.emits(["a", "b"]), x => Str.concat(x, "!")))
    _ <- IO.println(Str.concat("map:", List.join(mapped, ",")))
    tw <- Stream.compileToList(Stream.takeWhile(Stream.emits(["a", "b", "", "c"]), x => Str.len(x) > 0))
    _ <- IO.println(Str.concat("takeWhile:", List.join(tw, ",")))
    dw <- Stream.compileToList(Stream.dropWhile(Stream.emits(["", "", "a", "b"]), x => Str.len(x) == 0))
    _ <- IO.println(Str.concat("dropWhile:", List.join(dw, ",")))
    found <- Stream.compileToList(Stream.find(Stream.emits(["", "a", "b"]), x => Str.len(x) > 0))
    _ <- IO.println(Str.concat("find:", List.join(found, ",")))
    hit <- Stream.exists(Stream.emits(["", "a", "b"]), x => Str.len(x) > 0)
    _ <- IO.println(Str.concat("exists:", if (hit) "1" else "0"))
    miss <- Stream.exists(Stream.emits(["", ""]), x => Str.len(x) > 0)
    _ <- IO.println(Str.concat("miss:", if (miss) "1" else "0"))
    ns <- Stream.compileToList(Stream.map(Stream.emits([1, 2]), n => n + 1))
    _ <- IO.println(s"mapN:${Str.fromInt(List.head(ns))}")
    fs <- Stream.compileToList(Stream.filter(Stream.emit(4), n => n > 0))
    _ <- IO.println(s"filterN:${Str.fromInt(List.head(fs))}")
    es <- Stream.compileToList(Stream.evalMap(Stream.eval(IO.pure(5)), n => IO.pure(n + 1)))
    _ <- IO.println(s"evalN:${Str.fromInt(List.head(es))}")
    cs <- Stream.compileToList(Stream.concat(Stream.take(Stream.emit(6), 1), Stream.drop(Stream.emit(7), 0)))
    _ <- IO.println(s"concatN:${Str.fromInt(List.head(cs))}")
  } yield ()

