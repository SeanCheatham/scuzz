def showResp(tag: String, p: (Unit, (Int, Map[String, String], String))): IO[Unit] =
  p match {
    case (_, resp) => printResp(tag, resp)
  }

def printResp(tag: String, resp: (Int, Map[String, String], String)): IO[Unit] =
  resp match {
    case (status, headers, body) => IO.println(s"$tag:${Str.fromInt(status)}:${Map.getOrElse(headers, "X-Trace", "-")}:$body")
  }

def reply(path: String): (Int, Map[String, String], String) =
  if (path == "/ping") (200, Map.set(Map.empty(), "X-Trace", "ok"), s"ok:$path") else (404, Map.set(Map.empty(), "X-Trace", "miss"), "missing")

def handle(req: (String, String, Map[String, String], String)): IO[(Int, Map[String, String], String)] =
  req match {
    case (path, method, _, body) => IO.println(s"served:$method:$path:$body").map(_ => reply(path))
  }

def runHttpOk(): IO[Unit] =
  for {
    p <- IO.both(Net.serveOnce(8080, handle), Net.httpPost("http://127.0.0.1:8080/ping", Map.empty(), "hi"))
    _ <- showResp("ping", p)
  } yield ()

def runHttpMiss(): IO[Unit] =
  for {
    p <- IO.both(Net.serveOnce(8081, handle), Net.httpGet("http://127.0.0.1:8081/nope", Map.empty()))
    _ <- showResp("miss", p)
  } yield ()

def echoServer(ln: Tcp): IO[Unit] =
  for {
    c <- Net.tcpAccept(ln)
    s <- Net.tcpRead(c, 16)
    _ <- Net.tcpWrite(c, s)
    _ <- Net.tcpClose(c)
  } yield ()

def echoClient(): IO[Unit] =
  for {
    c <- Net.tcpConnect("127.0.0.1", 9090)
    _ <- Net.tcpWrite(c, "hi")
    s <- Net.tcpRead(c, 16)
    _ <- Net.tcpClose(c)
    _ <- IO.println(s"tcp:$s")
  } yield ()

def runTcp(): IO[Unit] =
  for {
    ln <- Net.tcpListen(9090)
    sock = Resource.make(IO.pure(ln), s => Net.tcpClose(s))
    _ <- Resource.use(sock, s => IO.both(echoServer(s), echoClient()))
  } yield ()

def showUdp(got: (String, Int, String)): IO[Unit] =
  got match {
    case (_, _, data) => IO.println(s"udp:$data")
  }

def runUdp(): IO[Unit] =
  for {
    a <- Net.udpBind(19091)
    b <- Net.udpBind(19092)
    _ <- Net.udpSend(a, "127.0.0.1", 19092, "pong")
    got <- Net.udpRecv(b, 16)
    _ <- showUdp(got)
    _ <- Net.udpClose(a)
    _ <- Net.udpClose(b)
  } yield ()

def runHttps(): IO[Unit] =
  for {
    p <- IO.both(Net.serveOnceTls(8082, handle), Net.httpGet("https://127.0.0.1:8082/ping", Map.empty()))
    _ <- showResp("tls", p)
  } yield ()

def runHttpsFiles(): IO[Unit] =
  for {
    p <- IO.both(Net.serveOnceTlsFiles(8084, "examples/io/tls/cert.pem", "examples/io/tls/key.pem", handle), Net.httpGet("https://127.0.0.1:8084/ping", Map.empty()))
    _ <- showResp("files", p)
  } yield ()

def runHttpMethods(): IO[Unit] =
  for {
    put <- IO.both(Net.serveOnce(8083, handle), Net.httpPut("http://127.0.0.1:8083/ping", Map.set(Map.empty(), "Content-Type", "text/plain"), "put"))
    _ <- showResp("put", put)
    patch <- IO.both(Net.serveOnce(8083, handle), Net.httpPatch("http://127.0.0.1:8083/ping", Map.empty(), "patch"))
    _ <- showResp("patch", patch)
    deleted <- IO.both(Net.serveOnce(8083, handle), Net.httpDelete("http://127.0.0.1:8083/ping", Map.empty()))
    _ <- showResp("delete", deleted)
    head <- IO.both(Net.serveOnce(8083, handle), Net.httpHead("http://127.0.0.1:8083/ping", Map.empty()))
    _ <- showResp("head", head)
  } yield ()

def runHttp(): IO[Unit] =
  for {
    _ <- runHttpOk()
    _ <- runHttpMiss()
    _ <- runHttpMethods()
  } yield ()

def run(): IO[Unit] =
  for {
    _ <- runHttp()
    _ <- runTcp()
    _ <- runUdp()
    _ <- runHttps()
    _ <- runHttpsFiles()
  } yield ()

