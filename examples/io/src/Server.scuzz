def handle(path: String): IO[String] =
  for {
    _ <- IO.println(s"served:$path")
  } yield s"ok:$path"

def showPing(p: (Unit, String)): IO[Unit] =
  p match {
    case (_, body) => IO.println(s"ping:$body")
  }

def run(): IO[Unit] =
  IO.both(Net.serveOnce(8080, path => handle(path)), Net.httpGet("http://127.0.0.1:8080/ping")).flatMap(p => showPing(p))
