import Manual.Topic
import Manual.Block
import Manual.NavLink

def all(): List[Topic] =
  start() :: install() :: language() :: gui() :: signals() :: packages() :: verify() :: commands() :: manifest() :: ios() :: android() :: web() :: ide() :: tryIt() :: how() :: []

def p(text: String): Block =
  Block.Para(text)

def code(text: String): Block =
  Block.Code(text)

def cmd(text: String): Block =
  Block.Cmd(text)

def link(label: String, route: String): Block =
  Block.Link(NavLink(label, route))

def start(): Topic =
  Topic("start", "Start", p("Build native CLI, server, desktop, and mobile apps with Scuzz. The language is a small Scala-inspired subset. Effects go through IO. UI is a View plus Signal session.") :: p("Install the CLI, then create a package. Use --ui for a Counter GUI. Omit --ui for an IO hello. Headless is a real runtime. It does not need a display.") :: cmd("scuzz new myapp --ui") :: cmd("scuzz check") :: cmd("scuzz fuzz --iterations 0") :: cmd("scuzz run --target headless --exec \"\"") :: p("Product locks live in docs/philosophy.md. Host setup lives in docs/developer-environment.md. Kit signatures: scuzz docs kits.") :: p("The checkout holds larger examples. examples/api-report is an authenticated HTTPS client. examples/webhook is an HTTP webhook receiver. Their scenario and verify files hold the claims.") :: link("Open the GUI topic", "gui") :: [])

def install(): Topic =
  Topic("install", "Install", p("Install the Scuzz CLI from the project release. Put ~/.local/bin on PATH. Apps need clang and make. Linux also needs zlib, bzip2, and OpenSSL development packages.") :: code("curl -fsSL https://github.com/SeanCheatham/scuzz/releases/latest/download/install.sh | sh") :: p("From a checkout, run ./scripts/install.sh. That command compiles examples/cli with the newest GitHub v* bootstrap. Override the tag with SCUZZ_BOOTSTRAP_TAG.") :: p("Default [ui] link uses the pinned Skia CPU prebuilt. Opt out with SCUZZ_SKIA=sk_sw. SCUZZ_SKIA=gpu rasterizes on OpenGL. It does not paint on the CPU.") :: cmd("scuzz new mycli") :: cmd("scuzz fuzz --iterations 0") :: cmd("scuzz run") :: p("install.sh --help lists flags. Pin a release with SCUZZ_VERSION=v0.2.1 on the curl | sh line.") :: [])

def language(): Topic =
  Topic("language", "Language", p("Use def for functions. Write oracle name for a drive oracle. An oracle returns Bool. Values are immutable. A function states its parameter types and result type. for is the primary binder. An equals sign binds a pure value. The left side can be a constructor or tuple pattern. Each binding pattern must cover every possible value of its type. Use match for a partial pattern and an explicit failure branch. The left arrow requires IO. The checker rejects pure values at this boundary. IO aliases and typed errors stay valid. Use () <- effect for a Unit payload. The effect still runs and propagates failure. There is no val. There is no var.") :: code("""def double(n: Int): Int =
  n * 2

""") :: p("Use a record to group values. Use copy to make a changed value.") :: code("""record Point(x: Int, y: Int)

""") :: code("""def move(p: Point): Point =
  p.copy(x = p.x + 1)

""") :: p("Write record Amount private(value: Int) to restrict construction. Only its declaring module can construct or copy the record. Other modules can read fields and match values. Validate external input in a live function that returns Result. Keep domain rules active in that function. Private access does not prove the predicate. Verification drivers accept raw input and call the live constructor. Generated input cannot construct a private record. The checker checks copy field names and types. It rejects duplicate fields and excess arguments.") :: p("Use a for expression to bind values and sequence effects.") :: code("@main def main: IO[Unit] =\n  for {\n    name = \"Scuzz\"\n    _ <- IO.println(name)\n  } yield ()\n") :: p("Integer division rounds toward zero. The remainder is zero or has the dividend sign. Division or remainder by zero fails with a Scuzz source error. Minimum Int divided by -1 returns minimum Int. Its remainder is zero. Check an expected invalid divisor in live code and return Result. Parse external integers with Str.parseInt(text). It returns Result[String, Int]. Match Result.Ok and Result.Err. Input has an optional + or - sign and one or more ASCII decimal digits. Leading zeroes are valid. Spaces, trailing bytes, embedded zero bytes, and other number forms return Str.parseInt: invalid integer. A valid decimal outside the signed 64-bit range returns Str.parseInt: out of range. Str.toInt(text, fallback) is for an explicit fallback policy.") :: p("Json.parse returns Result[String, Json]. Json.field(json, key) returns Result[String, Json] for a required field. A value that is not an object returns Json.field: expected object. A missing key returns Json.field: missing field. A present null returns Result.Ok(Json.Null). Match the Json case to check the field type. Do not use a fallback for a required value.") :: code("def quantity(text: String): Result[String, Int] =\n  Str.parseInt(text) match {\n    case Result.Ok(n) => if (n >= 1 && n <= 100) Result.Ok(n) else Result.Err(\"quantity must be 1 through 100\")\n    case Result.Err(error) => Result.Err(error)\n  }\n\n") :: p("Use Result values for expected input errors. The checker requires every match case. A for binding of Result must retain and use the result. This also applies to the Result payload from IO.attempt. A wildcard discard, an unused result, or a success-only binding is a compiler error. Match both outcomes to select a failure policy. Return the result or pass it to a function when that function owns the policy. The check also applies to each Result field in a tuple, list-cons, or constructor binding pattern. An omitted Result field in a constructor pattern is a discard. Use distinct names in each for binding pattern. Pattern alternatives must bind the same names with the same types. Retain and use each result on its own. A bound list of Results must also be retained and used. This includes nested Result lists and Result-list IO payloads. Return the list or pass it to the function that handles each result. Other whole container bindings remain outside this check. Check application ranges before you build a domain record. Keep these checks in ordinary app code. They run in compiled apps and evaluation. Property.assume limits verification inputs. It has no effect in a live run. Assertions with .require also erase from live builds. Neither operation validates live input.") :: p("Types include Unit, Int, Float, String, Bool, List[T], Option[T], Map[K, V], Set[T], tuples, IO[T], IO[E, A], and A => B. true and false are Bool. IO[A] means IO[String, A]. A match on a closed type must cover every possible value. Enums, records, Bool, Unit, Json, tuples, and lists are closed types. The checker checks nested payload patterns and alternatives. A guarded arm does not establish coverage. Use an unguarded arm for the remaining values. The checker rejects unknown fields, repeated fields, and excess fields in constructor patterns. Blessed impurity is IO, Fiber, Ref, Queue, Deferred, Resource, Stream, Fs, Json, Sys, Clock, Random, and Net.") :: p("A file stem names a module. Enum, record, alias, and trait types belong to their declaring module. A.Box and B.Box are separate types. Use A.Box for a qualified type or record constructor. Use A.Choice.Wrap for a qualified enum case. A short type name uses the local declaration first, then an import, then a unique declaration. The checker rejects an ambiguous name and a value from another declared type. import Module.name brings a public name into scope. import Module.name as Local changes its local name. A local value binding takes precedence in a value expression. Bare Some and None use Option. Bare Ok and Err use Result. Names that start with __Scuzz are reserved. Indent trait and impl methods. Start a top-level def in column 1. private def stays in-module. check reports unused imports, locals, parameters, and private defs.") :: p("Use each bound Result in live code. Match it, return it, or pass it to a function. A use only in a .require label or predicate does not count. Live builds erase those arguments. The .require receiver remains in live code. The same rule applies to Result lists and selected Result fields. A function call does not prove that the receiver handles the error.") :: [])

def gui(): Topic =
  Topic("gui", "GUI", p("Use View.progress(signal, name) or View.circularProgress(signal, name) for named completion indicators. Values use percentages from 0 to 100. Paint and accessibility clamp values to this range. Indicators do not receive keyboard or pointer input. The default native renderer shapes proportional text. It supports font kerning, ligatures, combining marks, Arabic joining, and direction runs. Adjacent spans with the same font and size keep one shaping run. Color, underline, and inline actions keep this context. Native proportional text and browser text keep paragraph context across wrapped lines. Proportional font and size changes keep the visual order of each line. Native and browser Arabic text keeps joining forms across font and size changes. Joining stays within one direction run of the visible line. Wrapping and ellipsis keep shaped source clusters together. Field input uses shaped positions. Left and Right move the caret in the visual direction. Composition keeps the committed Signal until commit. Source strings keep their original UTF-8 bytes. Editor cells keep their monospace layout. Pinned Noto fonts supply fallback for Arabic, Devanagari, Thai, and Simplified Chinese. Web packages include the same fonts. Other contextual scripts, mark placement across font changes, and full bidi caret affinity remain open. Native software and OpenGL renderers use code-point cells.") :: p("Use View.animatedOpacity(value, pumps, child) for an opacity transition. value is a Signal[Int]. Display clamps it to 0 through 100. Construction preserves the Signal. Initial display uses the current value. pumps is positive and fits a signed 32-bit integer. Each painted pump advances one linear step. Structural timeline text records opacity:label=value, target:opacity:label=value, and pumps:opacity:label=remaining. Use Timeline.a11yHas to check these values. Frame labels use a descendant name. They stop at a complete UTF-8 character within 64 bytes. A new target starts from the displayed value. Hidden content snaps to its target. Pause preserves the displayed value. Resume continues without time catch-up. Opacity keeps layout, focus, input, and accessibility. Use visibility to remove input. Both View.opacity and View.animatedOpacity composite overlapping content as one layer. Use View.reducedMotion(reduced, child) to reduce motion in a subtree. A nonzero Signal snaps transitions and removes built-in motion steps. An ancestor or session preference stays effective. Set SCUZZ_UI_REDUCED_MOTION=1 for a native or Headless session. The browser follows prefers-reduced-motion. Native operating-system preference detection remains open.") :: p("Use View.tooltip(message, child) for short help. Hover or keyboard focus opens it. Focus stays on the control. The tooltip adds no Tab stop. The pointer can move onto the popup. Escape clears field composition first, then dismisses tooltips, then closes a dialog. Dismissal stays effective until hover and focus leave the trigger. The popup wraps inside the viewport and uses the nearest Theme. Empty messages have no popup. Browser controls reference their nearest tooltip with aria-describedby. Keep essential instructions visible in the application.") :: p("Use Text.action(key, text) to mark an underlined action in styled text. The key is an Int. Use View.actionText(text, onAction) to handle it. The handler receives the key. It can update Signals or return IO. Handlers support lambdas, named functions, and captured function values. Each action has one Tab stop across its wrapped text. Enter and Space activate it. Pointer input uses the visible source fragments. Gaps and ellipsis dots do not activate it. Empty and completely elided actions have no input target. Styles preserve keys. An outer action replaces actions inside its text. Repeated keys keep separate targets. View.richText displays the same text without actions.") :: p("Use View.expansionTile(open, label, child) for collapsible content. A nonzero open Signal shows the body. Only the header toggles it. Enter and Space activate the focused header. The body keeps its own visibility conditions. Passive text and empty body space do not toggle the header. Nested controls keep their input. Closing preserves committed field state. If the body has focus when it closes, focus returns to the header. Focus outside the body stays in place.") :: p("Use View.select(selected, label, options) for compact single selection. options is a Signal[List[String]]. A changed list closes the popup and cancels pending input. It resets type-ahead and scroll. The control keeps focus and the selected Signal. Set the index in application code when its meaning changes. Old pointer input cannot select a replacement option. Give the control and each option a nonempty label. The selected Signal holds a zero-based index. An invalid index shows no selected text. An empty list has no input. The control has one Tab stop. Arrows open the popup and move a pending option. Home and End use the endpoints. PageUp and PageDown move ten options. Enter, Space, Tab, and explicit focus transfer commit. Escape and outside pointer input cancel. Outside pointer input only closes the popup. Type a prefix to find an option. Repeated characters cycle through matches. ASCII matching ignores case. Other UTF-8 bytes match exactly. The prefix expires after one second. Wheel and touch input scroll the popup. A dialog keeps its own popup input. Escape closes the popup before the dialog. Editable selection and changing option lists remain open.") :: p("Use View.segmented(selected, label, choices) for equal-width choices. choices is List[String]. The selected Signal holds an index that starts at zero. The label names the radio group. Tab enters the selected choice or the first choice. The next Tab leaves the group. Arrows select a choice and wrap at the ends. Home and End select the first and last choices. Enter and Space select the focused choice. Construction preserves the Signal. An index outside the list selects no choice. An empty list has no input target.") :: p("Use View.split(fraction, label, start, end) for two resizable panes. The fraction is the primary pane percent from 0 through 100. The label names the primary pane and separator. Left and Right change the size by one percent. Home and End select the endpoints. Enter collapses the primary pane or restores its previous size. Tab visits primary controls, separator, and secondary controls. A collapsed pane retains state and has no input. Pointer drag starts on the handle.") :: p("Use View.slider(value, label, minimum, maximum, step) for a named integer slider. value is a Signal[Int]. Use signed Int bounds. Minimum must not exceed maximum. Step must be positive. Allowed values start at minimum and advance by step without exceeding maximum. The last allowed step supplies the upper endpoint. Equal bounds give one value. Display clamps and snaps the Signal value. Construction does not write the Signal. Input writes an allowed value. Half-step ties select the higher value. Arrows move one step. Home and End select the endpoints. PageUp and PageDown move ten steps. Browser keys and pointer input use the same runtime. Browser accessible values keep the full Int range.") :: p("Use View.overlay(open, label, child) for a named modal dialog. open is a Signal[Int]. A nonzero value opens the dialog. Give label a short name. Use View.card for its surface. Card text and empty card space keep the dialog open. Backdrop taps outside the card close it. Wheel, touch scroll, hover, and secondary input stay inside the top dialog. A dialog scope change cancels the current pointer gesture. Focus moves to the first control. A dialog with no control takes focus itself. Tab stays inside the top dialog. Escape closes that dialog. Closing returns focus to its opener. A removed opener uses the first visible control. Keep a visible Close button in the dialog. Browser background content stays outside the accessibility tree while the dialog is open.") :: p("Use View.theme(Theme.dark(), child) for dark colors. Use Theme.light() for the default palette. Reuse a Theme value in several Views. Theme.colors takes background, surface, foreground, primary, on-primary, border, muted, accent, and selection colors in that order. Use Color.rgb or Color.rgba for each color. The wrapper paints its background inside its frame. Nested themes keep their own control, text, focus, and selection colors. The color constructors use default font size, spacing, and control height. Use Theme.metrics(theme, fontSize, lineGap, padding, gap, controlHeight) to change these values. It returns a new Theme and preserves the source Theme. Use logical pixels. Font size must be positive. Spacing values must be nonnegative. Control height must fit the font size plus the line gap. Invalid metrics stop the program. Nested themes use their own metrics. Device scale stays separate. Carets, editor input, scrolling, and measured lists use the same metrics. Theme values do not follow operating-system appearance changes.") :: p("Build styled text with Text.span(string) and Text.concat(list). Text.color(color, text) and Text.size(size, text) change span attributes. Use Text.bold, Text.italic, Text.underline, and Text.monospace for other styles. These functions return new values and preserve their sources. Text.plain reads the complete source string. View.richText displays one paragraph. Words wrap across spans. Mixed sizes use one baseline per line. Default sizes and colors follow the nearest wrappers. Explicit sizes use logical pixels. Text.size needs a positive 32-bit size. Use View.maxLines and View.ellipsis to limit display. The ellipsis uses the final visible span style. Browser copying preserves source spaces and line breaks. It does not add synthetic ellipsis marks.") :: p("Use Tab and Shift+Tab to move focus through visible controls. Enter and Space activate the focused control. Slider arrows change its value. Home and End select the bounds. Use View.radioGroup(label, child) to name a radio group. Its radios share one Signal. Tab enters the selected radio, or the first visible radio when none is selected. Arrows select radios inside that group. A tab list has one Tab stop. Left and Right move tab focus. Enter or Space selects the panel. Tab moves into the panel. Tab stays inside an open overlay. Escape closes it. Plain Tab inserts two spaces in an editor. Use Ctrl+Tab to leave the editor.") :: p("A View describes the interface. Signals hold state. Build a pure View tree. Run a session with Ui.run. Create Signals outside the factory so they stay across rebuilds.") :: code("@main def main: IO[Unit] =\n  for {\n    count = Signal.make(0)\n    label = Signal.map(count, n => s\"count = $n\")\n    _ <- Ui.run(_ => View.column([View.bindText(label), View.button(\"+1\", _ => Signal.set(count, Signal.get(count) + 1))]))\n  } yield ()\n") :: p("Container constructors take a List[View]. Use View.column([a, b]), View.row([a, b]), View.stack([a, b]), View.wrap([a, b]), and View.breadcrumb([a, b]). Use View.grid(columns, children) for fixed columns. Use List.map to construct children from data. The native and evaluator paths use the same flat child list. Use View.autoGrid(minWidth, children) for equal column slots that fit the parent width. The minimum width is in logical pixels. Padding and gaps use the current theme. Resize selects the columns again. Children excluded by View.showWhen use no slot. View.visibility keeps the slot when it hides a child. A width below the minimum uses one column. A very narrow parent reduces padding to keep positive cell width. An unbounded width uses one column with intrinsic child sizes. Empty columns use no space. Values below one select a one-pixel minimum. Use View.gap to set the space between cells. Use View.adaptive(minWidth, compact, wide) to select a layout from the parent width. Use compact below the limit. Use wide at the limit and with unbounded width. The limit uses logical pixels. Only the selected branch has layout, paint, input, and accessibility. Resize clears focus in the hidden branch. Construct separate Views for both branches. Keep shared Signals outside them. Use View.expanded(weight, child) in a row or column to divide the remaining space. Subtract fixed children, padding, and gaps first. Weights of 1 and 2 use one third and two thirds of that space. Values below one use a weight of one. Hidden children excluded by View.showWhen use no weight. View.visibility keeps the weight and slot. View.stretch preserves the weight. An unbounded main axis uses intrinsic layout. Fixed content that exceeds the available space uses intrinsic layout. Use View.measuredList(estimate, items, key, render) for rows with different heights. Give it a bounded height. The runtime measures mounted rows at the available width. It uses the estimate for rows with no measurement. Heights use logical pixels. Each row uses at least one logical pixel. The scroll extent changes as rows acquire measurements. Resize preserves the visible item by key. A data or width change follows the focused row. Run scuzz run examples/measured. Use View.virtualList(rowHeight, items, key, render) for large lists with fixed row heights. Give it a bounded height. Row height uses logical pixels. Use Signal[List[A]] for items and A => Int for unique keys. The renderer receives Signal[A] with the current item. Use Signal.map and View.bindText for item changes. A row keeps its View, focus, and Signals while its key stays in the row window. The window contains visible rows and one extra row on each side. A data change follows the focused row. Rows outside the window release their Views and Signals. Keep persistent application state outside the renderer. Do not keep a row input Signal after its row leaves the viewport. Duplicate keys fail before the row window changes. Run the large-list example with scuzz run examples/list. Use View.appShell with View.appBar for a title and actions above the body. Use View.indexBook for named app sections. Use View.tabs for local panels and for a walkthrough progress strip. Headless uses the same layout and input model. A button press paints for four pumps. A button that becomes shown paints an appear for four pumps. A tab change paints for four pumps. The new panel uses that appear. A list insert paints for four pumps. The next pump is settled. A static tree paints one frame and waits. The clock is pump. Headless and Desktop paint the same frames. The timeline records the hit on the pump that took the input. The session dump keeps that hit.") :: p("Use View.link and View.navTile to open an Index Book section. Use View.breadcrumb for a trail. Use Icon.* glyphs with View.icon. Use Image.decode(bytes) to decode static PNG or JPEG data. It returns Result[String, Image]. Handle an error before you construct an image View. Use Bytes.fromStr with bytes from Fs.read or a network response. Keep these reads in IO. Image.width and Image.height return pixel dimensions. Decode accepts at most 32 MiB and 4096 pixels on each axis. View.image(image, label) retains the decoded image. The label supplies accessibility text. Use View.text for a visible caption. View.sized sets the display size in logical pixels. The image keeps its aspect ratio and stays at the center of a tight slot. View.clip, View.radius, and View.opacity also apply to images. Images use linear sampling and source-over alpha. Color profiles and JPEG orientation metadata do not change the decoded pixels. It does not add Back and Next sibling chapter links.") :: p("Desktop and Mobile record live input and painted pumps to build/record.json and write build/debug.json. Replay headless with --exec and --dump. Every run watches build/inject.json and rewrites build/debug.json. Drive a live session with scuzz exec. [ui] run --watch is hot reload. It stamp-reloads the View tree. Signals stay. Host and iOS simulator hot reload need one direct Ui.run factory. Reload checks captured bindings and type layouts. It preserves the app after an incompatible change. Enter r to rebuild and restart with new bindings. Enter q to stop. Ctrl+C stops the session and app. The app also stops when its CLI session ends.") :: p("On Linux, a Desktop window needs DISPLAY. Without DISPLAY, Desktop stays offscreen. On macOS, Desktop needs a GUI session. Retina sessions paint at native scale. Close the window to quit a live Desktop run.") :: cmd("scuzz run --target headless --exec \"\"") :: cmd("scuzz run examples/studio") :: cmd("scuzz run --target headless --exec \"\" examples/layout") :: link("Open the iOS topic", "ios") :: link("Open the Android topic", "android") :: link("Open the Web topic", "web") :: [])

def signals(): Topic =
  Topic("signals", "Signals", p("Signal.make(value) creates a typed cell. Signal.get and Signal.set preserve the payload type. Signal.map maps A => B and caches derived values. Signal.makeN and Signal.mapN set an explicit observation name.") :: code("def labelOf(count: Signal[Int]): Signal[String] =\n  Signal.map(count, n => s\"count = $n\")\n\n") :: p("A Signal publishes its for binder name. count = Signal.make(0) is the name count. Claims read that name. A missing name panics. Absence is not 0 or empty.") :: p("View.bindText needs Signal[String]. View.each binds a list element type from Signal[List[T]]. Widget signatures require the correct Signal payload.") :: [])

def packages(): Topic =
  Topic("packages", "Packages", p("A scuzz.toml package is the link boundary. Foo.scuzz is a module. Reuse local packages with path dependencies. Dependency sources merge into one program with the root.") :: code("[package]\nname = \"hello\"\nversion = \"0.1.0\"\n") :: p("Named path dependencies only. No git, hosted, version, or registry forms. Cycles, missing packages, duplicate names, and unknown keys fail load.") :: cmd("scuzz check") :: cmd("scuzz build") :: p("On macOS, scuzz package --target macos writes a UI .app bundle under build/package/host. The bundle includes its non-system libraries and an ad hoc signature. Open it from Finder. Finder launch uses Desktop and the manifest UI size. Explicit runtime environment values take priority. IO packages keep the host executable layout. Net HTTP clients in macOS GUI apps use URLSession and platform certificate trust. Input continues during IO button handlers. IO.timeout cancels a native request. Use HTTPS for remote services. Local networking is allowed by App Transport Security. Developer ID signing and notarization remain open.") :: p("See the manifest topic for the full scuzz.toml schema.") :: [])

def verify(): Topic =
  Topic("verify", "Verify", p("Scuzz does not use classical unit tests as the author path. Encode claims in *.scuzz_verify and live .require. A *.scuzz_scenario file holds one world: setup, replacements, and oracle-free drivers. scuzz fuzz is the testing command. It probes the live graph, then searches, then mutates. Search and mutation probes run on the evaluator. A package without [ui] uses scuzz eval --probe. A [ui] package uses one headless host. Mutants do not emit or link. A search failure found on the evaluator replays on the compiled binary before the campaign ends; a difference fails the campaign. The idle probe runs on both engines first; when the evaluator timeline differs, times out, or crashes, the campaign prints why and runs every probe compiled. Corpus replay, --replay, and --relate run compiled. scuzz fuzz --live replays the corpus with --iterations 0, or one --replay file, on the host loopback transport. Clock and files stay simulated. A live file write can return an error after replacement. Read the resulting file state before recovery. A non-loopback host fails. Search and mutation stay on the simulated network. scuzz fuzz --asan replays the corpus with --iterations 0, or one --replay file, on the compiled engine under AddressSanitizer. Leak and use-after-free reports fail the probe. A [ui] package is rejected. scuzz fuzz --session replays URLSession certificate checks and TLS errors on host loopback. Clock and files stay simulated. A non-loopback host fails. --differential also compares pixel snapshots of one backend across two repeats. SCUZZ_FUZZ_ENGINE=compiled runs every phase compiled. On the evaluator, every Int comparison reports how far its operands are apart, and the search nudges Int driver arguments toward a comparison it has not flipped. Each probe has a 20-second deadline. Linux probes also have a 512 MiB virtual memory limit. AddressSanitizer probes skip that limit. Each simulated IO run has a limit of 1000000 scheduler steps. A limit failure fails the probe. A scenario declares its fault surface with def faults(): List[String]: entries fs, net, or queue with an optional :fail, :drop, or :corrupt mode. A scenario without faults gets no injected faults. A plan faults one call. The call index runs from 1 through 16 for each declared entry. The next pass faults every later call of that kind. The pass after that discards an Fs.write and keeps the previous file. The following pass does both. The next two passes report a write error after replacement, once or on every later call. The complete new bytes remain. Other filesystem calls retain their failure behavior. A fault seed below 145 stays one call. A recorded fault_seed can use fs:fail:N, fs:partial:N, or fs:after:N. N is a positive filesystem call index. These plans can reach calls beyond 16. Setup does not consume the call index. A corpus entry records the fiber picked at each contention step in schedule_picks. Replay follows the recorded picks and reports schedule drift when they no longer match the program. A claim must not pass on faulted alone: pair every faulted guard with the preserved file or the app's own fault response.") :: p("Use resize WIDTH HEIGHT in a UI corpus event. Add SCALE to set the device scale. An omitted scale keeps the current scale.") :: p("Property.assume(name, condition) returns Unit. Call it in live source to restrict a verification input. A false condition ends the probe with an excluded result. It cannot recover through IO.handleErrorWith. Scenario and verify files reject this call. An assumption has no effect in run or eval. It does not validate production input. Keep production validation in the app with explicit success and failure values. A where condition, .require assertion, oracle, or claim failure still fails the probe.") :: p("An excluded search input consumes one search iteration. It does not count as a passing input or a failure. An excluded required idle probe, seed, or corpus entry fails the campaign. --no-fail-fast cannot change this result. A mutant that excludes an input does not count as a kill. The report lists its site in scope.mutant_excluded and gives its count in mutate.excluded. The score denominator includes excluded mutants. They can reduce the score. An evaluator search exclusion must reproduce compiled with the same reason. A different result fails the campaign. A failure shrink must preserve a failure. An excluded shrink is rejected.") :: p("build/fuzz/summary.json contains a scope object. It separates passed, failed, excluded, and incomplete required and search workloads. The report status is passed, failed, or incomplete. Deadlines and step limits stay incomplete. A required incomplete workload blocks the campaign. Terminal property and claim rejection stays failed. Each campaign starts with an incomplete report. After campaign start, a check or build error leaves an incomplete report. The required group also gives planned and unrun counts. Each workload records its script, schedule, fault, recorded schedule picks, engine, result, and exclusion reason. scope.inputs lists the driver argument schemas and where bounds. scope.claims lists declared, executed, and never executed timeline claims. The reached list means that a claim executes. Trigger reach stays separate in triggers. These records describe finite checked inputs. They do not prove all inputs correct.") :: code("""oracle bump(n: Int): Bool =
  Main.bump(n) == n + 1

""") :: p("A detected mutation defect has terminal property or claim rejection evidence. A caught assertion does not supply terminal evidence. Deadlines, crashes, and tool errors without rejection evidence are incomplete. They stay in the score denominator and fail the campaign. A source check error is invalid. A link or file error is incomplete. Incomplete results are not reusable. Probe logs retain the rejection reason. A corpus-only pass covers its recorded workloads. Inspect claim execution and trigger reach separately. A claim can execute while its trigger remains unreached. A positive search budget requires declared triggers to occur. Resource rules can check one release and no later write after cancellation or timeout. Synchronize cancellation with entry into the resource body. Handle expected effect errors through Result. Repeat requests to check their content and status. Use fault workloads for interrupted writes and recovery. Check bounded progress as well as preserved state. An absence rule needs workloads that can produce the forbidden behavior. Check that the rule rejects such a workload. A def with one Timeline parameter is a session claim and returns Verdict. A def with two Timeline parameters is a relation claim. Private functions can share predicates between claims. They do not become drivers or registered claims. Write oracle name for a drive oracle. An oracle returns Bool. A public def that returns Bool is not an oracle. An oracle cannot be private. Drive oracles take at most three generator-friendly params. A zero-argument oracle is a fact. Facts seed the campaign. Search generates arguments only for oracles that take parameters.") :: p("Verdict.alwaysHas(t, needle) requires the needle in a11y at every state that has a view tree. Verdict.afterHit(t, hit, needle) requires the needle after a hit. Verdict.onHit(t, hit, (before, after) => Bool) checks an edge-triggered consecutive-state relation. Verdict.stepEvery(t, (before, after) => Bool) checks every consecutive pair. Timeline.fold(t, model, (model, i) => model) walks every state in order and returns the final model. Timeline.hit(t, i, name) is true only on the state that recorded that hit. A later state keeps lastHitHas and does not record the hit again. Write a reference model as a record in a live module. The step function reads the state with Timeline.signalInt and the other readers, compares it with the model, and records the first state index that leaves the model. The claim turns that record into a Verdict. Do not add a temporal calculus.") :: cmd("scuzz fuzz --iterations 16") :: cmd("scuzz fuzz --iterations 0") :: cmd("scuzz fuzz --differential --iterations 0") :: p("Workload TOML fields accept optional spaces around equals. Multiline event and scheduler-pick arrays retain their values. Array comments do not add events. Reports retain the script, seeds, and picks. Zero iterations replays corpus and seeds, then stops. A search failure fails the campaign and writes build/fuzz/repro.toml. The campaign writes build/fuzz/summary.json. The document is the typed session schema (v=1) with kind \"fuzz\": fuzz, corpus, classify, mutate, coverage, sometimes, triggers, and breadth sections. sometimes and triggers list declared, reached, and never. breadth lists varied State buckets, Timeline readers that claims call, and varied buckets with no reader. Varied but unclaimed prints as info. It does not fail the campaign. The campaign fails when a declared Property.sometimes name or afterHit / onHit trigger never fires. Zero iterations reports never-reached names and does not fail. A missing hit still leaves that per-timeline fold valid. The default mutation score floor is 1.000. A package can set a lower score floor. A score below the selected floor sets fuzz.ok to false. Universal oracles always probe the live graph with no scenario wrap: IO must exit 0; UI must paint a view tree. UI campaigns also probe the verify graph. Live and verify dumps match only when the package has no scenario file. --differential compares live dumps across Skia backends and pixel snapshots of one backend across two repeats. check reports unclaimed defs, signals, and controls as info. They do not fail check.") :: p("A scenario file must define setup with zero generated params. Qualified defs replace live IO targets by name. Drivers take the setup context as the first param when setup returns a named type. Simulation is hermetic. TestRuntime does not open live sockets. Sys.exec and Sys.spawn fail. Sys.getenv is sealed except SCUZZ_SERVE and SCUZZ_KIT.") :: p("scuzz diff [REV] [PATH] compares the behavior of a git revision with the working tree. REV defaults to HEAD. The command checks out REV in a git worktree under build/delta and builds both sides with the same compiler. It replays the union of both corpus directories, the seeds, and an idle probe on both sides under TestRuntime. Each workload is same, diverged, fixed, regressed, or unrunnable. Regressed passes on REV and fails on the working tree. Unrunnable needs a control or driver that one side does not have. Diverged rows show the first timeline state that differs and the changed signals, a11y lines, effects, and files. The report also lists added and removed controls, drivers, and oracles, claim verdict changes, sometimes names reached on one side only, and classify count shifts. --iterations N searches the shared alphabet for inputs where the two sides differ. It shrinks each hit and writes build/delta/witness-<hash>.toml. scuzz fuzz --replay reproduces a witness. Each workload that differs writes both timelines to build/delta/tl-<hash>-a.txt and tl-<hash>-b.txt. The report names them in timelines. scuzz diff never writes to corpus/. It writes build/delta/report.json. The command exits 1 only for a regression.") :: cmd("scuzz diff") :: cmd("scuzz diff --iterations 16 HEAD~1") :: p("A replay writes build/fuzz/summary.json with kind replay. It reports one required input. It names the input, execution mode, sanitizer flag, script, seeds, declared scheduler choices, and executed choices. Its status is passed, failed, excluded, or incomplete. Author rule execution has a separate guarded or unguarded status. A successful unguarded replay does not establish rule protection. A replay does not establish that a full campaign passes. Source, build, and input failures replace previous success with an incomplete report.") :: [])

def commands(): Topic =
  Topic("commands", "Commands", p("scuzz --help and scuzz <command> --help list flags and examples. Long prose lives in these topics.") :: p("scuzz check format-verifies src/, *.scuzz_scenario, and *.scuzz_verify. It typechecks live sources. JSON with --message-format=json is the editor protocol. scuzz fmt rewrites live sources, scenarios, and claims. It includes nested scenario and claim files. It skips build, corpus, goldens, and hidden directories. Use scuzz fmt --check to find formatting changes without writing files. scuzz lsp wraps check JSON over stdin/stdout. scuzz eval runs an IO-only package on the evaluator without emit or link.") :: p("scuzz run builds and runs. --target selects the platform: linux, macos, headless, android, or ios. It overrides [ui].default_runtime. linux and macos must match the host. A package without [ui] accepts only the host platform. [ui] run --watch is hot reload. IO-only run --watch kills and reruns. --exec OPS plays a finite ops program after the first pump, then quiesces and exits. Inline JSON starts with { or [; anything else is an inject document path. Without --exec a [ui] run stays live. Every run watches build/inject.json and rewrites build/debug.json. scuzz exec PATH OP [ARGS...] writes ops to a live session. Desktop and Mobile also record live input to build/record.json. scuzz package artifacts strip the channel.") :: p("Timeline.fileTextIs(t, i, path, text) compares file contents at a recorded state. It uses the hermetic filesystem. It returns false for a missing file or a directory. It compares the full contents, including empty text and NUL bytes. Paths use the filesystem path rules. Timeline.fileSame(t, a, b, path) compares the full file contents at two recorded states. It returns false if either state is invalid or the path is a directory at either state or the file is missing at exactly one state. A file missing at both states is the same. The comparison includes empty text and NUL bytes. It does not check intermediate states. Use it with Verdict.stepEvery to check that a failed operation preserves a file. No host file is read by a claim. scuzz fuzz --iterations N probes the live graph, replays corpus and seeds, then searches, then mutates. Search uses five eighths of N, rounded down. Mutation uses the remaining allocation, up to the number of sites. The initial probes and corpus replay do not use this allocation. N is not a time limit. The terminal and build/fuzz/summary.json use the same results. Search counts include only completed search probes. Corpus failures have a separate count and always fail the campaign. --no-fail-fast continues search after a corpus failure. Coverage shows reached functions and branch arms as reached/total. Sometimes and triggers show reached/declared counts. A zero denominator means that the group has no entries. --iterations 0 is corpus-only. --replay restores a repro.toml. --relate judges relation claims. --differential compares live dumps across Skia backends and pixel snapshots of one backend across two repeats. --no-fail-fast finishes search and still mutates.") :: p("scuzz new NAME creates an IO hello. scuzz new NAME --ui creates a Counter GUI, a verify file, and a corpus tap. scuzz devices lists iOS simulators. scuzz run --target ios builds and launches on a simulator. --device selects a name or ID. --watch reloads Views after source changes. Manifest changes restart the app. scuzz package --target linux|macos|android|ios|web|all writes artifacts under build/package/. scuzz ide launches the bundled editor. scuzz diff [REV] [PATH] compares a git revision with the working tree. See the verify topic.") :: p("Use these live input operations:") :: code("""tap xy resize lifecycle keyboard reduceMotion text type key
compose commit caret select copy cut paste drag
hover secondary pump scroll backspace dump snapshot
reload quit resetpeak
""") :: p("Use scuzz exec for a live session. A script, record, or input file ends in .json. It uses schema v=1 with kind \"inject\" and an events array. Each event is one object. The session pumps after each event except quit. Explicit transitions keep their pending steps for the next input. Use pump with k to advance them. Live journals set manualPumps to true. They record painted pumps with pump events. Replay adds no implicit pump in this mode. Consecutive pumps share one count. Use reduceMotion with a Boolean value to change the session preference. The change also enters a live journal. A script input does not enter that journal. An invalid envelope or unknown operation fails.") :: p("The live dump is build/debug.json. A dump uses schema v=2 with kind \"dump\" at any path. It contains signals, views, a11y, taps, fields, editors, splits, overlays, selects, transitions, reducedMotion, scrolls, and hit records. Signal payloads use strings, numbers, arrays, and ADTs with a tag and payload. The a11y tree follows the views order. Toggle controls carry on. Numeric controls carry value. Children use children. Only live dumps include session, heap, and live. Session records contain runtime, size, title, focus, lifecycle, keyboard, and pump count. Heap records include totals, changes since the previous live dump, and counts by kind. Live rows have a limit of 32. Fuzz dumps omit these three sections.") :: p("The taps array contains at most 64 controls in scan order. Use i for an index or id for a role:label key. A missing tap target changes nothing. xy uses logical x and y coordinates. A point that misses a control does not fail. last_hit, hover, and last_secondary appear after the corresponding pointer input.") :: code("{\"v\":1,\"kind\":\"inject\",\"events\":[{\"op\":\"tap\",\"id\":\"button:+1\"},{\"op\":\"scroll\",\"i\":0,\"dy\":40}]}\n") :: p("Text fields use accessibility order. The target field is the focused field, or the first field when none has focus. Editor records include text, caret, selection, scroll position, line count, diagnostics, tokens, inlays, folds, and preedit. Diagnostic lines start at 1. Text and editor caret offsets count bytes. A selection uses start and end, with the caret at end.") :: p("Use text to replace field contents and type to insert at the caret. The value key contains the text. Use i to select a field by its dump index. Without i, editing uses the target field or focused editor. caret takes offset. select takes start and end. backspace takes count, which defaults to 1, and removes UTF-8 code points before the caret. Missing fields and empty insertions change nothing.") :: p("A key event takes key, optional UTF-8 text, mods, and repeat. Modifier names are shift, ctrl, cmd, and alt. Held keys use repeat. Arrow keys, Home, End, and Delete use the caret. Shift with an arrow extends the selection. In an editor, Enter inserts a newline and Tab inserts two spaces. PageUp and PageDown move by the viewport. Ctrl or Cmd with Z undoes. Y or Shift with Z redoes.") :: p("compose takes value and sets the underlined IME preview. The preview stays outside committed text. commit inserts it at the caret and replaces a selection. Escape cancels a preview, or dismisses an overlay when no preview is active. copy copies the selection. cut copies and removes it. paste uses the session clipboard on Headless and the OS clipboard on Desktop or Mobile. A paste event with value sets the session clipboard before insertion. drag takes x1, y1, x2, and y2 to extend a text selection.") :: p("hover takes x and y and can show a tooltip. secondary takes i, or x and y, and sends button 3 input. It runs View.onSecondary without a primary tap. Live input records preserve key, clipboard, selection, hover, and secondary operations. A record replaces the complete document after each event. A watched input file plays the complete document when its contents change.") :: p("The scrolls array contains scroll targets in scan order. scroll takes i, dy, and optional dx. Without i, it selects the first scroll target. Positive movement moves content up or left. With dx and no dy, vertical movement is zero. A missing target changes nothing. pump takes k for additional frames.") :: p("resize takes width, height, and optional scale. An omitted scale keeps the current scale. lifecycle takes phase: pause, resume, or stop. keyboard takes visible: true or false. The top overlay record names the topmost open overlay.") :: p("dump updates the live dump when its path is set. snapshot takes a PNG path and fails when it is missing. reload rebuilds the View when a factory is set. quit stops the session before remaining events run. resetpeak sets peak bytes to current live bytes and marks the heap totals. The next dump reports changes from that point. drive takes name and args to run a verification driver. Driver argument types are Int, String, and Bool.") :: cmd("scuzz check") :: cmd("scuzz fuzz --iterations 0") :: cmd("scuzz docs verify") :: [])

def manifest(): Topic =
  Topic("manifest", "Manifest", p("scuzz.toml is data. It is not a plugin DSL. Unknown keys fail load. Do not add [plugins] or a build.scuzz hook.") :: code("[package]\nname = \"hello\"\nversion = \"0.1.0\"\ndescription = \"Scuzz Lang hello world\"\n") :: p("[package] requires name. version is optional package metadata. description is optional prose. The toolchain ignores description.") :: p("[dependencies] holds named local path dependencies. Each entry is an inline table with exactly path. Paths resolve relative to the declaring scuzz.toml. The complete graph typechecks as one program. An executable root needs exactly one @main.") :: p("[ui] is optional. default_runtime is headless, desktop, or mobile. scuzz run exports SCUZZ_UI_RUNTIME from that key. --target on run and ide overrides it. headless_size is [w, h] logical pixels. headless_scale is a positive float. bundle_id is the Android package and the Apple CFBundleIdentifier. tap_button is an optional 0-based [taps] index.") :: p("[fuzz] is optional. score_floor is a 0.000 to 1.000 mutation score. scuzz fuzz fails when the score drops below that floor. summary.json then records fuzz.ok as false. Omit the table to use the floor 1.000. Baseline and mutant probes use recorded scheduler choices. Each probe keeps its workload in replay.toml. Mutation results persist per site in .scuzz/mutate.results. Reuse needs an equal recorded campaign input. The input includes source, rules, drivers, manifests, workloads, choices, engine, limits, compiler identity, native artifacts, and a host environment hash. The record does not keep environment values. Read build/fuzz/mutation-input.json. The guards field in summary.json lists author properties and claims that execute. An assumption does not count as a guard. An IO assertion counts when its IO runs. Unguarded means that no author rule executes. Guarded means that at least one author rule executes. Check trigger reach and mutation results for rule scope and strength. A changed input clears all stored site results. Changed definitions run first.") :: p("Sources live in src/*.scuzz. At most one *.scuzz_scenario file may sit anywhere in the package. *.scuzz_verify files may sit anywhere in the package. Leftover *.scuzz_sim and *.scuzz_drivers files fail check.") :: [])

def ios(): Topic =
  Topic("ios", "iOS", p("Run a GUI app on an iOS simulator. Use an Apple Silicon Mac with Xcode. Install an iOS simulator runtime in Xcode. The package needs a [ui] section.") :: cmd("scuzz new myapp --ui") :: p("Open the myapp directory.") :: cmd("scuzz check") :: cmd("scuzz fuzz --iterations 0") :: cmd("scuzz devices") :: cmd("scuzz run --target ios --watch") :: p("Scuzz selects a booted simulator when one is available. Otherwise, it selects an iPhone on the newest available iOS runtime. It builds the app, boots the simulator, installs the app, and streams app output. Use --device with an exact name or ID from scuzz devices. If names repeat, use an ID.") :: cmd("scuzz run --target ios --device DEVICE --watch") :: p("Enter r and press Return to rebuild and restart. Enter q and press Return to stop. Ctrl+C stops the app and the CLI session. The simulator stays available. With --watch, source changes reload the View and preserve Signals. Manifest changes rebuild and restart. Local path dependencies are included. A build error preserves the running app. Save a source change or enter r to retry.") :: p("The iOS viewport excludes the status area, home indicator, and docked keyboard. It follows window size and orientation changes. Put long forms in View.scroll so a focused field stays visible above the keyboard. The r command resets Signals and app state. Host and iOS simulator run --watch reload Views and preserve Signals. Reload checks captured binding names, order, types, and record or enum layouts. An incompatible change preserves the app and requires a restart. On iOS, enter r to restart. Failed builds preserve the app. Captured values retain their current values. Native Ui.run yields to IO fibers. IO button handlers run while the screen accepts input. Session exit cancels these handlers. The session writes live debug.json and record.json to the build directory. Write inject.json there for live input. Use Headless for verification and input replay. Simulator runs do not replace the Headless proof.") :: cmd("scuzz run --target headless --exec \"\"") :: p("Native runtime objects are cached under build/ios-sim. App source edits reuse these objects. Use --out-dir to choose the build directory. scuzz package --target ios writes the simulator app under build/package/ios. Net HTTP clients and TCP/UDP link on iOS. HTTP servers need a host target. HTTP clients use URLSession and platform certificate trust. They verify loopback certificates. Use HTTPS for remote services. Local networking is allowed by App Transport Security. IO.timeout cancels the native request. Physical device signing and release distribution remain open.") :: link("Open the GUI topic", "gui") :: [])

def android(): Topic =
  Topic("android", "Android", p("Package a GUI app as an Android APK. Use a host with the Android SDK and NDK. The package needs a [ui] section. The manifest bundle_id sets the Android package name.") :: cmd("scuzz package --target android") :: p("The command writes a debug APK and libscuzz.so under build/package/android. A missing SDK or NDK fails with one install line. A package that calls Net fails. The NDK link does not include OpenSSL.") :: p("Install and start the APK on an emulator or device.") :: code("""adb install -r build/package/android/myapp.apk
adb shell am start -n dev.scuzz.app/.MainActivity
""") :: p("SCUZZ_ANDROID_TYPE inserts then backspaces through the hidden EditText. Pass it as an activity extra: adb shell am start -n dev.scuzz.app/.MainActivity --es SCUZZ_ANDROID_TYPE hi. SCUZZ_ANDROID_TAP=x,y sends a pointer down and up in logical points. SurfaceView taps map to the same session space. The soft keyboard shows on TextField focus. Typed insert and backspace become text edits.") :: p("The Android shell owns JNI_OnLoad and MainActivity. The app main is renamed to scuzz_app_main and runs on a worker thread. It mounts UiRuntime.Mobile and pumps until the session ends. Frames cross as RGBA8888. Touches enqueue into the shell event queue.") :: p("Use Headless for verification and input replay. Emulator runs do not replace the Headless proof.") :: link("Open the GUI topic", "gui") :: [])

def web(): Topic =
  Topic("web", "Web", p("Package a GUI app as static browser files. The package must have a [ui] section. The first web build downloads Emscripten into the host cache. Later builds reuse it.") :: cmd("scuzz package --target web") :: p("The command writes index.html, app.js, and app.wasm to build/package/web. Serve this directory over HTTP. Do not open index.html as a local file. Assets use relative URLs. They work below a repository path.") :: p("The Docs walkthrough is the first browser target. Stage IDs stay stable when titles change. Walkthrough tabs, Index Book chips, View.link, View.navTile, and View.breadcrumb use #stage=id. An http or https route stays a normal browser URL. Browser links support new tabs. Nested local tabs that are not the walkthrough strip do not change the URL. The session waits when the view does not change. Real phone and screen-reader checks remain open. Limits: docs/compatibility.md.") :: link("Scuzz on GitHub", "https://github.com/SeanCheatham/scuzz") :: link("Open the GUI topic", "gui") :: [])

def ide(): Topic =
  Topic("ide", "IDE", p("scuzz ide launches the bundled [ui] editor. The CLI uses SCUZZ_IDE, else SCUZZ_HOME/ide, else examples/editor in a checkout. Desktop is the default. --target headless stays a peer. There is no scuzz-ide binary.") :: cmd("scuzz ide") :: cmd("scuzz ide --target headless .") :: p("The app talks to scuzz check, scuzz lsp, scuzz fmt, scuzz run, scuzz fuzz, and scuzz diff. The CLI, language server, and editor share project checks. Manifest and dependency errors remain visible. Open dependency files supply their current text to the checked graph. Check also validates formatting, verification structure, and types in the prepared verification program. It does not reimplement the compiler. External editors speak scuzz lsp. Info, Go to def, and Rename call the compiler Lsp module in the IDE process. They do not start scuzz lsp.") :: p("Pass a file or a project directory. A directory opens Develop. Develop opens Review. Code and Session open from the objective row. Select Review to return from either view. Review shows the objective and two comparison lanes. Each lane has its choice button below it. More evidence opens the full timelines and diagnostic controls. Session holds source scope, model setup, and work limits. Code shows live source files. Verify shows claims, scenarios, diagnostics, fuzz, mutation, and coverage. Run launches the app or builds a package. Select linux, macos, android, ios, or web. The command writes files under build/package/. Develop, Verify, and Run are top-level tabs. The editor does not use Index Book chapter numbers, Start tiles, or Back/Next sibling chapters. Code lists *.scuzz stems. There is no document tab row. Verify lists claim names. The scenario file may stay listed. A claim tap stays on Verify. Session has one objective, comma-separated allowed source paths, and External proposals or Local model mode. Start exports build/ide/request.json. Pause session cancels owned setup, inference, and preparation. A restart restores the objective, scope, model, and request count in a paused state. Resume preserves a valid frozen request. An objective or model change pauses the session. Verify shows named campaign chips and check diagnostics. Fuzz and mutate starts scuzz fuzz --iterations 32. It updates reachability during the run. It shows coverage and mutation results when the run ends. Check opens Verify. A diagnostic tap opens Code. The app-bar title is the package name. The app bar contains Develop, Verify, and Run. Code holds Save, Save all, Find, Info, and Go to def. Verify holds Check.") :: p("More evidence shows the last scuzz diff report when the IDE opens. Diff runs scuzz diff again. The list shows each workload that differs. A workload tap opens its first diverging state. The step rail marks each state that differs with *. A step tap shows that state on both sides. Lane a is the revision. Lane b is the working tree. Changed sections come first and end with *. A step tap also renders the recorded a11y tree of that state as tiles in the lane. Playback starts paused. Play and Pause chips control the loop through recorded states. A workload or step tap pauses it. The step tap does no IO. The deck reads complete candidates from build/proposals/. Each candidate has proposal.json and at most three src/*.scuzz replacement files. It can add a source file. It cannot change a manifest, dependency, scenario, or verification file. Read the exported request before publication. Metadata version 1 has v, request, baseline, kind, generator, and files. Echo its request and baseline fields. Set kind to behavior. Each files entry has path and sha256. baseline is the SHA-256 of the current source set. Hash compact JSON records sorted by path. Each record has path and content, in that order. Use UTF-8. The importer rejects unknown fields, unsafe paths, duplicate modules, stale baselines, mismatched hashes, and more than 64 KiB of replacement source. Write the files and metadata in a staging directory outside build/proposals/. Rename the complete directory into build/proposals/. Proposals checks the candidate and compares it with disk through the shared evaluator. Review replays idle, all seeds, and every corpus file. It runs 32 differential search iterations with seed 1. It uses the shared shrinker to retain short witnesses. Static failure and any candidate assertion, oracle, or claim failure block the card. A timeout, crash, drift, or incomplete budget also blocks it. A failure on both sides also blocks it. A passing repair of a broken baseline remains eligible. A failed review clears the lanes and disables choices. A local generated suggestion that fails static or workload checks gets an automatic failure record. Scuzz requests another suggestion within the eight-request session limit. The next request includes up to three recent failed or excluded candidates in time order. It includes source and diagnostics. A failure requests a correction. A duplicate requests a different useful addition. Setup, transport, and incomplete baseline failures need an explicit retry. A ready card freezes all source and review inputs. It shows Left and Right in a fixed random order. Source, results, and recorded behavior use the same order. The card opens the shortest available recorded difference at its first useful step. It starts paused. The lane tiles show recorded structure. More evidence opens other workloads, the step rail, changed source, and the finite evidence scope. Question returns to the compact view. Scope shows completed workloads, search work, registered claims, and reached or untriggered claim triggers. The queue keeps the displayed card and at most one ready successor. Local generation waits for review of the previous generated candidate. At most one generation request and one review job run. Ready capacity and preparation status stay visible. Retry preparation restarts failed preparation explicitly. Generation stops at eight attempts. Workload, step, and Randomize navigation reads cached evidence. It starts no probe, build, or subprocess. Restart restores undecided cards only when their full input identity and saved evidence still match. Missing or changed evidence needs a new review. Baseline replay can reuse checked results for the same inputs and exact workload. Candidate checks and the 32-case search still run. States align by index. Added or removed steps can shift this comparison. Console output does not appear in the recorded timeline. Evidence uses the evaluator. Compiled witness parity is a separate check. A complete review with no observed difference removes the proposal from the behavior queue. It stores an automatic No observed difference result. It changes no source and does not count as a choice. This result does not establish equivalence. Choose left and Choose right select the displayed state. The choice reveals which lane holds the proposal. The proposal lane accepts its frozen bytes. The baseline lane changes no source. Can't decide records an abstention and changes no source. Randomize selects another cached card. It does not change its lane order. Baseline choice and abstention can show the prepared successor. Acceptance, Undo, objective change, and model change cancel stale preparation. The queue refills from the current baseline. Pause and exit stop owned generation, inference, and review. Independent inbox directories remain pending. Duplicate source sets and recorded outcomes are automatic exclusions. They do not count as choices. A choice names one ready card. A duplicate or expired action cannot select another candidate. Acceptance checks disk sources, dependencies, manifest, verification, scenario, workloads, compiler and evaluator host identities, and publication again. It refuses dirty touched buffers. A changed input invalidates the card. The IDE stores frozen cards, timelines, witness scripts, decisions, and an operation journal under .scuzz/ide/. These files survive deletion of build/. Before the first source write, the IDE stores the complete operation. Startup finishes recovery or reports a conflict before a new review. Recovery preserves unrelated edits. Undo restores the last accepted replacement and removes files that it adds. Undo refuses when the affected files no longer match the accepted bytes. Undo uses the same journal. Acceptance and Undo update clean open buffers. They preserve dirty buffers. Save, Save all, and Check serialize source writes with acceptance and recovery. Each replacement checks its input again. An independent external writer can still race this check. Recovery detects unexpected bytes and preserves them. Generate mutations creates mutation candidates as a diagnostic control. It uses the same complete publication format. It does not generate toward an objective. A package without a verification file shows unguarded: no claims. Compare buffers diffs the open buffers against the files on disk. It checks and probes both file sets on the evaluator in forked children. It does not use git or a native build of the target package. It uses the same complete workload set and search budget as proposal review. It writes build/ide/report.json. The lanes open the first workload that differs. Lane b is the buffers.") :: p("Local setup offers Qwen3.5 4B and Qwen3.5 9B. Qwen3.5 4B is the default. Select the larger option explicitly. Inspect cache checks complete artifacts. The picker shows cached, downloadable, or unavailable states. Download model shows the pinned identity, license link, cache destination, and limits. Scuzz streams model files from Hugging Face with Net.httpGetToFile. It follows at most five HTTPS redirects. It writes to a temporary file and checks its size and SHA-256 before rename. Set SCUZZ_MODEL_CACHE to select the cache. The default is ~/.cache/scuzz/models. Scuzz verifies exact bytes and SHA-256. Incomplete files stay unavailable. An interrupted download removes its temporary file. It never reads weights into a source String or copies them into the workspace.") :: cmd("scuzz models list") :: cmd("scuzz models list --message-format=json") :: cmd("scuzz models download qwen3.5-4b") :: cmd("scuzz models download qwen3.5-9b --message-format=json") :: p("Model listing is offline. It starts no inference and writes no workspace file. Download selects no IDE model and fetches no backend. A successful download has a complete verified pinned artifact. Explicit local setup fetches the selected llama.cpp b11146 backend into the user tool cache. It verifies the release digest, files, build, and MIT license identity. Apple Silicon uses Metal. Linux uses Vulkan when a supported GPU is available. Other cases use CPU inference. Unsupported hosts keep External proposals mode. Inference binds private loopback and uses the exact snapshot. Model loading has a five-minute deadline. Each request has a fifteen-minute deadline. Setup has a sixty-minute deadline. Pause, model switch, timeout, and exit stop only owned work. A backend failure needs an explicit retry.") :: p("Limits are three replacement files and 64 KiB of source. Input JSON is at most 1 MiB. Response JSON is at most 128 KiB. Context is 4096 tokens with a 1024-token output allowance. Scuzz applies the pinned chat template and tokenizes before generation. Reduce scope when input does not fit. Scuzz rejects truncated and reasoning-only output. Qwen3.5 4B has a 4 GiB process budget. Qwen3.5 9B has an 8 GiB budget. Available host memory below the model budget plus 2 GiB gives a warning. It does not block setup or generation. Inference uses at most four CPU threads. Linux enforces virtual memory. macOS reports that this process limit is unavailable. A session has eight generation attempts. Failures consume attempts. New session stops owned work, starts a new input identity, and resets the eight-request count. It preserves the objective, source scope, and model. Each review runs 32 search cases. The ready queue limit is two cards. Exported requests permit at most sixteen feedback records. Local IDE requests use the latest three. Finite checks do not establish universal correctness or model usefulness.") :: cmd("scuzz ide export-request myapp --objective 'Create a chat app' --out myapp/build/ide/request.json") :: cmd("scuzz ide generate-suggestion myapp --request myapp/build/ide/request.json --model qwen3.5-4b --out myapp/build/proposals/p1") :: p("Local generation uses the objective as a long-term direction. It requests one small useful addition. The prompt includes Scuzz examples and UI signatures. The local model states one small change and returns at most three edits. Each edit has path, search, and replacement. search matches one unique source block of one to three lines. Scuzz applies each exact match to the frozen source and supplies complete replacement files. Scuzz adds publication metadata and model provenance. Scuzz checks source before formatting. It formats valid source before publication. Review uses those exact bytes. Syntax errors stay available for compiler diagnostics. Raw replies and measurements are in build/ide/generation/. Replies remain available when validation fails. Each request records its sampling seed. The sampling profile is temperature 0.7, top_p 0.8, top_k 20, and min_p 0.0. The finite command uses the same request, catalog, parser, and lifecycle as the IDE. It validates the source graph and compiler before inference. It uses cached artifacts by default. Add --download to permit explicit setup. It refuses an existing output directory and package input paths. It publishes one complete suggestion and exits. Success reports JSON on stdout. Progress goes to stderr. The result says behavioral_review is pending and accepted is false. Source stays unchanged. A successful generation is not an acceptance or a ready card.") :: cmd("scuzz ide review-suggestion myapp --request myapp/build/ide/request.json --candidate myapp/build/proposals/p1") :: p("This command checks the publication and runs the IDE behavioral review. It preserves package source. It writes build/ide/report.json. The report shows differences, claim results, workload scope, and witnesses. An unchanged source fails before behavioral review. The request and publication must still match after review. Use a new request after a source or compiler change. export-request refuses an existing output file.") :: p("An external producer reads build/ide/request.json. The request has v, request, kind, objective, baseline, compiler, inputs, sources, allowed, checks, feedback, limits, and instructions. checks contains fixed verification files, scenario files, and corpus inputs. Keep their requirements true. Use these frozen fields. Do not reconstruct or omit them. The complete response has v, request, baseline, kind, generator, and files. Each replacement has path and content. This example shows the response shape. Use the actual exported identities and one allowed path.") :: code("{\n  \"v\": 1,\n  \"request\": \"EXPORTED_REQUEST\",\n  \"baseline\": \"EXPORTED_BASELINE\",\n  \"kind\": \"behavior\",\n  \"generator\": \"external-producer\",\n  \"files\": [{\"path\": \"src/Main.scuzz\", \"content\": \"@main def main: IO[Unit] = IO.println(2)\"}]\n}") :: p("The importer accepts complete directories with content hashes. Use a new candidate name. Keep staging outside the watched inbox. This recipe publishes one replacement from a file. It does not start a producer or manage its credentials.") :: code("import hashlib, json, os, pathlib, uuid\nroot = pathlib.Path(\"myapp\")\nrequest = json.loads((root / \"build/ide/request.json\").read_text())\npath = \"src/Main.scuzz\"\nassert path in request[\"allowed\"]\ncontent = pathlib.Path(\"replacement.scuzz\").read_text()\nstage = root / \"build\" / (\"publish-\" + str(uuid.uuid4()))\nout = root / \"build/proposals/p1\"\nassert not out.exists()\n(stage / \"src\").mkdir(parents=True)\n(stage / path).write_text(content)\nmetadata = {\"v\": 1, \"request\": request[\"request\"],\n            \"baseline\": request[\"baseline\"], \"kind\": \"behavior\",\n            \"generator\": \"external-producer\",\n            \"files\": [{\"path\": path, \"sha256\": hashlib.sha256(content.encode()).hexdigest()}]}\n(stage / \"proposal.json\").write_text(json.dumps(metadata))\nout.parent.mkdir(parents=True, exist_ok=True)\nos.rename(stage, out)\n") :: [])

def tryIt(): Topic =
  Topic("try", "Try it", p("Edit the program and press Run. The evaluator checks the source, runs @main, and mounts the View that Ui.run receives. A check error or an evaluator stop shows in place of the view. The same evaluator drives scuzz eval and scuzz fuzz.") :: p("The view is live. Buttons run their closures. Signals update the bound text.") :: [])

def trySource(): String =
  "@main def main: IO[Unit] =\n  for {\n    clicks = Signal.make(0)\n    label = Signal.map(clicks, n => s\"Clicks: $n\")\n    _ <- Ui.run(_ => View.column([View.bindText(label), View.button(\"+1\", _ => Signal.set(clicks, Signal.get(clicks) + 1))]))\n  } yield ()\n"

def how(): Topic =
  Topic("how", "How it runs", p("Write oracle hidden in a *.scuzz_verify file. Press Fuzz to search it. The search tries hidden at 0 through 8 and prints the failing argument.") :: p("The same IO.both snippet runs under two schedule seeds. Two cards show the two scheduler worlds. Queue.offer L and Queue.offer R race. leftFirst requires L. One branch fails. One branch passes. Below that, the evaluator shows a reduction trace, coverage hits, and one mutant.") :: Block.Viz("schedule", schedSource()) :: Block.Viz("trace", traceSource()) :: Block.Viz("coverage", coverSource()) :: Block.Viz("mutant", mutSource()) :: [])

def campSource(): String =
  """oracle hidden(code: Int): Bool =
  if (code == 3) false else true

@main def main: IO[Unit] =
  IO.pure(())
"""

def schedSource(): String =
  "@main def main: IO[Unit] =\n  for {\n    order = Signal.makeN(\"order\", 0)\n    q <- Queue.unbounded()\n    _ <- IO.both(Queue.offer(q, \"L\"), Queue.offer(q, \"R\"))\n    first <- Queue.take(q)\n    _ = Signal.set(order, if (Str.eq(first, \"L\")) 1 else 0)\n  } yield ()\n"

def traceSource(): String =
  """@main def main: IO[Unit] =
  for {
    n = 1 + 2
    _ <- IO.pure(())
  } yield ()
"""

def coverSource(): String =
  """def countdown(n: Int): Int =
  if (n <= 0) 0 else countdown(n - 1)

@main def main: IO[Unit] =
  for {
    _ = countdown(8)
    _ <- IO.pure(())
  } yield ()
"""

def mutSource(): String =
  """@main def main: IO[Unit] =
  for {
    n = 1 + 2
    _ <- IO.pure(())
  } yield ()
"""

