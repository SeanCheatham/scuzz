@main def main: IO[Unit] =
  for {
    r <- Ref.of("x")
    _ <- Ref.set(r, "ref-ok")
    v <- Ref.get(r)
    _ <- IO.println(s"ref:$v")
    q <- Queue.unbounded()
    _ <- IO.both(Queue.take(q), Queue.offer(q, "parked"))
    _ <- IO.println("queue-ok")
    d <- Deferred.empty()
    _ <- IO.both(Deferred.get(d), Deferred.complete(d, "go"))
    _ <- IO.println("deferred-ok")
    _ <- IO.race(IO.sleep(50), IO.println("race-fast"))
    f <- Fiber.fork(IO.pure("fork-ok"))
    got <- Fiber.join(f)
    _ <- IO.println(got)
    g <- Fiber.fork(IO.sleep(50))
    _ <- Fiber.interrupt(g)
    _ <- Fiber.join(g).handleErrorWith(_ => IO.println("interrupted"))
    _ <- IO.println("done")
  } yield ()
