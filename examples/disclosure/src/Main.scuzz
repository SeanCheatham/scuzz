@main def main: IO[Unit] =
  for {
    open = Signal.make(0)
    nested = Signal.make(0)
    show = Signal.make(0)
    conditional = Signal.make(1)
    name = Signal.make("")
    note = Signal.make("")
    count = Signal.make(0)
    countText = Signal.map(count, n => s"Count: $n")
    tab = Signal.make(0)
    book = Signal.make(0)
    picks = Signal.make(0)
    picksText = Signal.map(picks, n => s"Picks: $n")
    modal = Signal.make(0)
    modalTab = Signal.make(0)
    modalBook = Signal.make(0)
    modalPicks = Signal.make(0)
    modalText = Signal.map(modalPicks, n => s"Modal picks: $n")
    _ <- Ui.run(_ => View.stack([View.expanded(1, View.scroll(View.column([View.expansionTile(open, "Details", View.padding(12, View.column([View.text("Select this body text."), View.textField(name, "Name"), View.button("Add", _ => Signal.set(count, Signal.get(count) + 1)), View.bindText(countText), View.expansionTile(nested, "More details", View.column([View.textField(note, "Note"), View.button("Close details", _ => Signal.set(open, 0))]))]))), View.expansionTile(conditional, "Conditional", View.showWhen(show, 1, View.text("Conditional body"))), View.checkbox(show, "Show conditional body"), View.button("Open details", _ => Signal.set(open, 2)), View.button("Hide details", _ => Signal.set(open, 0)), View.tabs(tab, View.column([View.section("overview", "Overview", View.text("Overview panel")), View.section("metrics", "Metrics", View.button("Apply metric", _ => Signal.set(picks, Signal.get(picks) + 1))), View.section("logs", "Logs", View.text("Logs panel"))])), View.indexBook(book, View.column([View.section("guide", "Guide", View.text("Guide page")), View.section("keys", "Keys", View.button("Run key", _ => Signal.set(picks, Signal.get(picks) + 10))), View.section("bounds", "Bounds", View.text("Bounds page"))])), View.focusGroup(View.row([View.button("Pin", _ => Signal.set(picks, Signal.get(picks) + 100)), View.button("Open modal", _ => Signal.set(modal, 1)), View.button("Reset picks", _ => Signal.set(picks, 0))])), View.bindText(picksText)]))), View.overlay(modal, "Composite dialog", View.center(View.card(View.padding(12, View.column([View.tabs(modalTab, View.column([View.section("m-alpha", "Alpha", View.text("Alpha body")), View.section("m-beta", "Beta", View.focusGroup(View.row([View.button("Modal pick", _ => Signal.set(modalPicks, Signal.get(modalPicks) + 1)), View.button("Done modal", _ => Signal.set(modal, 0))])))])), View.indexBook(modalBook, View.column([View.section("m-first", "First", View.text("First note")), View.section("m-second", "Second", View.text("Second note"))])), View.bindText(modalText)])))))]))
  } yield ()
