def add(n: Int, m: Int): Bool =
  Main.add(n, m) == Main.add(m, n)

def addTwoThree(): Bool =
  Main.add(2, 3) == 5

def sumToDiff(n: Int where n >= 0): Bool =
  Main.sumTo(n, 0) == Oracle.sumTo(n)

def sumToTen(): Bool =
  Main.sumTo(10, 0) == 55

def termDiff(t: Term): Bool =
  Main.termAgrees(t)

def utf8Ops(): Bool =
  Main.utf8Check() == 1

