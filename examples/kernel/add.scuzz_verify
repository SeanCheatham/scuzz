oracle add(n: Int, m: Int): Bool =
  Main.add(n, m) == Main.add(m, n)

oracle addTwoThree(): Bool =
  Main.add(2, 3) == 5

oracle sumToDiff(n: Int where n >= 0): Bool =
  Main.sumTo(n, 0) == Oracle.sumTo(n)

oracle sumToTen(): Bool =
  Main.sumTo(10, 0) == 55

oracle termDiff(t: Term): Bool =
  Main.termAgrees(t)

oracle nestedTerm(t: Term): Bool =
  Main.evalNestedAdd(t) == Main.evalTerm(t)

oracle utf8Ops(): Bool =
  Main.utf8Check() == 1

oracle mixedDefault(): Bool =
  Main.addDefault(3, m = 4) == 7

oracle mixedGreet(): Bool =
  Main.greet("hi", punct = "?") == "hi?"

oracle tupFive(): Bool =
  (1, 2, 3, 4, 5)._5 == 5

oracle tupEight(): Bool =
  (1, 2, 3, 4, 5, 6, 7, 8)._8 == 8

oracle tupCall(): Bool =
  Main.rot3((1, "x", true))._1 == "x"

oracle smapN(): Bool =
  Main.mapSetSizeOk()

oracle smapHas(): Bool =
  Main.mapSetHasOk()

oracle smapEq(): Bool =
  Main.mapSetEqOk()

oracle scollapse(): Bool =
  Main.mapSetCollapseOk()

oracle tosetVar(): Bool =
  Main.toSetFromVarOk()

oracle mapEmptyGet(): Bool =
  Main.mapGetEmptyOk()

oracle jsonPairLifetime(n: Int): Bool =
  Main.jsonPairRoundTrip(n)

