def add(n: Int, m: Int): Bool =
  Main.add(n, m) == Main.add(m, n)

def addTwoThree(): Bool =
  Main.add(2, 3) == 5

def sumToDiff(n: Int where n >= 0): Bool =
  Main.sumTo(n, 0) == Oracle.sumTo(n)

def sumToTen(): Bool =
  Main.sumTo(10, 0) == 55

def termDiff(t: Term): Bool =
  Main.termAgrees(t)

def utf8Ops(): Bool =
  Main.utf8Check() == 1

def mixedDefault(): Bool =
  Main.addDefault(3, m = 4) == 7

def mixedGreet(): Bool =
  Main.greet("hi", punct = "?") == "hi?"

def tupFive(): Bool =
  (1, 2, 3, 4, 5)._5 == 5

def tupEight(): Bool =
  (1, 2, 3, 4, 5, 6, 7, 8)._8 == 8

def tupCall(): Bool =
  Main.rot3((1, "x", true))._1 == "x"

def smapN(): Bool =
  Main.mapSetSizeOk()

def smapHas(): Bool =
  Main.mapSetHasOk()

def smapEq(): Bool =
  Main.mapSetEqOk()

def scollapse(): Bool =
  Main.mapSetCollapseOk()

def tosetVar(): Bool =
  Main.toSetFromVarOk()

def mapEmptyGet(): Bool =
  Main.mapGetEmptyOk()

