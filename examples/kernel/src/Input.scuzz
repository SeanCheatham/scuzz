record Quantity private(value: Int)

record Read[A](result: Result[String, A], count: Int)

record Piece(quantity: Int)

record Order(name: String, item: Piece, note: Json)

record Mark(on: Bool, ratio: Float)

record Line(qty: Int)

record Cart(names: List[String], lines: List[Line], flags: List[Bool], ratios: List[Float], counts: List[Int])

record Note(text: String)

record Ticket(title: String, label: Option[String], count: Option[Int], flag: Option[Bool], ratio: Option[Float], note: Option[Note])

enum Tone:
  case Calm
  case Loud

record Mood(tone: Tone)

record Job(title: String, tone: Tone, mood: Mood)

record Choir(tones: List[Tone], pick: Option[Tone])

record Grid(items: List[List[String]], rows: List[List[Line]], tones: List[List[Tone]])

type Effect[E, A] = IO[E, A]
type Sale = Order
def aliasEffect[E, A](effect: Effect[E, A]): Effect[E, A] =
  for {
    value <- effect
  } yield value

def quotient(a: Int, b: Int): Int =
  a / b

def remainder(a: Int, b: Int): Int =
  a % b

def division(a: Int, b: Int): Result[String, (Int, Int)] =
  if (b == 0) Result.Err("divisor must be nonzero") else Result.Ok((quotient(a, b), remainder(a, b)))

def fields(text: String): Result[String, Int] =
  for {
    ((first, _), second) = ((Str.parseInt(text), true), Str.parseInt("7"))
    Read(result = result) = Read(first, 1)
  } yield second match {
  case Result.Ok(_) => result
  case Result.Err(error) => Result.Err(error)
}

def effectFields(text: String): IO[Result[String, Int]] =
  for {
    (result, _) <- IO.pure((fields(text), 1))
  } yield result

def totalBindings(flag: Bool, n: Int): IO[Int] =
  for {
    __p = n
    true | false = flag
    true | false <- IO.pure(flag)
    (Quantity(value), ()) <- IO.pure((Quantity(n), ()))
  } yield value + __p - n

def quantity(n: Int): Result[String, Quantity] =
  if (n >= 1 && n <= 100) Result.Ok(Quantity(n)) else Result.Err("quantity must be 1 through 100")

def parseQuantity(text: String): Result[String, Quantity] =
  Str.parseInt(text) match {
    case Result.Ok(n) => quantity(n)
    case Result.Err(error) => Result.Err(error)
  }

def collectQuantities(results: List[Result[String, Quantity]]): Result[String, List[Quantity]] =
  results match {
    case [] => Result.Ok([])
    case head :: tail => head match {
  case Result.Err(error) => Result.Err(error)
  case Result.Ok(value) => collectQuantities(tail) match {
  case Result.Err(error) => Result.Err(error)
  case Result.Ok(values) => Result.Ok(value :: values)
}
}
  }

def batch(texts: List[String]): Result[String, List[Quantity]] =
  for {
    results = List.map(texts, text => parseQuantity(text))
  } yield collectQuantities(results)

def decodeOrder(json: Json): Result[String, Order] =
  Json.decode(json)

def decodeText(text: String): Result[String, Order] =
  Json.parse(text) match {
    case Result.Ok(json) => Json.decode(json)
    case Result.Err(error) => Result.Err(error)
  }

def decodeSale(json: Json): Result[String, Sale] =
  Json.decode(json)

def decodeFlag(json: Json): Result[String, Mark] =
  Json.decode(json)

def showOrder(result: Result[String, Order]): String =
  result match {
    case Result.Ok(Order(name, Piece(quantity), note)) => Json.stringify(note) match {
  case Result.Ok(encoded) => s"ok:$name:$quantity:$encoded"
  case Result.Err(error) => s"error:$error"
}
    case Result.Err(error) => s"error:$error"
  }

def orderText(text: String): String =
  Json.parse(text) match {
    case Result.Ok(json) => showOrder(decodeOrder(json))
    case Result.Err(error) => s"error:$error"
  }

def textOrder(text: String): String =
  showOrder(decodeText(text))

def saleText(text: String): String =
  Json.parse(text) match {
    case Result.Ok(json) => decodeSale(json) match {
  case Result.Ok(Order(name, Piece(quantity), note)) => Json.stringify(note) match {
  case Result.Ok(encoded) => s"ok:$name:$quantity:$encoded"
  case Result.Err(error) => s"error:$error"
}
  case Result.Err(error) => s"error:$error"
}
    case Result.Err(error) => s"error:$error"
  }

def orderInRange(text: String): Bool =
  Json.parse(text) match {
    case Result.Ok(json) => decodeOrder(json) match {
  case Result.Ok(Order(_, Piece(quantity), _)) => quantity >= 1 && quantity <= 100
  case Result.Err(_) => false
}
    case Result.Err(_) => false
  }

def flagOk(text: String): Bool =
  Json.parse(text) match {
    case Result.Ok(json) => decodeFlag(json) match {
  case Result.Ok(Mark(on, ratio)) => on && ratio == 1.5
  case Result.Err(_) => false
}
    case Result.Err(_) => false
  }

def ratioMark(xs: List[Float]): String =
  xs match {
    case [] => "empty"
    case a :: b :: rest => if (List.isEmpty(rest) && a == 1.5 && b == 2.5) "pair" else "bad"
    case _ => "bad"
  }

def showCart(result: Result[String, Cart]): String =
  result match {
    case Result.Ok(Cart(names, lines, flags, ratios, counts)) => s"ok:${List.join(names, ",")}:${List.join(List.map(lines, line => Str.fromInt(line.qty)), ",")}:${List.join(List.map(flags, flag => Str.fromBool(flag)), ",")}:${List.join(List.map(counts, n => Str.fromInt(n)), ",")}:${ratioMark(ratios)}"
    case Result.Err(error) => s"error:$error"
  }

def decodeCart(json: Json): Result[String, Cart] =
  Json.decode(json)

def listText(text: String): String =
  Json.parse(text) match {
    case Result.Ok(json) => showCart(decodeCart(json))
    case Result.Err(error) => s"error:$error"
  }

def listProof(): Bool =
  listText("{\"names\":[\"a\",\"b\"],\"lines\":[{\"qty\":2},{\"qty\":3}],\"flags\":[true,false],\"ratios\":[1.5,2.5],\"counts\":[4,5]}") == "ok:a,b:2,3:true,false:4,5:pair" && listText("{\"names\":[],\"lines\":[],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "ok:::::empty" && listText("{\"lines\":[],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: missing field names" && listText("{\"names\":[\"a\",1],\"lines\":[],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: wrong case at names.1" && listText("{\"names\":[null],\"lines\":[],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: wrong case at names.0" && listText("{\"names\":[],\"lines\":[{\"qty\":2},{\"qty\":true}],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: wrong case at lines.1.qty" && listText("{\"names\":[],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: missing field lines" && listText("{\"names\":null,\"lines\":[],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: wrong case at names" && listText("{\"names\":[\"a\"],\"lines\":[],\"flags\":[null],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: wrong case at flags.0" && listText("{\"names\":[],\"lines\":[],\"flags\":[],\"ratios\":[1],\"counts\":[]}") == "error:Json.decode: wrong case at ratios.0" && listText("{\"names\":[],\"lines\":[],\"flags\":[],\"ratios\":[],\"counts\":[1,\"x\"]}") == "error:Json.decode: wrong case at counts.1"

def optText(value: Option[String]): String =
  value match {
    case Option.Some(text) => text
    case Option.None => "none"
  }

def optCount(value: Option[Int]): String =
  value match {
    case Option.Some(n) => Str.fromInt(n)
    case Option.None => "none"
  }

def optFlag(value: Option[Bool]): String =
  value match {
    case Option.Some(flag) => Str.fromBool(flag)
    case Option.None => "none"
  }

def optRatio(value: Option[Float]): String =
  value match {
    case Option.Some(n) => if (n == 1.5) "1.5" else "bad"
    case Option.None => "none"
  }

def optNote(value: Option[Note]): String =
  value match {
    case Option.Some(Note(text)) => text
    case Option.None => "none"
  }

def showTicket(result: Result[String, Ticket]): String =
  result match {
    case Result.Ok(Ticket(title, label, count, flag, ratio, note)) => s"ok:$title:${optText(label)}:${optCount(count)}:${optFlag(flag)}:${optRatio(ratio)}:${optNote(note)}"
    case Result.Err(error) => s"error:$error"
  }

def decodeTicket(json: Json): Result[String, Ticket] =
  Json.decode(json)

def ticketText(text: String): String =
  Json.parse(text) match {
    case Result.Ok(json) => showTicket(decodeTicket(json))
    case Result.Err(error) => s"error:$error"
  }

def optionProof(): Bool =
  ticketText("{\"title\":\"a\"}") == "ok:a:none:none:none:none:none" && ticketText("{\"title\":\"a\",\"label\":null,\"count\":null,\"flag\":null,\"ratio\":null,\"note\":null}") == "ok:a:none:none:none:none:none" && ticketText("{\"title\":\"a\",\"label\":\"x\",\"count\":0,\"flag\":false,\"ratio\":1.5,\"note\":{\"text\":\"hi\"}}") == "ok:a:x:0:false:1.5:hi" && ticketText("{\"title\":\"a\",\"label\":1}") == "error:Json.decode: wrong case at label" && ticketText("{\"title\":\"a\",\"note\":{\"text\":true}}") == "error:Json.decode: wrong case at note.text" && ticketText("{\"label\":\"x\"}") == "error:Json.decode: missing field title" && ticketText("{\"title\":null}") == "error:Json.decode: wrong case at title" && ticketText("{\"title\":\"a\",\"note\":{}}") == "error:Json.decode: missing field note.text" && ticketText("{\"title\":\"a\",\"ratio\":1}") == "error:Json.decode: wrong case at ratio" && ticketText("{\"title\":\"a\",\"count\":7}") == "ok:a:none:7:none:none:none" && ticketText("{\"title\":\"a\",\"note\":1}") == "error:Json.decode: wrong case at note.text"

def toneName(tone: Tone): String =
  tone match {
    case Tone.Calm => "Calm"
    case Tone.Loud => "Loud"
  }

def showJob(result: Result[String, Job]): String =
  result match {
    case Result.Ok(Job(title, tone, Mood(inner))) => s"ok:$title:${toneName(tone)}:${toneName(inner)}"
    case Result.Err(error) => s"error:$error"
  }

def decodeJob(json: Json): Result[String, Job] =
  Json.decode(json)

def jobText(text: String): String =
  Json.parse(text) match {
    case Result.Ok(json) => showJob(decodeJob(json))
    case Result.Err(error) => s"error:$error"
  }

def enumProof(): Bool =
  jobText("{\"title\":\"a\",\"tone\":\"Calm\",\"mood\":{\"tone\":\"Loud\"}}") == "ok:a:Calm:Loud" && jobText("{\"title\":\"a\",\"tone\":\"Loud\",\"mood\":{\"tone\":\"Calm\"}}") == "ok:a:Loud:Calm" && jobText("{\"title\":\"a\",\"tone\":\"Gone\",\"mood\":{\"tone\":\"Calm\"}}") == "error:Json.decode: unknown case at tone: Gone" && jobText("{\"title\":\"a\",\"tone\":\"Calm\",\"mood\":{\"tone\":\"Gone\"}}") == "error:Json.decode: unknown case at mood.tone: Gone" && jobText("{\"title\":\"a\",\"tone\":1,\"mood\":{\"tone\":\"Calm\"}}") == "error:Json.decode: wrong case at tone: 1" && jobText("{\"title\":\"a\",\"tone\":\"Calm\",\"mood\":{\"tone\":1}}") == "error:Json.decode: wrong case at mood.tone: 1" && jobText("{\"title\":\"a\",\"tone\":null,\"mood\":{\"tone\":\"Calm\"}}") == "error:Json.decode: wrong case at tone: null" && jobText("{\"title\":\"a\",\"tone\":true,\"mood\":{\"tone\":\"Calm\"}}") == "error:Json.decode: wrong case at tone: true" && jobText("{\"title\":\"a\",\"mood\":{\"tone\":\"Calm\"}}") == "error:Json.decode: missing field tone" && jobText("{\"title\":\"a\",\"tone\":\"Calm\",\"mood\":{}}") == "error:Json.decode: missing field mood.tone"

def toneList(xs: List[Tone]): String =
  if (List.isEmpty(xs)) "empty" else List.join(List.map(xs, tone => toneName(tone)), ",")

def optTone(value: Option[Tone]): String =
  value match {
    case Option.Some(tone) => toneName(tone)
    case Option.None => "none"
  }

def showChoir(result: Result[String, Choir]): String =
  result match {
    case Result.Ok(Choir(tones, pick)) => s"ok:${toneList(tones)}:${optTone(pick)}"
    case Result.Err(error) => s"error:$error"
  }

def decodeChoir(json: Json): Result[String, Choir] =
  Json.decode(json)

def choirText(text: String): String =
  Json.parse(text) match {
    case Result.Ok(json) => showChoir(decodeChoir(json))
    case Result.Err(error) => s"error:$error"
  }

def choirProof(): Bool =
  choirText("{\"tones\":[\"Calm\",\"Loud\"],\"pick\":\"Calm\"}") == "ok:Calm,Loud:Calm" && choirText("{\"tones\":[\"Calm\",\"Gone\"],\"pick\":\"Calm\"}") == "error:Json.decode: unknown case at tones.1: Gone" && choirText("{\"tones\":[\"Calm\"]}") == "ok:Calm:none" && choirText("{\"tones\":[\"Loud\"],\"pick\":null}") == "ok:Loud:none" && choirText("{\"tones\":[],\"pick\":\"Loud\"}") == "ok:empty:Loud" && choirText("{\"tones\":[\"Calm\"],\"pick\":\"Gone\"}") == "error:Json.decode: unknown case at pick: Gone" && choirText("{\"tones\":[1],\"pick\":\"Calm\"}") == "error:Json.decode: wrong case at tones.0: 1" && choirText("{\"tones\":[\"Calm\"],\"pick\":1}") == "error:Json.decode: wrong case at pick: 1" && choirText("{\"tones\":[null],\"pick\":null}") == "error:Json.decode: wrong case at tones.0: null" && choirText("{\"pick\":\"Calm\"}") == "error:Json.decode: missing field tones"

def groupText(xs: List[String]): String =
  if (List.isEmpty(xs)) "empty" else List.join(xs, ",")

def groupsText(xs: List[List[String]]): String =
  if (List.isEmpty(xs)) "empty" else List.join(List.map(xs, row => groupText(row)), "|")

def showGrid(result: Result[String, Grid]): String =
  result match {
    case Result.Ok(Grid(items, rows, tones)) => s"ok:${groupsText(items)}:${groupsText(List.map(rows, row => List.map(row, line => Str.fromInt(line.qty))))}:${groupsText(List.map(tones, row => List.map(row, tone => toneName(tone))))}"
    case Result.Err(error) => s"error:$error"
  }

def decodeGrid(json: Json): Result[String, Grid] =
  Json.decode(json)

def gridText(text: String): String =
  Json.parse(text) match {
    case Result.Ok(json) => showGrid(decodeGrid(json))
    case Result.Err(error) => s"error:$error"
  }

def gridProof(): Bool =
  gridText("{\"items\":[[\"a\",\"b\"],[\"c\"]],\"rows\":[[{\"qty\":2}],[{\"qty\":3},{\"qty\":4}]],\"tones\":[[\"Calm\"],[\"Loud\",\"Calm\"]]}") == "ok:a,b|c:2|3,4:Calm|Loud,Calm" && gridText("{\"items\":[[],[]],\"rows\":[],\"tones\":[[]]}") == "ok:empty|empty:empty:empty" && gridText("{\"items\":[[\"a\"],[1]],\"rows\":[],\"tones\":[]}") == "error:Json.decode: wrong case at items.1.0" && gridText("{\"items\":[[null]],\"rows\":[],\"tones\":[]}") == "error:Json.decode: wrong case at items.0.0" && gridText("{\"items\":[[\"a\"],\"b\"],\"rows\":[],\"tones\":[]}") == "error:Json.decode: wrong case at items.1" && gridText("{\"items\":[],\"rows\":[[{\"qty\":1}],[{\"qty\":true}]],\"tones\":[]}") == "error:Json.decode: wrong case at rows.1.0.qty" && gridText("{\"items\":[],\"rows\":[[{}]],\"tones\":[]}") == "error:Json.decode: missing field rows.0.0.qty" && gridText("{\"items\":[],\"rows\":[],\"tones\":[[\"Calm\"],[\"Gone\"]]}") == "error:Json.decode: unknown case at tones.1.0: Gone" && gridText("{\"items\":[],\"rows\":[],\"tones\":[[1]]}") == "error:Json.decode: wrong case at tones.0.0: 1" && gridText("{\"items\":[],\"rows\":[],\"tones\":[[null]]}") == "error:Json.decode: wrong case at tones.0.0: null" && gridText("{\"rows\":[],\"tones\":[]}") == "error:Json.decode: missing field items"

def orderProof(): Bool =
  orderText("{\"name\":\"bolt\",\"item\":{\"quantity\":2},\"note\":\"ok\"}") == "ok:bolt:2:\"ok\"" && textOrder("{\"name\":\"bolt\",\"item\":{\"quantity\":2},\"note\":\"ok\"}") == "ok:bolt:2:\"ok\"" && saleText("{\"name\":\"bolt\",\"item\":{\"quantity\":2},\"note\":\"ok\"}") == "ok:bolt:2:\"ok\"" && orderText("{\"name\":\"bolt\",\"item\":{},\"note\":\"ok\"}") == "error:Json.decode: missing field item.quantity" && orderText("{\"name\":\"bolt\",\"item\":{\"quantity\":\"2\"},\"note\":\"ok\"}") == "error:Json.decode: wrong case at item.quantity" && orderText("{\"name\":\"bolt\",\"item\":{\"quantity\":2},\"note\":null}") == "ok:bolt:2:null" && orderText("{\"name\":\"bolt\",\"item\":null,\"note\":\"ok\"}") == "error:Json.decode: wrong case at item.quantity" && orderText("[]") == "error:Json.decode: wrong case at name" && orderText("{\"item\":{\"quantity\":2},\"note\":\"ok\"}") == "error:Json.decode: missing field name" && orderText("{\"name\":null,\"item\":{\"quantity\":2},\"note\":\"ok\"}") == "error:Json.decode: wrong case at name" && orderText("{\"name\":\"bolt\",\"item\":{\"quantity\":101},\"note\":null}") == "ok:bolt:101:null" && orderInRange("{\"name\":\"bolt\",\"item\":{\"quantity\":2},\"note\":null}") && !orderInRange("{\"name\":\"bolt\",\"item\":{\"quantity\":101},\"note\":null}") && flagOk("{\"on\":true,\"ratio\":1.5}") && !flagOk("{\"on\":true,\"ratio\":1}")

def decodeQuantity(text: String): Result[String, Quantity] =
  Json.parse(text) match {
    case Result.Ok(json) => Json.field(json, "quantity") match {
  case Result.Ok(Json.Int(n)) => quantity(n)
  case Result.Ok(_) => Result.Err("quantity must be an integer")
  case Result.Err(error) => Result.Err(error)
}
    case Result.Err(error) => Result.Err(error)
  }

def parsed(text: String): String =
  Str.parseInt(text) match {
    case Result.Ok(n) => s"ok:$n"
    case Result.Err(error) => s"error:$error"
  }

def accepted(result: Result[String, Quantity]): Bool =
  result match {
    case Result.Ok(_) => true
    case Result.Err(_) => false
  }

def proof(): Bool =
  parsed("9223372036854775807") == "ok:9223372036854775807" && parsed("-9223372036854775808") == "ok:-9223372036854775808" && parsed("+0007") == "ok:7" && parsed(Hex.decode("370078")) == "error:Str.parseInt: invalid integer" && parsed("9223372036854775808") == "error:Str.parseInt: out of range" && parsed("-9223372036854775809") == "error:Str.parseInt: out of range" && !accepted(parseQuantity("0")) && !accepted(parseQuantity("101")) && !accepted(parseQuantity(" 1")) && !accepted(decodeQuantity("{}")) && !accepted(decodeQuantity("[]")) && !accepted(decodeQuantity("{\"quantity\":null}")) && !accepted(decodeQuantity("{\"quantity\":\"1\"}")) && !accepted(decodeQuantity("{\"quantity\":1.0}")) && !accepted(decodeQuantity("{\"quantity\":101}")) && accepted(decodeQuantity("{\"quantity\":1}")) && accepted(parseQuantity("100")) && orderProof() && listProof() && optionProof() && enumProof() && choirProof() && gridProof()

def forward(text: String): Result[String, Int] =
  for {
    result = Str.parseInt(text)
  } yield result

def resolved(text: String): Int =
  for {
    result = forward(text)
    copied = result
  } yield copied match {
  case Result.Ok(n) => n
  case Result.Err(_) => -1
}

def attempt(flag: Bool): IO[Int] =
  for {
    result <- IO.attempt(if (flag) IO.pure(7) else IO.fail("input failure"))
  } yield result match {
  case Result.Ok(n) => n
  case Result.Err(_) => -1
}

def unitBind(flag: Bool): IO[Int] =
  for {
    () <- if (flag) IO.pure(()) else IO.fail("unit failure")
  } yield 7

