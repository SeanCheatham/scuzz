record Quantity private(value: Int)

record Read[A](result: Result[String, A], count: Int)

record Piece(quantity: Int)

record Order(name: String, item: Piece, note: Json)

record Mark(on: Bool, ratio: Float)

record Line(qty: Int)

record Cart(names: List[String], lines: List[Line], flags: List[Bool], ratios: List[Float], counts: List[Int])

type Effect[E, A] = IO[E, A]
type Sale = Order
def aliasEffect[E, A](effect: Effect[E, A]): Effect[E, A] =
  for {
    value <- effect
  } yield value

def quotient(a: Int, b: Int): Int =
  a / b

def remainder(a: Int, b: Int): Int =
  a % b

def division(a: Int, b: Int): Result[String, (Int, Int)] =
  if (b == 0) Result.Err("divisor must be nonzero") else Result.Ok((quotient(a, b), remainder(a, b)))

def fields(text: String): Result[String, Int] =
  for {
    ((first, _), second) = ((Str.parseInt(text), true), Str.parseInt("7"))
    Read(result = result) = Read(first, 1)
  } yield second match {
  case Result.Ok(_) => result
  case Result.Err(error) => Result.Err(error)
}

def effectFields(text: String): IO[Result[String, Int]] =
  for {
    (result, _) <- IO.pure((fields(text), 1))
  } yield result

def totalBindings(flag: Bool, n: Int): IO[Int] =
  for {
    __p = n
    true | false = flag
    true | false <- IO.pure(flag)
    (Quantity(value), ()) <- IO.pure((Quantity(n), ()))
  } yield value + __p - n

def quantity(n: Int): Result[String, Quantity] =
  if (n >= 1 && n <= 100) Result.Ok(Quantity(n)) else Result.Err("quantity must be 1 through 100")

def parseQuantity(text: String): Result[String, Quantity] =
  Str.parseInt(text) match {
    case Result.Ok(n) => quantity(n)
    case Result.Err(error) => Result.Err(error)
  }

def collectQuantities(results: List[Result[String, Quantity]]): Result[String, List[Quantity]] =
  results match {
    case [] => Result.Ok([])
    case head :: tail => head match {
  case Result.Err(error) => Result.Err(error)
  case Result.Ok(value) => collectQuantities(tail) match {
  case Result.Err(error) => Result.Err(error)
  case Result.Ok(values) => Result.Ok(value :: values)
}
}
  }

def batch(texts: List[String]): Result[String, List[Quantity]] =
  for {
    results = List.map(texts, text => parseQuantity(text))
  } yield collectQuantities(results)

def decodeOrder(json: Json): Result[String, Order] =
  Json.decode(json)

def decodeText(text: String): Result[String, Order] =
  Json.parse(text) match {
    case Result.Ok(json) => Json.decode(json)
    case Result.Err(error) => Result.Err(error)
  }

def decodeSale(json: Json): Result[String, Sale] =
  Json.decode(json)

def decodeFlag(json: Json): Result[String, Mark] =
  Json.decode(json)

def showOrder(result: Result[String, Order]): String =
  result match {
    case Result.Ok(Order(name, Piece(quantity), note)) => Json.stringify(note) match {
  case Result.Ok(encoded) => s"ok:$name:$quantity:$encoded"
  case Result.Err(error) => s"error:$error"
}
    case Result.Err(error) => s"error:$error"
  }

def orderText(text: String): String =
  Json.parse(text) match {
    case Result.Ok(json) => showOrder(decodeOrder(json))
    case Result.Err(error) => s"error:$error"
  }

def textOrder(text: String): String =
  showOrder(decodeText(text))

def saleText(text: String): String =
  Json.parse(text) match {
    case Result.Ok(json) => decodeSale(json) match {
  case Result.Ok(Order(name, Piece(quantity), note)) => Json.stringify(note) match {
  case Result.Ok(encoded) => s"ok:$name:$quantity:$encoded"
  case Result.Err(error) => s"error:$error"
}
  case Result.Err(error) => s"error:$error"
}
    case Result.Err(error) => s"error:$error"
  }

def orderInRange(text: String): Bool =
  Json.parse(text) match {
    case Result.Ok(json) => decodeOrder(json) match {
  case Result.Ok(Order(_, Piece(quantity), _)) => quantity >= 1 && quantity <= 100
  case Result.Err(_) => false
}
    case Result.Err(_) => false
  }

def flagOk(text: String): Bool =
  Json.parse(text) match {
    case Result.Ok(json) => decodeFlag(json) match {
  case Result.Ok(Mark(on, ratio)) => on && ratio == 1.5
  case Result.Err(_) => false
}
    case Result.Err(_) => false
  }

def ratioMark(xs: List[Float]): String =
  xs match {
    case [] => "empty"
    case a :: b :: rest => if (List.isEmpty(rest) && a == 1.5 && b == 2.5) "pair" else "bad"
    case _ => "bad"
  }

def showCart(result: Result[String, Cart]): String =
  result match {
    case Result.Ok(Cart(names, lines, flags, ratios, counts)) => s"ok:${List.join(names, ",")}:${List.join(List.map(lines, line => Str.fromInt(line.qty)), ",")}:${List.join(List.map(flags, flag => Str.fromBool(flag)), ",")}:${List.join(List.map(counts, n => Str.fromInt(n)), ",")}:${ratioMark(ratios)}"
    case Result.Err(error) => s"error:$error"
  }

def decodeCart(json: Json): Result[String, Cart] =
  Json.decode(json)

def listText(text: String): String =
  Json.parse(text) match {
    case Result.Ok(json) => showCart(decodeCart(json))
    case Result.Err(error) => s"error:$error"
  }

def listProof(): Bool =
  listText("{\"names\":[\"a\",\"b\"],\"lines\":[{\"qty\":2},{\"qty\":3}],\"flags\":[true,false],\"ratios\":[1.5,2.5],\"counts\":[4,5]}") == "ok:a,b:2,3:true,false:4,5:pair" && listText("{\"names\":[],\"lines\":[],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "ok:::::empty" && listText("{\"lines\":[],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: missing field names" && listText("{\"names\":[\"a\",1],\"lines\":[],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: wrong case at names.1" && listText("{\"names\":[null],\"lines\":[],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: wrong case at names.0" && listText("{\"names\":[],\"lines\":[{\"qty\":2},{\"qty\":true}],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: wrong case at lines.1.qty" && listText("{\"names\":[],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: missing field lines" && listText("{\"names\":null,\"lines\":[],\"flags\":[],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: wrong case at names" && listText("{\"names\":[\"a\"],\"lines\":[],\"flags\":[null],\"ratios\":[],\"counts\":[]}") == "error:Json.decode: wrong case at flags.0" && listText("{\"names\":[],\"lines\":[],\"flags\":[],\"ratios\":[1],\"counts\":[]}") == "error:Json.decode: wrong case at ratios.0" && listText("{\"names\":[],\"lines\":[],\"flags\":[],\"ratios\":[],\"counts\":[1,\"x\"]}") == "error:Json.decode: wrong case at counts.1"

def orderProof(): Bool =
  orderText("{\"name\":\"bolt\",\"item\":{\"quantity\":2},\"note\":\"ok\"}") == "ok:bolt:2:\"ok\"" && textOrder("{\"name\":\"bolt\",\"item\":{\"quantity\":2},\"note\":\"ok\"}") == "ok:bolt:2:\"ok\"" && saleText("{\"name\":\"bolt\",\"item\":{\"quantity\":2},\"note\":\"ok\"}") == "ok:bolt:2:\"ok\"" && orderText("{\"name\":\"bolt\",\"item\":{},\"note\":\"ok\"}") == "error:Json.decode: missing field item.quantity" && orderText("{\"name\":\"bolt\",\"item\":{\"quantity\":\"2\"},\"note\":\"ok\"}") == "error:Json.decode: wrong case at item.quantity" && orderText("{\"name\":\"bolt\",\"item\":{\"quantity\":2},\"note\":null}") == "ok:bolt:2:null" && orderText("{\"name\":\"bolt\",\"item\":null,\"note\":\"ok\"}") == "error:Json.decode: wrong case at item.quantity" && orderText("[]") == "error:Json.decode: wrong case at name" && orderText("{\"item\":{\"quantity\":2},\"note\":\"ok\"}") == "error:Json.decode: missing field name" && orderText("{\"name\":null,\"item\":{\"quantity\":2},\"note\":\"ok\"}") == "error:Json.decode: wrong case at name" && orderText("{\"name\":\"bolt\",\"item\":{\"quantity\":101},\"note\":null}") == "ok:bolt:101:null" && orderInRange("{\"name\":\"bolt\",\"item\":{\"quantity\":2},\"note\":null}") && !orderInRange("{\"name\":\"bolt\",\"item\":{\"quantity\":101},\"note\":null}") && flagOk("{\"on\":true,\"ratio\":1.5}") && !flagOk("{\"on\":true,\"ratio\":1}")

def decodeQuantity(text: String): Result[String, Quantity] =
  Json.parse(text) match {
    case Result.Ok(json) => Json.field(json, "quantity") match {
  case Result.Ok(Json.Int(n)) => quantity(n)
  case Result.Ok(_) => Result.Err("quantity must be an integer")
  case Result.Err(error) => Result.Err(error)
}
    case Result.Err(error) => Result.Err(error)
  }

def parsed(text: String): String =
  Str.parseInt(text) match {
    case Result.Ok(n) => s"ok:$n"
    case Result.Err(error) => s"error:$error"
  }

def accepted(result: Result[String, Quantity]): Bool =
  result match {
    case Result.Ok(_) => true
    case Result.Err(_) => false
  }

def proof(): Bool =
  parsed("9223372036854775807") == "ok:9223372036854775807" && parsed("-9223372036854775808") == "ok:-9223372036854775808" && parsed("+0007") == "ok:7" && parsed(Hex.decode("370078")) == "error:Str.parseInt: invalid integer" && parsed("9223372036854775808") == "error:Str.parseInt: out of range" && parsed("-9223372036854775809") == "error:Str.parseInt: out of range" && !accepted(parseQuantity("0")) && !accepted(parseQuantity("101")) && !accepted(parseQuantity(" 1")) && !accepted(decodeQuantity("{}")) && !accepted(decodeQuantity("[]")) && !accepted(decodeQuantity("{\"quantity\":null}")) && !accepted(decodeQuantity("{\"quantity\":\"1\"}")) && !accepted(decodeQuantity("{\"quantity\":1.0}")) && !accepted(decodeQuantity("{\"quantity\":101}")) && accepted(decodeQuantity("{\"quantity\":1}")) && accepted(parseQuantity("100")) && orderProof() && listProof()

def forward(text: String): Result[String, Int] =
  for {
    result = Str.parseInt(text)
  } yield result

def resolved(text: String): Int =
  for {
    result = forward(text)
    copied = result
  } yield copied match {
  case Result.Ok(n) => n
  case Result.Err(_) => -1
}

def attempt(flag: Bool): IO[Int] =
  for {
    result <- IO.attempt(if (flag) IO.pure(7) else IO.fail("input failure"))
  } yield result match {
  case Result.Ok(n) => n
  case Result.Err(_) => -1
}

def unitBind(flag: Bool): IO[Int] =
  for {
    () <- if (flag) IO.pure(()) else IO.fail("unit failure")
  } yield 7

