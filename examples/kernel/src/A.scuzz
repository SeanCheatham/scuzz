enum Msg:
  case Hi
  case Bye

record RemotePoint(x: Int, y: Int)

record RemoteMarker()

record RemoteBox[T](value: T)

record RemotePair[T](left: T, right: T)

type Tag = String
def one(): Int =
  1

private def hidden(): String =
  "a"

def tag(): String =
  labeled(hidden())

def labeled(t: Tag): Tag =
  t

def greet(): String =
  Msg.Hi match {
    case Msg.Hi => "hello-a"
    case Msg.Bye => "bye-a"
  }

