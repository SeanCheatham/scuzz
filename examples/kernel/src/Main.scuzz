    _ <- head match {
  case Color.Red => IO.println("adt:list:red")
  case Color.Blue => IO.println("adt:list:blue")
}
    _ <- Color.Red match {
  case Color.Red if false => IO.println("guard:skip")
  case Color.Red => IO.println("guard:hit")
  case Color.Blue => IO.println("guard:blue")
}
    _ <- IO.println(Str.concat("guard:", describePos(Opt.Some(3))))
    _ <- IO.println(Str.concat("guard:", describePos(Opt.Some(0))))
    _ <- IO.println(Str.concat("guard:", describePos(noneInt())))
    _ <- IO.println(Str.concat("lit:", describeNum(0)))
