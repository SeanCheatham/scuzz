    _ <- IO.println(Str.concat("or:", describeOptSmall(Opt.Some(0))))
    _ <- IO.println(Str.concat("or:either:", Str.fromInt(eitherNum(Either.Left(4)))))
    _ <- Color.Red match {
  case Color.Red | Color.Blue if false => IO.println("or:skip")
  case Color.Red | Color.Blue => IO.println("or:hit")
}
    _ <- IO.println(Str.concat("as:", keepSome(Opt.Some(42))))
    _ <- IO.println(Str.concat("as:", describeAsZero(Opt.Some(0))))
    _ <- IO.println(Str.concat("as:", describeAsHue(Color.Red)))
    _ <- Opt.Some(1) match {
  case s @ Opt.Some(n) => IO.println(Str.concat("as:both:", Str.fromInt(n)))
  case Opt.None => IO.println("as:none")
}
    _ <- 0 match {
  case 0 => IO.println("lit:hit0")
  case _ => IO.println("lit:miss0")
}
    packed = Pack.Of("a" :: "b" :: List.empty())
    _ <- packed match {
  case Pack.Of(ys) => IO.println(Str.concat("adt:box:", List.join(ys, ",")))
  case Pack.Empty => IO.println("adt:box:empty")
}
    _ <- IO.println(Str.concat("record:", Str.fromInt(sum(Point(3, 5))))).require(sumPositive).require(onePositive)
    _ <- IO.println(Point(3, 5).show())
    _ <- IO.println(Str.concat("get:", Str.fromInt(Point(3, 5).getOrElse(0))))
    b = Box(4)
    _ <- IO.println(Str.concat("show:", b.show()))
    _ <- IO.println(Str.concat("show:", Opt.Some(1).show()))
    _ <- IO.println(Str.concat("get:", Str.fromInt(Opt.Some(2).getOrElse(0))))
    _ <- IO.println(Str.concat(Str.fromInt(id(7)), id("ok")))
    _ <- IO.println(Str.concat("genum:some:", Str.fromInt(Opt.Some(3).getOrElse(0))))
    _ <- IO.println(Str.concat("genum:none:", Str.fromInt(noneInt().getOrElse(9))))
    wrapped = wrap(4)
