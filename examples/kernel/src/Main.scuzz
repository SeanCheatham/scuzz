enum Either[L, R]:
  case Left(x: L)
  case Right(y: R)

record Point(x: Int where x >= 0, y: Int where y + 1 > y && y * 2 > y && y % 2 < 2 && y == y)

type UserId = Int
type Labels = List[String]
type BoxList[T] = List[T]
trait Show:
  def show(): String

trait Get[T]:
  def getOrElse(default: T): T

impl Show for Point:
  def show(): String =
    Str.concat("Point(", Str.concat(Str.fromInt(self.x), Str.concat(",", Str.concat(Str.fromInt(self.y), ")"))))

impl Get[Int] for Point:
  def getOrElse(_default: Int): Int =
    self.x

impl Show for Box:
  def show(): String =
    "box"

impl Show for Opt:
  def show(): String =
    self match {
      case Opt.Some(x) => "some"
      case Opt.None => "none"
    }

impl Get[T] for Opt:
  def getOrElse(default: T): T =
    self match {
      case Opt.Some(x) => x
      case Opt.None => default
    }

import A.tag
import A.Msg
import A.one as fromA
import A.Tag

def id[T](x: T): T =
  x

def sum(p: Point): Int =
  p.x + p.y

def addDefault(n: Int, m: Int = 1): Int =
  n + m

def greet(name: String, punct: String = "!"): String =
  Str.concat(name, punct)

def idOf(n: UserId): UserId =
  n

def joinLabels(xs: Labels): String =
  List.join(xs, ",")

def lenBoxes(xs: BoxList[Int]): Int =
  List.len(xs)

def showTag(t: Tag): String =
  t

law sumPositive: Bool =
  sum(Point(3, 5)) > 0

law onePositive: Bool =
  fromA() > 0

law addComm(a: Int, b: Int): Bool =
  a + b == b + a

def noneInt(): Opt[Int] =
  Opt.None

def applyOptStr(f: Opt[Int] => String, o: Opt[Int]): String =
  f(o)

def applyIntStr(f: Int => String, n: Int): String =
  f(n)

def applyInt(f: Int => Int, n: Int): Int =
  f(n)

def plusOne(): Int => Int =
  (n: Int) => n + 1

def addN(n: Int): Int => Int =
  (m: Int) => n + m

def maybeYes(ok: Bool): IO[Unit] =
  if (ok) IO.println("ifone:fn")

def applyTwice(f: Int => String, n: Int): String =
  Str.concat(f(n), f(n))

def wrap[T](x: T): Box[T] =
  Box(x)

def leftOr[L, R](e: Either[L, R], fallback: L): L =
  e match {
    case Either.Left(x) => x
    case Either.Right(y) => fallback
  }

def describeEither(e: Either[Int, String]): String =
  e match {
    case Either.Left(n) => Str.fromInt(n)
    case Either.Right(s) => s
  }

def flip(c: Color): Color =
  c match {
    case Color.Red => Color.Blue
    case Color.Blue => Color.Red
  }

def describe(o: Opt[Int]): String =
  o match {
    case Opt.Some(n) => Str.concat("adt:describe:", Str.fromInt(n))
    case Opt.None => "adt:describe:none"
  }

def describeBare(o: Opt[Int]): String =
  o match {
    case Some(n) => Str.concat("bare:", Str.fromInt(n))
    case None => "bare:none"
  }

def hueBare(c: Color): String =
  c match {
    case Red | Blue => "barehue"
  }

def fromBare(n: Int): Opt[Int] =
  if (n > 0) Some(n) else None

def describePos(o: Opt[Int]): String =
  o match {
    case Opt.Some(n) if n > 0 => Str.concat("pos:", Str.fromInt(n))
    case Opt.Some(n) => Str.concat("nonpos:", Str.fromInt(n))
    case Opt.None => "none"
  }

def describeNum(n: Int): String =
  n match {
    case 0 => "zero"
    case 1 => "one"
    case _ => "other"
  }

def describeFlag(b: Bool): String =
  b match {
    case true => "yes"
    case false => "no"
  }

def describeWord(s: String): String =
  s match {
    case "ok" => "good"
    case _ => "bad"
  }

def describeOptZero(o: Opt[Int]): String =
  o match {
    case Opt.Some(0) => "some0"
    case Opt.Some(_) => "someN"
    case Opt.None => "none"
  }

def describeHue(c: Color): String =
  c match {
    case Color.Red | Color.Blue => "primary"
  }

def describeSmall(n: Int): String =
  n match {
    case 0 | 1 => "tiny"
    case _ => "big"
  }

def describeOptSmall(o: Opt[Int]): String =
  o match {
    case Opt.Some(0 | 1) => "opt01"
    case Opt.Some(_) => "optN"
    case Opt.None => "optNone"
  }

def keepSome(o: Opt[Int]): String =
  o match {
    case s @ Opt.Some(_) => describe(s)
    case Opt.None => "none"
  }

def describeAsZero(o: Opt[Int]): String =
  o match {
    case Opt.Some(n @ 0) => Str.concat("z:", Str.fromInt(n))
    case Opt.Some(_) => "n"
    case Opt.None => "none"
  }

def describeAsHue(c: Color): String =
  c match {
    case p @ Color.Red | Color.Blue => describeHue(p)
  }

def eitherNum(e: Either[Int, Int]): Int =
  e match {
    case Either.Left(n) | Either.Right(n) => n
  }

def greetFrom(m: Msg): String =
  m match {
    case Msg.Hi => "main-hi"
    case Msg.Bye => "main-bye"
  }

def scale(x: Float): Float =
  x * 2.0

def trunc(x: Float): Int =
  Float.toInt(x)

def mapSetProof(): IO[Unit] =
  for {
    mp = Map.set(Map.set(Map.empty(), "a", "1"), "b", "2")
    st = Set.add(Set.add(Set.empty(), "x"), "y")
    gone = Map.remove(mp, "b")
    dropped = Set.remove(st, "x")
    _ <- IO.println(s"map:${Map.getOrElse(mp, "a", "?")}")
    _ <- IO.println(s"miss:${Map.getOrElse(mp, "z", "no")}")
    _ <- IO.println(s"has:${if (Map.contains(mp, "b")) "y" else "n"}")
    _ <- IO.println(s"set:${if (Set.contains(st, "x")) "y" else "n"}")
    _ <- IO.println(s"keys:${List.join(Map.keys(mp), ",")}")
    _ <- IO.println(s"vals:${List.join(Map.values(mp), ",")}")
    _ <- IO.println(s"msize:${Map.size(mp)}")
    _ <- IO.println(s"gone:${if (Map.contains(gone, "b")) "y" else "n"}")
    _ <- IO.println(s"slist:${List.join(Set.toList(st), ",")}")
    _ <- IO.println(s"ssize:${Set.size(st)}")
    _ <- IO.println(s"sgone:${if (Set.contains(dropped, "x")) "y" else "n"}")
    _ <- IO.println(s"mempty:${if (Map.isEmpty(Map.empty())) "y" else "n"}")
    _ <- IO.println(s"sempty:${if (Set.isEmpty(Set.empty())) "y" else "n"}")
    _ <- IO.println(s"mne:${if (Map.nonEmpty(mp)) "y" else "n"}")
    _ <- IO.println(s"sne:${if (Set.nonEmpty(st)) "y" else "n"}")
    _ <- IO.println(s"mget:${List.join(Map.get(mp, "a"), ",")}")
    _ <- IO.println(s"mmiss:${List.join(Map.get(mp, "z"), ",")}")
    _ <- IO.println(s"union:${List.join(Set.toList(Set.union(st, Set.add(Set.empty(), "z"))), ",")}")
    _ <- IO.println(s"isect:${List.join(Set.toList(Set.intersect(st, Set.add(Set.add(Set.empty(), "y"), "z"))), ",")}")
    _ <- IO.println(s"sdiff:${List.join(Set.toList(Set.diff(st, Set.add(Set.add(Set.empty(), "y"), "z"))), ",")}")
    other = Map.set(Map.set(Map.empty(), "b", "9"), "c", "3")
    _ <- IO.println(s"munion:${List.join(Map.values(Map.union(mp, other)), ",")}")
    _ <- IO.println(s"misect:${List.join(Map.values(Map.intersect(mp, other)), ",")}")
    _ <- IO.println(s"mdiff:${List.join(Map.values(Map.diff(mp, other)), ",")}")
    _ <- IO.println(s"sub:${if (Set.isSubset(st, Set.union(st, Set.add(Set.empty(), "z")))) "y" else "n"}")
    _ <- IO.println(s"disj:${if (Set.isDisjoint(st, Set.add(Set.empty(), "z"))) "y" else "n"}")
    _ <- IO.println(s"mfil:${List.join(Map.values(Map.filter(mp, v => v != "2")), ",")}")
    _ <- IO.println(s"mmap:${List.join(Map.values(Map.mapValues(mp, v => Str.concat(v, "!"))), ",")}")
    _ <- IO.println(s"mex:${if (Map.exists(mp, v => v == "2")) "y" else "n"}")
    _ <- IO.println(s"mfa:${if (Map.forall(mp, v => v != "z")) "y" else "n"}")
    _ <- IO.println(s"sfil:${List.join(Set.toList(Set.filter(st, x => x != "y")), ",")}")
    _ <- IO.println(s"smap:${List.join(Set.toList(Set.map(st, x => Str.concat(x, "!"))), ",")}")
    _ <- IO.println(s"sex:${if (Set.exists(st, x => x == "x")) "y" else "n"}")
    _ <- IO.println(s"sfa:${if (Set.forall(st, x => x != "z")) "y" else "n"}")
    _ <- IO.println(s"tolist:${List.join(List.map(Map.toList(mp), (k, v) => s"$k:$v"), "|")}")
  } yield ()

def listProof(): IO[Unit] =
  for {
    xs = ["a", "b", "c"]
    _ <- IO.println(s"take:${List.join(List.take(xs, 2), ",")}")
    _ <- IO.println(s"drop:${List.join(List.drop(xs, 1), ",")}")
    _ <- IO.println(s"find:${List.join(List.find(xs, x => x == "b"), ",")}")
    _ <- IO.println(s"exists:${if (List.exists(xs, x => x == "c")) "y" else "n"}")
    _ <- IO.println(s"takeWhile:${List.join(List.takeWhile(xs, x => x != "b"), ",")}")
    _ <- IO.println(s"dropWhile:${List.join(List.dropWhile(xs, x => x != "b"), ",")}")
    _ <- IO.println(s"forall:${if (List.forall(xs, x => x != "z")) "y" else "n"}")
    _ <- IO.println(s"concat:${List.join(List.concat(["a"], ["b", "c"]), ",")}")
    xss = List.append(List.append(List.empty(), ["a"]), ["b", "c"])
    _ <- IO.println(s"flat:${List.join(List.flatten(xss), ",")}")
    _ <- IO.println(s"takeRight:${List.join(List.takeRight(xs, 2), ",")}")
    _ <- IO.println(s"dropRight:${List.join(List.dropRight(xs, 1), ",")}")
    _ <- IO.println(s"init:${List.join(List.init(xs), ",")}")
    _ <- IO.println(s"last:${List.join(List.last(xs), ",")}")
    _ <- IO.println(s"get:${List.getOrElse(xs, 1, "z")}")
    _ <- IO.println(s"miss:${List.getOrElse(xs, 9, "z")}")
    _ <- IO.println(s"fill:${List.join(List.fill(3, "a"), ",")}")
    _ <- IO.println(s"rev:${List.join(List.reverse(xs), ",")}")
    _ <- IO.println(s"count:${Str.fromInt(List.count(xs, x => x != "b"))}")
    _ <- IO.println(s"fnot:${List.join(List.filterNot(xs, x => x == "b"), ",")}")
    _ <- IO.println(s"llen:${Str.fromInt(List.len(xs))}")
    _ <- IO.println(s"head:${List.head(xs)}")
    _ <- IO.println(s"at:${List.at(xs, 1)}")
    _ <- IO.println(s"tail:${List.join(List.tail(xs), ",")}")
    _ <- IO.println(s"fmap:${List.join(List.flatMap(["a", "b"], x => [x, x]), ",")}")
    _ <- IO.println(s"padTo:${List.join(List.padTo(["a"], 3, "z"), ",")}")
    _ <- IO.println(s"nempty:${if (List.nonEmpty(xs)) "y" else "n"}")
    _ <- IO.println(s"range:${List.join(List.map(List.range(1, 4), n => Str.fromInt(n)), ",")}")
    _ <- IO.println(s"typedlam:${List.join(List.map(List.range(1, 4), (n: Int) => Str.fromInt(n)), ",")}")
    _ <- IO.println(s"phmap:${List.join(List.map(List.range(1, 4), Str.fromInt(_)), ",")}")
    _ <- IO.println(s"phadd:${List.join(List.map(List.map(List.range(1, 4), _ + 1), Str.fromInt(_)), ",")}")
    _ <- IO.println(s"phfilt:${List.join(List.filter(["a", "b", "c"], _ != "b"), ",")}")
    _ <- IO.println(s"phid:${List.join(List.map(["a", "b"], _), ",")}")
    _ <- IO.println(s"caselam:${List.join(List.map([Opt.Some(1), noneInt()], {
  case Opt.Some(n) => Str.fromInt(n)
  case Opt.None => "n"
}), ",")}")
    _ <- IO.println(s"caselambare:${List.join(List.map([Opt.Some(1), noneInt()], {
  case Some(n) => Str.fromInt(n)
  case None => "n"
}), ",")}")
    _ <- IO.println(s"caselam0:${List.join(List.map([]: List[Opt[Int]], {
  case Opt.Some(n) => Str.fromInt(n)
  case Opt.None => "n"
}), ",")}")
    _ <- IO.println(s"caselit:${List.join(List.map([0, 2], {
  case 0 => "z"
  case _ => "n"
}), ",")}")
    _ <- IO.println(s"funapply:${applyOptStr({
  case Opt.Some(n) => Str.fromInt(n)
  case Opt.None => "?"
}, Opt.Some(3))}")
    _ <- IO.println(s"funapplyN:${applyOptStr({
  case Opt.Some(n) => Str.fromInt(n)
  case Opt.None => "?"
}, noneInt())}")
    _ <- IO.println(s"funph:${applyIntStr(Str.fromInt(_), 1)}")
    _ <- IO.println(s"funtl:${applyIntStr((x: Int) => Str.fromInt(x), 2)}")
    _ <- IO.println(s"funadd:${Str.fromInt(applyInt(_ + 1, 3))}")
    _ <- IO.println(s"funtwice:${applyTwice(Str.fromInt(_), 1)}")
    _ <- IO.println(s"funeta:${applyIntStr(Str.fromInt(), 1)}")
    _ <- IO.println(s"mapeta:${List.join(List.map([1, 2], Str.fromInt()), ",")}")
    _ <- IO.println(s"mapeta0:${List.join(List.map([]: List[Int], Str.fromInt()), ",")}")
    _ <- IO.println(s"usereta:${Str.fromInt(applyInt(id, 3))}")
    inc = (_ + 1): Int => Int
    typed = (n: Int) => n + 1
    eta = Str.fromInt(): Int => String
    po = plusOne()
    add3 = addN(3)
    _ <- IO.println(s"funlet:${Str.fromInt(inc(3))}")
    _ <- IO.println(s"funtyped:${Str.fromInt(typed(4))}")
    _ <- IO.println(s"funret:${Str.fromInt(po(5))}")
    _ <- IO.println(s"funcap:${Str.fromInt(add3(4))}")
    _ <- IO.println(s"funpass:${Str.fromInt(applyInt(inc, 5))}")
    _ <- IO.println(s"funpass0:${Str.fromInt(applyInt(plusOne(), 6))}")
    _ <- IO.println(s"funmap:${List.join(List.map([1, 2], eta), ",")}")
    _ <- IO.println(s"funmap0:${List.join(List.map([]: List[Int], eta), ",")}")
    _ <- IO.println(s"funapp:${Str.fromInt(plusOne()(5))}")
    _ <- IO.println(s"funcurry:${Str.fromInt(addN(3)(4))}")
    _ <- IO.println(s"funlit:${Str.fromInt(((n: Int) => n + 1)(6))}")
    _ <- IO.println(s"fungrp:${Str.fromInt(inc(3))}")
    _ <- IO.println(s"funphapp:${Str.fromInt((_ + 1)(8))}")
    _ <- maybeYes(true)
    _ <- maybeYes(false)
    _ <- if (true) IO.println("ifone:y")
    _ <- if (false) IO.println("ifone:skip")
    _ = if (true) ()
    _ <- IO.println(s"tab:${List.join(List.tabulate(3, i => Str.fromInt(i)), ",")}")
    _ <- IO.println(s"isp:${List.join(List.intersperse(xs, "|"), ",")}")
    _ <- IO.println(s"grp:${List.join(List.map(List.grouped(xs, 2), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"sld:${List.join(List.map(List.sliding(xs, 2), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"lslice:${List.join(List.slice(xs, 1, 3), ",")}")
    _ <- IO.println(s"ixw:${Str.fromInt(List.indexWhere(xs, x => x == "b"))}")
    _ <- IO.println(s"lixw:${Str.fromInt(List.lastIndexWhere(xs, x => x != "z"))}")
    _ <- IO.println(s"ixs:${List.join(List.map(List.indices(xs), n => Str.fromInt(n)), ",")}")
    _ <- IO.println(s"sat:${List.join(List.map(List.splitAt(xs, 1), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"span:${List.join(List.map(List.span(xs, x => x != "c"), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"part:${List.join(List.map(List.partition(xs, x => x == "b"), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"inits:${List.join(List.map(List.inits(xs), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"tails:${List.join(List.map(List.tails(xs), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"zip:${List.join(List.map(List.zip(xs, ["1", "2"]), (a, b) => s"$a,$b"), "|")}")
    _ <- IO.println(s"zipAll:${List.join(List.map(List.zipAll(xs, ["1"], "z", "9"), (a, b) => s"$a,$b"), "|")}")
    (uzA, uzB) = List.unzip(List.zip(xs, ["1", "2"]))
    _ <- IO.println(s"unzip:${List.join([List.join(uzA, ","), List.join(uzB, ",")], "|")}")
    _ <- IO.println(s"zipN:${List.join(List.map(List.zip([1, 2], ["a", "b"]), (n, s) => s"${Str.fromInt(n)},$s"), "|")}")
    _ <- IO.println(s"zix:${List.join(List.map(List.zipWithIndex(xs), (i, s) => s"${Str.fromInt(i)},$s"), "|")}")
    _ <- IO.println(s"fold:${Str.fromInt(List.foldLeft([1, 2, 3], 0, (acc, n) => acc + n))}")
    _ <- IO.println(s"foldL:${List.foldLeft(["a", "b"], "!", (acc, x) => Str.concat(acc, x))}")
    _ <- IO.println(s"foldR:${List.foldRight(["a", "b"], "!", (x, acc) => Str.concat(x, acc))}")
    _ <- IO.println(s"scanL:${List.join(List.map(List.scanLeft([1, 2, 3], 0, (acc, n) => acc + n), Str.fromInt(_)), ",")}")
    _ <- IO.println(s"scanR:${List.join(List.map(List.scanRight([1, 2, 3], 0, (n, acc) => n + acc), Str.fromInt(_)), ",")}")
    _ <- IO.println(s"scanS:${List.join(List.scanLeft(["a", "b"], "!", (acc, x) => Str.concat(acc, x)), "|")}")
    _ <- IO.println(s"scanSR:${List.join(List.scanRight(["a", "b"], "!", (x, acc) => Str.concat(x, acc)), "|")}")
    _ <- IO.println(s"scan0:${List.join(List.map(List.scanLeft([]: List[Int], 7, (acc, n) => acc + n), Str.fromInt(_)), ",")}")
    _ <- IO.println(s"red:${Str.fromInt(List.reduceLeft([1, 2, 3], (acc, n) => acc + n))}")
    _ <- IO.println(s"redL:${List.reduceLeft(["a", "b"], (acc, x) => Str.concat(acc, x))}")
    _ <- IO.println(s"redR:${List.reduceRight(["a", "b"], (x, acc) => Str.concat(x, acc))}")
    _ <- IO.println(s"tr:${List.join(List.map(List.transpose([["a", "b"], ["c", "d"]]), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"lhas:${if (List.contains(xs, "b")) "y" else "n"}")
    _ <- IO.println(s"lix:${Str.fromInt(List.indexOf(xs, "b"))}")
    _ <- IO.println(s"llix:${Str.fromInt(List.lastIndexOf(["a", "b", "a"], "a"))}")
    _ <- IO.println(s"uniq:${List.join(List.distinct(["a", "b", "a", "c"]), ",")}")
    _ <- IO.println(s"dby:${List.join(List.distinctBy(["aa", "b", "cc", "d"], x => Str.len(x)), ",")}")
    _ <- IO.println(s"dby0:${List.join(List.distinctBy([]: List[String], x => x), ",")}")
    _ <- IO.println(s"tomap:${Map.getOrElse(List.toMap([("a", "1"), ("b", "2")]), "a", "?")}")
    _ <- IO.println(s"tomapN:${Map.getOrElse(List.toMap([("a", "1"), ("a", "9")]), "a", "?")}")
    _ <- IO.println(s"tomap0:${Map.size(List.toMap([]: List[(String, Int)]))}")
    _ <- IO.println(s"toset:${List.join(Set.toList(List.toSet(["b", "a", "b"])), ",")}")
    _ <- IO.println(s"tosetN:${List.join(List.map(Set.toList(List.toSet([2, 1, 2])), Str.fromInt(_)), ",")}")
    _ <- IO.println(s"ldiff:${List.join(List.diff(xs, ["a", "z"]), ",")}")
    _ <- IO.println(s"lisect:${List.join(List.intersect(xs, ["a", "z"]), ",")}")
    _ <- IO.println(s"nhas:${if (List.contains(List.range(1, 4), 2)) "y" else "n"}")
    _ <- IO.println(s"ixslice:${Str.fromInt(List.indexOfSlice(["a", "b", "a", "b"], ["a", "b"]))}")
    _ <- IO.println(s"lixslice:${Str.fromInt(List.lastIndexOfSlice(["a", "b", "a", "b"], ["a", "b"]))}")
    _ <- IO.println(s"seglen:${Str.fromInt(List.segmentLength(["a", "a", "b"], x => x == "a", 0))}")
    _ <- IO.println(s"defat:${if (List.isDefinedAt(xs, 1)) "y" else "n"}")
    _ <- IO.println(s"lcmp:${Str.fromInt(List.lengthCompare(xs, 3))}")
    _ <- IO.println(s"sort:${List.join(List.sort(["c", "a", "b"]), ",")}")
    _ <- IO.println(s"sortn:${List.join(List.map(List.sort([3, 1, 2]), n => Str.fromInt(n)), ",")}")
    _ <- IO.println(s"sortBy:${List.join(List.sortBy(["bb", "a", "ccc"], x => Str.len(x)), ",")}")
    _ <- IO.println(s"max:${List.max(["a", "c", "b"])}")
    _ <- IO.println(s"min:${List.min(["a", "c", "b"])}")
    _ <- IO.println(s"maxn:${Str.fromInt(List.max([1, 3, 2]))}")
    _ <- IO.println(s"maxBy:${List.maxBy(["bb", "a", "ccc"], x => Str.len(x))}")
    _ <- IO.println(s"minBy:${List.minBy(["bb", "a", "ccc"], x => Str.len(x))}")
    g = List.groupBy(["aa", "b", "cc"], x => Str.len(x))
    _ <- IO.println(s"gbyk:${List.join(List.map(Map.keys(g), n => Str.fromInt(n)), ",")}")
    _ <- IO.println(s"gbyv:${List.join(List.map(Map.values(g), row => List.join(row, ":")), "|")}")
    _ <- IO.println(s"gbys:${List.join(Map.keys(List.groupBy(["ab", "ac", "b"], x => Str.take(x, 1))), ",")}")
    _ <- IO.println(s"sum:${Str.fromInt(List.sum([1, 2, 3]))}")
    _ <- IO.println(s"prod:${Str.fromInt(List.product([2, 3, 4]))}")
    _ <- IO.println(s"lpat:${describeList(["a", "b"])}")
    _ <- IO.println(s"lpat0:${describeList([])}")
    _ <- IO.println(s"lpat1:${describeList(["z"])}")
    _ <- IO.println(s"lpati:${describeInts([1, 2])}")
    _ <- IO.println(s"cons:${List.join(consPair("a", "b"), ",")}")
    _ <- IO.println(s"npat:${originX(Point(3, 5))}")
    _ <- IO.println(s"npaty:${namedY(Point(3, 5))}")
    _ <- IO.println(s"npatopt:${namedSome(Opt.Some(8))}")
  } yield ()

def describeList(xs: List[String]): String =
  xs match {
    case [] => "empty"
    case [x] => Str.concat("one:", x)
    case x :: y :: _ => Str.concat("more:", Str.concat(x, y))
  }

def describeInts(xs: List[Int]): String =
  xs match {
    case [] => "none"
    case n :: _ => Str.fromInt(n)
  }

def originX(p: Point): Int =
  p match {
    case Point(x = n) => n
  }

def namedY(p: Point): Int =
  p match {
    case Point(y = n) => n
  }

def namedSome(o: Opt[Int]): Int =
  o match {
    case Opt.Some(x = n) => n
    case Opt.None => 0
  }

def consPair(a: String, b: String): List[String] =
  a :: b :: List.empty()

def strProof(): IO[Unit] =
  for {
    _ <- IO.println(s"contains:${if (Str.contains("ab", "b")) "y" else "n"}")
    _ <- IO.println(s"ends:${if (Str.endsWith("ab", "b")) "y" else "n"}")
    _ <- IO.println(s"toInt:${Str.toInt("7", 0)}")
    _ <- IO.println(s"miss:${Str.toInt("x", 9)}")
    _ <- IO.println(s"repl:${Str.replace("a-b", "-", ":")}")
    _ <- IO.println(s"split:${List.join(Str.split("a,b", ","), ":")}")
    _ <- IO.println(s"empty:${if (Str.isEmpty("")) "y" else "n"}")
    _ <- IO.println(s"strne:${if (Str.nonEmpty("a")) "y" else "n"}")
    _ <- IO.println(s"lower:${Str.toLower("Ab")}")
    _ <- IO.println(s"upper:${Str.toUpper("Ab")}")
    _ <- IO.println(s"cap:${Str.capitalize("hello")}")
    _ <- IO.println(s"repeat:${Str.repeat("a", 3)}")
    _ <- IO.println(s"strip:${Str.stripPrefix("abc", "a")}")
    _ <- IO.println(s"suffix:${Str.stripSuffix("abc", "c")}")
    _ <- IO.println(s"padL:${Str.padLeft("a", 3, "x")}")
    _ <- IO.println(s"padR:${Str.padRight("a", 3, "x")}")
    _ <- IO.println(s"blank:${if (Str.isBlank(" \t")) "y" else "n"}")
    _ <- IO.println(s"lix:${Str.lastIndexOf("ababa", "ba")}")
    _ <- IO.println(s"take:${Str.take("abc", 2)}")
    _ <- IO.println(s"drop:${Str.drop("abc", 1)}")
    _ <- IO.println(s"takeR:${Str.takeRight("abc", 2)}")
    _ <- IO.println(s"dropR:${Str.dropRight("abc", 1)}")
    _ <- IO.println(s"srev:${Str.reverse("abc")}")
    _ <- IO.println(s"slen:${Str.fromInt(Str.len("abc"))}")
    _ <- IO.println(s"slice:${Str.slice("abc", 1, 3)}")
    _ <- IO.println(s"ix:${Str.fromInt(Str.indexOf("ababa", "ba"))}")
    _ <- IO.println(s"ch:${Str.fromInt(Str.charAt("abc", 1))}")
    _ <- IO.println(s"lines:${List.join(Str.lines("""a
b"""), ",")}")
  } yield ()

def swap[A, B](p: (A, B)): (B, A) =
  p match {
    case (a, b) => (b, a)
  }

def rot3(t: (Int, String, Bool)): (String, Bool, Int) =
  t match {
    case (a, b, c) => (b, c, a)
  }

def firsts(xs: List[(Int, String)]): List[Int] =
  List.map(xs, (n, _) => n)

def unpackProof(): IO[Unit] =
  for {
    Point(x, y) = Point(3, 5)
    Opt.Some(n) = Opt.Some(7)
    Some(k) = Opt.Some(6)
    h :: _t = [8, 9]
    got <- IO.pure(Opt.Some(4))
    Opt.Some(m) = got
    xs = List.map([Opt.Some(1), Opt.Some(2)], (Opt.Some(k)) => k)
    _ <- IO.println(s"unpack:${Str.fromInt(x + y)}")
    _ <- IO.println(s"unpackSome:${Str.fromInt(n)}")
    _ <- IO.println(s"unpackBare:${Str.fromInt(k)}")
    _ <- IO.println(s"unpackCons:${Str.fromInt(h)}")
    _ <- IO.println(s"unpackDraw:${Str.fromInt(m)}")
    _ <- IO.println(s"unpackLam:${Str.fromInt(List.head(xs))}")
  } yield ()

def choose(ok: Bool): IO[Int] =
  if (ok) IO.pure(7) else IO.fail("nope")

def positive(n: Int): IO[Int] =
  for {
    x <- IO.pure(n)
    if x > 0
  } yield x

def failProof(): IO[Unit] =
  for {
    n <- choose(true)
    _ <- IO.println(s"failif:${Str.fromInt(n)}")
    _ <- choose(false).handleErrorWith(_ =>
  IO.println("failif:miss")
)
    p <- positive(3)
    _ <- IO.println(s"forif:${Str.fromInt(p)}")
    _ <- positive(0).handleErrorWith(_ =>
  IO.println("forif:miss")
)
  } yield ()

def mapProof(): IO[Unit] =
  for {
    n <- IO.pure(3).map(x => x + 1)
    s <- IO.pure("a").map(x => Str.concat(x, "!"))
    z <- IO.pure(1).map(_ => 7)
    o <- IO.pure(Opt.Some(1)).map({
  case Opt.Some(n) => n
  case Opt.None => 0
})
    _ <- IO.println(s"iomap:${Str.fromInt(n)}")
    _ <- IO.println(s"iomapS:$s")
    _ <- IO.println(s"iomapU:${Str.fromInt(z)}")
    _ <- IO.println(s"caseio:${Str.fromInt(o)}")
  } yield ()

def tupleProof(): IO[Unit] =
  for {
    (n, s) = (42, "ok")
    q = swap((n, s))
    (_, bothS) <- IO.both(IO.pure(1), IO.pure("x"))
    _ <- IO.println(s"tup:$n")
    _ <- IO.println(s"tup:$s")
    _ <- q match {
  case (a, m) => IO.println(s"swap:$a:$m")
}
    _ <- IO.println(s"eqTup:${if ((n, s) == (42, "ok") && (1, "x") != (2, "x")) "y" else "n"}")
    _ <- IO.println(s"both:$bothS")
    _ <- IO.println(s"first:${Str.fromInt(List.head(firsts([(9, "z")])))}")
    (tn, ts, tok) = (1, "x", true)
    r3 = rot3((tn, ts, tok))
    _ <- IO.println(s"tri:${Str.fromInt(tn)}")
    _ <- IO.println(s"tri:$ts")
    _ <- IO.println(s"tri:${if (tok) "y" else "n"}")
    _ <- IO.println(s"rot:${r3._1}")
    _ <- IO.println(s"rot:${Str.fromInt(r3._3)}")
  } yield ()

def eqProof(): IO[Unit] =
  for {
    xs = ["a", "b"]
    ys = ["a", "b"]
    zs = ["a", "c"]
    mp = Map.set(Map.set(Map.empty(), "a", "1"), "b", "2")
    mp2 = Map.set(Map.set(Map.empty(), "b", "2"), "a", "1")
    other = Map.set(Map.empty(), "z", "9")
    st = Set.add(Set.add(Set.empty(), "x"), "y")
    st2 = Set.add(Set.add(Set.empty(), "y"), "x")
    stz = Set.add(Set.empty(), "z")
    o1 = Opt.Some(1)
    o2 = Opt.Some(1)
    none = Opt.None: Opt[Int]
    p1 = Point(3, 5)
    p2 = Point(3, 5)
    _ <- IO.println(s"eqStr:${if ("ab" == "ab" && "ab" != "c") "y" else "n"}")
    _ <- IO.println(s"eqList:${if (xs == ys && xs != zs) "y" else "n"}")
    _ <- IO.println(s"eqAdt:${if (Color.Red == Color.Red && Color.Red != Color.Blue) "y" else "n"}")
    _ <- IO.println(s"eqOpt:${if (o1 == o2 && o1 != none) "y" else "n"}")
    _ <- IO.println(s"eqRec:${if (p1 == p2 && p1 != Point(3, 6)) "y" else "n"}")
    _ <- IO.println(s"eqMap:${if (mp == mp2 && mp != other) "y" else "n"}")
    _ <- IO.println(s"eqSet:${if (st == st2 && st != stz) "y" else "n"}")
    _ <- IO.println(s"eqNest:${if (Opt.Some(o1) == Opt.Some(o2)) "y" else "n"}")
  } yield ()

record Box[T](x: T):
  def get(): T =
    self.x

@main def main: IO[Unit] =
  for {
    c = Color.Red
    o = Opt.Some(42)
