enum Either[L, R]:
  case Left(x: L)
  case Right(y: R)

record Point(x: Int where x >= 0, y: Int where y + 1 > y && y * 2 > y && y % 2 < 2 && y == y)

trait Show:
  def show(): String

trait Get[T]:
  def getOrElse(default: T): T

impl Show for Point:
  def show(): String =
    Str.concat("Point(", Str.concat(Str.fromInt(self.x), Str.concat(",", Str.concat(Str.fromInt(self.y), ")"))))

impl Get[Int] for Point:
  def getOrElse(default: Int): Int =
    self.x

impl Show for Box:
  def show(): String =
    "box"

impl Show for Opt:
  def show(): String =
    self match {
      case Opt.Some(x) => "some"
      case Opt.None => "none"
    }

impl Get[T] for Opt:
  def getOrElse(default: T): T =
    self match {
      case Opt.Some(x) => x
      case Opt.None => default
    }

import A.tag
import A.Msg
import A.one

def id[T](x: T): T =
  x

def sum(p: Point): Int =
  p.x + p.y

law sumPositive: Bool =
  sum(Point(3, 5)) > 0

law onePositive: Bool =
  one() > 0

law addComm(a: Int, b: Int): Bool =
  a + b == b + a

def noneInt(): Opt[Int] =
  Opt.None

def wrap[T](x: T): Box[T] =
  Box(x)

def leftOr[L, R](e: Either[L, R], fallback: L): L =
  e match {
    case Either.Left(x) => x
    case Either.Right(y) => fallback
  }

def describeEither(e: Either[Int, String]): String =
  e match {
    case Either.Left(n) => Str.fromInt(n)
    case Either.Right(s) => s
  }

def flip(c: Color): Color =
  c match {
    case Color.Red => Color.Blue
    case Color.Blue => Color.Red
  }

def describe(o: Opt[Int]): String =
  o match {
    case Opt.Some(n) => Str.concat("adt:describe:", Str.fromInt(n))
    case Opt.None => "adt:describe:none"
  }

def greetFrom(m: Msg): String =
  m match {
    case Msg.Hi => "main-hi"
    case Msg.Bye => "main-bye"
  }

def scale(x: Float): Float =
  x * 2.0

def trunc(x: Float): Int =
  Float.toInt(x)

def mapSetProof(): IO[Unit] =
  for {
    mp = Map.set(Map.set(Map.empty(), "a", "1"), "b", "2")
    st = Set.add(Set.add(Set.empty(), "x"), "y")
    gone = Map.remove(mp, "b")
    dropped = Set.remove(st, "x")
    _ <- IO.println(s"map:${Map.getOrElse(mp, "a", "?")}")
    _ <- IO.println(s"miss:${Map.getOrElse(mp, "z", "no")}")
    _ <- IO.println(s"has:${if (Map.contains(mp, "b")) "y" else "n"}")
    _ <- IO.println(s"set:${if (Set.contains(st, "x")) "y" else "n"}")
    _ <- IO.println(s"keys:${List.join(Map.keys(mp), ",")}")
    _ <- IO.println(s"vals:${List.join(Map.values(mp), ",")}")
    _ <- IO.println(s"msize:${Map.size(mp)}")
    _ <- IO.println(s"gone:${if (Map.contains(gone, "b")) "y" else "n"}")
    _ <- IO.println(s"slist:${List.join(Set.toList(st), ",")}")
    _ <- IO.println(s"ssize:${Set.size(st)}")
    _ <- IO.println(s"sgone:${if (Set.contains(dropped, "x")) "y" else "n"}")
    _ <- IO.println(s"mempty:${if (Map.isEmpty(Map.empty())) "y" else "n"}")
    _ <- IO.println(s"sempty:${if (Set.isEmpty(Set.empty())) "y" else "n"}")
    _ <- IO.println(s"mne:${if (Map.nonEmpty(mp)) "y" else "n"}")
    _ <- IO.println(s"sne:${if (Set.nonEmpty(st)) "y" else "n"}")
    _ <- IO.println(s"mget:${List.join(Map.get(mp, "a"), ",")}")
    _ <- IO.println(s"mmiss:${List.join(Map.get(mp, "z"), ",")}")
    _ <- IO.println(s"union:${List.join(Set.toList(Set.union(st, Set.add(Set.empty(), "z"))), ",")}")
    _ <- IO.println(s"isect:${List.join(Set.toList(Set.intersect(st, Set.add(Set.add(Set.empty(), "y"), "z"))), ",")}")
    _ <- IO.println(s"sdiff:${List.join(Set.toList(Set.diff(st, Set.add(Set.add(Set.empty(), "y"), "z"))), ",")}")
    other = Map.set(Map.set(Map.empty(), "b", "9"), "c", "3")
    _ <- IO.println(s"munion:${List.join(Map.values(Map.union(mp, other)), ",")}")
    _ <- IO.println(s"misect:${List.join(Map.values(Map.intersect(mp, other)), ",")}")
    _ <- IO.println(s"mdiff:${List.join(Map.values(Map.diff(mp, other)), ",")}")
    _ <- IO.println(s"sub:${if (Set.isSubset(st, Set.union(st, Set.add(Set.empty(), "z")))) "y" else "n"}")
    _ <- IO.println(s"disj:${if (Set.isDisjoint(st, Set.add(Set.empty(), "z"))) "y" else "n"}")
  } yield ()

def listProof(): IO[Unit] =
  for {
    xs = ["a", "b", "c"]
    _ <- IO.println(s"take:${List.join(List.take(xs, 2), ",")}")
    _ <- IO.println(s"drop:${List.join(List.drop(xs, 1), ",")}")
    _ <- IO.println(s"find:${List.join(List.find(xs, x => x == "b"), ",")}")
    _ <- IO.println(s"exists:${if (List.exists(xs, x => x == "c")) "y" else "n"}")
    _ <- IO.println(s"takeWhile:${List.join(List.takeWhile(xs, x => x != "b"), ",")}")
    _ <- IO.println(s"dropWhile:${List.join(List.dropWhile(xs, x => x != "b"), ",")}")
    _ <- IO.println(s"forall:${if (List.forall(xs, x => x != "z")) "y" else "n"}")
    _ <- IO.println(s"concat:${List.join(List.concat(["a"], ["b", "c"]), ",")}")
    xss = List.append(List.append(List.empty(), ["a"]), ["b", "c"])
    _ <- IO.println(s"flat:${List.join(List.flatten(xss), ",")}")
    _ <- IO.println(s"takeRight:${List.join(List.takeRight(xs, 2), ",")}")
    _ <- IO.println(s"dropRight:${List.join(List.dropRight(xs, 1), ",")}")
    _ <- IO.println(s"init:${List.join(List.init(xs), ",")}")
    _ <- IO.println(s"last:${List.join(List.last(xs), ",")}")
    _ <- IO.println(s"get:${List.getOrElse(xs, 1, "z")}")
    _ <- IO.println(s"miss:${List.getOrElse(xs, 9, "z")}")
    _ <- IO.println(s"fill:${List.join(List.fill(3, "a"), ",")}")
    _ <- IO.println(s"rev:${List.join(List.reverse(xs), ",")}")
    _ <- IO.println(s"count:${Str.fromInt(List.count(xs, x => x != "b"))}")
    _ <- IO.println(s"fnot:${List.join(List.filterNot(xs, x => x == "b"), ",")}")
    _ <- IO.println(s"llen:${Str.fromInt(List.len(xs))}")
    _ <- IO.println(s"head:${List.head(xs)}")
    _ <- IO.println(s"at:${List.at(xs, 1)}")
    _ <- IO.println(s"tail:${List.join(List.tail(xs), ",")}")
    _ <- IO.println(s"fmap:${List.join(List.flatMap(["a", "b"], x => [x, x]), ",")}")
    _ <- IO.println(s"padTo:${List.join(List.padTo(["a"], 3, "z"), ",")}")
    _ <- IO.println(s"nempty:${if (List.nonEmpty(xs)) "y" else "n"}")
    _ <- IO.println(s"range:${List.join(List.map(List.range(1, 4), n => Str.fromInt(n)), ",")}")
    _ <- IO.println(s"tab:${List.join(List.tabulate(3, i => Str.fromInt(i)), ",")}")
    _ <- IO.println(s"isp:${List.join(List.intersperse(xs, "|"), ",")}")
    _ <- IO.println(s"grp:${List.join(List.map(List.grouped(xs, 2), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"sld:${List.join(List.map(List.sliding(xs, 2), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"lslice:${List.join(List.slice(xs, 1, 3), ",")}")
    _ <- IO.println(s"ixw:${Str.fromInt(List.indexWhere(xs, x => x == "b"))}")
    _ <- IO.println(s"lixw:${Str.fromInt(List.lastIndexWhere(xs, x => x != "z"))}")
    _ <- IO.println(s"ixs:${List.join(List.map(List.indices(xs), n => Str.fromInt(n)), ",")}")
    _ <- IO.println(s"sat:${List.join(List.map(List.splitAt(xs, 1), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"span:${List.join(List.map(List.span(xs, x => x != "c"), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"part:${List.join(List.map(List.partition(xs, x => x == "b"), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"inits:${List.join(List.map(List.inits(xs), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"tails:${List.join(List.map(List.tails(xs), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"zip:${List.join(List.map(List.zip(xs, ["1", "2"]), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"zipAll:${List.join(List.map(List.zipAll(xs, ["1"], "z", "9"), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"unzip:${List.join(List.map(List.unzip(List.zip(xs, ["1", "2"])), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"tr:${List.join(List.map(List.transpose([["a", "b"], ["c", "d"]]), g => List.join(g, ",")), "|")}")
    _ <- IO.println(s"lhas:${if (List.contains(xs, "b")) "y" else "n"}")
    _ <- IO.println(s"lix:${Str.fromInt(List.indexOf(xs, "b"))}")
    _ <- IO.println(s"llix:${Str.fromInt(List.lastIndexOf(["a", "b", "a"], "a"))}")
    _ <- IO.println(s"uniq:${List.join(List.distinct(["a", "b", "a", "c"]), ",")}")
    _ <- IO.println(s"ldiff:${List.join(List.diff(xs, ["a", "z"]), ",")}")
    _ <- IO.println(s"lisect:${List.join(List.intersect(xs, ["a", "z"]), ",")}")
    _ <- IO.println(s"nhas:${if (List.contains(List.range(1, 4), 2)) "y" else "n"}")
    _ <- IO.println(s"ixslice:${Str.fromInt(List.indexOfSlice(["a", "b", "a", "b"], ["a", "b"]))}")
    _ <- IO.println(s"lixslice:${Str.fromInt(List.lastIndexOfSlice(["a", "b", "a", "b"], ["a", "b"]))}")
    _ <- IO.println(s"seglen:${Str.fromInt(List.segmentLength(["a", "a", "b"], x => x == "a", 0))}")
    _ <- IO.println(s"defat:${if (List.isDefinedAt(xs, 1)) "y" else "n"}")
    _ <- IO.println(s"lcmp:${Str.fromInt(List.lengthCompare(xs, 3))}")
  } yield ()

def strProof(): IO[Unit] =
  for {
    _ <- IO.println(s"contains:${if (Str.contains("ab", "b")) "y" else "n"}")
    _ <- IO.println(s"ends:${if (Str.endsWith("ab", "b")) "y" else "n"}")
    _ <- IO.println(s"toInt:${Str.toInt("7", 0)}")
    _ <- IO.println(s"miss:${Str.toInt("x", 9)}")
    _ <- IO.println(s"repl:${Str.replace("a-b", "-", ":")}")
    _ <- IO.println(s"split:${List.join(Str.split("a,b", ","), ":")}")
    _ <- IO.println(s"empty:${if (Str.isEmpty("")) "y" else "n"}")
    _ <- IO.println(s"strne:${if (Str.nonEmpty("a")) "y" else "n"}")
    _ <- IO.println(s"lower:${Str.toLower("Ab")}")
    _ <- IO.println(s"upper:${Str.toUpper("Ab")}")
    _ <- IO.println(s"cap:${Str.capitalize("hello")}")
    _ <- IO.println(s"repeat:${Str.repeat("a", 3)}")
    _ <- IO.println(s"strip:${Str.stripPrefix("abc", "a")}")
    _ <- IO.println(s"suffix:${Str.stripSuffix("abc", "c")}")
    _ <- IO.println(s"padL:${Str.padLeft("a", 3, "x")}")
    _ <- IO.println(s"padR:${Str.padRight("a", 3, "x")}")
    _ <- IO.println(s"blank:${if (Str.isBlank(" \t")) "y" else "n"}")
    _ <- IO.println(s"lix:${Str.lastIndexOf("ababa", "ba")}")
    _ <- IO.println(s"take:${Str.take("abc", 2)}")
    _ <- IO.println(s"drop:${Str.drop("abc", 1)}")
    _ <- IO.println(s"takeR:${Str.takeRight("abc", 2)}")
    _ <- IO.println(s"dropR:${Str.dropRight("abc", 1)}")
    _ <- IO.println(s"srev:${Str.reverse("abc")}")
    _ <- IO.println(s"slen:${Str.fromInt(Str.len("abc"))}")
    _ <- IO.println(s"slice:${Str.slice("abc", 1, 3)}")
    _ <- IO.println(s"ix:${Str.fromInt(Str.indexOf("ababa", "ba"))}")
    _ <- IO.println(s"ch:${Str.fromInt(Str.charAt("abc", 1))}")
    _ <- IO.println(s"lines:${List.join(Str.lines("a\nb"), ",")}")
  } yield ()

record Box[T](x: T):
  def get(): T =
    self.x

@main def main: IO[Unit] =
  for {
    c = Color.Red
    o = Opt.Some(42)
    p = Pair.Pair(7, "ok")
    flipped = flip(c)
    desc = describe(o)
    xs = List.cons(Color.Blue, List.empty())
    head = List.head(xs)
    _ <- c match {
  case Color.Red => IO.println("adt:red")
  case Color.Blue => IO.println("adt:blue")
}
    _ <- o match {
  case Opt.Some(n) => IO.println(Str.concat("adt:some:", Str.fromInt(n)))
  case Opt.None => IO.println("adt:none")
}
    _ <- p match {
  case Pair(x, y) => IO.println(Str.concat(Str.concat("adt:pair:", Str.fromInt(x)), Str.concat(":", y)))
}
    _ <- flipped match {
  case Color.Red => IO.println("adt:flip:red")
  case Color.Blue => IO.println("adt:flip:blue")
}
    _ <- IO.println(desc)
    _ <- head match {
  case Color.Red => IO.println("adt:list:red")
  case Color.Blue => IO.println("adt:list:blue")
}
    packed = Pack.Of(List.cons("a", List.cons("b", List.empty())))
    _ <- packed match {
  case Pack.Of(ys) => IO.println(Str.concat("adt:box:", List.join(ys, ",")))
  case Pack.Empty => IO.println("adt:box:empty")
}
    _ <- IO.println(Str.concat("record:", Str.fromInt(sum(Point(3, 5))))).require(sumPositive).require(onePositive)
    _ <- IO.println(Point(3, 5).show())
    _ <- IO.println(Str.concat("get:", Str.fromInt(Point(3, 5).getOrElse(0))))
    b = Box(4)
    _ <- IO.println(Str.concat("show:", b.show()))
    _ <- IO.println(Str.concat("show:", Opt.Some(1).show()))
    _ <- IO.println(Str.concat("get:", Str.fromInt(Opt.Some(2).getOrElse(0))))
    _ <- IO.println(Str.concat(Str.fromInt(id(7)), id("ok")))
    _ <- IO.println(Str.concat("genum:some:", Str.fromInt(Opt.Some(3).getOrElse(0))))
    _ <- IO.println(Str.concat("genum:none:", Str.fromInt(noneInt().getOrElse(9))))
    wrapped = wrap(4)
    _ <- IO.println(Str.concat("genum:box:", Str.fromInt(wrapped.get())))
    _ <- IO.println(Str.concat("genum:either:", describeEither(Either.Right("ok"))))
    _ <- IO.println(Str.concat("genum:multi:", Str.fromInt(leftOr(Either.Right("s"), 7))))
    _ <- IO.println(Str.concat(tag(), B.tag()))
    _ <- IO.println(greetFrom(Msg.Hi))
    _ <- IO.println(B.greet())
    _ <- IO.println(s"float:${scale(1.5)}")
    _ <- IO.println(s"from:${Float.fromInt(3)}")
    _ <- IO.println(s"to:${trunc(2.9)}")
    _ <- IO.println(s"cmp:${if (1.5 < 2.0 && 2.0 > 1.0) "lt" else "ge"}")
    _ <- IO.println(s"neg:${0.0 - 1.5}")
    _ <- mapSetProof()
    _ <- listProof()
    _ <- strProof()
  } yield ()
