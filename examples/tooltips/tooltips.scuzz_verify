def labelFollowsCount(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, Str.concat("text:Saved: ", Str.fromInt(Timeline.signalInt(t, i, "count")))))

def saveChangesCount(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Save", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "count") == Timeline.signalInt(t, before, "count") + 1
})

def nextChangesCount(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Next", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "count") == Timeline.signalInt(t, before, "count") + 10
})

def nestedChangesCount(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Nested", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "count") == Timeline.signalInt(t, before, "count") + 100
})

def dialogFollowsState(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "open") != 0 == Timeline.a11yHas(t, i, "button:Close"))

def longHelpFollowsState(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "shown") != 0 == Timeline.a11yHas(t, i, "button:Long help"))

def startsClosed(t: Timeline): Verdict =
  Verdict.every(t, i => i != 0 || Timeline.signalInt(t, i, "count") == 0 && Timeline.signalInt(t, i, "open") == 0)

def backgroundHelpStaysClosedInDialog(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "open") == 0 || !Timeline.a11yHas(t, i, "tooltip:Save the current document=1"))

def outerHelpStaysClosed(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "tooltip:Outer help=1"))

def emptyHelpStaysClosed(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "tooltip:=1"))

