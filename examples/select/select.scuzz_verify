def choiceLabelFollowsValue(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, Str.concat("text:Choice: ", Str.fromInt(Timeline.signalInt(t, i, "choice")))))

def itemLabelFollowsValue(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, Str.concat("text:Item: ", Str.fromInt(Timeline.signalInt(t, i, "item")))))

def countLabelFollowsValue(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, Str.concat("text:Count: ", Str.fromInt(Timeline.signalInt(t, i, "count")))))

def addChangesCount(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Add", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "count") == Timeline.signalInt(t, before, "count") + 1
})

def betaKeepsIndex(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Set Beta", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "choice") == 2
})

def lastKeepsIndex(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Set Last", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "item") == 129
})

def beginsUnset(t: Timeline): Verdict =
  Verdict.every(t, i => i != 0 || Timeline.signalInt(t, i, "choice") == -1 && Timeline.signalInt(t, i, "item") == 0 && Timeline.signalInt(t, i, "count") == 0 && Timeline.signalInt(t, i, "empty") == -1 && Timeline.signalInt(t, i, "dialog") == 0 && Timeline.signalListLen(t, i, "options") == 5 && Timeline.signalListLen(t, i, "items") == 130 && Timeline.signalListLen(t, i, "noOptions") == 0)

def settingsOpensDialog(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Settings", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "dialog") == 1 && Timeline.a11yHas(t, after, "combobox:Dialog choice") && Timeline.lastHitHas(t, after, "button:Settings")
})

def closeHidesDialog(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Close", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "dialog") == 0 && !Timeline.a11yHas(t, after, "combobox:Dialog choice")
})

def replaceChangesOptions(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Replace options", pair => pair match {
  case (before, after) => Timeline.signalListLen(t, after, "options") == 4 && Timeline.signalInt(t, after, "choice") == Timeline.signalInt(t, before, "choice")
})

def clearChangesOptions(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Clear options", pair => pair match {
  case (before, after) => Timeline.signalListLen(t, after, "options") == 0 && Timeline.signalInt(t, after, "choice") == Timeline.signalInt(t, before, "choice")
})

def restoreChangesOptions(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Restore options", pair => pair match {
  case (before, after) => Timeline.signalListLen(t, after, "options") == 5 && Timeline.signalInt(t, after, "choice") == Timeline.signalInt(t, before, "choice")
})

