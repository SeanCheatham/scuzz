private def validTok(): String =
  "pairing-token-1234"

private def rotatedTok(): String =
  "rotated-token-5678"

private def cardAlphaId(): String =
  Str.repeat("a", 64)

private def cardBetaId(): String =
  Str.repeat("b", 64)

private def cardGammaId(): String =
  Str.repeat("c", 64)

private def cardNextId(): String =
  Str.repeat("d", 64)

private def jsonStr(j: Json): String =
  Json.stringify(j) match {
    case Result.Ok(s) => s
    case Result.Err(e) => e
  }

private def jField(obj: Json, key: String): Json =
  Json.field(obj, key) match {
    case Result.Ok(v) => v
    case Result.Err(_) => Json.Null()
  }

private def hashSource(content: String): String =
  Hash.sha256(Str.concat("[{\"path\":\"src/Main.scuzz\",\"content\":\"", Str.concat(content, "\"}]")))

private def baseZero(): String =
  hashSource("v0")

private def baseAlpha(): String =
  hashSource("alpha")

private def baseBeta(): String =
  hashSource("beta")

private def sampleCards(mainSrc: String, decidedIds: List[String]): List[Deck.CardItem] =
  for {
    curBase = hashSource(mainSrc)
    all = if (curBase == baseZero()) [Deck.CardItem(cardAlphaId(), "ship mobile sync", baseZero(), baseAlpha(), 0, "idle", 0, ["signals"], [Deck.FilePair("src/Main.scuzz", "v0")], [Deck.FilePair("src/Main.scuzz", "alpha")]), Deck.CardItem(cardBetaId(), "ship mobile sync", baseZero(), baseBeta(), 1, "swipe", 2, ["a11y"], [Deck.FilePair("src/Main.scuzz", "v0")], [Deck.FilePair("src/Main.scuzz", "beta")]), Deck.CardItem(cardGammaId(), "ship mobile sync", baseZero(), hashSource("gamma"), 0, "offline", 1, ["files"], [Deck.FilePair("src/Main.scuzz", "v0")], [Deck.FilePair("src/Main.scuzz", "gamma")])] else if (curBase == baseAlpha()) [Deck.CardItem(cardNextId(), "ship mobile sync", baseAlpha(), hashSource("alpha-next"), 0, "next", 1, ["signals"], [Deck.FilePair("src/Main.scuzz", "alpha")], [Deck.FilePair("src/Main.scuzz", "alpha-next")])] else []
  } yield List.filter(all, c => !List.contains(decidedIds, c.id))

private def cardWireJson(c: Deck.CardItem, propName: String): Json =
  Json.Obj([("id", Json.Str(c.id)), ("proposal", Json.Str(propName)), ("objective", Json.Str(c.objective)), ("baseline", Json.Str(c.baseline)), ("after", Json.Str(c.after)), ("flip", Json.Int(c.flip)), ("question", Json.Obj([("workload", Json.Str(c.workload)), ("step", Json.Int(c.step))])), ("changes", Json.Arr(List.map(c.changes, s => Json.Obj([("section", Json.Str(s))])))), ("before", Json.Arr(List.map(c.before, f => Json.Obj([("path", Json.Str(f.path)), ("content", Json.Str(f.content))])))), ("proposed", Json.Arr(List.map(c.proposed, f => Json.Obj([("path", Json.Str(f.path)), ("content", Json.Str(f.content))]))))])

private def initSimServer(prefix: String, mainSrc: String, tok: String, online: String, dirty: String): IO[Unit] =
  for {
    _ <- Fs.mkdirs(prefix)
    _ <- Fs.write(Fs.join(prefix, "online.txt"), online)
    _ <- Fs.write(Fs.join(prefix, "token.txt"), tok)
    _ <- Fs.write(Fs.join(prefix, "dirty.txt"), dirty)
    _ <- Fs.write(Fs.join(prefix, "main.txt"), mainSrc)
    _ <- Fs.write(Fs.join(prefix, "rev.txt"), "0")
    _ <- Fs.write(Fs.join(prefix, "decided.json"), "[]")
    _ <- Fs.write(Fs.join(prefix, "receipts.json"), "{}")
    _ <- Fs.write(Fs.join(prefix, "steers.json"), "[]")
    _ <- Fs.write(Fs.join(prefix, "batches.txt"), "")
    _ <- Fs.write(Fs.join(prefix, "mode.txt"), "")
  } yield ()

private def headerAuth(headers: Map[String, String]): String =
  for {
    vals = List.map(List.filter(Map.toList(headers), kv => Str.toLower(kv._1) == "authorization"), kv => kv._2)
  } yield if (List.len(vals) == 1) List.at(vals, 0) else ""

private def checkBearer(expected: String, headers: Map[String, String]): Bool =
  Deck.validToken(expected) && headerAuth(headers) == Str.concat("Bearer ", expected)

private def jsonHeaders(): Map[String, String] =
  Map.set(Map.empty(), "Content-Type", "application/json")

private def readJsonOr(path: String, fallback: Json): IO[Json] =
  Fs.read(path).map(raw => Json.parse(raw) match {
  case Result.Ok(j) => j
  case Result.Err(_) => fallback
})

private def readIntOr(path: String, fallback: Int): IO[Int] =
  Fs.read(path).map(raw => Str.parseInt(Str.trim(raw)) match {
  case Result.Ok(n) => n
  case Result.Err(_) => fallback
})

private def simGet(prefix: String): IO[(Int, Map[String, String], String)] =
  for {
    mode <- Fs.read(Fs.join(prefix, "mode.txt")).handleErrorWith(_ => IO.pure(""))
    resp <- if (mode == "oversize-snap") IO.pure((200, jsonHeaders(), "__oversize__")) else for {
  mainSrc <- Fs.read(Fs.join(prefix, "main.txt"))
  rev <- readIntOr(Fs.join(prefix, "rev.txt"), 0)
  decidedJ <- readJsonOr(Fs.join(prefix, "decided.json"), Json.Arr([]))
  steersJ <- readJsonOr(Fs.join(prefix, "steers.json"), Json.Arr([]))
  decidedIds = List.map(Json.arr(decidedJ), j => Json.strOr(j, ""))
  cards = sampleCards(mainSrc, decidedIds)
  normalCards = List.map(cards, c => cardWireJson(c, if (c.id == cardAlphaId()) "p-alpha" else if (c.id == cardBetaId()) "p-beta" else if (c.id == cardGammaId()) "p-gamma" else "p-next"))
  cardsJson = if (mode == "malformed-cards" && List.len(normalCards) >= 3) Json.Arr([List.at(normalCards, 0), Json.set(List.at(normalCards, 1), "after", Json.Str("bad-hex")), Json.set(List.at(normalCards, 2), "question", Json.Obj([("workload", Json.Str("offline")), ("step", Json.Int(-1))]))]) else Json.Arr(normalCards)
  base = hashSource(mainSrc)
  cursor = Hash.sha256(Str.concat(base, Str.concat(":", Str.fromInt(rev))))
  doc = Json.Obj([("v", Json.Int(1)), ("baseline", Json.Str(base)), ("cursor", Json.Str(cursor)), ("revision", Json.Int(rev)), ("objective", Json.Str("ship mobile sync")), ("cards", cardsJson), ("steer", steersJ)])
} yield (200, jsonHeaders(), jsonStr(doc))
  } yield resp

private def applySimAction(prefix: String, item: Json): IO[Json] =
  for {
    id = Json.getStr(item, "id", "")
    kind = Json.getStr(item, "kind", "")
    card = Json.getStr(item, "card", "")
    expBase = Json.getStr(item, "baseline", "")
    reason = Json.getStr(item, "reason", "")
    prompt = Json.getStr(item, "prompt", "")
    receipts <- readJsonOr(Fs.join(prefix, "receipts.json"), Json.Obj([]))
    res <- if (Json.has(receipts, id)) IO.pure(Json.set(jField(receipts, id), "replayed", Json.Bool(true))) else for {
  mainSrc <- Fs.read(Fs.join(prefix, "main.txt"))
  dirty <- Fs.read(Fs.join(prefix, "dirty.txt"))
  rev <- readIntOr(Fs.join(prefix, "rev.txt"), 0)
  decidedJ <- readJsonOr(Fs.join(prefix, "decided.json"), Json.Arr([]))
  steersJ <- readJsonOr(Fs.join(prefix, "steers.json"), Json.Arr([]))
  decidedIds = List.map(Json.arr(decidedJ), j => Json.strOr(j, ""))
  curBase = hashSource(mainSrc)
  built <- if (kind == "steer") for {
  seq = List.len(Json.arr(steersJ)) + 1
  useBase = if (Deck.validHex(expBase)) expBase else curBase
  sRow = Json.Obj([("seq", Json.Int(seq)), ("id", Json.Str(id)), ("prompt", Json.Str(prompt)), ("baseline", Json.Str(useBase)), ("status", Json.Str("queued"))])
  _ <- Fs.write(Fs.join(prefix, "steers.json"), jsonStr(Json.Arr(List.append(Json.arr(steersJ), sRow))))
  _ <- Fs.write(Fs.join(prefix, "rev.txt"), Str.fromInt(rev + 1))
  rec = Json.Obj([("v", Json.Int(1)), ("id", Json.Str(id)), ("kind", Json.Str("steer")), ("status", Json.Str("queued")), ("seq", Json.Int(seq)), ("baseline", Json.Str(useBase)), ("replayed", Json.Bool(false))])
} yield rec else if (List.contains(decidedIds, card)) IO.pure(Json.Obj([("v", Json.Int(1)), ("id", Json.Str(id)), ("kind", Json.Str(kind)), ("card", Json.Str(card)), ("status", Json.Str("already-decided")), ("baseline", Json.Str(curBase)), ("replayed", Json.Bool(false))])) else if (kind == "accept") if (dirty == "1") IO.pure(Json.Obj([("v", Json.Int(1)), ("id", Json.Str(id)), ("kind", Json.Str("accept")), ("card", Json.Str(card)), ("status", Json.Str("dirty")), ("baseline", Json.Str(curBase)), ("replayed", Json.Bool(false))])) else if (curBase != expBase) IO.pure(Json.Obj([("v", Json.Int(1)), ("id", Json.Str(id)), ("kind", Json.Str("accept")), ("card", Json.Str(card)), ("status", Json.Str("stale")), ("baseline", Json.Str(curBase)), ("replayed", Json.Bool(false))])) else for {
  nextSrc = if (card == cardAlphaId()) "alpha" else if (card == cardBetaId()) "beta" else "gamma"
  nextBase = hashSource(nextSrc)
  _ <- Fs.write(Fs.join(prefix, "main.txt"), nextSrc)
  _ <- Fs.write(Fs.join(prefix, "decided.json"), jsonStr(Json.Arr(List.append(Json.arr(decidedJ), Json.Str(card)))))
  _ <- Fs.write(Fs.join(prefix, "rev.txt"), Str.fromInt(rev + 1))
} yield Json.Obj([("v", Json.Int(1)), ("id", Json.Str(id)), ("kind", Json.Str("accept")), ("card", Json.Str(card)), ("status", Json.Str("applied")), ("baseline", Json.Str(nextBase)), ("replayed", Json.Bool(false))]) else for {
  _ <- Fs.write(Fs.join(prefix, "decided.json"), jsonStr(Json.Arr(List.append(Json.arr(decidedJ), Json.Str(card)))))
  _ <- Fs.write(Fs.join(prefix, "rev.txt"), Str.fromInt(rev + 1))
  baseFields = [("v", Json.Int(1)), ("id", Json.Str(id)), ("kind", Json.Str(kind)), ("card", Json.Str(card)), ("status", Json.Str("applied")), ("baseline", Json.Str(curBase)), ("replayed", Json.Bool(false))]
  fields = if (kind == "skip") List.append(baseFields, ("reason", Json.Str(reason))) else baseFields
} yield Json.Obj(fields)
  _ <- Fs.write(Fs.join(prefix, "receipts.json"), jsonStr(Json.set(receipts, id, built)))
} yield built
  } yield res

private def applySimBatch(prefix: String, items: List[Json], acc: List[Json]): IO[List[Json]] =
  if (List.isEmpty(items)) IO.pure(acc) else applySimAction(prefix, List.at(items, 0)).flatMap(r => applySimBatch(prefix, List.tail(items), List.append(acc, r)))

private def mockBadReceipts(items: List[Json], base: String, badKind: Bool): List[Json] =
  List.map(items, item => for {
  id = Json.getStr(item, "id", "")
  kind = Json.getStr(item, "kind", "")
  card = Json.getStr(item, "card", "")
  outKind = if (badKind && kind == "accept") "reject" else kind
  outCard = if (!badKind && kind == "accept") cardBetaId() else card
  core = [("v", Json.Int(1)), ("id", Json.Str(id)), ("kind", Json.Str(outKind)), ("status", Json.Str("applied")), ("baseline", Json.Str(base)), ("replayed", Json.Bool(false))]
} yield Json.Obj(if (kind == "steer") core else List.append(core, ("card", Json.Str(outCard)))))

private def simPost(prefix: String, body: String): IO[(Int, Map[String, String], String)] =
  Fs.read(Fs.join(prefix, "mode.txt")).handleErrorWith(_ => IO.pure("")).flatMap(mode => if (mode == "oversize-batch") IO.pure((200, jsonHeaders(), "__oversize__")) else Json.parse(body) match {
  case Result.Err(_) => IO.pure((400, jsonHeaders(), "{\"v\":1,\"error\":\"invalid-json\"}"))
  case Result.Ok(doc) => for {
  items = Json.arr(jField(doc, "actions"))
  valid = Json.isObj(doc) && Json.getInt(doc, "v", 0) == 1 && Json.isArr(jField(doc, "actions")) && List.nonEmpty(items) && List.len(items) <= 64
  steersValid = List.forall(items, x => Json.getStr(x, "kind", "") != "steer" || Str.trim(Json.getStr(x, "prompt", "")) != "" && Str.byteLen(Str.trim(Json.getStr(x, "prompt", ""))) <= 512)
  resp <- if (!valid) IO.pure((400, jsonHeaders(), "{\"v\":1,\"error\":\"invalid-actions\"}")) else if (!steersValid) IO.pure((400, jsonHeaders(), "{\"v\":1,\"error\":\"invalid-steer\"}")) else if (mode == "bad-receipt-kind" || mode == "bad-receipt-card") for {
  mainSrc <- Fs.read(Fs.join(prefix, "main.txt"))
  rev <- readIntOr(Fs.join(prefix, "rev.txt"), 0)
  base = hashSource(mainSrc)
  cursor = Hash.sha256(Str.concat(base, Str.concat(":", Str.fromInt(rev))))
  badResults = mockBadReceipts(items, base, mode == "bad-receipt-kind")
  reply = Json.Obj([("v", Json.Int(1)), ("baseline", Json.Str(base)), ("cursor", Json.Str(cursor)), ("revision", Json.Int(rev)), ("results", Json.Arr(badResults))])
} yield (200, jsonHeaders(), jsonStr(reply)) else for {
  prevBatches <- Fs.read(Fs.join(prefix, "batches.txt"))
  batchLen = Str.fromInt(List.len(items))
  nextBatches = if (prevBatches == "") batchLen else Str.concat(prevBatches, Str.concat(",", batchLen))
  _ <- Fs.write(Fs.join(prefix, "batches.txt"), nextBatches)
  results <- applySimBatch(prefix, items, [])
  mainSrc <- Fs.read(Fs.join(prefix, "main.txt"))
  rev <- readIntOr(Fs.join(prefix, "rev.txt"), 0)
  base = hashSource(mainSrc)
  cursor = Hash.sha256(Str.concat(base, Str.concat(":", Str.fromInt(rev))))
  reply = Json.Obj([("v", Json.Int(1)), ("baseline", Json.Str(base)), ("cursor", Json.Str(cursor)), ("revision", Json.Int(rev)), ("results", Json.Arr(results))])
} yield (200, jsonHeaders(), jsonStr(reply))
} yield resp
})

private def simHandle(req: (String, String, Map[String, String], String)): IO[(Int, Map[String, String], String)] =
  req match {
    case (path, method, headers, body) => (for {
  prefix <- Fs.read("sim/active.txt")
  tok <- Fs.read(Fs.join(prefix, "token.txt"))
  resp <- if (path != "/v1/ide/sync") IO.pure((404, jsonHeaders(), "{\"v\":1,\"error\":\"not-found\"}")) else if (!checkBearer(tok, headers)) IO.pure((401, jsonHeaders(), "{\"v\":1,\"error\":\"unauthorized\"}")) else if (method == "GET") simGet(prefix) else if (method == "POST") simPost(prefix, body) else IO.pure((405, jsonHeaders(), "{\"v\":1,\"error\":\"method-not-allowed\"}"))
} yield resp).handleErrorWith(_ => IO.pure((503, jsonHeaders(), "{\"v\":1,\"error\":\"storage-unavailable\"}")))
  }

def Sync.httpGet(url: String, headers: Map[String, String]): IO[(Int, Map[String, String], String)] =
  for {
    prefix <- Fs.read("sim/active.txt").handleErrorWith(_ => IO.pure(""))
    online <- (if (prefix == "") IO.pure("0") else Fs.read(Fs.join(prefix, "online.txt"))).handleErrorWith(_ => IO.pure("0"))
    resp <- if (online != "1" || url != "http://127.0.0.1:18795/v1/ide/sync") IO.fail("network offline") else IO.both(Net.serveOnce(18795, req => simHandle(req)), IO.timeout(1000, Net.httpGet(url, headers))).map(p => p._2)
  } yield if (resp._3 == "__oversize__") (resp._1, resp._2, Str.repeat(" ", 1048577)) else resp

def Sync.httpPost(url: String, headers: Map[String, String], body: String): IO[(Int, Map[String, String], String)] =
  for {
    prefix <- Fs.read("sim/active.txt").handleErrorWith(_ => IO.pure(""))
    online <- (if (prefix == "") IO.pure("0") else Fs.read(Fs.join(prefix, "online.txt"))).handleErrorWith(_ => IO.pure("0"))
    resp <- if (online != "1" || url != "http://127.0.0.1:18795/v1/ide/sync") IO.fail("network offline") else IO.both(Net.serveOnce(18795, req => simHandle(req)), IO.timeout(1000, Net.httpPost(url, headers, body))).map(p => p._2)
  } yield if (resp._3 == "__oversize__") (resp._1, resp._2, Str.repeat(" ", 1048577)) else resp

