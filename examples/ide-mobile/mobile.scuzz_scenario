    _ <- Fs.mkdirs(".scuzz/ide-mobile")
    _ <- Fs.write(".scuzz/ide-mobile/state.json", Deck.encodeState(seeded))
    _ <- Fs.write("obs/e2e.txt", "")
    _ <- Fs.write("obs/idempotent.txt", "")
    _ <- Fs.write("obs/conflicts.txt", "")
    _ <- Fs.write("obs/auth.txt", "")
    _ <- Fs.write("obs/chunked.txt", "")
    _ <- Fs.write("obs/corrupt.txt", "")
    _ <- Fs.write("obs/wire.txt", "")
  } yield ()

def faults(): List[String] =
  ["net", "fs"]

def offlineSwipeSteerRestartFlush(): IO[Unit] =
  IO.attempt(for {
  _ <- initSimServer("sim/e2e", "v0", validTok(), "1", "0")
  _ <- Fs.write("sim/active.txt", "sim/e2e")
  cDir = "e2e/full"
  fresh <- Sync.loadOrInit(cDir)
  stSig = Sync.makeCell(fresh.copy(pairing = Deck.Pairing("127.0.0.1", 18795, validTok()), syncStatus = "Paired"))
  busySig = Signal.make(0)
  _ <- Sync.persist(cDir, stSig)
  _ <- Sync.syncNow(cDir, stSig, busySig)
  _ <- Fs.write("sim/e2e/online.txt", "0")
  _ <- Sync.syncNow(cDir, stSig, busySig)
  offlineBefore = Sync.readCell(stSig).syncStatus == "Offline"
  s1 = Deck.applySwipeDelta(Sync.readCell(stSig), 85)
  s2 = Deck.applySwipeDelta(s1, -85)
  s3 = Deck.queueCardAction(s2, "skip", "need-another-scenario")
  s4 = Deck.queueSteer(s3, "  keep layout compact  ") match {
  case Result.Ok(v) => v
  case Result.Err(_) => s3
}
  _ = Sync.writeCell(stSig, s4)
  _ <- Sync.persist(cDir, stSig)
  restarted <- Sync.loadOrInit(cDir)
  restSig = Sync.makeCell(restarted)
  _ <- Fs.write("sim/e2e/online.txt", "1")
  _ <- Sync.syncNow(cDir, restSig, busySig)
  finalSt = Sync.readCell(restSig)
  mainDisk <- Fs.read("sim/e2e/main.txt")
  cardsTag = List.join(List.map(finalSt.snapshot.cards, c => Str.take(c.id, 4)), ",")
  steerTag = List.join(List.map(finalSt.snapshot.steer, s => s.prompt), "|")
  okPre = offlineBefore && Sync.readCell(stSig).syncStatus == "Queued steer" && List.len(restarted.outbox) == 4 && List.map(restarted.outbox, a => a.kind) == ["accept", "reject", "skip", "steer"]
  summary = if (okPre && mainDisk == "alpha" && List.isEmpty(finalSt.outbox)) Str.concat("ok:rev=", Str.concat(Str.fromInt(finalSt.snapshot.revision), Str.concat(";cards=", Str.concat(cardsTag, Str.concat(";steer=", steerTag))))) else "incomplete"
  _ <- Fs.write("obs/e2e.txt", summary)
  _ <- Fs.write("sim/active.txt", "sim/ui")
} yield ()).map(_ => ())

def retryIdempotentBatch(): IO[Unit] =
  IO.attempt(for {
  _ <- initSimServer("sim/idem", "v0", validTok(), "1", "0")
  _ <- Fs.write("sim/active.txt", "sim/idem")
  cDir = "e2e/idem"
  st0 = Deck.ClientState("idem", 1, Deck.Pairing("127.0.0.1", 18795, validTok()), Deck.Snapshot(baseZero(), baseZero(), 0, "ship mobile sync", sampleCards("v0", []), []), [], "Synced rev 0", "")
  st1 = Deck.queueCardAction(st0, "accept", "")
  st2 = Deck.queueCardAction(st1, "reject", "")
  st3 = Deck.queueCardAction(st2, "skip", "outside-my-goal")
  st4 = Deck.queueSteer(st3, "one steer only") match {
  case Result.Ok(v) => v
  case Result.Err(_) => st3
}
  savedJson = Deck.encodeState(st4)
  sig1 = Sync.makeCell(st4)
  busy = Signal.make(0)
  _ <- Sync.persist(cDir, sig1)
  _ <- Sync.syncNow(cDir, sig1, busy)
  _ <- Fs.write(Sync.statePath(cDir), savedJson)
  reloaded <- Sync.loadOrInit(cDir)
  sig2 = Sync.makeCell(reloaded)
  _ <- Sync.syncNow(cDir, sig2, busy)
  steersJ <- readJsonOr("sim/idem/steers.json", Json.Arr([]))
  mainSrc <- Fs.read("sim/idem/main.txt")
  directResp <- Sync.httpPost("http://127.0.0.1:18795/v1/ide/sync", Deck.authHeaders(validTok()), Deck.encodeBatch(st4.outbox))
  replayCount = Deck.decodeBatchReply(directResp._3, st4.outbox) match {
  case Result.Ok(rep) => List.count(rep.results, r => r.replayed)
  case Result.Err(_) => -1
}
  done = Sync.readCell(sig2)
  msg = if (mainSrc == "alpha" && replayCount == 4 && List.len(Json.arr(steersJ)) == 1 && List.isEmpty(done.outbox)) "ok:replayed=4;steers=1;outbox=0" else "mismatch"
  _ <- Fs.write("obs/idempotent.txt", msg)
  _ <- Fs.write("sim/active.txt", "sim/ui")
} yield ()).map(_ => ())

def staleAndDirtyHandling(): IO[Unit] =
  IO.attempt(for {
  _ <- initSimServer("sim/conf", "v0", validTok(), "1", "1")
  _ <- Fs.write("sim/active.txt", "sim/conf")
  cDir = "e2e/conf"
  baseSt = Deck.ClientState("conf", 1, Deck.Pairing("127.0.0.1", 18795, validTok()), Deck.Snapshot(baseZero(), baseZero(), 0, "ship mobile sync", sampleCards("v0", []), []), [], "Synced rev 0", "")
  dirtyQueued = Deck.queueCardAction(baseSt, "accept", "")
  sig = Sync.makeCell(dirtyQueued)
  busy = Signal.make(0)
  _ <- Sync.persist(cDir, sig)
  _ <- Sync.syncNow(cDir, sig, busy)
  afterDirty = Sync.readCell(sig)
  mainAfterDirty <- Fs.read("sim/conf/main.txt")
  _ <- Fs.write("sim/conf/dirty.txt", "0")
  _ <- Fs.write("sim/conf/main.txt", "external")
  staleQueued = Deck.queueCardAction(afterDirty.copy(snapshot = baseSt.snapshot), "accept", "")
  _ = Sync.writeCell(sig, staleQueued)
  _ <- Sync.syncNow(cDir, sig, busy)
  afterStale = Sync.readCell(sig)
  mainAfterStale <- Fs.read("sim/conf/main.txt")
  ok = mainAfterDirty == "v0" && mainAfterStale == "external" && Str.contains(afterDirty.alert, "dirty workspace") && Str.contains(afterStale.alert, "stale baseline")
  _ <- Fs.write("obs/conflicts.txt", if (ok) "ok:dirty-and-stale-flagged" else "mismatch")
  _ <- Fs.write("sim/active.txt", "sim/ui")
} yield ()).map(_ => ())

def unauthorizedKeepsOutbox(): IO[Unit] =
  IO.attempt(for {
  _ <- initSimServer("sim/auth", "v0", rotatedTok(), "1", "0")
  _ <- Fs.write("sim/active.txt", "sim/auth")
  cDir = "e2e/auth"
  baseSt = Deck.ClientState("auth", 1, Deck.Pairing("127.0.0.1", 18795, validTok()), Deck.Snapshot(baseZero(), baseZero(), 0, "ship mobile sync", sampleCards("v0", []), []), [], "Synced rev 0", "")
  q1 = Deck.queueCardAction(baseSt, "accept", "")
  q2 = Deck.queueSteer(q1, "survive 401") match {
  case Result.Ok(v) => v
  case Result.Err(_) => q1
}
  sig = Sync.makeCell(q2)
  busy = Signal.make(0)
  _ <- Sync.persist(cDir, sig)
  _ <- Sync.syncNow(cDir, sig, busy)
  after401 = Sync.readCell(sig)
  persisted401 <- Sync.loadOrInit(cDir)
  _ = Sync.writeCell(sig, persisted401.copy(pairing = Deck.Pairing("127.0.0.1", 18795, rotatedTok()), alert = ""))
  _ <- Sync.syncNow(cDir, sig, busy)
  afterFix = Sync.readCell(sig)
  mainSrc <- Fs.read("sim/auth/main.txt")
  ok = after401.syncStatus == "401 unauthorized" && Str.contains(after401.alert, "401 unauthorized") && List.len(persisted401.outbox) == 2 && List.isEmpty(afterFix.outbox) && mainSrc == "alpha"
  _ <- Fs.write("obs/auth.txt", if (ok) "ok:401-kept=2;flushed=0;main=alpha" else "mismatch")
  _ <- Fs.write("sim/active.txt", "sim/ui")
} yield ()).map(_ => ())

private def addManySteers(st: Deck.ClientState, i: Int, total: Int): Deck.ClientState =
  if (i > total) st else Deck.queueSteer(st, Str.concat("steer-", Str.fromInt(i))) match {
  case Result.Ok(next) => addManySteers(next, i + 1, total)
  case Result.Err(_) => st
}

