def wireBoundsAndReceiptIntegrity(): IO[Unit] =
  IO.attempt(for {
  _ <- initSimServer("sim/wire", "v0", validTok(), "1", "0")
  _ <- Fs.write("sim/active.txt", "sim/wire")
  utf8Prompt512 = Str.repeat("é", 256)
  utf8Prompt514 = Str.repeat("é", 257)
  baseSt = Deck.ClientState("wire", 1, Deck.Pairing("127.0.0.1", 18795, validTok()), Deck.Snapshot(baseZero(), baseZero(), 0, "ship mobile sync", sampleCards("v0", []), []), [], "Steer prompt exceeds 512 bytes", "Steer prompt exceeds 512 bytes")
  overRes = Deck.queueSteer(baseSt, utf8Prompt514)
  s1 = Deck.queueCardAction(baseSt, "accept", "")
  s2 = Deck.queueSteer(s1, utf8Prompt512) match {
  case Result.Ok(v) => v
  case Result.Err(_) => s1
}
  badSaved = Deck.encodeState(s2.copy(outbox = [Deck.OutboxAction("wire-9", "steer", "", baseZero(), "", utf8Prompt514)]))
  _ <- Fs.mkdirs("e2e/wire_bad_utf8")
  _ <- Fs.write("e2e/wire_bad_utf8/state.json", badSaved)
  badUtf8Loaded <- Sync.loadOrInit("e2e/wire_bad_utf8")
  _ <- Fs.mkdirs("e2e/wire_over")
  _ <- Fs.write("e2e/wire_over/state.json", Str.concat(Deck.encodeState(s2), Str.repeat(" ", 1048577)))
  overLoaded <- Sync.loadOrInit("e2e/wire_over")
  _ <- Fs.write("e2e/wire_over/state.json", "")
  cDir = "e2e/wire_sync"
  sig = Sync.makeCell(s2)
  busy = Signal.make(0)
  _ <- Sync.persist(cDir, sig)
  persistedClean <- Sync.loadOrInit(cDir)
  _ <- Fs.write("sim/wire/mode.txt", "oversize-batch")
  _ <- Sync.syncNow(cDir, sig, busy)
  afterOverBatch = Sync.readCell(sig)
  _ <- Fs.write("sim/wire/mode.txt", "bad-receipt-kind")
  _ <- Sync.syncNow(cDir, sig, busy)
  afterBadKind = Sync.readCell(sig)
  _ <- Fs.write("sim/wire/mode.txt", "bad-receipt-card")
  _ <- Sync.syncNow(cDir, sig, busy)
  afterBadCard = Sync.readCell(sig)
  _ <- Fs.write("sim/wire/mode.txt", "")
  _ <- Sync.syncNow(cDir, sig, busy)
  afterFlush = Sync.readCell(sig)
  steersJ <- readJsonOr("sim/wire/steers.json", Json.Arr([]))
  mainAfterFlush <- Fs.read("sim/wire/main.txt")
  _ <- Fs.write("sim/wire/mode.txt", "oversize-snap")
  _ <- Sync.syncNow(cDir, sig, busy)
  afterOverSnap = Sync.readCell(sig)
  _ <- initSimServer("sim/wire", "v0", validTok(), "1", "0")
  _ <- Fs.write("sim/wire/mode.txt", "malformed-cards")
  _ <- Sync.syncNow(cDir, sig, busy)
  afterMalformed = Sync.readCell(sig)
  utf8Ok = overRes == Result.Err("Steer prompt exceeds 512 bytes") && persistedClean.syncStatus == "Queued steer" && persistedClean.alert == "" && List.isEmpty(badUtf8Loaded.outbox) && Str.contains(badUtf8Loaded.alert, "Saved state was invalid")
  boundsOk = List.isEmpty(overLoaded.outbox) && Str.contains(overLoaded.alert, "Saved state was invalid") && afterOverBatch.syncStatus == "Batch reply exceeds 1 MiB" && List.len(afterOverBatch.outbox) == 2 && afterOverSnap.syncStatus == "Snapshot exceeds 1 MiB"
  receiptsOk = afterBadKind.syncStatus == "Invalid batch receipt" && List.len(afterBadKind.outbox) == 2 && afterBadCard.syncStatus == "Invalid batch receipt" && List.len(afterBadCard.outbox) == 2
  flushAndCardsOk = List.isEmpty(afterFlush.outbox) && mainAfterFlush == "alpha" && List.len(Json.arr(steersJ)) == 1 && Str.byteLen(Json.getStr(List.at(Json.arr(steersJ), 0), "prompt", "")) == 512 && List.map(afterMalformed.snapshot.cards, c => c.id) == [cardAlphaId()]
  _ <- Fs.write("obs/wire.txt", if (utf8Ok && boundsOk && receiptsOk && flushAndCardsOk) "ok:utf8-clear-bounds-receipts" else "mismatch")
  _ <- Fs.write("sim/active.txt", "sim/ui")
} yield ()).flatMap(res => Fs.write("sim/active.txt", "sim/ui").handleErrorWith(_ => IO.pure(())).map(_ => res)).map(_ => ())

