private def sampleHex(ch: String): String =
  Str.repeat(ch, 64)

private def sampleCard(flip: Int): Deck.CardItem =
  Deck.CardItem(sampleHex("a"), "ship mobile sync", sampleHex("0"), sampleHex("1"), flip, "idle", 0, ["signals"], [Deck.FilePair("src/Main.scuzz", "v0")], [Deck.FilePair("src/Main.scuzz", "v1")])

private def buildOutbox(st: Deck.ClientState, i: Int, total: Int): Deck.ClientState =
  if (i > total) st else Deck.queueSteer(st, Str.concat("s-", Str.fromInt(i))) match {
  case Result.Ok(next) => buildOutbox(next, i + 1, total)
  case Result.Err(_) => st
}

oracle pairingAndReasonBounds(): Bool =
  for {
    goodTok = Str.repeat("t", 16)
    maxTok = Str.repeat("t", 128)
    okPair = Deck.parsePairing(" 192.168.1.10 ", " 8787 ", Str.concat(" ", Str.concat(goodTok, " ")))
    loPair = Deck.parsePairing("127.0.0.1", "1", goodTok)
    hiPair = Deck.parsePairing("my-laptop.local", "65535", maxTok)
    pairUrl = Deck.endpointUrl(Deck.Pairing("192.168.1.10", 8787, goodTok))
    badHost = Deck.parsePairing("bad/host", "8787", goodTok)
    badPort0 = Deck.parsePairing("127.0.0.1", "0", goodTok)
    badPortHi = Deck.parsePairing("127.0.0.1", "65536", goodTok)
    badPortNan = Deck.parsePairing("127.0.0.1", "abc", goodTok)
    badTokShort = Deck.parsePairing("127.0.0.1", "8787", Str.repeat("t", 15))
    badTokLong = Deck.parsePairing("127.0.0.1", "8787", Str.repeat("t", 129))
    badUrlHost = Deck.endpointUrl(Deck.Pairing("", 8787, goodTok))
    badUrlPort = Deck.endpointUrl(Deck.Pairing("127.0.0.1", 0, goodTok))
    badUrlTok = Deck.endpointUrl(Deck.Pairing("127.0.0.1", 8787, "short"))
    hostsOk = Deck.validHost("127.0.0.1") && Deck.validHost("dev_box-1.local") && !Deck.validHost("") && !Deck.validHost("bad/host")
    portsOk = Deck.validPort(1) && Deck.validPort(65535) && !Deck.validPort(0) && !Deck.validPort(65536)
    hexOk = Deck.validHex(sampleHex("f")) && !Deck.validHex(Str.repeat("f", 63)) && !Deck.validHex(Str.repeat("G", 64))
    hdrs = Deck.authHeaders(goodTok)
    hdrsOk = Map.get(hdrs, "Authorization") == Some(Str.concat("Bearer ", goodTok)) && Map.get(hdrs, "Content-Type") == Some("application/json")
    reasonsOk = Deck.skipReasonOf(0) == "" && Deck.skipReasonOf(1) == "no-visible-difference" && Deck.skipReasonOf(2) == "need-another-scenario" && Deck.skipReasonOf(3) == "outside-my-goal" && Deck.skipReasonOf(9) == "" && Deck.validReason("") && Deck.validReason("no-visible-difference") && Deck.validReason("need-another-scenario") && Deck.validReason("outside-my-goal") && !Deck.validReason("other")
    clientIds = Deck.sanitizeClientId("abc_1-2") == "abc_1-2" && Deck.sanitizeClientId("") == "mob" && Deck.sanitizeClientId("bad space") == "mob" && Deck.initialState("mob", Deck.defaultPairing()).snapshot.revision == 0
  } yield okPair == Result.Ok(Deck.Pairing("192.168.1.10", 8787, goodTok)) && loPair == Result.Ok(Deck.Pairing("127.0.0.1", 1, goodTok)) && hiPair == Result.Ok(Deck.Pairing("my-laptop.local", 65535, maxTok)) && Deck.validToken(maxTok) && pairUrl == Result.Ok("http://192.168.1.10:8787/v1/ide/sync") && badHost == Result.Err("Host is invalid") && badPort0 == Result.Err("Port must be 1..65535") && badPortHi == Result.Err("Port must be 1..65535") && badPortNan == Result.Err("Port must be 1..65535") && badTokShort == Result.Err("Bearer token must be 16..128 URL-safe chars") && badTokLong == Result.Err("Bearer token must be 16..128 URL-safe chars") && badUrlHost == Result.Err("Host is invalid") && badUrlPort == Result.Err("Port must be 1..65535") && badUrlTok == Result.Err("Pair bearer token first") && hostsOk && portsOk && hexOk && hdrsOk && reasonsOk && clientIds

oracle blindLaneProjection(flipRaw: Int, laneRaw: Int): Bool =
  for {
    flip = if (flipRaw % 2 == 0) 0 else 1
    lane = if (laneRaw % 2 == 0) 0 else 1
    card = sampleCard(flip)
    files = Deck.laneFiles(card, lane)
    kind = Deck.laneKind(card, lane)
    st0 = Deck.ClientState("mob", 1, Deck.defaultPairing(), Deck.Snapshot(sampleHex("0"), sampleHex("0"), 0, "obj", [card], []), [], "Ready", "")
    st1 = Deck.queueLaneChoice(st0, lane)
    st2 = Deck.queueLaneChoice(st1, lane)
    isProposalLane = lane == 0 && flip == 1 || lane == 1 && flip == 0
  } yield (if (isProposalLane) files == card.proposed && kind == "accept" else files == card.before && kind == "reject") && List.len(st1.outbox) == 1 && List.at(st1.outbox, 0).kind == kind && List.at(st1.outbox, 0).baseline == card.baseline && List.isEmpty(Deck.visibleCards(st1)) && st2 == st1

oracle swipeThresholdLaw(delta: Int): Bool =
  for {
    card = sampleCard(0)
    st0 = Deck.ClientState("mob", 5, Deck.defaultPairing(), Deck.Snapshot(sampleHex("0"), sampleHex("0"), 0, "obj", [card], []), [], "Ready", "")
    st1 = Deck.applySwipeDelta(st0, delta)
  } yield if (delta >= 60) st1.nextSeq == 6 && List.len(st1.outbox) == 1 && List.at(st1.outbox, 0).kind == "accept" && List.at(st1.outbox, 0).id == "mob-5" else if (delta <= -60) st1.nextSeq == 6 && List.len(st1.outbox) == 1 && List.at(st1.outbox, 0).kind == "reject" && List.at(st1.outbox, 0).id == "mob-5" else st1.nextSeq == 5 && List.isEmpty(st1.outbox)

oracle steerBoundsAndFormatting(): Bool =
  for {
    st0 = Deck.initialState("mob", Deck.Pairing("127.0.0.1", 8787, Str.repeat("k", 16)))
    emptyErr = Deck.queueSteer(st0, "   ")
    ok512 = Deck.queueSteer(st0, Str.repeat("p", 512))
    over513 = Deck.queueSteer(st0, Str.repeat("p", 513))
    withSteer = ok512 match {
  case Result.Ok(s) => s.copy(snapshot = s.snapshot.copy(steer = [Deck.SteerRow(1, "r1", "server steer", sampleHex("0"), "queued")]))
  case Result.Err(_) => st0
}
    lines = Deck.steerLines(withSteer)
  } yield emptyErr == Result.Err("Enter a steer prompt") && over513 == Result.Err("Steer prompt exceeds 512 bytes") && List.len(lines) == 2 && List.at(lines, 1) == "[#1 queued] server steer" && Deck.formatFiles([]) == "(no file changes)" && Deck.formatFiles([Deck.FilePair("src/A.scuzz", "1")]) == """src/A.scuzz
1"""

oracle statePersistenceAndWireProtocol(): Bool =
  for {
    tok = Str.repeat("z", 20)
    c0 = sampleCard(0)
    c1 = sampleCard(1).copy(id = sampleHex("b"))
    st0 = Deck.ClientState("mob_1", 1, Deck.Pairing("127.0.0.1", 8787, tok), Deck.Snapshot(sampleHex("0"), sampleHex("9"), 2, "ship", [c0, c1], [Deck.SteerRow(1, "s0", "first", sampleHex("0"), "queued")]), [], "Synced rev 2", "")
    st1 = Deck.queueCardAction(st0, "accept", "")
    st2 = Deck.queueCardAction(st1, "skip", "outside-my-goal")
    stEmpty = Deck.queueCardAction(st2, "reject", "")
    st3 = Deck.queueSteer(st2, "compact cards") match {
  case Result.Ok(v) => v
  case Result.Err(_) => st2
}
    many = buildOutbox(st0, 1, 70).outbox
    batchOk = Deck.nextBatch(st3.outbox) == st3.outbox && List.len(Deck.nextBatch(many)) == 64 && List.len(Deck.nextBatch(List.take(many, 64))) == 64
    snap7 = Deck.Snapshot(sampleHex("2"), sampleHex("7"), 7, "next", [c0], [])
    snapped = Deck.applySnapshot(st3, snap7)
    offline = Deck.applyOffline(st3)
    encoded = Deck.encodeState(st3)
    roundTrip = Deck.decodeState(encoded)
    batchWire = Deck.encodeBatch(st3.outbox)
    h1 = sampleHex("1")
    h8 = sampleHex("8")
    ha = sampleHex("a")
    hb = sampleHex("b")
    replyRaw = List.join(["{\"v\":1,\"baseline\":\"", h1, "\",\"cursor\":\"", h8, "\",\"revision\":5,\"results\":[{\"v\":1,\"id\":\"mob_1-1\",\"kind\":\"accept\",\"card\":\"", ha, "\",\"status\":\"stale\",\"baseline\":\"", h1, "\",\"replayed\":false},{\"v\":1,\"id\":\"mob_1-2\",\"kind\":\"skip\",\"card\":\"", hb, "\",\"status\":\"dirty\",\"baseline\":\"", h1, "\",\"replayed\":false},{\"v\":1,\"id\":\"mob_1-3\",\"kind\":\"steer\",\"status\":\"queued\",\"baseline\":\"", h1, "\",\"replayed\":false}]}"], "")
    concurrent = Deck.queueSteer(st3, "added during flight") match {
  case Result.Ok(v) => v
  case Result.Err(_) => st3
}
    merged = Deck.decodeBatchReply(replyRaw, st3.outbox) match {
  case Result.Ok(rep) => Deck.applyBatchReply(concurrent, st3.outbox, rep)
  case Result.Err(_) => concurrent
}
    err401 = Deck.applyHttpError(st3, 401)
    err503 = Deck.applyHttpError(st3, 503)
    badStates = List.forall(["{", "[]", "{\"v\":2}", "{\"v\":1,\"client_id\":\"\",\"next_seq\":1}"], s => Deck.decodeState(s) match {
  case Result.Ok(_) => false
  case Result.Err(_) => true
})
    badBatch = List.forall(["{", "{\"v\":2,\"results\":[]}", "{\"v\":1,\"baseline\":\"bad\",\"cursor\":\"bad\",\"revision\":0,\"results\":[]}"], s => Deck.decodeBatchReply(s, st3.outbox) match {
  case Result.Ok(_) => false
  case Result.Err(_) => true
})
    badSnap = List.forall(["{", "{\"v\":2}", "{\"v\":1,\"baseline\":\"bad\",\"cursor\":\"bad\",\"revision\":0,\"cards\":[],\"steer\":[]}"], s => Deck.decodeSnapshot(s) match {
  case Result.Ok(_) => false
  case Result.Err(_) => true
})
  } yield stEmpty == st2 && batchOk && snapped.snapshot == snap7 && snapped.syncStatus == "Synced rev 7" && offline.syncStatus == "Offline" && offline.outbox == st3.outbox && roundTrip == Result.Ok(st3) && Str.contains(batchWire, "\"outside-my-goal\"") && List.len(merged.outbox) == 1 && List.at(merged.outbox, 0).prompt == "added during flight" && Str.contains(merged.alert, "stale baseline") && err401.syncStatus == "401 unauthorized" && List.len(err401.outbox) == 3 && err503.syncStatus == "Sync HTTP 503" && List.len(err503.outbox) == 3 && badStates && badBatch && badSnap

private def checkPersistCase(dir: String, init: Deck.ClientState, wantStatus: String): Bool =
  for {
    _ = Property.force(IO.attempt(Fs.mkdirs(dir).flatMap(_ => Fs.write(Sync.statePath(dir), "seed"))))
    cell = Sync.makeCell(init)
    _ = Property.force(Sync.persist(dir, cell))
    _ = if (Sync.readCell(cell).syncStatus == "Storage write failed") Property.force(Sync.persist(dir, cell)) else ()
    probe = Property.force(IO.attempt(Fs.read(Sync.statePath(dir))))
    st = Sync.readCell(cell)
  } yield probe match {
  case Result.Ok(raw) => st.syncStatus == wantStatus && Deck.decodeState(raw) == Result.Ok(st)
  case Result.Err(_) => st.syncStatus == wantStatus || st.syncStatus == "Storage write failed"
}

oracle syncStorageAndOfflineRules(): Bool =
  for {
    tok = Str.repeat("v", 16)
    pathOk = Sync.statePath("oracle/sync") == "oracle/sync/state.json"
    dirOk = Property.force(Sync.resolveDir()) == ".scuzz/ide-mobile"
    fresh1 = Property.force(Sync.loadOrInit("oracle/fresh1"))
    fresh = if (fresh1.syncStatus == "Storage read failed") Property.force(Sync.loadOrInit("oracle/fresh2")) else fresh1
    freshProbe = Property.force(IO.attempt(Fs.exists("oracle/fresh2/state.json")))
    freshOk = fresh.pairing == Deck.defaultPairing() && List.isEmpty(fresh.outbox) && freshProbe match {
  case Result.Ok(_) => fresh.syncStatus == "Unpaired"
  case Result.Err(_) => fresh.syncStatus == "Unpaired" || fresh.syncStatus == "Storage read failed"
}
    cell = Sync.makeCell(fresh)
    _ = Signal.set(cell, "{bad")
    fallbackOk = Sync.readCell(cell) == Deck.initialState("mob", Deck.defaultPairing())
    pairedErr = Deck.initialState("mob_p", Deck.Pairing("127.0.0.1", 18795, tok)).copy(syncStatus = "Storage write failed")
    _ = Sync.writeCell(cell, pairedErr)
    writeOk = Sync.readCell(cell) == pairedErr
    pairedRecovered = checkPersistCase("oracle/paired", pairedErr, "Ready")
    unpairedRecovered = checkPersistCase("oracle/unpaired", fresh.copy(syncStatus = "Storage write failed"), "Unpaired")
    keptCell = Sync.makeCell(pairedErr.copy(syncStatus = "Synced rev 3"))
    keptOk = checkPersistCase("oracle/kept", pairedErr.copy(syncStatus = "Synced rev 3"), "Synced rev 3")
    busyOn = Signal.make(1)
    _ = Property.force(Sync.syncNow("oracle/kept", keptCell, busyOn))
    busyGuardOk = Signal.get(busyOn) == 1 && Sync.readCell(keptCell).syncStatus == "Synced rev 3"
    unpairedCell = Sync.makeCell(fresh)
    _ = Property.force(IO.attempt(Fs.mkdirs("oracle/unpaired_sync").flatMap(_ => Fs.write("oracle/unpaired_sync/state.json", "seed"))))
    busyOff = Signal.make(0)
    _ = Property.force(Sync.syncNow("oracle/unpaired_sync", unpairedCell, busyOff))
    _ = if (Sync.readCell(unpairedCell).syncStatus == "Storage write failed") Property.force(Sync.syncNow("oracle/unpaired_sync", unpairedCell, busyOff)) else ()
    unpairedProbe = Property.force(IO.attempt(Fs.read("oracle/unpaired_sync/state.json")))
    unpairedSyncOk = Signal.get(busyOff) == 0 && unpairedProbe match {
  case Result.Ok(_) => Sync.readCell(unpairedCell).syncStatus == "Pair bearer token first"
  case Result.Err(_) => Sync.readCell(unpairedCell).syncStatus == "Pair bearer token first" || Sync.readCell(unpairedCell).syncStatus == "Storage write failed"
}
    pairedSyncCell = Sync.makeCell(Deck.initialState("mob_s", Deck.Pairing("127.0.0.1", 18795, tok)))
    busyFlight = Signal.make(0)
    pendingIo = Sync.syncNow("oracle/inflight", pairedSyncCell, busyFlight)
    inFlightLocked = Signal.get(busyFlight) == 1 && Sync.readCell(pairedSyncCell).syncStatus == "Syncing"
    _ = Property.force(pendingIo)
    settledUnlocked = Signal.get(busyFlight) == 0 && Sync.readCell(pairedSyncCell).syncStatus != "Syncing"
  } yield pathOk && dirOk && freshOk && fallbackOk && writeOk && pairedRecovered && unpairedRecovered && keptOk && busyGuardOk && unpairedSyncOk && inFlightLocked && settledUnlocked

private def faulted(t: Timeline, i: Int): Bool =
  Timeline.faultKindHas(t, i, "net") || Timeline.faultKindHas(t, i, "fs")

private def modalErrorMatchesA11y(t: Timeline, i: Int, hasPairErr: Int): Bool =
  if (hasPairErr == 0) !Timeline.a11yHas(t, i, "text:Host is invalid") && !Timeline.a11yHas(t, i, "text:Port must be 1..65535") && !Timeline.a11yHas(t, i, "text:Bearer token must be 16..128 URL-safe chars") else Timeline.signalStrHas(t, i, "pairErr", "Host is invalid") && Timeline.a11yHas(t, i, "text:Host is invalid") || Timeline.signalStrHas(t, i, "pairErr", "Port must be 1..65535") && Timeline.a11yHas(t, i, "text:Port must be 1..65535") || Timeline.signalStrHas(t, i, "pairErr", "Bearer token must be 16..128 URL-safe chars") && Timeline.a11yHas(t, i, "text:Bearer token must be 16..128 URL-safe chars")

private def skipChipsMatchReason(t: Timeline, i: Int, hasCard: Int, skipReason: Int): Bool =
  skipReason >= 0 && skipReason <= 3 && (hasCard == 0 || skipReason == 0 == Timeline.a11yHas(t, i, "choicechip:None=1") && skipReason == 1 == Timeline.a11yHas(t, i, "choicechip:No diff=1") && skipReason == 2 == Timeline.a11yHas(t, i, "choicechip:Need scenario=1") && skipReason == 3 == Timeline.a11yHas(t, i, "choicechip:Off goal=1"))

def shellControlsStayAvailable(t: Timeline): Verdict =
  Verdict.and(Verdict.alwaysHas(t, "button:Sync"), Verdict.alwaysHas(t, "outlined:Pair"))

def blindDeckNeverShowsCandidateNames(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "p-alpha") && !Timeline.a11yHas(t, i, "p-beta") && !Timeline.a11yHas(t, i, "p-gamma") && !Timeline.a11yHas(t, i, "p-next"))

private def checkDeckState(t: Timeline, i: Int): Bool =
  for {
    cards = Timeline.signalInt(t, i, "cardCount")
    outbox = Timeline.signalInt(t, i, "outboxCount")
    hasCard = Timeline.signalInt(t, i, "hasCard")
    hasEmpty = Timeline.signalInt(t, i, "hasEmpty")
    hasAlert = Timeline.signalInt(t, i, "hasAlert")
    pairOpen = Timeline.signalInt(t, i, "pairOpen")
    hasPairErr = Timeline.signalInt(t, i, "hasPairErr")
    skipReason = Timeline.signalInt(t, i, "skipReason")
    swipe = Timeline.signalInt(t, i, "swipe")
    storeValid = Timeline.signalStrHas(t, i, "store", "\"v\":1")
    pairErrSync = hasPairErr == 0 == Timeline.signalStrHas(t, i, "pairErr", "")
    modalControls = Timeline.a11yHas(t, i, "button:Save pairing") && Timeline.a11yHas(t, i, "textbutton:Close pairing") && Timeline.a11yHas(t, i, "textfield:Host") && Timeline.a11yHas(t, i, "textfield:Port") && Timeline.a11yHas(t, i, "textfield:Bearer token")
    modalOk = pairOpen != 0 == modalControls && (if (pairOpen != 0) modalErrorMatchesA11y(t, i, hasPairErr) else !Timeline.a11yHas(t, i, "text:Host is invalid") && !Timeline.a11yHas(t, i, "text:Port must be 1..65535") && !Timeline.a11yHas(t, i, "text:Bearer token must be 16..128 URL-safe chars"))
    bgAlertClean = !Timeline.a11yHas(t, i, "text:Alert: Host is invalid") && !Timeline.a11yHas(t, i, "text:Alert: Port must be 1..65535") && !Timeline.a11yHas(t, i, "text:Alert: Bearer token must be 16..128 URL-safe chars")
    objectiveOk = (!Timeline.signalStrHas(t, i, "store", "\"objective\":\"ship mobile sync\"") || Timeline.a11yHas(t, i, "text:Objective: ship mobile sync")) && (!Timeline.signalStrHas(t, i, "store", "\"objective\":\"\"") || Timeline.a11yHas(t, i, "text:Objective: (none)"))
    cardTextOk = hasCard == 0 || Timeline.a11yHas(t, i, Str.concat(" | Remaining: ", Str.fromInt(cards))) && Timeline.a11yHas(t, i, "text:Question: ") && Timeline.a11yHas(t, i, "text:Changed: ") && !Timeline.a11yHas(t, i, "text:Changed: behavior") && swipe >= 60 == Timeline.a11yHas(t, i, "text:Release right to accept") && swipe <= -60 == Timeline.a11yHas(t, i, "text:Release left to reject") && (swipe > -60 && swipe < 60) == Timeline.a11yHas(t, i, "text:Swipe left to reject or right to accept")
    alertBannerOk = hasAlert != 0 == Timeline.a11yHas(t, i, "textbutton:Dismiss alert") && hasAlert != 0 == Timeline.a11yHas(t, i, "text:Alert: ")
    emptyViewOk = hasEmpty != 0 == Timeline.a11yHas(t, i, "text:No undecided cards in local deck.")
    initSignalsOk = i != 0 || swipe == 0 && skipReason == 0 && pairOpen == 0 && hasPairErr == 0
    deckViewOk = Timeline.a11yHas(t, i, Str.concat(" | Outbox: ", Str.fromInt(outbox))) && objectiveOk && cardTextOk && alertBannerOk && emptyViewOk && initSignalsOk && bgAlertClean && skipChipsMatchReason(t, i, hasCard, skipReason)
  } yield cards >= 0 && outbox >= 0 && cards > 0 == (hasCard == 1) && cards == 0 == (hasEmpty == 1) && storeValid && pairErrSync && modalOk && deckViewOk

def deckSignalsMatchView(t: Timeline): Verdict =
  Verdict.every(t, i => checkDeckState(t, i))

def acceptButtonQueuesDecision(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Accept", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "swipe") == 0 && (Timeline.signalInt(t, before, "cardCount") == 0 || Timeline.signalInt(t, after, "outboxCount") == Timeline.signalInt(t, before, "outboxCount") + 1 && Timeline.signalInt(t, after, "cardCount") == Timeline.signalInt(t, before, "cardCount") - 1 && Timeline.signalStrHas(t, after, "store", "\"kind\":\"accept\""))
})

def rejectButtonQueuesDecision(t: Timeline): Verdict =
  Verdict.onHit(t, "outlined:Reject", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "swipe") == 0 && (Timeline.signalInt(t, before, "cardCount") == 0 || Timeline.signalInt(t, after, "outboxCount") == Timeline.signalInt(t, before, "outboxCount") + 1 && Timeline.signalInt(t, after, "cardCount") == Timeline.signalInt(t, before, "cardCount") - 1 && Timeline.signalStrHas(t, after, "store", "\"kind\":\"reject\""))
})

private def checkSkipHit(t: Timeline, before: Int, after: Int): Bool =
  for {
    prevCards = Timeline.signalInt(t, before, "cardCount")
    prevOut = Timeline.signalInt(t, before, "outboxCount")
    reason = Timeline.signalInt(t, before, "skipReason")
    reasonSaved = (reason != 1 || Timeline.signalStrHas(t, after, "store", "\"reason\":\"no-visible-difference\"")) && (reason != 2 || Timeline.signalStrHas(t, after, "store", "\"reason\":\"need-another-scenario\"")) && (reason != 3 || Timeline.signalStrHas(t, after, "store", "\"reason\":\"outside-my-goal\"")) && (reason != 0 || Timeline.signalStrHas(t, after, "store", "\"kind\":\"skip\"") && (prevOut != 0 || Timeline.signalStrHas(t, after, "store", "\"reason\":\"\"")))
  } yield Timeline.signalInt(t, after, "swipe") == 0 && (prevCards == 0 && Timeline.signalInt(t, after, "outboxCount") == prevOut || prevCards > 0 && Timeline.signalInt(t, after, "outboxCount") == prevOut + 1 && Timeline.signalInt(t, after, "cardCount") == prevCards - 1 && reasonSaved)

def skipButtonQueuesDecision(t: Timeline): Verdict =
  Verdict.onHit(t, "textbutton:Skip", pair => pair match {
  case (before, after) => checkSkipHit(t, before, after)
})

def skipReasonSegmentedSelection(t: Timeline): Verdict =
  Verdict.and(Verdict.onHit(t, "choicechip:None", pair => pair match {
  case (_, after) => Timeline.signalInt(t, after, "skipReason") == 0
}), Verdict.and(Verdict.onHit(t, "choicechip:No diff", pair => pair match {
  case (_, after) => Timeline.signalInt(t, after, "skipReason") == 1
}), Verdict.and(Verdict.onHit(t, "choicechip:Need scenario", pair => pair match {
  case (_, after) => Timeline.signalInt(t, after, "skipReason") == 2
}), Verdict.onHit(t, "choicechip:Off goal", pair => pair match {
  case (_, after) => Timeline.signalInt(t, after, "skipReason") == 3
}))))

def chooseLaneAQueuesDecision(t: Timeline): Verdict =
  Verdict.onHit(t, "outlined:Choose A", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "swipe") == 0 && (Timeline.signalInt(t, before, "cardCount") == 0 || Timeline.signalInt(t, after, "outboxCount") == Timeline.signalInt(t, before, "outboxCount") + 1 && Timeline.signalInt(t, after, "cardCount") == Timeline.signalInt(t, before, "cardCount") - 1 && (!(Timeline.signalInt(t, before, "outboxCount") == 0 && Timeline.a11yHas(t, before, "text:Card aaaaaaaa | Remaining: 3")) || Timeline.signalStrHas(t, after, "store", "\"kind\":\"reject\"")))
})

def chooseLaneBQueuesDecision(t: Timeline): Verdict =
  Verdict.onHit(t, "outlined:Choose B", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "swipe") == 0 && (Timeline.signalInt(t, before, "cardCount") == 0 || Timeline.signalInt(t, after, "outboxCount") == Timeline.signalInt(t, before, "outboxCount") + 1 && Timeline.signalInt(t, after, "cardCount") == Timeline.signalInt(t, before, "cardCount") - 1 && (!(Timeline.signalInt(t, before, "outboxCount") == 1 && !Timeline.signalStrHas(t, before, "store", "\"kind\":\"accept\"") && Timeline.a11yHas(t, before, "text:Card bbbbbbbb | Remaining: 2")) || !Timeline.signalStrHas(t, after, "store", "\"kind\":\"accept\"")))
})

def swipeSliderCommitsOrResets(t: Timeline): Verdict =
  Verdict.onHit(t, "slider:Swipe card", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "swipe") == 0 && (Timeline.signalInt(t, after, "outboxCount") == Timeline.signalInt(t, before, "outboxCount") && Timeline.signalInt(t, after, "cardCount") == Timeline.signalInt(t, before, "cardCount") || Timeline.signalInt(t, before, "cardCount") > 0 && Timeline.signalInt(t, after, "outboxCount") == Timeline.signalInt(t, before, "outboxCount") + 1 && Timeline.signalInt(t, after, "cardCount") == Timeline.signalInt(t, before, "cardCount") - 1)
})

def queueSteerUpdatesOutboxOrAlerts(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Queue steer", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "outboxCount") == Timeline.signalInt(t, before, "outboxCount") + 1 && Timeline.signalStrHas(t, after, "steerInput", "") || Timeline.signalInt(t, after, "outboxCount") == Timeline.signalInt(t, before, "outboxCount") && Timeline.signalInt(t, after, "hasAlert") == 1
})

def dismissAlertHidesBanner(t: Timeline): Verdict =
  Verdict.onHit(t, "textbutton:Dismiss alert", pair => pair match {
  case (_, after) => Timeline.signalInt(t, after, "hasAlert") == 0
})

private def checkSavePairingHit(t: Timeline, before: Int, after: Int): Bool =
  for {
    badHost = Timeline.signalStrHas(t, before, "hostInput", "/") && Timeline.signalStrHas(t, before, "portInput", "18795")
    badPort = Timeline.signalStrHas(t, before, "portInput", "70000")
    badTok = Timeline.signalStrHas(t, before, "hostInput", "127.0.0.1") && Timeline.signalStrHas(t, before, "portInput", "18795") && Timeline.signalStrHas(t, before, "tokenInput", "short")
    knownValid = Timeline.signalStrHas(t, before, "hostInput", "127.0.0.1") && Timeline.signalStrHas(t, before, "portInput", "18795") && (Timeline.signalStrHas(t, before, "tokenInput", "pairing-token-1234") || Timeline.signalStrHas(t, before, "tokenInput", "wrong-token-123456"))
    openAfter = Timeline.signalInt(t, after, "pairOpen")
    knownErrOk = (!badHost || openAfter == 1 && Timeline.signalStrHas(t, after, "pairErr", "Host is invalid") && Timeline.a11yHas(t, after, "text:Host is invalid")) && (!badPort || openAfter == 1 && Timeline.signalStrHas(t, after, "pairErr", "Port must be 1..65535") && Timeline.a11yHas(t, after, "text:Port must be 1..65535")) && (!badTok || openAfter == 1 && Timeline.signalStrHas(t, after, "pairErr", "Bearer token must be 16..128 URL-safe chars") && Timeline.a11yHas(t, after, "text:Bearer token must be 16..128 URL-safe chars"))
    knownValidOk = !knownValid || openAfter == 0
    errBranch = openAfter == 1 && Timeline.signalInt(t, after, "hasPairErr") == 1 && !Timeline.signalStrHas(t, after, "pairErr", "") && Timeline.signalInt(t, after, "hasAlert") == Timeline.signalInt(t, before, "hasAlert") && !Timeline.effectHas(t, after, "Fs.write") && Timeline.fileSame(t, before, after, ".scuzz/ide-mobile/state.json")
    alertClearedOk = (!Timeline.signalStrHas(t, before, "store", "\"alert\":\"401 ") || Timeline.signalInt(t, after, "hasAlert") == 0) && (!Timeline.signalStrHas(t, before, "store", "\"alert\":\"Enter a steer prompt\"") || Timeline.signalInt(t, after, "hasAlert") == 1)
    okBranch = openAfter == 0 && Timeline.signalInt(t, after, "hasPairErr") == 0 && Timeline.signalStrHas(t, after, "pairErr", "") && (Timeline.signalStrHas(t, after, "syncStatus", "Paired") || Timeline.signalStrHas(t, after, "syncStatus", "Storage write failed")) && alertClearedOk
  } yield Timeline.signalInt(t, after, "outboxCount") == Timeline.signalInt(t, before, "outboxCount") && knownErrOk && knownValidOk && (errBranch || okBranch)

def pairOverlayOpensAndCloses(t: Timeline): Verdict =
  Verdict.and(Verdict.onHit(t, "outlined:Pair", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "pairOpen") == 1 && Timeline.signalInt(t, after, "hasPairErr") == 0 && Timeline.signalStrHas(t, after, "pairErr", "") && (!Timeline.signalStrHas(t, before, "store", "\"host\":\"127.0.0.1\",\"port\":18795,\"token\":\"pairing-token-1234\"") || Timeline.signalStrHas(t, after, "hostInput", "127.0.0.1") && Timeline.signalStrHas(t, after, "portInput", "18795") && Timeline.signalStrHas(t, after, "tokenInput", "pairing-token-1234"))
}), Verdict.and(Verdict.onHit(t, "textbutton:Close pairing", pair => pair match {
  case (before, after) => Timeline.signalInt(t, after, "pairOpen") == 0 && Timeline.signalInt(t, after, "hasPairErr") == 0 && Timeline.signalStrHas(t, after, "pairErr", "") && Timeline.signalInt(t, after, "outboxCount") == Timeline.signalInt(t, before, "outboxCount") && Timeline.fileSame(t, before, after, ".scuzz/ide-mobile/state.json")
}), Verdict.onHit(t, "button:Save pairing", pair => pair match {
  case (before, after) => checkSavePairingHit(t, before, after)
})))

private def checkStorageStep(t: Timeline, a: Int, b: Int): Bool =
  for {
    sameState = Timeline.fileSame(t, a, b, ".scuzz/ide-mobile/state.json")
    wasWriteErr = Timeline.signalStrHas(t, a, "syncStatus", "Storage write failed")
    nowWriteErr = Timeline.signalStrHas(t, b, "syncStatus", "Storage write failed")
    writeNeedsEffect = sameState || Timeline.effectHas(t, b, "Fs.write") && !Timeline.fileTextIs(t, b, ".scuzz/ide-mobile/state.json", "")
    faultEntryOk = !(!wasWriteErr && nowWriteErr) || Timeline.faultKindHas(t, b, "kind=fs") && (Timeline.signalInt(t, b, "outboxCount") >= Timeline.signalInt(t, a, "outboxCount") || Timeline.effectHas(t, b, "Net.httpPost"))
    recoveryOk = !(wasWriteErr && !sameState && !Timeline.faultKindHas(t, b, "kind=fs")) || !nowWriteErr && !Timeline.signalStrHas(t, b, "store", "\"sync_status\":\"Storage write failed\"")
  } yield writeNeedsEffect && faultEntryOk && recoveryOk

def storagePersistAndFaultRecovery(t: Timeline): Verdict =
  Verdict.and(Verdict.every(t, i => i != 0 || Timeline.faultKindHas(t, 0, "kind=fs") && Timeline.signalStrHas(t, 0, "syncStatus", "Storage read failed") || Timeline.signalStrHas(t, 0, "syncStatus", "Synced rev 0") && !Timeline.fileTextIs(t, 0, ".scuzz/ide-mobile/state.json", "")), Verdict.stepEvery(t, pair => pair match {
  case (a, b) => checkStorageStep(t, a, b)
}))

def syncButtonPreservesOutbox(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Sync", pair => pair match {
  case (before, after) => (Timeline.signalStrHas(t, before, "store", "\"token\":\"\"") && Timeline.signalInt(t, after, "busy") == 0 || !Timeline.signalStrHas(t, before, "store", "\"token\":\"\"") && Timeline.signalInt(t, after, "busy") == 1) && Timeline.signalInt(t, after, "outboxCount") <= Timeline.signalInt(t, before, "outboxCount")
})

def syncSettlesAndNeverDropsSilently(t: Timeline): Verdict =
  Verdict.and(Verdict.every(t, i => !Timeline.lastHitHas(t, i, "button:Sync") || !Timeline.signalStrHas(t, Timeline.len(t) - 1, "syncStatus", "Syncing") && Timeline.signalInt(t, Timeline.len(t) - 1, "busy") == 0), Verdict.stepEvery(t, pair => pair match {
  case (a, b) => (Timeline.signalInt(t, b, "outboxCount") >= Timeline.signalInt(t, a, "outboxCount") || Timeline.effectHas(t, b, "Net.httpPost")) && (!(Timeline.signalStrHas(t, b, "syncStatus", "401 unauthorized") && Timeline.effectHas(t, b, "Net.httpPost") && !Timeline.driveHas(t, b, "unauthorizedKeepsOutbox")) || !Timeline.effectHas(t, b, "Net.httpGet"))
}))

def e2eOfflineRestartAndFlushClaim(t: Timeline): Verdict =
  Verdict.stepEvery(t, pair => pair match {
  case (a, b) => !Timeline.driveHas(t, b, "offlineSwipeSteerRestartFlush") || (Timeline.effectCount(t, b) == 0 || Timeline.effectHas(t, b, "Net.httpPost") && Timeline.effectHas(t, b, "Net.httpGet") && Timeline.effectHas(t, b, "Fs.write")) && Timeline.fileTextIs(t, b, "obs/e2e.txt", "ok:rev=4;cards=dddd;steer=keep layout compact") && Timeline.fileTextIs(t, b, "sim/e2e/main.txt", "alpha") || faulted(t, b) && (Timeline.fileSame(t, a, b, "obs/e2e.txt") || Timeline.fileTextIs(t, b, "obs/e2e.txt", "incomplete") || Timeline.fileTextIs(t, b, "sim/e2e/main.txt", "v0") || Timeline.fileTextIs(t, b, "sim/e2e/main.txt", "alpha"))
})

def idempotentAndChunkedBatchClaims(t: Timeline): Verdict =
  Verdict.stepEvery(t, pair => pair match {
  case (a, b) => (!Timeline.driveHas(t, b, "retryIdempotentBatch") || Timeline.fileTextIs(t, b, "obs/idempotent.txt", "ok:replayed=4;steers=1;outbox=0") && Timeline.fileTextIs(t, b, "sim/idem/main.txt", "alpha") || faulted(t, b) && (Timeline.fileSame(t, a, b, "obs/idempotent.txt") || Timeline.fileTextIs(t, b, "obs/idempotent.txt", "mismatch") || Timeline.fileTextIs(t, b, "sim/idem/main.txt", "v0") || Timeline.fileTextIs(t, b, "sim/idem/main.txt", "alpha"))) && (!Timeline.driveHas(t, b, "chunkedLargeOutbox") || Timeline.fileTextIs(t, b, "obs/chunked.txt", "ok:batches=64,2;steers=66;outbox=0") || faulted(t, b) && (Timeline.fileSame(t, a, b, "obs/chunked.txt") || Timeline.fileTextIs(t, b, "obs/chunked.txt", "mismatch")))
})

def conflictAuthAndRecoveryClaims(t: Timeline): Verdict =
  Verdict.stepEvery(t, pair => pair match {
  case (a, b) => (!Timeline.driveHas(t, b, "staleAndDirtyHandling") || Timeline.fileTextIs(t, b, "obs/conflicts.txt", "ok:dirty-and-stale-flagged") && Timeline.fileTextIs(t, b, "sim/conf/main.txt", "external") || faulted(t, b) && (Timeline.fileSame(t, a, b, "obs/conflicts.txt") || Timeline.fileTextIs(t, b, "obs/conflicts.txt", "mismatch"))) && (!Timeline.driveHas(t, b, "unauthorizedKeepsOutbox") || Timeline.fileTextIs(t, b, "obs/auth.txt", "ok:401-kept=2;flushed=0;main=alpha") && Timeline.fileTextIs(t, b, "sim/auth/main.txt", "alpha") || faulted(t, b) && (Timeline.fileSame(t, a, b, "obs/auth.txt") || Timeline.fileTextIs(t, b, "obs/auth.txt", "mismatch"))) && (!Timeline.driveHas(t, b, "corruptStoreRecovery") || Timeline.fileTextIs(t, b, "obs/corrupt.txt", "ok:recovered") || faulted(t, b) && (Timeline.fileSame(t, a, b, "obs/corrupt.txt") || Timeline.fileTextIs(t, b, "obs/corrupt.txt", "mismatch")))
})

