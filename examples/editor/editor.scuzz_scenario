def queueFlow(phase: Int where phase >= 0 && phase <= 9): IO[Unit] =
  for {
    original <- proofCard(1)
    _ <- Fs.delete(Cards.cardDir("proof", Cards.str(original, "id")))
    session <- Session.create("proof")
    lanes = proofLanes()
    deck = proofDeck(session, lanes)
    result = Signal.make(0)
    _ <- Main.queueInit("proof", deck)
    _ <- if (phase == 0) for {
  generationToken <- Uuid.v4()
  reviewToken <- Uuid.v4()
  thirdToken <- Uuid.v4()
  tokens = (generationToken, reviewToken)
  reserved <- IO.both(Main.queueReserve(deck, "generate", generationToken), Main.queueReserve(deck, "review", reviewToken))
  third <- Main.queueReserve(deck, "generate", thirdToken)
  _ <- Main.queueStage(deck, tokens._1, "published", "p")
  _ <- Main.queueCleanup(deck, tokens._1, "generate")
  blocked <- Main.queueClaimPublished(deck, thirdToken)
  _ <- Main.queueRelease(deck, tokens._2, false)
  firstClaim <- Uuid.v4()
  secondClaim <- Uuid.v4()
  claims <- IO.both(Main.queueClaimPublished(deck, firstClaim), Main.queueClaimPublished(deck, secondClaim))
  winner = if (Str.isEmpty(claims._1.token)) claims._2 else claims._1
  _ <- Main.queueCleanup(deck, tokens._1, "generate")
  q <- Main.queueRead(deck)
  _ = Signal.set(result, if (reserved._1 && reserved._2 && !third && Str.isEmpty(blocked.token) && Str.isEmpty(claims._1.token) != Str.isEmpty(claims._2.token) && List.len(q.slots) == 1 && List.at(q.slots, 0).token == winner.token && winner.token != tokens._1 && !q.retry) 1 else 0)
