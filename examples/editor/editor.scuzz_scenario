def setup(): IO[Unit] =
  for {
    _ <- Fs.write("scuzz.toml", "[package]\nname = \"editor\"\nversion = \"0.1.0\"\n")
    _ <- Fs.mkdirs("src")
    _ <- Fs.write("src/Main.scuzz", "def twice(n: Int): Int =\n  n + n\n\n@main def main: IO[Unit] =\n  for {\n    _ <- IO.println(twice(2))\n    _ <- IO.println(1 + \"x\")\n  } yield ()\n")
    _ <- Fs.mkdirs("build/proposals/p1/src")
    _ <- Fs.write("build/proposals/p1/src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(2)
""")
    _ <- Fs.mkdirs("build/proposals/p2/src")
    _ <- Fs.write("build/proposals/p2/src/Other.scuzz", """def other(): Int =
  1
""")
    _ <- Fs.mkdirs("build/proposals/p3/src")
    _ <- Fs.write("build/proposals/p3/src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(3)
""")
    baseline <- Cards.own(".")
    _ <- writeManualRequest(".")
    _ <- IO.foreachDiscard(["p1", "p2", "p3"], n => for {
  dir = Fs.join("build/proposals", n)
  ents <- Fs.walk(dir)
  files <- IO.foreach(List.map(List.filter(ents, e => !e._2), e => e._1), p => Fs.read(Fs.join(dir, p)).map(src => (p, src)))
  _ <- Fs.write(Fs.join(dir, "proposal.json"), Cards.metadata("manual", Cards.setHash(baseline), "manual", files))
} yield ())
    _ <- Main.startDiff(".")
  } yield ()

