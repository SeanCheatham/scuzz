def Cards.replayRuleWorkloads(_root: String, _toml: String, verPairsWithRule: List[(String, String)], filesWithRule: List[(String, String)], witness: Json): IO[(List[Json], String, String)] =
  IO.pure(for {
  mainSrc = List.getOrElse(List.map(filesWithRule, f => f._2), List.indexOf(List.map(filesWithRule, f => f._1), "Main"), "")
  countVal = if (Str.contains(mainSrc, "IO.println(\"3\")") || Str.contains(mainSrc, "IO.println(3)")) "3" else if (Str.contains(mainSrc, "IO.println(\"2\")") || Str.contains(mainSrc, "IO.println(2)")) "2" else "1"
  tlIdle = """# timeline v=3 n=1
--- 0 checkpoint=1
a11y:
text:Counter
"""
  tlSeed = simSeedTimeline(countVal)
  witLabel = Str.concat("witness (", Str.concat(Cards.str(witness, "workload"), ")"))
  runs = [("idle", tlIdle), ("seed count 1", tlSeed), (witLabel, tlSeed)]
  evaluated = List.map(runs, r => (r._1, simEvalTimeline(verPairsWithRule, r._2)))
  workRows = List.map(evaluated, e => Json.Obj([("label", Json.Str(e._1)), ("ok", Json.Bool(Str.isEmpty(e._2._1))), ("why", if (Str.isEmpty(e._2._1)) Json.Null() else Json.Str(e._2._1))]))
  trigDump = List.join(List.flatMap(evaluated, e => e._2._2), """
""")
  claimDump = List.join(List.flatMap(evaluated, e => e._2._3), """
""")
} yield (workRows, trigDump, claimDump))

