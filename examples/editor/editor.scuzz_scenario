def setup(): IO[Unit] =
  for {
    _ <- Fs.write("scuzz.toml", "[package]\nname = \"editor\"\nversion = \"0.1.0\"\n")
    _ <- Fs.mkdirs("src")
    _ <- Fs.write("src/Main.scuzz", "def twice(n: Int): Int =\n  n + n\n\n@main def main: IO[Unit] =\n  for {\n    _ <- IO.println(twice(2))\n    _ <- IO.println(1 + \"x\")\n  } yield ()\n")
    _ <- Fs.mkdirs("build/proposals/p1/src")
    _ <- Fs.write("build/proposals/p1/src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(2)
""")
    _ <- Fs.mkdirs("build/proposals/p2/src")
    _ <- Fs.write("build/proposals/p2/src/Other.scuzz", """def other(): Int =
  1
""")
    _ <- Fs.mkdirs("build/proposals/p3/src")
    _ <- Fs.write("build/proposals/p3/src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(3)
""")
    _ <- Main.startDiff(".")
  } yield ()

def Main.runProject(_root: String): IO[String] =
  IO.pure("run ok")

def Main.startFuzz(root: String): IO[Int] =
  for {
    build = Fs.join(root, "build")
    fuzz = Fs.join(build, "fuzz")
    _ <- Fs.mkdirs(build).handleErrorWith(_ => IO.pure(()))
    _ <- Fs.mkdirs(fuzz).handleErrorWith(_ => IO.pure(()))
    _ <- Fs.write(Fs.join(build, "sometimes.declared"), """tappedPlus
neverHit
""")
    _ <- Fs.write(Fs.join(build, "triggers.declared"), """outlined:Check
""")
    _ <- Fs.write(Fs.join(fuzz, "sometimes.dump"), """tappedPlus
""")
    _ <- Fs.write(Fs.join(fuzz, "triggers.dump"), """claim	outlined:Check	triggered
""")
    _ <- Fs.write(Fs.join(fuzz, "summary.json"), "{\"v\":1,\"kind\":\"fuzz\",\"fuzz\":{\"ok\":true}}\n")
  } yield 1

def Main.startDiff(root: String): IO[Int] =
  for {
    build = Fs.join(root, "build")
    delta = Fs.join(build, "delta")
    _ <- Fs.mkdirs(build).handleErrorWith(_ => IO.pure(()))
    _ <- Fs.mkdirs(delta).handleErrorWith(_ => IO.pure(()))
    _ <- Fs.write(Fs.join(delta, "report.json"), "{\"v\":1,\"kind\":\"diff\",\"rev\":\"HEAD\",\"counts\":{\"regressed\":1,\"fixed\":0,\"diverged\":0,\"unrunnable\":0,\"same\":1},\"workloads\":[{\"label\":\"idle\",\"class\":\"regressed\",\"delta\":{\"first\":1},\"timelines\":{\"a\":\"tl-a.txt\",\"b\":\"tl-b.txt\"}},{\"label\":\"corpus/same.toml\",\"class\":\"same\",\"delta\":{\"first\":-1},\"timelines\":null}]}\n")
    _ <- Fs.write(Fs.join(delta, "tl-a.txt"), """# timeline v=3 n=2
--- 0 checkpoint=1
drive:
setup
signals:
count=0
a11y:
text:Counter
text:count = 0
button:+1
--- 1 checkpoint=1
drive:
tap button:+1
signals:
count=1
a11y:
text:Counter
text:count = 1
button:+1
""")
    _ <- Fs.write(Fs.join(delta, "tl-b.txt"), """# timeline v=3 n=2
--- 0 checkpoint=1
drive:
setup
signals:
count=0
a11y:
text:Counter
text:count = 0
button:+1
--- 1 checkpoint=1
drive:
tap button:+1
signals:
count=2
a11y:
text:Counter
text:count = 2
button:+1
""")
  } yield 1

