private def ownershipAction(started: Signal[Int], active: Signal[Int], peak: Signal[Int], ended: Signal[Int]): IO[Unit] =
  IO.ensure(IO.pure(()).map(_ => for {
  _ = Signal.set(started, Signal.get(started) + 1)
  _ = Signal.set(active, Signal.get(active) + 1)
  _ = Signal.set(peak, if (Signal.get(peak) > Signal.get(active)) Signal.get(peak) else Signal.get(active))
} yield ()).flatMap(_ => IO.sleep(100)), IO.pure(()).map(_ => for {
  _ = Signal.set(active, Signal.get(active) - 1)
  _ = Signal.set(ended, Signal.get(ended) + 1)
} yield ()))

def ownershipFlow(phase: Int): IO[Unit] =
  for {
    jobs <- Ref.of(Session.OwnedJob("", []: List[Fiber[Unit]], false))
    s = SessionS(Signal.make("One objective"), Signal.make("src/Main.scuzz"), Signal.make(0), Signal.make("smollm3-3b"), Signal.make(1), Signal.make(0), Signal.make(""), Signal.make(""), Signal.make(0), jobs, "", Signal.make(""), Signal.make([]: List[Json]), Signal.make(0), Signal.make(0))
