private def waitPreparation(s: SessionS, remaining: Int): IO[Unit] =
  Ref.get(s.reviews).flatMap(owner => if (Str.isEmpty(owner.token)) IO.pure(()) else if (remaining <= 0) IO.fail("controlled preparation did not finish") else IO.sleep(1).flatMap(_ => waitPreparation(s, remaining - 1)))

