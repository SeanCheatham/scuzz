def proofCard(flip: Int): IO[Json] =
  for {
    _ <- Fs.delete("proof").handleErrorWith(_ => IO.pure(()))
    _ <- Fs.mkdirs("proof/src")
    _ <- Fs.write("proof/compiler-id", Hash.sha256("controlled review compiler"))
    _ <- Cards.setupStorage("proof")
    _ <- Fs.write("proof/.scuzz/ide/session.json", "{\"model\":\"smollm3-3b\"}")
    _ <- Fs.mkdirs("proof/dependency/src")
    _ <- Fs.write("proof/dependency/scuzz.toml", "[package]\nname = \"dependency\"\n")
    _ <- Fs.write("proof/dependency/src/Dependency.scuzz", """def value(): Int =
  1
""")
    _ <- Fs.write("proof/scuzz.toml", "[package]\nname = \"proof\"\n[dependencies]\ndependency = { path = \"dependency\" }\n")
    _ <- Fs.write("proof/src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(1)
""")
    _ <- Fs.mkdirs("proof/build/proposals/p/src")
    props = [("src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(2)
"""), ("src/Other.scuzz", """def other(): Int =
  3
""")]
    _ <- IO.foreachDiscard(props, p => Fs.write(Fs.join("proof/build/proposals/p", p._1), p._2))
    disk <- Cards.own("proof")
    _ <- writeManualRequest("proof")
    _ <- Fs.write("proof/build/proposals/p/proposal.json", Cards.metadata("manual", Cards.setHash(disk), "manual", props))
    imported <- Cards.importProposal("proof", "p")
    c <- Cards.freeze("proof", "p", imported, flip)
    _ <- Main.reviewProposal("proof", "", [], [])
    raw <- Fs.read("proof/build/ide/report.json")
    ready <- Cards.complete("proof", c, raw)
  } yield ready

def laneFlow(flip: Int, lane: Int): IO[Unit] =
  for {
    chosenFlip = if (flip == 0) 0 else 1
    chosenLane = if (lane == 0) 0 else if (lane == 1) 1 else -1
    proofCase = Signal.make(chosenFlip * 3 + chosenLane + 1)
    _ = Signal.set(proofCase, chosenFlip * 3 + chosenLane + 1)
    c <- proofCard(chosenFlip)
    _ <- Cards.decide("proof", c, chosenLane)
    _ <- Cards.decide("proof", c, chosenLane).handleErrorWith(_ => IO.pure(()))
    _ <- Fs.delete("proof/build")
  } yield ()

def requestFlow(mode: Int where mode >= 0 && mode <= 6): IO[Unit] =
  for {
    original <- proofCard(1)
    _ <- Fs.write("proof/.scuzz/ide/session.json", "{\"model\":\"smollm3-3b\"}")
    frozen <- Cards.freeze("proof", "p", Cards.propsOf(original), 1)
    card <- Cards.complete("proof", frozen, Cards.text(Proposal.field(original, "evidence")))
    rawRequest <- Fs.read("proof/build/ide/request.json")
    request <- Proposal.parse(rawRequest, 1048576)
    id <- Uuid.v4()
    next = Json.set(request, "request", Json.Str(id))
    changed = if (mode == 1) Json.set(next, "objective", Json.Str("A different objective")) else if (mode == 2) Json.set(next, "allowed", Json.Arr([Json.Str("src/Other.scuzz")])) else if (mode == 3) Json.set(next, "limits", Json.Obj([])) else if (mode == 5) Json.set(next, "feedback", Json.Arr([Json.Obj([("decision", Json.Str("baseline"))])])) else if (mode == 6) Json.set(next, "feedback", Json.Str("invalid feedback")) else next
    _ <- Fs.write("proof/build/ide/request.json", Cards.text(changed))
    _ <- if (mode == 4) Fs.write("proof/.scuzz/ide/session.json", "{\"model\":\"qwen2.5-coder-7b\"}") else IO.pure(())
    accepted <- Cards.decide("proof", card, 0).map(_ => 1).handleErrorWith(_ => IO.pure(0))
    saved <- Fs.read(Fs.join(Cards.cardDir("proof", Cards.str(card, "id")), "card.json"))
    same = Cards.text(Proposal.field(LspClient.parseJson(saved), "request")) == Cards.text(request)
    requestAccepted = Signal.make(accepted)
    requestStable = Signal.make(if (accepted == (if (mode == 0 || mode == 5) 1 else 0) && same) 1 else 0)
    _ = Signal.set(requestAccepted, accepted)
    _ = Signal.set(requestStable, Signal.get(requestStable))
  } yield ()

def requestImportFlow(mode: Int where mode >= 0 && mode <= 5): IO[Unit] =
  for {
    card <- proofCard(1)
    request = Proposal.field(card, "request")
    _ <- Cards.rememberRequest("proof", request)
    id <- Uuid.v4()
    next = Json.set(Json.set(request, "request", Json.Str(id)), "feedback", Json.Arr([Json.Obj([("decision", Json.Str("baseline"))])]))
    _ <- Fs.write("proof/build/ide/request.json", Cards.text(next))
    archive = Fs.join("proof/.scuzz/ide/requests", Str.concat(Cards.str(request, "request"), ".json"))
    frozenArchive <- Cards.requestArchive("proof", Cards.str(request, "request"))
    _ <- if (mode == 1) Fs.delete(archive) else if (mode == 2) Fs.write(archive, Cards.text(Json.set(frozenArchive, "request", Json.set(request, "request", Json.Str("wrong"))))) else if (mode == 3) Fs.write(archive, Cards.text(Json.set(frozenArchive, "request", Json.set(request, "objective", Json.Str("Another objective"))))) else if (mode == 4) Fs.write("proof/src/Main.scuzz", "changed baseline") else if (mode == 5) Fs.write("proof/build/proposals/p/proposal.json", Cards.text(Json.set(LspClient.parseJson(Cards.str(card, "publication")), "request", Json.Str("../escape")))) else IO.pure(())
    matched <- (for {
  props <- Cards.importProposal("proof", "p")
  frozen <- Cards.freeze("proof", "p", props, 0)
} yield Cards.text(Proposal.field(frozen, "request")) == Cards.text(request) && Cards.setHash(props) == Cards.setHash(Cards.propsOf(card))).handleErrorWith(_ => IO.pure(false))
    requestImportBound = Signal.make(if (matched == (mode == 0)) 1 else 0)
    _ = Signal.set(requestImportBound, Signal.get(requestImportBound))
  } yield ()

def requestModelFlow(mode: Int where mode >= 0 && mode <= 5): IO[Unit] =
  for {
    card <- proofCard(1)
    s <- Session.create("proof")
    request <- Session.exportRequest("proof", s, false)
    _ <- publishQueue("p-bind", Cards.propsOf(card))
    _ = if (mode == 1) Signal.set(s.model, "qwen2.5-coder-7b") else if (mode == 2) Signal.set(s.mode, 1) else if (mode == 3) Signal.set(s.count, 1) else ()
    next <- Session.exportRequest("proof", s, mode == 0 || mode == 3)
    archive = Cards.requestArchivePath("proof", Cards.str(request, "request"))
    frozen <- Cards.requestArchive("proof", Cards.str(request, "request"))
    _ <- if (mode == 4) Fs.write(archive, Cards.text(Json.set(frozen, "session", Json.Str("another model")))) else if (mode == 5) Fs.delete(archive) else IO.pure(())
    matched <- (for {
  props <- Cards.importProposal("proof", "p-bind")
  imported <- Cards.freeze("proof", "p-bind", props, 1)
} yield Cards.text(Proposal.field(imported, "request")) == Cards.text(request)).handleErrorWith(_ => IO.pure(false))
    requestModelBound = Signal.make(if (matched == (mode == 0 || mode == 3) && (mode >= 4 || Cards.str(next, "request") != Cards.str(request, "request"))) 1 else 0)
    _ = Signal.set(requestModelBound, Signal.get(requestModelBound))
  } yield ()

