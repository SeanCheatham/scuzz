def LspClient.lspCall(_root: String, _path: String, _body: String, method: String): IO[Json] =
  IO.pure(parseJson(method match {
  case "textDocument/hover" => "{\"result\":{\"contents\":{\"kind\":\"plaintext\",\"value\":\"hover\"}}}"
  case "textDocument/completion" => "{\"result\":{\"items\":[{\"label\":\"foo\"}]}}"
  case "textDocument/definition" => "{\"result\":[{\"uri\":\"\",\"range\":{\"start\":{\"line\":0,\"character\":0}}}]}"
  case "textDocument/formatting" => "{\"result\":[]}"
  case "textDocument/rename" => "{\"result\":{\"changes\":{\"file://x\":[{\"newText\":\"\"}]}}}"
  case "textDocument/codeAction" => "{\"result\":[{\"title\":\"fix\",\"edit\":{\"changes\":{\"file://x\":[{\"newText\":\"fixed\"}]}}}]}"
  case "textDocument/semanticTokens/full" => "{\"result\":{\"data\":[0,0,5,8,0]}}"
  case "textDocument/inlayHint" => "{\"result\":[{\"position\":{\"line\":0,\"character\":5},\"label\":\"Int\"}]}"
  case "textDocument/foldingRange" => "{\"result\":[{\"startLine\":0,\"endLine\":1}]}"
  case _ => "{\"result\":{\"data\":[1]}}"
}))

def Cards.compilerIdentity(): IO[String] =
  Fs.read("proof/compiler-id").handleErrorWith(_ => IO.pure(Hash.sha256("controlled review compiler")))

def proofCard(flip: Int): IO[Json] =
  for {
    _ <- Fs.delete("proof").handleErrorWith(_ => IO.pure(()))
    _ <- Fs.mkdirs("proof/src")
    _ <- Fs.write("proof/compiler-id", Hash.sha256("controlled review compiler"))
    _ <- Fs.mkdirs("proof/dependency/src")
    _ <- Fs.write("proof/dependency/scuzz.toml", "[package]\nname = \"dependency\"\n")
    _ <- Fs.write("proof/dependency/src/Dependency.scuzz", """def value(): Int =
  1
""")
    _ <- Fs.write("proof/scuzz.toml", "[package]\nname = \"proof\"\n[dependencies]\ndependency = { path = \"dependency\" }\n")
    _ <- Fs.write("proof/src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(1)
""")
    _ <- Fs.mkdirs("proof/build/proposals/p/src")
    props = [("src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(2)
"""), ("src/Other.scuzz", """def other(): Int =
  3
""")]
    _ <- IO.foreachDiscard(props, p => Fs.write(Fs.join("proof/build/proposals/p", p._1), p._2))
    disk <- Cards.own("proof")
    _ <- Fs.write("proof/build/proposals/p/proposal.json", Cards.metadata("manual", Cards.setHash(disk), "manual", props))
    imported <- Cards.importProposal("proof", "p")
    c <- Cards.freeze("proof", "p", imported, flip)
    _ <- Main.reviewProposal("proof", "", [], [])
    raw <- Fs.read("proof/build/ide/report.json")
    ready <- Cards.complete("proof", c, raw)
  } yield ready

def laneFlow(flip: Int, lane: Int): IO[Unit] =
  for {
    chosenFlip = if (flip == 0) 0 else 1
    chosenLane = if (lane == 0) 0 else if (lane == 1) 1 else -1
    proofCase = Signal.make(chosenFlip * 3 + chosenLane + 1)
    _ = Signal.set(proofCase, chosenFlip * 3 + chosenLane + 1)
    c <- proofCard(chosenFlip)
    _ <- Cards.decide("proof", c, chosenLane)
    _ <- Cards.decide("proof", c, chosenLane).handleErrorWith(_ => IO.pure(()))
    _ <- Fs.delete("proof/build")
  } yield ()

def journalFlow(mode: Int): IO[Unit] =
  for {
    selectedMode = if (mode <= 0) 0 else if (mode > 5) 5 else mode
    proofCase = Signal.make(selectedMode)
    _ = Signal.set(proofCase, selectedMode)
    c <- proofCard(1)
    op = Cards.operation(c, 0, 1)
    _ <- Fs.write("proof/.scuzz/ide/journal.json", Cards.text(op))
    _ <- Cards.writeOne("proof", List.at(Json.arr(Diags.jsonField(op, "writes")), 0))
    _ <- if (selectedMode == 1) Fs.write("proof/src/Main.scuzz", "external bytes") else IO.pure(())
    _ <- Cards.recover("proof").handleErrorWith(_ => IO.pure(()))
    _ <- Cards.recover("proof").handleErrorWith(_ => IO.pure(()))
    _ <- if (selectedMode == 2) Cards.undo("proof") else IO.pure(())
    _ <- if (selectedMode == 3) Fs.write("proof/src/Main.scuzz", "external bytes").flatMap(_ => Cards.undo("proof").handleErrorWith(_ => IO.pure(()))) else IO.pure(())
    _ <- if (selectedMode >= 4) for {
  reverse = Cards.undoOperation(op, 2)
  _ <- Fs.write("proof/.scuzz/ide/journal.json", Cards.text(reverse))
  _ <- Cards.writeOne("proof", List.at(Json.arr(Diags.jsonField(reverse, "writes")), 0))
  _ <- if (selectedMode == 5) Fs.write("proof/src/Main.scuzz", "external bytes") else IO.pure(())
  _ <- Cards.recover("proof").handleErrorWith(_ => IO.pure(()))
  _ <- Cards.recover("proof").handleErrorWith(_ => IO.pure(()))
} yield () else IO.pure(())
    _ <- Fs.delete("proof/build")
  } yield ()

def staleFlow(kind: Int): IO[Unit] =
  for {
    selectedKind = if (kind < 0) 0 else if (kind > 7) 7 else kind
    proofCase = Signal.make(selectedKind)
    _ = Signal.set(proofCase, selectedKind)
    c <- proofCard(1)
    _ <- if (selectedKind == 0) Fs.write("proof/src/Main.scuzz", "external bytes") else if (selectedKind == 1) Fs.write("proof/scuzz.toml", "[package]\nname = \"changed\"\n") else if (selectedKind == 2) Fs.write("proof/build/proposals/p/src/Main.scuzz", "new publication") else if (selectedKind == 3) Fs.write("proof/dependency/src/Dependency.scuzz", "changed dependency") else if (selectedKind == 4) Fs.write("proof/claim.scuzz_verify", "changed verification") else if (selectedKind == 5) Fs.write("proof/driver.scuzz_scenario", "changed scenario") else if (selectedKind == 6) Fs.mkdirs("proof/corpus").flatMap(_ => Fs.write("proof/corpus/new.toml", "changed workload")) else Fs.write("proof/compiler-id", Hash.sha256("changed compiler"))
    _ <- Cards.decide("proof", c, 0).handleErrorWith(_ => IO.pure(()))
  } yield ()

def unsafeFlow(kind: Int): IO[Unit] =
  for {
    mode = if (kind < 0) 0 else if (kind > 6) 6 else kind
    c <- proofCard(1)
    fs = Cards.propsOf(c)
    bad = if (mode == 0) [("src/../Escape.scuzz", "escape")] else if (mode == 1) List.concat(fs, fs) else if (mode == 6) [] else fs
    pub = Cards.metadata("manual", Cards.str(LspClient.parseJson(Cards.str(c, "publication")), "baseline"), "manual", bad)
    _ <- Fs.write("proof/build/proposals/p/proposal.json", pub)
    _ <- if (mode == 2) Fs.write("proof/build/proposals/p/src/Main.scuzz", "unpublished") else if (mode == 3) Fs.write("proof/build/proposals/p/extra.txt", "extra") else if (mode == 4) Fs.write("proof/build/proposals/p/proposal.json", Str.repeat("x", 131073)) else if (mode == 5) Fs.write("proof/dependency/src/Other.scuzz", "duplicate module") else IO.pure(())
    rejected <- Cards.importProposal("proof", "p").map(_ => 0).handleErrorWith(_ => IO.pure(1))
    proofBlocked = Signal.make(rejected)
    _ = Signal.set(proofBlocked, rejected)
  } yield ()

def focusDiagnostic(): IO[Unit] =
  for {
    src <- Fs.read("src/Main.scuzz")
    raw <- Main.analyze("src/Main.scuzz", src)
    rows = Diags.diagRows(LspClient.parseJson(raw))
    _ <- IO.foreachDiscard(rows, row => Diags.jumpDiag(row))
    caret <- Ui.editorCaret()
    diagnosticRows = Signal.make(List.len(rows))
    diagnosticCaret = Signal.make(caret)
    _ = Signal.set(diagnosticRows, List.len(rows))
    _ = Signal.set(diagnosticCaret, caret)
  } yield ()

def bufferedFrames(n: Int): IO[Unit] =
  for {
    count = (n % 8 + 8) % 8
    notice = LspClient.frame(Cards.text(Json.Obj([("method", Json.Str("note"))])))
    first = LspClient.frame(Cards.text(Json.Obj([("id", Json.Int(1)), ("result", Json.Str("é"))])))
    second = LspClient.frame(Cards.text(Json.Obj([("id", Json.Int(2)), ("result", Json.Str("done"))])))
    buffer <- Ref.of(Str.concat(Str.repeat(notice, count), Str.concat(first, second)))
    a <- LspClient.readResult(0, buffer, 1)
    b <- LspClient.readResult(0, buffer, 2)
    rest <- Ref.get(buffer)
    frameFirst = Signal.make(Json.getInt(a, "id", 0))
    frameSecond = Signal.make(Json.getInt(b, "id", 0))
    frameValue = Signal.make(Json.getStr(a, "result", ""))
    frameRest = Signal.make(Str.byteLen(rest))
    _ = Signal.set(frameFirst, Json.getInt(a, "id", 0))
    _ = Signal.set(frameSecond, Json.getInt(b, "id", 0))
    _ = Signal.set(frameValue, Json.getStr(a, "result", ""))
    _ = Signal.set(frameRest, Str.byteLen(rest))
  } yield ()

def exclusionFlow(): IO[Unit] =
  for {
    c <- proofCard(0)
    evidence = Diags.jsonField(c, "evidence")
    rows = List.map(Json.arr(Diags.jsonField(evidence, "workloads")), w => Json.set(w, "class", Json.Str("same")))
    allSame = Json.set(evidence, "workloads", Json.Arr(rows))
    excluded <- Cards.complete("proof", c, Cards.text(allSame))
    exclusion = Signal.make(Cards.str(excluded, "id"))
    _ = Signal.set(exclusion, Cards.str(excluded, "id"))
  } yield ()

def incompleteFlow(mode: Int): IO[Unit] =
  for {
    c <- proofCard(0)
    evidence = Diags.jsonField(c, "evidence")
    review = Diags.jsonField(evidence, "review")
    search = Diags.jsonField(evidence, "search")
    broken = if (mode == 0) Json.set(evidence, "review", Json.set(review, "complete", Json.Bool(false))) else if (mode == 1) Json.set(evidence, "search", Json.set(search, "ran", Json.Int(31))) else Json.set(evidence, "workloads", Json.Arr(List.map(Json.arr(Diags.jsonField(evidence, "workloads")), w => Json.set(w, "why_b", Json.Str("scuzz: claim shared failure")))))
    blocked <- Cards.complete("proof", c, Cards.text(broken)).map(_ => 0).handleErrorWith(_ => IO.pure(1))
    evidenceBlocked = Signal.make(blocked)
    _ = Signal.set(evidenceBlocked, blocked)
  } yield ()

