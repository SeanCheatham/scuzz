private def reviewFixture(raw: String): String =
  for {
    j = LspClient.parseJson(raw)
    initial = List.map(Json.arr(Diags.jsonField(j, "workloads")), w => Json.set(Json.set(w, "why_a", Json.Null()), "events", Json.Arr([Json.Str("count 1"), Json.Str("count 2")])))
    base = List.at(initial, 0)
    search = List.map(List.range(0, 32), i => Json.set(base, "label", Json.Str(Str.concat("search ", Str.fromInt(i)))))
    short = Json.set(Json.set(List.at(initial, 1), "label", Json.Str("witness 0")), "events", Json.Arr([Json.Str("count 1")]))
    rows = List.concat(List.concat(initial, search), [short])
    scope = Json.Obj([("complete", Json.Bool(true)), ("required", Json.Int(List.len(initial))), ("completed_required", Json.Int(List.len(initial))), ("recorded_workloads", Json.Int(List.len(rows))), ("corpus", Json.Int(0)), ("seeds", Json.Int(1)), ("registered_claims", Json.Arr([Json.Str("greetFact")])), ("declared_triggers", Json.Arr([Json.Str("button:+1")])), ("reached_a", Json.Arr([])), ("reached_b", Json.Arr([])), ("reach_scope", Json.Str("required workloads, search, and shrinking probes")), ("parity", Json.Str("evaluator evidence; compiled witness parity is a separate check")), ("alignment", Json.Str("states align by index; added or removed steps can shift the comparison"))])
    report = Json.set(Json.set(Json.set(j, "workloads", Json.Arr(rows)), "review", scope), "search", Json.Obj([("iterations", Json.Int(32)), ("ran", Json.Int(32)), ("seed", Json.Int(1))]))
  } yield Cards.text(report)

