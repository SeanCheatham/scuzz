private def reviewFixture(raw: String): String =
  for {
    j = LspClient.parseJson(raw)
    initial = List.map(Json.arr(Diags.jsonField(j, "workloads")), w => Json.set(Json.set(w, "why_a", Json.Null()), "events", Json.Arr([Json.Str("count 1"), Json.Str("count 2")])))
    base = List.at(initial, 0)
    search = List.map(List.range(0, 32), i => Json.set(base, "label", Json.Str(Str.concat("search ", Str.fromInt(i)))))
    short = Json.set(Json.set(List.at(initial, 1), "label", Json.Str("witness 0")), "events", Json.Arr([Json.Str("count 1")]))
    rows = List.concat(List.concat(initial, search), [short])
    scope = Json.Obj([("complete", Json.Bool(true)), ("required", Json.Int(List.len(initial))), ("completed_required", Json.Int(List.len(initial))), ("recorded_workloads", Json.Int(List.len(rows))), ("corpus", Json.Int(0)), ("seeds", Json.Int(1)), ("registered_claims", Json.Arr([Json.Str("greetFact")])), ("declared_triggers", Json.Arr([Json.Str("button:+1")])), ("reached_a", Json.Arr([])), ("reached_b", Json.Arr([])), ("reach_scope", Json.Str("required workloads, search, and shrinking probes")), ("parity", Json.Str("evaluator evidence; compiled witness parity is a separate check")), ("alignment", Json.Str("states align by index; added or removed steps can shift the comparison"))])
    report = Json.set(Json.set(Json.set(j, "workloads", Json.Arr(rows)), "review", scope), "search", Json.Obj([("iterations", Json.Int(32)), ("ran", Json.Int(32)), ("seed", Json.Int(1))]))
  } yield Cards.text(report)

private def simEvalClaim(d: Parse.Fun, tl: String): (String, List[String]) =
  for {
    states = Lanes.states(tl)
    alwaysNeedles = Verify.callLitsFun(d, "Verdict.alwaysHas", 1)
    alwaysOk = List.forall(alwaysNeedles, needle => List.forall(states, st => List.exists(Lanes.a11yLines(st), l => Str.contains(l, needle))))
    afterPairs = List.zip(Verify.callLitsFun(d, "Verdict.afterHit", 1), Verify.callLitsFun(d, "Verdict.afterHit", 2))
    afterEval = List.map(afterPairs, pair => for {
  hits = List.filter(List.indices(states), idx => Str.contains(Lanes.secBody(Lanes.sections(List.at(states, idx)), "drive"), pair._1))
  fired = List.nonEmpty(hits)
  ok = !fired || List.exists(hits, idx => List.exists(List.drop(states, idx), st => List.exists(Lanes.a11yLines(st), l => Str.contains(l, pair._2))))
} yield (if (ok) "" else d.name, Str.concat("claim\t", Str.concat(pair._1, if (fired) "\ttriggered" else "\tvacuous"))))
    onEval = List.map(Verify.callLitsFun(d, "Verdict.onHit", 1), trig => for {
  fired = List.exists(states, st => Str.contains(Lanes.secBody(Lanes.sections(st), "drive"), trig))
} yield Str.concat("claim\t", Str.concat(trig, if (fired) "\ttriggered" else "\tvacuous")))
    directFail = Str.contains(Parse.pretty0(d.body), "Verdict.fail(")
    passed = alwaysOk && List.forall(afterEval, r => Str.isEmpty(r._1)) && !directFail
    why = if (passed) "" else Str.concat("claim ", Str.concat(d.name, " failed"))
  } yield (why, List.concat(List.map(afterEval, r => r._2), onEval))

private def simEvalTimeline(verPairs: List[(String, String)], tl: String): (String, List[String], List[String]) =
  for {
    claims = List.filter(List.flatMap(verPairs, v => Verify.parseClaims(v._2)), d => List.len(d.params) == 1)
    evaluated = List.map(claims, d => (d.name, simEvalClaim(d, tl)))
    failed = List.filter(evaluated, r => !Str.isEmpty(r._2._1))
    why = if (List.isEmpty(failed)) "" else List.at(failed, 0)._2._1
    trigs = List.flatMap(evaluated, r => r._2._2)
    drives = List.map(List.distinct(List.flatMap(Lanes.states(tl), st => Chrome.nonEmptyLines(Lanes.secBody(Lanes.sections(st), "drive")))), l => Str.concat("drive\t", l))
    checked = List.concat(List.map(evaluated, r => Str.concat("checked\t", r._1)), drives)
  } yield (why, trigs, checked)

