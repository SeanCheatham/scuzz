def setup(): IO[Unit] =
  Fs.write("scuzz.toml", "[package]\nname = \"editor\"\nversion = \"0.1.0\"\n")

def Main.analyze(_path: String, _body: String): IO[String] =
  IO.pure("[{\"severity\":\"error\",\"message\":\"x\",\"line\":1,\"column\":1,\"file\":\"Main.scuzz\"}]")

def Main.runProject(_root: String): IO[String] =
  IO.pure("run ok")

def Main.startFuzz(root: String): IO[Int] =
  for {
    build = Fs.join(root, "build")
    fuzz = Fs.join(build, "fuzz")
    _ <- Fs.mkdirs(build).handleErrorWith(_ => IO.pure(()))
    _ <- Fs.mkdirs(fuzz).handleErrorWith(_ => IO.pure(()))
    _ <- Fs.write(Fs.join(build, "sometimes.declared"), """tappedPlus
neverHit
""")
    _ <- Fs.write(Fs.join(build, "triggers.declared"), """outlined:Check
""")
    _ <- Fs.write(Fs.join(fuzz, "sometimes.dump"), """tappedPlus
""")
    _ <- Fs.write(Fs.join(fuzz, "triggers.dump"), """claim	outlined:Check	triggered
""")
    _ <- Fs.write(Fs.join(fuzz, "summary.json"), "{\"v\":1,\"kind\":\"fuzz\",\"fuzz\":{\"ok\":true}}\n")
  } yield 1

def Main.loadClaimNames(_root: String, _rels: List[String]): IO[List[String]] =
  IO.pure(["greetFact"])

def Lsp.lspCall(_root: String, _path: String, _body: String, method: String): IO[Json] =
  IO.pure(parseJson(method match {
  case "textDocument/hover" => "{\"result\":{\"contents\":{\"kind\":\"plaintext\",\"value\":\"hover\"}}}"
  case "textDocument/completion" => "{\"result\":{\"items\":[{\"label\":\"foo\"}]}}"
  case "textDocument/definition" => "{\"result\":[{\"uri\":\"\",\"range\":{\"start\":{\"line\":0,\"character\":0}}}]}"
  case "textDocument/formatting" => "{\"result\":[]}"
  case "textDocument/rename" => "{\"result\":{\"changes\":{\"file://x\":[{\"newText\":\"\"}]}}}"
  case "textDocument/codeAction" => "{\"result\":[{\"title\":\"fix\",\"edit\":{\"changes\":{\"file://x\":[{\"newText\":\"fixed\"}]}}}]}"
  case "textDocument/semanticTokens/full" => "{\"result\":{\"data\":[0,0,5,8,0]}}"
  case "textDocument/inlayHint" => "{\"result\":[{\"position\":{\"line\":0,\"character\":5},\"label\":\"Int\"}]}"
  case "textDocument/foldingRange" => "{\"result\":[{\"startLine\":0,\"endLine\":1}]}"
  case _ => "{\"result\":{\"data\":[1]}}"
}))

