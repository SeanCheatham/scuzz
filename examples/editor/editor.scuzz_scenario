def bufferedFrames(n: Int): IO[Unit] =
  for {
    count = (n % 8 + 8) % 8
    notice = LspClient.frame(Cards.text(Json.Obj([("method", Json.Str("note"))])))
    first = LspClient.frame(Cards.text(Json.Obj([("id", Json.Int(1)), ("result", Json.Str("é"))])))
    second = LspClient.frame(Cards.text(Json.Obj([("id", Json.Int(2)), ("result", Json.Str("done"))])))
    buffer <- Ref.of(Str.concat(Str.repeat(notice, count), Str.concat(first, second)))
    a <- LspClient.readResult(0, buffer, 1)
    b <- LspClient.readResult(0, buffer, 2)
    rest <- Ref.get(buffer)
    frameFirst = Signal.make(Json.getInt(a, "id", 0))
    frameSecond = Signal.make(Json.getInt(b, "id", 0))
    frameValue = Signal.make(Json.getStr(a, "result", ""))
    frameRest = Signal.make(Str.byteLen(rest))
    _ = Signal.set(frameFirst, Json.getInt(a, "id", 0))
    _ = Signal.set(frameSecond, Json.getInt(b, "id", 0))
    _ = Signal.set(frameValue, Json.getStr(a, "result", ""))
    _ = Signal.set(frameRest, Str.byteLen(rest))
  } yield ()

