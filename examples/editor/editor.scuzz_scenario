    _ <- Fs.write("proof/dependency/src/Dependency.scuzz", """def value(): Int =
  1
""")
    _ <- Fs.write("proof/scuzz.toml", "[package]\nname = \"proof\"\n[dependencies]\ndependency = { path = \"dependency\" }\n")
    _ <- Fs.write("proof/src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(1)
""")
    _ <- Fs.mkdirs("proof/build/proposals/p/src")
