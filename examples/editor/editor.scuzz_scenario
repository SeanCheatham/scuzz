def generationFlow(model: Int, cancel: Int): IO[Unit] =
  for {
    _ <- Fs.delete("generation-proof").handleErrorWith(_ => IO.pure(()))
    _ <- Fs.mkdirs("generation-proof/src")
    _ <- Fs.write("generation-proof/scuzz.toml", "[package]\nname = \"generation-proof\"\n")
    _ <- Fs.write("generation-proof/src/Main.scuzz", "@main def main: IO[Unit] = IO.println(1)")
    session <- Session.create("generation-proof")
    _ = Signal.set(session.mode, 1)
    _ = Signal.set(session.model, if (model == 0) "smollm3-3b" else "qwen2.5-coder-7b")
    _ = Signal.set(session.objective, "Print two")
    _ = Signal.set(session.paths, "src/Main.scuzz")
    _ = Signal.set(session.config, Session.settings(session))
    _ <- Session.start("generation-proof", session).flatMap(_ => IO.sleep(500))
    cleanup = Session.pause(session)
    lazyPause = Signal.make(if (Signal.get(session.active) == 1) 1 else 0)
    _ = Signal.set(lazyPause, if (Signal.get(session.active) == 1) 1 else 0)
    _ <- Session.generate("generation-proof", session, _ => IO.pure(()))
    _ <- if (cancel == 0) IO.sleep(500) else if (cancel == 2) Session.changeModel(session, if (model == 0) "qwen2.5-coder-7b" else "smollm3-3b") else if (cancel == 3) IO.ensure(IO.pure(()), cleanup) else cleanup
    frozen <- Fs.read("generation-proof/build/ide/request.json")
    _ <- if (cancel == 4) Session.start("generation-proof", session).flatMap(_ => IO.sleep(500)).flatMap(_ => Session.pause(session)) else IO.pure(())
    _ <- if (cancel == 0) Session.pause(session) else IO.pure(())
    frozenRequest = Signal.make(frozen)
    resumedRequest = Signal.make(Signal.get(session.request))
    _ = Signal.set(frozenRequest, frozen)
    _ = Signal.set(resumedRequest, Signal.get(session.request))
    lifecycleIdentity = Signal.make(if ((cancel != 2 || Signal.get(session.model) == (if (model == 0) "qwen2.5-coder-7b" else "smollm3-3b")) && (cancel != 4 || Signal.get(session.request) == frozen)) 1 else 0)
    _ = Signal.set(lifecycleIdentity, if ((cancel != 2 || Signal.get(session.model) == (if (model == 0) "qwen2.5-coder-7b" else "smollm3-3b")) && (cancel != 4 || Signal.get(session.request) == frozen)) 1 else 0)
    jobs <- Ref.get(session.jobs)
    savedRaw <- Fs.read(Fs.join(Cards.storage("generation-proof"), "session.json"))
    saved <- Proposal.parse(savedRaw, 8192)
    stopped = Signal.make(if (Str.isEmpty(jobs.token) && List.isEmpty(jobs.fibers) && Signal.get(session.active) == 0 && Signal.get(session.count) == 1 && Json.getInt(saved, "requests", 0) == 1) 1 else 0)
    _ = Signal.set(stopped, if (Str.isEmpty(jobs.token) && List.isEmpty(jobs.fibers) && Signal.get(session.active) == 0 && Signal.get(session.count) == 1 && Json.getInt(saved, "requests", 0) == 1) 1 else 0)
    requestRaw <- Fs.read("generation-proof/build/ide/request.json")
    request <- Proposal.parse(requestRaw, 1048576)
    candidate = Fs.join("generation-proof/build/proposals", Str.concat("local-", Proposal.str(request, "request")))
    exists <- Fs.exists(candidate)
    generationPublished = Signal.make(if (exists != 0) 1 else 0)
    generationCancelled = Signal.make(if (cancel == 0) 0 else 1)
    _ = Signal.set(generationPublished, if (exists != 0) 1 else 0)
    _ = Signal.set(generationCancelled, if (cancel == 0) 0 else 1)
  } yield ()

