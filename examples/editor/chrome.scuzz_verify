def readyQueueRestoresFrozenEvidence(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "queueCacheFlow") || Timeline.signalInt(t, i, "queueCacheBound") == 1)

def projectChecksKeepErrors(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "projectChecks") || Timeline.signalInt(t, i, "projectChecked") == 1)

def abstentionControlsFollowArmedCard(t: Timeline): Verdict =
  Verdict.every(t, i => if (Timeline.a11yHas(t, i, "button:Choose left")) Timeline.a11yHas(t, i, "outlined:Can't decide") && Timeline.a11yHas(t, i, "choicechip:No reason") && Timeline.a11yHas(t, i, "choicechip:No visible difference") && Timeline.a11yHas(t, i, "choicechip:Need another scenario") && Timeline.a11yHas(t, i, "choicechip:Outside my goal") else !Timeline.a11yHas(t, i, "outlined:Can't decide") && !Timeline.a11yHas(t, i, "choicechip:Need another scenario"))

def abstentionReasonResetsAfterChoice(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.lastHitHas(t, i, "outlined:Can't decide") || Timeline.signalInt(t, i, "abstainReason") == 0)

def revealNeverNamesArmedCard(t: Timeline): Verdict =
  Verdict.every(t, i => !visibleReadyCard(t, i) || (!Timeline.signalStrHas(t, i, "deckCard", "\"proposal\":\"p1\"") || !Timeline.signalStrHas(t, i, "deckLast", " p1 ") && !Timeline.signalStrHas(t, i, "deckLastResult", "Result (p1)")) && (!Timeline.signalStrHas(t, i, "deckCard", "\"proposal\":\"p2\"") || !Timeline.signalStrHas(t, i, "deckLast", " p2 ") && !Timeline.signalStrHas(t, i, "deckLastResult", "Result (p2)")) && (!Timeline.signalStrHas(t, i, "deckCard", "\"proposal\":\"p3\"") || !Timeline.signalStrHas(t, i, "deckLast", " p3 ") && !Timeline.signalStrHas(t, i, "deckLastResult", "Result (p3)")))

def postResultExposesRegionFocus(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "page") != 0 || Timeline.signalInt(t, i, "developSection") != 0 || Timeline.signalInt(t, i, "evidenceDetails") != 0 || Timeline.signalStrHas(t, i, "deckLast", "") && !Timeline.a11yHas(t, i, "text:accepted ") && !Timeline.a11yHas(t, i, "text:baseline chosen ") && !Timeline.a11yHas(t, i, "text:abstained") || Timeline.a11yHas(t, i, "outlined:Retain region") && Timeline.a11yHas(t, i, "outlined:All regions"))

def sessionDisplaysConservativeSummary(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "page") != 0 || Timeline.signalInt(t, i, "developSection") != 2 || Timeline.a11yHas(t, i, "text:Session summary") && Timeline.a11yHas(t, i, "text:Conservative source measure: counts non-undone acceptances whose touched files match accepted SHA-256 bytes. Does not prove preserved behavior.") && Timeline.a11yHas(t, i, "text:Rule reviews: installed ") && Timeline.a11yHas(t, i, "outlined:Refresh summary"))

def choiceFeedbackContract(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "choiceFeedbackFlow") || Timeline.signalInt(t, i, "choiceFeedbackBound") == 1)

def sessionSummaryContract(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "sessionSummaryFlow") || Timeline.signalInt(t, i, "sessionSummaryBound") == 1)

oracle skipNeverBecomesNegativePreference(reasonIdx: Int): Bool =
  for {
    reason = Proposal.abstentionReasonAt(reasonIdx)
    rec = Json.Obj([("operation", Json.Str("abstain-c1")), ("card", Json.Str("c1")), ("proposal", Json.Str("p1")), ("decision", Json.Str("abstain")), ("reason", Json.Str(reason)), ("time", Json.Int(10)), ("writes", Json.Arr([]))])
    fb = Proposal.boundedFeedback([rec], [])
    summary = Cards.summarizeRecords([("src/Main.scuzz", "x")], [rec])
  } yield List.len(fb) == 1 && Proposal.str(List.at(fb, 0), "kind") == "abstention" && Proposal.str(List.at(fb, 0), "decision") == "abstain" && Proposal.str(List.at(fb, 0), "reason") == reason && Json.getInt(summary, "baseline_choices", -1) == 0 && Json.getInt(summary, "abstentions", -1) == 1

oracle automaticExclusionsNeverCountAsHumanChoices(n: Int where n >= 0 && n <= 8): Bool =
  for {
    autos = List.map(List.range(0, n), idx => Json.Obj([("card", Json.Str(Str.concat("a", Str.fromInt(idx)))), ("proposal", Json.Str(Str.concat("pa", Str.fromInt(idx)))), ("kind", Json.Str("automatic")), ("decision", Json.Str(if (idx % 2 == 0) "duplicate-source" else "candidate-failed")), ("readiness_ms", Json.Int(25)), ("time", Json.Int(idx + 1)), ("writes", Json.Arr([]))]))
    humanFb = Proposal.boundedFeedback(autos, [])
    summary = Cards.summarizeRecords([("src/Main.scuzz", "x")], autos)
  } yield List.isEmpty(humanFb) && Json.getInt(summary, "accepted", -1) == 0 && Json.getInt(summary, "retained_acceptances", -1) == 0 && Json.getInt(summary, "baseline_choices", -1) == 0 && Json.getInt(summary, "abstentions", -1) == 0 && Json.getInt(summary, "undo", -1) == 0 && Json.getInt(summary, "automatic_exclusions", -1) == n && Json.getInt(summary, "duplicates", -1) == (n + 1) / 2

oracle retentionChangesOnUndoAndReplacement(undone: Bool, replaced: Bool, reviewMs: Int where reviewMs >= 0 && reviewMs <= 600000): Bool =
  for {
    cid = Hash.sha256("ret-card")
    acceptedBody = """@main def main: IO[Unit] = IO.println(2)
"""
    diskBody = if (replaced) """@main def main: IO[Unit] = IO.println(9)
""" else if (undone) """@main def main: IO[Unit] = IO.println(1)
""" else acceptedBody
    acc = Json.Obj([("operation", Json.Str(Str.concat("accept-", cid))), ("card", Json.Str(cid)), ("proposal", Json.Str("p1")), ("decision", Json.Str("accept")), ("readiness_ms", Json.Int(50)), ("review_ms", Json.Int(reviewMs)), ("time", Json.Int(10)), ("writes", Json.Arr([Json.Obj([("path", Json.Str("src/Main.scuzz")), ("before", Json.Str("""@main def main: IO[Unit] = IO.println(1)
""")), ("before_exists", Json.Bool(true)), ("after", Json.Str(acceptedBody)), ("after_exists", Json.Bool(true))])]))])
    records = if (undone) [acc, Cards.undoOperation(acc, 20)] else [acc]
    summary = Cards.summarizeRecords([("src/Main.scuzz", diskBody)], records)
    expectedRetained = if (!undone && !replaced) 1 else 0
    expectedRate = if (reviewMs <= 0) 0 else (expectedRetained * 6000000 + reviewMs / 2) / reviewMs
  } yield Json.getInt(summary, "accepted", -1) == 1 && Json.getInt(summary, "retained_acceptances", -1) == expectedRetained && Json.getInt(summary, "undo", -1) == (if (undone) 1 else 0) && Json.getInt(summary, "readiness_ms", -1) == 50 && Json.getInt(summary, "review_ms", -1) == reviewMs && Json.getInt(summary, "retained_per_review_minute_x100", -1) == expectedRate

oracle activeReviewTimingExcludesPauseAndWait(waitMs: Int where waitMs >= 0 && waitMs <= 5000, revMs: Int where revMs >= 0 && revMs <= 5000, pauseMs: Int where pauseMs >= 0 && pauseMs <= 20000): Bool =
  for {
    rev1 = revMs / 2
    rev2 = revMs - rev1
    t0 = Main.timingWaitStart(Main.emptyTiming(), 100)
    t1 = Main.timingCardShown(t0, "card-a", 100 + waitMs)
    t2 = Main.timingPause(t1, 100 + waitMs + rev1)
    t3 = Main.timingCardShown(t2, "card-a", 100 + waitMs + rev1 + pauseMs)
    done = Main.timingFinishCard(t3, "card-a", false, 100 + waitMs + rev1 + pauseMs + rev2)
  } yield done._2 == waitMs && done._3 == revMs

oracle boundedFeedbackRespectsCap(totalHuman: Int where totalHuman >= 0 && totalHuman <= 24, totalAuto: Int where totalAuto >= 0 && totalAuto <= 6): Bool =
  for {
    humans = List.map(List.range(0, totalHuman), idx => Json.Obj([("operation", Json.Str(Str.concat("op-", Str.fromInt(idx)))), ("card", Json.Str(Str.concat("c-", Str.fromInt(idx)))), ("proposal", Json.Str(Str.concat("p-", Str.fromInt(idx)))), ("decision", Json.Str(if (idx % 2 == 0) "baseline" else "abstain")), ("reason", Json.Str(if (idx % 2 == 0) "" else "outside-my-goal")), ("time", Json.Int(idx + 1)), ("writes", Json.Arr([]))]))
    autos = List.map(List.range(0, totalAuto), idx => Json.Obj([("kind", Json.Str("automatic")), ("decision", Json.Str("duplicate-source")), ("time", Json.Int(100 + idx))]))
    fb = Proposal.boundedFeedback(humans, autos)
    autoCount = List.len(List.filter(fb, f => Proposal.str(f, "kind") == "automatic"))
    expectedAuto = if (totalAuto > 3) 3 else totalAuto
    expectedHuman = if (totalHuman > 16 - expectedAuto) 16 - expectedAuto else totalHuman
  } yield List.len(fb) == expectedHuman + expectedAuto && List.len(fb) <= 16 && autoCount == expectedAuto

oracle revealIsolatesNextCardFlip(decidedFlip: Int, nextFlip: Int): Bool =
  for {
    dBit = if (decidedFlip % 2 == 0) 0 else 1
    nBit = if (nextFlip % 2 == 0) 0 else 1
    decidedCard = Json.Obj([("proposal", Json.Str("p-decided")), ("flip", Json.Int(dBit))])
    nextCard = Json.Obj([("proposal", Json.Str("p-next")), ("flip", Json.Int(nBit))])
    reveal = Deck.revealText("baseline chosen", Cards.str(decidedCard, "proposal"), Main.cardProposalSide(decidedCard))
  } yield reveal == Deck.revealText("baseline chosen", "p-decided", if (dBit == 1) "Left" else "Right") && !Str.contains(reveal, Cards.str(nextCard, "proposal"))

def ruleReviewSectionDisplaysFiniteFraming(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "page") != 0 || Timeline.signalInt(t, i, "developSection") != 3 || Timeline.a11yHas(t, i, "text:Rule review") && Timeline.a11yHas(t, i, "text:Keep rule suggestions separate from behavior choices. Finite workload evidence is not a universal proof.") && Timeline.a11yHas(t, i, "outlined:Import rule draft"))

def installRuleRequiresVerifiedDraft(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "button:Install rule") || Timeline.signalInt(t, i, "ruleVerified") == 1 && Timeline.signalStrHas(t, i, "ruleCard", "\"status\":\"verified\"") && Timeline.a11yHas(t, i, "outlined:Reject rule") && Timeline.a11yHas(t, i, "text:Verified on finite required workloads and supporting witness. Not a universal proof."))

def afterSuggestRuleOpensRuleReview(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Suggest rule", "text:Rule review")

def ruleReviewContract(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "ruleReviewFlow") || Timeline.signalInt(t, i, "ruleReviewBound") == 1)

oracle behaviorAndRuleOperationsStaySeparated(beforeExists: Bool): Bool =
  for {
    cid = Hash.sha256("sep-op")
    verifyWrite = Json.Obj([("path", Json.Str("rules.scuzz_verify")), ("before", Json.Str(if (beforeExists) """def a(t: Timeline): Verdict =
  Verdict.ok()
""" else "")), ("before_exists", Json.Bool(beforeExists)), ("after", Json.Str("def b(t: Timeline): Verdict =\n  Verdict.alwaysHas(t, \"text:Counter\")\n")), ("after_exists", Json.Bool(true))])
    sourceWrite = Json.Obj([("path", Json.Str("src/Main.scuzz")), ("before", Json.Str("x")), ("before_exists", Json.Bool(true)), ("after", Json.Str("y")), ("after_exists", Json.Bool(true))])
    badAccept = Json.Obj([("operation", Json.Str(Str.concat("accept-", cid))), ("card", Json.Str(cid)), ("decision", Json.Str("accept")), ("writes", Json.Arr([verifyWrite]))])
    badInstall = Json.Obj([("operation", Json.Str(Str.concat("install-rule-", cid))), ("card", Json.Str(cid)), ("decision", Json.Str("install-rule")), ("writes", Json.Arr([sourceWrite]))])
    goodInstall = Json.Obj([("operation", Json.Str(Str.concat("install-rule-", cid))), ("card", Json.Str(cid)), ("decision", Json.Str("install-rule")), ("writes", Json.Arr([verifyWrite]))])
    undoInstall = Cards.undoOperation(goodInstall, 30)
  } yield !Cards.validOperation(badAccept) && !Cards.validOperation(badInstall) && Cards.validOperation(goodInstall) && Cards.validAccepted(goodInstall) && Cards.validOperation(undoInstall)

oracle ruleRecordsStayOutOfBehaviorCounts(ruleUndone: Bool, ruleRejected: Bool, behaviorUndone: Bool): Bool =
  for {
    behId = Hash.sha256("beh-card")
    ruleId = Hash.sha256("rule-card")
    rejId = Hash.sha256("rej-rule-card")
    acceptedBody = """@main def main: IO[Unit] = IO.println(2)
"""
    diskBody = if (behaviorUndone) """@main def main: IO[Unit] = IO.println(1)
""" else acceptedBody
    abstainRec = Json.Obj([("operation", Json.Str("abstain-c0")), ("card", Json.Str("c0")), ("proposal", Json.Str("p0")), ("decision", Json.Str("abstain")), ("reason", Json.Str("need-another-scenario")), ("readiness_ms", Json.Int(20)), ("review_ms", Json.Int(100)), ("time", Json.Int(10)), ("writes", Json.Arr([]))])
    baseRec = Json.Obj([("operation", Json.Str("baseline-c1")), ("card", Json.Str("c1")), ("proposal", Json.Str("p1")), ("decision", Json.Str("baseline")), ("readiness_ms", Json.Int(30)), ("review_ms", Json.Int(200)), ("time", Json.Int(20)), ("writes", Json.Arr([]))])
    accRec = Json.Obj([("operation", Json.Str(Str.concat("accept-", behId))), ("card", Json.Str(behId)), ("proposal", Json.Str("p2")), ("decision", Json.Str("accept")), ("readiness_ms", Json.Int(40)), ("review_ms", Json.Int(300)), ("time", Json.Int(30)), ("writes", Json.Arr([Json.Obj([("path", Json.Str("src/Main.scuzz")), ("before", Json.Str("""@main def main: IO[Unit] = IO.println(1)
""")), ("before_exists", Json.Bool(true)), ("after", Json.Str(acceptedBody)), ("after_exists", Json.Bool(true))])]))])
    ruleWrite = Json.Obj([("path", Json.Str("rules.scuzz_verify")), ("before", Json.Str("")), ("before_exists", Json.Bool(false)), ("after", Json.Str("def keep(t: Timeline): Verdict =\n  Verdict.alwaysHas(t, \"text:Counter\")\n")), ("after_exists", Json.Bool(true))])
    installRec = Json.Obj([("operation", Json.Str(Str.concat("install-rule-", ruleId))), ("card", Json.Str(ruleId)), ("kind", Json.Str("rule")), ("proposal", Json.Str("r1")), ("decision", Json.Str("install-rule")), ("time", Json.Int(40)), ("writes", Json.Arr([ruleWrite]))])
    rejectRec = Json.Obj([("operation", Json.Str(Str.concat("reject-rule-", rejId))), ("card", Json.Str(rejId)), ("kind", Json.Str("rule")), ("proposal", Json.Str("r2")), ("decision", Json.Str("reject-rule")), ("time", Json.Int(50)), ("writes", Json.Arr([]))])
    baseRecords = [abstainRec, baseRec, accRec, installRec]
    withRuleUndo = if (ruleUndone) List.concat(baseRecords, [Cards.undoOperation(installRec, 45)]) else baseRecords
    withRuleRej = if (ruleRejected) List.concat(withRuleUndo, [rejectRec]) else withRuleUndo
    records = if (behaviorUndone) List.concat(withRuleRej, [Cards.undoOperation(accRec, 60)]) else withRuleRej
    summary = Cards.summarizeRecords([("src/Main.scuzz", diskBody)], records)
    lines = Cards.summaryLines(summary)
    expectedBehUndo = if (behaviorUndone) 1 else 0
    expectedRuleActive = if (ruleUndone) 0 else 1
    expectedRuleUndo = if (ruleUndone) 1 else 0
    expectedRuleRej = if (ruleRejected) 1 else 0
  } yield Json.getInt(summary, "accepted", -1) == 1 && Json.getInt(summary, "retained_acceptances", -1) == (if (behaviorUndone) 0 else 1) && Json.getInt(summary, "baseline_choices", -1) == 1 && Json.getInt(summary, "abstentions", -1) == 1 && Json.getInt(summary, "undo", -1) == expectedBehUndo && Json.getInt(summary, "rules_installed", -1) == 1 && Json.getInt(summary, "rules_active", -1) == expectedRuleActive && Json.getInt(summary, "rules_undone", -1) == expectedRuleUndo && Json.getInt(summary, "rules_rejected", -1) == expectedRuleRej && List.contains(lines, Str.concat("Baseline choices: 1; Undo: ", Str.fromInt(expectedBehUndo))) && List.contains(lines, Str.concat("Rule reviews: installed 1 (active ", Str.concat(Str.fromInt(expectedRuleActive), Str.concat(", undone ", Str.concat(Str.fromInt(expectedRuleUndo), Str.concat("); rejected ", Str.fromInt(expectedRuleRej)))))))

oracle restoredSessionInitFallsBackCleanly(hasObjective: Bool, hasAllowed: Bool): Bool =
  for {
    files = [("src/Main.scuzz", "a"), ("src/Other.scuzz", "b")]
    saved = Json.Obj([("v", Json.Int(1)), ("objective", Json.Str(if (hasObjective) "Refine Counter" else "   ")), ("allowed", Json.Arr(if (hasAllowed) [Json.Str(" src/Other.scuzz "), Json.Str("")] else []))])
    init = Session.restoredInit(saved, files)
    emptyInit = Session.restoredInit(Json.Obj([]), files)
    expectedPaths = if (hasAllowed) "src/Other.scuzz" else "src/Main.scuzz,src/Other.scuzz"
    expectedStatus = if (hasObjective) "Session restored in paused state. Select Start to resume." else "Set an objective, then select Start."
  } yield init._2 == expectedPaths && init._3 == expectedStatus && emptyInit._1 == "" && emptyInit._2 == "src/Main.scuzz,src/Other.scuzz" && emptyInit._3 == "Set an objective, then select Start."

oracle diagRowsAndFilesRoundTrip(line: Int where line >= 0 && line <= 5000, col: Int where col >= 0 && col <= 500, hasFile: Bool): Bool =
  for {
    file = if (hasFile) "src/Main.scuzz" else ""
    item = Json.Obj([("line", Json.Int(line)), ("column", Json.Int(col)), ("file", Json.Str(file)), ("message", Json.Str("type error"))])
    row = Diags.diagRow(item)
    emptyRow = Diags.diagRow(Json.Obj([]))
    expectedRow = Str.concat(Str.fromInt(line), Str.concat(":", Str.concat(Str.fromInt(col), Str.concat("|", Str.concat(file, "|type error")))))
  } yield row == expectedRow && Diags.diagFile(row) == file && Diags.diagFile("plain") == "" && emptyRow == "0:0||" && Diags.diagRows(Json.Arr([item, Json.Obj([])])) == [expectedRow, "0:0||"] && List.isEmpty(Diags.diagRows(Json.Null())) && List.isEmpty(Diags.diagRows(Json.Obj([])))

oracle diagMarksClassifySeverity(line: Int where line >= 0 && line <= 5000, warn: Bool): Bool =
  for {
    sev = if (warn) "warning" else "error"
    item = Json.Obj([("line", Json.Int(line)), ("severity", Json.Str(sev))])
    plain = Json.Obj([("line", Json.Int(line))])
    expectedSev = if (warn) 2 else 1
  } yield Diags.diagMark(item) == (line, expectedSev) && Diags.diagMark(plain) == (line, 1) && Diags.diagMark(Json.Null()) == (0, 1) && Diags.diagMarks(Json.Arr([item, plain])) == [(line, expectedSev), (line, 1)] && List.isEmpty(Diags.diagMarks(Json.Null())) && List.isEmpty(Diags.diagMarks(Json.Str("x")))

