private def alwaysHas(t: Timeline, needle: String): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, needle))

private def afterHitShows(t: Timeline, hit: String, needle: String): Verdict =
  Verdict.or(Verdict.every(t, i => !Timeline.lastHitHas(t, i, hit)), Verdict.any(t, i => Timeline.lastHitHas(t, i, hit) && Timeline.exists(t, j => j >= i && Timeline.a11yHas(t, j, needle))))

def chrome(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, "button:Save") && Timeline.a11yHas(t, i, "button:Check") && Timeline.a11yHas(t, i, "button:Find") && Timeline.a11yHas(t, i, "button:Palette") && Timeline.a11yHas(t, i, "button:Save all") && Timeline.a11yHas(t, i, "button:Run") && Timeline.a11yHas(t, i, "button:Fuzz") && Timeline.a11yHas(t, i, "button:x sample.txt") && Timeline.a11yHas(t, i, "editor:editor"))

def editorStays(t: Timeline): Verdict =
  alwaysHas(t, "editor:editor")

def afterCheckShowsDiag(t: Timeline): Verdict =
  afterHitShows(t, "button:Check", "button:1:1|sample.txt|x")

def afterCompleteShowsItem(t: Timeline): Verdict =
  afterHitShows(t, "button:Complete", "button:foo")

