def chrome(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, "choicechip:Live") && Timeline.a11yHas(t, i, "choicechip:Verify") && Timeline.a11yHas(t, i, "choicechip:Session") && Timeline.a11yHas(t, i, "semantics:Index book") && Timeline.a11yHas(t, i, "button:Save") && Timeline.a11yHas(t, i, "outlined:Check") && Timeline.signalStrHas(t, i, "title", "editor") && Timeline.a11yHas(t, i, "text:editor") && !Timeline.a11yHas(t, i, "x Main.scuzz") && !Timeline.a11yHas(t, i, "01  Live") && !Timeline.a11yHas(t, i, "02  Verify") && !Timeline.a11yHas(t, i, "03  Session") && !Timeline.a11yHas(t, i, "navtile:") && (Timeline.signalInt(t, i, "page") != 0 || Timeline.a11yHas(t, i, "editor:editor")))

def editorStays(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "page") != 0 || Timeline.a11yHas(t, i, "editor:editor"))

def afterCheckStaysLive(t: Timeline): Verdict =
  Verdict.onHit(t, "outlined:Check", __tup => __tup match {
  case (before, after) => Timeline.signalInt(t, after, "page") == 0 && Timeline.a11yHas(t, after, "editor:editor") && Timeline.a11yHas(t, after, "choicechip:Live=1")
})

def afterCheckKeepsDiags(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.signalStrHas(t, i, "checkedSource", "IO.println(1 + \"x\")") || Timeline.signalListLen(t, i, "diags") > 0)

def checkFindsTypeError(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "page") != 2 || !Timeline.signalStrHas(t, i, "checkedSource", "IO.println(1 + \"x\")") || Timeline.a11yHas(t, i, "Main.scuzz|type error"))

def sessionHasRun(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "page") != 2 || Timeline.a11yHas(t, i, "button:Run") && Timeline.a11yHas(t, i, "outlined:Fuzz"))

def afterFuzzShowsSometimes(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Fuzz", "chip:tappedPlus")

def afterFuzzShowsReached(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Fuzz", "chip:tappedPlus=1")

def afterFuzzShowsOpen(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Fuzz", "chip:neverHit=0")

def afterVerifyShowsClaim(t: Timeline): Verdict =
  Verdict.onHit(t, "choicechip:Verify", __tup => __tup match {
  case (before, after) => Timeline.signalInt(t, after, "page") == 1 && Timeline.a11yHas(t, after, "choicechip:Verify=1") && Timeline.a11yHas(t, after, "textbutton:greetFact") && !Timeline.a11yHas(t, after, "chrome.scuzz_verify")
})

def afterClaimStaysVerify(t: Timeline): Verdict =
  Verdict.onHit(t, "textbutton:greetFact", __tup => __tup match {
  case (before, after) => Timeline.signalInt(t, after, "page") == 1 && Timeline.a11yHas(t, after, "choicechip:Verify=1") && Timeline.a11yHas(t, after, "textbutton:greetFact")
})

def afterDiffShowsCounts(t: Timeline): Verdict =
  Verdict.afterHit(t, "button:Diff", "text:HEAD: 1 regressed, 0 fixed, 0 diverged, 0 unrunnable, 1 same")

def afterDiffListsChanged(t: Timeline): Verdict =
  Verdict.afterHit(t, "button:Diff", "textbutton:regressed idle")

def sameWorkStaysHidden(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "textbutton:same corpus/same.toml"))

def afterWorkMarksDivergence(t: Timeline): Verdict =
  Verdict.afterHit(t, "textbutton:regressed idle", "textbutton:1*")

def afterWorkOpensDivergence(t: Timeline): Verdict =
  Verdict.afterHit(t, "textbutton:regressed idle", "text:step 1 of 2 - tap button:+1 - differs")

def afterStepShowsState(t: Timeline): Verdict =
  Verdict.afterHit(t, "textbutton:0", "text:step 0 of 2 - setup - same")

def afterStepRendersView(t: Timeline): Verdict =
  Verdict.afterHit(t, "textbutton:1*", "text:+1")

def afterStepRendersCounter(t: Timeline): Verdict =
  Verdict.afterHit(t, "textbutton:1*", "text:Counter")

def afterWorkPlaysTimeline(t: Timeline): Verdict =
  Verdict.afterHit(t, "textbutton:regressed idle", "text:count = 2")

def afterPauseHoldsFrame(t: Timeline): Verdict =
  Verdict.afterHit(t, "choicechip:Pause", "choicechip:Pause=1")

def afterCompareShowsCounts(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Compare buffers", "text:buffers: 0 regressed, 0 fixed, 1 diverged, 0 unrunnable, 1 same")

def afterCompareListsSeed(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Compare buffers", "textbutton:diverged seed count 1")

def afterCompareOpensSignals(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Compare buffers", "text:step 1 of 2 - count 1 - differs")

def afterCompareMarksSignals(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Compare buffers", Str.concat("text:signals *", Str.concat("""
""", "count=1")))

def afterCompareShowsBuffers(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Compare buffers", "text:b: buffers")

def afterCompareRendersView(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Compare buffers", "text:+1")

def afterDeckShowsCard(t: Timeline): Verdict =
  Verdict.every(t, i => !visibleReadyCard(t, i) || Timeline.a11yHas(t, i, "text:Behavior review"))

def deckStaysBlind(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "button:Choose left") || Timeline.a11yHas(t, i, "text:Left") && Timeline.a11yHas(t, i, "text:Right") && !Timeline.a11yHas(t, i, "text:proposal p") && !Timeline.a11yHas(t, i, "text:b: buffers") && !Timeline.a11yHas(t, i, "text:a: HEAD"))

def choicesNeedReadyIdentity(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "button:Choose left") || Timeline.signalStrHas(t, i, "deckCard", "\"status\":\"ready\""))

def failedReviewClearsEvidence(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalStrHas(t, i, "deckCard", "\"status\":\"ready\"") || !Timeline.a11yHas(t, i, "button:Choose right"))

def choiceUsesDisplayedLane(t: Timeline): Verdict =
  Verdict.every(t, i => !(Timeline.lastHitHas(t, i, "button:Choose left") || Timeline.lastHitHas(t, i, "button:Choose right")) || choiceRecordMatches(t, i))

private def choiceRecordMatches(t: Timeline, i: Int): Bool =
  if (i == 0 || !Timeline.signalStrHas(t, i - 1, "deckCard", "\"status\":\"ready\"")) true else for {
  lane = if (Timeline.lastHitHas(t, i, "button:Choose left")) 0 else 1
  accepted = lane == (if (Timeline.signalInt(t, i - 1, "deckFlip") == 1) 0 else 1)
} yield if (Timeline.a11yHas(t, i, "text:dirty buffer:")) Timeline.fileSame(t, i - 1, i, "src/Main.scuzz") else if (accepted) Timeline.a11yHas(t, i, "text:accepted ") && (!Timeline.signalStrHas(t, i - 1, "deckCard", "\"proposal\":\"p1\"") || Timeline.signalStrHas(t, i, "buf", "IO.println(2)") && !Timeline.signalStrHas(t, i, "buf", "IO.println(1 + \"x\")")) else Timeline.fileSame(t, i - 1, i, "src/Main.scuzz") && Timeline.fileSame(t, i - 1, i, "src/Other.scuzz") && Timeline.a11yHas(t, i, "text:baseline chosen ")

def abstentionPreservesSources(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.lastHitHas(t, i, "outlined:Can't decide") || i == 0 || Timeline.fileSame(t, i - 1, i, "src/Main.scuzz") && Timeline.fileSame(t, i - 1, i, "src/Other.scuzz"))

def decisionRevealsOnlyChosenCard(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "button:Choose left") || !Timeline.a11yHas(t, i, "text:proposal p"))

private def visibleReadyCard(t: Timeline, i: Int): Bool =
  Timeline.signalInt(t, i, "page") == 3 && Timeline.signalStrHas(t, i, "deckCard", "\"status\":\"ready\"")

def afterDeckShowsSource(t: Timeline): Verdict =
  Verdict.every(t, i => !visibleReadyCard(t, i) || !Timeline.signalStrHas(t, i, "deckCard", "\"proposal\":\"p1\"") || Timeline.signalListLen(t, i, "srcFiles") == 1 && (Timeline.signalInt(t, i, "evidenceDetails") == 0 || Timeline.a11yHas(t, i, "IO.println(2)")))

def afterDeckFlagsUnguarded(t: Timeline): Verdict =
  Verdict.every(t, i => !visibleReadyCard(t, i) || Timeline.a11yHas(t, i, "text:unguarded: no claims"))

def durableRecordsStayOutsideBuild(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.fileSame(t, 0, i, "build/ide/decisions.jsonl"))

def afterDeckEndClearsLanes(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "text:no more proposals") || !Timeline.a11yHas(t, i, "textbutton:diverged seed count 1") && !Timeline.a11yHas(t, i, "button:Choose left"))

def afterRandomizeBlindsLanes(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Randomize", "text:Left")

def afterRandomizeShowsStep(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Randomize", "text:step 1 of 2 - count 1 - differs")

def afterGenerateShowsCard(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Generate", "text:Behavior review")

def afterInfoShowsHover(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Info", "text:IO.println(String): IO[Unit]")

def afterDefShowsLocation(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Go to def", "text:def file://src/Main.scuzz:1")

def afterDefKeepsBuffer(t: Timeline): Verdict =
  if (!Timeline.exists(t, i => Timeline.lastHitHas(t, i, "outlined:Go to def"))) Verdict.ok() else if (Timeline.signalStrHas(t, Timeline.len(t) - 1, "buf", "def twice(n: Int): Int =\n  n + n\n\n@main def main: IO[Unit] =\n  for {\n    _ <- IO.println(twice(2))\n    _ <- IO.println(1 + \"x\")\n  } yield ()\n")) Verdict.ok() else Verdict.fail(Timeline.len(t) - 1, "Go to def keeps the buffer")

def afterRenameRenamesDef(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Rename", __tup => __tup match {
  case (before, after) => Timeline.exists(t, i => i >= after && (Timeline.signalStrHas(t, i, "infoLine", "no rename") || Timeline.signalStrHas(t, i, "infoLine", "renamed")) && (!Timeline.signalStrHas(t, before, "replQ", "thrice") || Timeline.signalInt(t, i, "renameCaret") != 90 || !Timeline.signalStrHas(t, before, "buf", "def twice(n: Int): Int =\n  n + n\n\n@main def main: IO[Unit] =\n  for {\n    _ <- IO.println(twice(2))\n    _ <- IO.println(1 + \"x\")\n  } yield ()\n") || Timeline.signalStrHas(t, i, "buf", "def thrice(n: Int): Int =\n  n + n\n\n@main def main: IO[Unit] =\n  for {\n    _ <- IO.println(thrice(2))\n    _ <- IO.println(1 + \"x\")\n  } yield ()\n")))
})

def afterRenameConfirms(t: Timeline): Verdict =
  Verdict.onHit(t, "button:Rename", __tup => __tup match {
  case (before, after) => Timeline.exists(t, i => i >= after && (if (Timeline.signalStrHas(t, before, "replQ", "")) Timeline.a11yHas(t, i, "text:no rename") && Timeline.signalInt(t, i, "dirty") == Timeline.signalInt(t, before, "dirty") else if (Timeline.a11yHas(t, i, "text:no rename")) Timeline.signalInt(t, i, "dirty") == Timeline.signalInt(t, before, "dirty") else Timeline.a11yHas(t, i, "text:renamed") && Timeline.signalInt(t, i, "dirty") == 1))
})

def rowsFollowStep(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalListLen(t, i, "rowsA") == 0 || Timeline.signalStrHas(t, i, "stepTitle", Str.concat("step ", Str.concat(Str.fromInt(Timeline.signalInt(t, i, "step")), " of "))))

def landmarksStayUnnumbered(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, "choicechip:Live") && Timeline.a11yHas(t, i, "choicechip:Verify") && Timeline.a11yHas(t, i, "choicechip:Session") && Timeline.a11yHas(t, i, "choicechip:Timeline") && !Timeline.a11yHas(t, i, "01  Live") && !Timeline.a11yHas(t, i, "02  Verify") && !Timeline.a11yHas(t, i, "03  Session"))

def explicitLaneProof(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "laneFlow") || (for {
  mode = Timeline.signalInt(t, i, "proofCase")
  accepted = mode == 4 || mode == 2
} yield Timeline.fileTextIs(t, i, "proof/src/Main.scuzz", if (accepted) """@main def main: IO[Unit] =
  IO.println(2)
""" else """@main def main: IO[Unit] =
  IO.println(1)
""") && (if (accepted) Timeline.fileTextIs(t, i, "proof/src/Other.scuzz", """def other(): Int =
  3
""") else Timeline.fileSame(t, 0, i, "proof/src/Other.scuzz"))))

def interruptedAcceptance(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "journalFlow") || Timeline.signalInt(t, i, "proofCase") != 0 || Timeline.fileTextIs(t, i, "proof/src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(2)
""") && Timeline.fileTextIs(t, i, "proof/src/Other.scuzz", """def other(): Int =
  3
""") && Timeline.fileTextIs(t, i, "proof/.scuzz/ide/journal.json", ""))

def recoveryPreservesExternalBytes(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "journalFlow") || Timeline.signalInt(t, i, "proofCase") != 1 && Timeline.signalInt(t, i, "proofCase") != 3 || Timeline.fileTextIs(t, i, "proof/src/Main.scuzz", "external bytes"))

def undoRestoresAdditionAndReplacement(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "journalFlow") || Timeline.signalInt(t, i, "proofCase") != 2 && Timeline.signalInt(t, i, "proofCase") != 4 || Timeline.fileTextIs(t, i, "proof/src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(1)
""") && Timeline.fileSame(t, 0, i, "proof/src/Other.scuzz"))

def staleCardWritesNothing(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "staleFlow") || Timeline.fileTextIs(t, i, "proof/src/Main.scuzz", if (Timeline.signalInt(t, i, "proofCase") == 0) "external bytes" else """@main def main: IO[Unit] =
  IO.println(1)
""") && Timeline.fileSame(t, 0, i, "proof/src/Other.scuzz"))

def unsafePublicationIsRejected(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "unsafeFlow") || Timeline.signalInt(t, i, "proofBlocked") == 1 && Timeline.fileTextIs(t, i, "proof/src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(1)
""") && Timeline.fileSame(t, 0, i, "proof/src/Other.scuzz"))

def checkPreservesAcceptedBuffer(t: Timeline): Verdict =
  Verdict.onHit(t, "outlined:Check", __tup => __tup match {
  case (before, after) => !Timeline.signalStrHas(t, before, "deckLast", "accepted ") || Timeline.signalInt(t, before, "dirty") != 0 || Timeline.fileSame(t, before, after, "src/Main.scuzz")
})

def diagnosticFocusHasCheckedSource(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "focusDiagnostic") || Timeline.signalInt(t, i, "diagnosticRows") > 0 && Timeline.signalInt(t, i, "diagnosticCaret") > 0)

def jobsStartFromTheirControls(t: Timeline): Verdict =
  Verdict.every(t, i => (Timeline.exists(t, j => j <= i && Timeline.lastHitHas(t, j, "outlined:Fuzz")) || Timeline.signalInt(t, i, "fuzzPid") == 0) && (Timeline.exists(t, j => j <= i && Timeline.lastHitHas(t, j, "button:Diff")) || Timeline.signalInt(t, i, "diffPid") == 0))

def timelineCursorStaysInRange(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "step") >= 0 && (if (Timeline.signalListLen(t, i, "rail") == 0) Timeline.signalInt(t, i, "step") == 0 else Timeline.signalInt(t, i, "step") < Timeline.signalListLen(t, i, "rail")))

def timelineStartsPaused(t: Timeline): Verdict =
  Verdict.onHit(t, "choicechip:Timeline", __tup => __tup match {
  case (before, after) => Timeline.exists(t, j => j <= before && Timeline.lastHitHas(t, j, "choicechip:Timeline")) || Timeline.a11yHas(t, after, "choicechip:Play=0")
})

def bufferedRepliesStayComplete(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "bufferedFrames") || Timeline.signalInt(t, i, "frameFirst") == 1 && Timeline.signalInt(t, i, "frameSecond") == 2 && Timeline.signalStrHas(t, i, "frameValue", "é") && Timeline.signalInt(t, i, "frameRest") == 0)

def questionChangePauses(t: Timeline): Verdict =
  Verdict.every(t, i => !visibleReadyCard(t, i) || !Timeline.lastHitHas(t, i, "outlined:Proposals") && !Timeline.lastHitHas(t, i, "outlined:Randomize") && !Timeline.lastHitHas(t, i, "textbutton:") || Timeline.signalInt(t, i, "playOn") == 0)

def readyQuestionHasResults(t: Timeline): Verdict =
  Verdict.every(t, i => !visibleReadyCard(t, i) || Timeline.a11yHas(t, i, "text:Recorded structure") && Timeline.a11yHas(t, i, "text:Result: execution passes its checks"))

def incompleteEvidenceBlocks(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "incompleteFlow") || Timeline.signalInt(t, i, "evidenceBlocked") == 1 && Timeline.fileTextIs(t, i, "proof/src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(1)
"""))

def automaticExclusionPreservesSource(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "exclusionFlow") || Timeline.fileTextIs(t, i, "proof/src/Main.scuzz", """@main def main: IO[Unit] =
  IO.println(1)
""") && Timeline.fileSame(t, 0, i, "proof/src/Other.scuzz"))

def expandedQuestionShowsScope(t: Timeline): Verdict =
  Verdict.every(t, i => !visibleReadyCard(t, i) || Timeline.signalInt(t, i, "evidenceDetails") != 1 || Timeline.a11yHas(t, i, "text:Required workloads: 2 / 2") && Timeline.a11yHas(t, i, "text:Search: 32 / 32 iterations; seed 1") && Timeline.a11yHas(t, i, "text:Claim trigger button:+1: Left untriggered; Right untriggered") && Timeline.a11yHas(t, i, "text:No observed difference does not establish equivalence"))

def shortestQuestionOpens(t: Timeline): Verdict =
  Verdict.every(t, i => !visibleReadyCard(t, i) || !Timeline.lastHitHas(t, i, "outlined:Proposals") || Timeline.signalStrHas(t, i, "questionWork", "witness 0") && Timeline.signalInt(t, i, "step") == 1 && Timeline.signalInt(t, i, "playOn") == 0 && Timeline.signalInt(t, i, "evidenceDetails") == 0 && Timeline.a11yHas(t, i, "text:signals *"))

