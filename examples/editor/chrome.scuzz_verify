def chrome(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, "choicechip:Live") && Timeline.a11yHas(t, i, "choicechip:Verify") && Timeline.a11yHas(t, i, "choicechip:Session") && Timeline.a11yHas(t, i, "semantics:Index book") && Timeline.a11yHas(t, i, "button:Save") && Timeline.a11yHas(t, i, "outlined:Check") && (Timeline.signalInt(t, i, "page") != 0 || Timeline.a11yHas(t, i, "editor:editor")))

def editorStays(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "page") != 0 || Timeline.a11yHas(t, i, "editor:editor"))

def afterCheckShowsDiag(t: Timeline): Verdict =
  Verdict.afterHit(t, "outlined:Check", "button:1:1|Main.scuzz|x")

def sessionHasRun(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "page") != 2 || Timeline.a11yHas(t, i, "button:Run") && Timeline.a11yHas(t, i, "outlined:Fuzz"))
