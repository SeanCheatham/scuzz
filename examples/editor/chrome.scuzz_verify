def chrome(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.a11yHas(t, i, "choicechip:Develop") && Timeline.a11yHas(t, i, "choicechip:Verify") && Timeline.a11yHas(t, i, "choicechip:Run") && (Timeline.signalInt(t, i, "page") != 0 || Timeline.a11yHas(t, i, "choicechip:Code") && Timeline.a11yHas(t, i, "choicechip:Session")) && Timeline.a11yHas(t, i, "semantics:Workspace") && (Timeline.signalInt(t, i, "page") != 0 || Timeline.signalInt(t, i, "developSection") != 1 || Timeline.a11yHas(t, i, "button:Save")) && (Timeline.signalInt(t, i, "page") != 1 || Timeline.a11yHas(t, i, "outlined:Check")) && Timeline.signalStrHas(t, i, "title", "editor") && Timeline.a11yHas(t, i, "text:editor") && !Timeline.a11yHas(t, i, "x Main.scuzz") && !Timeline.a11yHas(t, i, "01  Develop") && !Timeline.a11yHas(t, i, "02  Verify") && !Timeline.a11yHas(t, i, "03  Run") && !Timeline.a11yHas(t, i, "navtile:"))

def editorStays(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "page") != 0 || Timeline.signalInt(t, i, "developSection") != 1 || Timeline.a11yHas(t, i, "editor:editor"))

def afterCheckStaysLive(t: Timeline): Verdict =
  Verdict.onHit(t, "outlined:Check", __tup => __tup match {
  case (before, after) => Timeline.signalInt(t, after, "page") == 1 && Timeline.a11yHas(t, after, "choicechip:Verify=1")
})

def afterCheckKeepsDiags(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.signalStrHas(t, i, "checkedSource", "IO.println(1 + \"x\")") || Timeline.signalListLen(t, i, "diags") > 0)

def checkFindsTypeError(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "page") != 1 || !Timeline.signalStrHas(t, i, "checkedSource", "IO.println(1 + \"x\")") || Timeline.a11yHas(t, i, "Main.scuzz|type error"))

def runWorkspaceHasActions(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "page") != 2 || Timeline.a11yHas(t, i, "button:Run locally") && Timeline.a11yHas(t, i, "button:Build package"))

def verifyHasFuzz(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "page") != 1 || Timeline.a11yHas(t, i, "button:Fuzz and mutate"))

def afterFuzzShowsSometimes(t: Timeline): Verdict =
  Verdict.afterHit(t, "button:Fuzz and mutate", "chip:tappedPlus")

def afterFuzzShowsReached(t: Timeline): Verdict =
  Verdict.afterHit(t, "button:Fuzz and mutate", "chip:tappedPlus=1")

def afterFuzzShowsOpen(t: Timeline): Verdict =
  Verdict.afterHit(t, "button:Fuzz and mutate", "chip:neverHit=0")

def afterVerifyShowsClaim(t: Timeline): Verdict =
  Verdict.onHit(t, "choicechip:Verify", __tup => __tup match {
  case (before, after) => Timeline.signalInt(t, after, "page") == 1 && Timeline.a11yHas(t, after, "choicechip:Verify=1") && Timeline.a11yHas(t, after, "textbutton:greetFact") && !Timeline.a11yHas(t, after, "chrome.scuzz_verify")
})

def afterClaimStaysVerify(t: Timeline): Verdict =
  Verdict.onHit(t, "textbutton:greetFact", __tup => __tup match {
  case (before, after) => Timeline.signalInt(t, after, "page") == 1 && Timeline.a11yHas(t, after, "choicechip:Verify=1") && Timeline.a11yHas(t, after, "textbutton:greetFact")
})

def afterDiffShowsCounts(t: Timeline): Verdict =
  Verdict.afterHit(t, "button:Diff", "text:HEAD: 1 regressed, 0 fixed, 0 diverged, 0 unrunnable, 1 same")

def afterDiffListsChanged(t: Timeline): Verdict =
  Verdict.afterHit(t, "button:Diff", "textbutton:regressed idle")

def sameWorkStaysHidden(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "textbutton:same corpus/same.toml"))

def afterWorkMarksDivergence(t: Timeline): Verdict =
