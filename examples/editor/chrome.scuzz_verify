def requestsKeepFrozenCards(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.driveHas(t, i, "requestFlow") || Timeline.signalInt(t, i, "requestStable") == 1 && Timeline.fileTextIs(t, i, "proof/src/Main.scuzz", if (Timeline.signalInt(t, i, "requestAccepted") == 1) """@main def main: IO[Unit] =
