record RelativePath private(value: String)

def text(j: Json): String =
  Models.text(j)

def field(j: Json, key: String): Json =
  Models.field(j, key)

def str(j: Json, key: String): String =
  Json.getStr(j, key, "")

def keys(j: Json, names: List[String]): Bool =
  List.sort(Json.keys(j)) == List.sort(names)

def parse(raw: String, max: Int): IO[Json] =
  if (Str.byteLen(raw) > max) IO.fail("serialized input exceeds its byte limit") else Json.parse(raw) match {
  case Result.Ok(j) => IO.pure(j)
  case Result.Err(e) => IO.fail(Str.concat("invalid proposal JSON: ", e))
}

def pairsJson(files: List[(String, String)]): Json =
  Json.Arr(List.map(List.sort(List.map(files, f => f._1)), p => Json.Obj([("path", Json.Str(p)), ("content", Json.Str(List.at(files, List.indexOf(List.map(files, f => f._1), p))._2))])))

def pairs(j: Json): List[(String, String)] =
  List.map(Json.arr(j), f => (str(f, "path"), str(f, "content")))

def setHash(files: List[(String, String)]): String =
  Hash.sha256(text(pairsJson(files)))

def safePath(path: String): Bool =
  Str.matches(path, "^src/[A-Za-z_][A-Za-z0-9_]*\\.scuzz$")

def safeVerifyPath(path: String): Bool =
  Str.matches(path, "^[A-Za-z_][A-Za-z0-9_]*\\.scuzz_verify$")

def sourceSetOk(files: List[(String, String)]): Bool =
  List.nonEmpty(files) && List.len(files) <= 3 && List.len(List.distinct(List.map(files, f => f._1))) == List.len(files) && List.forall(files, f => safePath(f._1)) && List.foldLeft(files, 0, p => p._1 + Str.byteLen(p._2._2)) <= 65536

def ruleSetOk(files: List[(String, String)]): Bool =
  List.len(files) == 1 && safeVerifyPath(List.at(files, 0)._1) && Str.byteLen(List.at(files, 0)._2) > 0 && Str.byteLen(List.at(files, 0)._2) <= 65536

def relativePath(path: String): Result[String, RelativePath] =
  if (Str.len(path) > 0 && pathChars(path, 0) && List.forall(Str.split(path, "/"), part => part != "" && part != "." && part != "..")) Result.Ok(RelativePath(path)) else Result.Err(Str.concat("invalid relative path: ", path))

private def pathChars(path: String, i: Int): Bool =
  if (i == Str.len(path)) true else for {
  c = Str.charAt(path, i)
} yield c >= 32 && c != 127 && c != 92 && c != 58 && pathChars(path, i + 1)

def checkInside(root: String, path: String): IO[Unit] =
  relativePath(path) match {
    case Result.Ok(value) => inside(root, value)
    case Result.Err(error) => IO.fail(error)
  }

def inside(root: String, path: RelativePath): IO[Unit] =
  for {
    base <- Fs.canonicalize(root)
    resolved <- Fs.canonicalize(Fs.join(root, path.value)).handleErrorWith(_ => Fs.canonicalize(Fs.dirname(Fs.join(root, path.value))).map(p => Fs.join(p, Fs.basename(path.value))))
    _ <- Models.need(resolved == Fs.join(base, path.value), Str.concat("unsafe resolved path: ", path.value))
  } yield ()

def own(root: String): IO[List[(String, String)]] =
  Fs.list(Fs.join(root, "src")).flatMap(ents => IO.foreach(List.sort(List.map(List.filter(ents, e => !e._2 && Str.endsWith(e._1, ".scuzz")), e => e._1)), p => Fs.read(Fs.join(Fs.join(root, "src"), p)).map(s => (Fs.join("src", p), s))))

def ownVerify(root: String): IO[List[(String, String)]] =
  Fs.list(root).flatMap(ents => IO.foreach(List.sort(List.map(List.filter(ents, e => !e._2 && safeVerifyPath(e._1)), e => e._1)), p => Fs.read(Fs.join(root, p)).map(s => (p, s))))

def inputPath(path: String): Bool =
  path == "scuzz.toml" || Str.startsWith(path, "src/") && Str.endsWith(path, ".scuzz") || !Str.startsWith(path, "build/") && !Str.startsWith(path, ".scuzz/") && (Str.endsWith(path, ".scuzz_scenario") || Str.endsWith(path, ".scuzz_verify")) || Str.startsWith(path, "corpus/") && Str.endsWith(path, ".toml")

def packageInputs(root: String, prefix: String, seen: List[String]): IO[List[(String, String)]] =
  for {
    abs <- Fs.canonicalize(root)
    _ <- Models.need(!List.contains(seen, abs), "dependency cycle")
    walked <- Fs.walk(root)
    paths = List.sort(List.map(List.filter(walked, e => !e._2 && inputPath(e._1)), e => e._1))
    files <- IO.foreach(paths, p => for {
  resolved <- Fs.canonicalize(Fs.join(root, p))
  s <- Fs.read(Fs.join(root, p))
} yield [(Fs.join(prefix, p), s), (Str.concat("resolved/", Fs.join(prefix, p)), resolved)])
    toml <- Fs.read(Fs.join(root, "scuzz.toml"))
    deps <- IO.foreach(Manifest.parse(toml).deps, d => packageInputs(Drive.depDir(root, d._2), Fs.join(Fs.join(prefix, "dependencies"), d._1), abs :: seen))
  } yield List.concat(List.flatten(files), List.flatten(deps))

def limits(): Json =
  Json.Obj([("files", Json.Int(3)), ("source_bytes", Json.Int(65536)), ("input_bytes", Json.Int(1048576)), ("response_bytes", Json.Int(131072)), ("context_tokens", Json.Int(4096)), ("output_tokens", Json.Int(1024)), ("request_ms", Json.Int(900000)), ("session_requests", Json.Int(8)), ("search_iterations", Json.Int(32)), ("cards", Json.Int(2)), ("feedback", Json.Int(16))])

def ruleLimits(): Json =
  Json.Obj([("files", Json.Int(1)), ("source_bytes", Json.Int(65536)), ("input_bytes", Json.Int(1048576)), ("response_bytes", Json.Int(131072)), ("context_tokens", Json.Int(4096)), ("output_tokens", Json.Int(1024)), ("request_ms", Json.Int(900000)), ("session_requests", Json.Int(8))])

def ruleInstructions(): String =
  "Propose one Timeline => Verdict claim supported by the recorded human preference and its finite witness. Add one new root *.scuzz_verify file or append the claim to one existing root *.scuzz_verify file. Do not alter, remove, or weaken any existing definition. Do not touch live source, scenarios, corpus files, dependencies, or manifests.\nUse Scuzz syntax. Define a public claim as def claimName(t: Timeline): Verdict = ... . Use Verdict.alwaysHas(t, \"a11y\"), Verdict.afterHit(t, \"trigger\", \"a11y\"), Verdict.onHit(t, \"trigger\", (prev, cur) => ...), or Verdict.every(t, i => ...). Every declared trigger must fire on the required workloads or supporting witness. Read UI text and signals from Timeline.a11yHas(t, i, \"...\"), Timeline.signalInt(t, i, \"...\"), or Timeline.signalStrHas(t, i, \"sig\", \"...\"). Finite evidence supports a checkable rule draft, not a universal proof. Omit markdown and explanations.\n"

def instructions(): String =
  "The objective is a long-term direction. Select one small useful addition toward it. Add one input or one action in this request. Keep all existing labels, controls, signals, and helper functions. Keep each existing View.textField and View.button in the replacement source. Keep the current behavior and all fixed checks true. A title change alone is not progress. Keep verification files, scenarios, dependencies, and manifests unchanged.\nRead task, sources, checks, and feedback. For a correction, preserve the intended small addition and correct the reported failure. For a duplicate, select a different useful addition. Do not repeat excluded source.\nUse Scuzz syntax. Scuzz has no statement blocks, val, var, or List(...) constructors. Use String for text, lists as [a, b], List.map(xs, x => ...), and records as record Message(text: String). Bind pure values with name = value in for. Bind IO with name <- effect. Return the final value with yield. Use lambdas for button callbacks. Use named def functions for callbacks with multiple arguments. Use one untyped parameter for a lambda, such as x => ... . Omit markdown and explanations.\nList functions:\nList.append(values: List[A], value: A): List[A]\nList.isEmpty(values: List[A]): Bool\nList.len(values: List[A]): Int\nList.take(values: List[A], count: Int): List[A]\nList.drop(values: List[A], count: Int): List[A]\nList.head(values: List[A]): A\nUse List.isEmpty(values), not values.isEmpty. Use List.take(values, count), not values.take(count).\nUI signatures:\nSignal.make(value: A): Signal[A]\nSignal.get(signal: Signal[A]): A\nSignal.set(signal: Signal[A], value: A): Unit\nSignal.map(signal: Signal[A], f: A => B): Signal[B]\nView.text(value: String): View\nView.bindText(value: Signal[String]): View\nView.textField(value: Signal[String], hint: String): View\nBind a text field to a source Signal[String]. Use Signal.make(\"\") for a new input. Name each control for its actual action. A Send action retains the message before it clears the input.\nView.button(label: String, action: Unit => Unit): View\nView.column(children: List[View]): View\nView.row(children: List[View]): View\nView.each(values: Signal[List[A]], render: A => View): View\nUi.run(render: Unit => View): IO[Unit]\nExample: add a draft field to an existing counter. Preserve the Counter label, count signal, and +1 action.\n@main def main: IO[Unit] =\n  for {\n    count = Signal.make(0)\n    draft = Signal.make(\"\")\n    label = Signal.map(count, n => s\"count = $n\")\n    _ <- Ui.run(_ => View.column([View.text(\"Counter\"), View.bindText(label), View.button(\"+1\", _ => Signal.set(count, Signal.get(count) + 1)), View.textField(draft, \"Message\")]))\n  } yield ()\nExample: a typed empty list and a callback with two actions.\ndef addMessage(messages: Signal[List[String]], draft: Signal[String]): Unit =\n  for {\n    _ = Signal.set(messages, List.append(Signal.get(messages), Signal.get(draft)))\n    _ = Signal.set(draft, \"\")\n  } yield ()\n\ndef messageView(): View =\n  for {\n    messages = Signal.make([]: List[String])\n    draft = Signal.make(\"\")\n  } yield View.column([View.textField(draft, \"Message\"), View.button(\"Send\", _ => addMessage(messages, draft)), View.each(messages, message => View.text(message))])\nFor the first addition, prefer one input or one action. Add only the state that this addition needs. Use the existing source as the base. Copy only the relevant syntax from an example. Do not replace the app with an example.\nSelect examples that apply to the current source. Preserve existing helper definitions. Implement one addition in this request. Formatting is automatic.\n"

def make(root: String, objective: String, allowed: List[String], compiler: String, feedback: List[Json]): IO[Json] =
  for {
    id <- Uuid.v4()
    sources <- own(root)
    inputs <- packageInputs(root, "package", [])
    j = Json.Obj([("v", Json.Int(1)), ("request", Json.Str(id)), ("kind", Json.Str("behavior")), ("objective", Json.Str(objective)), ("baseline", Json.Str(setHash(sources))), ("compiler", Json.Str(compiler)), ("inputs", Json.Str(setHash(inputs))), ("sources", pairsJson(List.filter(sources, f => List.contains(allowed, f._1)))), ("allowed", Json.Arr(List.map(allowed, p => Json.Str(p)))), ("checks", pairsJson(checkInputs(inputs))), ("feedback", Json.Arr(List.takeRight(feedback, 16))), ("limits", limits()), ("instructions", Json.Str(instructions()))])
    _ <- validate(root, j, compiler)
  } yield j

def makeRule(root: String, objective: String, compiler: String, preference: Json, witness: Json): IO[Json] =
  for {
    id <- Uuid.v4()
    sources <- own(root)
    verifyFiles <- ownVerify(root)
    inputs <- packageInputs(root, "package", [])
    j = Json.Obj([("v", Json.Int(1)), ("request", Json.Str(id)), ("kind", Json.Str("rule")), ("objective", Json.Str(objective)), ("baseline", Json.Str(setHash(sources))), ("compiler", Json.Str(compiler)), ("inputs", Json.Str(setHash(inputs))), ("sources", pairsJson(sources)), ("verify_files", pairsJson(verifyFiles)), ("checks", pairsJson(checkInputs(inputs))), ("preference", preference), ("witness", witness), ("limits", ruleLimits()), ("instructions", Json.Str(ruleInstructions()))])
    _ <- validateRule(root, j, compiler)
  } yield j

def checkInputs(inputs: List[(String, String)]): List[(String, String)] =
  List.filter(inputs, f => Str.startsWith(f._1, "package/") && (Str.endsWith(f._1, ".scuzz_verify") || Str.endsWith(f._1, ".scuzz_scenario") || Str.startsWith(f._1, "package/corpus/") && Str.endsWith(f._1, ".toml")))

def stringValue(j: Json): Bool =
  j match {
    case Json.Str(_) => true
    case _ => false
  }

def arrayValue(j: Json): Bool =
  j match {
    case Json.Arr(_) => true
    case _ => false
  }

def version(j: Json): Bool =
  field(j, "v") match {
    case Json.Int(1) => true
    case _ => false
  }

def resolvedOutput(path: String): IO[String] =
  Fs.canonicalize(path).handleErrorWith(_ => if (Fs.dirname(path) == path) IO.fail("candidate parent is unavailable") else resolvedOutput(Fs.dirname(path)).map(parent => Fs.join(parent, Fs.basename(path))))

def within(path: String, dir: String): Bool =
  path == dir || Str.startsWith(path, Str.concat(dir, "/"))

def outputSafe(root: String, out: String): IO[Unit] =
  for {
    _ <- Models.need(out != "" && Fs.basename(out) != "." && Fs.basename(out) != "..", "invalid candidate output directory")
    base <- Fs.canonicalize(root)
    dest <- resolvedOutput(out)
    inputs <- packageInputs(root, "package", [])
    packages = List.map(List.filter(inputs, f => Str.startsWith(f._1, "resolved/") && Str.endsWith(f._1, "/scuzz.toml")), f => Fs.dirname(f._2))
    inbox = Fs.join(base, "build/proposals")
    ownOutput = Fs.dirname(dest) == inbox || Fs.dirname(dest) == base && !List.contains(["src", "corpus", "build", ".scuzz", "scuzz.toml"], Fs.basename(dest))
    _ <- Models.need(!List.exists(packages, p => within(p, dest) || within(dest, p) && !(p == base && ownOutput)), "candidate output must be outside package inputs, a new package directory, or a new directory in build/proposals")
    exists <- Fs.exists(out)
    _ <- Models.need(exists == 0, "candidate output directory already exists")
  } yield ()

def validateRule(root: String, j: Json, compiler: String): IO[Unit] =
  for {
    _ <- Models.need(keys(j, ["v", "request", "kind", "objective", "baseline", "compiler", "inputs", "sources", "verify_files", "checks", "preference", "witness", "limits", "instructions"]) && version(j) && str(j, "kind") == "rule", "invalid rule request fields or version")
    _ <- Models.need(Str.matches(str(j, "request"), "^[A-Za-z0-9_-]{1,128}$") && Str.byteLen(str(j, "objective")) > 0 && Str.byteLen(str(j, "objective")) <= 2048 && str(j, "instructions") == ruleInstructions(), "invalid objective, request identity, or instructions")
    _ <- Models.need(Str.matches(compiler, "^[a-f0-9]{64}$") && str(j, "compiler") == compiler, "request compiler does not match")
    _ <- Models.need(text(field(j, "limits")) == text(ruleLimits()) && Str.byteLen(text(j)) <= 1048576, "invalid request limits")
    pref = field(j, "preference")
    _ <- Models.need(keys(pref, ["card", "proposal", "decision", "chosen", "rejected"]) && Str.matches(str(pref, "card"), "^[a-f0-9]{64}$") && List.contains(["accept", "baseline"], str(pref, "decision")) && arrayValue(field(pref, "chosen")) && arrayValue(field(pref, "rejected")), "invalid rule preference binding")
    wit = field(j, "witness")
    _ <- Models.need(keys(wit, ["id", "workload", "step", "events", "script", "chosen_timeline", "rejected_timeline"]) && Str.matches(str(wit, "id"), "^[a-f0-9]{64}$") && Str.byteLen(str(wit, "workload")) > 0 && arrayValue(field(wit, "events")) && stringValue(field(wit, "script")) && stringValue(field(wit, "chosen_timeline")) && stringValue(field(wit, "rejected_timeline")), "invalid rule witness binding")
    disk <- own(root)
    verifyFiles <- ownVerify(root)
    inputs <- packageInputs(root, "package", [])
    _ <- Models.need(str(j, "baseline") == setHash(disk) && text(field(j, "sources")) == text(pairsJson(disk)) && text(field(j, "verify_files")) == text(pairsJson(verifyFiles)) && str(j, "inputs") == setHash(inputs) && text(field(j, "checks")) == text(pairsJson(checkInputs(inputs))), "stale request baseline or inputs")
  } yield ()

def validate(root: String, j: Json, compiler: String): IO[Unit] =
  if (str(j, "kind") == "rule") validateRule(root, j, compiler) else for {
  _ <- Models.need(keys(j, ["v", "request", "kind", "objective", "baseline", "compiler", "inputs", "sources", "allowed", "checks", "feedback", "limits", "instructions"]) && version(j) && str(j, "kind") == "behavior", "invalid request fields or version")
  _ <- Models.need(Str.matches(str(j, "request"), "^[A-Za-z0-9_-]{1,128}$") && Str.byteLen(str(j, "objective")) > 0 && Str.byteLen(str(j, "objective")) <= 2048 && str(j, "instructions") == instructions(), "invalid objective, request identity, or instructions")
  _ <- Models.need(Str.matches(compiler, "^[a-f0-9]{64}$") && str(j, "compiler") == compiler, "request compiler does not match")
  _ <- Models.need(text(field(j, "limits")) == text(limits()) && arrayValue(field(j, "feedback")) && List.len(Json.arr(field(j, "feedback"))) <= 16 && Str.byteLen(text(j)) <= 1048576, "invalid request limits")
  allow = Json.arr(field(j, "allowed"))
  paths = List.map(allow, p => Json.strOr(p, ""))
  _ <- Models.need(List.nonEmpty(paths) && List.forall(allow, p => stringValue(p) && safePath(Json.strOr(p, ""))) && List.len(List.distinct(paths)) == List.len(paths), "invalid allowed source paths")
  _ <- IO.foreachDiscard(paths, p => checkInside(root, p))
  disk <- own(root)
  inputs <- packageInputs(root, "package", [])
  _ <- Models.need(str(j, "baseline") == setHash(disk) && text(field(j, "sources")) == text(pairsJson(List.filter(disk, f => List.contains(paths, f._1)))) && str(j, "inputs") == setHash(inputs) && text(field(j, "checks")) == text(pairsJson(checkInputs(inputs))), "stale request baseline or inputs")
} yield ()

def responseRule(j: Json, request: Json): IO[List[(String, String)]] =
  for {
    expectedWitness = str(field(request, "witness"), "id")
    _ <- Models.need(keys(j, ["v", "request", "baseline", "kind", "witness", "generator", "files"]) && version(j) && str(j, "request") == str(request, "request") && str(j, "baseline") == str(request, "baseline") && str(j, "kind") == "rule" && str(request, "kind") == "rule" && str(j, "witness") == expectedWitness, "invalid or stale rule identity or witness")
    _ <- Models.need(Str.byteLen(str(j, "generator")) > 0 && Str.byteLen(str(j, "generator")) <= 1024 && Str.byteLen(text(j)) <= 131072, "invalid generator or response size")
    fs = Json.arr(field(j, "files"))
    _ <- Models.need(List.forall(fs, f => keys(f, ["path", "content"]) && stringValue(field(f, "path")) && stringValue(field(f, "content"))), "invalid replacement fields")
    files = pairs(field(j, "files"))
    _ <- Models.need(ruleSetOk(files), "rule proposal exceeds verify scope or limit")
  } yield files

def response(j: Json, request: Json): IO[List[(String, String)]] =
  if (str(request, "kind") == "rule") responseRule(j, request) else for {
  _ <- Models.need(keys(j, ["v", "request", "baseline", "kind", "generator", "files"]) && version(j) && str(j, "request") == str(request, "request") && str(j, "baseline") == str(request, "baseline") && str(j, "kind") == str(request, "kind"), "invalid or stale proposal identity")
  _ <- Models.need(Str.byteLen(str(j, "generator")) > 0 && Str.byteLen(str(j, "generator")) <= 1024 && Str.byteLen(text(j)) <= 131072, "invalid generator or response size")
  fs = Json.arr(field(j, "files"))
  _ <- Models.need(List.forall(fs, f => keys(f, ["path", "content"]) && stringValue(field(f, "path")) && stringValue(field(f, "content"))), "invalid replacement fields")
  files = pairs(field(j, "files"))
  allowed = List.map(Json.arr(field(request, "allowed")), p => Json.strOr(p, ""))
  _ <- Models.need(sourceSetOk(files) && List.forall(files, f => List.contains(allowed, f._1)), "proposal exceeds source scope or limit")
} yield files

def metadata(request: String, baseline: String, generator: String, files: List[(String, String)]): String =
  text(Json.Obj([("v", Json.Int(1)), ("request", Json.Str(request)), ("baseline", Json.Str(baseline)), ("kind", Json.Str("behavior")), ("generator", Json.Str(generator)), ("files", Json.Arr(List.map(files, f => Json.Obj([("path", Json.Str(f._1)), ("sha256", Json.Str(Hash.sha256(f._2)))]))))]))

def ruleMetadata(request: String, baseline: String, witness: String, generator: String, files: List[(String, String)]): String =
  text(Json.Obj([("v", Json.Int(1)), ("request", Json.Str(request)), ("baseline", Json.Str(baseline)), ("kind", Json.Str("rule")), ("witness", Json.Str(witness)), ("generator", Json.Str(generator)), ("files", Json.Arr(List.map(files, f => Json.Obj([("path", Json.Str(f._1)), ("sha256", Json.Str(Hash.sha256(f._2)))]))))]))

def importRuleFrom(root: String, dir: String, request: Json): IO[List[(String, String)]] =
  for {
    _ <- checkInside(dir, "proposal.json")
    raw <- Fs.read(Fs.join(dir, "proposal.json"))
    j <- parse(raw, 131072)
    _ <- Models.need(keys(j, ["v", "request", "baseline", "kind", "witness", "generator", "files"]), "invalid rule publication fields")
    fs = Json.arr(field(j, "files"))
    _ <- Models.need(List.len(fs) == 1 && List.forall(fs, f => keys(f, ["path", "sha256"]) && safeVerifyPath(str(f, "path")) && Str.matches(str(f, "sha256"), "^[a-f0-9]{64}$")), "invalid rule publication verify set")
    files <- IO.foreach(fs, f => for {
  path = str(f, "path")
  _ <- checkInside(dir, path)
  _ <- checkInside(root, path)
  src <- Fs.read(Fs.join(dir, path))
  _ <- Models.need(Hash.sha256(src) == str(f, "sha256"), "incomplete rule publication")
} yield (path, src))
    normalized = Json.Obj(List.concat(List.filter(Json.pairs(j), p => p._1 != "files"), [("files", pairsJson(files))]))
    validated <- responseRule(normalized, request)
    walked <- Fs.walk(dir)
    actual = List.sort(List.map(List.filter(walked, e => !e._2), e => e._1))
    _ <- Models.need(actual == List.sort("proposal.json" :: List.map(files, f => f._1)), "undeclared publication file")
  } yield validated

def importFrom(root: String, dir: String, request: Json): IO[List[(String, String)]] =
  if (str(request, "kind") == "rule") importRuleFrom(root, dir, request) else for {
  _ <- checkInside(dir, "proposal.json")
  raw <- Fs.read(Fs.join(dir, "proposal.json"))
  j <- parse(raw, 131072)
  _ <- Models.need(keys(j, ["v", "request", "baseline", "kind", "generator", "files"]), "invalid publication fields")
  fs = Json.arr(field(j, "files"))
  _ <- Models.need(List.nonEmpty(fs) && List.len(fs) <= 3 && List.forall(fs, f => keys(f, ["path", "sha256"]) && safePath(str(f, "path")) && Str.matches(str(f, "sha256"), "^[a-f0-9]{64}$")), "invalid publication source set")
  files <- IO.foreach(fs, f => for {
  path = str(f, "path")
  _ <- checkInside(dir, path)
  _ <- checkInside(root, path)
  src <- Fs.read(Fs.join(dir, path))
  _ <- Models.need(Hash.sha256(src) == str(f, "sha256"), "incomplete proposal publication")
} yield (path, src))
  normalized = Json.Obj(List.concat(List.filter(Json.pairs(j), p => p._1 != "files"), [("files", pairsJson(files))]))
  validated <- response(normalized, request)
  walked <- Fs.walk(dir)
  actual = List.sort(List.map(List.filter(walked, e => !e._2), e => e._1))
  _ <- Models.need(actual == List.sort("proposal.json" :: List.map(files, f => f._1)), "undeclared publication file")
  toml <- Fs.read(Fs.join(root, "scuzz.toml"))
  sources <- own(root)
  all <- Drive.collectDeps(root, Manifest.parse(toml).deps, List.map(sources, f => (Str.dropRight(Fs.basename(f._1), 6), f._2)))
  additions = List.filter(files, f => !List.contains(List.map(sources, d => d._1), f._1))
  _ <- Models.need(!List.exists(additions, f => List.contains(List.map(all, d => d._1), Str.dropRight(Fs.basename(f._1), 6))), "duplicate module stem")
} yield validated

def publishRule(root: String, out: String, request: Json, reply: Json, compiler: String): IO[Unit] =
  for {
    _ <- validateRule(root, request, compiler)
    _ <- outputSafe(root, out)
    rawFiles <- responseRule(reply, request)
    files = List.map(rawFiles, f => for {
  parsed = Parse.parseFile(Str.dropRight(f._1, 13), f._2)
} yield (f._1, if (Parse.hasParseError(parsed)) f._2 else Parse.pretty(parsed)))
    _ <- responseRule(Json.set(reply, "files", pairsJson(files)), request)
    exists <- Fs.exists(out)
    _ <- Models.need(exists == 0, "candidate output directory already exists")
    nonce <- Uuid.v4()
    parent = Fs.dirname(out)
    _ <- Fs.mkdirs(parent)
    stage = Fs.join(Fs.dirname(parent), Str.concat(".scuzz-publish-", nonce))
    _ <- IO.ensure(for {
  _ <- Fs.mkdirs(stage)
  _ <- IO.foreachDiscard(files, f => Fs.write(Fs.join(stage, f._1), f._2))
  _ <- Fs.write(Fs.join(stage, "proposal.json"), ruleMetadata(str(request, "request"), str(request, "baseline"), str(reply, "witness"), str(reply, "generator"), files))
  _ <- importRuleFrom(root, stage, request)
  _ <- validateRule(root, request, compiler)
  finalExists <- Fs.exists(out)
  _ <- Models.need(finalExists == 0, "candidate output directory appeared during generation")
  _ <- Fs.rename(stage, out)
} yield (), Fs.delete(stage).handleErrorWith(_ => IO.pure(())))
  } yield ()

def publish(root: String, out: String, request: Json, reply: Json, compiler: String): IO[Unit] =
  if (str(request, "kind") == "rule") publishRule(root, out, request, reply, compiler) else for {
  _ <- validate(root, request, compiler)
  _ <- outputSafe(root, out)
  rawFiles <- response(reply, request)
  sources <- own(root)
  toml <- Fs.read(Fs.join(root, "scuzz.toml"))
  changed = List.concat(List.filter(sources, f => !List.contains(List.map(rawFiles, r => r._1), f._1)), rawFiles)
  candidate <- Drive.collectDeps(root, Manifest.parse(toml).deps, List.map(changed, f => (Str.dropRight(Fs.basename(f._1), 6), f._2)))
  valid = Check.checkFilesOwn(candidate, List.map(changed, f => Str.dropRight(Fs.basename(f._1), 6))) == "[]"
  files = if (!valid) rawFiles else List.map(rawFiles, f => for {
  parsed = Parse.parseFile(Str.dropRight(Fs.basename(f._1), 6), f._2)
} yield (f._1, if (Parse.hasParseError(parsed)) f._2 else Parse.pretty(parsed)))
  _ <- response(Json.set(reply, "files", pairsJson(files)), request)
  exists <- Fs.exists(out)
  _ <- Models.need(exists == 0, "candidate output directory already exists")
  nonce <- Uuid.v4()
  parent = Fs.dirname(out)
  _ <- Fs.mkdirs(parent)
  stage = Fs.join(Fs.dirname(parent), Str.concat(".scuzz-publish-", nonce))
  _ <- IO.ensure(for {
  _ <- Fs.mkdirs(Fs.join(stage, "src"))
  _ <- IO.foreachDiscard(files, f => Fs.write(Fs.join(stage, f._1), f._2))
  _ <- Fs.write(Fs.join(stage, "proposal.json"), metadata(str(request, "request"), str(request, "baseline"), str(reply, "generator"), files))
  _ <- importFrom(root, stage, request)
  _ <- validate(root, request, compiler)
  finalExists <- Fs.exists(out)
  _ <- Models.need(finalExists == 0, "candidate output directory appeared during generation")
  _ <- Fs.rename(stage, out)
} yield (), Fs.delete(stage).handleErrorWith(_ => IO.pure(())))
} yield ()

def validAbstentionReason(reason: String): Bool =
  reason == "" || reason == "no-visible-difference" || reason == "need-another-scenario" || reason == "outside-my-goal"

def abstentionReasonAt(index: Int): String =
  if (index == 1) "no-visible-difference" else if (index == 2) "need-another-scenario" else if (index == 3) "outside-my-goal" else ""

def recordSortKey(r: Json): String =
  Str.concat(str(r, "operation"), Str.concat("|", Str.concat(str(r, "card"), Str.concat("|", text(r)))))

def sortRecords(records: List[Json]): List[Json] =
  for {
    keys = List.sort(List.distinct(List.map(records, r => recordSortKey(r))))
    byKey = List.sortBy(records, r => List.indexOf(keys, recordSortKey(r)))
  } yield List.sortBy(byKey, r => Json.getInt(r, "time", 0))

def feedbackEntry(r: Json, undoneCards: List[String]): Json =
  for {
    kind = str(r, "kind")
    decision = str(r, "decision")
    region = if (arrayValue(field(r, "region"))) field(r, "region") else Json.Arr([])
    time = Json.getInt(r, "time", 0)
    reason = if (validAbstentionReason(str(r, "reason"))) str(r, "reason") else ""
  } yield if (kind == "automatic") Json.Null() else if (decision == "accept" || decision == "baseline" || decision == "reject") Json.Obj([("kind", Json.Str("preference")), ("decision", Json.Str(if (decision == "accept") "accept" else "baseline")), ("card", Json.Str(str(r, "card"))), ("proposal", Json.Str(str(r, "proposal"))), ("region", region), ("undone", Json.Bool(decision == "accept" && List.contains(undoneCards, str(r, "card")))), ("time", Json.Int(time))]) else if (decision == "abstain" || decision == "skip") Json.Obj([("kind", Json.Str("abstention")), ("decision", Json.Str("abstain")), ("card", Json.Str(str(r, "card"))), ("proposal", Json.Str(str(r, "proposal"))), ("reason", Json.Str(reason)), ("region", region), ("time", Json.Int(time))]) else if (decision == "undo") Json.Obj([("kind", Json.Str("undo")), ("decision", Json.Str("undo")), ("card", Json.Str(str(r, "card"))), ("proposal", Json.Str(str(r, "proposal"))), ("region", region), ("time", Json.Int(time))]) else Json.Null()

def boundedFeedback(records: List[Json], automatic: List[Json]): List[Json] =
  for {
    ordered = sortRecords(records)
    undoneCards = List.distinct(List.map(List.filter(ordered, r => str(r, "kind") != "automatic" && str(r, "decision") == "undo"), r => str(r, "card")))
    humanAll = List.filter(List.map(ordered, r => feedbackEntry(r, undoneCards)), item => !Json.isNull(item))
    keptAuto = List.takeRight(List.sortBy(automatic, a => Json.getInt(a, "time", 0)), 3)
    keptHuman = List.takeRight(humanAll, 16 - List.len(keptAuto))
  } yield List.sortBy(List.concat(keptHuman, keptAuto), item => Json.getInt(item, "time", 0))

def loadLocalRecords(root: String): IO[List[Json]] =
  for {
    dir = Fs.join(root, ".scuzz/ide/records")
    entries <- Fs.list(dir).handleErrorWith(_ => IO.pure([]))
    names = List.sort(List.map(List.filter(entries, e => !e._2 && Str.matches(e._1, "^[A-Za-z0-9_-]+\\.json$")), e => e._1))
    parsed <- IO.foreach(names, name => for {
  _ <- checkInside(root, Fs.join(".scuzz/ide/records", name))
  raw <- Fs.read(Fs.join(dir, name)).handleErrorWith(_ => IO.pure(""))
} yield Json.parse(raw) match {
  case Result.Ok(j) => if (Json.isObj(j)) j else Json.Null()
  case Result.Err(_) => Json.Null()
})
  } yield sortRecords(List.filter(parsed, j => !Json.isNull(j)))

def recentFeedback(root: String, automatic: List[Json]): IO[List[Json]] =
  loadLocalRecords(root).map(records => boundedFeedback(records, automatic))

def checkExistingInside(root: String, path: String): IO[Unit] =
  relativePath(path) match {
    case Result.Err(error) => IO.fail(error)
    case Result.Ok(value) => for {
  base <- Fs.canonicalize(root)
  resolved <- Fs.canonicalize(Fs.join(root, value.value)).handleErrorWith(_ => IO.fail(Str.concat("unsafe resolved path: ", value.value)))
  _ <- Models.need(resolved == Fs.join(base, value.value), Str.concat("unsafe resolved path: ", value.value))
} yield ()
  }

def checkTargetInside(root: String, path: String): IO[Unit] =
  relativePath(path) match {
    case Result.Err(error) => IO.fail(error)
    case Result.Ok(value) => for {
  base <- Fs.canonicalize(root)
  resolved <- resolvedOutput(Fs.join(root, value.value))
  _ <- Models.need(resolved == Fs.join(base, value.value), Str.concat("unsafe resolved path: ", value.value))
} yield ()
  }

def checkNoDuplicateStems(root: String, files: List[(String, String)]): IO[Unit] =
  for {
    _ <- Models.need(List.len(List.distinct(List.map(files, f => Str.toLower(f._1)))) == List.len(files), "duplicate module stem")
    toml <- Fs.read(Fs.join(root, "scuzz.toml"))
    m = Manifest.parse(toml)
    _ <- Drive.manNeed(m)
    sources <- own(root)
    all <- Drive.collectDeps(root, m.deps, List.map(sources, f => (Str.dropRight(Fs.basename(f._1), 6), f._2)))
    additions = List.filter(files, f => !List.contains(List.map(sources, d => d._1), f._1))
    knownStems = List.map(all, d => Str.toLower(d._1))
    _ <- Models.need(!List.exists(additions, f => List.contains(knownStems, Str.toLower(Str.dropRight(Fs.basename(f._1), 6)))), "duplicate module stem")
  } yield ()

private def checkTargetSourcePaths(root: String, paths: List[String]): IO[Unit] =
  for {
    _ <- checkExistingInside(root, "src")
    srcEnts <- Fs.list(Fs.join(root, "src"))
    existing = List.map(srcEnts, e => Fs.join("src", e._1))
    _ <- IO.foreachDiscard(paths, p => if (List.contains(existing, p)) checkExistingInside(root, p) else checkTargetInside(root, p))
  } yield ()

private def finalizeInboxCandidate(root: String, generator: String, files: List[(String, String)]): IO[Option[Result[String, (String, List[(String, String)])]]] =
  if (!sourceSetOk(files)) IO.pure(Option.Some(Result.Err("proposal exceeds source scope or limit"))) else IO.attempt(checkNoDuplicateStems(root, files)).map(res => res match {
  case Result.Err(err) => Option.Some(Result.Err(err))
  case Result.Ok(_) => Option.Some(Result.Ok((generator, files)))
})

private def importInboxPublished(root: String, candDir: String, baseline: String, actualFiles: List[String], actualDirs: List[String]): IO[Option[Result[String, (String, List[(String, String)])]]] =
  IO.attempt(Fs.read(Fs.join(candDir, "proposal.json"))).flatMap(rawRes => rawRes match {
  case Result.Err(_) => IO.pure(Option.None)
  case Result.Ok(raw) => if (Str.byteLen(raw) > 131072) IO.pure(Option.Some(Result.Err("serialized input exceeds its byte limit"))) else Json.parse(raw) match {
  case Result.Err(_) => IO.pure(Option.None)
  case Result.Ok(j) => if (!Json.isObj(j) || keys(j, ["v", "request", "baseline", "kind", "witness", "generator", "files"]) && version(j) && str(j, "kind") == "rule") IO.pure(Option.None) else for {
  metaOk = keys(j, ["v", "request", "baseline", "kind", "generator", "files"]) && version(j) && str(j, "kind") == "behavior" && Str.matches(str(j, "request"), "^[A-Za-z0-9_-]{1,128}$") && Str.matches(str(j, "baseline"), "^[a-f0-9]{64}$") && stringValue(field(j, "generator")) && Str.byteLen(str(j, "generator")) > 0 && Str.byteLen(str(j, "generator")) <= 1024 && arrayValue(field(j, "files"))
  out <- if (!metaOk) IO.pure(Option.Some(Result.Err("invalid publication fields"))) else for {
  fs = Json.arr(field(j, "files"))
  declPaths = List.map(fs, f => str(f, "path"))
  setOk = List.nonEmpty(fs) && List.len(fs) <= 3 && List.forall(fs, f => keys(f, ["path", "sha256"]) && stringValue(field(f, "path")) && stringValue(field(f, "sha256")) && safePath(str(f, "path")) && Str.matches(str(f, "sha256"), "^[a-f0-9]{64}$")) && List.len(List.distinct(declPaths)) == List.len(declPaths)
  step <- if (!setOk) IO.pure(Option.Some(Result.Err("invalid publication source set"))) else IO.attempt(checkTargetSourcePaths(root, declPaths)).flatMap(targetRes => targetRes match {
  case Result.Err(err) => IO.pure(Option.Some(Result.Err(err)))
  case Result.Ok(_) => if (!List.forall(declPaths, p => List.contains(actualFiles, p))) IO.pure(Option.None) else IO.attempt(IO.foreach(fs, f => Fs.read(Fs.join(candDir, str(f, "path"))).map(src => (str(f, "path"), src)))).flatMap(readRes => readRes match {
  case Result.Err(_) => IO.pure(Option.None)
  case Result.Ok(files) => if (!List.forall(fs, f => List.exists(files, p => p._1 == str(f, "path") && Hash.sha256(p._2) == str(f, "sha256")))) IO.pure(Option.None) else for {
  expectedFiles = List.sort("proposal.json" :: declPaths)
  checked <- if (actualFiles != expectedFiles || actualDirs != ["src"]) IO.pure(Option.Some(Result.Err("undeclared publication file"))) else if (str(j, "baseline") != baseline) IO.pure(Option.Some(Result.Err("stale-proposal-baseline"))) else finalizeInboxCandidate(root, str(j, "generator"), files)
} yield checked
})
})
} yield step
} yield out
}
})

private def importInboxRaw(root: String, candDir: String, actualFiles: List[String], actualDirs: List[String]): IO[Option[Result[String, (String, List[(String, String)])]]] =
  if (!List.forall(actualFiles, p => safePath(p)) || actualDirs != ["src"]) IO.pure(Option.Some(Result.Err("undeclared publication file"))) else if (List.len(actualFiles) > 3) IO.pure(Option.Some(Result.Err("proposal exceeds source scope or limit"))) else IO.attempt(checkTargetSourcePaths(root, actualFiles)).flatMap(targetRes => targetRes match {
  case Result.Err(err) => IO.pure(Option.Some(Result.Err(err)))
  case Result.Ok(_) => IO.attempt(IO.foreach(actualFiles, p => Fs.read(Fs.join(candDir, p)).map(src => (p, src)))).flatMap(readRes => readRes match {
  case Result.Err(_) => IO.pure(Option.None)
  case Result.Ok(files) => finalizeInboxCandidate(root, "inbox", files)
})
})

def importInbox(root: String, name: String, baseline: String): IO[Option[Result[String, (String, List[(String, String)])]]] =
  if (!Str.matches(name, "^[A-Za-z0-9_-]{1,128}$")) IO.pure(Option.None) else for {
  relDir = Fs.join("build/proposals", name)
  candDir = Fs.join(root, relDir)
  dirRes <- IO.attempt(checkExistingInside(root, "build/proposals").flatMap(_ => checkExistingInside(root, relDir)))
  out <- dirRes match {
  case Result.Err(err) => IO.pure(Option.Some(Result.Err(err)))
  case Result.Ok(_) => IO.attempt(Fs.walk(candDir)).flatMap(walkRes => walkRes match {
  case Result.Err(_) => IO.pure(Option.None)
  case Result.Ok(walked) => IO.attempt(IO.foreachDiscard(walked, e => checkExistingInside(candDir, e._1))).flatMap(walkCheck => walkCheck match {
  case Result.Err(err) => Fs.walk(candDir).handleErrorWith(_ => IO.pure([]: List[(String, Bool)])).map(reWalk => if (reWalk != walked) Option.None else Option.Some(Result.Err(err)))
  case Result.Ok(_) => for {
  actualFiles = List.sort(List.map(List.filter(walked, e => !e._2), e => e._1))
  actualDirs = List.sort(List.map(List.filter(walked, e => e._2), e => e._1))
  res <- if (List.isEmpty(actualFiles) || List.exists(actualFiles, p => Str.endsWith(p, ".tmp") || Str.endsWith(p, ".part"))) IO.pure(Option.None) else if (List.contains(actualFiles, "proposal.json")) importInboxPublished(root, candDir, baseline, actualFiles, actualDirs) else importInboxRaw(root, candDir, actualFiles, actualDirs)
} yield res
})
})
}
} yield out

