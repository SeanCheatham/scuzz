def headerBreak(): String =
  """

"""

def frame(body: String): String =
  Str.concat("Content-Length: ", Str.concat(Str.fromInt(Str.byteLen(body)), Str.concat(headerBreak(), body))) match {
    case s => Property.check("frame", Str.contains(s, "Content-Length: ") && Str.contains(s, body), s)
  }

def parseLen(head: String): Int =
  Str.toInt(Str.take(Str.drop(head, Str.indexOf(head, "Content-Length: ") + Str.len("Content-Length: ")), Str.indexOf(Str.drop(head, Str.indexOf(head, "Content-Length: ") + Str.len("Content-Length: ")), Str.take(headerBreak(), Str.len("x")))), Str.len("")) match {
    case n => Property.check("plen", n >= 0, n)
  }

def needLen(start: Int, len: Int): Int =
  start + len

def msgSlice(full: String, start: Int, len: Int): String =
  Str.byteSlice(full, start, needLen(start, len)) match {
    case s => Property.check("mslice", Str.len(s) >= 0, s)
  }

def parseJson(s: String): Json =
  Json.parse(s) match {
    case Result.Ok(j) => j
    case Result.Err(_) => Json.Null()
  }

def infoCall(root: String, path: String, body: String, method: String, line: Int, col: Int, nu: String): IO[Json] =
  Lsp.query(root, path, body, method, line, col, nu).map(s => parseJson(s))

def takeIfMatch(j: Json, want: Int): Json =
  if (Diags.jsonInt(Diags.jsonField(j, "id")) == want) j else Json.Null()

def hoverText(j: Json): String =
  Diags.jsonStr(Diags.jsonField(Diags.jsonField(Diags.jsonField(j, "result"), "contents"), "value")) match {
    case s => Property.check("hover", Str.len(s) >= 0, s)
  }

def completeLabels(j: Json): List[String] =
  Diags.jsonField(Diags.jsonField(j, "result"), "items") match {
    case Json.Arr(xs) => List.map(xs, it => Diags.jsonStr(Diags.jsonField(it, "label")))
    case _ => []
  }

def defLoc(j: Json): Json =
  Diags.jsonField(j, "result") match {
    case Json.Arr(x :: _) => x
    case other => other
  }

def defUri(j: Json): String =
  Diags.jsonStr(Diags.jsonField(defLoc(j), "uri")) match {
    case s => Property.check("defUri", Str.len(s) >= 0, s)
  }

def defLine(j: Json): Int =
  Diags.jsonInt(Diags.jsonField(Diags.jsonField(Diags.jsonField(defLoc(j), "range"), "start"), "line")) + Str.len("x") match {
  case n => Property.check("defLine", n > 0, n)
}

def defCol(j: Json): Int =
  Diags.jsonInt(Diags.jsonField(Diags.jsonField(Diags.jsonField(defLoc(j), "range"), "start"), "character")) + Str.len("x") match {
  case n => Property.check("defCol", n > 0, n)
}

def formatText(j: Json, fallback: String): String =
  Diags.jsonField(j, "result") match {
    case Json.Arr(x :: _) => Diags.jsonStr(Diags.jsonField(x, "newText")) match {
  case t => if (Str.isEmpty(t)) fallback else t
}
    case _ => fallback
  }

def renameText(j: Json, fallback: String): String =
  firstNewText(Diags.jsonField(Diags.jsonField(j, "result"), "changes")) match {
    case t => if (Str.isEmpty(t)) fallback else t
  }

def fixTitle(j: Json): String =
  Diags.jsonField(j, "result") match {
    case Json.Arr(x :: _) => Diags.jsonStr(Diags.jsonField(x, "title"))
    case _ => ""
  }

def firstNewText(j: Json): String =
  j match {
    case Json.Obj(pairs) => List.find(pairs, p => p._1 == "newText") match {
  case x :: _ => Diags.jsonStr(x._2)
  case [] => List.find(List.map(pairs, p => firstNewText(p._2)), s => Str.nonEmpty(s)) match {
  case h :: _ => h
  case [] => ""
}
}
    case Json.Arr(xs) => List.find(List.map(xs, firstNewText), s => Str.nonEmpty(s)) match {
  case h :: _ => h
  case [] => ""
}
    case _ => ""
  }

def fixText(j: Json, fallback: String): String =
  firstNewText(j) match {
    case t => if (Str.isEmpty(t)) fallback else t
  }

def tokenCount(j: Json): Int =
  Diags.jsonField(Diags.jsonField(j, "result"), "data") match {
    case Json.Arr(xs) => List.len(xs)
    case _ => Str.len("")
  }

def tokenData(j: Json): List[Int] =
  Diags.jsonField(Diags.jsonField(j, "result"), "data") match {
    case Json.Arr(xs) => List.map(xs, Diags.jsonInt)
    case _ => []
  }

def inlayLabel(j: Json): String =
  j match {
    case Json.Str(s) => s
    case Json.Arr(xs) => List.join(List.map(xs, it => Diags.jsonStr(Diags.jsonField(it, "value"))), "")
    case _ => ""
  }

def inlayHint(item: Json): (Int, Int, String) =
  (Diags.jsonInt(Diags.jsonField(Diags.jsonField(item, "position"), "line")), Diags.jsonInt(Diags.jsonField(Diags.jsonField(item, "position"), "character")), inlayLabel(Diags.jsonField(item, "label")))

def inlayHints(j: Json): List[(Int, Int, String)] =
  Diags.jsonField(j, "result") match {
    case Json.Arr(xs) => List.map(xs, inlayHint)
    case _ => []
  }

def foldRange(item: Json): (Int, Int) =
  (Diags.jsonInt(Diags.jsonField(item, "startLine")), Diags.jsonInt(Diags.jsonField(item, "endLine")))

def foldRanges(j: Json): List[(Int, Int)] =
  Diags.jsonField(j, "result") match {
    case Json.Arr(xs) => List.map(xs, foldRange)
    case _ => []
  }

def paintEditor(root: String, path: String, body: String): IO[Json] =
  for {
    tok <- lspCall(root, path, body, "textDocument/semanticTokens/full").handleErrorWith(_ => IO.pure(Json.Null()))
    inl <- lspCall(root, path, body, "textDocument/inlayHint").handleErrorWith(_ => IO.pure(Json.Null()))
    fld <- lspCall(root, path, body, "textDocument/foldingRange").handleErrorWith(_ => IO.pure(Json.Null()))
    _ <- Ui.setEditorTokens(tokenData(tok))
    _ <- Ui.setEditorInlays(inlayHints(inl))
    _ <- Ui.setEditorFolds(foldRanges(fld))
  } yield tok

def readUntil(pid: Int, acc: String): IO[String] =
  if (Lsp.headerBody(acc) >= 0) IO.pure(acc) else Sys.childRead(pid, 1).flatMap(c => if (Str.isEmpty(c)) IO.fail("LSP: incomplete header") else readUntil(pid, Str.concat(acc, c)))

def fillTo(pid: Int, acc: String, need: Int): IO[String] =
  if (Str.byteLen(acc) >= need) IO.pure(acc) else Sys.childRead(pid, need - Str.byteLen(acc)).flatMap(c => if (Str.isEmpty(c)) IO.fail("LSP: incomplete body") else fillTo(pid, Str.concat(acc, c), need))

def readMsg(pid: Int, buffer: Ref[String]): IO[String] =
  for {
    cached <- Ref.get(buffer)
    acc <- readUntil(pid, cached)
    start = Lsp.headerBody(acc)
    len = Lsp.parseLen(acc)
    _ <- Cards.need(start >= 0 && len > 0 && len <= 1048576, "LSP: invalid message length")
    full <- fillTo(pid, acc, start + len)
    parts = Lsp.readMsg5(full, start, len)
    _ <- Ref.set(buffer, parts._2)
  } yield parts._1

def readResult(pid: Int, buffer: Ref[String], want: Int): IO[Json] =
  for {
    raw <- readMsg(pid, buffer)
    j = parseJson(raw)
    hit = takeIfMatch(j, want)
    out <- hit match {
  case Json.Null => readResult(pid, buffer, want)
  case _ => IO.pure(hit)
}
  } yield out

def lspCall(root: String, path: String, body: String, method: String): IO[Json] =
  Lsp.query(root, path, body, method, Str.len(""), Str.len(""), "x").map(s => parseJson(s))

