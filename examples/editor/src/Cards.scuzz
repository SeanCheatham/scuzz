def text(j: Json): String =
  Json.stringify(j) match {
    case Result.Ok(s) => s
    case Result.Err(e) => e
  }

def str(j: Json, key: String): String =
  Json.getStr(j, key, "")

def pairsJson(files: List[(String, String)]): Json =
  Proposal.pairsJson(files)

def pairs(j: Json): List[(String, String)] =
  Proposal.pairs(j)

def setHash(files: List[(String, String)]): String =
  Proposal.setHash(files)

def applyPaths(disk: List[(String, String)], props: List[(String, String)]): List[(String, String)] =
  List.concat(List.map(disk, d => (d._1, List.getOrElse(List.map(props, p => p._2), List.indexOf(List.map(props, p => p._1), d._1), d._2))), List.filter(props, p => !List.contains(List.map(disk, d => d._1), p._1)))

def safePath(path: String): Bool =
  Proposal.safePath(path)

def sourceSetOk(files: List[(String, String)]): Bool =
  Proposal.sourceSetOk(files)

def need(ok: Bool, why: String): IO[Unit] =
  if (ok) IO.pure(()) else IO.fail(why)

def own(root: String): IO[List[(String, String)]] =
  Proposal.own(root)

def inside(root: String, path: String): IO[Unit] =
  Proposal.inside(root, path)

def dirtyHits(root: String, props: List[(String, String)], dirties: List[String]): IO[List[String]] =
  for {
    dirty <- IO.foreach(dirties, p => Fs.canonicalize(p))
    touched <- IO.foreach(props, p => Fs.canonicalize(Fs.join(root, p._1)).handleErrorWith(_ => Fs.canonicalize(Fs.dirname(Fs.join(root, p._1))).map(dir => Fs.join(dir, Fs.basename(p._1)))))
  } yield List.map(List.filter(List.indices(props), i => List.contains(dirty, List.at(touched, i))), i => List.at(props, i)._1)

def metadata(request: String, baseline: String, generator: String, files: List[(String, String)]): String =
  Proposal.metadata(request, baseline, generator, files)

def importProposal(root: String, name: String): IO[List[(String, String)]] =
  for {
    request <- proposalRequest(root, name)
    files <- importFor(root, name, request)
  } yield files

def requestArchivePath(root: String, id: String): String =
  Fs.join(Fs.join(storage(root), "requests"), Str.concat(id, ".json"))

def requestArchive(root: String, id: String): IO[Json] =
  for {
    _ <- need(Str.matches(id, "^[A-Za-z0-9_-]{1,128}$"), "unsafe request identity")
    _ <- inside(root, Fs.join(".scuzz/ide/requests", Str.concat(id, ".json")))
    exists <- Fs.exists(requestArchivePath(root, id))
    _ <- need(exists != 0, stalePublicationMessage())
    raw <- Fs.read(requestArchivePath(root, id))
    archive <- Proposal.parse(raw, 1067008)
    _ <- need(Proposal.keys(archive, ["v", "request", "session"]) && Proposal.version(archive) && Proposal.stringValue(Proposal.field(archive, "session")) && str(Proposal.field(archive, "request"), "request") == id, "invalid frozen request archive")
  } yield archive

def rememberRequest(root: String, request: Json): IO[Unit] =
  for {
    id = str(request, "request")
    _ <- need(Str.matches(id, "^[A-Za-z0-9_-]{1,128}$"), "unsafe request identity")
    _ <- setupStorage(root)
    _ <- Fs.mkdirs(Fs.join(storage(root), "requests"))
    _ <- inside(root, Fs.join(".scuzz/ide/requests", Str.concat(id, ".json")))
    session <- sessionContext(root)
    archive = text(Json.Obj([("v", Json.Int(1)), ("request", request), ("session", Json.Str(session))]))
    previous <- readOptional(requestArchivePath(root, id))
    _ <- need(Str.isEmpty(previous) || previous == archive, "frozen request identity is already stored")
    _ <- if (Str.isEmpty(previous)) Fs.write(requestArchivePath(root, id), archive) else IO.pure(())
  } yield ()

def proposalRequest(root: String, name: String): IO[Json] =
  for {
    _ <- need(Str.matches(name, "^[A-Za-z0-9_-]+$"), "unsafe proposal name")
    path = Fs.join(Fs.join("build/proposals", name), "proposal.json")
    _ <- inside(root, path)
    publicationRaw <- Fs.read(Fs.join(root, path))
    publication <- Proposal.parse(publicationRaw, 131072)
    id = str(publication, "request")
    _ <- need(Str.matches(id, "^[A-Za-z0-9_-]{1,128}$"), "unsafe publication request identity")
    latestRaw <- Fs.read(Fs.join(root, "build/ide/request.json"))
    latest <- Proposal.parse(latestRaw, 1048576)
    archive <- requestArchive(root, id)
    request = Proposal.field(archive, "request")
    session <- sessionContext(root)
    _ <- need(str(archive, "session") == session && requestContext(request) == requestContext(latest), stalePublicationMessage())
    compiler <- compilerIdentity()
    _ <- Proposal.validate(root, latest, compiler)
    _ <- Proposal.validate(root, request, compiler)
  } yield request

def stalePublicationMessage(): String =
  "publication request no longer matches the session"

def excludePublication(root: String, name: String, context: String): IO[Unit] =
  for {
    _ <- need(Str.matches(name, "^[A-Za-z0-9_-]+$"), "unsafe proposal name")
    relative = Fs.join(Fs.join("build/proposals", name), "proposal.json")
    _ <- inside(root, relative)
    raw <- Fs.read(Fs.join(root, relative))
    publication <- Proposal.parse(raw, 131072)
    id <- Uuid.v4()
    now <- Clock.monotonic()
    entry = Json.Obj([("v", Json.Int(1)), ("operation", Json.Str(id)), ("proposal", Json.Str(name)), ("kind", Json.Str("automatic")), ("decision", Json.Str("stale-publication")), ("evidence_status", Json.Str("not-reviewed")), ("input_context", Json.Str(context)), ("publication", publication), ("time", Json.Int(now)), ("writes", Json.Arr([]))])
    _ <- setupStorage(root)
    _ <- Fs.write(recordPath(root, id), text(entry))
  } yield ()

def importFor(root: String, name: String, request: Json): IO[List[(String, String)]] =
  for {
    _ <- need(Str.matches(name, "^[A-Za-z0-9_-]+$"), "unsafe proposal name")
    _ <- inside(root, Fs.join("build/proposals", name))
    files <- Proposal.importFrom(root, Fs.join(Deck.proposalsDir(root), name), request)
  } yield files

def inputPath(path: String): Bool =
  Proposal.inputPath(path)

def packageInputs(root: String, prefix: String, seen: List[String]): IO[List[(String, String)]] =
  Proposal.packageInputs(root, prefix, seen)

def compilerIdentity(): IO[String] =
  for {
    cli <- Main.scuzzCli()
    digest <- executableIdentity(cli)
  } yield digest

def executableIdentity(cli: String): IO[String] =
  for {
    got <- Sys.exec(Str.concat("review_cli=$(command -v ", Str.concat(Lanes.shQuote(cli), ") && if command -v sha256sum >/dev/null 2>&1; then sha256sum \"$review_cli\"; else shasum -a 256 \"$review_cli\"; fi")))
    digest = Str.take(Str.trim(got._2), 64)
    _ <- need(got._1 == 0 && Str.matches(digest, "^[a-f0-9]{64}$"), "cannot identify review compiler")
  } yield digest

def requestContext(request: Json): String =
  text(Json.Obj(List.map(["v", "kind", "objective", "baseline", "compiler", "inputs", "sources", "allowed", "checks", "limits", "instructions"], key => (key, Proposal.field(request, key)))))

def sessionContext(root: String): IO[String] =
  for {
    raw <- readOptional(Fs.join(storage(root), "session.json"))
    session <- Proposal.parse(if (Str.isEmpty(raw)) "{}" else raw, 8192)
  } yield sessionFields(session)

def sessionFields(session: Json): String =
  text(Json.Obj(List.map(["baseline_epoch", "objective", "allowed", "mode", "model", "resolved_model", "backend", "limits"], key => (key, Proposal.field(session, key)))))

def currentInputs(root: String): IO[List[(String, String)]] =
  Fs.read(Fs.join(root, "build/ide/request.json")).flatMap(raw => Proposal.parse(raw, 1048576)).flatMap(request => inputs(root, request))

def inputs(root: String, request: Json): IO[List[(String, String)]] =
  for {
    files <- packageInputs(root, "package", [])
    compiler <- Sys.getenv("SCUZZ_EXECUTABLE_SHA256")
    session <- sessionContext(root)
    cli <- compilerIdentity()
    _ <- Proposal.validate(root, request, cli)
    toml <- Fs.read(Fs.join(root, "scuzz.toml"))
    host <- if (Manifest.parse(toml).hasUi) Main.scuzzCli().flatMap(scuzz => Drive.uiHostExe(scuzz)).flatMap(exe => need(exe != "", "UI review host is unavailable").flatMap(_ => executableIdentity(exe))) else IO.pure(cli)
  } yield List.concat(files, [("compiler", compiler), ("review-compiler", cli), ("review-host", host), ("request-context", requestContext(request)), ("session-context", session), ("objective", str(request, "objective")), ("limits", "files=3;source=65536;review=idle,seeds,corpus;search=32;seed=1")])

def storage(root: String): String =
  Fs.join(root, ".scuzz/ide")

def cardDir(root: String, id: String): String =
  Fs.join(Fs.join(storage(root), "cards"), id)

def identity(inputs0: List[(String, String)], props: List[(String, String)], publication: String, nonce: String): String =
  Hash.sha256(text(Json.Arr([pairsJson(inputs0), pairsJson(props), Json.Str(publication), Json.Str(nonce)])))

def candidatePass(raw: String): Bool =
  candidateReportPass(LspClient.parseJson(raw))

def candidateReportPass(j: Json): Bool =
  for {
    review = Diags.jsonField(j, "review")
    search = Diags.jsonField(j, "search")
    rows = Json.arr(Diags.jsonField(j, "workloads"))
    required = Json.getInt(review, "required", 0)
  } yield str(j, "kind") == "diff" && Json.getBool(review, "complete", false) && required >= 1 && Json.getInt(review, "completed_required", -1) == required && Json.getInt(search, "iterations", -1) == 32 && Json.getInt(search, "ran", -1) == 32 && Json.getInt(search, "seed", -1) == 1 && Json.getInt(review, "recorded_workloads", -1) == List.len(rows) && List.len(rows) >= required + 32 && List.len(List.distinct(List.map(rows, w => str(w, "label")))) == List.len(rows) && List.forall(rows, w => candidateRowPass(w))

def candidateRowPass(w: Json): Bool =
  Json.has(w, "why_a") && Json.has(w, "why_b") && Json.isNull(Diags.jsonField(w, "why_b")) && (Json.isNull(Diags.jsonField(w, "why_a")) || str(w, "why_a") == "check failed" || Diff.constraintFailure(str(w, "why_a"))) && (str(w, "class") != "unrunnable" || str(w, "why_a") == "check failed") && List.contains(["same", "fixed", "diverged", "regressed", "unrunnable"], str(w, "class")) && !Str.isEmpty(str(w, "label")) && !Str.isEmpty(Lanes.workPath(w, "a")) && !Str.isEmpty(Lanes.workPath(w, "b"))

def setupStorage(root: String): IO[Unit] =
  for {
    _ <- Fs.mkdirs(Fs.join(root, ".scuzz"))
    _ <- inside(root, ".scuzz")
    _ <- Fs.mkdirs(storage(root))
    _ <- inside(root, ".scuzz/ide")
    _ <- Fs.mkdirs(Fs.join(storage(root), "cards"))
    _ <- Fs.mkdirs(Fs.join(storage(root), "records"))
    _ <- inside(root, ".scuzz/ide/cards")
    _ <- inside(root, ".scuzz/ide/records")
  } yield ()

def freeze(root: String, name: String, props: List[(String, String)], flip: Int): IO[Json] =
  for {
    ins <- currentInputs(root)
    disk <- own(root)
    request <- proposalRequest(root, name)
    imported <- importFor(root, name, request)
    _ <- need(setHash(imported) == setHash(props), "proposal changed before freezing")
    pub <- Fs.read(Fs.join(Fs.join(Deck.proposalsDir(root), name), "proposal.json"))
    nonce <- Uuid.v4()
    now <- Clock.monotonic()
    id = identity(List.concat(ins, [("frozen-request", text(request))]), props, pub, nonce)
    c = Json.Obj([("v", Json.Int(1)), ("id", Json.Str(id)), ("proposal", Json.Str(name)), ("publication", Json.Str(pub)), ("objective", Json.Str(List.getOrElse(List.map(ins, f => f._2), List.indexOf(List.map(ins, f => f._1), "objective"), ""))), ("inputs", pairsJson(ins)), ("baseline", pairsJson(disk)), ("proposed", pairsJson(props)), ("a", Json.Str(setHash(disk))), ("b", Json.Str(setHash(applyPaths(disk, props)))), ("flip", Json.Int(flip)), ("started", Json.Int(now)), ("status", Json.Str("preparing"))])
    frozen = Json.set(c, "request", request)
    _ <- setupStorage(root)
    _ <- Fs.mkdirs(cardDir(root, id))
    _ <- Fs.write(Fs.join(cardDir(root, id), "card.json"), text(frozen))
  } yield frozen

def current(root: String, c: Json): IO[Unit] =
  for {
    ins <- currentInputs(root)
    _ <- need(setHash(ins) == setHash(pairs(Diags.jsonField(c, "inputs"))), "review inputs changed")
    request = Proposal.field(c, "request")
    compiler <- compilerIdentity()
    _ <- Proposal.validate(root, request, compiler)
    props <- importFor(root, str(c, "proposal"), request)
    pub <- Fs.read(Fs.join(Fs.join(Deck.proposalsDir(root), str(c, "proposal")), "proposal.json"))
    _ <- need(setHash(props) == setHash(pairs(Diags.jsonField(c, "proposed"))) && pub == str(c, "publication"), "proposal changed")
  } yield ()

def complete(root: String, c: Json, raw: String): IO[Json] =
  for {
    _ <- need(candidatePass(raw), "candidate fails required review")
    _ <- current(root, c)
    j = LspClient.parseJson(raw)
    files = List.distinct(List.flatMap(Json.arr(Diags.jsonField(j, "workloads")), w => [Lanes.workPath(w, "a"), Lanes.workPath(w, "b")]))
    _ <- IO.foreachDiscard(files, p => for {
  _ <- need(Str.matches(p, "^[A-Za-z0-9_-]+\\.txt$"), "unsafe evidence path")
  _ <- inside(root, Fs.join("build/ide", p))
  body <- Fs.read(Lanes.fileAt(root, "ide", p))
  _ <- need(List.nonEmpty(Lanes.states(body)) || List.exists(Json.arr(Diags.jsonField(j, "workloads")), w => Lanes.workPath(w, "a") == p && str(w, "why_a") == "check failed"), "missing review timeline")
  _ <- Fs.write(Fs.join(cardDir(root, str(c, "id")), p), body)
} yield ())
    witnesses <- IO.foreach(Json.arr(Diags.jsonField(j, "witnesses")), w => for {
  path = str(w, "path")
  name = Fs.basename(path)
  _ <- need(Str.matches(name, "^witness-[a-f0-9]{16}\\.toml$"), "unsafe witness path")
  source <- Fs.canonicalize(path)
  expected <- Fs.canonicalize(Lanes.fileAt(root, "ide", name))
  _ <- need(source == expected, "unsafe resolved witness path")
  body <- Fs.read(source)
  _ <- need(!Str.isEmpty(body), "missing review witness")
  _ <- Fs.write(Fs.join(cardDir(root, str(c, "id")), name), body)
} yield Json.set(w, "path", Json.Str(name)))
    evidence = Json.set(j, "witnesses", Json.Arr(witnesses))
    items = Lanes.workItems(evidence)
    _ <- need(List.isEmpty(items) || !Str.isEmpty(Lanes.workPath(List.at(items, 0), "a")) && !Str.isEmpty(Lanes.workPath(List.at(items, 0), "b")), "missing question timeline paths")
    aText <- if (List.isEmpty(items)) IO.pure("") else Fs.read(Fs.join(cardDir(root, str(c, "id")), Lanes.workPath(List.at(items, 0), "a")))
    bText <- if (List.isEmpty(items)) IO.pure("") else Fs.read(Fs.join(cardDir(root, str(c, "id")), Lanes.workPath(List.at(items, 0), "b")))
    question = if (List.isEmpty(items)) Json.Null() else Json.Obj([("workload", Json.Str(str(List.at(items, 0), "label"))), ("step", Json.Int(Lanes.usefulStep(List.at(items, 0), Lanes.states(aText), Lanes.states(bText))))])
    now <- Clock.monotonic()
    observed <- outcome(root, c, evidence)
    hashes <- evidenceHashes(root, c, evidence)
    readyCard = Json.set(Json.set(Json.set(Json.set(Json.set(Json.set(c, "evidence_files", pairsJson(hashes)), "outcome", Json.Str(observed)), "status", Json.Str(if (List.isEmpty(items)) "excluded" else "ready")), "evidence", evidence), "ready", Json.Int(now)), "question", question)
    out = if (List.nonEmpty(items)) readyCard else Json.set(Json.set(readyCard, "exclusion", Json.Str("no-observed-difference")), "feedback_time", Json.Int(now))
    _ <- Fs.write(Fs.join(cardDir(root, str(c, "id")), "card.json"), text(out))
    _ <- if (List.nonEmpty(items)) IO.pure(()) else Fs.write(recordPath(root, str(c, "id")), text(Json.Obj([("card", Json.Str(str(c, "id"))), ("decision", Json.Str("no-observed-difference")), ("kind", Json.Str("automatic")), ("evidence_status", Json.Str("excluded")), ("evidence", evidence), ("time", Json.Int(now)), ("writes", Json.Arr([]))])))
  } yield out

def outcome(root: String, c: Json, evidence: Json): IO[String] =
  IO.foreach(Json.arr(Proposal.field(evidence, "workloads")), w => Fs.read(Fs.join(cardDir(root, str(c, "id")), Lanes.workPath(w, "b"))).map(body => Json.Obj([("label", Proposal.field(w, "label")), ("events", Proposal.field(w, "events")), ("verdict", Proposal.field(w, "why_b")), ("states", Json.Arr(List.map(Delta.parse(body), state => Json.Obj(List.map(state, pair => (pair._1, Json.Str(pair._2)))))))]))).map(rows => Hash.sha256(text(Json.Arr(rows))))

def evidencePaths(evidence: Json): List[String] =
  List.distinct(List.concat(List.flatMap(Json.arr(Proposal.field(evidence, "workloads")), w => [Lanes.workPath(w, "a"), Lanes.workPath(w, "b")]), List.map(Json.arr(Proposal.field(evidence, "witnesses")), w => str(w, "path"))))

def evidenceHashes(root: String, c: Json, evidence: Json): IO[List[(String, String)]] =
  IO.foreach(evidencePaths(evidence), name => for {
  _ <- need(Str.matches(name, "^[A-Za-z0-9_-]+\\.(txt|toml)$"), "unsafe cached evidence path")
  _ <- inside(root, Fs.join(".scuzz/ide/cards", Fs.join(str(c, "id"), name)))
  body <- Fs.read(Fs.join(cardDir(root, str(c, "id")), name))
} yield (name, Hash.sha256(body)))

def cachedEvidence(root: String, c: Json): IO[Bool] =
  (for {
  evidence = Proposal.field(c, "evidence")
  hashes <- evidenceHashes(root, c, evidence)
  observed <- outcome(root, c, evidence)
} yield candidateReportPass(evidence) && List.nonEmpty(hashes) && pairsJson(hashes) == Proposal.field(c, "evidence_files") && observed == str(c, "outcome")).handleErrorWith(_ => IO.pure(false))

def known(root: String, context: String): IO[List[Json]] =
  for {
    entries <- Fs.list(Fs.join(storage(root), "cards")).handleErrorWith(_ => IO.pure([]))
    ids = List.sort(List.map(List.filter(entries, e => e._2 && Str.matches(e._1, "^[a-f0-9]{64}$")), e => e._1))
    cards <- IO.foreach(ids, id => (for {
  _ <- inside(root, Fs.join(".scuzz/ide/cards", Fs.join(id, "card.json")))
  raw <- readOptional(Fs.join(cardDir(root, id), "card.json"))
  c = LspClient.parseJson(raw)
  metadata = str(c, "id") == id && setHash(pairs(Proposal.field(c, "inputs"))) == context && Str.matches(str(c, "b"), "^[a-f0-9]{64}$")
  duplicate = str(c, "status") == "excluded" && List.contains(["duplicate-source", "unchanged-source"], str(c, "exclusion"))
  rejected = str(c, "status") == "excluded" && str(c, "exclusion") == "candidate-failed" && str(c, "diagnostic") != ""
  complete = List.contains(["ready", "excluded"], str(c, "status")) && candidateReportPass(Proposal.field(c, "evidence")) && Str.matches(str(c, "outcome"), "^[a-f0-9]{64}$")
  valid <- if (metadata && complete) cachedEvidence(root, c) else IO.pure(false)
  choiceText <- if (metadata && complete && !valid) readOptional(recordPath(root, id)).flatMap(choice => if (!Str.isEmpty(choice)) IO.pure(choice) else readOptional(recordPath(root, Str.concat("accept-", id)))) else IO.pure("")
} yield if (!metadata || !duplicate && !rejected && !valid && Str.isEmpty(choiceText)) Json.Null() else if (duplicate || rejected || valid) c else Json.set(c, "outcome", Json.Null())).handleErrorWith(_ => IO.pure(Json.Null())))
  } yield List.filter(cards, c => !Json.isNull(c))

def seenKeys(cards: List[Json]): List[String] =
  List.distinct(List.flatMap(cards, c => List.concat([Str.concat("source:", str(c, "b"))], if (Str.matches(str(c, "outcome"), "^[a-f0-9]{64}$")) [Str.concat("outcome:", str(c, "outcome"))] else [])))

def excludedPublications(root: String, context: String): IO[List[String]] =
  for {
    entries <- Fs.list(Fs.join(storage(root), "records")).handleErrorWith(_ => IO.pure([]))
    names = List.map(List.filter(entries, e => !e._2 && Str.matches(e._1, "^[A-Za-z0-9_-]+\\.json$")), e => e._1)
    records <- IO.foreach(names, name => inside(root, Fs.join(".scuzz/ide/records", name)).flatMap(_ => readOptional(Fs.join(Fs.join(storage(root), "records"), name))).map(raw => LspClient.parseJson(raw)))
  } yield List.distinct(List.map(List.filter(records, r => str(r, "input_context") == context && str(r, "kind") == "automatic" && str(r, "decision") == "stale-publication"), r => str(r, "proposal")))

def propsOf(c: Json): List[(String, String)] =
  pairs(Diags.jsonField(c, "proposed"))

def automatic(root: String, c: Json, reason: String): IO[Unit] =
  for {
    now <- Clock.monotonic()
    excluded = Json.set(Json.set(Json.set(c, "status", Json.Str("excluded")), "exclusion", Json.Str(reason)), "feedback_time", Json.Int(now))
    _ <- Fs.write(Fs.join(cardDir(root, str(c, "id")), "card.json"), text(excluded))
    entry = Json.Obj([("v", Json.Int(1)), ("card", Proposal.field(c, "id")), ("proposal", Proposal.field(c, "proposal")), ("kind", Json.Str("automatic")), ("decision", Json.Str(reason)), ("diagnostic", Proposal.field(c, "diagnostic")), ("objective", Proposal.field(c, "objective")), ("a", Proposal.field(c, "a")), ("b", Proposal.field(c, "b")), ("inputs", Proposal.field(c, "inputs")), ("request", Proposal.field(c, "request")), ("evidence_status", Json.Str("excluded")), ("evidence", Proposal.field(c, "evidence")), ("time", Json.Int(now)), ("writes", Json.Arr([]))])
    _ <- Fs.write(recordPath(root, str(c, "id")), text(entry))
  } yield ()

def sourceWrites(c: Json): List[Json] =
  List.map(pairs(Diags.jsonField(c, "proposed")), f => Json.Obj([("path", Json.Str(f._1)), ("before", Json.Str(List.getOrElse(List.map(pairs(Diags.jsonField(c, "baseline")), d => d._2), List.indexOf(List.map(pairs(Diags.jsonField(c, "baseline")), d => d._1), f._1), ""))), ("before_exists", Json.Bool(List.contains(List.map(pairs(Diags.jsonField(c, "baseline")), d => d._1), f._1))), ("after", Json.Str(f._2)), ("after_exists", Json.Bool(true))]))

def matches(root: String, w: Json, side: String): IO[Bool] =
  for {
    _ <- inside(root, str(w, "path"))
    hit <- Fs.exists(Fs.join(root, str(w, "path")))
    src <- if (hit == 0) IO.pure("") else Fs.read(Fs.join(root, str(w, "path")))
  } yield hit != 0 == Json.getBool(w, Str.concat(side, "_exists"), false) && src == str(w, side)

def writeOne(root: String, w: Json): IO[Unit] =
  for {
    after <- matches(root, w, "after")
    before <- matches(root, w, "before")
    _ <- need(after || before, Str.concat("recovery conflict: ", str(w, "path")))
    _ <- if (after) IO.pure(()) else if (Json.getBool(w, "after_exists", false)) Fs.write(Fs.join(root, str(w, "path")), str(w, "after")) else Fs.delete(Fs.join(root, str(w, "path")))
    finalMatch <- matches(root, w, "after")
    _ <- need(finalMatch, Str.concat("external write conflict: ", str(w, "path")))
  } yield ()

def recordPath(root: String, id: String): String =
  Fs.join(Fs.join(storage(root), "records"), Str.concat(id, ".json"))

def finish(root: String, op: Json): IO[Unit] =
  for {
    id = str(op, "operation")
    ws = Json.arr(Diags.jsonField(op, "writes"))
    _ <- need(Str.matches(id, "^(accept|undo)-[a-f0-9]{64}$") && List.nonEmpty(ws) && List.len(ws) <= 3 && List.len(List.distinct(List.map(ws, w => str(w, "path")))) == List.len(ws) && List.forall(ws, w => safePath(str(w, "path")) && Json.isStr(Diags.jsonField(w, "before")) && Json.isStr(Diags.jsonField(w, "after")) && Json.isBool(Diags.jsonField(w, "before_exists")) && Json.isBool(Diags.jsonField(w, "after_exists"))), "invalid recovery journal")
    checks <- IO.foreach(ws, w => matches(root, w, "before").flatMap(b => matches(root, w, "after").map(a => b || a)))
    _ <- need(List.forall(checks, b => b), "recovery conflict: preserve external edits")
    _ <- IO.foreachDiscard(ws, w => writeOne(root, w))
    _ <- Fs.write(recordPath(root, id), text(op))
    _ <- Fs.write(Fs.join(storage(root), "last.json"), if (str(op, "decision") == "accept") text(op) else "")
    _ <- Fs.write(Fs.join(storage(root), "journal.json"), "")
  } yield ()

def readOptional(path: String): IO[String] =
  Fs.exists(path).flatMap(hit => if (hit == 0) IO.pure("") else Fs.read(path))

def recover(root: String): IO[Unit] =
  for {
    _ <- setupStorage(root)
    raw <- readOptional(Fs.join(storage(root), "journal.json"))
    _ <- if (Str.isEmpty(raw)) IO.pure(()) else finish(root, LspClient.parseJson(raw))
  } yield ()

def undecided(root: String, id: String): IO[Unit] =
  for {
    choice <- Fs.exists(recordPath(root, id))
    accepted <- Fs.exists(recordPath(root, Str.concat("accept-", id)))
    _ <- need(choice == 0 && accepted == 0, "card is already decided")
  } yield ()

def operation(c: Json, lane: Int, now: Int): Json =
  for {
    accepted = lane >= 0 && lane == (if (Json.getInt(c, "flip", 0) == 1) 0 else 1)
    decision = if (lane < 0) "abstain" else if (accepted) "accept" else "baseline"
    id = Str.concat("accept-", str(c, "id"))
  } yield Json.Obj([("operation", Json.Str(id)), ("card", Json.Str(str(c, "id"))), ("proposal", Json.Str(str(c, "proposal"))), ("decision", Json.Str(decision)), ("lane", Json.Int(lane)), ("flip", Diags.jsonField(c, "flip")), ("a", Diags.jsonField(c, "a")), ("b", Diags.jsonField(c, "b")), ("objective", Diags.jsonField(c, "objective")), ("generator", Json.Str(str(LspClient.parseJson(str(c, "publication")), "generator"))), ("evidence_status", Diags.jsonField(c, "status")), ("question", Diags.jsonField(c, "question")), ("started", Diags.jsonField(c, "started")), ("ready", Diags.jsonField(c, "ready")), ("limits", Json.Str("files=3;source=65536;review=idle,seeds,corpus;search=32;seed=1")), ("region", Json.Arr(List.map(propsOf(c), f => Json.Str(f._1)))), ("time", Json.Int(now)), ("writes", Json.Arr(if (accepted) sourceWrites(c) else []))])

def decide(root: String, c: Json, lane: Int): IO[Unit] =
  for {
    _ <- recover(root)
    _ <- need(lane == -1 || lane == 0 || lane == 1, "invalid choice lane")
    _ <- need(str(c, "status") == "ready", "card is not ready")
    question = Diags.jsonField(c, "question")
    work = Lanes.workAt(Diags.jsonField(c, "evidence"), str(question, "workload"))
    _ <- need(!Json.isNull(work), "invalid review question")
    timelineA <- Fs.read(Fs.join(cardDir(root, str(c, "id")), Lanes.workPath(work, "a")))
    timelineB <- Fs.read(Fs.join(cardDir(root, str(c, "id")), Lanes.workPath(work, "b")))
    count = List.len(Lanes.railLabels(Lanes.states(timelineA), Lanes.states(timelineB)))
    step = Json.getInt(question, "step", -1)
    _ <- need(step >= 0 && step < count, "invalid review step")
    _ <- undecided(root, str(c, "id"))
    _ <- current(root, c)
    valid <- cachedEvidence(root, c)
    _ <- need(valid, "review evidence changed")
    accepted = lane >= 0 && lane == (if (Json.getInt(c, "flip", 0) == 1) 0 else 1)
    now <- Clock.monotonic()
    op = operation(c, lane, now)
    _ <- if (accepted) Fs.write(Fs.join(storage(root), "journal.json"), text(op)).flatMap(_ => finish(root, op)) else Fs.write(recordPath(root, str(c, "id")), text(op))
  } yield ()

def undo(root: String): IO[Unit] =
  for {
    _ <- recover(root)
    raw <- readOptional(Fs.join(storage(root), "last.json"))
    _ <- need(!Str.isEmpty(raw), "no accepted change to undo")
    prior = LspClient.parseJson(raw)
    ws = Json.arr(Diags.jsonField(prior, "writes"))
    checks <- IO.foreach(ws, w => matches(root, w, "after"))
    _ <- need(List.forall(checks, b => b), "undo conflict: preserve external edits")
    now <- Clock.monotonic()
    op = undoOperation(prior, now)
    _ <- Fs.write(Fs.join(storage(root), "journal.json"), text(op))
    _ <- finish(root, op)
  } yield ()

def undoOperation(prior: Json, now: Int): Json =
  for {
    ws = Json.arr(Diags.jsonField(prior, "writes"))
    reverse = List.map(ws, w => Json.Obj([("path", Diags.jsonField(w, "path")), ("before", Diags.jsonField(w, "after")), ("before_exists", Diags.jsonField(w, "after_exists")), ("after", Diags.jsonField(w, "before")), ("after_exists", Diags.jsonField(w, "before_exists"))]))
  } yield Json.set(Json.set(Json.set(Json.set(prior, "operation", Json.Str(Str.concat("undo-", str(prior, "card")))), "decision", Json.Str("undo")), "writes", Json.Arr(reverse)), "time", Json.Int(now))

