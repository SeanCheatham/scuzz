def text(j: Json): String =
  Json.stringify(j) match {
    case Result.Ok(s) => s
    case Result.Err(e) => e
  }

def str(j: Json, key: String): String =
  Json.getStr(j, key, "")

def pairsJson(files: List[(String, String)]): Json =
  Proposal.pairsJson(files)

def pairs(j: Json): List[(String, String)] =
  Proposal.pairs(j)

def setHash(files: List[(String, String)]): String =
  Proposal.setHash(files)

def applyPaths(disk: List[(String, String)], props: List[(String, String)]): List[(String, String)] =
  List.concat(List.map(disk, d => (d._1, List.getOrElse(List.map(props, p => p._2), List.indexOf(List.map(props, p => p._1), d._1), d._2))), List.filter(props, p => !List.contains(List.map(disk, d => d._1), p._1)))

def safePath(path: String): Bool =
  Proposal.safePath(path)

def sourceSetOk(files: List[(String, String)]): Bool =
  Proposal.sourceSetOk(files)

def need(ok: Bool, why: String): IO[Unit] =
  if (ok) IO.pure(()) else IO.fail(why)

def own(root: String): IO[List[(String, String)]] =
  Proposal.own(root)

def inside(root: String, path: String): IO[Unit] =
  Proposal.checkInside(root, path)

def dirtyHits(root: String, props: List[(String, String)], dirties: List[String]): IO[List[String]] =
  for {
    dirty <- IO.foreach(dirties, p => Fs.canonicalize(p))
    touched <- IO.foreach(props, p => Fs.canonicalize(Fs.join(root, p._1)).handleErrorWith(_ => Fs.canonicalize(Fs.dirname(Fs.join(root, p._1))).map(dir => Fs.join(dir, Fs.basename(p._1)))))
  } yield List.map(List.filter(List.indices(props), i => List.contains(dirty, List.at(touched, i))), i => List.at(props, i)._1)

def metadata(request: String, baseline: String, generator: String, files: List[(String, String)]): String =
  Proposal.metadata(request, baseline, generator, files)

def importProposal(root: String, name: String): IO[List[(String, String)]] =
  for {
    request <- proposalRequest(root, name)
    files <- importFor(root, name, request)
  } yield files

def requestArchivePath(root: String, id: String): String =
  Fs.join(Fs.join(storage(root), "requests"), Str.concat(id, ".json"))

def requestArchive(root: String, id: String): IO[Json] =
  for {
    _ <- need(Str.matches(id, "^[A-Za-z0-9_-]{1,128}$"), "unsafe request identity")
    _ <- inside(root, Fs.join(".scuzz/ide/requests", Str.concat(id, ".json")))
    exists <- Fs.exists(requestArchivePath(root, id))
    _ <- need(exists != 0, stalePublicationMessage())
    raw <- Fs.read(requestArchivePath(root, id))
    archive <- Proposal.parse(raw, 1067008)
    _ <- need(Proposal.keys(archive, ["v", "request", "session"]) && Proposal.version(archive) && Proposal.stringValue(Proposal.field(archive, "session")) && str(Proposal.field(archive, "request"), "request") == id, "invalid frozen request archive")
  } yield archive

def rememberRequest(root: String, request: Json): IO[Unit] =
  for {
    id = str(request, "request")
    _ <- need(Str.matches(id, "^[A-Za-z0-9_-]{1,128}$"), "unsafe request identity")
    _ <- setupStorage(root)
    _ <- Fs.mkdirs(Fs.join(storage(root), "requests"))
    _ <- inside(root, Fs.join(".scuzz/ide/requests", Str.concat(id, ".json")))
    session <- sessionContext(root)
    archive = text(Json.Obj([("v", Json.Int(1)), ("request", request), ("session", Json.Str(session))]))
    previous <- readOptional(requestArchivePath(root, id))
    _ <- need(Str.isEmpty(previous) || previous == archive, "frozen request identity is already stored")
    _ <- if (Str.isEmpty(previous)) Fs.write(requestArchivePath(root, id), archive) else IO.pure(())
  } yield ()

def proposalRequest(root: String, name: String): IO[Json] =
  for {
    _ <- need(Str.matches(name, "^[A-Za-z0-9_-]+$"), "unsafe proposal name")
    path = Fs.join(Fs.join("build/proposals", name), "proposal.json")
    _ <- inside(root, path)
    publicationRaw <- Fs.read(Fs.join(root, path))
    publication <- Proposal.parse(publicationRaw, 131072)
    id = str(publication, "request")
    _ <- need(Str.matches(id, "^[A-Za-z0-9_-]{1,128}$"), "unsafe publication request identity")
    latestRaw <- Fs.read(Fs.join(root, "build/ide/request.json"))
    latest <- Proposal.parse(latestRaw, 1048576)
    archive <- requestArchive(root, id)
    request = Proposal.field(archive, "request")
    session <- sessionContext(root)
    _ <- need(str(archive, "session") == session && requestContext(request) == requestContext(latest), stalePublicationMessage())
    compiler <- compilerIdentity()
    _ <- Proposal.validate(root, latest, compiler)
    _ <- Proposal.validate(root, request, compiler)
  } yield request

def stalePublicationMessage(): String =
  "publication request no longer matches the session"

def excludePublicationWithWait(root: String, name: String, context: String, waitMs: Int): IO[Unit] =
  for {
    _ <- need(Str.matches(name, "^[A-Za-z0-9_-]+$"), "unsafe proposal name")
    relative = Fs.join(Fs.join("build/proposals", name), "proposal.json")
    _ <- inside(root, relative)
    raw <- Fs.read(Fs.join(root, relative))
    publication <- Proposal.parse(raw, 131072)
    id <- Uuid.v4()
    now <- Clock.monotonic()
    effWait = if (waitMs > 0) waitMs else 0
    entry = Json.Obj([("v", Json.Int(1)), ("operation", Json.Str(id)), ("proposal", Json.Str(name)), ("kind", Json.Str("automatic")), ("decision", Json.Str("stale-publication")), ("evidence_status", Json.Str("not-reviewed")), ("input_context", Json.Str(context)), ("publication", publication), ("readiness_ms", Json.Int(effWait)), ("time", Json.Int(now)), ("writes", Json.Arr([]))])
    _ <- setupStorage(root)
    _ <- Fs.write(recordPath(root, id), text(entry))
  } yield ()

def importFor(root: String, name: String, request: Json): IO[List[(String, String)]] =
  for {
    _ <- need(Str.matches(name, "^[A-Za-z0-9_-]+$"), "unsafe proposal name")
    _ <- inside(root, Fs.join("build/proposals", name))
    files <- Proposal.importFrom(root, Fs.join(Deck.proposalsDir(root), name), request)
  } yield files

def inputPath(path: String): Bool =
  Proposal.inputPath(path)

def packageInputs(root: String, prefix: String, seen: List[String]): IO[List[(String, String)]] =
  Proposal.packageInputs(root, prefix, seen)

def compilerIdentity(): IO[String] =
  for {
    cli <- Main.scuzzCli()
    digest <- executableIdentity(cli)
  } yield digest

def executableIdentity(cli: String): IO[String] =
  for {
    got <- Sys.exec(Str.concat("review_cli=$(command -v ", Str.concat(Lanes.shQuote(cli), ") && if command -v sha256sum >/dev/null 2>&1; then sha256sum \"$review_cli\"; else shasum -a 256 \"$review_cli\"; fi")))
    digest = Str.take(Str.trim(got._2), 64)
    _ <- need(got._1 == 0 && Str.matches(digest, "^[a-f0-9]{64}$"), "cannot identify review compiler")
  } yield digest

def requestContext(request: Json): String =
  text(Json.Obj(List.map(["v", "kind", "objective", "baseline", "compiler", "inputs", "sources", "allowed", "checks", "limits", "instructions"], key => (key, Proposal.field(request, key)))))

def sessionContext(root: String): IO[String] =
  for {
    raw <- readOptional(Fs.join(storage(root), "session.json"))
    session <- Proposal.parse(if (Str.isEmpty(raw)) "{}" else raw, 8192)
  } yield sessionFields(session)

def sessionFields(session: Json): String =
  text(Json.Obj(List.map(["baseline_epoch", "objective", "allowed", "mode", "model", "resolved_model", "backend", "limits"], key => (key, Proposal.field(session, key)))))

def currentInputs(root: String): IO[List[(String, String)]] =
  Fs.read(Fs.join(root, "build/ide/request.json")).flatMap(raw => Proposal.parse(raw, 1048576)).flatMap(request => inputs(root, request))

def inputs(root: String, request: Json): IO[List[(String, String)]] =
  for {
    files <- packageInputs(root, "package", [])
    compiler <- Sys.getenv("SCUZZ_EXECUTABLE_SHA256")
    session <- sessionContext(root)
    cli <- compilerIdentity()
    _ <- Proposal.validate(root, request, cli)
    toml <- Fs.read(Fs.join(root, "scuzz.toml"))
    host <- if (Manifest.parse(toml).hasUi) Main.scuzzCli().flatMap(scuzz => Drive.uiHostExe(scuzz)).flatMap(exe => need(exe != "", "UI review host is unavailable").flatMap(_ => executableIdentity(exe))) else IO.pure(cli)
  } yield List.concat(files, [("compiler", compiler), ("review-compiler", cli), ("review-host", host), ("request-context", requestContext(request)), ("session-context", session), ("objective", str(request, "objective")), ("limits", "files=3;source=65536;review=idle,seeds,corpus;search=32;seed=1")])

def storage(root: String): String =
  Fs.join(root, ".scuzz/ide")

def cardDir(root: String, id: String): String =
  Fs.join(Fs.join(storage(root), "cards"), id)

def identity(inputs0: List[(String, String)], props: List[(String, String)], publication: String, nonce: String): String =
  Hash.sha256(text(Json.Arr([pairsJson(inputs0), pairsJson(props), Json.Str(publication), Json.Str(nonce)])))

def candidatePass(raw: String): Bool =
  candidateReportPass(LspClient.parseJson(raw))

def candidateReportPass(j: Json): Bool =
  for {
    review = Diags.jsonField(j, "review")
    search = Diags.jsonField(j, "search")
    rows = Json.arr(Diags.jsonField(j, "workloads"))
    required = Json.getInt(review, "required", 0)
  } yield str(j, "kind") == "diff" && Json.getBool(review, "complete", false) && required >= 1 && Json.getInt(review, "completed_required", -1) == required && Json.getInt(search, "iterations", -1) == 32 && Json.getInt(search, "ran", -1) == 32 && Json.getInt(search, "seed", -1) == 1 && Json.getInt(review, "recorded_workloads", -1) == List.len(rows) && List.len(rows) >= required + 32 && List.len(List.distinct(List.map(rows, w => str(w, "label")))) == List.len(rows) && List.forall(rows, w => candidateRowPass(w))

def candidateRowPass(w: Json): Bool =
  Json.has(w, "why_a") && Json.has(w, "why_b") && Json.isNull(Diags.jsonField(w, "why_b")) && (Json.isNull(Diags.jsonField(w, "why_a")) || str(w, "why_a") == "check failed" || Diff.constraintFailure(str(w, "why_a"))) && (str(w, "class") != "unrunnable" || str(w, "why_a") == "check failed") && List.contains(["same", "fixed", "diverged", "regressed", "unrunnable"], str(w, "class")) && !Str.isEmpty(str(w, "label")) && !Str.isEmpty(Lanes.workPath(w, "a")) && !Str.isEmpty(Lanes.workPath(w, "b"))

def setupStorage(root: String): IO[Unit] =
  for {
    _ <- Fs.mkdirs(Fs.join(root, ".scuzz"))
    _ <- inside(root, ".scuzz")
    _ <- Fs.mkdirs(storage(root))
    _ <- inside(root, ".scuzz/ide")
    _ <- Fs.mkdirs(Fs.join(storage(root), "cards"))
    _ <- Fs.mkdirs(Fs.join(storage(root), "records"))
    _ <- inside(root, ".scuzz/ide/cards")
    _ <- inside(root, ".scuzz/ide/records")
  } yield ()

def freeze(root: String, name: String, props: List[(String, String)], flip: Int): IO[Json] =
  for {
    ins <- currentInputs(root)
    disk <- own(root)
    request <- proposalRequest(root, name)
    imported <- importFor(root, name, request)
    _ <- need(setHash(imported) == setHash(props), "proposal changed before freezing")
    pub <- Fs.read(Fs.join(Fs.join(Deck.proposalsDir(root), name), "proposal.json"))
    nonce <- Uuid.v4()
    now <- Clock.monotonic()
    id = identity(List.concat(ins, [("frozen-request", text(request))]), props, pub, nonce)
    c = Json.Obj([("v", Json.Int(1)), ("id", Json.Str(id)), ("proposal", Json.Str(name)), ("publication", Json.Str(pub)), ("objective", Json.Str(List.getOrElse(List.map(ins, f => f._2), List.indexOf(List.map(ins, f => f._1), "objective"), ""))), ("inputs", pairsJson(ins)), ("baseline", pairsJson(disk)), ("proposed", pairsJson(props)), ("a", Json.Str(setHash(disk))), ("b", Json.Str(setHash(applyPaths(disk, props)))), ("flip", Json.Int(flip)), ("started", Json.Int(now)), ("status", Json.Str("preparing"))])
    frozen = Json.set(c, "request", request)
    _ <- setupStorage(root)
    _ <- Fs.mkdirs(cardDir(root, id))
    _ <- Fs.write(Fs.join(cardDir(root, id), "card.json"), text(frozen))
  } yield frozen

def current(root: String, c: Json): IO[Unit] =
  for {
    ins <- currentInputs(root)
    _ <- need(setHash(ins) == setHash(pairs(Diags.jsonField(c, "inputs"))), "review inputs changed")
    request = Proposal.field(c, "request")
    compiler <- compilerIdentity()
    _ <- Proposal.validate(root, request, compiler)
    props <- importFor(root, str(c, "proposal"), request)
    pub <- Fs.read(Fs.join(Fs.join(Deck.proposalsDir(root), str(c, "proposal")), "proposal.json"))
    _ <- need(setHash(props) == setHash(pairs(Diags.jsonField(c, "proposed"))) && pub == str(c, "publication"), "proposal changed")
  } yield ()

def complete(root: String, c: Json, raw: String): IO[Json] =
  completeWithWait(root, c, raw, -1)

def completeWithWait(root: String, c: Json, raw: String, waitMs: Int): IO[Json] =
  for {
    _ <- need(candidatePass(raw), "candidate fails required review")
    _ <- current(root, c)
    j = LspClient.parseJson(raw)
    files = List.distinct(List.flatMap(Json.arr(Diags.jsonField(j, "workloads")), w => [Lanes.workPath(w, "a"), Lanes.workPath(w, "b")]))
    _ <- IO.foreachDiscard(files, p => for {
  _ <- need(Str.matches(p, "^[A-Za-z0-9_-]+\\.txt$"), "unsafe evidence path")
  _ <- inside(root, Fs.join("build/ide", p))
  body <- Fs.read(Lanes.fileAt(root, "ide", p))
  _ <- need(List.nonEmpty(Lanes.states(body)) || List.exists(Json.arr(Diags.jsonField(j, "workloads")), w => Lanes.workPath(w, "a") == p && str(w, "why_a") == "check failed"), "missing review timeline")
  _ <- Fs.write(Fs.join(cardDir(root, str(c, "id")), p), body)
} yield ())
    witnesses <- IO.foreach(Json.arr(Diags.jsonField(j, "witnesses")), w => for {
  path = str(w, "path")
  name = Fs.basename(path)
  _ <- need(Str.matches(name, "^witness-[a-f0-9]{16}\\.toml$"), "unsafe witness path")
  source <- Fs.canonicalize(path)
  expected <- Fs.canonicalize(Lanes.fileAt(root, "ide", name))
  _ <- need(source == expected, "unsafe resolved witness path")
  body <- Fs.read(source)
  _ <- need(!Str.isEmpty(body), "missing review witness")
  _ <- Fs.write(Fs.join(cardDir(root, str(c, "id")), name), body)
} yield Json.set(w, "path", Json.Str(name)))
    evidence = Json.set(j, "witnesses", Json.Arr(witnesses))
    items = Lanes.workItems(evidence)
    _ <- need(List.isEmpty(items) || !Str.isEmpty(Lanes.workPath(List.at(items, 0), "a")) && !Str.isEmpty(Lanes.workPath(List.at(items, 0), "b")), "missing question timeline paths")
    aText <- if (List.isEmpty(items)) IO.pure("") else Fs.read(Fs.join(cardDir(root, str(c, "id")), Lanes.workPath(List.at(items, 0), "a")))
    bText <- if (List.isEmpty(items)) IO.pure("") else Fs.read(Fs.join(cardDir(root, str(c, "id")), Lanes.workPath(List.at(items, 0), "b")))
    question = if (List.isEmpty(items)) Json.Null() else Json.Obj([("workload", Json.Str(str(List.at(items, 0), "label"))), ("step", Json.Int(Lanes.usefulStep(List.at(items, 0), Lanes.states(aText), Lanes.states(bText))))])
    now <- Clock.monotonic()
    observed <- outcome(root, c, evidence)
    hashes <- evidenceHashes(root, c, evidence)
    readyCard = Json.set(Json.set(Json.set(Json.set(Json.set(Json.set(c, "evidence_files", pairsJson(hashes)), "outcome", Json.Str(observed)), "status", Json.Str(if (List.isEmpty(items)) "excluded" else "ready")), "evidence", evidence), "ready", Json.Int(now)), "question", question)
    out = if (List.nonEmpty(items)) readyCard else Json.set(Json.set(readyCard, "exclusion", Json.Str("no-observed-difference")), "feedback_time", Json.Int(now))
    _ <- Fs.write(Fs.join(cardDir(root, str(c, "id")), "card.json"), text(out))
    _ <- if (List.nonEmpty(items)) IO.pure(()) else for {
  started = Json.getInt(c, "started", now)
  effWait = if (waitMs >= 0) waitMs else if (now > started) now - started else 0
  _ <- Fs.write(recordPath(root, str(c, "id")), text(Json.Obj([("card", Json.Str(str(c, "id"))), ("proposal", Proposal.field(c, "proposal")), ("decision", Json.Str("no-observed-difference")), ("kind", Json.Str("automatic")), ("evidence_status", Json.Str("excluded")), ("evidence", evidence), ("started", Proposal.field(c, "started")), ("ready", Json.Int(now)), ("readiness_ms", Json.Int(effWait)), ("time", Json.Int(now)), ("writes", Json.Arr([]))])))
} yield ()
  } yield out

def outcome(root: String, c: Json, evidence: Json): IO[String] =
  IO.foreach(Json.arr(Proposal.field(evidence, "workloads")), w => Fs.read(Fs.join(cardDir(root, str(c, "id")), Lanes.workPath(w, "b"))).map(body => Json.Obj([("label", Proposal.field(w, "label")), ("events", Proposal.field(w, "events")), ("verdict", Proposal.field(w, "why_b")), ("states", Json.Arr(List.map(Delta.parse(body), state => Json.Obj(List.map(state, pair => (pair._1, Json.Str(pair._2)))))))]))).map(rows => Hash.sha256(text(Json.Arr(rows))))

def evidencePaths(evidence: Json): List[String] =
  List.distinct(List.concat(List.flatMap(Json.arr(Proposal.field(evidence, "workloads")), w => [Lanes.workPath(w, "a"), Lanes.workPath(w, "b")]), List.map(Json.arr(Proposal.field(evidence, "witnesses")), w => str(w, "path"))))

def evidenceHashes(root: String, c: Json, evidence: Json): IO[List[(String, String)]] =
  IO.foreach(evidencePaths(evidence), name => for {
  _ <- need(Str.matches(name, "^[A-Za-z0-9_-]+\\.(txt|toml)$"), "unsafe cached evidence path")
  _ <- inside(root, Fs.join(".scuzz/ide/cards", Fs.join(str(c, "id"), name)))
  body <- Fs.read(Fs.join(cardDir(root, str(c, "id")), name))
} yield (name, Hash.sha256(body)))

def cachedEvidence(root: String, c: Json): IO[Bool] =
  (for {
  evidence = Proposal.field(c, "evidence")
  hashes <- evidenceHashes(root, c, evidence)
  observed <- outcome(root, c, evidence)
} yield candidateReportPass(evidence) && List.nonEmpty(hashes) && pairsJson(hashes) == Proposal.field(c, "evidence_files") && observed == str(c, "outcome")).handleErrorWith(_ => IO.pure(false))

def known(root: String, context: String): IO[List[Json]] =
  for {
    entries <- Fs.list(Fs.join(storage(root), "cards")).handleErrorWith(_ => IO.pure([]))
    ids = List.sort(List.map(List.filter(entries, e => e._2 && Str.matches(e._1, "^[a-f0-9]{64}$")), e => e._1))
    cards <- IO.foreach(ids, id => (for {
  _ <- inside(root, Fs.join(".scuzz/ide/cards", Fs.join(id, "card.json")))
  raw <- readOptional(Fs.join(cardDir(root, id), "card.json"))
  c = LspClient.parseJson(raw)
  metadata = str(c, "id") == id && setHash(pairs(Proposal.field(c, "inputs"))) == context && Str.matches(str(c, "b"), "^[a-f0-9]{64}$")
  duplicate = str(c, "status") == "excluded" && List.contains(["duplicate-source", "unchanged-source"], str(c, "exclusion"))
  rejected = str(c, "status") == "excluded" && str(c, "exclusion") == "candidate-failed" && str(c, "diagnostic") != ""
  complete = List.contains(["ready", "excluded"], str(c, "status")) && candidateReportPass(Proposal.field(c, "evidence")) && Str.matches(str(c, "outcome"), "^[a-f0-9]{64}$")
  valid <- if (metadata && complete) cachedEvidence(root, c) else IO.pure(false)
  choiceText <- if (metadata && complete && !valid) readOptional(recordPath(root, id)).flatMap(choice => if (!Str.isEmpty(choice)) IO.pure(choice) else readOptional(recordPath(root, Str.concat("accept-", id)))) else IO.pure("")
} yield if (!metadata || !duplicate && !rejected && !valid && Str.isEmpty(choiceText)) Json.Null() else if (duplicate || rejected || valid) c else Json.set(c, "outcome", Json.Null())).handleErrorWith(_ => IO.pure(Json.Null())))
  } yield List.filter(cards, c => !Json.isNull(c))

def seenKeys(cards: List[Json]): List[String] =
  List.distinct(List.flatMap(cards, c => List.concat([Str.concat("source:", str(c, "b"))], if (Str.matches(str(c, "outcome"), "^[a-f0-9]{64}$")) [Str.concat("outcome:", str(c, "outcome"))] else [])))

def excludedPublications(root: String, context: String): IO[List[String]] =
  for {
    entries <- Fs.list(Fs.join(storage(root), "records")).handleErrorWith(_ => IO.pure([]))
    names = List.map(List.filter(entries, e => !e._2 && Str.matches(e._1, "^[A-Za-z0-9_-]+\\.json$")), e => e._1)
    records <- IO.foreach(names, name => inside(root, Fs.join(".scuzz/ide/records", name)).flatMap(_ => readOptional(Fs.join(Fs.join(storage(root), "records"), name))).map(raw => LspClient.parseJson(raw)))
  } yield List.distinct(List.map(List.filter(records, r => str(r, "input_context") == context && str(r, "kind") == "automatic" && str(r, "decision") == "stale-publication"), r => str(r, "proposal")))

def propsOf(c: Json): List[(String, String)] =
  pairs(Diags.jsonField(c, "proposed"))

def automatic(root: String, c: Json, reason: String): IO[Unit] =
  automaticWithWait(root, c, reason, -1)

def automaticWithWait(root: String, c: Json, reason: String, waitMs: Int): IO[Unit] =
  for {
    now <- Clock.monotonic()
    started = Json.getInt(c, "started", now)
    effWait = if (waitMs >= 0) waitMs else if (now > started) now - started else 0
    excluded = Json.set(Json.set(Json.set(c, "status", Json.Str("excluded")), "exclusion", Json.Str(reason)), "feedback_time", Json.Int(now))
    _ <- Fs.write(Fs.join(cardDir(root, str(c, "id")), "card.json"), text(excluded))
    entry = Json.Obj([("v", Json.Int(1)), ("card", Proposal.field(c, "id")), ("proposal", Proposal.field(c, "proposal")), ("kind", Json.Str("automatic")), ("decision", Json.Str(reason)), ("diagnostic", Proposal.field(c, "diagnostic")), ("objective", Proposal.field(c, "objective")), ("a", Proposal.field(c, "a")), ("b", Proposal.field(c, "b")), ("inputs", Proposal.field(c, "inputs")), ("request", Proposal.field(c, "request")), ("evidence_status", Json.Str("excluded")), ("evidence", Proposal.field(c, "evidence")), ("started", Proposal.field(c, "started")), ("readiness_ms", Json.Int(effWait)), ("time", Json.Int(now)), ("writes", Json.Arr([]))])
    _ <- Fs.write(recordPath(root, str(c, "id")), text(entry))
  } yield ()

def sourceWrites(c: Json): List[Json] =
  List.map(pairs(Diags.jsonField(c, "proposed")), f => Json.Obj([("path", Json.Str(f._1)), ("before", Json.Str(List.getOrElse(List.map(pairs(Diags.jsonField(c, "baseline")), d => d._2), List.indexOf(List.map(pairs(Diags.jsonField(c, "baseline")), d => d._1), f._1), ""))), ("before_exists", Json.Bool(List.contains(List.map(pairs(Diags.jsonField(c, "baseline")), d => d._1), f._1))), ("after", Json.Str(f._2)), ("after_exists", Json.Bool(true))]))

def matches(root: String, w: Json, side: String): IO[Bool] =
  for {
    _ <- inside(root, str(w, "path"))
    hit <- Fs.exists(Fs.join(root, str(w, "path")))
    src <- if (hit == 0) IO.pure("") else Fs.read(Fs.join(root, str(w, "path")))
  } yield hit != 0 == Json.getBool(w, Str.concat(side, "_exists"), false) && src == str(w, side)

def writeOne(root: String, w: Json): IO[Unit] =
  for {
    after <- matches(root, w, "after")
    before <- matches(root, w, "before")
    _ <- need(after || before, Str.concat("recovery conflict: ", str(w, "path")))
    _ <- if (after) IO.pure(()) else if (Json.getBool(w, "after_exists", false)) Fs.write(Fs.join(root, str(w, "path")), str(w, "after")) else Fs.delete(Fs.join(root, str(w, "path")))
    finalMatch <- matches(root, w, "after")
    _ <- need(finalMatch, Str.concat("external write conflict: ", str(w, "path")))
  } yield ()

def recordPath(root: String, id: String): String =
  Fs.join(Fs.join(storage(root), "records"), Str.concat(id, ".json"))

def finish(root: String, op: Json): IO[Unit] =
  for {
    id = str(op, "operation")
    ws = Json.arr(Diags.jsonField(op, "writes"))
    _ <- need(validOperation(op), "invalid recovery journal")
    checks <- IO.foreach(ws, w => matches(root, w, "before").flatMap(b => matches(root, w, "after").map(a => b || a)))
    _ <- need(List.forall(checks, b => b), "recovery conflict: preserve external edits")
    _ <- IO.foreachDiscard(ws, w => writeOne(root, w))
    _ <- Fs.write(recordPath(root, id), text(op))
    _ <- Fs.write(Fs.join(storage(root), "last.json"), if (str(op, "decision") == "accept" || str(op, "decision") == "install-rule") text(op) else "")
    _ <- if (str(op, "decision") == "install-rule") Fs.write(Fs.join(storage(root), "active-rule.txt"), "") else IO.pure(())
    _ <- Fs.write(Fs.join(storage(root), "journal.json"), "")
  } yield ()

def readOptional(path: String): IO[String] =
  Fs.exists(path).flatMap(hit => if (hit == 0) IO.pure("") else Fs.read(path))

def recover(root: String): IO[Unit] =
  for {
    _ <- setupStorage(root)
    raw <- readOptional(Fs.join(storage(root), "journal.json"))
    _ <- if (Str.isEmpty(raw)) IO.pure(()) else finish(root, LspClient.parseJson(raw))
  } yield ()

def undecided(root: String, id: String): IO[Unit] =
  for {
    choice <- Fs.exists(recordPath(root, id))
    accepted <- Fs.exists(recordPath(root, Str.concat("accept-", id)))
    _ <- need(choice == 0 && accepted == 0, "card is already decided")
  } yield ()

def operation(c: Json, lane: Int, now: Int): Json =
  operationDetails(c, lane, "", -1, -1, now)

def operationDetails(c: Json, lane: Int, reason: String, readinessMs: Int, reviewMs: Int, now: Int): Json =
  for {
    accepted = lane >= 0 && lane == (if (Json.getInt(c, "flip", 0) == 1) 0 else 1)
    decision = if (lane < 0) "abstain" else if (accepted) "accept" else "baseline"
    id = Str.concat(decision, Str.concat("-", str(c, "id")))
    started = Json.getInt(c, "started", now)
    ready = Json.getInt(c, "ready", now)
    effWait = if (readinessMs >= 0) readinessMs else if (ready > started) ready - started else 0
    effReview = if (reviewMs >= 0) reviewMs else if (now > ready) now - ready else 0
    cleanReason = if (lane < 0) reason else ""
  } yield Json.Obj([("operation", Json.Str(id)), ("card", Json.Str(str(c, "id"))), ("proposal", Json.Str(str(c, "proposal"))), ("decision", Json.Str(decision)), ("reason", Json.Str(cleanReason)), ("lane", Json.Int(lane)), ("flip", Diags.jsonField(c, "flip")), ("a", Diags.jsonField(c, "a")), ("b", Diags.jsonField(c, "b")), ("objective", Diags.jsonField(c, "objective")), ("generator", Json.Str(str(LspClient.parseJson(str(c, "publication")), "generator"))), ("evidence_status", Diags.jsonField(c, "status")), ("question", Diags.jsonField(c, "question")), ("started", Diags.jsonField(c, "started")), ("ready", Diags.jsonField(c, "ready")), ("readiness_ms", Json.Int(effWait)), ("review_ms", Json.Int(effReview)), ("limits", Json.Str("files=3;source=65536;review=idle,seeds,corpus;search=32;seed=1")), ("region", Json.Arr(List.map(propsOf(c), f => Json.Str(f._1)))), ("time", Json.Int(now)), ("writes", Json.Arr(if (accepted) sourceWrites(c) else []))])

def decide(root: String, c: Json, lane: Int): IO[Unit] =
  decideWithDetails(root, c, lane, "", -1, -1)

def decideWithDetails(root: String, c: Json, lane: Int, reason: String, readinessMs: Int, reviewMs: Int): IO[Unit] =
  for {
    _ <- recover(root)
    _ <- need(lane == -1 || lane == 0 || lane == 1, "invalid choice lane")
    _ <- need(Proposal.validAbstentionReason(reason) && (lane < 0 || reason == ""), "invalid abstention reason")
    _ <- need(str(c, "status") == "ready", "card is not ready")
    question = Diags.jsonField(c, "question")
    work = Lanes.workAt(Diags.jsonField(c, "evidence"), str(question, "workload"))
    _ <- need(!Json.isNull(work), "invalid review question")
    timelineA <- Fs.read(Fs.join(cardDir(root, str(c, "id")), Lanes.workPath(work, "a")))
    timelineB <- Fs.read(Fs.join(cardDir(root, str(c, "id")), Lanes.workPath(work, "b")))
    count = List.len(Lanes.railLabels(Lanes.states(timelineA), Lanes.states(timelineB)))
    step = Json.getInt(question, "step", -1)
    _ <- need(step >= 0 && step < count, "invalid review step")
    _ <- undecided(root, str(c, "id"))
    _ <- current(root, c)
    valid <- cachedEvidence(root, c)
    _ <- need(valid, "review evidence changed")
    accepted = lane >= 0 && lane == (if (Json.getInt(c, "flip", 0) == 1) 0 else 1)
    now <- Clock.monotonic()
    op = operationDetails(c, lane, reason, readinessMs, reviewMs, now)
    _ <- if (accepted) Fs.write(Fs.join(storage(root), "journal.json"), text(op)).flatMap(_ => finish(root, op)) else Fs.write(recordPath(root, str(c, "id")), text(op))
  } yield ()

def undo(root: String): IO[Unit] =
  for {
    _ <- recover(root)
    raw <- readOptional(Fs.join(storage(root), "last.json"))
    _ <- need(!Str.isEmpty(raw), "no accepted change to undo")
    prior = LspClient.parseJson(raw)
    _ <- need(validAccepted(prior), "invalid accepted record")
    ws = Json.arr(Diags.jsonField(prior, "writes"))
    checks <- IO.foreach(ws, w => matches(root, w, "after"))
    _ <- need(List.forall(checks, b => b), "undo conflict: preserve external edits")
    now <- Clock.monotonic()
    op = undoOperation(prior, now)
    _ <- Fs.write(Fs.join(storage(root), "journal.json"), text(op))
    _ <- finish(root, op)
  } yield ()

def validAccepted(prior: Json): Bool =
  List.contains(["accept", "install-rule"], str(prior, "decision")) && validOperation(prior)

def validOperation(op: Json): Bool =
  for {
    card = str(op, "card")
    decision = str(op, "decision")
    ws = Json.arr(Diags.jsonField(op, "writes"))
    pathsOk = if (decision == "accept") List.nonEmpty(ws) && List.len(ws) <= 3 && List.forall(ws, w => safePath(str(w, "path"))) else if (decision == "install-rule") List.len(ws) == 1 && Str.matches(str(List.at(ws, 0), "path"), "^[A-Za-z_][A-Za-z0-9_]*\\.scuzz_verify$") && Json.getBool(List.at(ws, 0), "after_exists", false) else List.nonEmpty(ws) && List.len(ws) <= 3 && (List.forall(ws, w => safePath(str(w, "path"))) || List.len(ws) == 1 && Str.matches(str(List.at(ws, 0), "path"), "^[A-Za-z_][A-Za-z0-9_]*\\.scuzz_verify$"))
  } yield List.contains(["accept", "install-rule", "undo"], decision) && Str.matches(card, "^[a-f0-9]{64}$") && str(op, "operation") == Str.concat(decision, Str.concat("-", card)) && pathsOk && List.len(List.distinct(List.map(ws, w => str(w, "path")))) == List.len(ws) && List.forall(ws, w => Json.isStr(Diags.jsonField(w, "before")) && Json.isStr(Diags.jsonField(w, "after")) && Json.isBool(Diags.jsonField(w, "before_exists")) && Json.isBool(Diags.jsonField(w, "after_exists")) && (Json.getBool(w, "before_exists", false) || str(w, "before") == "") && (Json.getBool(w, "after_exists", false) || str(w, "after") == ""))

def undoOperation(prior: Json, now: Int): Json =
  for {
    ws = Json.arr(Diags.jsonField(prior, "writes"))
    reverse = List.map(ws, w => Json.Obj([("path", Diags.jsonField(w, "path")), ("before", Diags.jsonField(w, "after")), ("before_exists", Diags.jsonField(w, "after_exists")), ("after", Diags.jsonField(w, "before")), ("after_exists", Diags.jsonField(w, "before_exists"))]))
  } yield Json.set(Json.set(Json.set(Json.set(prior, "operation", Json.Str(Str.concat("undo-", str(prior, "card")))), "decision", Json.Str("undo")), "writes", Json.Arr(reverse)), "time", Json.Int(now))

def max0(n: Int): Int =
  if (n < 0) 0 else n

def formatHundredths(n: Int): String =
  for {
    safe = max0(n)
    whole = safe / 100
    frac = safe % 100
    pad = if (frac < 10) Str.concat("0", Str.fromInt(frac)) else Str.fromInt(frac)
  } yield Str.concat(Str.fromInt(whole), Str.concat(".", pad))

def recordReviewMs(r: Json): Int =
  if (Json.isInt(Diags.jsonField(r, "review_ms"))) max0(Json.getInt(r, "review_ms", 0)) else max0(Json.getInt(r, "time", 0) - Json.getInt(r, "ready", Json.getInt(r, "time", 0)))

def recordReadinessMs(r: Json): Int =
  if (Json.isInt(Diags.jsonField(r, "readiness_ms"))) max0(Json.getInt(r, "readiness_ms", 0)) else max0(Json.getInt(r, "ready", 0) - Json.getInt(r, "started", Json.getInt(r, "ready", 0)))

def recordAutoWaitMs(r: Json): Int =
  if (Json.isInt(Diags.jsonField(r, "readiness_ms"))) max0(Json.getInt(r, "readiness_ms", 0)) else 0

def summarizeRecords(disk: List[(String, String)], records: List[Json]): Json =
  for {
    ordered = Proposal.sortRecords(records)
    rawPaths = List.map(disk, f => f._1)
    diskPaths = List.sort(List.distinct(rawPaths))
    diskSorted = List.map(diskPaths, p => (p, List.at(disk, List.indexOf(rawPaths, p))._2))
    workspaceFiles = Json.Arr(List.map(diskSorted, f => Json.Obj([("path", Json.Str(f._1)), ("sha256", Json.Str(Hash.sha256(f._2)))])))
    workspaceSha = setHash(diskSorted)
    human = List.filter(ordered, r => str(r, "kind") != "automatic" && str(r, "kind") != "rule")
    rules = List.filter(ordered, r => str(r, "kind") == "rule")
    rulesInstalled = List.filter(rules, r => str(r, "decision") == "install-rule")
    rulesRejected = List.filter(rules, r => str(r, "decision") == "reject-rule")
    ruleUndos = List.filter(rules, r => str(r, "decision") == "undo")
    ruleUndoneIds = List.distinct(List.map(ruleUndos, r => str(r, "card")))
    rulesActive = List.len(List.filter(rulesInstalled, r => !List.contains(ruleUndoneIds, str(r, "card"))))
    accepts = List.filter(human, r => str(r, "decision") == "accept")
    baselines = List.filter(human, r => str(r, "decision") == "baseline" || str(r, "decision") == "reject")
    abstains = List.filter(human, r => str(r, "decision") == "abstain" || str(r, "decision") == "skip")
    undos = List.filter(human, r => str(r, "decision") == "undo")
    undoneCards = List.distinct(List.map(undos, r => str(r, "card")))
    autos = List.filter(ordered, r => str(r, "kind") == "automatic")
    dups = List.filter(autos, r => str(r, "decision") == "duplicate-source" || str(r, "decision") == "duplicate-outcome")
    audits = List.map(accepts, r => for {
  cardId = str(r, "card")
  isUndone = List.contains(undoneCards, cardId)
  ws = Json.arr(Diags.jsonField(r, "writes"))
  fileAudits = List.map(ws, w => for {
  path = str(w, "path")
  after = str(w, "after")
  afterExists = Json.getBool(w, "after_exists", false)
  accSha = if (afterExists) Hash.sha256(after) else ""
  existsNow = List.contains(diskPaths, path)
  curBody = if (existsNow) List.at(diskSorted, List.indexOf(diskPaths, path))._2 else ""
  curSha = if (existsNow) Hash.sha256(curBody) else ""
  ok = existsNow == afterExists && (!afterExists || curSha == accSha && curBody == after)
} yield Json.Obj([("path", Json.Str(path)), ("accepted_sha256", Json.Str(accSha)), ("current_sha256", Json.Str(curSha)), ("matches", Json.Bool(ok))]))
  allMatch = List.nonEmpty(ws) && List.forall(fileAudits, fa => Json.getBool(fa, "matches", false))
  isRetained = !isUndone && allMatch
  status = if (isUndone) "undone" else if (allMatch) "retained" else "replaced"
} yield Json.Obj([("card", Json.Str(cardId)), ("proposal", Json.Str(str(r, "proposal"))), ("undone", Json.Bool(isUndone)), ("retained", Json.Bool(isRetained)), ("status", Json.Str(status)), ("b", Diags.jsonField(r, "b")), ("files", Json.Arr(fileAudits))]))
    retainedCount = List.len(List.filter(audits, a => Json.getBool(a, "retained", false)))
    noDiff = List.len(List.filter(abstains, r => str(r, "reason") == "no-visible-difference"))
    needScen = List.len(List.filter(abstains, r => str(r, "reason") == "need-another-scenario"))
    outsideGoal = List.len(List.filter(abstains, r => str(r, "reason") == "outside-my-goal"))
    unspecified = List.len(abstains) - noDiff - needScen - outsideGoal
    cardReviews = List.concat(accepts, List.concat(baselines, abstains))
    reviewMs = List.foldLeft(cardReviews, 0, p => p._1 + recordReviewMs(p._2))
    readinessMs = List.foldLeft(cardReviews, 0, p => p._1 + recordReadinessMs(p._2)) + List.foldLeft(autos, 0, p => p._1 + recordAutoWaitMs(p._2))
    rateX100 = if (reviewMs <= 0) 0 else (retainedCount * 6000000 + reviewMs / 2) / reviewMs
    rateText = formatHundredths(rateX100)
    byReason = Json.Obj([("no-visible-difference", Json.Int(noDiff)), ("need-another-scenario", Json.Int(needScen)), ("outside-my-goal", Json.Int(outsideGoal)), ("unspecified", Json.Int(unspecified))])
    note = "Conservative source measure: counts non-undone acceptances whose touched files match accepted SHA-256 bytes. Does not prove preserved behavior."
  } yield Json.Obj([("accepted", Json.Int(List.len(accepts))), ("retained_acceptances", Json.Int(retainedCount)), ("baseline_choices", Json.Int(List.len(baselines))), ("abstentions", Json.Int(List.len(abstains))), ("abstentions_by_reason", byReason), ("automatic_exclusions", Json.Int(List.len(autos))), ("duplicates", Json.Int(List.len(dups))), ("undo", Json.Int(List.len(undos))), ("rules_installed", Json.Int(List.len(rulesInstalled))), ("rules_active", Json.Int(rulesActive)), ("rules_undone", Json.Int(List.len(ruleUndos))), ("rules_rejected", Json.Int(List.len(rulesRejected))), ("readiness_ms", Json.Int(readinessMs)), ("review_ms", Json.Int(reviewMs)), ("retained_per_review_minute_x100", Json.Int(rateX100)), ("retained_per_review_minute", Json.Str(rateText)), ("measure_note", Json.Str(note)), ("workspace_sha256", Json.Str(workspaceSha)), ("workspace_files", workspaceFiles), ("acceptances", Json.Arr(audits))])

def loadRecords(root: String): IO[List[Json]] =
  Proposal.loadLocalRecords(root)

def sessionSummary(root: String): IO[Json] =
  for {
    disk <- own(root).handleErrorWith(_ => IO.pure([]: List[(String, String)]))
    records <- loadRecords(root)
  } yield summarizeRecords(disk, records)

def emptySummaryLines(workspaceSha: String): List[String] =
  ["Conservative source measure: counts non-undone acceptances whose touched files match accepted SHA-256 bytes. Does not prove preserved behavior.", "Accepted: 0; retained: 0; retained / active review min: 0.00", "Baseline choices: 0; Undo: 0", "Abstentions: 0 (no-visible-difference: 0, need-another-scenario: 0, outside-my-goal: 0, unspecified: 0)", "Rule reviews: installed 0 (active 0, undone 0); rejected 0", "Automatic exclusions: 0; duplicates: 0", "Readiness wait: 0 ms; active review time: 0 ms", Str.concat("Workspace SHA-256: ", workspaceSha)]

def summaryLines(summary: Json): List[String] =
  for {
    byReason = Diags.jsonField(summary, "abstentions_by_reason")
    audits = Json.arr(Diags.jsonField(summary, "acceptances"))
    auditLines = List.map(audits, a => for {
  fs = Json.arr(Diags.jsonField(a, "files"))
  fileText = List.join(List.map(fs, f => Str.concat(str(f, "path"), Str.concat(":", Str.concat(Str.take(str(f, "accepted_sha256"), 8), Str.concat("->", if (str(f, "current_sha256") == "") "missing" else Str.take(str(f, "current_sha256"), 8)))))), ", ")
} yield Str.concat("Audit ", Str.concat(str(a, "proposal"), Str.concat(" (", Str.concat(Str.take(str(a, "card"), 8), Str.concat("): ", Str.concat(str(a, "status"), Str.concat(" [", Str.concat(fileText, "]")))))))))
    ruleLine = Str.concat("Rule reviews: installed ", Str.concat(Str.fromInt(Json.getInt(summary, "rules_installed", 0)), Str.concat(" (active ", Str.concat(Str.fromInt(Json.getInt(summary, "rules_active", 0)), Str.concat(", undone ", Str.concat(Str.fromInt(Json.getInt(summary, "rules_undone", 0)), Str.concat("); rejected ", Str.fromInt(Json.getInt(summary, "rules_rejected", 0)))))))))
    header = [str(summary, "measure_note"), Str.concat("Accepted: ", Str.concat(Str.fromInt(Json.getInt(summary, "accepted", 0)), Str.concat("; retained: ", Str.concat(Str.fromInt(Json.getInt(summary, "retained_acceptances", 0)), Str.concat("; retained / active review min: ", str(summary, "retained_per_review_minute")))))), Str.concat("Baseline choices: ", Str.concat(Str.fromInt(Json.getInt(summary, "baseline_choices", 0)), Str.concat("; Undo: ", Str.fromInt(Json.getInt(summary, "undo", 0))))), Str.concat("Abstentions: ", Str.concat(Str.fromInt(Json.getInt(summary, "abstentions", 0)), Str.concat(" (no-visible-difference: ", Str.concat(Str.fromInt(Json.getInt(byReason, "no-visible-difference", 0)), Str.concat(", need-another-scenario: ", Str.concat(Str.fromInt(Json.getInt(byReason, "need-another-scenario", 0)), Str.concat(", outside-my-goal: ", Str.concat(Str.fromInt(Json.getInt(byReason, "outside-my-goal", 0)), Str.concat(", unspecified: ", Str.concat(Str.fromInt(Json.getInt(byReason, "unspecified", 0)), ")")))))))))), ruleLine, Str.concat("Automatic exclusions: ", Str.concat(Str.fromInt(Json.getInt(summary, "automatic_exclusions", 0)), Str.concat("; duplicates: ", Str.fromInt(Json.getInt(summary, "duplicates", 0))))), Str.concat("Readiness wait: ", Str.concat(Str.fromInt(Json.getInt(summary, "readiness_ms", 0)), Str.concat(" ms; active review time: ", Str.concat(Str.fromInt(Json.getInt(summary, "review_ms", 0)), " ms")))), Str.concat("Workspace SHA-256: ", str(summary, "workspace_sha256"))]
  } yield List.concat(header, auditLines)

private def setupRuleStorage(root: String): IO[Unit] =
  for {
    _ <- setupStorage(root)
    _ <- Fs.mkdirs(Fs.join(storage(root), "rules"))
    _ <- inside(root, ".scuzz/ide/rules")
  } yield ()

def ruleDir(root: String, id: String): String =
  Fs.join(Fs.join(storage(root), "rules"), id)

def isRulePublication(root: String, name: String): IO[Bool] =
  if (!Str.matches(name, "^[A-Za-z0-9_-]+$")) IO.pure(false) else (for {
  relative = Fs.join(Fs.join("build/proposals", name), "proposal.json")
  _ <- inside(root, relative)
  raw <- readOptional(Fs.join(root, relative))
} yield Json.parse(raw) match {
  case Result.Ok(j) => Json.isObj(j) && str(j, "kind") == "rule"
  case Result.Err(_) => false
}).handleErrorWith(_ => IO.pure(false))

private def activePreferenceRecords(root: String): IO[List[Json]] =
  for {
    records <- loadRecords(root)
    undoneCards = List.distinct(List.map(List.filter(records, r => str(r, "kind") != "automatic" && str(r, "decision") == "undo"), r => str(r, "card")))
    candidates = List.filter(records, r => str(r, "kind") != "automatic" && List.contains(["accept", "baseline", "reject"], str(r, "decision")) && !(str(r, "decision") == "accept" && List.contains(undoneCards, str(r, "card"))) && Str.matches(str(r, "card"), "^[a-f0-9]{64}$"))
    kept <- IO.foreach(candidates, r => Fs.exists(Fs.join(cardDir(root, str(r, "card")), "card.json")).map(hit => if (hit != 0) r else Json.Null()))
  } yield List.filter(kept, r => !Json.isNull(r))

def latestPreferenceCard(root: String): IO[String] =
  activePreferenceRecords(root).map(rs => if (List.isEmpty(rs)) "" else str(List.at(List.reverse(rs), 0), "card"))

private def cardWitnessScript(root: String, cardId: String, evidence: Json, events: List[String]): IO[String] =
  for {
    wits = Json.arr(Diags.jsonField(evidence, "witnesses"))
    matched = List.filter(wits, w => List.map(Json.arr(Diags.jsonField(w, "events")), e => Json.strOr(e, "")) == events)
    picked = if (List.nonEmpty(matched)) List.at(matched, 0) else Json.Null()
    name = Fs.basename(str(picked, "path"))
    body <- if (!Json.isNull(picked) && Str.matches(name, "^witness-[a-f0-9]{16}\\.toml$")) inside(root, Fs.join(".scuzz/ide/cards", Fs.join(cardId, name))).flatMap(_ => readOptional(Fs.join(cardDir(root, cardId), name))).handleErrorWith(_ => IO.pure("")) else IO.pure("")
  } yield if (!Str.isEmpty(body)) body else Verify.withOracle(Verify.reproText("0", "", Verify.noStr(), events), events)

def choiceRuleInputs(root: String, cardId: String): IO[(Json, Json)] =
  for {
    _ <- need(Str.matches(cardId, "^[a-f0-9]{64}$"), "select a recorded preference choice before Suggest rule")
    _ <- inside(root, Fs.join(".scuzz/ide/cards", Fs.join(cardId, "card.json")))
    prefs <- activePreferenceRecords(root)
    matches0 = List.filter(prefs, r => str(r, "card") == cardId)
    _ <- need(List.nonEmpty(matches0), "select a recorded preference choice before Suggest rule")
    rec = List.at(List.reverse(matches0), 0)
    decision = if (str(rec, "decision") == "accept") "accept" else "baseline"
    cardRaw <- Fs.read(Fs.join(cardDir(root, cardId), "card.json"))
    card <- Proposal.parse(cardRaw, 1048576)
    baseSrcs = pairs(Diags.jsonField(card, "baseline"))
    propSrcs = applyPaths(baseSrcs, propsOf(card))
    chosenSrcs = if (decision == "accept") propSrcs else baseSrcs
    rejectedSrcs = if (decision == "accept") baseSrcs else propSrcs
    preference = Json.Obj([("card", Json.Str(cardId)), ("proposal", Json.Str(str(card, "proposal"))), ("decision", Json.Str(decision)), ("chosen", pairsJson(chosenSrcs)), ("rejected", pairsJson(rejectedSrcs))])
    evidence = Diags.jsonField(card, "evidence")
    recQ = Diags.jsonField(rec, "question")
    cardQ = Diags.jsonField(card, "question")
    question = if (!Str.isEmpty(str(recQ, "workload"))) recQ else cardQ
    workLabel = str(question, "workload")
    step = Json.getInt(question, "step", 0)
    work = Lanes.workAt(evidence, workLabel)
    _ <- need(!Json.isNull(work), "recorded choice has no supporting witness")
    pathA = Lanes.workPath(work, "a")
    pathB = Lanes.workPath(work, "b")
    _ <- need(Str.matches(pathA, "^[A-Za-z0-9_-]+\\.txt$") && Str.matches(pathB, "^[A-Za-z0-9_-]+\\.txt$"), "unsafe witness timeline path")
    _ <- inside(root, Fs.join(".scuzz/ide/cards", Fs.join(cardId, pathA)))
    _ <- inside(root, Fs.join(".scuzz/ide/cards", Fs.join(cardId, pathB)))
    tlA <- Fs.read(Fs.join(cardDir(root, cardId), pathA))
    tlB <- Fs.read(Fs.join(cardDir(root, cardId), pathB))
    chosenTl = if (decision == "accept") tlB else tlA
    rejectedTl = if (decision == "accept") tlA else tlB
    events = List.map(Json.arr(Diags.jsonField(work, "events")), e => Json.strOr(e, ""))
    script <- cardWitnessScript(root, cardId, evidence, events)
    witnessId = Hash.sha256(text(Json.Obj([("card", Json.Str(cardId)), ("decision", Json.Str(decision)), ("workload", Json.Str(workLabel)), ("step", Json.Int(step)), ("events", Diags.jsonField(work, "events")), ("chosen_sha256", Json.Str(Hash.sha256(chosenTl)))])))
    witness = Json.Obj([("id", Json.Str(witnessId)), ("workload", Json.Str(workLabel)), ("step", Json.Int(step)), ("events", Diags.jsonField(work, "events")), ("script", Json.Str(script)), ("chosen_timeline", Json.Str(Str.take(chosenTl, 8192))), ("rejected_timeline", Json.Str(Str.take(rejectedTl, 8192)))])
  } yield (preference, witness)

private def ruleRequestContext(request: Json): String =
  text(Json.Obj(List.map(["v", "kind", "objective", "baseline", "compiler", "inputs", "sources", "verify_files", "checks", "preference", "witness", "limits", "instructions"], key => (key, Proposal.field(request, key)))))

private def ruleInputs(root: String, request: Json): IO[List[(String, String)]] =
  for {
    files <- packageInputs(root, "package", [])
    compiler <- Sys.getenv("SCUZZ_EXECUTABLE_SHA256")
    session <- sessionContext(root)
    cli <- compilerIdentity()
    _ <- Proposal.validateRule(root, request, cli)
    toml <- Fs.read(Fs.join(root, "scuzz.toml"))
    host <- if (Manifest.parse(toml).hasUi) Main.scuzzCli().flatMap(scuzz => Drive.uiHostExe(scuzz)).flatMap(exe => need(exe != "", "UI review host is unavailable").flatMap(_ => executableIdentity(exe))) else IO.pure(cli)
  } yield List.concat(files, [("compiler", compiler), ("review-compiler", cli), ("review-host", host), ("rule-request-context", ruleRequestContext(request)), ("session-context", session), ("objective", str(request, "objective"))])

private def activeRuleRequestRaw(root: String): IO[String] =
  readOptional(Fs.join(storage(root), "rule-request.json")).flatMap(saved => if (!Str.isEmpty(saved)) IO.pure(saved) else readOptional(Fs.join(root, "build/ide/rule-request.json")))

private def ruleProposalRequest(root: String, name: String): IO[Json] =
  for {
    _ <- need(Str.matches(name, "^[A-Za-z0-9_-]+$"), "unsafe proposal name")
    path = Fs.join(Fs.join("build/proposals", name), "proposal.json")
    _ <- inside(root, path)
    publicationRaw <- Fs.read(Fs.join(root, path))
    publication <- Proposal.parse(publicationRaw, 131072)
    _ <- need(str(publication, "kind") == "rule", "publication is not a rule draft")
    id = str(publication, "request")
    _ <- need(Str.matches(id, "^[A-Za-z0-9_-]{1,128}$"), "unsafe publication request identity")
    latestRaw <- activeRuleRequestRaw(root)
    _ <- need(!Str.isEmpty(latestRaw), "no exported rule request is active")
    latest <- Proposal.parse(latestRaw, 1048576)
    archive <- requestArchive(root, id)
    request = Proposal.field(archive, "request")
    session <- sessionContext(root)
    _ <- need(str(archive, "session") == session && str(request, "request") == str(latest, "request") && ruleRequestContext(request) == ruleRequestContext(latest), stalePublicationMessage())
    compiler <- compilerIdentity()
    _ <- Proposal.validateRule(root, latest, compiler)
    _ <- Proposal.validateRule(root, request, compiler)
  } yield request

private def existingVerifyPairs(root: String): IO[List[(String, String)]] =
  packageInputs(root, "package", []).map(ins => List.map(List.filter(ins, f => Str.startsWith(f._1, "package/") && Str.endsWith(f._1, ".scuzz_verify")), f => (Str.drop(f._1, 8), f._2)))

private def ruleFailReport(why: String, addedSrc: String, workRows: List[Json]): Json =
  Json.Obj([("status", Json.Str("draft")), ("diagnostic", Json.Str(why)), ("added_source", Json.Str(addedSrc)), ("added_claims", Json.Arr([])), ("declared_triggers", Json.Arr([])), ("reached_triggers", Json.Arr([])), ("workloads", Json.Arr(workRows)), ("scope_note", Json.Str("Draft failed verification. Finite evidence does not establish a universal proof."))])

def ruleStaticCheck(root: String, targetPath: String, proposedSrc: String): IO[(String, String, List[(String, String)], List[(String, String)], List[(String, String)], String)] =
  if (!Proposal.safeVerifyPath(targetPath)) IO.pure(("rule path must be a root *.scuzz_verify file", "", [], [], [], "")) else for {
  _ <- inside(root, targetPath)
  toml <- Fs.read(Fs.join(root, "scuzz.toml"))
  m = Manifest.parse(toml)
  _ <- Drive.manNeed(m)
  ents <- Fs.list(Fs.join(root, "src"))
  ownSrcs <- Drive.readSrcFiles(Fs.join(root, "src"), ents)
  liveAll <- Drive.collectDeps(root, m.deps, ownSrcs)
  ens = Verify.ensOfFiles(liveAll)
  scn <- Drive.fuzzReadScenario(root)
  existingVers <- existingVerifyPairs(root)
  existingHit = List.exists(existingVers, v => v._1 == targetPath)
  existingSrc = List.getOrElse(List.map(existingVers, v => v._2), List.indexOf(List.map(existingVers, v => v._1), targetPath), "")
  targetStem = Str.dropRight(targetPath, 13)
  proposedProg = Parse.parseFile(targetStem, proposedSrc)
  existingProg = if (existingHit) Parse.parseFile(targetStem, existingSrc) else Parse.emptyProg()
  verMsg = Verify.checkVerifyEns(proposedSrc, targetPath, ens)
  prefixPreserved = !existingHit || List.len(proposedProg.defs) > List.len(existingProg.defs) && List.map(List.take(proposedProg.defs, List.len(existingProg.defs)), d => Parse.prettyFun(d)) == List.map(existingProg.defs, d => Parse.prettyFun(d))
  addedDefs = if (!prefixPreserved || Parse.hasParseError(proposedProg)) Parse.noFun() else List.drop(proposedProg.defs, List.len(existingProg.defs))
  claimsValid = List.nonEmpty(addedDefs) && List.exists(addedDefs, d => Verify.isClaim(d) && List.len(d.params) == 1) && List.forall(addedDefs, d => d.priv || Verify.isClaim(d) && List.len(d.params) == 1 && Str.contains(Parse.pretty0(d.body), List.at(d.params, 0).name))
  allExistingNames = List.flatMap(existingVers, v => List.map(Parse.parseFile(Str.dropRight(Fs.basename(v._1), 13), v._2).defs, d => d.name))
  addedNames = List.map(addedDefs, d => d.name)
  namesFresh = List.len(List.distinct(addedNames)) == List.len(addedNames) && !List.exists(addedNames, n => List.contains(allExistingNames, n))
  addedSrc = if (List.isEmpty(addedDefs)) "" else Parse.pretty(Parse.emptyProg().copy(defs = addedDefs, mod = targetStem))
  baseVerPairs = List.map(List.filter(existingVers, v => v._1 != targetPath), v => (Str.dropRight(Fs.basename(v._1), 13), v._2))
  verPairsWithRule = List.concat(baseVerPairs, [(targetStem, proposedSrc)])
  versWithRule = List.map(verPairsWithRule, p => p._2)
  oracles = Verify.oracleNamesEns(versWithRule, ens)
  drvMsg = Verify.ruleFirst(Verify.driveRule(List.concat(oracles, Verify.scenarioDrvNames(scn))), Verify.driveClaimRule(versWithRule, Verify.driveClaimNames(scn, oracles)))
  filesWithRule = Drive.fuzzFiles(Verify.applyScenarioFiles(liveAll, scn), verPairsWithRule, Verify.scenarioWrap(scn))
  checkedStems = Verify.wrapMod() :: Drive.fileStems(ownSrcs)
  typeMsg = if (Parse.hasParseError(proposedProg)) "syntax error" else Check.humanFilesOwn(Drive.sigFiles(filesWithRule, checkedStems), checkedStems)
  diag = if (Parse.hasParseError(proposedProg)) "rule draft has a syntax error" else if (!prefixPreserved) "rule draft alters, removes, or weakens an existing definition" else if (verMsg != "scuzz check ok") verMsg else if (!claimsValid) "rule draft must add a non-vacuous single-timeline Verdict claim without altering drivers" else if (!namesFresh) "rule draft redefines an existing verify name" else if (drvMsg != "") drvMsg else if (typeMsg != "scuzz check ok") Str.concat("scuzz check: ", typeMsg) else ""
} yield (diag, addedSrc, existingVers, verPairsWithRule, filesWithRule, toml)

def replayRuleWorkloads(root: String, toml: String, verPairsWithRule: List[(String, String)], filesWithRule: List[(String, String)], witness: Json): IO[(List[Json], String, String)] =
  for {
    _ = verPairsWithRule
    m = Manifest.parse(toml)
    scuzzExe <- Main.scuzzCli()
    host <- if (m.hasUi) Drive.uiHostExeAt(scuzzExe, true) else IO.pure(scuzzExe)
    _ <- need(!m.hasUi || !Str.isEmpty(host), "UI review host is unavailable")
    outDir = Fs.join(root, "build/ide/rule-check")
    _ <- Fs.delete(outDir).handleErrorWith(_ => IO.pure(()))
    _ <- Fs.mkdirs(outDir)
    side <- Diff.sideEv(root, outDir, 0, m, filesWithRule, host)
    requiredRuns = Diff.workloads(side, side)
    witScript = str(witness, "script")
    witEvents = List.map(Json.arr(Diags.jsonField(witness, "events")), e => Json.strOr(e, ""))
    witRun = Drive.FuzzRun("supporting-witness", witScript, Verify.nls(if (Str.isEmpty(witScript)) witEvents else Verify.parseEvents(witScript)), Verify.tomlQuoted(witScript, "schedule_seed"), Verify.tomlQuoted(witScript, "fault_seed"), Verify.parseStrArr(witScript, "schedule_picks"))
    allRuns = if (Drive.fuzzHasScript(requiredRuns, witRun.script)) requiredRuns else List.append(requiredRuns, witRun)
    replayed <- IO.ensure(for {
  _ <- IO.foreachDiscard([Drive.fuzzTriggerPath(side.job.outDir), Drive.fuzzClaimPath(side.job.outDir), Drive.fuzzSometimesPath(side.job.outDir)], p => Fs.write(p, ""))
  workRows <- IO.foreach(allRuns, r => Diff.probeSide(side, r).map(out => for {
  label = if (r.path == "supporting-witness") Str.concat("witness (", Str.concat(str(witness, "workload"), ")")) else Diff.label(r)
  ok = !out.unrun && out.code == 0
  why = if (ok) Json.Null() else Json.Str(if (Str.isEmpty(out.why)) "rejected" else out.why)
} yield Json.Obj([("label", Json.Str(label)), ("ok", Json.Bool(ok)), ("why", why)])))
  trigDump <- Drive.fuzzReadOr(Drive.fuzzTriggerPath(side.job.outDir))
  claimDump <- Drive.fuzzReadOr(Drive.fuzzClaimPath(side.job.outDir))
} yield (workRows, trigDump, claimDump), Drive.evStop(side.job))
  } yield replayed

def verifyRuleDraft(root: String, targetPath: String, proposedSrc: String, witness: Json): IO[Json] =
  for {
    checked <- ruleStaticCheck(root, targetPath, proposedSrc)
    diag = checked._1
    addedSrc = checked._2
    existingVers = checked._3
    verPairsWithRule = checked._4
    filesWithRule = checked._5
    toml = checked._6
    report <- if (!Str.isEmpty(diag)) IO.pure(ruleFailReport(diag, addedSrc, [])) else for {
  replayed <- replayRuleWorkloads(root, toml, verPairsWithRule, filesWithRule, witness)
  workRows = replayed._1
  trigDump = replayed._2
  claimDump = replayed._3
  failed = List.filter(workRows, row => !Json.getBool(row, "ok", false))
  targetStem = Str.dropRight(targetPath, 13)
  addedPair = [(targetStem, addedSrc)]
  existingSingleClaims = List.map(List.filter(List.flatMap(existingVers, v => Verify.parseClaims(v._2)), d => List.len(d.params) == 1), d => d.name)
  addedClaimNames = Verify.claimNames([addedSrc])
  checkedClaims = Verify.checkedClaimNames(claimDump)
  missingExisting = Verify.reachNever(existingSingleClaims, checkedClaims)
  missingAdded = Verify.reachNever(addedClaimNames, checkedClaims)
  addedTriggers = Verify.triggersOf(addedPair)
  addedDrives = Verify.claimDriveOf(addedPair)
  reachedTriggers = Verify.triggerReached(trigDump)
  reachedDrives = Verify.claimDriveHit(claimDump, addedDrives)
  untriggered = List.concat(Verify.reachNever(addedTriggers, reachedTriggers), Verify.reachNever(addedDrives, reachedDrives))
  firstFail = if (List.isEmpty(failed)) Json.Null() else List.at(failed, 0)
  firstWhy = if (Str.isEmpty(str(firstFail, "why"))) "rejected" else str(firstFail, "why")
} yield if (List.nonEmpty(failed)) ruleFailReport(Str.concat("rule workload failed (", Str.concat(str(firstFail, "label"), Str.concat("): ", firstWhy))), addedSrc, workRows) else if (List.nonEmpty(missingExisting)) ruleFailReport(Str.concat("existing claim did not execute: ", List.join(missingExisting, ", ")), addedSrc, workRows) else if (List.nonEmpty(missingAdded)) ruleFailReport(Str.concat("added claim did not execute: ", List.join(missingAdded, ", ")), addedSrc, workRows) else if (List.nonEmpty(untriggered)) ruleFailReport(Str.concat("untriggered new claim: ", List.join(untriggered, ", ")), addedSrc, workRows) else Json.Obj([("status", Json.Str("verified")), ("diagnostic", Json.Str("")), ("added_source", Json.Str(addedSrc)), ("added_claims", Json.Arr(List.map(addedClaimNames, n => Json.Str(n)))), ("declared_triggers", Json.Arr(List.map(List.concat(addedTriggers, addedDrives), n => Json.Str(n)))), ("reached_triggers", Json.Arr(List.map(List.concat(List.filter(reachedTriggers, n => List.contains(addedTriggers, n)), reachedDrives), n => Json.Str(n)))), ("workloads", Json.Arr(workRows)), ("scope_note", Json.Str("Verified on finite required workloads and supporting witness. Not a universal proof."))])
  } yield report

def prepareRuleDraft(root: String, name: String): IO[Json] =
  for {
    _ <- recover(root)
    request <- ruleProposalRequest(root, name)
    files <- importFor(root, name, request)
    verifyDisk <- Proposal.ownVerify(root)
    ins <- ruleInputs(root, request)
    pub <- Fs.read(Fs.join(Fs.join(Deck.proposalsDir(root), name), "proposal.json"))
    report <- verifyRuleDraft(root, List.at(files, 0)._1, List.at(files, 0)._2, Proposal.field(request, "witness"))
    nonce <- Uuid.v4()
    now <- Clock.monotonic()
    id = identity(List.concat(ins, [("frozen-rule-request", text(request))]), files, pub, nonce)
    ruleCard = Json.Obj([("v", Json.Int(1)), ("id", Json.Str(id)), ("kind", Json.Str("rule")), ("proposal", Json.Str(name)), ("publication", Json.Str(pub)), ("objective", Proposal.field(request, "objective")), ("inputs", pairsJson(ins)), ("baseline_verify", pairsJson(verifyDisk)), ("proposed", pairsJson(files)), ("preference", Proposal.field(request, "preference")), ("witness", Proposal.field(request, "witness")), ("request", request), ("report", report), ("status", Proposal.field(report, "status")), ("diagnostic", Proposal.field(report, "diagnostic")), ("started", Json.Int(now)), ("ready", Json.Int(now))])
    _ <- setupRuleStorage(root)
    _ <- Fs.mkdirs(ruleDir(root, id))
    _ <- Fs.write(Fs.join(ruleDir(root, id), "rule.json"), text(ruleCard))
    _ <- Fs.write(Fs.join(storage(root), "active-rule.txt"), id)
    _ <- Fs.delete(Fs.join(Deck.proposalsDir(root), name)).handleErrorWith(_ => IO.pure(()))
  } yield ruleCard

def loadActiveRule(root: String): IO[Json] =
  (for {
  idRaw <- readOptional(Fs.join(storage(root), "active-rule.txt"))
  id = Str.trim(idRaw)
  _ <- need(Str.matches(id, "^[a-f0-9]{64}$"), "no active rule")
  _ <- inside(root, Fs.join(".scuzz/ide/rules", Fs.join(id, "rule.json")))
  installedHit <- Fs.exists(recordPath(root, Str.concat("install-rule-", id)))
  rejectedHit <- Fs.exists(recordPath(root, Str.concat("reject-rule-", id)))
  _ <- need(installedHit == 0 && rejectedHit == 0, "active rule already decided")
  raw <- Fs.read(Fs.join(ruleDir(root, id), "rule.json"))
  card <- Proposal.parse(raw, 1048576)
  _ <- need(str(card, "id") == id && str(card, "kind") == "rule", "invalid active rule")
} yield card).handleErrorWith(_ => IO.pure(Json.Null()))

def installRule(root: String, ruleCard: Json, dirties: List[String]): IO[Unit] =
  for {
    _ <- recover(root)
    id = str(ruleCard, "id")
    _ <- need(Str.matches(id, "^[a-f0-9]{64}$") && str(ruleCard, "kind") == "rule", "invalid rule review card")
    _ <- need(str(ruleCard, "status") == "verified" && str(Diags.jsonField(ruleCard, "report"), "status") == "verified" && Str.isEmpty(str(ruleCard, "diagnostic")), if (!Str.isEmpty(str(ruleCard, "diagnostic"))) str(ruleCard, "diagnostic") else "rule draft is not verified")
    installedHit <- Fs.exists(recordPath(root, Str.concat("install-rule-", id)))
    rejectedHit <- Fs.exists(recordPath(root, Str.concat("reject-rule-", id)))
    _ <- need(installedHit == 0 && rejectedHit == 0, "rule draft is already decided")
    props = propsOf(ruleCard)
    _ <- need(Proposal.ruleSetOk(props), "invalid rule verify file")
    hits <- dirtyHits(root, props, dirties)
    _ <- need(List.isEmpty(hits), List.join(Deck.dirtyLines(hits), Lanes.nl()))
    request = Proposal.field(ruleCard, "request")
    compiler <- compilerIdentity()
    _ <- Proposal.validateRule(root, request, compiler)
    ins <- ruleInputs(root, request)
    _ <- need(setHash(ins) == setHash(pairs(Diags.jsonField(ruleCard, "inputs"))), "rule review inputs changed")
    verifyDisk <- Proposal.ownVerify(root)
    baseVer = pairs(Diags.jsonField(ruleCard, "baseline_verify"))
    _ <- need(setHash(verifyDisk) == setHash(baseVer), "workspace verify files changed")
    rechecked <- ruleStaticCheck(root, List.at(props, 0)._1, List.at(props, 0)._2)
    _ <- need(Str.isEmpty(rechecked._1), rechecked._1)
    ws = List.map(props, f => Json.Obj([("path", Json.Str(f._1)), ("before", Json.Str(List.getOrElse(List.map(baseVer, d => d._2), List.indexOf(List.map(baseVer, d => d._1), f._1), ""))), ("before_exists", Json.Bool(List.contains(List.map(baseVer, d => d._1), f._1))), ("after", Json.Str(f._2)), ("after_exists", Json.Bool(true))]))
    now <- Clock.monotonic()
    op = Json.Obj([("operation", Json.Str(Str.concat("install-rule-", id))), ("card", Json.Str(id)), ("kind", Json.Str("rule")), ("proposal", Proposal.field(ruleCard, "proposal")), ("decision", Json.Str("install-rule")), ("witness", Json.Str(str(Diags.jsonField(ruleCard, "witness"), "id"))), ("objective", Proposal.field(ruleCard, "objective")), ("region", Json.Arr(List.map(props, f => Json.Str(f._1)))), ("time", Json.Int(now)), ("writes", Json.Arr(ws))])
    _ <- Fs.write(Fs.join(storage(root), "journal.json"), text(op)).flatMap(_ => finish(root, op))
  } yield ()

def rejectRule(root: String, ruleCard: Json): IO[Unit] =
  for {
    _ <- recover(root)
    id = str(ruleCard, "id")
    _ <- need(Str.matches(id, "^[a-f0-9]{64}$") && str(ruleCard, "kind") == "rule", "invalid rule review card")
    installedHit <- Fs.exists(recordPath(root, Str.concat("install-rule-", id)))
    rejectedHit <- Fs.exists(recordPath(root, Str.concat("reject-rule-", id)))
    _ <- need(installedHit == 0 && rejectedHit == 0, "rule draft is already decided")
    now <- Clock.monotonic()
    op = Json.Obj([("operation", Json.Str(Str.concat("reject-rule-", id))), ("card", Json.Str(id)), ("kind", Json.Str("rule")), ("proposal", Proposal.field(ruleCard, "proposal")), ("decision", Json.Str("reject-rule")), ("witness", Json.Str(str(Diags.jsonField(ruleCard, "witness"), "id"))), ("objective", Proposal.field(ruleCard, "objective")), ("diagnostic", Proposal.field(ruleCard, "diagnostic")), ("region", Json.Arr(List.map(propsOf(ruleCard), f => Json.Str(f._1)))), ("time", Json.Int(now)), ("writes", Json.Arr([]))])
    _ <- Fs.write(recordPath(root, Str.concat("reject-rule-", id)), text(op))
    _ <- Fs.write(Fs.join(storage(root), "active-rule.txt"), "")
  } yield ()

