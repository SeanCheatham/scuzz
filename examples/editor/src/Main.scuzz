def analyze(path: String, body: String): IO[String] =
  for {
    _ <- Fs.write(path, body)
    start = Fs.dirname(path)
    here <- Fs.canonicalize(start).handleErrorWith(_ => IO.pure(start))
    hit <- Fs.exists(Fs.join(here, "scuzz.toml"))
    parent = Fs.dirname(here)
    up <- Fs.exists(Fs.join(parent, "scuzz.toml"))
    above = Fs.dirname(parent)
    up2 <- Fs.exists(Fs.join(above, "scuzz.toml"))
    root = if (hit) here else if (up) parent else if (up2) above else here
    got <- Sys.exec(Str.concat("scuzz check --message-format=json ", root)).handleErrorWith(_ => IO.pure((Str.len("x"), "[]", "")))
  } yield if (Str.startsWith(got._2, "[")) got._2 else "[]"

def runProject(root: String): IO[String] =
  for {
    got <- Sys.exec(Str.concat("scuzz run ", root)).handleErrorWith(_ => IO.pure((Str.len("x"), "", "run fail")))
  } yield Chrome.captureOut(got._2, got._3)

def startFuzz(root: String): IO[Int] =
  Sys.spawn(Str.concat("scuzz fuzz --iterations 0 ", root)).handleErrorWith(_ => IO.pure(0))

def fuzzAlive(pid: Int): IO[Int] =
  Sys.alive(pid).handleErrorWith(_ => IO.pure(0))

def loadFuzzMaps(root: String): IO[(List[String], List[String])] =
  for {
    somDec <- Chrome.readOr(Chrome.declaredPath(root, "sometimes.declared"))
    trigDec <- Chrome.readOr(Chrome.declaredPath(root, "triggers.declared"))
    somDump <- Chrome.readOr(Chrome.fuzzFile(root, "sometimes.dump"))
    trigDump <- Chrome.readOr(Chrome.fuzzFile(root, "triggers.dump"))
  } yield (Chrome.chipRows(Chrome.nonEmptyLines(somDec), Chrome.nonEmptyLines(somDump)), Chrome.chipRows(Chrome.nonEmptyLines(trigDec), Chrome.triggerHitNames(trigDump)))

def loadFuzzStatus(root: String): IO[List[String]] =
  Chrome.readOr(Chrome.fuzzFile(root, "summary.json")).map(raw => Chrome.statusLines(raw))

def walkTree(root: String): IO[List[String]] =
  for {
    ents <- Fs.walk(root).handleErrorWith(_ => IO.pure([]))
  } yield List.sort(List.filter(Chrome.filesOf(ents), s => Chrome.keepWalk(s)))

@main def main: IO[Unit] =
  for {
    _ <- Chrome.seedWorkspace()
    args <- Sys.args()
    tomlHit <- Fs.exists("scuzz.toml")
    arg = List.head(args) match {
  case Option.Some(s) => s
  case Option.None => Chrome.defaultArg(tomlHit)
}
    _ = Property.check("rel", Chrome.preferredRel(true, [], []) == Fs.join("src", "Main.scuzz"), true)
    _ = Property.check("stem", Chrome.stemOf("src/Main.scuzz") == "Main", true)
    _ = Property.check("pkg", Chrome.packageName("[package]\nname = \"hello\"\n", "x") == "hello", true)
    _ = Property.check("pkgf", Chrome.packageName("", "hello") == "hello", true)
    _ = Property.check("live", Chrome.liveRels(["src/Main.scuzz", "src/", "a.txt"]) == ["src/Main.scuzz"], true)
    _ = Property.check("ver", Chrome.verifyRels(["chrome.scuzz_verify", "editor.scuzz_scenario", "src/Main.scuzz"]) == ["chrome.scuzz_verify", "editor.scuzz_scenario"], true)
    _ = Property.check("defa", Chrome.defaultArg(1) == ".", true)
    _ = Property.check("deft", Chrome.defaultArg(0) == "sample.txt", true)
    _ = Property.check("strip", Chrome.stripUri("file://a") == "a", true)
    _ = Property.check("abs", Chrome.resolvePath("d", "/a") == "/a", true)
    _ = Property.check("res", Chrome.resolvePath("d", "b") == Fs.join("d", "b"), true)
    _ = Property.check("dfile", Check.diagFile("1:1|a.scuzz|m") == "a.scuzz", true)
    _ = Property.check("dempty", Check.diagFile("1:1||m") == "", true)
    _ = Property.check("open", Chrome.openPaths(["a"], "b") == ["a", "b"], true)
    _ = Property.check("reopen", Chrome.openPaths(["a"], "a") == ["a"], true)
    _ = Property.check("drop", Chrome.dropAt(["a", "b", "c"], 1) == ["a", "c"], true)
    _ = Property.check("aft", Chrome.afterClose(1, 0, 1) == 0, true)
    _ = Property.check("keep", Chrome.afterClose(0, 0, 1) == 0, true)
    _ = Property.check("tl", Chrome.tabLabel("src/Main.scuzz", "x", "x") == "Main.scuzz", true)
    _ = Property.check("td", Chrome.tabLabel("src/Main.scuzz", "x", "y") == "Main.scuzz *", true)
    _ = Property.check("cl", Chrome.closeLabel("src/Main.scuzz") == "x Main.scuzz", true)
    _ = Property.check("cap", Chrome.captureOut("out", "") == "out", true)
    _ = Property.check("err", Chrome.captureOut("out", "e") == """out
e""", true)
    _ = Property.check("nemp", Chrome.nonEmptyLines("""a

b""") == ["a", "b"], true)
    _ = Property.check("row", Chrome.rowName("tappedPlus\t1") == "tappedPlus", true)
    _ = Property.check("ron", Chrome.rowOn("tappedPlus\t1") == 1, true)
    _ = Property.check("roff", Chrome.rowOn("neverHit\t0") == 0, true)
    _ = Property.check("crows", Chrome.chipRows(["a", "b"], ["a"]) == ["a\t1", "b\t0"], true)
    _ = Property.check("thit", Chrome.triggerHitNames("""claim	outlined:Check	triggered
claim	x	vacuous
""") == ["outlined:Check"], true)
    _ = Property.check("sok", Chrome.statusLines("{\"fuzz\":{\"ok\":true}}") == ["fuzz ok"], true)
    _ = Property.check("sfail", Chrome.statusLines("{\"fuzz\":{\"ok\":false}}") == ["fuzz fail"], true)
    _ = Property.check("sempty", Chrome.statusLines("") == [], true)
    _ = Property.check("find", Chrome.findNextOffset("ababa", "ba", 0) == 1, true)
    _ = Property.check("ins", Chrome.insertAt("ab", 1, "x") == "axb", true)
    _ = Property.check("line", Chrome.lineColAt("""a
bc""", 3)._1 == 1, true)
    argListed <- Fs.list(arg).map(_ => Str.len("x")).handleErrorWith(_ => IO.pure(Str.len("")))
    file <- Chrome.openBuffer(arg, argListed)
    root = if (argListed == 0) Fs.dirname(file) else arg
    raw <- Fs.read(file).handleErrorWith(_ => IO.pure(""))
    walked <- walkTree(root)
    toml <- Fs.read(Fs.join(root, "scuzz.toml")).handleErrorWith(_ => IO.pure(""))
    pkg = Chrome.packageName(toml, Fs.basename(root))
    buf = Signal.make(raw)
    orig = Signal.make(raw)
    pathSig = Signal.make(file)
    dirSig = Signal.make(root)
    dirty = Signal.make(Str.len(""))
    paths = Signal.make([file])
    bodies = Signal.make([raw])
    origs = Signal.make([raw])
    idx = Signal.make(Str.len(""))
    diags = Signal.make([]: List[String])
    showDiags = Signal.make(0)
    lives = Signal.make(Chrome.liveRels(walked))
    verifies = Signal.make(Chrome.verifyRels(walked))
    output = Signal.make([]: List[String])
    showOut = Signal.make(0)
    fuzzPid = Signal.make(0)
    fuzzSometimesRows = Signal.make([]: List[String])
    fuzzTriggerRows = Signal.make([]: List[String])
    fuzzStatus = Signal.make([]: List[String])
    onChip = Signal.make(1)
    offChip = Signal.make(0)
    findQ = Signal.make("")
    replQ = Signal.make("")
    findOpen = Signal.make(Str.len(""))
    page = Signal.make(0)
    title = Signal.make(pkg)
    _ = Lsp.frame("{}")
    _ = Lsp.parseLen(Str.concat("Content-Length: 2", Str.concat(Lsp.headerBreak(), "{}")))
    _ = Property.check("need", Lsp.needLen(Str.len("abcd"), Str.len("xy")) == Str.len("abcdef"), true)
    _ = Property.check("ms", Lsp.msgSlice("aabbcc", Str.len("aa"), Str.len("bb")) == "bb", true)
    _ = Property.check("idm", Check.jsonInt(Check.jsonField(Lsp.takeIfMatch(Lsp.parseJson("{\"id\":2}"), Str.len("xy")), "id")) == Str.len("xy"), true)
    _ = Property.check("fix", Lsp.fixText(Lsp.parseJson("{\"result\":[{\"title\":\"fix\",\"edit\":{\"changes\":{\"u\":[{\"newText\":\"fixed\"}]}}}]}"), "x") == "fixed", true)
    _ = Property.check("rename", Lsp.renameText(Lsp.parseJson("{\"result\":{\"changes\":{\"u\":[{\"newText\":\"renamed\"}]}}}"), "x") == "renamed", true)
    _ = Property.check("duri", Lsp.defUri(Lsp.parseJson("{\"result\":[{\"uri\":\"file://x\",\"range\":{\"start\":{\"line\":0,\"character\":0}}}]}")) == "file://x", true)
    _ = Property.check("dobj", Lsp.defUri(Lsp.parseJson("{\"result\":{\"uri\":\"u\"}}")) == "u", true)
    _ <- Ui.setTitle(pkg)
    _ <- Fiber.fork(IO.forever(for {
  _ = Property.sometimes("polledFiles")
  _ <- IO.sleep(300)
  ps = Signal.get(paths)
  i = Signal.get(idx)
  curB = Signal.get(buf)
  curO = Signal.get(orig)
  polled <- Chrome.pollTabs(ps, Signal.get(bodies), Signal.get(origs), i, curB, curO)
  bs = polled._1
  os = polled._2
  reloaded = polled._3
  _ = Signal.set(bodies, bs)
  _ = Signal.set(origs, os)
  _ = if (reloaded == 1) Signal.set(buf, List.at(bs, i)) else ()
  _ = if (reloaded == 1) Signal.set(orig, List.at(os, i)) else ()
  _ = if (reloaded == 1) Signal.set(dirty, Str.len("")) else ()
  dir = Signal.get(dirSig)
  walked <- walkTree(dir)
  _ = Signal.set(lives, Chrome.liveRels(walked))
  _ = Signal.set(verifies, Chrome.verifyRels(walked))
  fp = Signal.get(fuzzPid)
  _ <- if (fp == 0) IO.pure(()) else for {
  maps <- loadFuzzMaps(dir)
  _ = Signal.set(onChip, 1)
  _ = Signal.set(offChip, 0)
  _ = Signal.set(fuzzSometimesRows, maps._1)
  _ = Signal.set(fuzzTriggerRows, maps._2)
  alive <- fuzzAlive(fp)
  _ <- if (alive != 0) IO.pure(()) else for {
  lines <- loadFuzzStatus(dir)
  _ = Signal.set(fuzzStatus, lines)
  _ = Signal.set(fuzzPid, 0)
} yield ()
} yield ()
} yield ()))
    _ <- Ui.run(_ => View.appShell(View.appBar(View.bindText(title), View.wrap(View.button("Save", _ => for {
  _ = Property.sometimes("tappedSave")
  p = Signal.get(pathSig)
  _ <- Fs.write(p, Signal.get(buf))
  _ = Signal.set(orig, Signal.get(buf))
  _ = Signal.set(bodies, List.setAt(Signal.get(bodies), Signal.get(idx), Signal.get(buf)))
  _ = Signal.set(origs, List.setAt(Signal.get(origs), Signal.get(idx), Signal.get(buf)))
  _ = Signal.set(dirty, Str.len(""))
} yield ()), View.outlinedButton("Check", _ => for {
  _ = Property.sometimes("tappedCheck")
  raw <- analyze(Signal.get(pathSig), Signal.get(buf))
  j = Lsp.parseJson(raw)
  _ <- Ui.setEditorDiagnostics(Check.diagMarks(j))
  _ <- Lsp.paintEditor(Signal.get(dirSig), Signal.get(pathSig), Signal.get(buf))
  rows = Check.diagRows(j)
  _ = Signal.set(diags, rows)
  _ = Signal.set(showDiags, Chrome.flagNonEmpty(rows))
} yield ()), View.outlinedButton("Find", _ => for {
  _ = Property.sometimes("tappedFind")
  _ = Signal.set(findOpen, Str.len("x"))
  _ <- IO.pure(())
} yield ()), View.outlinedButton("Save all", _ => for {
  _ = Property.sometimes("tappedSaveAll")
  bs = List.setAt(Signal.get(bodies), Signal.get(idx), Signal.get(buf))
  os <- Chrome.writeDirty(Signal.get(paths), bs, List.setAt(Signal.get(origs), Signal.get(idx), Signal.get(orig)))
  _ = Signal.set(bodies, bs)
  _ = Signal.set(origs, os)
  _ = Signal.set(orig, List.at(os, Signal.get(idx)))
  _ = Signal.set(dirty, Str.len(""))
} yield ()))), View.stack(View.indexBook(page, View.column(View.section("live", "Live", View.column(View.each(lives, s => View.textButton(Chrome.stemOf(s), _ => for {
  _ = Property.sometimes("tappedLive")
  next = Chrome.joinChild(Signal.get(dirSig), s)
  body <- Fs.read(next).handleErrorWith(_ => IO.pure(""))
  (ps, bs, os, i2, nextBody, nextOrig, d) = Chrome.applyOpen(Signal.get(paths), Signal.get(bodies), Signal.get(origs), Signal.get(idx), Signal.get(buf), Signal.get(orig), next, body)
  _ = Signal.set(paths, ps)
  _ = Signal.set(bodies, bs)
  _ = Signal.set(origs, os)
  _ = Signal.set(idx, i2)
  _ = Signal.set(buf, nextBody)
  _ = Signal.set(orig, nextOrig)
  _ = Signal.set(dirty, d)
  _ = Signal.set(pathSig, List.at(ps, i2))
  _ = Signal.set(page, 0)
} yield ())), View.editor(buf))), View.section("verify", "Verify", View.each(verifies, s => View.textButton(s, _ => for {
  _ = Property.sometimes("tappedVerify")
  next = Chrome.joinChild(Signal.get(dirSig), s)
  body <- Fs.read(next).handleErrorWith(_ => IO.pure(""))
  (ps, bs, os, i2, nextBody, nextOrig, d) = Chrome.applyOpen(Signal.get(paths), Signal.get(bodies), Signal.get(origs), Signal.get(idx), Signal.get(buf), Signal.get(orig), next, body)
  _ = Signal.set(paths, ps)
  _ = Signal.set(bodies, bs)
  _ = Signal.set(origs, os)
  _ = Signal.set(idx, i2)
  _ = Signal.set(buf, nextBody)
  _ = Signal.set(orig, nextOrig)
  _ = Signal.set(dirty, d)
  _ = Signal.set(pathSig, List.at(ps, i2))
  _ = Signal.set(page, 0)
} yield ()))), View.section("session", "Session", View.column(View.wrap(View.button("Run", _ => for {
  _ = Property.sometimes("tappedRun")
  line <- runProject(Signal.get(dirSig))
  runOut = List.append(Signal.get(output), line)
  _ = Signal.set(output, runOut)
  _ = Signal.set(showOut, Chrome.flagNonEmpty(runOut))
} yield ()), View.outlinedButton("Fuzz", _ => for {
  _ = Property.sometimes("tappedFuzz")
  root = Signal.get(dirSig)
  pid <- startFuzz(root)
  _ = Signal.set(fuzzPid, pid)
  _ = Signal.set(onChip, 1)
  _ = Signal.set(offChip, 0)
  maps <- loadFuzzMaps(root)
  _ = Signal.set(fuzzSometimesRows, maps._1)
  _ = Signal.set(fuzzTriggerRows, maps._2)
  alive <- if (pid == 0) IO.pure(0) else fuzzAlive(pid)
  _ <- if (alive != 0) IO.pure(()) else for {
  lines <- loadFuzzStatus(root)
  _ = Signal.set(fuzzStatus, lines)
  _ = Signal.set(fuzzPid, 0)
} yield ()
} yield ())), View.each(fuzzSometimesRows, row => View.chip(if (Chrome.rowOn(row) != 0) onChip else offChip, Chrome.rowName(row))), View.each(fuzzTriggerRows, row => View.chip(if (Chrome.rowOn(row) != 0) onChip else offChip, Chrome.rowName(row))), View.each(fuzzStatus, s => View.text(s)), View.showWhen(showDiags, 1, View.focusGroup(View.each(diags, s => View.button(s, _ => for {
  file = Check.diagFile(s)
  _ <- if (Str.isEmpty(file)) IO.pure(()) else for {
  dest = Chrome.resolvePath(Signal.get(dirSig), file)
  body <- Fs.read(dest).handleErrorWith(_ => IO.pure(""))
  (ps, bs, os, i2, nextBody, nextOrig, d) = Chrome.applyOpen(Signal.get(paths), Signal.get(bodies), Signal.get(origs), Signal.get(idx), Signal.get(buf), Signal.get(orig), dest, body)
  _ = Signal.set(paths, ps)
  _ = Signal.set(bodies, bs)
  _ = Signal.set(origs, os)
  _ = Signal.set(idx, i2)
  _ = Signal.set(buf, nextBody)
  _ = Signal.set(orig, nextOrig)
  _ = Signal.set(dirty, d)
  _ = Signal.set(pathSig, List.at(ps, i2))
  _ = Signal.set(page, 0)
} yield ()
  _ <- Check.jumpDiag(s)
} yield ())))), View.showWhen(showOut, 1, View.each(output, s => View.text(s))))))), View.overlay(findOpen, View.column(View.fontSize(20, View.text("Find")), View.textField(findQ, "find"), View.textField(replQ, "repl"), View.button("Next", _ => for {
  off <- Ui.editorCaret()
  found = Chrome.findNextOffset(Signal.get(buf), Signal.get(findQ), off + 1)
  hit = if (found < 0) Chrome.findNextOffset(Signal.get(buf), Signal.get(findQ), 0) else found
  lc = Chrome.lineColAt(Signal.get(buf), hit)
  _ <- if (hit < 0) IO.pure(()) else Ui.setEditorCaret(lc._1, lc._2)
} yield ()), View.button("Replace", _ => for {
  _ = Signal.set(buf, Str.replace(Signal.get(buf), Signal.get(findQ), Signal.get(replQ)))
  _ = Signal.set(dirty, Str.len("x"))
  _ = Signal.set(bodies, List.setAt(Signal.get(bodies), Signal.get(idx), Signal.get(buf)))
} yield ())))))).require(Str.len(Property.signalStr("buf")) >= 0).require(Property.signalListLen("paths") >= 0)
  } yield ()
