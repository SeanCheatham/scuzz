} yield ()))), View.expanded(View.column(View.bindText(revLabel), View.each(rowsA, s => View.code(s)))), View.expanded(View.column(View.text("b: working tree"), View.each(rowsB, s => View.code(s))))))))), View.overlay(findOpen, View.column(View.fontSize(20, View.text("Find")), View.textField(findQ, "find"), View.textField(replQ, "repl"), View.button("Next", _ => for {
  off <- Ui.editorCaret()
  found = Chrome.findNextOffset(Signal.get(buf), Signal.get(findQ), off + 1)
  hit = if (found < 0) Chrome.findNextOffset(Signal.get(buf), Signal.get(findQ), 0) else found
  lc = Chrome.lineColAt(Signal.get(buf), hit)
  _ <- if (hit < 0) IO.pure(()) else Ui.setEditorCaret(lc._1, lc._2)
} yield ()), View.button("Replace", _ => for {
  _ = Signal.set(buf, Str.replace(Signal.get(buf), Signal.get(findQ), Signal.get(replQ)))
  _ = Signal.set(dirty, Str.len("x"))
  _ = Signal.set(bodies, List.setAt(Signal.get(bodies), Signal.get(idx), Signal.get(buf)))
} yield ())))))).require(Str.len(Property.signalStr("buf")) >= 0).require(Property.signalListLen("paths") >= 0)
  } yield ()
