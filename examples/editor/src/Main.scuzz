record LaneS(status: Signal[List[String]], raw: Signal[String], rev: Signal[String], blab: Signal[String], works: Signal[List[String]], tls: Signal[List[String]], laneA: Signal[List[String]], laneB: Signal[List[String]], rail: Signal[List[String]], step: Signal[Int], title: Signal[String], rowsA: Signal[List[String]], rowsB: Signal[List[String]], viewA: Signal[List[String]], viewB: Signal[List[String]], srcs: Signal[List[(String, String, String)]], play: Signal[Int], work: Signal[String], resultA: Signal[String], resultB: Signal[String], flip: Signal[Int], scope: Signal[List[String]], details: Signal[Int])

record DeckS(card: Signal[String], pending: Signal[List[String]], armed: Signal[String], title: Signal[String], flip: Signal[Int], last: Signal[String], busy: Signal[Int], session: SessionS, queue: Signal[QueueS], queueStatus: Signal[String], root: Signal[String])

record PrepSlot(token: String, role: String, name: String)

record QueueS(epoch: Int, context: String, cards: List[PreparedCard], slots: List[PrepSlot], seen: List[String], ignored: List[String], enabled: Bool, automatic: Bool, retry: Bool)

record PreparedCard(card: Json, texts: List[String], guards: List[String], sources: List[(String, String, String)], outcome: String)

import Parse.Prog

def analyze(path: String, body: String): IO[String] =
  for {
    _ <- Fs.write(path, body)
    start = Fs.dirname(path)
    here <- Fs.canonicalize(start).handleErrorWith(_ => IO.pure(start))
    hit <- Fs.exists(Fs.join(here, "scuzz.toml"))
    parent = Fs.dirname(here)
    up <- Fs.exists(Fs.join(parent, "scuzz.toml"))
    above = Fs.dirname(parent)
    up2 <- Fs.exists(Fs.join(above, "scuzz.toml"))
    root = if (hit != 0) here else if (up != 0) parent else if (up2 != 0) above else here
    toml <- Fs.read(Fs.join(root, "scuzz.toml")).handleErrorWith(_ => IO.pure(""))
    ents <- Fs.list(Fs.join(root, "src")).handleErrorWith(_ => IO.pure([]))
    own <- Drive.readSrcFiles(Fs.join(root, "src"), ents)
    files <- Drive.collectDeps(root, Manifest.parse(toml).deps, own).handleErrorWith(_ => IO.pure(own))
  } yield Check.checkFilesOwn(files, Drive.fileStems(own))

def runProject(root: String): IO[String] =
  for {
    got <- Sys.exec(Str.concat("scuzz run ", root)).handleErrorWith(_ => IO.pure((Str.len("x"), "", "run fail")))
  } yield Chrome.captureOut(got._2, got._3)

def startDiff(root: String): IO[Int] =
  for {
    _ <- Fs.mkdirs(Fs.dirname(Lanes.reportPath(root))).handleErrorWith(_ => IO.pure(()))
    _ <- Fs.write(Lanes.reportPath(root), "").handleErrorWith(_ => IO.pure(()))
    pid <- Sys.spawn(Str.concat("scuzz diff ", Lanes.shQuote(root))).handleErrorWith(_ => IO.pure(0))
  } yield pid

def scuzzCli(): IO[String] =
  Sys.getenv("SCUZZ").map(v => if (Str.isEmpty(v)) "scuzz" else v)

def diskFiles(root: String, toml: String): IO[List[(String, String)]] =
  for {
    ents <- Fs.list(Fs.join(root, "src")).handleErrorWith(_ => IO.pure([]))
    own <- Drive.readSrcFiles(Fs.join(root, "src"), ents)
    files <- Drive.collectDeps(root, Manifest.parse(toml).deps, own).handleErrorWith(_ => IO.pure(own))
  } yield files

def compareBuffers(root: String, toml: String, disk: List[(String, String)], buffers: List[(String, String)]): IO[Unit] =
  scuzzCli().flatMap(cli => Diff.reviewSets(root, toml, disk, buffers, 1, 32, cli, ""))

def loadProposals(root: String): IO[List[String]] =
  Fs.list(Deck.proposalsDir(root)).map(es => Deck.propNames(es)).handleErrorWith(_ => IO.pure([]))

def readProposal(root: String, name: String): IO[List[(String, String)]] =
  Cards.importProposal(root, name)

def reviewProposal(root: String, toml: String, disk: List[(String, String)], propSet: List[(String, String)]): IO[Unit] =
  Cards.currentInputs(root).flatMap(inputs => scuzzCli().flatMap(cli => Diff.reviewSets(root, toml, disk, propSet, 1, 32, cli, Cards.setHash(inputs))))

def dropProposal(root: String, name: String): IO[Unit] =
  Fs.delete(Fs.join(Deck.proposalsDir(root), name)).handleErrorWith(_ => IO.pure(()))

def verifyFilesOf(root: String): IO[List[String]] =
  Fs.list(root).map(ents => Chrome.verifyFileRels(Chrome.filesOf(ents))).handleErrorWith(_ => IO.pure([]))

def deckGuard(ds: DeckS, io: Unit => IO[Unit]): IO[Unit] =
  IO.sleep(0).flatMap(_ => if (Signal.get(ds.busy) != 0) IO.sleep(50).flatMap(_ => deckGuard(ds, io)) else for {
  _ = Signal.set(ds.busy, 1)
  _ <- IO.ensure(io(()), IO.sleep(0).map(_ => Signal.set(ds.busy, 0)))
} yield ())

def deckEnd(ls: LaneS, ds: DeckS): Unit =
  for {
    _ = Signal.set(ds.card, "")
    _ = Signal.set(ds.armed, "")
    _ = Signal.set(ds.title, "")
    _ = Signal.set(ls.raw, "")
    _ = Signal.set(ls.tls, []: List[String])
    _ = Signal.set(ls.status, Deck.withLast(Signal.get(ds.last), ["no more proposals"]))
    _ = Signal.set(ls.works, []: List[String])
    _ = Signal.set(ls.rail, []: List[String])
    _ = Signal.set(ls.step, 0)
    _ = Signal.set(ls.play, 0)
    _ = Signal.set(ls.work, "")
    _ = Signal.set(ls.resultA, "")
    _ = Signal.set(ls.resultB, "")
    _ = Signal.set(ls.flip, 0)
    _ = Signal.set(ls.scope, []: List[String])
    _ = Signal.set(ls.details, 0)
    _ = Signal.set(ls.laneA, []: List[String])
    _ = Signal.set(ls.laneB, []: List[String])
    _ = Signal.set(ls.rowsA, []: List[String])
    _ = Signal.set(ls.rowsB, []: List[String])
    _ = Signal.set(ls.viewA, []: List[String])
    _ = Signal.set(ls.viewB, []: List[String])
    _ = Signal.set(ls.srcs, []: List[(String, String, String)])
    _ = Signal.set(ls.title, "")
    _ = Signal.set(ls.rev, "a: HEAD")
    _ = Signal.set(ls.blab, "b: working tree")
  } yield ()

def emptyQueue(epoch: Int): QueueS =
  QueueS(epoch, "", []: List[PreparedCard], []: List[PrepSlot], []: List[String], []: List[String], false, false, false)

def queueRead(ds: DeckS): IO[QueueS] =
  IO.pure(()).map(_ => Signal.get(ds.queue))

def queueChange(ds: DeckS, update: QueueS => QueueS): IO[QueueS] =
  IO.pure(()).map(_ => for {
  next = update(Signal.get(ds.queue))
  _ = Signal.set(ds.queue, next)
} yield next)

def queueUpdate(ds: DeckS, update: QueueS => QueueS): IO[Unit] =
  queueChange(ds, update).map(_ => ())

def queueStatus(ds: DeckS, q: QueueS): Unit =
  Signal.set(ds.queueStatus, if (q.retry) "Preparation failed. Retry preparation explicitly." else if (!q.enabled) "Preparation is paused." else Str.concat("Ready cards: ", Str.concat(Str.fromInt(List.len(q.cards)), Str.concat(" / 2; reserved: ", Str.concat(Str.fromInt(List.len(q.slots)), if (Signal.get(ds.session.count) >= 8 && q.automatic) "; request budget exhausted" else "")))))

def queueClear(ls: LaneS, ds: DeckS): IO[Unit] =
  queueUpdate(ds, q => for {
  next = q.copy(epoch = Signal.get(ds.session.epoch), cards = []: List[PreparedCard], slots = []: List[PrepSlot], enabled = false, retry = false)
  _ = deckEnd(ls, ds)
  _ = queueStatus(ds, next)
} yield next)

def restoreReady(root: String, cards: List[Json], capacity: Int): IO[List[PreparedCard]] =
  if (capacity <= 0 || List.isEmpty(cards)) IO.pure([]) else for {
  card = List.at(cards, 0)
  restored <- IO.attempt(for {
  _ <- Cards.need(Cards.str(card, "status") == "ready", "cached card is excluded")
  _ <- Cards.undecided(root, Cards.str(card, "id"))
  _ <- Cards.current(root, card)
  toml <- Fs.read(Fs.join(root, "scuzz.toml"))
  disk <- diskFiles(root, toml)
  cached <- loadCard(root, card, disk, Cards.propsOf(card))
} yield cached)
  ready = restored match {
  case Result.Ok(cached) => [cached]
  case Result.Err(_) => []: List[PreparedCard]
}
  rest <- restoreReady(root, List.tail(cards), capacity - List.len(ready))
} yield List.concat(ready, rest)

def queueInit(root: String, ds: DeckS): IO[Unit] =
  for {
    _ <- Session.guard(ds.session)
    epoch = Signal.get(ds.session.epoch)
    inputs <- Cards.currentInputs(root)
    context = Cards.setHash(inputs)
    _ <- Session.guard(ds.session)
    _ <- Cards.need(epoch == Signal.get(ds.session.epoch), "session changed during queue initialization")
    previous <- queueRead(ds)
    _ <- Cards.need(!previous.enabled || Str.isEmpty(previous.context) || previous.context == context, "baseline changed; cancel stale preparation before refill")
    _ <- if (previous.context == context && previous.epoch == epoch) queueUpdate(ds, q => for {
  next = q.copy(enabled = true)
  _ = queueStatus(ds, next)
} yield next) else for {
  known <- Cards.known(root, context)
  excluded <- Cards.excludedPublications(root, context)
  cached <- restoreReady(root, known, 2)
  _ <- Session.guard(ds.session)
  _ <- Cards.need(epoch == Signal.get(ds.session.epoch), "session changed during cache recovery")
  _ <- queueUpdate(ds, q => if (q.enabled && q.context == context && q.epoch == epoch) q else for {
  same = q.context == context
  seen = List.distinct(List.concat(if (same) q.seen else [], Cards.seenKeys(known)))
  ignored = List.distinct(List.concat(if (same) q.ignored else [], List.concat(List.map(known, c => Cards.str(c, "proposal")), excluded)))
  next = emptyQueue(epoch).copy(context = context, enabled = true, automatic = q.automatic, cards = cached, seen = seen, ignored = ignored)
  _ = queueStatus(ds, next)
} yield next)
} yield ()
  } yield ()

def queueReserve(ds: DeckS, role: String, token: String): IO[Bool] =
  for {
    q <- queueChange(ds, current => if (current.enabled && !current.retry && current.epoch == Signal.get(ds.session.epoch) && Signal.get(ds.session.active) == 1 && Signal.get(ds.session.config) == Session.settings(ds.session) && List.len(current.cards) + List.len(current.slots) < 2 && !List.exists(current.slots, slot => slot.role == role)) current.copy(slots = List.append(current.slots, PrepSlot(token, role, ""))) else current)
    _ = queueStatus(ds, q)
  } yield List.exists(q.slots, slot => slot.token == token)

def queueStage(ds: DeckS, token: String, role: String, name: String): IO[Unit] =
  queueUpdate(ds, q => if (q.epoch != Signal.get(ds.session.epoch) || Signal.get(ds.session.active) != 1 || Signal.get(ds.session.config) != Session.settings(ds.session)) q else q.copy(slots = List.map(q.slots, slot => if (slot.token == token && (slot.role == "generate" && role == "published" || slot.role == "review" && role == "review" && Str.isEmpty(slot.name))) PrepSlot(token, role, name) else slot)))

def queueRelease(ds: DeckS, token: String, failed: Bool): IO[Unit] =
  queueUpdate(ds, q => for {
  exists = List.exists(q.slots, slot => slot.token == token)
  next = q.copy(slots = List.filter(q.slots, slot => slot.token != token), retry = q.retry || failed && exists)
  _ = queueStatus(ds, next)
} yield next)

def queueCleanup(ds: DeckS, token: String, role: String): IO[Unit] =
  queueUpdate(ds, q => if (!List.exists(q.slots, slot => slot.token == token && slot.role == role)) q else for {
  next = q.copy(slots = List.filter(q.slots, slot => slot.token != token), retry = true)
  _ = queueStatus(ds, next)
} yield next)

def queueClaimPublished(ds: DeckS, token: String): IO[PrepSlot] =
  for {
    q <- queueChange(ds, current => if (!current.enabled || current.retry || current.epoch != Signal.get(ds.session.epoch) || Signal.get(ds.session.active) != 1 || Signal.get(ds.session.config) != Session.settings(ds.session) || List.exists(current.slots, slot => slot.role == "review")) current else for {
  published = List.filter(current.slots, slot => slot.role == "published")
} yield if (List.isEmpty(published)) current else current.copy(slots = List.map(current.slots, slot => if (slot.token == List.at(published, 0).token) PrepSlot(token, "review", slot.name) else slot)))
    claimed = List.filter(q.slots, slot => slot.token == token)
  } yield if (List.isEmpty(claimed)) PrepSlot("", "", "") else List.at(claimed, 0)

def queueFail(ds: DeckS, token: String, error: String): IO[Unit] =
  queueUpdate(ds, q => if (!List.exists(q.slots, slot => slot.token == token)) q else for {
  next = q.copy(slots = List.filter(q.slots, slot => slot.token != token), retry = true)
  _ = Signal.set(ds.session.reviewStatus, Str.concat(error, "; retry explicitly"))
  _ = queueStatus(ds, next)
} yield next)

def deckNext(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  queueWatch(root, ls, ds).flatMap(_ => queueInit(root, ds)).flatMap(_ => queuePulse(root, ls, ds)).handleErrorWith(e => IO.pure(Signal.set(ds.session.reviewStatus, e)))

def queueRetry(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  queueUpdate(ds, q => q.copy(retry = false)).flatMap(_ => deckNext(root, ls, ds))

def queueRestart(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  for {
    active = Signal.get(ds.session.active)
    _ <- Session.pause(ds.session)
    _ <- queueClear(ls, ds)
    _ <- Session.invalidateBaseline(root, ds.session)
    _ <- if (active == 1) Session.start(root, ds.session).flatMap(_ => queueInit(root, ds)) else IO.pure(())
  } yield ()

def queueWatch(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  if (Signal.get(ds.session.active) != 1 || Signal.get(ds.busy) != 0) IO.pure(()) else queueRead(ds).flatMap(q => if (!q.enabled || Str.isEmpty(q.context)) IO.pure(()) else Fs.exists(Fs.join(root, "build/ide/request.json")).flatMap(hit => if (hit == 0) Proposal.parse(Signal.get(ds.session.request), 1048576).flatMap(request => Cards.inputs(root, request)) else Cards.currentInputs(root)).map(inputs => Cards.setHash(inputs) == q.context).handleErrorWith(_ => IO.pure(false)).flatMap(same => if (same) IO.pure(()) else queueRestart(root, ls, ds)))

def queueGenerate(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  for {
    _ <- queueWatch(root, ls, ds)
    _ <- queueInit(root, ds)
    _ <- Cards.need(Signal.get(ds.session.mode) == 1, "select Local model mode before Generate suggestion")
    _ <- queueUpdate(ds, q => q.copy(automatic = true))
    _ <- queueGenerateOne(root, ds)
  } yield ()

def queueGenerateOne(root: String, ds: DeckS): IO[Unit] =
  for {
    owner <- Ref.get(ds.session.jobs)
    _ <- if (!Str.isEmpty(owner.token) || Signal.get(ds.session.count) >= 8) queueRead(ds).map(q => queueStatus(ds, q)) else for {
  token <- Uuid.v4()
  _ <- Session.generate(root, ds.session, _ => queueReserve(ds, "generate", token), name => queueStage(ds, token, "published", name), _ => queueCleanup(ds, token, "generate")).handleErrorWith(e => queueFail(ds, token, e))
} yield ()
  } yield ()

def queuePulse(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  if (Signal.get(ds.session.active) != 1 || Signal.get(ds.busy) != 0) IO.pure(()) else for {
  q <- queueRead(ds)
  _ <- if (!q.enabled || q.retry) IO.pure(()) else for {
  _ <- if (Str.isEmpty(q.context) || q.epoch != Signal.get(ds.session.epoch)) queueInit(root, ds) else IO.pure(())
  current <- queueRead(ds)
  _ = if (Str.isEmpty(Signal.get(ds.armed)) && List.nonEmpty(current.cards)) presentCard(List.at(current.cards, 0), ls, ds) else ()
  owner <- Ref.get(ds.session.reviews)
  _ <- if (!Str.isEmpty(owner.token)) IO.pure(()) else queueReviewOne(root, ls, ds)
  latest <- queueRead(ds)
  _ <- if (latest.automatic && Signal.get(ds.session.mode) == 1) queueGenerateOne(root, ds) else IO.pure(())
} yield ()
} yield ()

def queueReviewOne(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  for {
    token <- Uuid.v4()
    _ <- Session.own(ds.session, false, _ => queueClaimPublished(ds, token).flatMap(claimed => if (claimed.token == token) IO.pure(true) else queueReserve(ds, "review", token)), _ => queueReviewReserved(root, token, ls, ds), _ => queueCleanup(ds, token, "review")).handleErrorWith(e => queueFail(ds, token, e))
  } yield ()

def queueReviewReserved(root: String, token: String, ls: LaneS, ds: DeckS): IO[Unit] =
  for {
    q <- queueRead(ds)
    slots = List.filter(q.slots, slot => slot.token == token && slot.role == "review")
    _ <- Cards.need(List.len(slots) == 1, "review reservation changed")
    reserved = List.at(slots, 0)
    names <- if (!Str.isEmpty(reserved.name)) IO.pure([reserved.name]) else loadProposals(root)
    current <- queueRead(ds)
    taken = List.concat(current.ignored, List.concat(List.map(current.cards, c => Cards.str(c.card, "proposal")), List.map(List.filter(current.slots, slot => slot.token != token), slot => slot.name)))
    available = List.filter(names, name => !List.contains(taken, name))
    _ = Signal.set(ds.pending, List.take(available, 2 - List.len(current.cards)))
    _ <- if (List.isEmpty(available)) queueRelease(ds, token, false) else for {
  name = List.at(available, 0)
  _ <- queueStage(ds, token, "review", name)
  _ <- queuePrepare(root, name, token, ls, ds)
} yield ()
  } yield ()

def queuePrepare(root: String, name: String, token: String, ls: LaneS, ds: DeckS): IO[Unit] =
  (for {
  _ <- Cards.recover(root)
  props <- readProposal(root, name)
  toml <- Chrome.readOr(Fs.join(root, "scuzz.toml"))
  disk <- diskFiles(root, toml)
  flip <- Random.nextInt(2)
  card <- Cards.freeze(root, name, props, flip)
  q <- queueRead(ds)
  source = Str.concat("source:", Cards.str(card, "b"))
  _ <- if (List.contains(q.seen, source)) Cards.automatic(root, card, "duplicate-source").flatMap(_ => queueExclude(ds, token, name, [source])) else for {
  _ <- reviewProposal(root, toml, disk, Deck.applyProposal(disk, props))
  raw <- Fs.read(Lanes.reportPathAt(root, "ide"))
  ready <- Cards.complete(root, card, raw)
  _ <- if (Cards.str(ready, "status") == "excluded") queueExclude(ds, token, name, [source]) else for {
  cached <- loadCard(root, ready, disk, props)
  _ <- Cards.current(root, ready)
  current <- queueRead(ds)
  outcome = Str.concat("outcome:", cached.outcome)
  _ <- if (List.contains(current.seen, outcome)) Cards.automatic(root, ready, "duplicate-outcome").flatMap(_ => queueExclude(ds, token, name, [source, outcome])) else queueUpdate(ds, latest => if (latest.epoch != Signal.get(ds.session.epoch) || Signal.get(ds.session.active) != 1 || latest.context != Cards.setHash(Cards.pairs(Proposal.field(ready, "inputs"))) || !List.exists(latest.slots, slot => slot.token == token && slot.role == "review" && slot.name == name)) latest else for {
  next = latest.copy(cards = List.append(latest.cards, cached), slots = List.filter(latest.slots, slot => slot.token != token), seen = List.distinct(List.concat(latest.seen, [source, outcome])), ignored = List.distinct(name :: latest.ignored))
  _ = if (List.isEmpty(latest.cards) && Signal.get(ds.busy) == 0) presentCard(cached, ls, ds) else ()
  _ = queueStatus(ds, next)
} yield next)
} yield ()
} yield ()
} yield ()).handleErrorWith(e => if (e != Cards.stalePublicationMessage()) IO.fail(e) else for {
  q <- queueRead(ds)
  _ <- if (q.epoch != Signal.get(ds.session.epoch) || Signal.get(ds.session.active) != 1 || !List.exists(q.slots, slot => slot.token == token && slot.role == "review" && slot.name == name)) IO.pure(()) else Cards.excludePublication(root, name, q.context).flatMap(_ => queueExclude(ds, token, name, []))
} yield ())

def queueExclude(ds: DeckS, token: String, name: String, keys: List[String]): IO[Unit] =
  queueUpdate(ds, q => if (!List.exists(q.slots, slot => slot.token == token)) q else for {
  next = q.copy(slots = List.filter(q.slots, slot => slot.token != token), seen = List.distinct(List.concat(q.seen, keys)), ignored = List.distinct(name :: q.ignored))
  _ = queueStatus(ds, next)
} yield next)

def deckRandom(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  if (Signal.get(ds.busy) != 0 || Signal.get(ds.session.active) != 1) IO.pure(()) else queueUpdate(ds, q => if (q.retry || List.len(q.cards) != 2) q else for {
  cards = [List.at(q.cards, 1), List.at(q.cards, 0)]
  _ = presentCard(List.at(cards, 0), ls, ds)
} yield q.copy(cards = cards))

def queueAdvance(ls: LaneS, ds: DeckS, id: String): IO[Unit] =
  queueUpdate(ds, q => if (List.isEmpty(q.cards) || Cards.str(List.at(q.cards, 0).card, "id") != id) q else for {
  next = q.copy(cards = List.tail(q.cards))
  _ = deckEnd(ls, ds)
  _ = if (List.isEmpty(next.cards)) () else presentCard(List.at(next.cards, 0), ls, ds)
  _ = queueStatus(ds, next)
} yield next)

def loadCard(root: String, ready: Json, disk: List[(String, String)], props: List[(String, String)]): IO[PreparedCard] =
  for {
    evidence = Diags.jsonField(ready, "evidence")
    _ <- Cards.need(Cards.candidateReportPass(evidence) && Str.matches(Cards.str(ready, "outcome"), "^[a-f0-9]{64}$"), "cached evidence is incomplete")
    valid <- Cards.cachedEvidence(root, ready)
    _ <- Cards.need(valid, "cached evidence changed; prepare the publication again")
    texts <- IO.foreach(Lanes.workFiles(evidence), name => Cards.need(Str.matches(name, "^[A-Za-z0-9_-]+\\.txt$"), "unsafe cached timeline path").flatMap(_ => Cards.inside(root, Fs.join(".scuzz/ide/cards", Fs.join(Cards.str(ready, "id"), name)))).flatMap(_ => Fs.read(Fs.join(Cards.cardDir(root, Cards.str(ready, "id")), name))))
    vers <- verifyFilesOf(root)
  } yield PreparedCard(ready, texts, Deck.guardLines(vers), Deck.changedTriples(disk, Deck.applyProposal(disk, props)), Cards.str(ready, "outcome"))

def presentCard(cached: PreparedCard, ls: LaneS, ds: DeckS): Unit =
  for {
    ready = cached.card
    evidence = Diags.jsonField(ready, "evidence")
    raw = Cards.text(evidence)
    flip = Json.getInt(ready, "flip", 0)
    _ = Signal.set(ls.raw, raw)
    _ = Signal.set(ls.tls, if (flip == 0) cached.texts else Deck.swapPairs(cached.texts))
    _ = Signal.set(ds.flip, flip)
    _ = Signal.set(ls.works, List.map(Lanes.workItems(LspClient.parseJson(raw)), w => Cards.str(w, "label")))
    _ = Signal.set(ls.srcs, cached.sources)
    _ = Signal.set(ls.status, Deck.withLast(Signal.get(ds.last), cached.guards))
    _ = Signal.set(ls.scope, Lanes.scopeLines(LspClient.parseJson(raw), flip))
    _ = Signal.set(ls.rev, "Left")
    _ = Signal.set(ls.blab, "Right")
    _ = deckArm(ls)
    _ = Signal.set(ds.title, "Behavior review")
    _ = Signal.set(ds.card, Cards.text(ready))
    _ = Signal.set(ds.armed, Cards.str(ready, "id"))
  } yield ()

def deckArm(ls: LaneS): Unit =
  for {
    ws = Signal.get(ls.works)
    _ = if (List.isEmpty(ws)) () else showWork(List.at(ws, 0), Signal.get(ls.raw), Signal.get(ls.tls), ws, ls.laneA, ls.laneB, ls.rail, ls.step, ls.title, ls.rowsA, ls.rowsB, ls.viewA, ls.viewB, ls.play, ls.work, ls.resultA, ls.resultB, ls.flip)
  } yield ()

def chooseCard(root: String, id: String, lane: Int, ls: LaneS, ds: DeckS, dirties: Unit => List[String], refresh: IO[Unit]): IO[Unit] =
  if (Signal.get(ds.busy) != 0 || Str.isEmpty(id) || id != Signal.get(ds.armed)) IO.pure(()) else deckGuard(ds, _ => for {
  c = Json.set(LspClient.parseJson(Signal.get(ds.card)), "question", Json.Obj([("workload", Json.Str(Signal.get(ls.work))), ("step", Json.Int(Signal.get(ls.step)))]))
  props = Cards.pairs(Diags.jsonField(c, "proposed"))
  _ <- Cards.need(id == Signal.get(ds.armed) && Cards.str(c, "id") == id, "expired card action")
  proposalLane = if (Json.getInt(c, "flip", 0) == 1) 0 else 1
  hits <- if (lane == proposalLane) Cards.dirtyHits(root, props, dirties(())) else IO.pure([]: List[String])
  _ <- Cards.need(List.isEmpty(hits), List.join(Deck.dirtyLines(hits), Lanes.nl()))
  accepted = lane >= 0 && lane == proposalLane
  _ <- if (accepted) Session.pause(ds.session) else IO.pure(())
  _ <- Cards.decide(root, c, lane)
  _ <- if (accepted) Session.invalidateBaseline(root, ds.session) else IO.pure(())
  bytesMatch <- if (accepted) IO.foreach(props, p => Fs.read(Fs.join(root, p._1)).map(src => src == p._2)) else IO.pure([]: List[Bool])
  _ <- Property.assert("accepted frozen bytes", List.forall(bytesMatch, b => b))
  _ <- if (accepted) refresh else IO.pure(())
  _ = Signal.set(ds.last, Deck.revealText(if (lane < 0) "abstained" else if (accepted) "accepted" else "baseline chosen", Cards.str(c, "proposal"), if (Signal.get(ds.flip) == 1) "Left" else "Right"))
  _ <- if (accepted) queueClear(ls, ds).flatMap(_ => Session.start(root, ds.session)).flatMap(_ => queueInit(root, ds)) else queueAdvance(ls, ds, id)
  _ <- dropProposal(root, Cards.str(c, "proposal"))
  _ <- queuePulse(root, ls, ds)
} yield ()).handleErrorWith(e => if (id != Signal.get(ds.armed)) IO.pure(()) else queueUpdate(ds, q => for {
  next = q.copy(retry = true)
  _ = deckEnd(ls, ds)
  _ = Signal.set(ls.status, Deck.withLast(Signal.get(ds.last), [e]))
  _ = queueStatus(ds, next)
} yield next))

def decisionButtons(root: String, id: String, ls: LaneS, ds: DeckS, objectiveSession: SessionS, paths: Signal[List[String]], bodies: Signal[List[String]], origs: Signal[List[String]], idx: Signal[Int], buf: Signal[String], orig: Signal[String]): View =
  View.wrap(View.button("Choose left", _ => Session.guard(objectiveSession).flatMap(_ => chooseCard(root, id, 0, ls, ds, _ => Chrome.dirtyPaths(Signal.get(paths), List.setAt(Signal.get(bodies), Signal.get(idx), Signal.get(buf)), List.setAt(Signal.get(origs), Signal.get(idx), Signal.get(orig))), refreshBuffers(paths, bodies, origs, idx, buf, orig)))), View.button("Choose right", _ => Session.guard(objectiveSession).flatMap(_ => chooseCard(root, id, 1, ls, ds, _ => Chrome.dirtyPaths(Signal.get(paths), List.setAt(Signal.get(bodies), Signal.get(idx), Signal.get(buf)), List.setAt(Signal.get(origs), Signal.get(idx), Signal.get(orig))), refreshBuffers(paths, bodies, origs, idx, buf, orig)))), View.outlinedButton("Can't decide", _ => Session.guard(objectiveSession).flatMap(_ => chooseCard(root, id, -1, ls, ds, _ => [], IO.pure(())))))

def refreshBuffers(paths: Signal[List[String]], bodies: Signal[List[String]], origs: Signal[List[String]], idx: Signal[Int], buf: Signal[String], orig: Signal[String]): IO[Unit] =
  IO.sleep(0).flatMap(_ => IO.foreachDiscard(List.indices(Signal.get(paths)), i => if (i >= List.len(Signal.get(paths))) IO.pure(()) else for {
  path = List.at(Signal.get(paths), i)
  body = if (i == Signal.get(idx)) Signal.get(buf) else List.at(Signal.get(bodies), i)
  before = if (i == Signal.get(idx)) Signal.get(orig) else List.at(Signal.get(origs), i)
  next <- if (body != before) IO.pure(body) else Cards.readOptional(path)
  _ = if (i >= List.len(Signal.get(paths)) || List.at(Signal.get(paths), i) != path || body != before) () else for {
  now = if (i == Signal.get(idx)) Signal.get(buf) else List.at(Signal.get(bodies), i)
  old = if (i == Signal.get(idx)) Signal.get(orig) else List.at(Signal.get(origs), i)
  _ = if (now != body || old != before) () else for {
  _ = Signal.set(bodies, List.setAt(Signal.get(bodies), i, next))
  _ = Signal.set(origs, List.setAt(Signal.get(origs), i, next))
  _ = if (i != Signal.get(idx)) () else for {
  _ = Signal.set(buf, next)
  _ = Signal.set(orig, next)
} yield ()
} yield ()
} yield ()
} yield ()))

def editorWrite(ls: LaneS, ds: DeckS, io: Unit => IO[Unit]): IO[Unit] =
  if (Signal.get(ds.busy) != 0) IO.pure(()) else deckGuard(ds, _ => for {
  active = Signal.get(ds.session.active)
  _ <- if (active == 1) Session.pause(ds.session) else IO.pure(())
  _ <- queueClear(ls, ds)
  _ <- Session.invalidateBaseline(Signal.get(ds.root), ds.session)
  _ <- io(())
  _ <- if (active == 1) Session.start(Signal.get(ds.root), ds.session).flatMap(_ => queueInit(Signal.get(ds.root), ds)) else IO.pure(())
} yield ())

def undoCard(root: String, ls: LaneS, ds: DeckS, dirties: Unit => List[String], refresh: IO[Unit]): IO[Unit] =
  deckGuard(ds, _ => for {
  _ <- Cards.need(List.isEmpty(dirties(())), "save or discard dirty buffers before Undo")
  active = Signal.get(ds.session.active)
  _ <- Session.pause(ds.session)
  _ <- queueClear(ls, ds)
  _ <- Session.invalidateBaseline(root, ds.session)
  _ <- Cards.undo(root)
  _ <- refresh
  _ = Signal.set(ds.last, "Undo completes")
  _ <- if (active == 1) Session.start(root, ds.session).flatMap(_ => queueInit(root, ds)) else IO.pure(())
} yield ()).handleErrorWith(e => IO.pure(Signal.set(ls.status, [e])))

def writeMutant(root: String, kept: List[(String, String, Prog)], disk: List[(String, String)], site: Int): IO[Unit] =
  for {
    changed = Deck.changedFiles(disk, Deck.genApply(kept, site))
    dir = Fs.join(Deck.proposalsDir(root), Deck.mutName(site))
    baseline <- Cards.own(root)
    _ <- IO.foreachDiscard(changed, f => Fs.mkdirs(Fs.join(dir, "src")).flatMap(_ => Fs.write(Fs.join(dir, Fs.join("src", Str.concat(f._1, ".scuzz"))), f._2)))
    props = List.map(changed, f => (Fs.join("src", Str.concat(f._1, ".scuzz")), f._2))
    requestRaw <- Fs.read(Fs.join(root, "build/ide/request.json"))
    request <- Proposal.parse(requestRaw, 1048576)
    _ <- Fs.write(Fs.join(dir, "proposal.json"), Cards.metadata(Proposal.str(request, "request"), Cards.setHash(baseline), "mutation", props))
  } yield ()

def generateProposals(root: String, set: List[(String, String)], cur: String, ls: LaneS, ds: DeckS): IO[Unit] =
  deckGuard(ds, _ => generateProposalsGo(root, Deck.regionSet(set, cur), ls, ds)).flatMap(_ => deckNext(root, ls, ds))

def generateProposalsGo(root: String, set: List[(String, String)], ls: LaneS, ds: DeckS): IO[Unit] =
  for {
    _ = Signal.set(ls.status, ["generating proposals"])
    sites = Deck.genCount(set)
    kept = Mutate.parseLive(set)
    seed <- Random.nextInt(1000000)
    _ <- IO.foreachDiscard(Mutate.pickSites(seed, if (sites > 8) 8 else sites, sites), s => writeMutant(root, kept, set, s))
  } yield ()

def loadDelta(root: String, status: Signal[List[String]], raw: Signal[String], rev: Signal[String], works: Signal[List[String]], tls: Signal[List[String]], blab: Signal[String]): IO[Unit] =
  loadLanes(root, "delta", status, raw, rev, works, tls, blab)

def loadIde(root: String, status: Signal[List[String]], raw: Signal[String], rev: Signal[String], works: Signal[List[String]], tls: Signal[List[String]], blab: Signal[String]): IO[Unit] =
  loadLanes(root, "ide", status, raw, rev, works, tls, blab)

def loadLanes(root: String, sub: String, status: Signal[List[String]], raw: Signal[String], rev: Signal[String], works: Signal[List[String]], tls: Signal[List[String]], blab: Signal[String]): IO[Unit] =
  for {
    text <- Chrome.readOr(Lanes.reportPathAt(root, sub))
    j = LspClient.parseJson(text)
    texts <- IO.foreach(Lanes.workFiles(j), name => Chrome.readOr(Lanes.fileAt(root, sub, name)))
    _ = Signal.set(raw, text)
    _ = Signal.set(status, if (Str.isEmpty(text)) [] else Lanes.statusLines(j))
    _ = Signal.set(rev, Lanes.revLabel(j))
    _ = Signal.set(blab, Lanes.bLabel(sub))
    _ = Signal.set(tls, texts)
    _ = Signal.set(works, List.map(Lanes.workItems(j), w => Lanes.workLabel(w)))
  } yield ()

def showStep(step: Signal[Int], title: Signal[String], rowsA: Signal[List[String]], rowsB: Signal[List[String]], viewA: Signal[List[String]], viewB: Signal[List[String]], a: List[String], b: List[String], i: Int): Unit =
  for {
    _ = Signal.set(step, i)
    _ = Signal.set(title, Lanes.stepTitle(a, b, i))
    _ = Signal.set(rowsA, Lanes.stepRows(a, b, i, true))
    _ = Signal.set(rowsB, Lanes.stepRows(a, b, i, false))
    _ = Signal.set(viewA, Lanes.a11yLines(Lanes.stateAt(a, i)))
    _ = Signal.set(viewB, Lanes.a11yLines(Lanes.stateAt(b, i)))
  } yield ()

def playTick(playOn: Signal[Int], rail: Signal[List[String]], step: Signal[Int], stepTitle: Signal[String], rowsA: Signal[List[String]], rowsB: Signal[List[String]], viewA: Signal[List[String]], viewB: Signal[List[String]], laneA: Signal[List[String]], laneB: Signal[List[String]]): IO[Unit] =
  for {
    _ <- IO.sleep(400)
    n = List.len(Signal.get(rail))
    _ <- if (n <= 1 || Signal.get(playOn) == 0) IO.pure(()) else IO.pure(showStep(step, stepTitle, rowsA, rowsB, viewA, viewB, Signal.get(laneA), Signal.get(laneB), (Signal.get(step) + 1) % n))
  } yield ()

def showWork(w: String, raw: String, tls: List[String], works: List[String], laneA: Signal[List[String]], laneB: Signal[List[String]], rail: Signal[List[String]], step: Signal[Int], stepTitle: Signal[String], rowsA: Signal[List[String]], rowsB: Signal[List[String]], viewA: Signal[List[String]], viewB: Signal[List[String]], play: Signal[Int], selected: Signal[String], resultA: Signal[String], resultB: Signal[String], flip: Signal[Int]): Unit =
  for {
    _ = Signal.set(play, 0)
    _ = Signal.set(selected, w)
    i = List.indexOf(works, w)
    item = Lanes.workAt(LspClient.parseJson(raw), w)
    a = Lanes.states(Lanes.laneText(tls, i, true))
    b = Lanes.states(Lanes.laneText(tls, i, false))
    _ = Signal.set(resultA, Lanes.resultLine(item, if (Signal.get(flip) == 0) "a" else "b"))
    _ = Signal.set(resultB, Lanes.resultLine(item, if (Signal.get(flip) == 0) "b" else "a"))
    _ = Signal.set(laneA, a)
    _ = Signal.set(laneB, b)
    _ = Signal.set(rail, Lanes.railLabels(a, b))
    _ = showStep(step, stepTitle, rowsA, rowsB, viewA, viewB, a, b, Lanes.usefulStep(item, a, b))
  } yield ()

def stopOwned(fuzzPid: Signal[Int], diffPid: Signal[Int]): IO[Unit] =
  IO.foreachDiscard([Signal.get(fuzzPid), Signal.get(diffPid)], pid => if (pid == 0) IO.pure(()) else Sys.kill(pid).handleErrorWith(_ => IO.pure(())))

def startFuzz(root: String): IO[Int] =
  Sys.spawn(Str.concat("scuzz fuzz --iterations 0 ", root)).handleErrorWith(_ => IO.pure(0))

def fuzzAlive(pid: Int): IO[Int] =
  Sys.alive(pid).handleErrorWith(_ => IO.pure(0))

def loadFuzzMaps(root: String): IO[(List[String], List[String])] =
  for {
    somDec <- Chrome.readOr(Chrome.declaredPath(root, "sometimes.declared"))
    trigDec <- Chrome.readOr(Chrome.declaredPath(root, "triggers.declared"))
    somDump <- Chrome.readOr(Chrome.fuzzFile(root, "sometimes.dump"))
    trigDump <- Chrome.readOr(Chrome.fuzzFile(root, "triggers.dump"))
  } yield (Chrome.chipRows(Chrome.nonEmptyLines(somDec), Chrome.nonEmptyLines(somDump)), Chrome.chipRows(Chrome.nonEmptyLines(trigDec), Chrome.triggerHitNames(trigDump)))

def loadFuzzStatus(root: String): IO[List[String]] =
  Chrome.readOr(Chrome.fuzzFile(root, "summary.json")).map(raw => Chrome.statusLines(raw))

def loadClaimNames(root: String, rels: List[String]): IO[List[String]] =
  IO.foreach(rels, rel => Chrome.readOr(Fs.join(root, rel)).map(src => Chrome.claimNames(src))).map(xss => List.distinct(List.flatten(xss)))

def walkTree(root: String): IO[List[String]] =
  for {
    ents <- Fs.walk(root).handleErrorWith(_ => IO.pure([]))
  } yield List.sort(List.filter(Chrome.filesOf(ents), s => Chrome.keepWalk(s)))

def landmarkRail(page: Signal[Int]): View =
  View.focusGroup(View.wrap(View.choiceChip(page, 0, "Live"), View.choiceChip(page, 1, "Verify"), View.choiceChip(page, 2, "Session"), View.choiceChip(page, 3, "Timeline")))

def landmarkBook(page: Signal[Int], live: View, verify: View, session: View, timeline: View): View =
  View.semantics("Index book", View.column(landmarkRail(page), View.showWhen(page, 0, View.expanded(live)), View.showWhen(page, 1, View.expanded(verify)), View.showWhen(page, 2, View.expanded(session)), View.showWhen(page, 3, View.expanded(timeline))))

def initialPage(): IO[Int] =
  IO.pure(2)

@main def main: IO[Unit] =
  for {
    _ <- Chrome.seedWorkspace()
    args <- Sys.args()
    tomlHit <- Fs.exists("scuzz.toml")
    arg = List.head(args) match {
  case Option.Some(s) => s
  case Option.None => Chrome.defaultArg(tomlHit)
}
    _ = Property.check("review type identity", List.forall(["Int", "String", "Bool", "Unit", "Any", "List[Int]", "(Int, String)", "Int => String"], name => Type.eq(Type.parse(name), Type.parse(name))), true)
    _ = Property.check("rel", Chrome.preferredRel(true, [], []) == Fs.join("src", "Main.scuzz"), true)
    _ = Property.check("stem", Chrome.stemOf("src/Main.scuzz") == "Main", true)
    _ = Property.check("pkg", Chrome.packageName("[package]\nname = \"hello\"\n", "x") == "hello", true)
    _ = Property.check("pkgf", Chrome.packageName("", "hello") == "hello", true)
