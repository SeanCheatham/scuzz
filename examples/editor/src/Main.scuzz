record LaneS(status: Signal[List[String]], raw: Signal[String], rev: Signal[String], blab: Signal[String], works: Signal[List[String]], tls: Signal[List[String]], laneA: Signal[List[String]], laneB: Signal[List[String]], rail: Signal[List[String]], step: Signal[Int], title: Signal[String], rowsA: Signal[List[String]], rowsB: Signal[List[String]], viewA: Signal[List[String]], viewB: Signal[List[String]], srcs: Signal[List[(String, String, String)]])

record DeckS(pending: Signal[List[String]], armed: Signal[String], title: Signal[String], flip: Signal[Int], skipped: Signal[List[String]], last: Signal[String], busy: Signal[Int])

import Parse.Prog

def analyze(path: String, body: String): IO[String] =
  for {
    _ <- Fs.write(path, body)
    start = Fs.dirname(path)
    here <- Fs.canonicalize(start).handleErrorWith(_ => IO.pure(start))
    hit <- Fs.exists(Fs.join(here, "scuzz.toml"))
    parent = Fs.dirname(here)
    up <- Fs.exists(Fs.join(parent, "scuzz.toml"))
    above = Fs.dirname(parent)
    up2 <- Fs.exists(Fs.join(above, "scuzz.toml"))
    root = if (hit) here else if (up) parent else if (up2) above else here
    toml <- Fs.read(Fs.join(root, "scuzz.toml")).handleErrorWith(_ => IO.pure(""))
    ents <- Fs.list(Fs.join(root, "src")).handleErrorWith(_ => IO.pure([]))
    own <- Drive.readSrcFiles(Fs.join(root, "src"), ents)
    files <- Drive.collectDeps(root, Manifest.parse(toml).deps, own).handleErrorWith(_ => IO.pure(own))
  } yield Check.checkFilesOwn(files, Drive.fileStems(own))

def runProject(root: String): IO[String] =
  for {
    got <- Sys.exec(Str.concat("scuzz run ", root)).handleErrorWith(_ => IO.pure((Str.len("x"), "", "run fail")))
  } yield Chrome.captureOut(got._2, got._3)

def startDiff(root: String): IO[Int] =
  for {
    _ <- Fs.mkdirs(Fs.dirname(Lanes.reportPath(root))).handleErrorWith(_ => IO.pure(()))
    _ <- Fs.write(Lanes.reportPath(root), "").handleErrorWith(_ => IO.pure(()))
    pid <- Sys.spawn(Str.concat("scuzz diff ", Lanes.shQuote(root))).handleErrorWith(_ => IO.pure(0))
  } yield pid

def scuzzCli(): IO[String] =
  Sys.getenv("SCUZZ").map(v => if (Str.isEmpty(v)) "scuzz" else v)

def diskFiles(root: String, toml: String): IO[List[(String, String)]] =
  for {
    ents <- Fs.list(Fs.join(root, "src")).handleErrorWith(_ => IO.pure([]))
    own <- Drive.readSrcFiles(Fs.join(root, "src"), ents)
    files <- Drive.collectDeps(root, Manifest.parse(toml).deps, own).handleErrorWith(_ => IO.pure(own))
  } yield files

def compareBuffers(root: String, toml: String, disk: List[(String, String)], buffers: List[(String, String)]): IO[Unit] =
  scuzzCli().flatMap(cli => Diff.reviewSets(root, toml, disk, buffers, 1, cli))

def loadProposals(root: String): IO[List[String]] =
  for {
    ents <- Fs.list(Deck.proposalsDir(root)).handleErrorWith(_ => IO.pure([]))
    raw <- Chrome.readOr(Deck.decisionsPath(root))
  } yield Deck.pending(Deck.propNames(ents), List.map(Chrome.nonEmptyLines(raw), l => Deck.decidedName(l)))

def readProposal(root: String, name: String): IO[List[(String, String)]] =
  for {
    dir = Fs.join(Deck.proposalsDir(root), name)
    ents <- Fs.walk(dir).handleErrorWith(_ => IO.pure([]))
    files <- IO.foreach(List.filter(Chrome.filesOf(ents), f => Str.endsWith(f, ".scuzz")), f => Fs.read(Fs.join(dir, f)).map(src => (f, src)))
  } yield files

def reviewProposal(root: String, toml: String, disk: List[(String, String)], propSet: List[(String, String)]): IO[Unit] =
  scuzzCli().flatMap(cli => Diff.reviewSets(root, toml, disk, propSet, 1, cli))

def recordDecision(root: String, name: String, decision: String, region: String, ha: String, hb: String): IO[Unit] =
  for {
    _ <- Fs.mkdirs(Fs.dirname(Deck.decisionsPath(root))).handleErrorWith(_ => IO.pure(()))
    old <- Chrome.readOr(Deck.decisionsPath(root))
    _ <- Fs.write(Deck.decisionsPath(root), Str.concat(old, Str.concat(Deck.decisionLine(name, decision, region, ha, hb), """
""")))
  } yield ()

def dropProposal(root: String, name: String): IO[Unit] =
  Fs.delete(Fs.join(Deck.proposalsDir(root), name)).handleErrorWith(_ => IO.pure(()))

def verifyFilesOf(root: String): IO[List[String]] =
  Fs.list(root).map(ents => Chrome.verifyFileRels(Chrome.filesOf(ents))).handleErrorWith(_ => IO.pure([]))

def deckGuard(ds: DeckS, io: IO[Unit]): IO[Unit] =
  for {
    busy0 = Signal.get(ds.busy)
    _ <- if (busy0 != 0) IO.sleep(50).flatMap(_ => deckGuard(ds, io)) else IO.pure(Signal.set(ds.busy, 1)).flatMap(_ => IO.ensure(io, IO.pure(Signal.set(ds.busy, 0))))
  } yield ()

def deckEnd(ls: LaneS, ds: DeckS): Unit =
  for {
    _ = Signal.set(ds.armed, "")
    _ = Signal.set(ds.title, "")
    _ = Signal.set(ls.status, Deck.withLast(Signal.get(ds.last), ["no more proposals"]))
    _ = Signal.set(ls.works, []: List[String])
    _ = Signal.set(ls.rail, []: List[String])
    _ = Signal.set(ls.laneA, []: List[String])
    _ = Signal.set(ls.laneB, []: List[String])
    _ = Signal.set(ls.rowsA, []: List[String])
    _ = Signal.set(ls.rowsB, []: List[String])
    _ = Signal.set(ls.viewA, []: List[String])
    _ = Signal.set(ls.viewB, []: List[String])
    _ = Signal.set(ls.srcs, []: List[(String, String, String)])
    _ = Signal.set(ls.title, "")
    _ = Signal.set(ls.rev, "a: HEAD")
    _ = Signal.set(ls.blab, "b: working tree")
  } yield ()

def deckNext(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  deckGuard(ds, deckNextIn(root, [], ls, ds))

def deckNextIn(root: String, region: List[String], ls: LaneS, ds: DeckS): IO[Unit] =
  for {
    toml <- Chrome.readOr(Fs.join(root, "scuzz.toml"))
    left <- loadProposals(root)
    _ = Signal.set(ds.pending, left)
    pick <- deckPick(root, left, region)
    _ <- if (Str.isEmpty(pick)) IO.pure(deckEnd(ls, ds)) else deckShow(root, toml, pick, ls, ds)
  } yield ()

def deckPick(root: String, left: List[String], region: List[String]): IO[String] =
  if (List.isEmpty(left)) IO.pure("") else if (List.isEmpty(region)) IO.pure(List.at(left, 0)) else for {
  regions <- IO.foreach(left, n => readProposal(root, n).map(props => Deck.regionOf(props)))
  hit = List.indexOf(regions, region)
} yield if (hit < 0) List.at(left, 0) else List.at(left, hit)

def deckRandom(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  deckGuard(ds, deckRandomGo(root, ls, ds))

def deckRandomGo(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  for {
    toml <- Chrome.readOr(Fs.join(root, "scuzz.toml"))
    left <- loadProposals(root)
    _ = Signal.set(ds.pending, left)
    i <- Random.nextInt(if (List.isEmpty(left)) 1 else List.len(left))
    _ <- if (List.isEmpty(left)) IO.pure(deckEnd(ls, ds)) else deckShow(root, toml, List.at(left, i % List.len(left)), ls, ds)
  } yield ()

def deckShow(root: String, toml: String, name: String, ls: LaneS, ds: DeckS): IO[Unit] =
  for {
    _ = Signal.set(ls.status, [Str.concat("reviewing ", name)])
    _ = Signal.set(ds.armed, name)
    _ = Signal.set(ds.title, Deck.deckTitle(name))
    disk <- diskFiles(root, toml)
    props <- readProposal(root, name)
    propSet = Deck.applyProposal(disk, props)
    err <- reviewProposal(root, toml, disk, propSet).map(_ => "").handleErrorWith(e => IO.pure(e))
    _ <- if (!Str.isEmpty(err)) IO.pure(Signal.set(ls.status, [err])) else deckReviewed(root, toml, name, disk, propSet, ls, ds)
  } yield ()

def deckReviewed(root: String, toml: String, name: String, disk: List[(String, String)], propSet: List[(String, String)], ls: LaneS, ds: DeckS): IO[Unit] =
  for {
    _ <- loadIde(root, ls.status, ls.raw, ls.rev, ls.works, ls.tls, ls.blab)
    flip <- Random.nextInt(2)
    vers <- verifyFilesOf(root)
    _ = Signal.set(ds.flip, flip)
    _ = Signal.set(ls.srcs, Deck.changedTriples(disk, propSet))
    _ = Signal.set(ls.status, Deck.withLast(Signal.get(ds.last), List.concat(Deck.guardLines(vers), Signal.get(ls.status))))
    _ = Signal.set(ls.rev, "lane 1")
    _ = Signal.set(ls.blab, "lane 2")
    _ = if (flip == 0) () else Signal.set(ls.tls, Deck.swapPairs(Signal.get(ls.tls)))
    _ <- if (Deck.gateFail(Signal.get(ls.raw))) for {
  _ = Signal.set(ds.last, Str.concat("auto-rejected ", Str.concat(name, " (fails check or a claim)")))
  _ <- recordDecision(root, name, "auto-reject", List.join(Deck.regionOf(propSet), ","), Deck.setHash(disk), Deck.setHash(propSet))
  _ <- dropProposal(root, name)
  _ <- deckNextIn(root, Deck.regionOf(propSet), ls, ds)
} yield () else IO.pure(deckArm(ls))
  } yield ()

def deckArm(ls: LaneS): Unit =
  for {
    ws = Signal.get(ls.works)
    _ = if (List.isEmpty(ws)) () else showWork(List.at(ws, 0), Signal.get(ls.raw), Signal.get(ls.tls), ws, ls.laneA, ls.laneB, ls.rail, ls.step, ls.title, ls.rowsA, ls.rowsB, ls.viewA, ls.viewB)
  } yield ()

def keepNext(root: String, ls: LaneS, ds: DeckS, dirties: List[String]): IO[Unit] =
  deckGuard(ds, keepNextGo(root, ls, ds, dirties))

def keepNextGo(root: String, ls: LaneS, ds: DeckS, dirties: List[String]): IO[Unit] =
  for {
    left <- loadProposals(root)
    name = Deck.keepTarget(Signal.get(ds.armed), left)
    _ <- if (Str.isEmpty(name)) deckNextIn(root, [], ls, ds) else for {
  toml <- Chrome.readOr(Fs.join(root, "scuzz.toml"))
  disk <- diskFiles(root, toml)
  props <- readProposal(root, name)
  hits = Deck.dirtyHits(props, dirties)
  _ <- if (List.nonEmpty(hits)) IO.pure(Signal.set(ls.status, Deck.dirtyLines(hits))) else for {
  _ <- IO.foreachDiscard(props, p => Fs.mkdirs(Fs.dirname(Fs.join(root, p._1))).handleErrorWith(_ => IO.pure(())).flatMap(_ => Fs.write(Fs.join(root, p._1), p._2)))
  _ = Signal.set(ds.last, Deck.revealText("kept", name, Deck.laneOf(Signal.get(ds.flip))))
  _ <- recordDecision(root, name, "keep", List.join(Deck.regionOf(props), ","), Deck.setHash(disk), Deck.setHash(Deck.applyProposal(disk, props)))
  _ <- dropProposal(root, name)
  _ <- deckNextIn(root, Deck.regionOf(props), ls, ds)
} yield ()
} yield ()
  } yield ()

def writeMutant(root: String, kept: List[(String, String, Prog)], disk: List[(String, String)], site: Int): IO[Unit] =
  for {
    changed = Deck.changedFiles(disk, Mutate.applyKept(kept, site, false))
    dir = Fs.join(Deck.proposalsDir(root), Deck.mutName(site))
    _ <- IO.foreachDiscard(changed, f => Fs.mkdirs(Fs.join(dir, "src")).flatMap(_ => Fs.write(Fs.join(dir, Fs.join("src", Str.concat(f._1, ".scuzz"))), f._2)))
  } yield ()

def generateProposals(root: String, set: List[(String, String)], cur: String, ls: LaneS, ds: DeckS): IO[Unit] =
  deckGuard(ds, generateProposalsGo(root, Deck.regionSet(set, cur), ls, ds))

def generateProposalsGo(root: String, set: List[(String, String)], ls: LaneS, ds: DeckS): IO[Unit] =
  for {
    _ = Signal.set(ls.status, ["generating proposals"])
    sites = Mutate.countFiles(set, false)
    kept = Mutate.parseLive(set)
    seed <- Random.nextInt(1000000)
    _ <- IO.foreachDiscard(Mutate.pickSites(seed, if (sites > 8) 8 else sites, sites), s => writeMutant(root, kept, set, s))
    _ <- deckNextIn(root, [], ls, ds)
  } yield ()

def rejectNext(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  deckGuard(ds, rejectNextGo(root, ls, ds))

def rejectNextGo(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  for {
    left <- loadProposals(root)
    name = Deck.keepTarget(Signal.get(ds.armed), left)
    _ <- if (Str.isEmpty(name)) deckNextIn(root, [], ls, ds) else for {
  toml <- Chrome.readOr(Fs.join(root, "scuzz.toml"))
  disk <- diskFiles(root, toml)
  props <- readProposal(root, name)
  _ = Signal.set(ds.last, Deck.revealText("rejected", name, Deck.laneOf(Signal.get(ds.flip))))
  _ <- recordDecision(root, name, "reject", List.join(Deck.regionOf(props), ","), Deck.setHash(disk), Deck.setHash(Deck.applyProposal(disk, props)))
  _ <- dropProposal(root, name)
  _ <- deckNextIn(root, Deck.regionOf(props), ls, ds)
} yield ()
  } yield ()

def skipNext(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  deckGuard(ds, skipNextGo(root, ls, ds))

def skipNextGo(root: String, ls: LaneS, ds: DeckS): IO[Unit] =
  for {
    toml <- Chrome.readOr(Fs.join(root, "scuzz.toml"))
    left <- loadProposals(root)
    pick = Deck.skipPick(left, Signal.get(ds.skipped), Deck.keepTarget(Signal.get(ds.armed), left))
    _ = Signal.set(ds.skipped, pick._2)
    _ <- if (Str.isEmpty(pick._1)) IO.pure(deckEnd(ls, ds)) else deckShow(root, toml, pick._1, ls, ds)
  } yield ()

def loadDelta(root: String, status: Signal[List[String]], raw: Signal[String], rev: Signal[String], works: Signal[List[String]], tls: Signal[List[String]], blab: Signal[String]): IO[Unit] =
  loadLanes(root, "delta", status, raw, rev, works, tls, blab)

def loadIde(root: String, status: Signal[List[String]], raw: Signal[String], rev: Signal[String], works: Signal[List[String]], tls: Signal[List[String]], blab: Signal[String]): IO[Unit] =
  loadLanes(root, "ide", status, raw, rev, works, tls, blab)

def loadLanes(root: String, sub: String, status: Signal[List[String]], raw: Signal[String], rev: Signal[String], works: Signal[List[String]], tls: Signal[List[String]], blab: Signal[String]): IO[Unit] =
  for {
    text <- Chrome.readOr(Lanes.reportPathAt(root, sub))
    j = LspClient.parseJson(text)
    texts <- IO.foreach(Lanes.workFiles(j), name => Chrome.readOr(Lanes.fileAt(root, sub, name)))
    _ = Signal.set(raw, text)
    _ = Signal.set(status, if (Str.isEmpty(text)) [] else Lanes.statusLines(j))
    _ = Signal.set(rev, Lanes.revLabel(j))
    _ = Signal.set(blab, Lanes.bLabel(sub))
    _ = Signal.set(tls, texts)
    _ = Signal.set(works, List.map(Lanes.workItems(j), w => Lanes.workLabel(w)))
  } yield ()

def showStep(step: Signal[Int], title: Signal[String], rowsA: Signal[List[String]], rowsB: Signal[List[String]], viewA: Signal[List[String]], viewB: Signal[List[String]], a: List[String], b: List[String], i: Int): Unit =
  for {
    _ = Signal.set(step, i)
    _ = Signal.set(title, Lanes.stepTitle(a, b, i))
    _ = Signal.set(rowsA, Lanes.stepRows(a, b, i, true))
    _ = Signal.set(rowsB, Lanes.stepRows(a, b, i, false))
    _ = Signal.set(viewA, Lanes.a11yLines(Lanes.stateAt(a, i)))
    _ = Signal.set(viewB, Lanes.a11yLines(Lanes.stateAt(b, i)))
  } yield ()

def playTick(playOn: Signal[Int], rail: Signal[List[String]], step: Signal[Int], stepTitle: Signal[String], rowsA: Signal[List[String]], rowsB: Signal[List[String]], viewA: Signal[List[String]], viewB: Signal[List[String]], laneA: Signal[List[String]], laneB: Signal[List[String]]): IO[Unit] =
  for {
    _ <- IO.sleep(400)
    n = List.len(Signal.get(rail))
    _ <- if (n <= 1 || Signal.get(playOn) == 0) IO.pure(()) else IO.pure(showStep(step, stepTitle, rowsA, rowsB, viewA, viewB, Signal.get(laneA), Signal.get(laneB), (Signal.get(step) + 1) % n))
  } yield ()

def showWork(w: String, raw: String, tls: List[String], works: List[String], laneA: Signal[List[String]], laneB: Signal[List[String]], rail: Signal[List[String]], step: Signal[Int], stepTitle: Signal[String], rowsA: Signal[List[String]], rowsB: Signal[List[String]], viewA: Signal[List[String]], viewB: Signal[List[String]]): Unit =
  for {
    i = List.indexOf(works, w)
    item = Lanes.workAt(LspClient.parseJson(raw), w)
    a = Lanes.states(Lanes.laneText(tls, i, true))
    b = Lanes.states(Lanes.laneText(tls, i, false))
    _ = Signal.set(laneA, a)
    _ = Signal.set(laneB, b)
    _ = Signal.set(rail, Lanes.railLabels(a, b))
    _ = showStep(step, stepTitle, rowsA, rowsB, viewA, viewB, a, b, if (Lanes.workFirst(item) < 0) 0 else Lanes.workFirst(item))
  } yield ()

def startFuzz(root: String): IO[Int] =
  Sys.spawn(Str.concat("scuzz fuzz --iterations 0 ", root)).handleErrorWith(_ => IO.pure(0))

def fuzzAlive(pid: Int): IO[Int] =
  Sys.alive(pid).handleErrorWith(_ => IO.pure(0))

def loadFuzzMaps(root: String): IO[(List[String], List[String])] =
  for {
    somDec <- Chrome.readOr(Chrome.declaredPath(root, "sometimes.declared"))
    trigDec <- Chrome.readOr(Chrome.declaredPath(root, "triggers.declared"))
    somDump <- Chrome.readOr(Chrome.fuzzFile(root, "sometimes.dump"))
    trigDump <- Chrome.readOr(Chrome.fuzzFile(root, "triggers.dump"))
  } yield (Chrome.chipRows(Chrome.nonEmptyLines(somDec), Chrome.nonEmptyLines(somDump)), Chrome.chipRows(Chrome.nonEmptyLines(trigDec), Chrome.triggerHitNames(trigDump)))

def loadFuzzStatus(root: String): IO[List[String]] =
  Chrome.readOr(Chrome.fuzzFile(root, "summary.json")).map(raw => Chrome.statusLines(raw))

def loadClaimNames(root: String, rels: List[String]): IO[List[String]] =
  IO.foreach(rels, rel => Chrome.readOr(Fs.join(root, rel)).map(src => Chrome.claimNames(src))).map(xss => List.distinct(List.flatten(xss)))

def walkTree(root: String): IO[List[String]] =
  for {
    ents <- Fs.walk(root).handleErrorWith(_ => IO.pure([]))
  } yield List.sort(List.filter(Chrome.filesOf(ents), s => Chrome.keepWalk(s)))

def landmarkRail(page: Signal[Int]): View =
  View.focusGroup(View.wrap(View.choiceChip(page, 0, "Live"), View.choiceChip(page, 1, "Verify"), View.choiceChip(page, 2, "Session"), View.choiceChip(page, 3, "Timeline")))

def landmarkBook(page: Signal[Int], live: View, verify: View, session: View, timeline: View): View =
  View.semantics("Index book", View.column(landmarkRail(page), View.showWhen(page, 0, View.expanded(live)), View.showWhen(page, 1, View.expanded(verify)), View.showWhen(page, 2, View.expanded(session)), View.showWhen(page, 3, View.expanded(timeline))))

@main def main: IO[Unit] =
  for {
    _ <- Chrome.seedWorkspace()
    args <- Sys.args()
    tomlHit <- Fs.exists("scuzz.toml")
    arg = List.head(args) match {
  case Option.Some(s) => s
  case Option.None => Chrome.defaultArg(tomlHit)
}
    _ = Property.check("rel", Chrome.preferredRel(true, [], []) == Fs.join("src", "Main.scuzz"), true)
    _ = Property.check("stem", Chrome.stemOf("src/Main.scuzz") == "Main", true)
    _ = Property.check("pkg", Chrome.packageName("[package]\nname = \"hello\"\n", "x") == "hello", true)
    _ = Property.check("pkgf", Chrome.packageName("", "hello") == "hello", true)
    _ = Property.check("live", Chrome.liveRels(["src/Main.scuzz", "src/", "a.txt"]) == ["src/Main.scuzz"], true)
    _ = Property.check("ver", Chrome.verifyRels(["chrome.scuzz_verify", "editor.scuzz_scenario", "src/Main.scuzz"]) == ["chrome.scuzz_verify", "editor.scuzz_scenario"], true)
    _ = Property.check("vfile", Chrome.verifyFileRels(["chrome.scuzz_verify", "editor.scuzz_scenario", "src/Main.scuzz"]) == ["chrome.scuzz_verify"], true)
    _ = Property.check("scn", Chrome.scenarioRels(["chrome.scuzz_verify", "editor.scuzz_scenario", "src/Main.scuzz"]) == ["editor.scuzz_scenario"], true)
    _ = Property.check("claim", Chrome.claimNames("""def greetFact(t: Timeline): Verdict =
  Verdict.ok()
""") == ["greetFact"], true)
    _ = Property.check("cnpriv", Chrome.claimNames("private def hide(t: Timeline): Verdict =") == [], true)
    _ = Property.check("cnora", Chrome.claimNames("oracle hidden(n: Int): Bool =") == ["hidden"], true)
    _ = Property.check("defa", Chrome.defaultArg(1) == ".", true)
    _ = Property.check("deft", Chrome.defaultArg(0) == "sample.txt", true)
    _ = Property.check("strip", Chrome.stripUri("file://a") == "a", true)
    _ = Property.check("abs", Chrome.resolvePath("d", "/a") == "/a", true)
    _ = Property.check("res", Chrome.resolvePath("d", "b") == Fs.join("d", "b"), true)
    _ = Property.check("dfile", Diags.diagFile("1:1|a.scuzz|m") == "a.scuzz", true)
    _ = Property.check("dempty", Diags.diagFile("1:1||m") == "", true)
    _ = Property.check("open", Chrome.openPaths(["a"], "b") == ["a", "b"], true)
    _ = Property.check("reopen", Chrome.openPaths(["a"], "a") == ["a"], true)
    _ = Property.check("drop", Chrome.dropAt(["a", "b", "c"], 1) == ["a", "c"], true)
    _ = Property.check("aft", Chrome.afterClose(1, 0, 1) == 0, true)
    _ = Property.check("keep", Chrome.afterClose(0, 0, 1) == 0, true)
    _ = Property.check("tl", Chrome.tabLabel("src/Main.scuzz", "x", "x") == "Main.scuzz", true)
    _ = Property.check("td", Chrome.tabLabel("src/Main.scuzz", "x", "y") == "Main.scuzz *", true)
    _ = Property.check("cl", Chrome.closeLabel("src/Main.scuzz") == "x Main.scuzz", true)
    _ = Property.check("cap", Chrome.captureOut("out", "") == "out", true)
    _ = Property.check("err", Chrome.captureOut("out", "e") == """out
e""", true)
    _ = Property.check("nemp", Chrome.nonEmptyLines("""a

b""") == ["a", "b"], true)
    _ = Property.check("row", Chrome.rowName("tappedPlus\t1") == "tappedPlus", true)
    _ = Property.check("ron", Chrome.rowOn("tappedPlus\t1") == 1, true)
    _ = Property.check("roff", Chrome.rowOn("neverHit\t0") == 0, true)
    _ = Property.check("crows", Chrome.chipRows(["a", "b"], ["a"]) == ["a\t1", "b\t0"], true)
    _ = Property.check("thit", Chrome.triggerHitNames("""claim	outlined:Check	triggered
claim	x	vacuous
""") == ["outlined:Check"], true)
    _ = Property.check("sok", Chrome.statusLines("{\"fuzz\":{\"ok\":true}}") == ["fuzz ok"], true)
    _ = Property.check("sfail", Chrome.statusLines("{\"fuzz\":{\"ok\":false}}") == ["fuzz fail"], true)
    _ = Property.check("sempty", Chrome.statusLines("") == [], true)
    _ = Property.check("find", Chrome.findNextOffset("ababa", "ba", 0) == 1, true)
    _ = Property.check("ins", Chrome.insertAt("ab", 1, "x") == "axb", true)
    _ = Property.check("line", Chrome.lineColAt("""a
bc""", 3)._1 == 1, true)
