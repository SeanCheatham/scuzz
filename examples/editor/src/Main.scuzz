property hasSave: Bool =
  Property.a11yHas("button:Save")

property hasCheck: Bool =
  Property.a11yHas("button:Check")

property hasFind: Bool =
  Property.a11yHas("button:Find")

property hasPalette: Bool =
  Property.a11yHas("button:Palette")

property hasEditor: Bool =
  Property.a11yHas("editor:editor")

property bufNonNeg: Bool =
  Str.len(Property.signalStr(0)) >= 0

property diagNonNeg: Bool =
  Property.signalListLen(5) >= 0

def analyze(path: String, body: String): IO[String] =
  for {
    _ <- Fs.write(path, body)
    start = Fs.dirname(path)
    here <- Fs.canonicalize(start).handleErrorWith(_ =>
  IO.pure(start)
)
    hit <- Fs.exists(Fs.join(here, "scuzz.toml"))
    parent = Fs.dirname(here)
    up <- Fs.exists(Fs.join(parent, "scuzz.toml"))
    above = Fs.dirname(parent)
    up2 <- Fs.exists(Fs.join(above, "scuzz.toml"))
    root = if (hit) here else if (up) parent else if (up2) above else here
    got <- Sys.exec(Str.concat("scuzz check --message-format=json ", root)).handleErrorWith(_ =>
  IO.pure((Str.len("x"), "[]", ""))
)
  } yield if (Str.startsWith(got._2, "[")) got._2 else "[]"

def walkTree(root: String): IO[List[String]] =
  for {
    ents <- Fs.walk(root).handleErrorWith(_ =>
  IO.pure([]: List[(String, Bool)])
)
  } yield List.sort(List.filter(Chrome.filesOf(ents), s => Chrome.keepWalk(s)))

