    _ = Property.check("rowsfirst", Lanes.rowsOf([("a", "1"), ("b", "2")], [("a", "1"), ("b", "3")], false) == [Str.concat("b *", Str.concat(Lanes.nl(), "3")), Str.concat("a", Str.concat(Lanes.nl(), "1"))], true)
    _ = Property.check("sigs", Lanes.shownBody("signals", "[{\"id\":0,\"type\":\"int\",\"name\":\"\",\"value\":1},{\"id\":1,\"type\":\"str\",\"name\":\"label\",\"value\":\"x\"}]") == Str.concat("#0 = 1", Str.concat(Lanes.nl(), "label = \"x\"")), true)
