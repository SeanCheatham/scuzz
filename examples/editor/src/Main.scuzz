def analyze(path: String, body: String): IO[String] =
  for {
    _ <- Fs.write(path, body)
    start = Fs.dirname(path)
    here <- Fs.canonicalize(start).handleErrorWith(_ => IO.pure(start))
    hit <- Fs.exists(Fs.join(here, "scuzz.toml"))
    parent = Fs.dirname(here)
    up <- Fs.exists(Fs.join(parent, "scuzz.toml"))
    above = Fs.dirname(parent)
    up2 <- Fs.exists(Fs.join(above, "scuzz.toml"))
    root = if (hit) here else if (up) parent else if (up2) above else here
    toml <- Fs.read(Fs.join(root, "scuzz.toml")).handleErrorWith(_ => IO.pure(""))
    ents <- Fs.list(Fs.join(root, "src")).handleErrorWith(_ => IO.pure([]))
    own <- Drive.readSrcFiles(Fs.join(root, "src"), ents)
    files <- Drive.collectDeps(root, Manifest.parse(toml).deps, own).handleErrorWith(_ => IO.pure(own))
  } yield Check.checkFilesOwn(files, Drive.fileStems(own))

def runProject(root: String): IO[String] =
  for {
    got <- Sys.exec(Str.concat("scuzz run ", root)).handleErrorWith(_ => IO.pure((Str.len("x"), "", "run fail")))
  } yield Chrome.captureOut(got._2, got._3)

def startDiff(root: String): IO[Int] =
  for {
    _ <- Fs.mkdirs(Fs.dirname(Lanes.reportPath(root))).handleErrorWith(_ => IO.pure(()))
    _ <- Fs.write(Lanes.reportPath(root), "").handleErrorWith(_ => IO.pure(()))
    pid <- Sys.spawn(Str.concat("scuzz diff ", Lanes.shQuote(root))).handleErrorWith(_ => IO.pure(0))
  } yield pid

def loadDelta(root: String, status: Signal[List[String]], raw: Signal[String], rev: Signal[String], works: Signal[List[String]], tls: Signal[List[String]]): IO[Unit] =
  for {
    text <- Chrome.readOr(Lanes.reportPath(root))
    j = LspClient.parseJson(text)
    texts <- IO.foreach(Lanes.workFiles(j), name => Chrome.readOr(Lanes.deltaFile(root, name)))
    _ = Signal.set(raw, text)
    _ = Signal.set(status, if (Str.isEmpty(text)) [] else Lanes.statusLines(j))
    _ = Signal.set(rev, Lanes.revLabel(j))
    _ = Signal.set(tls, texts)
    _ = Signal.set(works, List.map(Lanes.workItems(j), w => Lanes.workLabel(w)))
  } yield ()

def showStep(step: Signal[Int], title: Signal[String], rowsA: Signal[List[String]], rowsB: Signal[List[String]], a: List[String], b: List[String], i: Int): Unit =
  for {
    _ = Signal.set(step, i)
    _ = Signal.set(title, Lanes.stepTitle(a, b, i))
    _ = Signal.set(rowsA, Lanes.stepRows(a, b, i, true))
    _ = Signal.set(rowsB, Lanes.stepRows(a, b, i, false))
  } yield ()

def startFuzz(root: String): IO[Int] =
  Sys.spawn(Str.concat("scuzz fuzz --iterations 0 ", root)).handleErrorWith(_ => IO.pure(0))

def fuzzAlive(pid: Int): IO[Int] =
  Sys.alive(pid).handleErrorWith(_ => IO.pure(0))

def loadFuzzMaps(root: String): IO[(List[String], List[String])] =
  for {
    somDec <- Chrome.readOr(Chrome.declaredPath(root, "sometimes.declared"))
    trigDec <- Chrome.readOr(Chrome.declaredPath(root, "triggers.declared"))
    somDump <- Chrome.readOr(Chrome.fuzzFile(root, "sometimes.dump"))
    trigDump <- Chrome.readOr(Chrome.fuzzFile(root, "triggers.dump"))
  } yield (Chrome.chipRows(Chrome.nonEmptyLines(somDec), Chrome.nonEmptyLines(somDump)), Chrome.chipRows(Chrome.nonEmptyLines(trigDec), Chrome.triggerHitNames(trigDump)))

def loadFuzzStatus(root: String): IO[List[String]] =
  Chrome.readOr(Chrome.fuzzFile(root, "summary.json")).map(raw => Chrome.statusLines(raw))

def loadClaimNames(root: String, rels: List[String]): IO[List[String]] =
  IO.foreach(rels, rel => Chrome.readOr(Fs.join(root, rel)).map(src => Chrome.claimNames(src))).map(xss => List.distinct(List.flatten(xss)))

def walkTree(root: String): IO[List[String]] =
  for {
    ents <- Fs.walk(root).handleErrorWith(_ => IO.pure([]))
  } yield List.sort(List.filter(Chrome.filesOf(ents), s => Chrome.keepWalk(s)))

def landmarkRail(page: Signal[Int]): View =
  View.focusGroup(View.wrap(View.choiceChip(page, 0, "Live"), View.choiceChip(page, 1, "Verify"), View.choiceChip(page, 2, "Session"), View.choiceChip(page, 3, "Timeline")))

def landmarkBook(page: Signal[Int], live: View, verify: View, session: View, timeline: View): View =
  View.semantics("Index book", View.column(landmarkRail(page), View.showWhen(page, 0, View.expanded(live)), View.showWhen(page, 1, View.expanded(verify)), View.showWhen(page, 2, View.expanded(session)), View.showWhen(page, 3, View.expanded(timeline))))

@main def main: IO[Unit] =
  for {
    _ <- Chrome.seedWorkspace()
    args <- Sys.args()
    tomlHit <- Fs.exists("scuzz.toml")
    arg = List.head(args) match {
  case Option.Some(s) => s
  case Option.None => Chrome.defaultArg(tomlHit)
}
    _ = Property.check("rel", Chrome.preferredRel(true, [], []) == Fs.join("src", "Main.scuzz"), true)
    _ = Property.check("stem", Chrome.stemOf("src/Main.scuzz") == "Main", true)
    _ = Property.check("pkg", Chrome.packageName("[package]\nname = \"hello\"\n", "x") == "hello", true)
    _ = Property.check("pkgf", Chrome.packageName("", "hello") == "hello", true)
    _ = Property.check("live", Chrome.liveRels(["src/Main.scuzz", "src/", "a.txt"]) == ["src/Main.scuzz"], true)
    _ = Property.check("ver", Chrome.verifyRels(["chrome.scuzz_verify", "editor.scuzz_scenario", "src/Main.scuzz"]) == ["chrome.scuzz_verify", "editor.scuzz_scenario"], true)
    _ = Property.check("vfile", Chrome.verifyFileRels(["chrome.scuzz_verify", "editor.scuzz_scenario", "src/Main.scuzz"]) == ["chrome.scuzz_verify"], true)
    _ = Property.check("scn", Chrome.scenarioRels(["chrome.scuzz_verify", "editor.scuzz_scenario", "src/Main.scuzz"]) == ["editor.scuzz_scenario"], true)
    _ = Property.check("claim", Chrome.claimNames("""def greetFact(t: Timeline): Verdict =
  Verdict.ok()
""") == ["greetFact"], true)
