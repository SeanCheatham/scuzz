property hasSave: Bool =
  Property.a11yHas("button:Save")

property hasCheck: Bool =
  Property.a11yHas("button:Check")

property hasFind: Bool =
  Property.a11yHas("button:Find")

property hasEditor: Bool =
  Property.a11yHas("editor:editor")

property bufNonNeg: Bool =
  Str.len(Property.signalStr(0)) >= 0

property diagNonNeg: Bool =
  Property.signalListLen(5) >= 0

def analyze(path: String, body: String): IO[String] =
  for {
    _ <- Fs.write(path, body)
    start = Fs.dirname(path)
    here <- Fs.canonicalize(start).handleErrorWith(_ =>
  IO.pure(start)
)
    hit <- Fs.exists(Fs.join(here, "scuzz.toml"))
    parent = Fs.dirname(here)
    up <- Fs.exists(Fs.join(parent, "scuzz.toml"))
    above = Fs.dirname(parent)
    up2 <- Fs.exists(Fs.join(above, "scuzz.toml"))
    root = if (hit) here else if (up) parent else if (up2) above else here
    got <- Sys.exec(Str.concat("scuzz check --message-format=json ", root)).handleErrorWith(_ =>
  IO.pure((Str.len("x"), "[]", ""))
)
  } yield if (Str.startsWith(got._2, "[")) got._2 else "[]"

def listDir(dir: String): IO[List[String]] =
  for {
    ents <- Fs.list(dir).handleErrorWith(_ =>
  IO.pure([]: List[(String, Bool)])
)
  } yield List.sort(List.filter(Chrome.filesOf(ents), s => Chrome.keepTree(dir, s)))

@main def main: IO[Unit] =
  for {
    _ <- Chrome.seedWorkspace()
    args <- Sys.args()
    arg = if (List.isEmpty(args)) "sample.txt" else List.head(args)
    _ = Property.check("file", Chrome.openPath("f", Str.len("")) == "f", true)
    _ = Property.check("dir", Chrome.openPath("d", Str.len("x")) == Fs.join("d", "sample.txt"), true)
    argListed <- Fs.list(arg).map(_ => Str.len("x")).handleErrorWith(_ =>
  IO.pure(Str.len(""))
)
    file = Chrome.openPath(arg, argListed)
    root = Fs.dirname(file)
    raw <- Fs.read(file).handleErrorWith(_ =>
  IO.pure("")
)
    names <- listDir(root)
    buf = Signal.str(raw)
    orig = Signal.str(raw)
    pathSig = Signal.str(file)
    dirSig = Signal.str(root)
    dirty = Signal.int(Str.len(""))
    diags = Signal.list([])
    tree = Signal.list(names)
    output = Signal.list([])
    findQ = Signal.str("")
    replQ = Signal.str("")
    frac = Signal.int(28)
    findOpen = Signal.int(Str.len(""))
    compOpen = Signal.int(Str.len(""))
    hoverOpen = Signal.int(Str.len(""))
    hoverTxt = Signal.str("hover stub")
    comps = Signal.list([])
    _ = Lsp.frame("{}")
    _ = Lsp.parseLen(Str.concat("Content-Length: 2", Str.concat(Lsp.headerBreak(), "{}")))
    _ = Property.check("need", Lsp.needLen(Str.len("abcd"), Str.len("xy")) == Str.len("abcdef"), true)
    _ = Property.check("ms", Lsp.msgSlice("aabbcc", Str.len("aa"), Str.len("bb")) == "bb", true)
    _ = Property.check("idm", Check.jsonInt(Check.jsonField(Lsp.takeIfMatch(Json.parse("{\"id\":2}"), Str.len("xy")), "id")) == Str.len("xy"), true)
    _ <- Ui.setTitle(Fs.basename(file))
    _ <- Ui.run(_ => View.split(frac, View.column(View.text("Files"), View.each(tree, s => View.button(s, _ => for {
  dir = Signal.getStr(dirSig)
  next = Chrome.joinChild(dir, s)
  listed <- Fs.list(next).flatMap(_ => IO.pure(Str.len("x"))).handleErrorWith(_ =>
  IO.pure(Str.len(""))
)
  kids <- Fs.list(next).handleErrorWith(_ =>
  IO.pure([]: List[(String, Bool)])
)
  _ <- if (listed == Str.len("x")) for {
  _ = Signal.setStr(dirSig, next)
  _ = Signal.setList(tree, List.sort(List.filter(Chrome.filesOf(kids), s => Chrome.keepTree(next, s))))
  _ <- IO.pure(())
} yield () else for {
  _ = Property.sometimes("tappedTree")
  body <- Fs.read(next).handleErrorWith(_ =>
  IO.pure("")
)
  _ = Signal.setStr(pathSig, next)
  _ = Signal.setStr(buf, body)
  _ = Signal.setStr(orig, body)
  _ = Signal.set(dirty, Str.len(""))
  _ <- Ui.setTitle(Fs.basename(next))
} yield ()
} yield ()))), View.stack(View.column(View.row(View.bindText(pathSig), View.showWhen(dirty, Str.len("x"), View.text("*")), View.button("Save", _ => for {
  _ = Property.sometimes("tappedSave")
  p = Signal.getStr(pathSig)
  _ <- Fs.write(p, Signal.getStr(buf))
  _ = Signal.setStr(orig, Signal.getStr(buf))
  _ = Signal.set(dirty, Str.len(""))
  _ <- Ui.setTitle(Fs.basename(p))
} yield ()), View.button("Check", _ => for {
  _ = Property.sometimes("tappedCheck")
  raw <- analyze(Signal.getStr(pathSig), Signal.getStr(buf))
  j = Json.parse(raw)
  _ <- Ui.setEditorDiagnostics(Check.diagMarks(j))
  _ = Signal.setList(diags, Check.diagRows(j))
} yield ()), View.button("Find", _ => for {
  _ = Property.sometimes("tappedFind")
  _ = Signal.set(findOpen, Str.len("x"))
  _ <- IO.pure(())
} yield ()), View.button("Complete", _ => for {
  _ = Property.sometimes("tappedComplete")
  j <- Lsp.lspCall(Signal.getStr(dirSig), Signal.getStr(pathSig), Signal.getStr(buf), "textDocument/completion").handleErrorWith(_ =>
  IO.pure(Json.Null)
)
  _ = Signal.setList(comps, Lsp.completeLabels(j))
  _ = Signal.set(compOpen, Str.len("x"))
  _ <- IO.pure(())
} yield ()), View.button("Hover", _ => for {
  _ = Property.sometimes("tappedHover")
  j <- Lsp.lspCall(Signal.getStr(dirSig), Signal.getStr(pathSig), Signal.getStr(buf), "textDocument/hover").handleErrorWith(_ =>
  IO.pure(Json.Null)
)
  tok <- Lsp.lspCall(Signal.getStr(dirSig), Signal.getStr(pathSig), Signal.getStr(buf), "textDocument/semanticTokens/full").handleErrorWith(_ =>
  IO.pure(Json.Null)
)
  _ = Signal.setStr(hoverTxt, Lsp.hoverText(j))
  _ = Signal.setList(output, List.append(Signal.getList(output), Str.concat("tok", Str.fromInt(Lsp.tokenCount(tok)))))
  _ = Signal.set(hoverOpen, Str.len("x"))
  _ <- IO.pure(())
} yield ()), View.button("Format", _ => for {
  _ = Property.sometimes("tappedFormat")
  j <- Lsp.lspCall(Signal.getStr(dirSig), Signal.getStr(pathSig), Signal.getStr(buf), "textDocument/formatting").handleErrorWith(_ =>
  IO.pure(Json.Null)
)
  _ = Signal.setStr(buf, Lsp.formatText(j, Signal.getStr(buf)))
  _ = Signal.setList(output, List.append(Signal.getList(output), "fmt"))
  _ <- IO.pure(())
} yield ()), View.button("Def", _ => for {
  j <- Lsp.lspCall(Signal.getStr(dirSig), Signal.getStr(pathSig), Signal.getStr(buf), "textDocument/definition").handleErrorWith(_ =>
  IO.pure(Json.Null)
)
  _ <- Ui.setEditorCaret(Lsp.defLine(j), Lsp.defCol(j))
} yield ()), View.button("Rename", _ => for {
  j <- Lsp.lspCall(Signal.getStr(dirSig), Signal.getStr(pathSig), Signal.getStr(buf), "textDocument/rename").handleErrorWith(_ =>
  IO.pure(Json.Null)
)
  _ = Signal.setStr(buf, Lsp.renameText(j, Signal.getStr(buf)))
  _ <- IO.pure(())
} yield ()), View.button("Fix", _ => for {
  j <- Lsp.lspCall(Signal.getStr(dirSig), Signal.getStr(pathSig), Signal.getStr(buf), "textDocument/codeAction").handleErrorWith(_ =>
  IO.pure(Json.Null)
)
  _ = Signal.setList(output, List.append(Signal.getList(output), Lsp.fixTitle(j)))
  _ <- IO.pure(())
} yield ())), View.expanded(View.editor(buf)), View.each(diags, s => View.button(s, _ => Check.jumpDiag(s))), View.each(output, s => View.text(s))), View.overlay(findOpen, View.column(View.text("Find"), View.textField(findQ, "find"), View.textField(replQ, "repl"), View.button("Next", _ => Ui.setEditorCaret(Str.len("x"), Str.len("x"))), View.button("Replace", _ => for {
  _ = Signal.setStr(buf, Str.replace(Signal.getStr(buf), Signal.getStr(findQ), Signal.getStr(replQ)))
  _ = Signal.set(dirty, Str.len("x"))
  _ <- Ui.setTitle(Str.concat(Fs.basename(Signal.getStr(pathSig)), " *"))
} yield ()))), View.overlay(compOpen, View.column(View.text("complete"), View.each(comps, s => View.button(s, _ => ())))), View.overlay(hoverOpen, View.bindText(hoverTxt))))).require(hasSave).require(hasCheck).require(hasFind).require(hasEditor).require(bufNonNeg).require(diagNonNeg)
  } yield ()
