import Parse.Prog

def proposalsDir(root: String): String =
  Fs.join(Fs.join(root, "build"), "proposals")

def propNames(ents: List[(String, Bool)]): List[String] =
  List.sort(List.map(List.filter(ents, e => e._2), e => e._1))

def setHash(files: List[(String, String)]): String =
  Cards.setHash(files)

def guardLines(vers: List[String]): List[String] =
  if (List.isEmpty(vers)) ["unguarded: no claims"] else []

def revealText(decision: String, name: String, lane: String): String =
  Str.concat(decision, Str.concat(" ", Str.concat(name, Str.concat(" (proposal was ", Str.concat(lane, ")")))))

def withLast(last: String, xs: List[String]): List[String] =
  if (Str.isEmpty(last)) xs else last :: xs

def swapPairs(xs: List[String]): List[String] =
  if (List.len(xs) < 2) xs else List.concat(List.at(xs, 1) :: List.at(xs, 0) :: [], swapPairs(List.drop(xs, 2)))

def applyProposal(disk: List[(String, String)], props: List[(String, String)]): List[(String, String)] =
  List.concat(List.map(disk, f => (f._1, propBody(f._1, f._2, props))), newStems(disk, props))

def propStems(props: List[(String, String)]): List[String] =
  List.map(props, p => Chrome.stemOf(p._1))

def propBody(stem: String, src: String, props: List[(String, String)]): String =
  if (List.contains(propStems(props), stem)) List.at(props, List.indexOf(propStems(props), stem))._2 else src

def newStems(disk: List[(String, String)], props: List[(String, String)]): List[(String, String)] =
  List.map(List.filter(props, p => !List.contains(List.map(disk, f => f._1), Chrome.stemOf(p._1))), p => (Chrome.stemOf(p._1), p._2))

def deckTitle(name: String): String =
  "Behavior review"

def regionOf(props: List[(String, String)]): List[String] =
  List.sort(List.distinct(List.map(props, p => Chrome.stemOf(p._1))))

def dirtyLines(hits: List[String]): List[String] =
  List.map(hits, s => Str.concat("dirty buffer: ", s))

def mutName(site: Int): String =
  Str.concat("m", Str.fromInt(site))

def changedFiles(disk: List[(String, String)], mutant: List[(String, String)]): List[(String, String)] =
  List.filter(mutant, f => List.getOrElse(List.map(disk, d => d._2), List.indexOf(List.map(disk, d => d._1), f._1), "") != f._2)

def mutOut(src: String, site: Int): String =
  List.at(genApply(Mutate.parseLive([("Main", src)]), site), 0)._2

def genCount(set: List[(String, String)]): Int =
  Mutate.countFiles(set, false) + Mutate.extFiles(set, false)

def genApply(kept: List[(String, String, Prog)], site: Int): List[(String, String)] =
  if (site < Mutate.countKept(kept, false)) Mutate.applyKept(kept, site, false) else Mutate.extApply(kept, site - Mutate.countKept(kept, false), false)

def changedTriples(disk: List[(String, String)], propSet: List[(String, String)]): List[(String, String, String)] =
  List.map(changedFiles(disk, propSet), f => (f._1, List.getOrElse(List.map(disk, d => d._2), List.indexOf(List.map(disk, d => d._1), f._1), ""), f._2))

def regionSet(set: List[(String, String)], cur: String): List[(String, String)] =
  if (Mutate.countFiles(List.filter(set, f => f._1 == cur), false) > 0) List.filter(set, f => f._1 == cur) else set

