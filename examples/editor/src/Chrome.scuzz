def filesOf(ents: List[(String, Bool)]): List[String] =
  List.map(ents, e => Property.check("enc", Str.len(e._1) > 0, if (e._2) Str.concat(e._1, "/") else e._1))

def joinChild(dir: String, label: String): String =
  Fs.join(dir, Str.stripSuffix(label, "/"))

def scuzzNames(ents: List[(String, Bool)]): List[String] =
  List.filter(filesOf(ents), s => Str.endsWith(s, ".scuzz"))

def preferredRel(hasMain: Bool, srcHits: List[String], topHits: List[String]): String =
  if (hasMain) Fs.join("src", "Main.scuzz") else if (List.nonEmpty(srcHits)) Fs.join("src", List.head(srcHits)) else if (List.nonEmpty(topHits)) List.head(topHits) else Fs.join("src", "Main.scuzz")

def pickSource(dir: String): IO[String] =
  for {
    main = Fs.join(dir, Fs.join("src", "Main.scuzz"))
    hasMain <- Fs.exists(main)
    srcEnts <- Fs.list(Fs.join(dir, "src")).handleErrorWith(_ =>
  IO.pure([]: List[(String, Bool)])
)
    srcHits = scuzzNames(srcEnts)
    topEnts <- Fs.list(dir).handleErrorWith(_ =>
  IO.pure([]: List[(String, Bool)])
)
    topHits = scuzzNames(topEnts)
  } yield Fs.join(dir, preferredRel(hasMain, srcHits, topHits))

def openBuffer(arg: String, isDir: Int): IO[String] =
  if (isDir == 0) IO.pure(arg) else pickSource(arg)

def stripUri(s: String): String =
  if (Str.startsWith(s, "file://")) Str.drop(s, Str.len("file://")) else s

def resolvePath(dir: String, rel: String): String =
  stripUri(rel) match {
    case raw => if (Str.startsWith(raw, "/")) raw else Fs.join(dir, raw)
  }

def keepPart(p: String): Bool =
  p != "" && !Str.startsWith(p, ".") && p != "corpus" && p != "goldens" && p != "build"

def keepWalk(s: String): Bool =
  Property.check("walk", Str.len(s) > 0, List.forall(Str.split(Str.stripSuffix(s, "/"), "/"), p => keepPart(p)))

def parts(path: String): List[String] =
  List.filter(Str.split(Str.stripSuffix(path, "/"), "/"), p => p != "")

def treeLabel(path: String): String =
  if (List.isEmpty(parts(path))) path else Str.concat(Str.repeat("    ", List.len(parts(path)) - 1), Str.concat(Fs.basename(Str.stripSuffix(path, "/")), if (Str.endsWith(path, "/")) "/" else ""))

def flagNonEmpty(xs: List[String]): Int =
  if (List.len(xs) > 0) 1 else 0

def parentRel(path: String): String =
  if (Fs.dirname(Str.stripSuffix(path, "/")) == "." || Fs.dirname(Str.stripSuffix(path, "/")) == "" || Fs.dirname(Str.stripSuffix(path, "/")) == "/") "" else Str.concat(Fs.dirname(Str.stripSuffix(path, "/")), "/")

def isVisible(path: String, open: List[String]): Bool =
  parentRel(path) == "" || List.contains(open, parentRel(path))

def flatten(ents: List[String], open: List[String]): List[String] =
  List.filter(ents, s => isVisible(s, open))

def toggleOpen(open: List[String], path: String): List[String] =
  if (List.contains(open, path)) List.filter(open, s => !Str.startsWith(s, path)) else List.append(open, path)

def seedWorkspace(): IO[Unit] =
  for {
    _ <- Fs.mkdirs("src").handleErrorWith(_ =>
  IO.pure(())
)
    _ <- Fs.read("sample.txt").flatMap(_ => IO.pure(())).handleErrorWith(_ =>
  Fs.write("sample.txt", """hello
world
""")
)
    _ <- Fs.read("scuzz.toml").flatMap(_ => IO.pure(())).handleErrorWith(_ =>
  Fs.write("scuzz.toml", "")
)
  } yield ()

def dirtyFlag(body: String, orig: String): Int =
  if (body == orig) 0 else 1

def tabLabel(path: String, body: String, orig: String): String =
  if (body == orig) Fs.basename(path) else Str.concat(Fs.basename(path), " *")

def closeLabel(path: String): String =
  Str.concat("x ", Fs.basename(path))

def openPaths(paths: List[String], path: String): List[String] =
  if (List.contains(paths, path)) paths else List.append(paths, path)

def dropAt(xs: List[String], i: Int): List[String] =
  List.concat(List.take(xs, i), List.drop(xs, i + 1))

def afterClose(idx: Int, closed: Int, n: Int): Int =
  if (n <= 0) 0 else if (closed < idx) idx - 1 else if (idx >= n) n - 1 else idx

def liveSlot(slots: List[String], paths: List[String], path: String, curPath: String, curVal: String): String =
  if (path == curPath) curVal else List.getOrElse(slots, List.indexOf(paths, path), curVal)

def captureOut(stdout: String, stderr: String): String =
  if (Str.isEmpty(stderr)) stdout else if (Str.isEmpty(stdout)) stderr else Str.concat(stdout, Str.concat("""
""", stderr))

def takeTab(ps: List[String], bs: List[String], os: List[String], i: Int): (List[String], List[String], List[String], Int, String, String, Int) =
  (ps, bs, os, i, List.at(bs, i), List.at(os, i), dirtyFlag(List.at(bs, i), List.at(os, i)))

def loadTab(ps: List[String], bs: List[String], os: List[String], dest: String): (List[String], List[String], List[String], Int, String, String, Int) =
  takeTab(ps, bs, os, List.indexOf(ps, dest))

def applyOpen(paths: List[String], bodies: List[String], origs: List[String], idx: Int, curBody: String, curOrig: String, dest: String, destBody: String): (List[String], List[String], List[String], Int, String, String, Int) =
  loadTab(if (List.contains(paths, dest)) paths else List.append(paths, dest), if (List.contains(paths, dest)) List.setAt(bodies, idx, curBody) else List.append(List.setAt(bodies, idx, curBody), destBody), if (List.contains(paths, dest)) List.setAt(origs, idx, curOrig) else List.append(List.setAt(origs, idx, curOrig), destBody), dest)

def dropTab(paths: List[String], bodies: List[String], origs: List[String], idx: Int, closed: Int): (List[String], List[String], List[String], Int, String, String, Int) =
  if (closed < 0) takeTab(paths, bodies, origs, idx) else takeTab(dropAt(paths, closed), dropAt(bodies, closed), dropAt(origs, closed), afterClose(idx, closed, List.len(paths) - 1))

def applyClose(paths: List[String], bodies: List[String], origs: List[String], idx: Int, curBody: String, curOrig: String, dest: String): (List[String], List[String], List[String], Int, String, String, Int) =
  if (List.len(paths) <= 1) takeTab(paths, List.setAt(bodies, idx, curBody), List.setAt(origs, idx, curOrig), idx) else dropTab(paths, List.setAt(bodies, idx, curBody), List.setAt(origs, idx, curOrig), idx, List.indexOf(paths, dest))

def writeDirty(paths: List[String], bodies: List[String], origs: List[String]): IO[List[String]] =
  IO.foreach(List.indices(paths), i => if (List.at(bodies, i) == List.at(origs, i)) IO.pure(List.at(origs, i)) else Fs.write(List.at(paths, i), List.at(bodies, i)).map(_ => List.at(bodies, i)))

def lineColFromLines(rows: List[String]): (Int, Int) =
  if (List.isEmpty(rows)) (0, 0) else (List.len(rows) - 1, Str.len(List.at(rows, List.len(rows) - 1)))

def lineColAt(body: String, off: Int): (Int, Int) =
  lineColFromLines(Str.lines(Str.take(body, if (off < 0) 0 else off)))

def findNextOffset(body: String, needle: String, start: Int): Int =
  if (Str.isEmpty(needle)) start else if (Str.indexOf(Str.drop(body, if (start < 0) 0 else start), needle) < 0) -1 else start + Str.indexOf(Str.drop(body, if (start < 0) 0 else start), needle)

def pollTab(path: String, body: String, orig: String, dirty: Int): IO[(String, String, Int)] =
  if (dirty != 0) IO.pure((body, orig, 0)) else Fs.read(path).map(disk => if (disk == orig) (body, orig, 0) else (disk, disk, 1)).handleErrorWith(_ =>
  IO.pure((body, orig, 0))
)

def pollTabs(paths: List[String], bodies: List[String], origs: List[String], idx: Int, curBody: String, curOrig: String): IO[(List[String], List[String], Int)] =
  IO.foreach(List.indices(paths), i => pollTab(List.at(paths, i), if (i == idx) curBody else List.at(bodies, i), if (i == idx) curOrig else List.at(origs, i), if (i == idx) dirtyFlag(curBody, curOrig) else dirtyFlag(List.at(bodies, i), List.at(origs, i)))).map(rows => (List.map(rows, r => r._1), List.map(rows, r => r._2), if (List.exists(rows, r => r._3 == 1)) 1 else 0))

