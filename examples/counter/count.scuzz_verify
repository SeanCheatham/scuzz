def plusVisible(t: Timeline): Verdict =
  Verdict.alwaysHas(t, "button:+1")

def simTitleVisible(t: Timeline): Verdict =
  Verdict.alwaysHas(t, "text:SimCounter")

def neverCountNegOne(t: Timeline): Verdict =
  Verdict.every(t, i => !Timeline.a11yHas(t, i, "text:count = -1"))

def afterPlusShowsOne(t: Timeline): Verdict =
  Verdict.afterHit(t, "button:+1", "text:count = 1")

def countStaysNonNeg(t: Timeline): Verdict =
  Verdict.every(t, i => Timeline.signalInt(t, i, "count") >= 0)

def countMatchesAcrossSchedules(a: Timeline, b: Timeline): Verdict =
  if (Timeline.signalInt(a, Timeline.len(a) - 1, "count") == Timeline.signalInt(b, Timeline.len(b) - 1, "count")) Verdict.ok() else Verdict.fail(0, "final count differs across schedules")
