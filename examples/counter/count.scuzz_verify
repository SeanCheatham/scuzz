private def alwaysHas(t: Timeline, needle: String): Bool =
  Timeline.forall(t, i => Timeline.a11yHas(t, i, needle))

private def afterHitShows(t: Timeline, hit: String, needle: String): Bool =
  !Timeline.exists(t, i => Timeline.lastHitHas(t, i, hit)) || Timeline.exists(t, i => Timeline.lastHitHas(t, i, hit) && Timeline.exists(t, j => j >= i && Timeline.a11yHas(t, j, needle)))

def plusVisible(t: Timeline): Bool =
  alwaysHas(t, "button:+1")

def simTitleVisible(t: Timeline): Bool =
  alwaysHas(t, "text:SimCounter")

def neverCountNegOne(t: Timeline): Bool =
  Timeline.forall(t, i => !Timeline.a11yHas(t, i, "text:count = -1"))

def afterPlusShowsOne(t: Timeline): Bool =
  afterHitShows(t, "button:+1", "text:count = 1")

def countStaysNonNeg(t: Timeline): Bool =
  Timeline.forall(t, i => Timeline.signalInt(t, i, 0) >= 0)

