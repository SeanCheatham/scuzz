@main def main: IO[Unit] =
  for {
    count = Signal.int(0)
    label = Signal.map(count, n => countLabel(n))
    root = View.center(View.column(View.background(Color.rgb(230, 240, 248), View.text(counterTitle())), View.bindText(label), View.row(View.minSize(80, 36, View.button("+1", _ => Signal.set(count, Signal.get(count) + 1))), View.sized(32, 32, View.stack(View.image(24, 24, Color.rgb(61, 126, 166), ""), View.positioned(4, 4, View.icon(43, Theme.accent())))))))
    _ <- Ui.run(root)
  } yield ()
