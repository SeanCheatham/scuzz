def setAt(xs: List, i: Int, v: String): List =
  if (List.isEmpty(xs) == 1) List.empty() else if (i == 0) List.cons(v, List.tail(xs)) else List.cons(List.head(xs), setAt(List.tail(xs), i - 1, v))

law listLenNonNeg: Bool =
  Law.signalListLen(1) >= 0

law itemPastEndEmpty: Bool =
  Str.len(Law.signalListAt(1, Law.signalListLen(1))) == 0

law draftNonNeg: Bool =
  Str.len(Law.signalStr(0)) >= 0

law hasAdd: Bool =
  Law.a11yHas("button:Add")

law hasClear: Bool =
  Law.a11yHas("button:Clear")

@main def main: IO[Unit] =
  Sys.getenv("SCUZZ_TODO_PATH").flatMap(envPath =>
    for {
      path = if (Str.len(envPath) == 0) "/tmp/scuzz_todo.txt" else envPath
      draft = Signal.str("")
      items = Signal.list([])
      text <- Fs.read(path).handleErrorWith(_ =>
  IO.pure("")
)
      loaded0 = Str.lines(text)
      loaded = if (List.isEmpty(loaded0) == 1) ["milk"] else loaded0
      _ = Signal.setList(items, loaded)
      _ <- Ui.run(_ => View.column(View.text("Todo"), View.row(View.textField(draft, "item"), View.button("Add", _ => for {
  d = Signal.getStr(draft)
  n = Str.len(d)
} yield if (n == 0) () else for {
  xs = List.append(Signal.getList(items), d)
  _ = Signal.setList(items, xs)
} yield Signal.setStr(draft, "")), View.button("Rename", _ => for {
  xs = Signal.getList(items)
  ys = setAt(xs, 0, "oat milk")
} yield Signal.setList(items, ys))), View.expanded(View.scroll(View.each(items, s => View.row(View.expanded(View.text(s)), View.button("Del", _ => Signal.setList(items, List.filter(Signal.getList(items), x => x != s))))))), View.button("Save", _ => for {
  xs = Signal.getList(items)
  body = if (List.isEmpty(xs) == 1) "" else Str.concat(List.join(xs, "\n"), "\n")
  _ <- Fs.write(path, body)
} yield ()), View.button("Clear", _ => Signal.setList(items, [])))).require(listLenNonNeg).require(itemPastEndEmpty).require(draftNonNeg).require(hasAdd).require(hasClear)
    } yield ()
  )
