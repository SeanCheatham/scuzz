import Eval.Value
import Eval.EvProg

def mount(v: Value, p: EvProg): View =
  v match {
    case Value.VView(kind, args) => mountKind(kind, args, p)
    case Value.VErr(msg) => View.text(msg)
    case _ => View.text(Str.concat("evaluator: not a View: ", Eval.show(v)))
  }

def mountKind(kind: String, args: List[Value], p: EvProg): View =
  if (kind == "View.richText") mountRichText(List.at(args, 0)) else if (kind == "View.theme") mountTheme(List.at(args, 0), viewAt(args, 1, p)) else if (kind == "View.virtualList" || kind == "View.measuredList") mountVirtualList(kind, args, p) else if (kind == "View.adaptive") View.adaptive(intAt(args, 0), viewAt(args, 1, p), viewAt(args, 2, p)) else if (isBox(kind)) mountBox(kind, args, p) else if (kind == "View.grid" || kind == "View.autoGrid") mountGrid(kind, intAt(args, 0), List.tail(args), p) else if (isViewOnly(kind)) mountViewOnly(kind, viewAt(args, 0, p)) else if (isIntView(kind)) mountIntView(kind, intAt(args, 0), viewAt(args, 1, p)) else if (isIntIntView(kind)) mountIntIntView(kind, intAt(args, 0), intAt(args, 1), viewAt(args, 2, p)) else if (isSigIntStr(kind)) mountSigIntStr(kind, sigInt(args, 0), strAt(args, 1)) else if (isSigIntView(kind)) mountSigIntView(kind, sigInt(args, 0), viewAt(args, 1, p)) else if (isTap(kind)) mountTap(kind, strAt(args, 0), List.at(args, 1), p) else mountKind2(kind, args, p)

def mountKind2(kind: String, args: List[Value], p: EvProg): View =
  if (kind == "View.text") View.text(strAt(args, 0)) else if (kind == "View.code") View.code(strAt(args, 0)) else if (kind == "View.avatar") View.avatar(strAt(args, 0)) else if (kind == "View.bindText") View.bindText(sigStr(args, 0)) else if (kind == "View.editor") View.editor(sigStr(args, 0)) else if (kind == "View.textField") View.textField(sigStr(args, 0), strAt(args, 1)) else if (kind == "View.heading") View.heading(intAt(args, 0), viewAt(args, 1, p)) else if (kind == "View.divider") View.divider() else if (kind == "View.verticalDivider") View.verticalDivider() else if (kind == "View.list") View.list() else if (kind == "View.link") View.link(strAt(args, 0), strAt(args, 1)) else if (kind == "View.icon") View.icon(intAt(args, 0), intAt(args, 1)) else if (kind == "View.navTile") View.navTile(intAt(args, 0), strAt(args, 1), strAt(args, 2)) else if (kind == "View.image") mountImage(List.at(args, 0), strAt(args, 1)) else mountKind3(kind, args, p)

def mountKind3(kind: String, args: List[Value], p: EvProg): View =
  if (kind == "View.animatedOpacity") View.animatedOpacity(sigInt(args, 0), intAt(args, 1), viewAt(args, 2, p)) else if (kind == "View.animatedSize") View.animatedSize(sigInt(args, 0), sigInt(args, 1), intAt(args, 2), viewAt(args, 3, p)) else if (kind == "View.animatedPosition") View.animatedPosition(sigInt(args, 0), sigInt(args, 1), intAt(args, 2), viewAt(args, 3, p)) else if (kind == "View.actionText") mountActionText(List.at(args, 0), List.at(args, 1), p) else if (kind == "View.overlay") View.overlay(sigInt(args, 0), strAt(args, 1), viewAt(args, 2, p)) else if (kind == "View.section") View.section(strAt(args, 0), strAt(args, 1), viewAt(args, 2, p)) else if (kind == "View.appShell") View.appShell(viewAt(args, 0, p), viewAt(args, 1, p)) else if (kind == "View.appBar") View.appBar(viewAt(args, 0, p), viewAt(args, 1, p)) else if (kind == "View.radioGroup") View.radioGroup(strAt(args, 0), viewAt(args, 1, p)) else if (kind == "View.semantics") View.semantics(strAt(args, 0), viewAt(args, 1, p)) else if (kind == "View.mergeSemantics") View.mergeSemantics(strAt(args, 0), viewAt(args, 1, p)) else if (kind == "View.tooltip") View.tooltip(strAt(args, 0), viewAt(args, 1, p)) else if (kind == "View.slider") View.slider(sigInt(args, 0), strAt(args, 1), intAt(args, 2), intAt(args, 3), intAt(args, 4)) else if (kind == "View.progress") View.progress(sigInt(args, 0), strAt(args, 1)) else if (kind == "View.circularProgress") View.circularProgress(sigInt(args, 0), strAt(args, 1)) else if (kind == "View.radio") View.radio(sigInt(args, 0), intAt(args, 1), strAt(args, 2)) else if (kind == "View.choiceChip") View.choiceChip(sigInt(args, 0), intAt(args, 1), strAt(args, 2)) else if (kind == "View.radioListTile") View.radioListTile(sigInt(args, 0), intAt(args, 1), strAt(args, 2)) else if (kind == "View.showWhen") View.showWhen(sigInt(args, 0), intAt(args, 1), viewAt(args, 2, p)) else if (kind == "View.split") View.split(sigInt(args, 0), strAt(args, 1), viewAt(args, 2, p), viewAt(args, 3, p)) else if (kind == "View.select") View.select(sigInt(args, 0), strAt(args, 1), Signal.mapN("$mirror", sigVal(List.at(args, 2)), value => List.map(Eval.listOf(value), v => Eval.strOf(v)))) else if (kind == "View.segmented") View.segmented(sigInt(args, 0), strAt(args, 1), List.map(Eval.listOf(List.at(args, 2)), v => Eval.strOf(v))) else if (kind == "View.expansionTile") View.expansionTile(sigInt(args, 0), strAt(args, 1), viewAt(args, 2, p)) else if (kind == "View.onSecondary") View.onSecondary(viewAt(args, 0, p), _ => tap(List.at(args, 1), p)) else if (kind == "View.inkWell") View.inkWell(strAt(args, 0), _ => tap(List.at(args, 1), p), viewAt(args, 2, p)) else if (kind == "View.listTile") View.listTile(strAt(args, 0), viewAt(args, 1, p)) else if (kind == "View.each") mountEach(args, p) else View.text(Str.concat("evaluator: no mount for ", kind))

def isBox(kind: String): Bool =
  kind == "View.column" || kind == "View.row" || kind == "View.stack" || kind == "View.wrap" || kind == "View.breadcrumb"

def mountBox(kind: String, args: List[Value], p: EvProg): View =
  boxOf(kind, List.map(Eval.listOf(List.at(args, 0)), a => mount(a, p)))

def boxOf(kind: String, children: List[View]): View =
  if (kind == "View.column") View.column(children) else if (kind == "View.row") View.row(children) else if (kind == "View.stack") View.stack(children) else if (kind == "View.wrap") View.wrap(children) else View.breadcrumb(children)

def mountGrid(kind: String, cols: Int, args: List[Value], p: EvProg): View =
  gridOf(kind, cols, List.map(Eval.listOf(List.at(args, 0)), a => mount(a, p)))

def gridOf(kind: String, cols: Int, children: List[View]): View =
  if (kind == "View.autoGrid") View.autoGrid(cols, children) else View.grid(cols, children)

def applyClo(f: Value, x: Value, p: EvProg): Value =
  Eval.applyValue(f, x :: [], Eval.envOf(p), p, 0)

def tap(f: Value, p: EvProg): IO[Unit] =
  tapVal(applyClo(f, Value.VUnit, p))

def tapVal(v: Value): IO[Unit] =
  v match {
    case Value.VIo(_) => Eval.evUnit(v)
    case Value.VErr(_) => Eval.evUnit(v)
    case _ => IO.pure(())
  }

def isTap(kind: String): Bool =
  kind == "View.button" || kind == "View.iconButton" || kind == "View.fab" || kind == "View.outlinedButton" || kind == "View.textButton" || kind == "View.actionChip"

def mountTap(kind: String, label: String, f: Value, p: EvProg): View =
  if (kind == "View.button") View.button(label, _ => tap(f, p)) else if (kind == "View.iconButton") View.iconButton(label, _ => tap(f, p)) else if (kind == "View.fab") View.fab(label, _ => tap(f, p)) else if (kind == "View.outlinedButton") View.outlinedButton(label, _ => tap(f, p)) else if (kind == "View.textButton") View.textButton(label, _ => tap(f, p)) else View.actionChip(label, _ => tap(f, p))

def isViewOnly(kind: String): Bool =
  kind == "View.center" || kind == "View.scroll" || kind == "View.scrollH" || kind == "View.card" || kind == "View.placeholder" || kind == "View.unconstrainedBox" || kind == "View.focusGroup" || kind == "View.stretch" || kind == "View.clip" || kind == "View.ellipsis" || kind == "View.ignorePointer" || kind == "View.absorbPointer" || kind == "View.excludeSemantics"

def mountViewOnly(kind: String, v: View): View =
  if (kind == "View.center") View.center(v) else if (kind == "View.scroll") View.scroll(v) else if (kind == "View.scrollH") View.scrollH(v) else if (kind == "View.card") View.card(v) else if (kind == "View.placeholder") View.placeholder(v) else if (kind == "View.unconstrainedBox") View.unconstrainedBox(v) else if (kind == "View.stretch") View.stretch(v) else if (kind == "View.clip") View.clip(v) else if (kind == "View.ellipsis") View.ellipsis(v) else if (kind == "View.ignorePointer") View.ignorePointer(v) else if (kind == "View.absorbPointer") View.absorbPointer(v) else if (kind == "View.excludeSemantics") View.excludeSemantics(v) else View.focusGroup(v)

def isIntView(kind: String): Bool =
  kind == "View.animatedContentSize" || kind == "View.expanded" || kind == "View.background" || kind == "View.padding" || kind == "View.textColor" || kind == "View.fontSize" || kind == "View.opacity" || kind == "View.maxLines" || kind == "View.gap" || kind == "View.radius"

def mountIntView(kind: String, n: Int, v: View): View =
  if (kind == "View.animatedContentSize") View.animatedContentSize(n, v) else if (kind == "View.expanded") View.expanded(n, v) else if (kind == "View.background") View.background(n, v) else if (kind == "View.padding") View.padding(n, v) else if (kind == "View.textColor") View.textColor(n, v) else if (kind == "View.opacity") View.opacity(n, v) else if (kind == "View.maxLines") View.maxLines(n, v) else if (kind == "View.gap") View.gap(n, v) else if (kind == "View.radius") View.radius(n, v) else View.fontSize(n, v)

def isIntIntView(kind: String): Bool =
  kind == "View.minSize" || kind == "View.sized" || kind == "View.positioned" || kind == "View.aspectRatio" || kind == "View.fraction" || kind == "View.maxSize" || kind == "View.align" || kind == "View.border"

def mountIntIntView(kind: String, a: Int, b: Int, v: View): View =
  if (kind == "View.minSize") View.minSize(a, b, v) else if (kind == "View.sized") View.sized(a, b, v) else if (kind == "View.positioned") View.positioned(a, b, v) else if (kind == "View.aspectRatio") View.aspectRatio(a, b, v) else if (kind == "View.fraction") View.fraction(a, b, v) else if (kind == "View.align") View.align(a, b, v) else if (kind == "View.border") View.border(a, b, v) else View.maxSize(a, b, v)

def isSigIntStr(kind: String): Bool =
  kind == "View.checkbox" || kind == "View.switch" || kind == "View.chip" || kind == "View.filterChip" || kind == "View.inputChip" || kind == "View.checkboxListTile" || kind == "View.switchListTile"

def mountSigIntStr(kind: String, s: Signal[Int], label: String): View =
  if (kind == "View.checkbox") View.checkbox(s, label) else if (kind == "View.switch") View.switch(s, label) else if (kind == "View.chip") View.chip(s, label) else if (kind == "View.filterChip") View.filterChip(s, label) else if (kind == "View.inputChip") View.inputChip(s, label) else if (kind == "View.checkboxListTile") View.checkboxListTile(s, label) else View.switchListTile(s, label)

def isSigIntView(kind: String): Bool =
  kind == "View.reducedMotion" || kind == "View.tabs" || kind == "View.indexBook" || kind == "View.badge" || kind == "View.visibility" || kind == "View.offstage"

def mountSigIntView(kind: String, s: Signal[Int], v: View): View =
  if (kind == "View.reducedMotion") View.reducedMotion(s, v) else if (kind == "View.tabs") View.tabs(s, v) else if (kind == "View.indexBook") View.indexBook(s, v) else if (kind == "View.badge") View.badge(s, v) else if (kind == "View.visibility") View.visibility(s, v) else View.offstage(s, v)

def viewAt(args: List[Value], i: Int, p: EvProg): View =
  mount(List.at(args, i), p)

def intAt(args: List[Value], i: Int): Int =
  Eval.intOf(List.at(args, i))

def strAt(args: List[Value], i: Int): String =
  Eval.strOf(List.at(args, i))

def sigInt(args: List[Value], i: Int): Signal[Int] =
  Eval.sigInt(List.at(args, i))

def sigStr(args: List[Value], i: Int): Signal[String] =
  Eval.sigStr(List.at(args, i))

def mountVirtualList(kind: String, args: List[Value], p: EvProg): View =
  for {
    items = Signal.mapN("$mirror", sigVal(List.at(args, 1)), v => Eval.listOf(v))
    key = v => Eval.intOf(applyClo(List.at(args, 2), v, p))
    row = s => mountVirtualRow(s, List.at(args, 3), Eval.withLiveSignals(p))
  } yield if (kind == "View.measuredList") View.measuredList(intAt(args, 0), items, key, row) else View.virtualList(intAt(args, 0), items, key, row)

def mountVirtualRow(item: Signal[Value], render: Value, p: EvProg): View =
  mount(applyClo(render, Eval.sigLiveInput(item), p), p)

def mountEach(args: List[Value], p: EvProg): View =
  View.each(Signal.mapN("$mirror", sigVal(List.at(args, 0)), v => Eval.listOf(v)), v => eachOne(v, cloAt(args), p))

def cloAt(args: List[Value]): Value =
  if (List.len(args) < 2) Value.VUnit else List.at(args, 1)

def eachOne(x: Value, f: Value, p: EvProg): View =
  f match {
    case Value.VUnit => rowPlain(x)
    case _ => mount(applyClo(f, x, p), p)
  }

def rowPlain(x: Value): View =
  x match {
    case Value.VStr(s) => View.text(s)
    case _ => View.text(Eval.show(x))
  }

def sigVal(sv: Value): Signal[Value] =
  sv match {
    case Value.VSig(_, _, s, _, _) => s
    case Value.VLiveSig(s, _, _) => s
    case _ => Signal.make(Value.VList([]))
  }

def mountImage(value: Value, label: String): View =
  value match {
    case Value.VImage(image) => View.image(image, label)
    case _ => View.text("evaluator: invalid image")
  }

def mountTheme(value: Value, child: View): View =
  value match {
    case Value.VTheme(theme) => View.theme(theme, child)
    case _ => View.text("evaluator: invalid theme")
  }

def mountRichText(value: Value): View =
  value match {
    case Value.VText(text) => View.richText(text)
    case _ => View.text("evaluator: invalid text")
  }

def mountActionText(value: Value, action: Value, p: EvProg): View =
  value match {
    case Value.VText(text) => View.actionText(text, key => tapVal(applyClo(action, Value.VInt(key), p)))
    case _ => View.text("evaluator: invalid text")
  }

