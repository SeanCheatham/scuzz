record Walk(e: Expr, n: Int, hi: Int)

record Walks(xs: List[Expr], n: Int, hi: Int)

record FunWalk(ds: List[Fun], n: Int)

record DefSite(stem: String, mod: String, name: String, base: Int, span: Int, hash: Int)

record StoreDef(stem: String, mod: String, name: String, hash: Int, sites: List[(Int, String)])

record MutStore(compiler: String, defs: List[StoreDef])

record ImplWalk(xs: List[Im], n: Int)

record ArmWalk(xs: List[Arm], n: Int, hi: Int)

record BindWalk(xs: List[Bind], n: Int, hi: Int)

import Parse.Expr
import Parse.Fun
import Parse.Prog
import Parse.Arm
import Parse.Bind
import Parse.Param
import Parse.Im

def wrapStem(): String =
  "__verify"

def noInts(): List[Int] =
  []

def noExprs(): List[Expr] =
  []

def live(inO: Bool, o: Bool): Bool =
  if (o) inO else !inO

def progSite(inO: Bool, o: Bool): Bool =
  !o && live(inO, o)

def isOracle(f: String): Bool =
  f == "Property.check" || f == "Property.assert" || f == "Property.force"

def isHandler(f: String): Bool =
  f == "View.button" || f == "View.iconButton" || f == "View.fab" || f == "View.outlinedButton" || f == "View.textButton" || f == "View.actionChip" || f == "View.onSecondary"

def flipRel(op: String): String =
  if (op == "==") "!=" else if (op == "!=") "==" else if (op == "<") ">=" else if (op == "<=") ">" else if (op == ">") "<=" else if (op == ">=") "<" else if (op == "&&") "||" else if (op == "||") "&&" else ""

def flipArith(op: String): String =
  if (op == "+") "-" else if (op == "-") "+" else if (op == "*") "/" else if (op == "/") "*" else if (op == "%") "*" else ""

def binN(op: String): Int =
  if (flipRel(op) != "") if (op == "&&") 3 else 1 else if (flipArith(op) != "") 1 else 0

def remEuclid(a: Int, n: Int): Int =
  if (n <= 0) 0 else remEuclid2(a % n, n)

def remEuclid2(r: Int, n: Int): Int =
  if (r < 0) r + n else r

def lcgSeed(seed: Int): Int =
  remEuclid(seed, 2147483646) + 1

def lcgNext(s: Int): Int =
  remEuclid(s * 48271, 2147483647)

def hasInt(xs: List[Int], n: Int): Bool =
  if (List.isEmpty(xs)) false else hasIntHd(List.at(xs, 0), List.tail(xs), n)

def hasIntHd(h: Int, rest: List[Int], n: Int): Bool =
  h == n || hasInt(rest, n)

def freeSite(i: Int, sites: Int, acc: List[Int]): Int =
  if (i >= sites) 0 else if (hasInt(acc, i)) freeSite(i + 1, sites, acc) else i

def pickSite(seed: Int, i: Int, sites: Int, acc: List[Int]): Int =
  pickSiteGo(lcgSeed(seed + i), 0, sites, acc)

def pickSiteGo(s: Int, tries: Int, sites: Int, acc: List[Int]): Int =
  pickSiteAt(remEuclid(s, sites), s, tries, sites, acc)

def pickSiteAt(site: Int, s: Int, tries: Int, sites: Int, acc: List[Int]): Int =
  if (!hasInt(acc, site)) site else if (tries < 8) pickSiteGo(lcgNext(s), tries + 1, sites, acc) else freeSite(0, sites, acc)

def noKept(): List[(String, String, Prog)] =
  []

def parseLive(files: List[(String, String)]): List[(String, String, Prog)] =
  if (List.isEmpty(files)) noKept() else parseLiveHd(List.at(files, 0), List.tail(files))

def parseLiveHd(h: (String, String), rest: List[(String, String)]): List[(String, String, Prog)] =
  h match {
    case (stem, src) => parseLivePick(stem, src, rest)
  }

def parseLivePick(stem: String, src: String, rest: List[(String, String)]): List[(String, String, Prog)] =
  if (stem == wrapStem()) (stem, src, Parse.emptyProg()) :: parseLive(rest) else (stem, src, Parse.parseFile(stem, src)) :: parseLive(rest)

def keptSrc(kept: List[(String, String, Prog)]): List[(String, String)] =
  if (List.isEmpty(kept)) noFiles() else keptSrcHd(List.at(kept, 0), List.tail(kept))

def keptSrcHd(h: (String, String, Prog), rest: List[(String, String, Prog)]): List[(String, String)] =
  h match {
    case (stem, src, _) => (stem, src) :: keptSrc(rest)
  }

def siteLoc(files: List[(String, String)], site: Int, o: Bool): String =
  siteLocKept(parseLive(files), site, o)

def siteLocKept(kept: List[(String, String, Prog)], site: Int, o: Bool): String =
  siteLocKeptGo(kept, site, 0, o)

def siteLocKeptGo(kept: List[(String, String, Prog)], site: Int, base: Int, o: Bool): String =
  if (List.isEmpty(kept)) Str.concat("site ", Str.fromInt(site)) else siteLocKeptHd(List.at(kept, 0), List.tail(kept), site, base, o)

def siteLocKeptHd(h: (String, String, Prog), rest: List[(String, String, Prog)], site: Int, base: Int, o: Bool): String =
  h match {
    case (stem, _, p) => if (stem == wrapStem()) siteLocKeptGo(rest, site, base, o) else siteLocKeptFile(p, rest, site, base, o)
  }

def siteLocKeptFile(p: Prog, rest: List[(String, String, Prog)], site: Int, base: Int, o: Bool): String =
  siteLocKeptFile2(p, rest, site, base, o, countProg(p, o))

def siteLocKeptFile2(p: Prog, rest: List[(String, String, Prog)], site: Int, base: Int, o: Bool, n: Int): String =
  if (site < base + n) siteLocProg(p, site - base, o) else siteLocKeptGo(rest, site, base + n, o)

def siteLocProg(p: Prog, local: Int, o: Bool): String =
  p match {
    case Prog(_, _, _, _, impls, _, defs, _, body) => siteLocImpls(impls, local, 0, o, siteLocFuns(defs, local, countImpls(impls, 0, o), o, siteLocBody(body, local, countImpls(impls, 0, o) + countFuns(defs, 0, o), o)))
  }

def siteLocBody(body: Expr, local: Int, seen: Int, o: Bool): String =
  if (local < seen + countExpr(body, o)) "body" else ""

def siteLocImpls(xs: List[Im], local: Int, seen: Int, o: Bool, fallback: String): String =
  if (List.isEmpty(xs)) fallback else siteLocImplHd(List.at(xs, 0), List.tail(xs), local, seen, o, fallback)

def siteLocImplHd(im: Im, rest: List[Im], local: Int, seen: Int, o: Bool, fallback: String): String =
  im match {
    case Im(_, _, _, methods) => siteLocFuns(methods, local, seen, o, siteLocImpls(rest, local, countFuns(methods, seen, o), o, fallback))
  }

def siteLocFuns(ds: List[Fun], local: Int, seen: Int, o: Bool, fallback: String): String =
  if (List.isEmpty(ds)) fallback else siteLocFunHd(List.at(ds, 0), List.tail(ds), local, seen, o, fallback)

def siteLocFunHd(d: Fun, rest: List[Fun], local: Int, seen: Int, o: Bool, fallback: String): String =
  d match {
    case Fun(_, _, name, _, _, _, body, mod, off) => if (local < seen + countExpr(body, o)) Str.concat(mod, Str.concat(".", Str.concat(name, Str.concat(":", Str.fromInt(off))))) else siteLocFuns(rest, local, seen + countExpr(body, o), o, fallback)
  }

def pickSites(seed: Int, take: Int, sites: Int): List[Int] =
  if (take <= 0 || sites <= 0) noInts() else List.reverse(pickSitesGo(seed, if (take < sites) take else sites, sites, 0, noInts()))

def pickSitesGo(seed: Int, take: Int, sites: Int, i: Int, acc: List[Int]): List[Int] =
  if (i >= take) acc else pickSitesGo(seed, take, sites, i + 1, pickSite(seed, i, sites, acc) :: acc)

def countFiles(files: List[(String, String)], o: Bool): Int =
  countKept(parseLive(files), o)

def countKept(kept: List[(String, String, Prog)], o: Bool): Int =
  if (List.isEmpty(kept)) 0 else countKeptHd(List.at(kept, 0), List.tail(kept), o)

def countKeptHd(h: (String, String, Prog), rest: List[(String, String, Prog)], o: Bool): Int =
  h match {
    case (stem, _, p) => if (stem == wrapStem()) countKept(rest, o) else countProg(p, o) + countKept(rest, o)
  }

def countProg(p: Prog, o: Bool): Int =
  p match {
    case Prog(_, _, _, _, impls, _, defs, _, body) => countImpls(impls, 0, o) + countFuns(defs, 0, o) + countExpr(body, o)
  }

def countImpls(xs: List[Im], n: Int, o: Bool): Int =
  if (List.isEmpty(xs)) n else countImplsHd(List.at(xs, 0), List.tail(xs), n, o)

def countImplsHd(im: Im, rest: List[Im], n: Int, o: Bool): Int =
  im match {
    case Im(_, _, _, methods) => countImpls(rest, countFuns(methods, n, o), o)
  }

def countFuns(ds: List[Fun], n: Int, o: Bool): Int =
  if (List.isEmpty(ds)) n else countFunsHd(List.at(ds, 0), List.tail(ds), n, o)

def countFunsHd(d: Fun, rest: List[Fun], n: Int, o: Bool): Int =
  d match {
    case Fun(_, _, _, _, _, _, body, _, _) => countFuns(rest, n + countExpr(body, o), o)
  }

def countExpr(e: Expr, o: Bool): Int =
  walk(e, 0 - 1, 0, false, collectHs(e, noExprs()), 0, o).n

def fnvText(s: String): Int =
  fnvGo(s, 0, 1469598103934665603)

def fnvGo(s: String, i: Int, h: Int): Int =
  if (i >= Str.len(s)) h else fnvGo(s, i + 1, (h ^ Str.charAt(s, i)) * 1099511628211)

def defHash(mod: String, name: String, body: Expr): Int =
  fnvText(Str.concat(mod, Str.concat("""
""", Str.concat(name, Str.concat("""
""", Parse.pretty0(body))))))

def defSites(kept: List[(String, String, Prog)], o: Bool): List[DefSite] =
  defSitesGo(kept, 0, o, noDefSites())._2

def noDefSites(): List[DefSite] =
  []

def defSitesGo(kept: List[(String, String, Prog)], base: Int, o: Bool, acc: List[DefSite]): (Int, List[DefSite]) =
  if (List.isEmpty(kept)) (base, List.reverse(acc)) else defSitesHd(List.at(kept, 0), List.tail(kept), base, o, acc)

def defSitesHd(h: (String, String, Prog), rest: List[(String, String, Prog)], base: Int, o: Bool, acc: List[DefSite]): (Int, List[DefSite]) =
  h match {
    case (stem, _, p) => if (stem == wrapStem()) defSitesGo(rest, base, o, acc) else defSitesGo(rest, defSitesProg(stem, p, (base, acc), o)._1, o, defSitesProg(stem, p, (base, acc), o)._2)
  }

def defSitesProg(stem: String, p: Prog, st: (Int, List[DefSite]), o: Bool): (Int, List[DefSite]) =
  p match {
    case Prog(_, _, _, _, impls, _, defs, _, body) => defSitesBody(stem, body, defSitesFuns(stem, defs, defSitesImpls(stem, impls, st, o), o), o)
  }

def defSitesImpls(stem: String, xs: List[Im], st: (Int, List[DefSite]), o: Bool): (Int, List[DefSite]) =
  if (List.isEmpty(xs)) st else defSitesImpls(stem, List.tail(xs), defSitesFuns(stem, List.at(xs, 0).methods, st, o), o)

def defSitesFuns(stem: String, ds: List[Fun], st: (Int, List[DefSite]), o: Bool): (Int, List[DefSite]) =
  if (List.isEmpty(ds)) st else defSitesFuns(stem, List.tail(ds), defSitesFun(stem, List.at(ds, 0), st, o), o)

def defSitesFun(stem: String, d: Fun, st: (Int, List[DefSite]), o: Bool): (Int, List[DefSite]) =
  st match {
    case (base, acc) => (base + countExpr(d.body, o), DefSite(stem, d.mod, d.name, base, countExpr(d.body, o), defHash(d.mod, d.name, d.body)) :: acc)
  }

def defSitesBody(stem: String, body: Expr, st: (Int, List[DefSite]), o: Bool): (Int, List[DefSite]) =
  st match {
    case (base, acc) => (base + countExpr(body, o), DefSite(stem, "", "@body", base, countExpr(body, o), defHash("", "@body", body)) :: acc)
  }

def defSiteOf(ds: List[DefSite], site: Int): List[DefSite] =
  if (List.isEmpty(ds)) noDefSites() else defSiteOfGo(List.at(ds, 0), List.tail(ds), site)

def defSiteOfGo(h: DefSite, rest: List[DefSite], site: Int): List[DefSite] =
  if (site >= h.base && site < h.base + h.span) h :: noDefSites() else defSiteOf(rest, site)

def noStore(): MutStore =
  MutStore("", [])

def storeDefOf(defs: List[StoreDef], stem: String, mod: String, name: String): List[StoreDef] =
  if (List.isEmpty(defs)) [] else storeDefOfGo(List.at(defs, 0), List.tail(defs), stem, mod, name)

def storeDefOfGo(h: StoreDef, rest: List[StoreDef], stem: String, mod: String, name: String): List[StoreDef] =
  if (h.stem == stem && h.mod == mod && h.name == name) h :: [] else storeDefOf(rest, stem, mod, name)

def storeSiteOf(sites: List[(Int, String)], local: Int): String =
  if (List.isEmpty(sites)) "" else storeSiteOfGo(List.at(sites, 0), List.tail(sites), local)

def storeSiteOfGo(h: (Int, String), rest: List[(Int, String)], local: Int): String =
  if (h._1 == local) h._2 else storeSiteOf(rest, local)

def storeReusable(store: MutStore, ds: List[DefSite], site: Int): String =
  storeReusableGo(store.defs, defSiteOf(ds, site), site)

def storeReusableGo(defs: List[StoreDef], hit: List[DefSite], site: Int): String =
  if (List.isEmpty(hit)) "" else storeReusableHd(storeDefOf(defs, List.at(hit, 0).stem, List.at(hit, 0).mod, List.at(hit, 0).name), List.at(hit, 0), site)

def storeReusableHd(found: List[StoreDef], d: DefSite, site: Int): String =
  if (List.isEmpty(found)) "" else storeReusableHash(List.at(found, 0), d, site)

def storeReusableHash(sd: StoreDef, d: DefSite, site: Int): String =
  if (sd.hash != d.hash) "" else storeSiteOf(sd.sites, site - d.base)

def storeChanged(store: MutStore, ds: List[DefSite]): List[Int] =
  if (store.compiler == "") noInts() else storeChangedGo(ds, store.defs, noInts())

def storeChangedGo(ds: List[DefSite], defs: List[StoreDef], acc: List[Int]): List[Int] =
  if (List.isEmpty(ds)) List.reverse(acc) else storeChangedGo(List.tail(ds), defs, storeChangedHd(List.at(ds, 0), storeDefOf(defs, List.at(ds, 0).stem, List.at(ds, 0).mod, List.at(ds, 0).name), acc))

def storeChangedHd(d: DefSite, found: List[StoreDef], acc: List[Int]): List[Int] =
  if (List.isEmpty(found) || List.at(found, 0).hash != d.hash) storeChangedAdd(d, acc) else acc

def storeChangedAdd(d: DefSite, acc: List[Int]): List[Int] =
  storeChangedAddGo(d.base, d.base + d.span, acc)

def storeChangedAddGo(i: Int, end: Int, acc: List[Int]): List[Int] =
  if (i >= end) acc else storeChangedAddGo(i + 1, end, i :: acc)

def storeParse(src: String): MutStore =
  storeParseGo(Verify.linesOf(src), noStore())

def storeParseGo(lines: List[String], acc: MutStore): MutStore =
  if (List.isEmpty(lines)) acc else storeParseHd(List.at(lines, 0), List.tail(lines), acc)

def storeParseHd(line: String, rest: List[String], acc: MutStore): MutStore =
  if (Str.startsWith(line, "compiler ")) storeParseGo(rest, MutStore(Str.drop(line, 9), acc.defs)) else if (Str.startsWith(line, "def ")) storeParseGo(rest, MutStore(acc.compiler, storeParseDef(Str.split(line, " ")) :: acc.defs)) else if (Str.startsWith(line, "site ")) storeParseGo(rest, MutStore(acc.compiler, storeParseSite(Str.split(line, " "), acc.defs))) else storeParseGo(rest, acc)

def storeParseDef(toks: List[String]): StoreDef =
  StoreDef(List.at(toks, 1), List.at(toks, 2), List.at(toks, 3), Str.toInt(List.at(toks, 4), 0), [])

def storeParseSite(toks: List[String], defs: List[StoreDef]): List[StoreDef] =
  if (List.isEmpty(defs)) defs else storeParseSiteHd(List.at(defs, 0), List.tail(defs), toks)

def storeParseSiteHd(d: StoreDef, rest: List[StoreDef], toks: List[String]): List[StoreDef] =
  StoreDef(d.stem, d.mod, d.name, d.hash, List.concat(d.sites, (Str.toInt(List.at(toks, 1), 0), List.at(toks, 2)) :: [])) :: rest

def storeFormat(compiler: String, defs: List[StoreDef]): String =
  Str.concat("""v 1
compiler """, Str.concat(compiler, Str.concat("""
""", storeFormatDefs(defs))))

def storeFormatDefs(defs: List[StoreDef]): String =
  if (List.isEmpty(defs)) "" else Str.concat(storeFormatDef(List.at(defs, 0)), storeFormatDefs(List.tail(defs)))

def storeFormatDef(d: StoreDef): String =
  Str.concat("def ", Str.concat(d.stem, Str.concat(" ", Str.concat(d.mod, Str.concat(" ", Str.concat(d.name, Str.concat(" ", Str.concat(Str.fromInt(d.hash), Str.concat("""
""", storeFormatSites(d.sites))))))))))

def storeFormatSites(sites: List[(Int, String)]): String =
  if (List.isEmpty(sites)) "" else Str.concat("site ", Str.concat(Str.fromInt(List.at(sites, 0)._1), Str.concat(" ", Str.concat(List.at(sites, 0)._2, Str.concat("""
""", storeFormatSites(List.tail(sites)))))))

def storeMerge(ds: List[DefSite], store: MutStore, fresh: List[(Int, String)]): List[StoreDef] =
  storeMergeGo(ds, store.defs, fresh, [])

def storeMergeGo(ds: List[DefSite], defs: List[StoreDef], fresh: List[(Int, String)], acc: List[StoreDef]): List[StoreDef] =
  if (List.isEmpty(ds)) List.reverse(acc) else storeMergeGo(List.tail(ds), defs, fresh, storeMergeDef(List.at(ds, 0), storeDefOf(defs, List.at(ds, 0).stem, List.at(ds, 0).mod, List.at(ds, 0).name), fresh) :: acc)

def storeMergeDef(d: DefSite, found: List[StoreDef], fresh: List[(Int, String)]): StoreDef =
  StoreDef(d.stem, d.mod, d.name, d.hash, storeMergeSites(d.base, d.base + d.span, d.base, if (List.isEmpty(found) || List.at(found, 0).hash != d.hash) [] else List.at(found, 0).sites, fresh, []))

def storeMergeSites(i: Int, end: Int, base: Int, stored: List[(Int, String)], fresh: List[(Int, String)], acc: List[(Int, String)]): List[(Int, String)] =
  if (i >= end) acc else storeMergeSites(i + 1, end, base, stored, fresh, storeMergeOne(i - base, storeSiteOf(fresh, i), storeSiteOf(stored, i - base), acc))

def storeMergeOne(local: Int, got: String, old: String, acc: List[(Int, String)]): List[(Int, String)] =
  if (got != "") List.concat(acc, (local, got) :: []) else if (old != "") List.concat(acc, (local, old) :: []) else acc

def applyFiles(files: List[(String, String)], site: Int, o: Bool): List[(String, String)] =
  applyKept(parseLive(files), site, o)

def applyKept(kept: List[(String, String, Prog)], site: Int, o: Bool): List[(String, String)] =
  applyKeptGo(kept, site, 0, o)

def applyKeptGo(kept: List[(String, String, Prog)], site: Int, base: Int, o: Bool): List[(String, String)] =
  if (List.isEmpty(kept)) noFiles() else applyKeptHd(List.at(kept, 0), List.tail(kept), site, base, o)

def applyKeptHd(h: (String, String, Prog), rest: List[(String, String, Prog)], site: Int, base: Int, o: Bool): List[(String, String)] =
  h match {
    case (stem, src, p) => if (stem == wrapStem()) (stem, src) :: applyKeptGo(rest, site, base, o) else applyKeptLive(stem, src, p, rest, site, base, o)
  }

def applyKeptLive(stem: String, src: String, p: Prog, rest: List[(String, String, Prog)], site: Int, base: Int, o: Bool): List[(String, String)] =
  applyKeptLive2(stem, src, p, rest, site, base, o, countProg(p, o))

def applyKeptLive2(stem: String, src: String, p: Prog, rest: List[(String, String, Prog)], site: Int, base: Int, o: Bool, n: Int): List[(String, String)] =
  if (site >= base && site < base + n) (stem, Parse.pretty(applyProg(p, site - base, o))) :: keptSrc(rest) else (stem, src) :: applyKeptGo(rest, site, base + n, o)

def applyProg(p: Prog, site: Int, o: Bool): Prog =
  p match {
    case Prog(pkg, ens, als, trs, impls, imps, defs, main, body) => applyImpls(impls, site, 0, o) match {
  case ImplWalk(ims, n0) => applyFuns(defs, site, n0, o) match {
  case FunWalk(ds, n) => walk(body, site, n, false, collectHs(body, noExprs()), 0, o) match {
  case Walk(b, _, _) => Prog(pkg, ens, als, trs, ims, imps, ds, main, b)
}
}
}
  }

def applyImpls(xs: List[Im], site: Int, seen: Int, o: Bool): ImplWalk =
  if (List.isEmpty(xs)) ImplWalk(Parse.noIm(), seen) else applyImplsHd(List.at(xs, 0), List.tail(xs), site, seen, o)

def applyImplsHd(im: Im, rest: List[Im], site: Int, seen: Int, o: Bool): ImplWalk =
  im match {
    case Im(tn, targs, forTy, methods) => applyFuns(methods, site, seen, o) match {
  case FunWalk(ms, n) => applyImplsRest(Im(tn, targs, forTy, ms), rest, site, n, o)
}
  }

def applyImplsRest(im: Im, rest: List[Im], site: Int, seen: Int, o: Bool): ImplWalk =
  applyImpls(rest, site, seen, o) match {
    case ImplWalk(xs, n) => ImplWalk(im :: xs, n)
  }

def applyFuns(ds: List[Fun], site: Int, seen: Int, o: Bool): FunWalk =
  if (List.isEmpty(ds)) FunWalk(Parse.noFun(), seen) else applyFunsHd(List.at(ds, 0), List.tail(ds), site, seen, o)

def applyFunsHd(d: Fun, rest: List[Fun], site: Int, seen: Int, o: Bool): FunWalk =
  d match {
    case Fun(priv, ora, name, tps, ps, ret, body, mod, off) => applyFunBody(priv, ora, name, tps, ps, ret, body, mod, off, rest, site, seen, o)
  }

def applyFunBody(priv: Bool, ora: Bool, name: String, tps: List[String], ps: List[Param], ret: String, body: Expr, mod: String, off: Int, rest: List[Fun], site: Int, seen: Int, o: Bool): FunWalk =
  walk(body, site, seen, false, collectHs(body, noExprs()), 0, o) match {
    case Walk(b, n, _) => applyFunsRest(Fun(priv, ora, name, tps, ps, ret, b, mod, off), rest, site, n, o)
  }

def applyFunsRest(d: Fun, rest: List[Fun], site: Int, seen: Int, o: Bool): FunWalk =
  applyFuns(rest, site, seen, o) match {
    case FunWalk(ds, n) => FunWalk(d :: ds, n)
  }

def collectHs(e: Expr, acc: List[Expr]): List[Expr] =
  e match {
    case Expr.ECall(f, args, _) => collectHsCall(f, args, acc, e)
    case Expr.EPrint(inner, _) => collectHs(inner, acc)
    case Expr.EMethod(recv, _, args, _) => collectHsList(args, collectHs(recv, acc))
    case Expr.EField(recv, _, _) => collectHs(recv, acc)
    case Expr.EBin(_, l, r, _) => collectHs(r, collectHs(l, acc))
    case Expr.EUn(_, inner, _) => collectHs(inner, acc)
    case Expr.ELam(_, _, body) => collectHs(body, acc)
    case Expr.EIf(c, t, el, _) => collectHs(el, collectHs(t, collectHs(c, acc)))
    case Expr.EMatch(s, arms, _) => collectHsArms(arms, collectHs(s, acc))
    case Expr.EFor(bs, body, _) => collectHs(body, collectHsBinds(bs, acc))
    case Expr.EList(xs) => collectHsList(xs, acc)
    case Expr.ETuple(xs) => collectHsList(xs, acc)
    case Expr.ENamed(_, inner) => collectHs(inner, acc)
    case Expr.EAscribe(inner, _, _) => collectHs(inner, acc)
    case _ => acc
  }

def collectHsCall(f: String, args: List[Expr], acc: List[Expr], _e: Expr): List[Expr] =
  collectHsList(args, if (isHandler(f) && isLamAt(args, 1)) List.concat(acc, handlerBody(args) :: noExprs()) else acc)

def isLamAt(args: List[Expr], i: Int): Bool =
  if (List.len(args) <= i) false else isLam(List.at(args, i))

def isLam(e: Expr): Bool =
  e match {
    case Expr.ELam(_, _, _) => true
    case _ => false
  }

def handlerBody(args: List[Expr]): Expr =
  if (List.len(args) < 2) Expr.EUnit else handlerBodyAt(List.at(args, 1))

def handlerBodyAt(e: Expr): Expr =
  e match {
    case Expr.ELam(_, _, body) => body
    case _ => Expr.EUnit
  }

def collectHsList(xs: List[Expr], acc: List[Expr]): List[Expr] =
  if (List.isEmpty(xs)) acc else collectHsList(List.tail(xs), collectHs(List.at(xs, 0), acc))

def collectHsArms(xs: List[Arm], acc: List[Expr]): List[Expr] =
  if (List.isEmpty(xs)) acc else collectHsArmsHd(List.at(xs, 0), List.tail(xs), acc)

def collectHsArmsHd(a: Arm, rest: List[Arm], acc: List[Expr]): List[Expr] =
  a match {
    case Arm(_, _, body) => collectHsArms(rest, collectHs(body, acc))
  }

def collectHsBinds(xs: List[Bind], acc: List[Expr]): List[Expr] =
  if (List.isEmpty(xs)) acc else collectHsBindsHd(List.at(xs, 0), List.tail(xs), acc)

def collectHsBindsHd(b: Bind, rest: List[Bind], acc: List[Expr]): List[Expr] =
  b match {
    case Bind(_, _, v) => collectHsBinds(rest, collectHs(v, acc))
  }

def walk(e: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  e match {
    case Expr.EInt(k, _) => walkInt(k, target, seen, inO, hi, o)
    case Expr.EBool(b) => walkBool(b, target, seen, inO, hi, o)
    case Expr.EBin(op, l, r, _) => walkBin(op, l, r, target, seen, inO, hs, hi, o)
    case Expr.EIf(c, t, el, off) => walkIf(c, t, el, off, target, seen, inO, hs, hi, o)
    case Expr.ECall(f, args, _) => walkCall(f, args, target, seen, inO, hs, hi, o)
    case Expr.EPrint(inner, _) => walkPrint(inner, target, seen, inO, hs, hi, o)
    case Expr.EMethod(recv, name, args, _) => walkMethod(recv, name, args, target, seen, inO, hs, hi, o)
    case Expr.EField(recv, name, _) => walkField(recv, name, target, seen, inO, hs, hi, o)
    case Expr.EUn(op, inner, off) => walkUn(op, inner, off, target, seen, inO, hs, hi, o)
    case Expr.ELam(p, ty, body) => walkLam(p, ty, body, target, seen, inO, hs, hi, o)
    case Expr.EMatch(s, arms, _) => walkMatch(s, arms, target, seen, inO, hs, hi, o)
    case Expr.EFor(bs, body, _) => walkFor(bs, body, target, seen, inO, hs, hi, o)
    case Expr.EList(xs) => walkListExpr(xs, target, seen, inO, hs, hi, o)
    case Expr.ETuple(xs) => walkTuple(xs, target, seen, inO, hs, hi, o)
    case Expr.ENamed(name, inner) => walkNamed(name, inner, target, seen, inO, hs, hi, o)
    case Expr.EAscribe(inner, ty, off) => walkAscribe(inner, ty, off, target, seen, inO, hs, hi, o)
    case _ => Walk(e, seen, hi)
  }

def walkInt(k: Int, target: Int, seen: Int, inO: Bool, hi: Int, o: Bool): Walk =
  if ((k == 0 || k == 1) && live(inO, o)) Walk(Expr.EInt(if (seen == target) 1 - k else k, 0), seen + 1, hi) else Walk(Expr.EInt(k, 0), seen, hi)

def walkBool(b: Bool, target: Int, seen: Int, inO: Bool, hi: Int, o: Bool): Walk =
  if (live(inO, o)) Walk(Expr.EBool(if (seen == target) !b else b), seen + 1, hi) else Walk(Expr.EBool(b), seen, hi)

def walkBin(op: String, l: Expr, r: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  if (live(inO, o) && binN(op) > 0) walkBinHit(op, l, r, target, seen, inO, hs, hi, o) else walkBinKids(op, l, r, target, seen, inO, hs, hi, o)

def walkBinHit(op: String, l: Expr, r: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(l, target, seen + binN(op), inO, hs, hi, o) match {
    case Walk(l2, n1, h1) => walkBinHitR(op, l2, r, target, seen, inO, hs, n1, h1, o)
  }

def walkBinHitR(op: String, l: Expr, r: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], n1: Int, h1: Int, o: Bool): Walk =
  walk(r, target, n1, inO, hs, h1, o) match {
    case Walk(r2, n2, h2) => Walk(binOut(op, l, r2, target, seen), n2, h2)
  }

def walkBinKids(op: String, l: Expr, r: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(l, target, seen, inO, hs, hi, o) match {
    case Walk(l2, n1, h1) => walkBinKidsR(op, l2, r, target, inO, hs, n1, h1, o)
  }

def walkBinKidsR(op: String, l: Expr, r: Expr, target: Int, inO: Bool, hs: List[Expr], n1: Int, h1: Int, o: Bool): Walk =
  walk(r, target, n1, inO, hs, h1, o) match {
    case Walk(r2, n2, h2) => Walk(Expr.EBin(op, l, r2, 0), n2, h2)
  }

def binOut(op: String, l: Expr, r: Expr, target: Int, seen: Int): Expr =
  if (seen == target && flipRel(op) != "") Expr.EBin(flipRel(op), l, r, 0) else binOut2(op, l, r, target, seen)

def binOut2(op: String, l: Expr, r: Expr, target: Int, seen: Int): Expr =
  if (op == "&&" && seen + 1 == target) l else if (op == "&&" && seen + 2 == target) r else if (seen == target && flipArith(op) != "") Expr.EBin(flipArith(op), l, r, 0) else Expr.EBin(op, l, r, 0)

def walkIf(c: Expr, t: Expr, el: Expr, off: Int, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  if (progSite(inO, o)) walkIfHit(c, t, el, off, target, seen, hs, hi, o) else walkIfKids(c, t, el, off, target, seen, inO, hs, hi, o)

def walkIfHit(c: Expr, t: Expr, el: Expr, off: Int, target: Int, seen: Int, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(c, target, seen + 1, false, hs, hi, o) match {
    case Walk(c2, n1, h1) => walkIfThen(c2, t, el, off, target, seen, n1, h1, hs, o)
  }

def walkIfThen(c: Expr, t: Expr, el: Expr, off: Int, target: Int, seen: Int, n1: Int, h1: Int, hs: List[Expr], o: Bool): Walk =
  walk(t, target, n1, false, hs, h1, o) match {
    case Walk(t2, n2, h2) => walkIfElse(c, t2, el, off, target, seen, n2, h2, hs, o)
  }

def walkIfElse(c: Expr, t: Expr, el: Expr, off: Int, target: Int, seen: Int, n2: Int, h2: Int, hs: List[Expr], o: Bool): Walk =
  walk(el, target, n2, false, hs, h2, o) match {
    case Walk(e2, n3, h3) => Walk(if (seen == target) Expr.EIf(c, e2, t, off) else Expr.EIf(c, t, e2, off), n3, h3)
  }

def walkIfKids(c: Expr, t: Expr, el: Expr, off: Int, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(c, target, seen, inO, hs, hi, o) match {
    case Walk(c2, n1, h1) => walkIfKidsT(c2, t, el, off, target, inO, hs, n1, h1, o)
  }

def walkIfKidsT(c: Expr, t: Expr, el: Expr, off: Int, target: Int, inO: Bool, hs: List[Expr], n1: Int, h1: Int, o: Bool): Walk =
  walk(t, target, n1, inO, hs, h1, o) match {
    case Walk(t2, n2, h2) => walkIfKidsE(c, t2, el, off, target, inO, hs, n2, h2, o)
  }

def walkIfKidsE(c: Expr, t: Expr, el: Expr, off: Int, target: Int, inO: Bool, hs: List[Expr], n2: Int, h2: Int, o: Bool): Walk =
  walk(el, target, n2, inO, hs, h2, o) match {
    case Walk(e2, n3, h3) => Walk(Expr.EIf(c, t, e2, off), n3, h3)
  }

def walkCall(f: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  if (isOracle(f)) walkArgs(args, target, seen, true, hs, hi, o) match {
  case Walks(xs, n, h) => Walk(Expr.ECall(f, xs, 0), n, h)
} else if (f == "Signal.map") walkMap(f, args, target, seen, inO, hs, hi, o) else if (isHandler(f)) walkHandler(f, args, target, seen, inO, hs, hi, o) else walkArgs(args, target, seen, inO, hs, hi, o) match {
  case Walks(xs, n, h) => Walk(Expr.ECall(f, xs, 0), n, h)
}

def walkMap(f: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  if (progSite(inO, o) && mapParam(args) != "") walkMapHit(f, args, target, seen, inO, hs, hi, o, mapParam(args)) else walkArgs(args, target, seen, inO, hs, hi, o) match {
  case Walks(xs, n, h) => Walk(Expr.ECall(f, xs, 0), n, h)
}

def mapParam(args: List[Expr]): String =
  if (List.len(args) != 2) "" else mapParamAt(List.at(args, 1))

def mapParamAt(e: Expr): String =
  e match {
    case Expr.ELam(p, _, _) => if (p == "_") "" else p
    case _ => ""
  }

def walkMapHit(f: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool, p: String): Walk =
  walkArgs(args, target, seen + 1, inO, hs, hi, o) match {
    case Walks(xs, n, h) => Walk(Expr.ECall(f, if (seen == target) mapIdent(xs, p) else xs, 0), n, h)
  }

def mapIdent(args: List[Expr], p: String): List[Expr] =
  if (List.len(args) != 2) args else List.at(args, 0) :: mapIdentLam(List.at(args, 1), p) :: noExprs()

def mapIdentLam(e: Expr, p: String): Expr =
  e match {
    case Expr.ELam(q, ty, _) => Expr.ELam(q, ty, Expr.EVar(p, 0))
    case _ => e
  }

def walkHandler(f: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  if (progSite(inO, o) && List.len(hs) >= 2) walkHandlerHit(f, args, target, seen, inO, hs, hi, o) else walkArgs(args, target, seen, inO, hs, hi, o) match {
  case Walks(xs, n, h) => Walk(Expr.ECall(f, xs, 0), n, h)
}

def walkHandlerHit(f: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walkArgs(args, target, seen + 1, inO, hs, hi + 1, o) match {
    case Walks(xs, n, h) => Walk(Expr.ECall(f, if (seen == target) swapHandler(xs, hs, hi) else xs, 0), n, h)
  }

def swapHandler(args: List[Expr], hs: List[Expr], hi: Int): List[Expr] =
  if (List.len(args) < 2) args else List.at(args, 0) :: swapHandlerLam(List.at(args, 1), nextH(hs, hi)) :: drop2(args)

def drop2(args: List[Expr]): List[Expr] =
  if (List.isEmpty(args) || List.isEmpty(List.tail(args))) noExprs() else List.tail(List.tail(args))

def nextH(hs: List[Expr], hi: Int): Expr =
  List.at(hs, remEuclid(hi + 1, List.len(hs)))

def swapHandlerLam(e: Expr, body: Expr): Expr =
  e match {
    case Expr.ELam(p, ty, _) => Expr.ELam(p, ty, body)
    case _ => e
  }

def walkPrint(inner: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(inner, target, seen, inO, hs, hi, o) match {
    case Walk(e2, n, h) => Walk(Expr.EPrint(e2, 0), n, h)
  }

def walkMethod(recv: Expr, name: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  if (name == "require") walkRequire(recv, args, target, seen, hs, hi, o) else walkMethodGo(recv, name, args, target, seen, inO, hs, hi, o)

def walkRequire(recv: Expr, args: List[Expr], target: Int, seen: Int, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(recv, target, seen, false, hs, hi, o) match {
    case Walk(r2, n1, h1) => walkArgs(args, target, n1, true, hs, h1, o) match {
  case Walks(xs, n2, h2) => Walk(Expr.EMethod(r2, "require", xs, 0), n2, h2)
}
  }

def walkMethodGo(recv: Expr, name: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(recv, target, seen, inO, hs, hi, o) match {
    case Walk(r2, n1, h1) => walkArgs(args, target, n1, inO, hs, h1, o) match {
  case Walks(xs, n2, h2) => Walk(Expr.EMethod(r2, name, xs, 0), n2, h2)
}
  }

def walkField(recv: Expr, name: String, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(recv, target, seen, inO, hs, hi, o) match {
    case Walk(r2, n, h) => Walk(Expr.EField(r2, name, 0), n, h)
  }

def walkUn(op: String, inner: Expr, off: Int, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  if (op == "!" && live(inO, o)) walkUnNot(inner, off, target, seen, inO, hs, hi, o) else walkUnGo(op, inner, off, target, seen, inO, hs, hi, o)

def walkUnNot(inner: Expr, off: Int, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(inner, target, seen + 1, inO, hs, hi, o) match {
    case Walk(e2, n, h) => Walk(if (seen == target) e2 else Expr.EUn("!", e2, off), n, h)
  }

def walkUnGo(op: String, inner: Expr, off: Int, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(inner, target, seen, inO, hs, hi, o) match {
    case Walk(e2, n, h) => Walk(Expr.EUn(op, e2, off), n, h)
  }

def walkLam(p: String, ty: String, body: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(body, target, seen, inO, hs, hi, o) match {
    case Walk(b, n, h) => Walk(Expr.ELam(p, ty, b), n, h)
  }

def walkAscribe(inner: Expr, ty: String, off: Int, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(inner, target, seen, inO, hs, hi, o) match {
    case Walk(e2, n, h) => Walk(Expr.EAscribe(e2, ty, off), n, h)
  }

def walkMatch(s: Expr, arms: List[Arm], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(s, target, seen, inO, hs, hi, o) match {
    case Walk(s2, n1, h1) => walkArms(arms, target, n1, inO, hs, h1, o) match {
  case ArmWalk(xs, n2, h2) => Walk(Expr.EMatch(s2, xs, 0), n2, h2)
}
  }

def walkFor(bs: List[Bind], body: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walkBinds(bs, target, seen, inO, hs, hi, o) match {
    case BindWalk(xs, n1, h1) => walk(body, target, n1, inO, hs, h1, o) match {
  case Walk(b, n2, h2) => Walk(Expr.EFor(xs, b, 0), n2, h2)
}
  }

def walkListExpr(xs: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walkArgs(xs, target, seen, inO, hs, hi, o) match {
    case Walks(ys, n, h) => Walk(Expr.EList(ys), n, h)
  }

def walkTuple(xs: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walkArgs(xs, target, seen, inO, hs, hi, o) match {
    case Walks(ys, n, h) => Walk(Expr.ETuple(ys), n, h)
  }

def walkNamed(name: String, inner: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walk =
  walk(inner, target, seen, inO, hs, hi, o) match {
    case Walk(e2, n, h) => Walk(Expr.ENamed(name, e2), n, h)
  }

def walkArgs(xs: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walks =
  if (List.isEmpty(xs)) Walks(noExprs(), seen, hi) else walkArgsHd(List.at(xs, 0), List.tail(xs), target, seen, inO, hs, hi, o)

def walkArgsHd(h: Expr, rest: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walks =
  walk(h, target, seen, inO, hs, hi, o) match {
    case Walk(e2, n1, h1) => walkArgsRest(e2, rest, target, n1, inO, hs, h1, o)
  }

def walkArgsRest(e: Expr, rest: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): Walks =
  walkArgs(rest, target, seen, inO, hs, hi, o) match {
    case Walks(xs, n, h) => Walks(e :: xs, n, h)
  }

def noArms(): List[Arm] =
  []

def walkArms(xs: List[Arm], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): ArmWalk =
  if (List.isEmpty(xs)) ArmWalk(noArms(), seen, hi) else walkArmsHd(List.at(xs, 0), List.tail(xs), target, seen, inO, hs, hi, o)

def walkArmsHd(a: Arm, rest: List[Arm], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): ArmWalk =
  a match {
    case Arm(pat, g, body) => walk(body, target, seen, inO, hs, hi, o) match {
  case Walk(b, n1, h1) => walkArmsRest(Arm(pat, g, b), rest, target, n1, inO, hs, h1, o)
}
  }

def walkArmsRest(a: Arm, rest: List[Arm], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): ArmWalk =
  walkArms(rest, target, seen, inO, hs, hi, o) match {
    case ArmWalk(xs, n, h) => ArmWalk(a :: xs, n, h)
  }

def noBinds(): List[Bind] =
  []

def walkBinds(xs: List[Bind], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): BindWalk =
  if (List.isEmpty(xs)) BindWalk(noBinds(), seen, hi) else walkBindsHd(List.at(xs, 0), List.tail(xs), target, seen, inO, hs, hi, o)

def walkBindsHd(b: Bind, rest: List[Bind], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): BindWalk =
  b match {
    case Bind(draw, name, v) => walk(v, target, seen, inO, hs, hi, o) match {
  case Walk(v2, n1, h1) => walkBindsRest(Bind(draw, name, v2), rest, target, n1, inO, hs, h1, o)
}
  }

def walkBindsRest(b: Bind, rest: List[Bind], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, o: Bool): BindWalk =
  walkBinds(rest, target, seen, inO, hs, hi, o) match {
    case BindWalk(xs, n, h) => BindWalk(b :: xs, n, h)
  }

def fuzzMutLine(killed: Int, survived: Int, inert: Int, ran: Int, sites: Int, invalid: Int, reused: Int): String =
  Str.concat("mutate: ", Str.concat(Str.fromInt(killed), Str.concat(" killed, ", Str.concat(Str.fromInt(survived), Str.concat(" survived, ", Str.concat(Str.fromInt(inert), Str.concat(" inert, ", Str.concat(Str.fromInt(invalid), Str.concat(" invalid, ", Str.concat(Str.fromInt(reused), Str.concat(" reused (", Str.concat(Str.fromInt(ran), Str.concat(" of ", Str.concat(Str.fromInt(sites), " sites)"))))))))))))))

def mutateHead(take: Int, sites: Int, o: Bool): String =
  Str.concat("scuzz fuzz mutate: ", Str.concat(Str.fromInt(take), Str.concat(" of ", Str.concat(Str.fromInt(sites), if (o) " residual oracle sites (negate/flip/0-1/arith/drop); idle + corpus replay" else " live-code sites (flip/if/0-1/map/handler); idle + corpus replay"))))

def noFiles(): List[(String, String)] =
  []

def oneSrc(src: String): List[(String, String)] =
  ("Main", src) :: noFiles()

def srcTwoBtn(): String =
  "@main def main: IO[Unit] =\n  Ui.run(_ => View.column(View.button(\"A\", _ => Signal.set(a, 3)), View.button(\"B\", _ => Signal.set(b, 4))))\n"

def srcArithBtn(): String =
  "@main def main: IO[Unit] =\n  Ui.run(_ => View.column(View.button(\"A\", _ => Signal.set(a, Signal.get(a) + 3)), View.button(\"B\", _ => Signal.set(b, 4))))\n"

def fileSrc(files: List[(String, String)]): String =
  if (List.isEmpty(files)) "" else fileSrcHd(List.at(files, 0))

def fileSrcHd(h: (String, String)): String =
  h match {
    case (_, src) => src
  }

def sitesOk(): Bool =
  twoBtnOk() && arithBtnOk() && twoBtnKept() && arithBtnKept() && pickSitesOk()

def pickSitesOk(): Bool =
  pickSitesEq(pickSites(42, 8, 8), 3 :: 4 :: 5 :: 6 :: 7 :: 0 :: 1 :: 2 :: noInts()) && pickSitesEq(pickSites(7, 3, 3), 2 :: 0 :: 1 :: noInts()) && pickSitesEq(pickSites(1, 0, 5), noInts())

def pickSitesEq(xs: List[Int], ys: List[Int]): Bool =
  if (List.isEmpty(xs) && List.isEmpty(ys)) true else if (List.isEmpty(xs) || List.isEmpty(ys)) false else pickSitesEqHd(List.at(xs, 0), List.at(ys, 0), List.tail(xs), List.tail(ys))

def pickSitesEqHd(x: Int, y: Int, xs: List[Int], ys: List[Int]): Bool =
  x == y && pickSitesEq(xs, ys)

def twoBtnOk(): Bool =
  countFiles(oneSrc(srcTwoBtn()), false) == 2 && twoBtnSwap()

def twoBtnSwap(): Bool =
  Str.contains(fileSrc(applyFiles(oneSrc(srcTwoBtn()), 0, false)), "View.button(\"A\", _ => Signal.set(b, 4))") && !Str.contains(fileSrc(applyFiles(oneSrc(srcTwoBtn()), 0, false)), "Signal.set(a, 3)")

def twoBtnKept(): Bool =
  twoBtnKeptOf(parseLive(oneSrc(srcTwoBtn())))

def twoBtnKeptOf(k: List[(String, String, Prog)]): Bool =
  countKept(k, false) == 2 && Str.contains(fileSrc(applyKept(k, 0, false)), "View.button(\"A\", _ => Signal.set(b, 4))") && !Str.contains(fileSrc(applyKept(k, 0, false)), "Signal.set(a, 3)") && siteLocKept(k, 0, false) == "body"

def arithBtnOk(): Bool =
  countFiles(oneSrc(srcArithBtn()), false) == 3 && arithBtnOp()

def arithBtnOp(): Bool =
  Str.contains(fileSrc(applyFiles(oneSrc(srcArithBtn()), 1, false)), "Signal.get(a) - 3") && Str.contains(fileSrc(applyFiles(oneSrc(srcArithBtn()), 1, false)), "Signal.set(a,") && Str.contains(fileSrc(applyFiles(oneSrc(srcArithBtn()), 1, false)), "Signal.set(b, 4)")

def arithBtnKept(): Bool =
  arithBtnKeptOf(parseLive(oneSrc(srcArithBtn())))

def arithBtnKeptOf(k: List[(String, String, Prog)]): Bool =
  countKept(k, false) == 3 && Str.contains(fileSrc(applyKept(k, 1, false)), "Signal.get(a) - 3") && siteLocKept(k, 1, false) == "body"

