record Walk(e: Expr, n: Int, hi: Int)

record Walks(xs: List[Expr], n: Int, hi: Int)

record FunWalk(ds: List[Fun], n: Int)

record ArmWalk(xs: List[Arm], n: Int, hi: Int)

record BindWalk(xs: List[Bind], n: Int, hi: Int)

import Parse.Expr
import Parse.Fun
import Parse.Prog
import Parse.Arm
import Parse.Bind
import Parse.Param

def wrapStem(): String =
  "__verify"

def noInts(): List[Int] =
  []

def noExprs(): List[Expr] =
  []

def live(inO: Bool): Bool =
  !inO

def isOracle(f: String): Bool =
  f == "Property.check" || f == "Property.assert"

def isHandler(f: String): Bool =
  f == "View.button" || f == "View.iconButton" || f == "View.outlinedButton" || f == "View.textButton" || f == "View.fab" || f == "View.inkWell"

def flipRel(op: String): String =
  if (op == "==") "!=" else if (op == "!=") "==" else if (op == "<") ">=" else if (op == "<=") ">" else if (op == ">") "<=" else if (op == ">=") "<" else if (op == "&&") "||" else if (op == "||") "&&" else ""

def flipArith(op: String): String =
  if (op == "+") "-" else if (op == "-") "+" else if (op == "*") "/" else if (op == "/") "*" else if (op == "%") "*" else ""

def binN(op: String): Int =
  if (flipRel(op) != "") if (op == "&&") 3 else 1 else if (flipArith(op) != "") 1 else 0

def remEuclid(a: Int, n: Int): Int =
  if (n <= 0) 0 else remEuclid2(a % n, n)

def remEuclid2(r: Int, n: Int): Int =
  if (r < 0) r + n else r

def lcgSeed(seed: Int): Int =
  remEuclid(seed, 2147483646) + 1

def lcgNext(s: Int): Int =
  remEuclid(s * 48271, 2147483647)

def hasInt(xs: List[Int], n: Int): Bool =
  if (List.isEmpty(xs)) false else hasIntHd(List.head(xs), List.tail(xs), n)

def hasIntHd(h: Int, rest: List[Int], n: Int): Bool =
  h == n || hasInt(rest, n)

def freeSite(i: Int, sites: Int, acc: List[Int]): Int =
  if (i >= sites) 0 else if (hasInt(acc, i)) freeSite(i + 1, sites, acc) else i

def pickSite(seed: Int, i: Int, sites: Int, acc: List[Int]): Int =
  pickSiteGo(lcgSeed(seed + i), 0, sites, acc)

def pickSiteGo(s: Int, tries: Int, sites: Int, acc: List[Int]): Int =
  pickSiteAt(remEuclid(s, sites), s, tries, sites, acc)

def pickSiteAt(site: Int, s: Int, tries: Int, sites: Int, acc: List[Int]): Int =
  if (!hasInt(acc, site)) site else if (tries < 8) pickSiteGo(lcgNext(s), tries + 1, sites, acc) else freeSite(0, sites, acc)

def pickSites(seed: Int, take: Int, sites: Int): List[Int] =
  if (take <= 0 || sites <= 0) noInts() else pickSitesGo(seed, if (take < sites) take else sites, sites, 0, noInts())

def pickSitesGo(seed: Int, take: Int, sites: Int, i: Int, acc: List[Int]): List[Int] =
  if (i >= take) acc else pickSitesGo(seed, take, sites, i + 1, List.concat(acc, pickSite(seed, i, sites, acc) :: noInts()))

def countFiles(files: List[(String, String)]): Int =
  if (List.isEmpty(files)) 0 else countFilesHd(List.head(files), List.tail(files))

def countFilesHd(h: (String, String), rest: List[(String, String)]): Int =
  h match {
    case (stem, src) => countFilesPick(stem, src, rest)
  }

def countFilesPick(stem: String, src: String, rest: List[(String, String)]): Int =
  if (stem == wrapStem()) countFiles(rest) else countProg(Parse.parseFile(stem, src)) + countFiles(rest)

def countProg(p: Prog): Int =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, body) => countFuns(defs, 0) + countExpr(body)
  }

def countFuns(ds: List[Fun], n: Int): Int =
  if (List.isEmpty(ds)) n else countFunsHd(List.head(ds), List.tail(ds), n)

def countFunsHd(d: Fun, rest: List[Fun], n: Int): Int =
  d match {
    case Fun(_, _, _, _, _, body, _) => countFuns(rest, n + countExpr(body))
  }

def countExpr(e: Expr): Int =
  walk(e, 0 - 1, 0, false, noExprs(), 0).n

def applyFiles(files: List[(String, String)], site: Int): List[(String, String)] =
  applyFilesGo(files, site, 0)

def applyFilesGo(files: List[(String, String)], site: Int, base: Int): List[(String, String)] =
  if (List.isEmpty(files)) files else applyFilesHd(List.head(files), List.tail(files), site, base)

def applyFilesHd(h: (String, String), rest: List[(String, String)], site: Int, base: Int): List[(String, String)] =
  h match {
    case (stem, src) => applyFilesPick(stem, src, rest, site, base)
  }

def applyFilesPick(stem: String, src: String, rest: List[(String, String)], site: Int, base: Int): List[(String, String)] =
  if (stem == wrapStem()) (stem, src) :: applyFilesGo(rest, site, base) else applyFilesLive(stem, src, rest, site, base)

def applyFilesLive(stem: String, src: String, rest: List[(String, String)], site: Int, base: Int): List[(String, String)] =
  applyFilesLive2(stem, src, rest, site, base, Parse.parseFile(stem, src))

def applyFilesLive2(stem: String, src: String, rest: List[(String, String)], site: Int, base: Int, p: Prog): List[(String, String)] =
  applyFilesLive3(stem, src, rest, site, base, p, countProg(p))

def applyFilesLive3(stem: String, src: String, rest: List[(String, String)], site: Int, base: Int, p: Prog, n: Int): List[(String, String)] =
  if (site >= base && site < base + n) (stem, Parse.pretty(applyProg(p, site - base))) :: rest else (stem, src) :: applyFilesGo(rest, site, base + n)

def applyProg(p: Prog, site: Int): Prog =
  p match {
    case Prog(pkg, ens, als, trs, ims, imps, defs, main, body) => applyFuns(defs, site, 0) match {
  case FunWalk(ds, n) => walk(body, site, n, false, collectHs(body, noExprs()), 0) match {
  case Walk(b, _, _) => Prog(pkg, ens, als, trs, ims, imps, ds, main, b)
}
}
  }

def applyFuns(ds: List[Fun], site: Int, seen: Int): FunWalk =
  if (List.isEmpty(ds)) FunWalk(Parse.noFun(), seen) else applyFunsHd(List.head(ds), List.tail(ds), site, seen)

def applyFunsHd(d: Fun, rest: List[Fun], site: Int, seen: Int): FunWalk =
  d match {
    case Fun(priv, name, tps, ps, ret, body, mod) => applyFunBody(priv, name, tps, ps, ret, body, mod, rest, site, seen)
  }

def applyFunBody(priv: Bool, name: String, tps: List[String], ps: List[Param], ret: String, body: Expr, mod: String, rest: List[Fun], site: Int, seen: Int): FunWalk =
  walk(body, site, seen, false, collectHs(body, noExprs()), 0) match {
    case Walk(b, n, _) => applyFunsRest(Fun(priv, name, tps, ps, ret, b, mod), rest, site, n)
  }

def applyFunsRest(d: Fun, rest: List[Fun], site: Int, seen: Int): FunWalk =
  applyFuns(rest, site, seen) match {
    case FunWalk(ds, n) => FunWalk(d :: ds, n)
  }

def collectHs(e: Expr, acc: List[Expr]): List[Expr] =
  e match {
    case Expr.ECall(f, args) => collectHsCall(f, args, acc, e)
    case Expr.EPrint(inner) => collectHs(inner, acc)
    case Expr.EMethod(recv, _, args) => collectHsList(args, collectHs(recv, acc))
    case Expr.EField(recv, _) => collectHs(recv, acc)
    case Expr.EBin(_, l, r) => collectHs(r, collectHs(l, acc))
    case Expr.EUn(_, inner) => collectHs(inner, acc)
    case Expr.ELam(_, body) => collectHs(body, acc)
    case Expr.EIf(c, t, el) => collectHs(el, collectHs(t, collectHs(c, acc)))
    case Expr.EMatch(s, arms) => collectHsArms(arms, collectHs(s, acc))
    case Expr.EFor(bs, body) => collectHs(body, collectHsBinds(bs, acc))
    case Expr.EList(xs) => collectHsList(xs, acc)
    case Expr.ETuple(xs) => collectHsList(xs, acc)
    case Expr.ENamed(_, inner) => collectHs(inner, acc)
    case _ => acc
  }

def collectHsCall(f: String, args: List[Expr], acc: List[Expr], _e: Expr): List[Expr] =
  collectHsList(args, if (isHandler(f) && isLamAt(args, 1)) handlerBody(args) :: acc else acc)

def isLamAt(args: List[Expr], i: Int): Bool =
  if (List.len(args) <= i) false else isLam(List.at(args, i))

def isLam(e: Expr): Bool =
  e match {
    case Expr.ELam(_, _) => true
    case _ => false
  }

def handlerBody(args: List[Expr]): Expr =
  if (List.len(args) < 2) Expr.EUnit else handlerBodyAt(List.at(args, 1))

def handlerBodyAt(e: Expr): Expr =
  e match {
    case Expr.ELam(_, body) => body
    case _ => Expr.EUnit
  }

def collectHsList(xs: List[Expr], acc: List[Expr]): List[Expr] =
  if (List.isEmpty(xs)) acc else collectHsList(List.tail(xs), collectHs(List.head(xs), acc))

def collectHsArms(xs: List[Arm], acc: List[Expr]): List[Expr] =
  if (List.isEmpty(xs)) acc else collectHsArmsHd(List.head(xs), List.tail(xs), acc)

def collectHsArmsHd(a: Arm, rest: List[Arm], acc: List[Expr]): List[Expr] =
  a match {
    case Arm(_, _, body) => collectHsArms(rest, collectHs(body, acc))
  }

def collectHsBinds(xs: List[Bind], acc: List[Expr]): List[Expr] =
  if (List.isEmpty(xs)) acc else collectHsBindsHd(List.head(xs), List.tail(xs), acc)

def collectHsBindsHd(b: Bind, rest: List[Bind], acc: List[Expr]): List[Expr] =
  b match {
    case Bind(_, _, v) => collectHsBinds(rest, collectHs(v, acc))
  }

def walk(e: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  e match {
    case Expr.EInt(k) => walkInt(k, target, seen, inO, hi)
    case Expr.EBin(op, l, r) => walkBin(op, l, r, target, seen, inO, hs, hi)
    case Expr.EIf(c, t, el) => walkIf(c, t, el, target, seen, inO, hs, hi)
    case Expr.ECall(f, args) => walkCall(f, args, target, seen, inO, hs, hi)
    case Expr.EPrint(inner) => walkPrint(inner, target, seen, inO, hs, hi)
    case Expr.EMethod(recv, name, args) => walkMethod(recv, name, args, target, seen, inO, hs, hi)
    case Expr.EField(recv, name) => walkField(recv, name, target, seen, inO, hs, hi)
    case Expr.EUn(op, inner) => walkUn(op, inner, target, seen, inO, hs, hi)
    case Expr.ELam(p, body) => walkLam(p, body, target, seen, inO, hs, hi)
    case Expr.EMatch(s, arms) => walkMatch(s, arms, target, seen, inO, hs, hi)
    case Expr.EFor(bs, body) => walkFor(bs, body, target, seen, inO, hs, hi)
    case Expr.EList(xs) => walkListExpr(xs, target, seen, inO, hs, hi)
    case Expr.ETuple(xs) => walkTuple(xs, target, seen, inO, hs, hi)
    case Expr.ENamed(name, inner) => walkNamed(name, inner, target, seen, inO, hs, hi)
    case _ => Walk(e, seen, hi)
  }

def walkInt(k: Int, target: Int, seen: Int, inO: Bool, hi: Int): Walk =
  if ((k == 0 || k == 1) && live(inO)) Walk(Expr.EInt(if (seen == target) 1 - k else k), seen + 1, hi) else Walk(Expr.EInt(k), seen, hi)

def walkBin(op: String, l: Expr, r: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  if (live(inO) && binN(op) > 0) walkBinHit(op, l, r, target, seen, inO, hs, hi) else walkBinKids(op, l, r, target, seen, inO, hs, hi)

def walkBinHit(op: String, l: Expr, r: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walk(l, target, seen + binN(op), inO, hs, hi) match {
    case Walk(l2, n1, h1) => walkBinHitR(op, l2, r, target, seen, inO, hs, n1, h1)
  }

def walkBinHitR(op: String, l: Expr, r: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], n1: Int, h1: Int): Walk =
  walk(r, target, n1, inO, hs, h1) match {
    case Walk(r2, n2, h2) => Walk(binOut(op, l, r2, target, seen), n2, h2)
  }

def walkBinKids(op: String, l: Expr, r: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walk(l, target, seen, inO, hs, hi) match {
    case Walk(l2, n1, h1) => walkBinKidsR(op, l2, r, target, inO, hs, n1, h1)
  }

def walkBinKidsR(op: String, l: Expr, r: Expr, target: Int, inO: Bool, hs: List[Expr], n1: Int, h1: Int): Walk =
  walk(r, target, n1, inO, hs, h1) match {
    case Walk(r2, n2, h2) => Walk(Expr.EBin(op, l, r2), n2, h2)
  }

def binOut(op: String, l: Expr, r: Expr, target: Int, seen: Int): Expr =
  if (seen == target && flipRel(op) != "") Expr.EBin(flipRel(op), l, r) else binOut2(op, l, r, target, seen)

def binOut2(op: String, l: Expr, r: Expr, target: Int, seen: Int): Expr =
  if (op == "&&" && seen + 1 == target) l else if (op == "&&" && seen + 2 == target) r else if (seen == target && flipArith(op) != "") Expr.EBin(flipArith(op), l, r) else Expr.EBin(op, l, r)

def walkIf(c: Expr, t: Expr, el: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  if (live(inO)) walkIfHit(c, t, el, target, seen, hs, hi) else walkIfKids(c, t, el, target, seen, inO, hs, hi)

def walkIfHit(c: Expr, t: Expr, el: Expr, target: Int, seen: Int, hs: List[Expr], hi: Int): Walk =
  walk(c, target, seen + 1, false, hs, hi) match {
    case Walk(c2, n1, h1) => walkIfThen(c2, t, el, target, seen, n1, h1, hs)
  }

def walkIfThen(c: Expr, t: Expr, el: Expr, target: Int, seen: Int, n1: Int, h1: Int, hs: List[Expr]): Walk =
  walk(t, target, n1, false, hs, h1) match {
    case Walk(t2, n2, h2) => walkIfElse(c, t2, el, target, seen, n2, h2, hs)
  }

def walkIfElse(c: Expr, t: Expr, el: Expr, target: Int, seen: Int, n2: Int, h2: Int, hs: List[Expr]): Walk =
  walk(el, target, n2, false, hs, h2) match {
    case Walk(e2, n3, h3) => Walk(if (seen == target) Expr.EIf(c, e2, t) else Expr.EIf(c, t, e2), n3, h3)
  }

def walkIfKids(c: Expr, t: Expr, el: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walk(c, target, seen, inO, hs, hi) match {
    case Walk(c2, n1, h1) => walkIfKidsT(c2, t, el, target, inO, hs, n1, h1)
  }

def walkIfKidsT(c: Expr, t: Expr, el: Expr, target: Int, inO: Bool, hs: List[Expr], n1: Int, h1: Int): Walk =
  walk(t, target, n1, inO, hs, h1) match {
    case Walk(t2, n2, h2) => walkIfKidsE(c, t2, el, target, inO, hs, n2, h2)
  }

def walkIfKidsE(c: Expr, t: Expr, el: Expr, target: Int, inO: Bool, hs: List[Expr], n2: Int, h2: Int): Walk =
  walk(el, target, n2, inO, hs, h2) match {
    case Walk(e2, n3, h3) => Walk(Expr.EIf(c, t, e2), n3, h3)
  }

def walkCall(f: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  if (isOracle(f)) walkArgs(args, target, seen, true, hs, hi) match {
  case Walks(xs, n, h) => Walk(Expr.ECall(f, xs), n, h)
} else if (f == "Signal.map") walkMap(f, args, target, seen, inO, hs, hi) else if (isHandler(f)) walkHandler(f, args, target, seen, inO, hs, hi) else walkArgs(args, target, seen, inO, hs, hi) match {
  case Walks(xs, n, h) => Walk(Expr.ECall(f, xs), n, h)
}

def walkMap(f: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  if (live(inO) && mapParam(args) != "") walkMapHit(f, args, target, seen, inO, hs, hi, mapParam(args)) else walkArgs(args, target, seen, inO, hs, hi) match {
  case Walks(xs, n, h) => Walk(Expr.ECall(f, xs), n, h)
}

def mapParam(args: List[Expr]): String =
  if (List.len(args) != 2) "" else mapParamAt(List.at(args, 1))

def mapParamAt(e: Expr): String =
  e match {
    case Expr.ELam(p, _) => if (p == "_") "" else p
    case _ => ""
  }

def walkMapHit(f: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int, p: String): Walk =
  walkArgs(args, target, seen + 1, inO, hs, hi) match {
    case Walks(xs, n, h) => Walk(Expr.ECall(f, if (seen == target) mapIdent(xs, p) else xs), n, h)
  }

def mapIdent(args: List[Expr], p: String): List[Expr] =
  if (List.len(args) != 2) args else List.head(args) :: mapIdentLam(List.at(args, 1), p) :: noExprs()

def mapIdentLam(e: Expr, p: String): Expr =
  e match {
    case Expr.ELam(q, _) => Expr.ELam(q, Expr.EVar(p))
    case _ => e
  }

def walkHandler(f: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  if (live(inO) && List.len(hs) >= 2) walkHandlerHit(f, args, target, seen, inO, hs, hi) else walkArgs(args, target, seen, inO, hs, hi) match {
  case Walks(xs, n, h) => Walk(Expr.ECall(f, xs), n, h)
}

def walkHandlerHit(f: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walkArgs(args, target, seen + 1, inO, hs, hi + 1) match {
    case Walks(xs, n, h) => Walk(Expr.ECall(f, if (seen == target) swapHandler(xs, hs, hi) else xs), n, h)
  }

def swapHandler(args: List[Expr], hs: List[Expr], hi: Int): List[Expr] =
  if (List.len(args) < 2) args else List.head(args) :: swapHandlerLam(List.at(args, 1), nextH(hs, hi)) :: drop2(args)

def drop2(args: List[Expr]): List[Expr] =
  if (List.isEmpty(args) || List.isEmpty(List.tail(args))) noExprs() else List.tail(List.tail(args))

def nextH(hs: List[Expr], hi: Int): Expr =
  List.at(hs, remEuclid(hi + 1, List.len(hs)))

def swapHandlerLam(e: Expr, body: Expr): Expr =
  e match {
    case Expr.ELam(p, _) => Expr.ELam(p, body)
    case _ => e
  }

def walkPrint(inner: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walk(inner, target, seen, inO, hs, hi) match {
    case Walk(e2, n, h) => Walk(Expr.EPrint(e2), n, h)
  }

def walkMethod(recv: Expr, name: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  if (name == "require") walkRequire(recv, args, target, seen, hs, hi) else walkMethodGo(recv, name, args, target, seen, inO, hs, hi)

def walkRequire(recv: Expr, args: List[Expr], target: Int, seen: Int, hs: List[Expr], hi: Int): Walk =
  walk(recv, target, seen, false, hs, hi) match {
    case Walk(r2, n1, h1) => walkArgs(args, target, n1, true, hs, h1) match {
  case Walks(xs, n2, h2) => Walk(Expr.EMethod(r2, "require", xs), n2, h2)
}
  }

def walkMethodGo(recv: Expr, name: String, args: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walk(recv, target, seen, inO, hs, hi) match {
    case Walk(r2, n1, h1) => walkArgs(args, target, n1, inO, hs, h1) match {
  case Walks(xs, n2, h2) => Walk(Expr.EMethod(r2, name, xs), n2, h2)
}
  }

def walkField(recv: Expr, name: String, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walk(recv, target, seen, inO, hs, hi) match {
    case Walk(r2, n, h) => Walk(Expr.EField(r2, name), n, h)
  }

def walkUn(op: String, inner: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walk(inner, target, seen, inO, hs, hi) match {
    case Walk(e2, n, h) => Walk(Expr.EUn(op, e2), n, h)
  }

def walkLam(p: String, body: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walk(body, target, seen, inO, hs, hi) match {
    case Walk(b, n, h) => Walk(Expr.ELam(p, b), n, h)
  }

def walkMatch(s: Expr, arms: List[Arm], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walk(s, target, seen, inO, hs, hi) match {
    case Walk(s2, n1, h1) => walkArms(arms, target, n1, inO, hs, h1) match {
  case ArmWalk(xs, n2, h2) => Walk(Expr.EMatch(s2, xs), n2, h2)
}
  }

def walkFor(bs: List[Bind], body: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walkBinds(bs, target, seen, inO, hs, hi) match {
    case BindWalk(xs, n1, h1) => walk(body, target, n1, inO, hs, h1) match {
  case Walk(b, n2, h2) => Walk(Expr.EFor(xs, b), n2, h2)
}
  }

def walkListExpr(xs: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walkArgs(xs, target, seen, inO, hs, hi) match {
    case Walks(ys, n, h) => Walk(Expr.EList(ys), n, h)
  }

def walkTuple(xs: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walkArgs(xs, target, seen, inO, hs, hi) match {
    case Walks(ys, n, h) => Walk(Expr.ETuple(ys), n, h)
  }

def walkNamed(name: String, inner: Expr, target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walk =
  walk(inner, target, seen, inO, hs, hi) match {
    case Walk(e2, n, h) => Walk(Expr.ENamed(name, e2), n, h)
  }

def walkArgs(xs: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walks =
  if (List.isEmpty(xs)) Walks(noExprs(), seen, hi) else walkArgsHd(List.head(xs), List.tail(xs), target, seen, inO, hs, hi)

def walkArgsHd(h: Expr, rest: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walks =
  walk(h, target, seen, inO, hs, hi) match {
    case Walk(e2, n1, h1) => walkArgsRest(e2, rest, target, n1, inO, hs, h1)
  }

def walkArgsRest(e: Expr, rest: List[Expr], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): Walks =
  walkArgs(rest, target, seen, inO, hs, hi) match {
    case Walks(xs, n, h) => Walks(e :: xs, n, h)
  }

def noArms(): List[Arm] =
  []

def walkArms(xs: List[Arm], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): ArmWalk =
  if (List.isEmpty(xs)) ArmWalk(noArms(), seen, hi) else walkArmsHd(List.head(xs), List.tail(xs), target, seen, inO, hs, hi)

def walkArmsHd(a: Arm, rest: List[Arm], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): ArmWalk =
  a match {
    case Arm(pat, g, body) => walk(body, target, seen, inO, hs, hi) match {
  case Walk(b, n1, h1) => walkArmsRest(Arm(pat, g, b), rest, target, n1, inO, hs, h1)
}
  }

def walkArmsRest(a: Arm, rest: List[Arm], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): ArmWalk =
  walkArms(rest, target, seen, inO, hs, hi) match {
    case ArmWalk(xs, n, h) => ArmWalk(a :: xs, n, h)
  }

def noBinds(): List[Bind] =
  []

def walkBinds(xs: List[Bind], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): BindWalk =
  if (List.isEmpty(xs)) BindWalk(noBinds(), seen, hi) else walkBindsHd(List.head(xs), List.tail(xs), target, seen, inO, hs, hi)

def walkBindsHd(b: Bind, rest: List[Bind], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): BindWalk =
  b match {
    case Bind(draw, name, v) => walk(v, target, seen, inO, hs, hi) match {
  case Walk(v2, n1, h1) => walkBindsRest(Bind(draw, name, v2), rest, target, n1, inO, hs, h1)
}
  }

def walkBindsRest(b: Bind, rest: List[Bind], target: Int, seen: Int, inO: Bool, hs: List[Expr], hi: Int): BindWalk =
  walkBinds(rest, target, seen, inO, hs, hi) match {
    case BindWalk(xs, n, h) => BindWalk(b :: xs, n, h)
  }

def fuzzMutLine(killed: Int, survived: Int, inert: Int, ran: Int, sites: Int): String =
  Str.concat("mutate: ", Str.concat(Str.fromInt(killed), Str.concat(" killed, ", Str.concat(Str.fromInt(survived), Str.concat(" survived, ", Str.concat(Str.fromInt(inert), Str.concat(" inert (", Str.concat(Str.fromInt(ran), Str.concat(" of ", Str.concat(Str.fromInt(sites), " sites)"))))))))))

def mutateHead(take: Int, sites: Int): String =
  Str.concat("scuzz fuzz mutate: ", Str.concat(Str.fromInt(take), Str.concat(" of ", Str.concat(Str.fromInt(sites), " live-code sites (flip/if/0-1/sibling); idle + corpus replay"))))

