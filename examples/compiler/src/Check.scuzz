record Out(ty: String, err: String, span: (String, Int))

import Parse.Expr
import Parse.Fun
import Parse.Param
import Parse.Prog
import Parse.En
import Parse.EnCase
import Parse.Arm
import Parse.Bind
import Parse.Alias
import Parse.Imp
import Parse.Im
import Lexer.lex
import Type.eqStr
import Type.preferStr
import Type.isTyParam
import Kits.has
import Kits.params
import Kits.ret
import Kits.names
import Kits.want
import Kits.arityOk

def noStr(): List[String] =
  []

def noEnv(): List[(String, String)] =
  []

def modFile(env: List[(String, String)]): String =
  getTy(env, "#mod")

def exprSpan(env: List[(String, String)], e: Expr): (String, Int) =
  spanPick(Parse.spanOf(e), (modFile(env), 0 - 1))

def noSpan(): (String, Int) =
  ("", 0 - 1)

def ok(ty: String): Out =
  Out(ty, "", noSpan())

def bad(err: String, span: (String, Int)): Out =
  Out("", err, span)

def hasErr(o: Out): Bool =
  Str.len(o.err) > 0

def getTy(env: List[(String, String)], name: String): String =
  if (List.isEmpty(env)) "" else getTyHd(List.at(env, 0), List.tail(env), name)

def getTyHd(h: (String, String), rest: List[(String, String)], name: String): String =
  h match {
    case (k, v) => if (k == name) v else getTy(rest, name)
  }

def bindParams(ps: List[Param], acc: List[(String, String)]): List[(String, String)] =
  if (List.isEmpty(ps)) acc else bindParamsHd(List.at(ps, 0), List.tail(ps), acc)

def bindParamsHd(p: Param, rest: List[Param], acc: List[(String, String)]): List[(String, String)] =
  p match {
    case Param(n, ty, _, _) => bindParams(rest, (n, ty) :: acc)
  }

def bindLam(p: String, ty: String, env: List[(String, String)]): List[(String, String)] =
  if (p == "") env else (p, if (ty == "") "A" else ty) :: env

def annOk(ann: String, expect: String, span: (String, Int)): Out =
  if (ann == "" || tyEq(ann, expect)) ok(expect) else bad(Str.concat("type mismatch: expected ", Str.concat(ann, Str.concat(", got ", expect))), span)

def lookupEnv(env: List[(String, String)], n: String): String =
  if (List.isEmpty(env)) "" else lookupEnv1(List.at(env, 0), List.tail(env), n)

def lookupEnv1(h: (String, String), rest: List[(String, String)], n: String): String =
  h match {
    case (k, ty) => if (k == n) ty else lookupEnv(rest, n)
  }

def isFunTy(t: String): Bool =
  isFunTyAt(t, 0)

def isFunTyAt(t: String, i: Int): Bool =
  if (i + 1 >= Str.len(t)) false else isFunTyAt2(t, i)

def isFunTyAt2(t: String, i: Int): Bool =
  if (Str.charAt(t, i) == 61) isFunTyAt3(t, i) else isFunTyAt(t, i + 1)

def isFunTyAt3(t: String, i: Int): Bool =
  if (Str.charAt(t, i + 1) == 62) true else isFunTyAt(t, i + 1)

def funRetOf(t: String): String =
  funRetOfAt(t, 0)

def funRetOfAt(t: String, i: Int): String =
  if (i + 4 > Str.len(t)) t else funRetOfAt2(t, i)

def funRetOfAt2(t: String, i: Int): String =
  if (sliceEq(t, i, " => ")) Str.slice(t, i + 4, 8192) else funRetOfAt(t, i + 1)

def sliceEq(t: String, i: Int, w: String): Bool =
  Str.slice(t, i, i + Str.len(w)) == w

def findFunPrefer(funs: List[Fun], name: String, env: List[(String, String)]): List[Fun] =
  findFunPrefer2(funs, name, getTy(env, "#mod"))

def findFunPrefer2(funs: List[Fun], name: String, mod: String): List[Fun] =
  if (mod == "") findFun(funs, name) else findFunPrefer3(findFunMod(funs, mod, name), funs, name)

def findFunPrefer3(hit: List[Fun], funs: List[Fun], name: String): List[Fun] =
  if (List.isEmpty(hit)) findFun(funs, name) else hit

def findFun(funs: List[Fun], name: String): List[Fun] =
  if (List.isEmpty(funs)) [] else findFun1(List.at(funs, 0), List.tail(funs), name)

def findFun1(h: Fun, rest: List[Fun], name: String): List[Fun] =
  h match {
    case Fun(priv, n, ts, ps, ret, body, mod, off) => if (n == name) Fun(priv, n, ts, ps, ret, body, mod, off) :: findFun(rest, name) else findFun(rest, name)
  }

def findFunMod(funs: List[Fun], mod: String, name: String): List[Fun] =
  if (List.isEmpty(funs)) [] else findFunMod1(List.at(funs, 0), List.tail(funs), mod, name)

def findFunMod1(h: Fun, rest: List[Fun], mod: String, name: String): List[Fun] =
  h match {
    case Fun(priv, n, ts, ps, ret, body, m, off) => if (n == name && m == mod) Fun(priv, n, ts, ps, ret, body, m, off) :: findFunMod(rest, mod, name) else findFunMod(rest, mod, name)
  }

def paramTys(ps: List[Param]): List[String] =
  if (List.isEmpty(ps)) [] else paramTys1(List.at(ps, 0), List.tail(ps))

def paramTys1(p: Param, rest: List[Param]): List[String] =
  p match {
    case Param(_, ty, _, _) => ty :: paramTys(rest)
  }

def stripNamed(e: Expr): Expr =
  e match {
    case Expr.ENamed(_, inner) => inner
    case _ => e
  }

def noExpr(): List[Expr] =
  []

def hasNamedArg(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (isNamedArg(List.at(xs, 0)) || hasNamedArg(List.tail(xs)))

def isNamedArg(e: Expr): Bool =
  e match {
    case Expr.ENamed(_, _) => true
    case _ => false
  }

def dfltExpr(d: String): Expr =
  dfltExprOf(Parse.parseExprList(lex(d), 0))

def dfltExprOf(p: (Expr, Int)): Expr =
  p match {
    case (e, _) => e
  }

def namedHas(n: String, args: List[Expr]): Bool =
  !List.isEmpty(args) && namedHas1(List.at(args, 0), List.tail(args), n)

def namedHas1(h: Expr, rest: List[Expr], n: String): Bool =
  h match {
    case Expr.ENamed(nm, _) => nm == n || namedHas(n, rest)
    case _ => namedHas(n, rest)
  }

def namedLookup(n: String, args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EUnit else namedLookup1(List.at(args, 0), List.tail(args), n)

def namedLookup1(h: Expr, rest: List[Expr], n: String): Expr =
  h match {
    case Expr.ENamed(nm, inner) => if (nm == n) inner else namedLookup(n, rest)
    case _ => namedLookup(n, rest)
  }

def paramHasName(ps: List[Param], n: String): Bool =
  if (List.isEmpty(ps)) false else paramHasName1(List.at(ps, 0), List.tail(ps), n)

def paramHasName1(p: Param, rest: List[Param], n: String): Bool =
  p match {
    case Param(nm, _, _, _) => nm == n || paramHasName(rest, n)
  }

def alignCall(ps: List[Param], args: List[Expr]): (List[Expr], String) =
  if (List.isEmpty(ps)) (args, "") else alignAfterSplit(ps, alignSplit(args, noExpr(), noExpr(), false))

def alignSplit(args: List[Expr], pos: List[Expr], named: List[Expr], seenN: Bool): (List[Expr], List[Expr], String) =
  if (List.isEmpty(args)) (List.reverse(pos), List.reverse(named), "") else alignSplit1(List.at(args, 0), List.tail(args), pos, named, seenN)

def alignSplit1(h: Expr, rest: List[Expr], pos: List[Expr], named: List[Expr], seenN: Bool): (List[Expr], List[Expr], String) =
  h match {
    case Expr.ENamed(_, _) => alignSplit(rest, pos, h :: named, true)
    case _ => if (seenN) (List.reverse(pos), List.reverse(named), "positional argument after named argument") else alignSplit(rest, h :: pos, named, false)
  }

def alignAfterSplit(ps: List[Param], sp: (List[Expr], List[Expr], String)): (List[Expr], String) =
  sp match {
    case (pos, named, err) => if (err != "") (noExpr(), err) else alignAfterUnknown(ps, pos, named, alignUnknown(named, ps))
  }

def alignUnknown(named: List[Expr], ps: List[Param]): String =
  if (List.isEmpty(named)) "" else alignUnknown1(List.at(named, 0), List.tail(named), ps)

def alignUnknown1(h: Expr, rest: List[Expr], ps: List[Param]): String =
  h match {
    case Expr.ENamed(nm, _) => if (paramHasName(ps, nm)) alignUnknown(rest, ps) else Str.concat("unknown argument ", nm)
    case _ => alignUnknown(rest, ps)
  }

def alignAfterUnknown(ps: List[Param], pos: List[Expr], named: List[Expr], err: String): (List[Expr], String) =
  if (err != "") (noExpr(), err) else alignFillPs(ps, pos, named, 0, noExpr())

def alignFillPs(ps: List[Param], pos: List[Expr], named: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  if (List.isEmpty(ps)) alignDone(pos, i, acc) else alignFillHd(List.at(ps, 0), List.tail(ps), pos, named, i, acc)

def alignDone(pos: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  if (i < List.len(pos)) (List.reverse(acc), "too many arguments") else (List.reverse(acc), "")

def alignFillHd(p: Param, rest: List[Param], pos: List[Expr], named: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  p match {
    case Param(n, _, _, d) => alignFillOne(n, d, rest, pos, named, i, acc)
  }

def alignFillOne(n: String, d: String, rest: List[Param], pos: List[Expr], named: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  if (i < List.len(pos)) alignFillPos(n, rest, pos, named, i, acc) else alignFillNamed(n, d, rest, pos, named, i, acc)

def alignFillPos(n: String, rest: List[Param], pos: List[Expr], named: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  if (namedHas(n, named)) (noExpr(), Str.concat("duplicate argument ", n)) else alignFillPs(rest, pos, named, i + 1, List.at(pos, i) :: acc)

def alignFillNamed(n: String, d: String, rest: List[Param], pos: List[Expr], named: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  if (namedHas(n, named)) alignFillPs(rest, pos, named, i, namedLookup(n, named) :: acc) else alignFillDflt(n, d, rest, pos, named, i, acc)

def alignFillDflt(n: String, d: String, rest: List[Param], pos: List[Expr], named: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  if (d != "") alignFillPs(rest, pos, named, i, dfltExpr(d) :: acc) else (noExpr(), Str.concat("missing argument ", n))

def alignErr(f: String, err: String, ps: List[Param], args: List[Expr]): String =
  if (arityErr(err, args)) Str.concat(f, Str.concat(" expects ", Str.concat(Str.fromInt(List.len(ps)), Str.concat(" args, got ", Str.fromInt(List.len(args)))))) else err

def arityErr(err: String, args: List[Expr]): Bool =
  (err == "too many arguments" || Str.startsWith(err, "missing argument ")) && !hasNamedArg(args)

def isKit(f: String): Bool =
  has(f)

def kitParams(f: String): List[String] =
  params(f)

def kitNames(): List[String] =
  names()

def kitRet(f: String): String =
  ret(f)

def isNetServe(f: String): Bool =
  f == "Net.serve" || f == "Net.serveOnce"

def isArith(op: String): Bool =
  op == "+" || op == "-" || op == "*" || op == "/" || op == "%"

def isEq(op: String): Bool =
  op == "==" || op == "!="

def isOrd(op: String): Bool =
  op == "<" || op == "<=" || op == ">" || op == ">="

def isLogic(op: String): Bool =
  op == "&&" || op == "||"

def isBit(op: String): Bool =
  op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>"

def firstArgErr(args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(args)) ok("") else firstArgErr2(infer(stripNamed(List.at(args, 0)), env, funs, ens), List.tail(args), env, funs, ens)

def firstArgErr2(o: Out, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(o)) o else firstArgErr(rest, env, funs, ens)

def zipCheck(callee: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), acc: String): Out =
  if (List.isEmpty(want)) ok(acc) else zipCheckHd(callee, List.at(want, 0), List.tail(want), args, env, funs, ens, span, acc)

def zipCheckHd(callee: String, w: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), acc: String): Out =
  zipCheckArg(callee, w, want, List.at(args, 0), List.tail(args), env, funs, ens, span, acc)

def zipCheckArg(callee: String, w: String, want: List[String], arg: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), acc: String): Out =
  zipCheckGo(callee, w, want, arg, args, env, funs, ens, span, acc, spanPick(exprSpan(env, stripNamed(arg)), span))

def zipCheckGo(callee: String, w: String, want: List[String], arg: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), acc: String, asp: (String, Int)): Out =
  if (List.isEmpty(args)) zipCheckLast(infer(stripNamed(arg), env, funs, ens), callee, w, asp, acc) else zipCheck2(callee, w, infer(stripNamed(arg), env, funs, ens), want, args, env, funs, ens, span, acc, asp)

def zipCheckLast(o: Out, callee: String, w: String, span: (String, Int), acc: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else if (tyEq(ty, w)) ok(if (acc == "") ty else acc) else argMismatch(callee, w, ty, span)
  }

def zipCheck2(callee: String, w: String, o: Out, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), acc: String, asp: (String, Int)): Out =
  o match {
    case Out(ty, err, sp) => zipCheckErr(callee, w, ty, err, sp, want, args, env, funs, ens, span, acc, asp)
  }

def zipCheckErr(callee: String, w: String, ty: String, err: String, sp: (String, Int), want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), acc: String, asp: (String, Int)): Out =
  if (Str.len(err) > 0) Out(ty, err, sp) else zipCheckEq(callee, w, ty, want, args, env, funs, ens, span, acc, asp)

def zipCheckEq(callee: String, w: String, got: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), acc: String, asp: (String, Int)): Out =
  if (tyEq(got, w)) zipCheck(callee, kitWantFromTy(callee, if (acc == "") got else acc, want), args, env, funs, ens, span, if (acc == "") got else acc) else argMismatch(callee, w, got, asp)

def kitWantFromTy(f: String, handleTy: String, want: List[String]): List[String] =
  if (List.isEmpty(want)) want else if (f == "Queue.offer" || f == "Deferred.complete") offerElem(handleTy) :: List.tail(want) else want

def offerElem(handleTy: String): String =
  if (Str.startsWith(handleTy, "Queue[") || Str.startsWith(handleTy, "Deferred[")) elemOf(handleTy) else "A"

def argMismatch(callee: String, w: String, got: String, span: (String, Int)): Out =
  bad(argMismatchMsg(argMismatchWant(callee, w), got), span)

def argMismatchWant(callee: String, w: String): String =
  if (callee == "IO.println") "expected String, got " else Str.concat(callee, Str.concat(" arg type mismatch: expected ", Str.concat(w, ", got ")))

def argMismatchMsg(prefix: String, got: String): String =
  Str.concat(prefix, got)

def isListTy(t: String): Bool =
  t == "List" || Str.startsWith(t, "List[")

def tyEq(a: String, b: String): Bool =
  eqStr(a, b)

def prefer(a: String, b: String): String =
  preferStr(a, b)

def isLoose(t: String): Bool =
  isTyParam(t)

def funArgOf(t: String): String =
  funArgOfAt(t, 0)

def funArgOfAt(t: String, i: Int): String =
  if (i + 4 > Str.len(t)) t else if (sliceEq(t, i, " => ")) Str.slice(t, 0, i) else funArgOfAt(t, i + 1)

def isTup(t: String): Bool =
  Str.len(t) > 0 && Str.charAt(t, 0) == 40

def checkKnown(f: String, want: List[String], ret: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.len(want) != List.len(args)) bad(Str.concat(f, Str.concat(" expects ", Str.concat(Str.fromInt(List.len(want)), Str.concat(" args, got ", Str.fromInt(List.len(args)))))), span) else checkKnownRet(f, zipCheck(f, want, args, env, funs, ens, span, ""), ret)

def checkKnownRet(f: String, o: Out, ret: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else ok(kitRetFromTy(f, ty, substKitE(ret, ty)))
  }

def substKitE(ret: String, ty: String): String =
  if (ty == "") ret else substTy(ret, "E", ty)

def kitRetFromTy(f: String, ty: String, ret: String): String =
  if (f == "List.head") kitRetOption(ty) else if (f == "Map.get") kitRetMapOption(ty) else if (f == "List.at") elemOf(ty) else if (f == "List.tail" || f == "List.reverse" || f == "List.concat" || f == "List.last" || f == "List.find" || f == "List.findLast") kitRetList(ty, ret) else if (f == "List.cons") kitRetCons(ty, ret) else if (f == "IO.pure") ioTy("String", ty) else if (f == "IO.fail") Str.concat("IO[", Str.concat(if (ty == "") "String" else ty, ", A]")) else if (f == "Deferred.get") defGetRet(ty) else if (f == "Queue.take") queueTakeRet(ty) else if (f == "Signal.list") kitRetSignalList(ty) else if (f == "Signal.getList") kitRetGetList(ty) else ret

def kitRetSignalList(ty: String): String =
  if (isListTy(ty) && ty != "List") Str.concat("Signal[", Str.concat(ty, "]")) else "Signal[List[A]]"

def kitRetGetList(ty: String): String =
  if (Str.startsWith(ty, "Signal[") && Str.len(ty) > 8) Str.slice(ty, 7, Str.len(ty) - 1) else "List"

def defGetRet(ty: String): String =
  if (Str.startsWith(ty, "Deferred[")) ioTy("String", elemOf(ty)) else "IO[A]"

def queueTakeRet(ty: String): String =
  if (Str.startsWith(ty, "Queue[")) ioTy("String", elemOf(ty)) else "IO[A]"

def kitRetOption(ty: String): String =
  Str.concat("Option[", Str.concat(elemOf(ty), "]"))

def kitRetMapOption(ty: String): String =
  Str.concat("Option[", Str.concat(mapValOf(ty), "]"))

def mapValOf(ty: String): String =
  mapValOf2(splitComma(elemOf(ty)))

def mapValOf2(parts: List[String]): String =
  if (List.isEmpty(parts) || List.isEmpty(List.tail(parts))) "A" else List.at(parts, 1)

def kitRetList(ty: String, ret: String): String =
  if (isListTy(ty)) ty else ret

def kitRetCons(ty: String, ret: String): String =
  if (ty == "") ret else Str.concat("List[", Str.concat(ty, "]"))

def resolveCall(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  resolveCall2(f, args, env, funs, ens, span)

def resolveCall2(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (isKit(f)) resolveKit(f, args, env, funs, ens, span) else if (isInstMeth(f)) resolveInst(f, args, env, funs, ens, span) else if (hasEn(ens, f)) inferCtor(f, args, env, funs, ens) else if (enOfCase(ens, f) != "") inferCtor(enOfCase(ens, f), args, env, funs, ens) else resolveFunOrUser(f, args, env, funs, ens, span, lookupEnv(env, f))

def resolveKit(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (f == "Resource.make" || f == "Resource.use") resolveResource(f, args, env, funs, ens, span) else if (isNetServe(f)) resolveNetServe(f, args, env, funs, ens, span) else if (f == "View.each") resolveViewEach(args, env, funs, ens, span) else if (f == "Signal.list" || f == "Signal.listN") resolveSignalList(f, args, env, funs, ens, span) else if (List.isEmpty(args) && !List.isEmpty(kitParams(f))) ok(funTyFrom(kitParams(f), kitRet(f))) else if (!arityOk(f, List.len(args))) bad(Str.concat(f, Str.concat(" expects ", Str.concat(Str.fromInt(List.len(kitParams(f))), Str.concat(" args, got ", Str.fromInt(List.len(args)))))), span) else checkKnown(f, want(f, List.len(args)), kitRet(f), args, env, funs, ens, span)

def enOfCase(ens: List[En], ctor: String): String =
  if (List.isEmpty(ens)) "" else enOfCase1(List.at(ens, 0), List.tail(ens), ctor)

def enOfCase1(h: En, rest: List[En], ctor: String): String =
  h match {
    case En(_, name, _, cases) => if (hasCase(cases, ctor)) name else enOfCase(rest, ctor)
  }

def hasCase(cs: List[EnCase], ctor: String): Bool =
  if (List.isEmpty(cs)) false else hasCase1(List.at(cs, 0), List.tail(cs), ctor)

def hasCase1(c: EnCase, rest: List[EnCase], ctor: String): Bool =
  c match {
    case EnCase(name, _) => name == ctor || hasCase(rest, ctor)
  }

def isInstMeth(f: String): Bool =
  Str.startsWith(f, ".") && f != ".apply"

def resolveInst(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(args)) bad(Str.concat("unknown function ", f), span) else resolveInst2(f, infer(stripNamed(List.at(args, 0)), env, funs, ens), args, env, funs, ens, span)

def resolveInst2(f: String, recv: Out, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (hasErr(recv)) recv else resolveInst3(f, recv.ty, args, env, funs, ens, span, findFunMod(funs, tyHead(recv.ty), Str.slice(f, 1, Str.len(f))))

def resolveInst3(f: String, ty: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), hit: List[Fun]): Out =
  if (!List.isEmpty(hit)) resolveUser(f, args, env, funs, ens, span, hit) else resolveInstKit(f, ty, args, env, funs, ens, span)

def kitNs(ty: String): String =
  kitNsH(tyHead(ty))

def kitNsH(h: String): String =
  if (h == "String") "Str" else h

def resolveInstKit(f: String, ty: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  resolveInstKit2(f, ty, args, env, funs, ens, span, Str.concat(kitNs(ty), Str.concat(".", Str.slice(f, 1, Str.len(f)))))

def resolveInstKit2(f: String, ty: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), q: String): Out =
  if (isKit(q)) resolveKit(q, args, env, funs, ens, span) else resolveInstCopy(f, ty, args, env, funs, ens, span)

def resolveInstCopy(f: String, ty: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (f == ".copy") resolveInstArgs(List.tail(args), env, funs, ens, ok(ty)) else resolveInstNamed(f, ty, args, env, funs, ens, span, findFun(funs, Str.slice(f, 1, Str.len(f))))

def resolveInstNamed(f: String, ty: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), hit: List[Fun]): Out =
  if (List.isEmpty(hit)) bad(Str.concat("unknown function ", f), span) else resolveInstHit(f, ty, args, env, funs, ens, span, List.at(hit, 0))

def resolveInstHit(f: String, ty: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), d: Fun): Out =
  d match {
    case Fun(_, _, _, ps, ret, _, _, _) => checkKnown(f, instWant(ps, ty), ret, args, env, funs, ens, span)
  }

def instWant(ps: List[Param], recvTy: String): List[String] =
  if (hasSelfParam(ps)) paramTys(ps) else recvTy :: paramTys(ps)

def hasSelfParam(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) false else hasSelfParam1(List.at(ps, 0))

def hasSelfParam1(p: Param): Bool =
  p match {
    case Param(n, _, _, _) => n == "self"
  }

def resolveInstArgs(args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], o: Out): Out =
  if (hasErr(o)) o else if (List.isEmpty(args)) o else resolveInstArgsGo(infer(stripNamed(List.at(args, 0)), env, funs, ens), List.tail(args), env, funs, ens, o)

def resolveInstArgsGo(h: Out, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], o: Out): Out =
  if (hasErr(h)) h else resolveInstArgs(rest, env, funs, ens, o)

def tyHead(t: String): String =
  tyHead2(brackAt(t, 0), t)

def tyHead2(b: Int, t: String): String =
  if (b < 0) t else Str.slice(t, 0, b)

def resourceKitRet(f: String): String =
  if (f == "Resource.make") "Resource" else if (f == "Resource.use") "IO[A]" else deferredKitRet(f)

def deferredKitRet(f: String): String =
  if (f == "Deferred.empty") "IO[Deferred]" else if (f == "Deferred.get") "IO[A]" else if (f == "Deferred.complete" || f == "Deferred.fail") "IO[Unit]" else queueKitRet(f)

def queueKitRet(f: String): String =
  if (f == "Queue.unbounded") "IO[Queue]" else if (f == "Queue.take") "IO[A]" else if (f == "Queue.offer") "IO[Unit]" else "A"

def resolveResource(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(args)) ok(funTyFrom(kitParams(f), resourceKitRet(f))) else if (List.len(args) != 2) bad(Str.concat(f, Str.concat(" expects 2 args, got ", Str.fromInt(List.len(args)))), span) else resolveResource2(f, infer(stripNamed(List.at(args, 0)), env, funs, ens), List.at(args, 1), env, funs, ens, span)

def resolveResource2(f: String, ao: Out, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (hasErr(ao)) ao else if (f == "Resource.make") resolveResMake(ao, lam, env, funs, ens, span) else resolveResUse(ao, lam, env, funs, ens, span)

def isRes(t: String): Bool =
  t == "Resource" || Str.startsWith(t, "Resource[")

def resTy(a: String): String =
  if (a == "" || isLoose(a)) "Resource" else Str.concat("Resource[", Str.concat(a, "]"))

def resPayload(t: String): String =
  if (isRes(t) && brackAt(t, 0) >= 0) elemOf(t) else "A"

def bindRes(p: String, ty: String, env: List[(String, String)]): List[(String, String)] =
  if (p == "_" || p == "") env else (p, ty) :: env

def resolveResMake(ao: Out, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (isIo(ao.ty) || isLoose(ao.ty)) resolveResLam(ao.ty, ioPayload(ao.ty), lam, env, funs, ens, span, resTy(ioPayload(ao.ty))) else bad(Str.concat("Resource.make needs IO, got ", ao.ty), span)

def resolveResUse(ao: Out, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (isRes(ao.ty) || isLoose(ao.ty)) resolveResLam(ao.ty, resPayload(ao.ty), lam, env, funs, ens, span, "") else bad(Str.concat("Resource.use needs Resource, got ", ao.ty), span)

def resolveResLam(recv: String, bind: String, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), makeRet: String): Out =
  lam match {
    case Expr.ELam(p, ty, body) => resolveResAnn(annOk(ty, bind, span), recv, p, body, env, funs, ens, span, makeRet)
    case Expr.ENamed(_, inner) => resolveResLam(recv, bind, inner, env, funs, ens, span, makeRet)
    case _ => bad(Str.concat(if (makeRet == "") "Resource.use" else "Resource.make", " needs a lambda"), span)
  }

def resolveResAnn(a: Out, recv: String, p: String, body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), makeRet: String): Out =
  if (hasErr(a)) a else resolveResBody(recv, infer(body, bindRes(p, bindOfAnn(a), env), funs, ens), span, makeRet)

def bindOfAnn(a: Out): String =
  a.ty

def resolveResBody(recv: String, body: Out, span: (String, Int), makeRet: String): Out =
  if (hasErr(body)) body else if (isIo(body.ty) || isLoose(body.ty)) ok(if (makeRet != "") makeRet else if (isIo(body.ty)) body.ty else "IO[A]") else bad(Str.concat(if (makeRet == "") "Resource.use" else "Resource.make", Str.concat(" needs IO, got ", Str.concat(recv, Str.concat(" and ", body.ty)))), span)

def netReqTy(): String =
  "(String, String, String)"

def isIoStr(t: String): Bool =
  isIo(t) && tyEq(ioOk(t), "String")

def netFunOk(ty: String): Bool =
  isFunTy(ty) && tyEq(funArgOf(ty), netReqTy()) && isIoStr(funRetOf(ty))

def resolveNetServe(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(args)) ok(funTyFrom(kitParams(f), kitRet(f))) else if (List.len(args) != 2) bad(Str.concat(f, Str.concat(" expects 2 args, got ", Str.fromInt(List.len(args)))), span) else resolveNetServe2(f, infer(stripNamed(List.at(args, 0)), env, funs, ens), List.at(args, 1), env, funs, ens, span)

def resolveNetServe2(f: String, po: Out, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (hasErr(po)) po else if (tyEq(po.ty, "Int")) resolveNetLam(f, lam, env, funs, ens, span) else argMismatch(f, "Int", po.ty, span)

def resolveNetLam(f: String, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  lam match {
    case Expr.ELam(p, ty, body) => resolveNetAnn(annOk(ty, netReqTy(), span), f, p, body, env, funs, ens, span)
    case Expr.ENamed(_, inner) => resolveNetLam(f, inner, env, funs, ens, span)
    case Expr.EAscribe(inner, _, _) => resolveNetLam(f, inner, env, funs, ens, span)
    case _ => resolveNetFun(f, infer(stripNamed(lam), env, funs, ens), span)
  }

def resolveNetAnn(a: Out, f: String, p: String, body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (hasErr(a)) a else resolveNetBody(f, infer(body, bindRes(p, bindOfAnn(a), env), funs, ens), span)

def resolveNetBody(f: String, body: Out, span: (String, Int)): Out =
  if (hasErr(body)) body else if (isIoStr(body.ty) || isLoose(body.ty)) ok("IO[Unit]") else bad(Str.concat(f, Str.concat(" needs IO[String], got ", body.ty)), span)

def resolveNetFun(f: String, o: Out, span: (String, Int)): Out =
  if (hasErr(o)) o else if (netFunOk(o.ty)) ok("IO[Unit]") else bad(Str.concat(f, " needs a lambda"), span)

def eachElemOf(ty: String): String =
  if (Str.startsWith(ty, "Signal[List[") && Str.len(ty) > 14) Str.slice(ty, 12, Str.len(ty) - 2) else "A"

def resolveViewEach(args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(args)) ok(funTyFrom(kitParams("View.each"), kitRet("View.each"))) else resolveViewEach2(infer(stripNamed(List.at(args, 0)), env, funs, ens), List.tail(args), env, funs, ens, span)

def resolveViewEach2(src: Out, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (hasErr(src)) src else if (List.isEmpty(rest)) ok("View") else resolveViewEachLam(src.ty, List.at(rest, 0), env, funs, ens, span)

def resolveViewEachLam(sigTy: String, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  lam match {
    case Expr.ELam(p, ty, body) => resolveViewEachAnn(annOk(ty, eachElemOf(sigTy), span), p, body, env, funs, ens, span)
    case Expr.ENamed(_, inner) => resolveViewEachLam(sigTy, inner, env, funs, ens, span)
    case Expr.EAscribe(inner, _, _) => resolveViewEachLam(sigTy, inner, env, funs, ens, span)
    case _ => resolveViewEachFun(infer(stripNamed(lam), env, funs, ens), eachElemOf(sigTy), span)
  }

def resolveViewEachAnn(a: Out, p: String, body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (hasErr(a)) a else resolveViewEachBody(infer(body, bindRes(p, bindOfAnn(a), env), funs, ens), span)

def resolveViewEachFun(o: Out, elem: String, span: (String, Int)): Out =
  if (hasErr(o)) o else if (isFunTy(o.ty) && tyEq(funArgOf(o.ty), elem) && (tyEq(funRetOf(o.ty), "View") || isLoose(funRetOf(o.ty)))) ok("View") else bad("View.each needs A => View", span)

def resolveViewEachBody(body: Out, span: (String, Int)): Out =
  if (hasErr(body)) body else if (tyEq(body.ty, "View") || isLoose(body.ty)) ok("View") else bad(Str.concat("View.each needs View, got ", body.ty), span)

def resolveSignalList(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(args)) ok(funTyFrom(kitParams(f), kitRet(f))) else resolveSignalList2(f, if (f == "Signal.listN" && !List.isEmpty(List.tail(args))) List.at(args, 1) else List.at(args, 0), env, funs, ens, span)

def resolveSignalList2(_f: String, xs: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  resolveSignalList3(infer(stripNamed(xs), env, funs, ens), span)

def resolveSignalList3(o: Out, span: (String, Int)): Out =
  if (hasErr(o)) o else if (isListTy(o.ty) || isLoose(o.ty)) ok(kitRetSignalList(o.ty)) else argMismatch("Signal.list", "List", o.ty, span)

def resolveFunOrUser(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), ty: String): Out =
  if (isFunTy(ty)) inferFunApply(ty, args, env, funs, ens, span) else resolveUser(f, args, env, funs, ens, span, findFunPrefer(funs, f, env))

def inferFunApply(ty: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(args)) bad("apply expects 1 arg", span) else if (List.len(args) == 1) inferFunApply1(ty, infer(List.at(args, 0), env, funs, ens), spanPick(exprSpan(env, List.at(args, 0)), span)) else inferFunApply1(ty, inferTuple(args, env, funs, ens), span)

def inferFunApply1(ty: String, o: Out, span: (String, Int)): Out =
  if (hasErr(o)) o else if (tyEq(o.ty, funArgOf(ty))) ok(funRetOf(ty)) else argMismatch("apply", funArgOf(ty), o.ty, span)

def elemOf(t: String): String =
  elemOf2(brackAt(t, 0), t)

def brackAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 91) i else brackAt(s, i + 1)

def elemOf2(b: Int, t: String): String =
  if (b < 0) "A" else Str.slice(t, b + 1, Str.len(t) - 1)

def resolveUser(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), hit: List[Fun]): Out =
  if (List.isEmpty(hit)) bad(Str.concat("unknown function ", f), span) else resolveUserHit(f, args, env, funs, ens, span, List.at(hit, 0))

def resolveUserHit(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), d: Fun): Out =
  d match {
    case Fun(_, _, _, ps, ret, _, _, _) => checkUser(f, ps, ret, args, env, funs, ens, span)
  }

def checkUser(f: String, ps: List[Param], ret: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  checkUserAl(f, ps, ret, args, env, funs, ens, span, alignCall(ps, args))

def checkUserAl(f: String, ps: List[Param], ret: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), al: (List[Expr], String)): Out =
  al match {
    case (xs, err) => if (err != "") bad(alignErr(f, err, ps, args), span) else checkKnown(f, paramTys(ps), ret, xs, env, funs, ens, span)
  }

def inferCall(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  resolveCall(f, args, env, funs, ens, span)

def inferPrint(inner: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferPrint2(infer(inner, env, funs, ens), env, inner, e)

def inferPrint2(o: Out, env: List[(String, String)], inner: Expr, e: Expr): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) o else if (ty == "String" || isLoose(ty)) ok("IO[Unit]") else bad(Str.concat("expected String, got ", ty), spanPick(exprSpan(env, inner), exprSpan(env, e)))
  }

def inferBin(op: String, l: Expr, r: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferBin2(op, infer(l, env, funs, ens), r, env, funs, ens, e)

def inferBin2(op: String, lo: Out, r: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(lo)) lo else inferBin3(op, lo, infer(r, env, funs, ens), env, e)

def inferBin3(op: String, lo: Out, ro: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(ro)) ro else inferBin4(op, lo.ty, ro.ty, exprSpan(env, e))

def inferBin4(op: String, lt: String, rt: String, span: (String, Int)): Out =
  if (isArith(op)) inferArith(lt, rt, span) else if (isEq(op)) inferEq(lt, rt, span) else if (isOrd(op)) inferOrd(lt, rt, span) else if (isLogic(op)) inferLogic(lt, rt, span) else if (isBit(op)) inferBit(lt, rt, span) else if (op == "::") ok(Str.concat("List[", Str.concat(lt, "]"))) else ok(lt)

def inferArith(lt: String, rt: String, span: (String, Int)): Out =
  if (numTy(lt) && numTy(rt)) ok(if (lt == "Float" || rt == "Float") "Float" else "Int") else bad(Str.concat("arithmetic needs Int or Float, got ", Str.concat(lt, Str.concat(" and ", rt))), span)

def numTy(t: String): Bool =
  t == "Int" || t == "Float" || isLoose(t)

def inferEq(lt: String, rt: String, span: (String, Int)): Out =
  if (tyEq(lt, rt)) ok("Bool") else bad(Str.concat("comparison type mismatch ", Str.concat(lt, Str.concat(" vs ", rt))), span)

def inferOrd(lt: String, rt: String, span: (String, Int)): Out =
  if (numTy(lt) && numTy(rt)) ok("Bool") else bad("ordered compare needs Int or Float", span)

def inferLogic(lt: String, rt: String, span: (String, Int)): Out =
  if (logicTy(lt) && logicTy(rt)) ok("Bool") else bad(Str.concat("logic needs Bool, got ", Str.concat(lt, Str.concat(" and ", rt))), span)

def logicTy(t: String): Bool =
  t == "Bool" || isLoose(t)

def inferBit(lt: String, rt: String, span: (String, Int)): Out =
  if (lt == "Int" && rt == "Int") ok("Int") else bad(Str.concat("bitwise needs Int, got ", Str.concat(lt, Str.concat(" and ", rt))), span)

def inferUn(op: String, inner: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferUn2(op, infer(inner, env, funs, ens), env, e)

def inferUn2(op: String, o: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(o)) o else if (op == "!") inferUnBool(o, env, e) else inferUnInt(o, env, e)

def inferUnBool(o: Out, env: List[(String, String)], e: Expr): Out =
  if (o.ty == "Bool" || isLoose(o.ty)) ok("Bool") else bad(Str.concat("expected Bool, got ", o.ty), exprSpan(env, e))

def inferUnInt(o: Out, env: List[(String, String)], e: Expr): Out =
  if (o.ty == "Int" || isLoose(o.ty)) ok("Int") else bad(Str.concat("expected Int, got ", o.ty), exprSpan(env, e))

def inferIf(c: Expr, t: Expr, el: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferIf2(infer(c, env, funs, ens), t, el, env, funs, ens, e)

def inferIf2(co: Out, t: Expr, el: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(co)) co else inferIf3(infer(t, env, funs, ens), el, env, funs, ens, e)

def inferIf3(to: Out, el: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(to)) to else inferIf4(to, infer(el, env, funs, ens), env, e)

def inferIf4(to: Out, eo: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(eo)) eo else if (tyEq(to.ty, eo.ty)) ok(prefer(to.ty, eo.ty)) else if (ifIoUnit(to.ty, eo.ty)) ok(ifIoPick(to.ty, eo.ty)) else bad(Str.concat("type mismatch: expected ", Str.concat(to.ty, Str.concat(", got ", eo.ty))), exprSpan(env, e))

def ifIoUnit(a: String, b: String): Bool =
  isIo(a) && b == "Unit" || isIo(b) && a == "Unit"

def ifIoPick(a: String, b: String): String =
  if (isIo(a)) a else b

def infer(e: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (needsPh(e)) infer(Expr.ELam("_ph", "", rewriteHole(e, "_ph")), env, funs, ens) else inferGo(e, env, funs, ens)

def needsPh(e: Expr): Bool =
  e match {
    case Expr.ELam(_, _, _) => false
    case Expr.EHole => true
    case Expr.EBin(_, l, r, _) => hasHole(l) || hasHole(r)
    case Expr.EUn(_, inner, _) => hasHole(inner)
    case Expr.ECall(f, args, _) => needsPhCall(f, args)
    case Expr.EMethod(recv, _, args, _) => (isBareHole(recv) || hasBareHoleArg(args)) && !isCompoundPh(recv) && !hasCompoundPhArg(args)
    case Expr.EField(recv, _, _) => isBareHole(recv)
    case _ => false
  }

def needsPhCall(f: String, args: List[Expr]): Bool =
  if (isHoKit(f)) false else hasBareHoleArg(args) && !hasCompoundPhArg(args)

def isHoKit(f: String): Bool =
  isKit(f) && kitHasFun(kitParams(f))

def kitHasFun(ps: List[String]): Bool =
  !List.isEmpty(ps) && (isFunTy(List.at(ps, 0)) || kitHasFun(List.tail(ps)))

def isBareHole(e: Expr): Bool =
  e match {
    case Expr.EHole => true
    case _ => false
  }

def isCompoundPh(e: Expr): Bool =
  hasHole(e) && !isBareHole(e)

def hasBareHoleArg(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (isBareHole(List.at(xs, 0)) || hasBareHoleArg(List.tail(xs)))

def hasCompoundPhArg(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (isCompoundPh(List.at(xs, 0)) || hasCompoundPhArg(List.tail(xs)))

def hasHole(e: Expr): Bool =
  e match {
    case Expr.EHole => true
    case Expr.EPrint(inner, _) => hasHole(inner)
    case Expr.ECall(_, args, _) => hasHoleList(args)
    case Expr.EMethod(recv, _, args, _) => hasHole(recv) || hasHoleList(args)
    case Expr.EField(recv, _, _) => hasHole(recv)
    case Expr.EBin(_, l, r, _) => hasHole(l) || hasHole(r)
    case Expr.EUn(_, inner, _) => hasHole(inner)
    case Expr.ELam(_, _, body) => hasHole(body)
    case Expr.EIf(c, t, el, _) => hasHole(c) || hasHole(t) || hasHole(el)
    case Expr.ENamed(_, inner) => hasHole(inner)
    case Expr.EAscribe(inner, _, _) => hasHole(inner)
    case Expr.EList(xs) => hasHoleList(xs)
    case Expr.ETuple(xs) => hasHoleList(xs)
    case _ => false
  }

def hasHoleList(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (hasHole(List.at(xs, 0)) || hasHoleList(List.tail(xs)))

def rewriteHole(e: Expr, n: String): Expr =
  e match {
    case Expr.EHole => Expr.EVar(n, 0)
    case Expr.EPrint(inner, _) => Expr.EPrint(rewriteHole(inner, n), 0)
    case Expr.ECall(f, args, _) => Expr.ECall(f, rewriteHoleList(args, n), 0)
    case Expr.EMethod(recv, name, args, _) => Expr.EMethod(rewriteHole(recv, n), name, rewriteHoleList(args, n), 0)
    case Expr.EField(recv, name, _) => Expr.EField(rewriteHole(recv, n), name, 0)
    case Expr.EBin(op, l, r, _) => Expr.EBin(op, rewriteHole(l, n), rewriteHole(r, n), 0)
    case Expr.EUn(op, inner, _) => Expr.EUn(op, rewriteHole(inner, n), 0)
    case Expr.ELam(p, ty, body) => Expr.ELam(p, ty, rewriteHole(body, n))
    case Expr.EIf(c, t, el, _) => Expr.EIf(rewriteHole(c, n), rewriteHole(t, n), rewriteHole(el, n), 0)
    case Expr.ENamed(nm, inner) => Expr.ENamed(nm, rewriteHole(inner, n))
    case Expr.EAscribe(inner, ty, off) => Expr.EAscribe(rewriteHole(inner, n), ty, off)
    case Expr.EList(xs) => Expr.EList(rewriteHoleList(xs, n))
    case Expr.ETuple(xs) => Expr.ETuple(rewriteHoleList(xs, n))
    case _ => e
  }

def rewriteHoleList(xs: List[Expr], n: String): List[Expr] =
  if (List.isEmpty(xs)) xs else rewriteHole(List.at(xs, 0), n) :: rewriteHoleList(List.tail(xs), n)

def inferGo(e: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  e match {
    case Expr.EInt(_, _) => ok("Int")
    case Expr.EBool(_) => ok("Bool")
    case Expr.EStr(_, _) => ok("String")
    case Expr.EFloat(_) => ok("Float")
    case Expr.EInterp(_) => ok("String")
    case Expr.EUnit => ok("Unit")
    case Expr.EHole => ok("Int")
    case Expr.EVar(s, off) => inferVar(s, env, funs, ens, (modFile(env), off))
    case Expr.EPrint(inner, _) => inferPrint(inner, env, funs, ens, e)
    case Expr.ECall(f, args, off) => inferCall(f, args, env, funs, ens, (modFile(env), off))
    case Expr.EBin(op, l, r, _) => inferBin(op, l, r, env, funs, ens, e)
    case Expr.EUn(op, inner, _) => inferUn(op, inner, env, funs, ens, e)
    case Expr.EIf(c, t, el, _) => inferIf(c, t, el, env, funs, ens, e)
    case Expr.ENamed(_, inner) => infer(inner, env, funs, ens)
    case Expr.EList(xs) => inferList(xs, env, funs, ens)
    case Expr.ETuple(xs) => inferTuple(xs, env, funs, ens)
    case Expr.EMethod(recv, name, args, _) => inferMethod(recv, name, args, env, funs, ens, e)
    case Expr.EField(recv, name, _) => inferField(recv, name, env, funs, ens)
    case Expr.ELam(p, ty, body) => inferLam(ty, infer(body, bindLam(p, ty, env), funs, ens))
    case Expr.EMatch(s, arms, _) => inferMatch(s, arms, env, funs, ens)
    case Expr.EFor(bs, body, _) => inferFor(bs, body, env, funs, ens)
    case Expr.EAscribe(inner, ty, off) => inferAscribe(inner, ty, off, env, funs, ens)
  }

def inferAscribe(inner: Expr, ty: String, off: Int, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferAscribe2(infer(inner, env, funs, ens), ty, (modFile(env), off))

def inferAscribe2(o: Out, ty: String, span: (String, Int)): Out =
  if (hasErr(o)) o else if (tyEq(o.ty, ty)) ok(prefer(ty, o.ty)) else bad(Str.concat("type mismatch: expected ", Str.concat(ty, Str.concat(", got ", o.ty))), span)

def inferLam(ty: String, o: Out): Out =
  if (hasErr(o)) o else ok(Str.concat(if (ty == "") "A" else ty, Str.concat(" => ", o.ty)))

def inferFor(bs: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferForGo(bs, body, env, funs, ens, "")

def inferForGo(bs: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], errTy: String): Out =
  if (List.isEmpty(bs)) inferFor2(infer(body, env, funs, ens), errTy) else inferForBind(List.at(bs, 0), List.tail(bs), body, env, funs, ens, errTy)

def inferForBind(b: Bind, rest: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], errTy: String): Out =
  b match {
    case Bind(d, name, v) => inferForBind2(d, name, infer(v, env, funs, ens), rest, body, env, funs, ens, errTy, exprSpan(env, v))
  }

def inferForBind2(d: Bool, name: String, vo: Out, rest: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], errTy: String, span: (String, Int)): Out =
  if (hasErr(vo)) vo else if (d) inferForDraw(name, vo.ty, rest, body, env, funs, ens, errTy, span) else inferForGo(rest, body, bindFor(false, name, vo.ty, env, ens), funs, ens, errTy)

def inferForDraw(name: String, ty: String, rest: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], errTy: String, span: (String, Int)): Out =
  if (Str.startsWith(ty, "Stream") || Str.startsWith(ty, "Resource")) bad(Str.concat("<- needs IO, got ", ty), span) else inferForDraw2(name, ty, rest, body, env, funs, ens, unifyErr(errTy, ioErr(ty), span))

def inferForDraw2(name: String, ty: String, rest: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], u: Out): Out =
  if (hasErr(u)) u else inferForGo(rest, body, bindFor(true, name, ty, env, ens), funs, ens, u.ty)

def bindFor(d: Bool, name: String, ty: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  if (name == "_" || name == "") env else bindPat(name, if (d) ioPayload(ty) else ty, env, ens)

def inferFor2(o: Out, errTy: String): Out =
  if (hasErr(o)) o else ok(ioTy(errTy, o.ty))

def forHasDraw(bs: List[Bind]): Bool =
  if (List.isEmpty(bs)) false else forHasDraw1(List.at(bs, 0), List.tail(bs))

def forHasDraw1(b: Bind, rest: List[Bind]): Bool =
  b match {
    case Bind(d, _, _) => d || forHasDraw(rest)
  }

def hasEn(ens: List[En], name: String): Bool =
  hasEnAt(ens, name, 0)

def hasEnAt(ens: List[En], name: String, i: Int): Bool =
  if (i >= List.len(ens)) false else hasEnHit(List.at(ens, i), ens, name, i)

def hasEnHit(h: En, ens: List[En], name: String, i: Int): Bool =
  if (h.name == name) true else hasEnAt(ens, name, i + 1)

def inferField(recv: Expr, name: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  recv match {
    case Expr.EVar(en, _) => if (hasEn(ens, en)) ok(en) else inferFieldVar(en, name, env, funs, ens)
    case _ => fieldOf(infer(recv, env, funs, ens), name, ens)
  }

def inferFieldVar(en: String, name: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferFieldHit(findFunMod(funs, en, name), en, name, env, funs, ens)

def inferFieldHit(hit: List[Fun], en: String, name: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(hit)) fieldOf(inferVar(en, env, funs, ens, noSpan()), name, ens) else ok(funTyOf(List.at(hit, 0)))

def fieldOf(o: Out, name: String, ens: List[En]): Out =
  if (hasErr(o)) o else fieldOf2(o.ty, name, ens, o.span)

def fieldOf2(ty: String, name: String, ens: List[En], span: (String, Int)): Out =
  if (isTup(ty) && isTupField(name)) tupFieldAt(splitComma(tupleInner(ty)), tupIdx(name), name, span) else if (isTup(ty) && tupBadName(name)) bad(Str.concat("tuple has no field ", name), span) else fieldOf3(fieldNamed(ens, ty, name), ty)

def isTupField(name: String): Bool =
  tupIdx(name) >= 0

def tupIdx(name: String): Int =
  if (Str.len(name) == 2 && Str.charAt(name, 0) == 95) tupIdxDig(Str.charAt(name, 1)) else 0 - 1

def tupIdxDig(c: Int): Int =
  if (c >= 49 && c <= 56) c - 49 else 0 - 1

def tupBadName(name: String): Bool =
  Str.len(name) >= 2 && Str.charAt(name, 0) == 95 && Str.charAt(name, 1) >= 48 && Str.charAt(name, 1) <= 57

def tupFieldAt(parts: List[String], i: Int, name: String, span: (String, Int)): Out =
  if (i < 0 || i >= List.len(parts)) bad(Str.concat("tuple has no field ", name), span) else ok(List.at(parts, i))

def fieldOf3(ft: String, ty: String): Out =
  if (ft == "") ok(ty) else ok(ft)

def fieldNamed(ens: List[En], ty: String, name: String): String =
  if (List.isEmpty(ens)) "" else fieldNamed1(List.at(ens, 0), List.tail(ens), ty, name)

def fieldNamed1(h: En, rest: List[En], ty: String, name: String): String =
  h match {
    case En(_, n, _, cases) => if (n == ty) fieldNamed2(cases, name) else fieldNamed(rest, ty, name)
  }

def fieldNamed2(cs: List[EnCase], name: String): String =
  if (List.isEmpty(cs)) "" else fieldNamed3(List.at(cs, 0), List.tail(cs), name)

def fieldNamed3(h: EnCase, rest: List[EnCase], name: String): String =
  h match {
    case EnCase(_, fields) => fieldNamed4(fields, name, rest)
  }

def fieldNamed4(fs: List[Param], name: String, rest: List[EnCase]): String =
  if (List.isEmpty(fs)) fieldNamed2(rest, name) else fieldNamed5(List.at(fs, 0), List.tail(fs), name, rest)

def fieldNamed5(p: Param, rest: List[Param], name: String, restCs: List[EnCase]): String =
  p match {
    case Param(n, ty, _, _) => if (n == name) ty else fieldNamed4(rest, name, restCs)
  }

def inferMatch(s: Expr, arms: List[Arm], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferMatch2(infer(s, env, funs, ens), arms, env, funs, ens)

def inferMatch2(o: Out, arms: List[Arm], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(o)) o else if (List.isEmpty(arms)) o else inferMatchArm(List.at(arms, 0), o.ty, env, funs, ens)

def inferMatchArm(arm: Arm, scrutTy: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  arm match {
    case Arm(pat, _, body) => infer(body, bindPat(pat, scrutTy, env, ens), funs, ens)
  }

def parenAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 40) i else parenAt(s, i + 1)

def patBind(pat: String): String =
  patBind2(parenAt(pat, 0), pat)

def patBind2(p: Int, pat: String): String =
  if (p < 0) "" else patBind3(p, closeParen(pat, p + 1, 1), pat)

def patBind3(p: Int, c: Int, pat: String): String =
  if (c < 0) Str.slice(pat, p + 1, Str.len(pat) - 1) else Str.slice(pat, p + 1, c)

def closeParen(s: String, i: Int, d: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else closeParenCh(s, i, d, Str.charAt(s, i))

def closeParenCh(s: String, i: Int, d: Int, c: Int): Int =
  if (c == 40) closeParen(s, i + 1, d + 1) else if (c == 41) closeParenDone(s, i, d) else closeParen(s, i + 1, d)

def closeParenDone(s: String, i: Int, d: Int): Int =
  if (d == 1) i else closeParen(s, i + 1, d - 1)

def patCore(pat: String): String =
  patCore2(parenAt(pat, 0), pat)

def patCore2(p: Int, pat: String): String =
  if (p < 0) pat else Str.slice(pat, 0, p)

def bindPat(pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindPat2(patBind(pat), pat, scrutTy, env, ens)

def bindPat2(b: String, pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  if (asAt(pat, 0) >= 0) bindAs(pat, scrutTy, env, ens) else if (consAt(pat, 0) >= 0) bindCons(pat, scrutTy, env, ens) else if (isTuplePat(pat)) bindTuple(pat, scrutTy, env) else if (hasComma(b)) bindTuple2(splitComma(b), recFieldTys(ens, patCore(pat)), env) else if (asAt(b, 0) >= 0) bindAs(b, bindTy(pat, scrutTy, ens), env, ens) else if (eqAt(b, 0) >= 0) bindEq(b, bindTy(pat, scrutTy, ens), env, ens) else if (consAt(b, 0) >= 0) bindCons(b, bindTy(pat, scrutTy, ens), env, ens) else if (b == "") bindBare(pat, scrutTy, env) else (b, bindTy(pat, scrutTy, ens)) :: env

def eqAt(s: String, i: Int): Int =
  eqAtD(s, i, 0)

def eqAtD(s: String, i: Int, d: Int): Int =
  if (i + 3 > Str.len(s)) 0 - 1 else if (d == 0 && Str.slice(s, i, i + 3) == " = ") i else eqAtD(s, i + 1, asDepth(s, i, d))

def bindEq(b: String, ty: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindPat(Str.slice(b, eqAt(b, 0) + 3, Str.len(b)), ty, env, ens)

def consAt(s: String, i: Int): Int =
  consAtD(s, i, 0)

def consAtD(s: String, i: Int, d: Int): Int =
  if (i + 4 > Str.len(s)) 0 - 1 else if (d == 0 && Str.slice(s, i, i + 4) == " :: ") i else consAtD(s, i + 1, asDepth(s, i, d))

def bindCons(pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindConsAt(consAt(pat, 0), pat, scrutTy, env, ens)

def bindConsAt(i: Int, pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindPat(Str.slice(pat, i + 4, Str.len(pat)), scrutTy, bindPat(Str.slice(pat, 0, i), elemOf(scrutTy), env, ens), ens)

def bindBare(pat: String, scrutTy: String, env: List[(String, String)]): List[(String, String)] =
  if (isBareName(pat)) (pat, scrutTy) :: env else env

def isBareName(s: String): Bool =
  Str.len(s) > 0 && isBareStart(Str.charAt(s, 0)) && s != "_"

def isBareStart(c: Int): Bool =
  c >= 65 && c <= 90 || c >= 97 && c <= 122

def asAt(s: String, i: Int): Int =
  asAtD(s, i, 0)

def asAtD(s: String, i: Int, d: Int): Int =
  if (i + 3 > Str.len(s)) 0 - 1 else if (d == 0 && Str.slice(s, i, i + 3) == " @ ") i else asAtD(s, i + 1, asDepth(s, i, d))

def asDepth(s: String, i: Int, d: Int): Int =
  asDepthCh(Str.charAt(s, i), d)

def asDepthCh(c: Int, d: Int): Int =
  if (c == 40) d + 1 else if (c == 41 && d > 0) d - 1 else if (c == 41) 0 else d

def bindAs(pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindAsAt(asAt(pat, 0), pat, scrutTy, env, ens)

def bindAsAt(i: Int, pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindPat(Str.slice(pat, i + 3, Str.len(pat)), scrutTy, (Str.slice(pat, 0, i), scrutTy) :: env, ens)

def isTuplePat(pat: String): Bool =
  Str.len(pat) > 0 && Str.charAt(pat, 0) == 40

def bindTuple(pat: String, scrutTy: String, env: List[(String, String)]): List[(String, String)] =
  bindTuple2(splitComma(Str.slice(pat, 1, Str.len(pat) - 1)), splitComma(tupleInner(scrutTy)), env)

def tupleInner(ty: String): String =
  if (Str.len(ty) > 0 && Str.charAt(ty, 0) == 40) Str.slice(ty, 1, Str.len(ty) - 1) else ty

def splitComma(s: String): List[String] =
  splitCommaAt(s, commaAt(s, 0))

def commaAt(s: String, i: Int): Int =
  commaAtD(s, i, 0)

def commaAtD(s: String, i: Int, d: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else commaAtC(s, i, d, Str.charAt(s, i))

def commaAtC(s: String, i: Int, d: Int, c: Int): Int =
  if (c == 40) commaAtD(s, i + 1, d + 1) else if (c == 41) commaAtD(s, i + 1, if (d > 0) d - 1 else 0) else if (c == 44 && d == 0) i else commaAtD(s, i + 1, d)

def splitCommaAt(s: String, c: Int): List[String] =
  if (c < 0) trimName(s) :: noStr() else trimName(Str.slice(s, 0, c)) :: splitComma(Str.slice(s, c + 1, Str.len(s)))

def trimName(s: String): String =
  trimName2(s, 0, Str.len(s))

def trimName2(s: String, a: Int, b: Int): String =
  if (a >= b) "" else if (Str.charAt(s, a) == 32) trimName2(s, a + 1, b) else if (Str.charAt(s, b - 1) == 32) trimName2(s, a, b - 1) else Str.slice(s, a, b)

def bindTuple2(ns: List[String], ts: List[String], env: List[(String, String)]): List[(String, String)] =
  if (List.isEmpty(ns)) env else bindSlot(List.at(ns, 0), if (List.isEmpty(ts)) "A" else List.at(ts, 0), bindTuple2(List.tail(ns), if (List.isEmpty(ts)) ts else List.tail(ts), env))

def bindSlot(n: String, ty: String, env: List[(String, String)]): List[(String, String)] =
  if (isTuplePat(n)) bindTuple(n, ty, env) else (n, ty) :: env

def bindTy(pat: String, scrutTy: String, ens: List[En]): String =
  bindTyGot(patCore(pat), fieldTy(ens, patCore(pat)), scrutTy)

def bindTyGot(core: String, ft: String, scrutTy: String): String =
  if (ft == "") ctorElem(core, scrutTy) else ft

def ctorElem(core: String, scrutTy: String): String =
  ctorElem2(ctorName(core), splitComma(elemOf(scrutTy)))

def ctorName(core: String): String =
  ctorName2(dotAt(core, 0), core)

def ctorName2(d: Int, core: String): String =
  if (d < 0) core else Str.slice(core, d + 1, Str.len(core))

def ctorElem2(name: String, args: List[String]): String =
  if (List.isEmpty(args)) "A" else if (name == "Right" || name == "Err") ctorSecond(args) else List.at(args, 0)

def ctorSecond(args: List[String]): String =
  if (List.isEmpty(List.tail(args))) List.at(args, 0) else List.at(List.tail(args), 0)

def fieldTy(ens: List[En], core: String): String =
  fieldTy2(dotAt(core, 0), core, ens)

def dotAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 46) i else dotAt(s, i + 1)

def fieldTy2(dot: Int, core: String, ens: List[En]): String =
  if (dot < 0) "" else caseFieldTy(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def caseFieldTy(ens: List[En], en: String, ctor: String): String =
  if (List.isEmpty(ens)) "" else caseFieldTy1(List.at(ens, 0), List.tail(ens), en, ctor)

def caseFieldTy1(h: En, rest: List[En], en: String, ctor: String): String =
  h match {
    case En(_, name, _, cases) => if (name == en) caseFieldTy2(cases, ctor) else caseFieldTy(rest, en, ctor)
  }

def caseFieldTy2(cs: List[EnCase], ctor: String): String =
  if (List.isEmpty(cs)) "" else caseFieldTy3(List.at(cs, 0), List.tail(cs), ctor)

def caseFieldTy3(h: EnCase, rest: List[EnCase], ctor: String): String =
  h match {
    case EnCase(name, fields) => if (name == ctor) firstFieldTy(fields) else caseFieldTy2(rest, ctor)
  }

def firstFieldTy(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else paramTyOf(List.at(ps, 0))

def paramTyOf(p: Param): String =
  p match {
    case Param(_, ty, _, _) => ty
  }

def hasComma(s: String): Bool =
  commaAt(s, 0) >= 0

def recFieldTys(ens: List[En], core: String): List[String] =
  recFieldTys2(dotAt(core, 0), core, ens)

def recFieldTys2(dot: Int, core: String, ens: List[En]): List[String] =
  if (dot < 0) enFieldTys(ens, core) else caseFieldTys(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def enFieldTys(ens: List[En], name: String): List[String] =
  if (List.isEmpty(ens)) noStr() else enFieldTys1(List.at(ens, 0), List.tail(ens), name)

def enFieldTys1(h: En, rest: List[En], name: String): List[String] =
  h match {
    case En(_, n, _, cases) => if (n == name) firstCaseTys(cases) else enFieldTys(rest, name)
  }

def firstCaseTys(cs: List[EnCase]): List[String] =
  if (List.isEmpty(cs)) noStr() else firstCaseTys1(List.at(cs, 0))

def firstCaseTys1(c: EnCase): List[String] =
  c match {
    case EnCase(_, fields) => paramTys(fields)
  }

def caseFieldTys(ens: List[En], en: String, ctor: String): List[String] =
  if (List.isEmpty(ens)) noStr() else caseFieldTys1(List.at(ens, 0), List.tail(ens), en, ctor)

def caseFieldTys1(h: En, rest: List[En], en: String, ctor: String): List[String] =
  h match {
    case En(_, name, _, cases) => if (name == en) caseFieldTys2(cases, ctor) else caseFieldTys(rest, en, ctor)
  }

def caseFieldTys2(cs: List[EnCase], ctor: String): List[String] =
  if (List.isEmpty(cs)) noStr() else caseFieldTys3(List.at(cs, 0), List.tail(cs), ctor)

def caseFieldTys3(h: EnCase, rest: List[EnCase], ctor: String): List[String] =
  h match {
    case EnCase(name, fields) => if (name == ctor) paramTys(fields) else caseFieldTys2(rest, ctor)
  }

def inferMethod(recv: Expr, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (name == "require") inferRequire(recv, args, env, funs, ens, e) else if (name == "flatMap") inferFlatMap(recv, args, env, funs, ens, e) else if (name == "handleErrorWith") inferHandle(recv, args, env, funs, ens, e) else if (name == "map") inferIoMap(recv, args, env, funs, ens, e) else if (name == "apply") inferApply(recv, args, env, funs, ens, e) else inferMethod2(recv, name, args, env, funs, ens, e)

def inferRequire(recv: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferRequire2(infer(recv, env, funs, ens), args, env, funs, ens, e)

def inferRequire2(o: Out, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (List.len(args) > 2) bad("require expects at most 2 args", exprSpan(env, e)) else inferRequirePred(o, requirePredExpr(args), env, funs, ens, e)

def requirePredExpr(args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EBool(true) else if (List.len(args) == 1) List.at(args, 0) else List.at(List.tail(args), 0)

def inferRequirePred(recv: Out, pred: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  pred match {
    case Expr.ELam(p, ty, body) => inferRequireLam(recv, infer(body, bindLam(p, requireBindTy(ty, recv.ty), env), funs, ens), env, e)
    case Expr.ENamed(_, inner) => inferRequirePred(recv, inner, env, funs, ens, e)
    case _ => inferRequirePredTy(recv, infer(pred, env, funs, ens), env, e)
  }

def requireBindTy(ann: String, recvTy: String): String =
  if (ann != "") ann else if (isIo(recvTy)) ioOk(recvTy) else recvTy

def inferRequireLam(recv: Out, body: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(body)) body else if (body.ty == "Bool" || isLoose(body.ty)) ok(recv.ty) else bad(Str.concat("require pred must be Bool, got ", body.ty), exprSpan(env, e))

def inferRequirePredTy(recv: Out, po: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(po)) po else if (requirePredOk(po.ty)) ok(recv.ty) else bad(Str.concat("require pred must be Bool, IO[Bool], or A => Bool, got ", po.ty), exprSpan(env, e))

def requirePredOk(ty: String): Bool =
  ty == "Bool" || isLoose(ty) || isIo(ty) && (ioOk(ty) == "Bool" || isLoose(ioOk(ty))) || isFunTy(ty) && (funRetOf(ty) == "Bool" || isLoose(funRetOf(ty)))

def inferApply(recv: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferApply2(infer(recv, env, funs, ens), args, env, funs, ens, e)

def inferApply2(o: Out, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (isFunTy(o.ty) || isLoose(o.ty)) inferFunApply(o.ty, args, env, funs, ens, exprSpan(env, e)) else bad(Str.concat("apply needs a function, got ", o.ty), exprSpan(env, e))

def inferMethod2(recv: Expr, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  recv match {
    case Expr.EVar(en, _) => if (getTy(env, en) != "") inferCall(Str.concat(".", name), recv :: args, env, funs, ens, exprSpan(env, e)) else inferMethodEn(en, name, args, env, funs, ens, e)
    case _ => inferCall(Str.concat(".", name), recv :: args, env, funs, ens, exprSpan(env, e))
  }

def inferMethodEn(en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferMethodQual(Str.concat(en, Str.concat(".", name)), en, name, args, env, funs, ens, e)

def inferMethodQual(q: String, en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (isKit(q)) inferCall(q, args, env, funs, ens, exprSpan(env, e)) else if (hasEn(ens, en)) inferCtor(en, args, env, funs, ens) else resolveQual(en, name, args, env, funs, ens, e)

def resolveQual(en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  resolveQualHit(en, name, args, env, funs, ens, findFunMod(funs, en, name), e)

def resolveQualHit(en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], hit: List[Fun], e: Expr): Out =
  if (List.isEmpty(hit)) bad(Str.concat("unknown function ", Str.concat(en, Str.concat(".", name))), exprSpan(env, e)) else resolveUser(Str.concat(en, Str.concat(".", name)), args, env, funs, ens, exprSpan(env, e), hit)

def inferCtor(en: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(args)) ok(en) else inferCtorHead(en, List.at(args, 0), List.tail(args), env, funs, ens)

def inferCtorHead(en: String, h: Expr, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferCtorFrom(en, infer(h, env, funs, ens), rest, env, funs, ens)

def inferCtorFrom(en: String, o: Out, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(o)) o else inferCtorRest(en, o, firstArgErr(rest, env, funs, ens), ens)

def inferCtorRest(en: String, o: Out, restErr: Out, ens: List[En]): Out =
  if (hasErr(restErr)) restErr else inferCtor2(en, o, ens)

def inferCtor2(en: String, o: Out, ens: List[En]): Out =
  if (hasErr(o)) o else if (enHasParams(ens, en)) ok(Str.concat(en, Str.concat("[", Str.concat(o.ty, "]")))) else ok(en)

def enHasParams(ens: List[En], name: String): Bool =
  if (List.isEmpty(ens)) false else enHasParams1(List.at(ens, 0), List.tail(ens), name)

def enHasParams1(h: En, rest: List[En], name: String): Bool =
  h match {
    case En(_, n, tps, _) => if (n == name) List.len(tps) > 0 else enHasParams(rest, name)
  }

def isIo(t: String): Bool =
  t == "IO" || Str.startsWith(t, "IO[")

def ioEq(a: String, b: String): Bool =
  isIo(a) && isIo(b) && tyEq(ioErr(a), ioErr(b)) && tyEq(ioOk(a), ioOk(b))

def ioParts(t: String): List[String] =
  if (isIo(t)) splitComma(elemOf(t)) else noStr()

def ioErr(t: String): String =
  ioErrParts(ioParts(t))

def ioErrParts(ps: List[String]): String =
  if (List.len(ps) >= 2) List.at(ps, 0) else "String"

def ioOk(t: String): String =
  ioOkParts(ioParts(t))

def ioOkParts(ps: List[String]): String =
  if (List.isEmpty(ps)) "A" else if (List.len(ps) == 1) List.at(ps, 0) else List.at(ps, List.len(ps) - 1)

def ioTy(e: String, a: String): String =
  if (e == "" || e == "String") Str.concat("IO[", Str.concat(a, "]")) else Str.concat("IO[", Str.concat(e, Str.concat(", ", Str.concat(a, "]"))))

def unifyErr(a: String, b: String, span: (String, Int)): Out =
  if (a == "") ok(if (b == "") "String" else b) else if (b == "") ok(a) else if (tyEq(a, b)) ok(prefer(a, b)) else bad(Str.concat("fail type mismatch: expected ", Str.concat(a, Str.concat(", got ", b))), span)

def inferFlatMap(recv: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferFlatMap2(infer(recv, env, funs, ens), args, env, funs, ens, e)

def inferIoMap(recv: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferIoMap2(infer(recv, env, funs, ens), recv, args, env, funs, ens, e)

def inferIoMap2(o: Out, recv: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (!isIo(o.ty)) inferMethod2(recv, "map", args, env, funs, ens, e) else if (List.len(args) != 1) bad(Str.concat("map expects 1 args, got ", Str.fromInt(List.len(args))), exprSpan(env, e)) else inferIoMapLam(o, List.at(args, 0), env, funs, ens, e)

def inferIoMapLam(recv: Out, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  lam match {
    case Expr.ELam(p, ty, body) => inferIoMapAnn(annOk(ty, ioPayload(recv.ty), exprSpan(env, e)), recv, p, body, env, funs, ens, e)
    case Expr.EMatch(_, _, _) => inferIoMap3(recv, infer(lam, env, funs, ens), env, e)
    case _ => bad("map needs a lambda", exprSpan(env, e))
  }

def inferIoMapAnn(a: Out, recv: Out, p: String, body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(a)) a else inferIoMap3(recv, infer(body, bindIo(p, recv.ty, env), funs, ens), env, e)

def inferIoMap3(recv: Out, body: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(body)) body else ok(ioTy(ioErr(recv.ty), body.ty))

def inferFlatMap2(o: Out, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (List.len(args) != 1) bad(Str.concat("flatMap expects 1 args, got ", Str.fromInt(List.len(args))), exprSpan(env, e)) else inferFlatMapLam(o, List.at(args, 0), env, funs, ens, e)

def inferFlatMapLam(recv: Out, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  lam match {
    case Expr.ELam(p, ty, body) => inferFlatMapAnn(annOk(ty, ioPayload(recv.ty), exprSpan(env, e)), recv, p, body, env, funs, ens, e)
    case _ => inferFlatMap3(recv, infer(lam, env, funs, ens), env, e)
  }

def inferFlatMapAnn(a: Out, recv: Out, p: String, body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(a)) a else inferFlatMap3(recv, infer(body, bindIo(p, recv.ty, env), funs, ens), env, e)

def bindIo(p: String, ioTy: String, env: List[(String, String)]): List[(String, String)] =
  if (p == "_" || p == "") env else (p, ioPayload(ioTy)) :: env

def ioPayload(t: String): String =
  if (isIo(t)) ioOk(t) else "A"

def inferFlatMap3(recv: Out, body: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(body)) body else inferFlatMap4(recv, body, env, e)

def inferFlatMap4(recv: Out, body: Out, env: List[(String, String)], e: Expr): Out =
  if (isIo(recv.ty) && isIo(body.ty)) inferFlatMapErr(recv, body, env, e) else if (isIo(recv.ty) && isLoose(body.ty)) ok(recv.ty) else if (isLoose(recv.ty)) ok(if (isIo(body.ty)) body.ty else "IO[A]") else bad(Str.concat("flatMap needs IO, got ", Str.concat(recv.ty, Str.concat(" and ", body.ty))), exprSpan(env, e))

def inferFlatMapErr(recv: Out, body: Out, env: List[(String, String)], e: Expr): Out =
  inferFlatMapErr2(unifyErr(ioErr(recv.ty), ioErr(body.ty), exprSpan(env, e)), recv, body)

def inferFlatMapErr2(u: Out, recv: Out, body: Out): Out =
  if (hasErr(u)) u else ok(ioTy(u.ty, ioOk(body.ty)))

def inferHandle(recv: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferHandle2(infer(recv, env, funs, ens), args, env, funs, ens, e)

def inferHandle2(o: Out, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (List.len(args) != 1) bad(Str.concat("handleErrorWith expects 1 args, got ", Str.fromInt(List.len(args))), exprSpan(env, e)) else inferHandleLam(o, List.at(args, 0), env, funs, ens, e)

def inferHandleLam(recv: Out, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  lam match {
    case Expr.ELam(p, ty, body) => inferHandleAnn(annOk(ty, ioErr(recv.ty), exprSpan(env, e)), recv, p, body, env, funs, ens, e)
    case _ => inferHandle3(recv, infer(lam, env, funs, ens), env, e)
  }

def inferHandleAnn(a: Out, recv: Out, p: String, body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(a)) a else inferHandle3(recv, infer(body, bindHandle(p, recv.ty, env), funs, ens), env, e)

def bindHandle(p: String, ioTy: String, env: List[(String, String)]): List[(String, String)] =
  if (p == "_" || p == "") env else (p, ioErr(ioTy)) :: env

def inferHandle3(recv: Out, body: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(body)) body else if (isIo(recv.ty) && isIo(body.ty)) inferHandleOk(recv, body, env, e) else if (isIo(recv.ty) && isLoose(body.ty)) ok(recv.ty) else bad(Str.concat("handleErrorWith needs IO, got ", Str.concat(recv.ty, Str.concat(" and ", body.ty))), exprSpan(env, e))

def inferHandleOk(recv: Out, body: Out, env: List[(String, String)], e: Expr): Out =
  if (tyEq(ioOk(recv.ty), ioOk(body.ty))) ok(ioTy(ioErr(body.ty), ioOk(recv.ty))) else bad(Str.concat("handleErrorWith type mismatch: expected ", Str.concat(ioOk(recv.ty), Str.concat(", got ", ioOk(body.ty)))), exprSpan(env, e))

def inferVar(s: String, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  inferVar2(s, getTy(env, s), env, funs, ens, span)

def inferVar2(s: String, t: String, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (s == "") bad("unexpected token", span) else if (t == "") inferVarFun(s, findFunPrefer(funs, s, env), ens, span) else ok(t)

def inferVarFun(s: String, hit: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(hit)) inferVarCase(s, ens, span) else ok(funTyOf(List.at(hit, 0)))

def inferVarCase(s: String, ens: List[En], span: (String, Int)): Out =
  if (enOfCase(ens, s) == "") bad(Str.concat("unbound variable ", s), span) else ok(enOfCase(ens, s))

def funTyOf(d: Fun): String =
  d match {
    case Fun(_, _, _, ps, ret, _, _, _) => funTyFrom(paramTys(ps), ret)
  }

def funTyFrom(ps: List[String], ret: String): String =
  if (List.isEmpty(ps)) ret else if (List.len(ps) == 1) Str.concat(List.at(ps, 0), Str.concat(" => ", ret)) else Str.concat("(", Str.concat(joinComma(ps), Str.concat(") => ", ret)))

def joinComma(ps: List[String]): String =
  if (List.isEmpty(ps)) "" else if (List.isEmpty(List.tail(ps))) List.at(ps, 0) else Str.concat(List.at(ps, 0), Str.concat(", ", joinComma(List.tail(ps))))

def inferList(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(xs)) ok("List") else inferList2(infer(List.at(xs, 0), env, funs, ens))

def inferList2(o: Out): Out =
  if (hasErr(o)) o else ok(Str.concat("List[", Str.concat(o.ty, "]")))

def inferTuple(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferTupleAcc(xs, env, funs, ens, "")

def inferTupleAcc(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  if (List.isEmpty(xs)) inferTupleDone(acc) else inferTupleHd(List.at(xs, 0), xs, env, funs, ens, acc)

def inferTupleDone(acc: String): Out =
  if (acc == "") ok("Unit") else ok(Str.concat("(", Str.concat(acc, ")")))

def inferTupleHd(h: Expr, xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  inferTupleGot(infer(stripNamed(h), env, funs, ens), xs, env, funs, ens, acc)

def inferTupleGot(o: Out, xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else inferTupleRest(List.tail(xs), env, funs, ens, if (acc == "") ty else Str.concat(acc, Str.concat(", ", ty)))
  }

def inferTupleRest(rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  inferTupleAcc(rest, env, funs, ens, acc)

def checkDef(d: Fun, funs: List[Fun], ens: List[En]): Out =
  d match {
    case Fun(_, name, _, ps, ret, body, mod, off) => checkDefWhere(name, ret, body, ps, funs, ens, mod, off, checkWheres(ps, bindParams(ps, ("self", "A") :: ("#mod", mod) :: noEnv()), funs, ens, (mod, off)))
  }

def checkDefWhere(name: String, ret: String, body: Expr, ps: List[Param], funs: List[Fun], ens: List[En], mod: String, off: Int, wo: Out): Out =
  if (hasErr(wo)) checkDefWrap(name, ret, body, wo, (mod, off)) else checkDefWrap(name, ret, body, infer(body, bindParams(ps, ("self", "A") :: ("#mod", mod) :: noEnv()), funs, ens), (mod, off))

def checkWheres(ps: List[Param], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(ps)) ok("Bool") else checkWhereHd(List.at(ps, 0), List.tail(ps), env, funs, ens, span)

def checkWhereHd(p: Param, rest: List[Param], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  p match {
    case Param(n, _, w, _) => checkWhereGo(n, w, rest, env, funs, ens, span)
  }

def checkWhereGo(n: String, w: String, rest: List[Param], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (w == "") checkWheres(rest, env, funs, ens, span) else checkWhereTy(infer(dfltExpr(w), env, funs, ens), n, rest, env, funs, ens, span)

def checkWhereTy(o: Out, n: String, rest: List[Param], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (hasErr(o)) o else if (o.ty == "Bool") checkWheres(rest, env, funs, ens, span) else bad(Str.concat("where on ", Str.concat(n, Str.concat(" must be Bool, got ", o.ty))), span)

def checkEns(ens: List[En], funs: List[Fun]): Out =
  checkEnsGo(ens, ens, funs)

def checkEnsGo(rest: List[En], ens: List[En], funs: List[Fun]): Out =
  if (List.isEmpty(rest)) ok("Bool") else checkEnHd(List.at(rest, 0), List.tail(rest), ens, funs)

def checkEnHd(h: En, rest: List[En], ens: List[En], funs: List[Fun]): Out =
  h match {
    case En(_, _, _, cases) => checkEnsAfter(checkEnCases(cases, ens, funs), rest, ens, funs)
  }

def checkEnsAfter(o: Out, rest: List[En], ens: List[En], funs: List[Fun]): Out =
  if (hasErr(o)) o else checkEnsGo(rest, ens, funs)

def checkEnCases(cs: List[EnCase], ens: List[En], funs: List[Fun]): Out =
  if (List.isEmpty(cs)) ok("Bool") else checkEnCaseHd(List.at(cs, 0), List.tail(cs), ens, funs)

def checkEnCaseHd(c: EnCase, rest: List[EnCase], ens: List[En], funs: List[Fun]): Out =
  c match {
    case EnCase(_, fs) => checkEnCasesAfter(checkWheres(fs, bindParams(fs, noEnv()), funs, ens, noSpan()), rest, ens, funs)
  }

def checkEnCasesAfter(o: Out, rest: List[EnCase], ens: List[En], funs: List[Fun]): Out =
  if (hasErr(o)) o else checkEnCases(rest, ens, funs)

def checkDefWrap(name: String, ret: String, body: Expr, o: Out, span: (String, Int)): Out =
  if (hasErr(o)) bad(Str.concat("in ", Str.concat(name, Str.concat(": ", o.err))), o.span) else checkDefGot(name, ret, body, o, span)

def checkDefGot(name: String, ret: String, body: Expr, o: Out, span: (String, Int)): Out =
  if (hasErr(o)) o else if (tyEq(o.ty, ret)) o else bad(Str.concat("def ", Str.concat(name, Str.concat(" body ", Str.concat(o.ty, Str.concat(" does not match declared ", ret))))), spanPick(Parse.spanOf(body), span))

def spanPick(a: (String, Int), b: (String, Int)): (String, Int) =
  a match {
    case (sa, oa) => b match {
  case (sb, _) => if (oa < 0) b else (if (sa == "") sb else sa, oa)
}
  }

def checkProg(p: Prog): Out =
  checkProgOwn(p, [])

def checkProgOwn(p: Prog, stems: List[String]): Out =
  p match {
    case Prog(_, enums, aliases, _, impls, imps, defs, main, body) => checkProgGo(expandDefs(withImportFuns(imps, implFuns(impls, defs)), aliases), Parse.builtins(enums), main, body, stems)
  }

def checkProgGo(ds: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  checkProgAfterEns(checkEns(enums, ds), ds, enums, main, body, stems)

def checkProgAfterEns(o: Out, ds: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  if (hasErr(o)) o else checkDefsRest(ds, ds, enums, main, body, stems)

def implFuns(impls: List[Im], defs: List[Fun]): List[Fun] =
  if (List.isEmpty(impls)) defs else implFuns(List.tail(impls), implMeths(List.at(impls, 0), defs))

def implMeths(im: Im, defs: List[Fun]): List[Fun] =
  im match {
    case Im(_, _, forTy, methods) => stampMod(methods, forTy, defs)
  }

def stampMod(ms: List[Fun], mod: String, defs: List[Fun]): List[Fun] =
  if (List.isEmpty(ms)) defs else stampFun(List.at(ms, 0), mod) :: stampMod(List.tail(ms), mod, defs)

def stampFun(d: Fun, mod: String): Fun =
  d match {
    case Fun(priv, name, ts, ps, ret, body, _, off) => Fun(priv, name, ts, Param("self", mod, "", "") :: ps, ret, body, mod, off)
  }

def withImportFuns(imps: List[Imp], defs: List[Fun]): List[Fun] =
  List.concat(importFuns(imps, defs), defs)

def importFuns(imps: List[Imp], defs: List[Fun]): List[Fun] =
  if (List.isEmpty(imps)) [] else importFunsGo(List.at(imps, 0), List.tail(imps), defs)

def importFunsGo(h: Imp, rest: List[Imp], defs: List[Fun]): List[Fun] =
  List.concat(importFun1(h, defs), importFuns(rest, defs))

def importFun1(h: Imp, defs: List[Fun]): List[Fun] =
  h match {
    case Imp(mod, name, alias) => if (alias == "") [] else renameHits(findFunMod(defs, mod, name), alias)
  }

def renameHits(hit: List[Fun], alias: String): List[Fun] =
  if (List.isEmpty(hit)) [] else renameFun(List.at(hit, 0), alias) :: []

def renameFun(d: Fun, alias: String): Fun =
  d match {
    case Fun(priv, _, ts, ps, ret, body, mod, off) => Fun(priv, alias, ts, ps, ret, body, mod, off)
  }

def expandDefs(defs: List[Fun], als: List[Alias]): List[Fun] =
  List.reverse(expandDefsGo(defs, als, []))

def expandDefsGo(defs: List[Fun], als: List[Alias], acc: List[Fun]): List[Fun] =
  if (List.isEmpty(defs)) acc else expandDefsGo(List.tail(defs), als, expandDef(List.at(defs, 0), als) :: acc)

def expandDef(d: Fun, als: List[Alias]): Fun =
  d match {
    case Fun(priv, name, ts, ps, ret, body, mod, off) => Fun(priv, name, ts, expandParams(ps, als), expandTy(ret, als), expandExpr(body, als), mod, off)
  }

def expandExpr(e: Expr, als: List[Alias]): Expr =
  e match {
    case Expr.EAscribe(inner, ty, off) => Expr.EAscribe(expandExpr(inner, als), expandTy(ty, als), off)
    case Expr.ELam(p, ty, body) => Expr.ELam(p, expandTy(ty, als), expandExpr(body, als))
    case Expr.EPrint(inner, off) => Expr.EPrint(expandExpr(inner, als), off)
    case Expr.ECall(f, args, off) => Expr.ECall(f, expandExprs(args, als), off)
    case Expr.EMethod(recv, name, args, off) => Expr.EMethod(expandExpr(recv, als), name, expandExprs(args, als), off)
    case Expr.EField(recv, name, off) => Expr.EField(expandExpr(recv, als), name, off)
    case Expr.EBin(op, l, r, off) => Expr.EBin(op, expandExpr(l, als), expandExpr(r, als), off)
    case Expr.EUn(op, inner, off) => Expr.EUn(op, expandExpr(inner, als), off)
    case Expr.EIf(c, t, el, off) => Expr.EIf(expandExpr(c, als), expandExpr(t, als), expandExpr(el, als), off)
    case Expr.EMatch(s, arms, off) => Expr.EMatch(expandExpr(s, als), expandArms(arms, als), off)
    case Expr.EFor(bs, body, off) => Expr.EFor(expandBinds(bs, als), expandExpr(body, als), off)
    case Expr.EList(xs) => Expr.EList(expandExprs(xs, als))
    case Expr.ETuple(xs) => Expr.ETuple(expandExprs(xs, als))
    case Expr.ENamed(n, inner) => Expr.ENamed(n, expandExpr(inner, als))
    case _ => e
  }

def expandExprs(xs: List[Expr], als: List[Alias]): List[Expr] =
  if (List.isEmpty(xs)) xs else expandExpr(List.at(xs, 0), als) :: expandExprs(List.tail(xs), als)

def expandArms(xs: List[Arm], als: List[Alias]): List[Arm] =
  if (List.isEmpty(xs)) xs else expandArm(List.at(xs, 0), als) :: expandArms(List.tail(xs), als)

def expandArm(a: Arm, als: List[Alias]): Arm =
  a match {
    case Arm(pat, g, body) => Arm(pat, g, expandExpr(body, als))
  }

def expandBinds(xs: List[Bind], als: List[Alias]): List[Bind] =
  if (List.isEmpty(xs)) xs else expandBind(List.at(xs, 0), als) :: expandBinds(List.tail(xs), als)

def expandBind(b: Bind, als: List[Alias]): Bind =
  b match {
    case Bind(d, name, v) => Bind(d, name, expandExpr(v, als))
  }

def expandParams(ps: List[Param], als: List[Alias]): List[Param] =
  if (List.isEmpty(ps)) ps else expandParam(List.at(ps, 0), als) :: expandParams(List.tail(ps), als)

def expandParam(p: Param, als: List[Alias]): Param =
  p match {
    case Param(n, ty, w, d) => Param(n, expandTy(ty, als), w, d)
  }

def expandTy(t: String, als: List[Alias]): String =
  if (List.isEmpty(als)) t else expandTyGo(t, List.at(als, 0), als)

def expandTyGo(t: String, h: Alias, als: List[Alias]): String =
  h match {
    case Alias(name, tps, target) => expandTyHit(t, name, tps, target, als)
  }

def expandTyHit(t: String, name: String, tps: List[String], target: String, als: List[Alias]): String =
  if (t == name && List.isEmpty(tps)) target else if (isTyApp(t, name) && !List.isEmpty(tps)) expandTy(substTy(target, List.at(tps, 0), tyAppArg(t, name)), List.tail(als)) else expandTy(t, List.tail(als))

def isTyApp(t: String, name: String): Bool =
  Str.len(t) > Str.len(name) + 1 && Str.slice(t, 0, Str.len(name) + 1) == Str.concat(name, "[") && Str.charAt(t, Str.len(t) - 1) == 93

def tyAppArg(t: String, name: String): String =
  Str.slice(t, Str.len(name) + 1, Str.len(t) - 1)

def substTy(target: String, param: String, arg: String): String =
  substTyAt(target, param, arg, 0)

def substTyAt(target: String, param: String, arg: String, i: Int): String =
  if (i + Str.len(param) > Str.len(target)) target else if (Str.slice(target, i, i + Str.len(param)) == param && tyBound(target, i, Str.len(param))) Str.concat(Str.slice(target, 0, i), Str.concat(arg, substTy(Str.slice(target, i + Str.len(param), Str.len(target)), param, arg))) else substTyAt(target, param, arg, i + 1)

def tyBound(s: String, i: Int, n: Int): Bool =
  tyBoundL(s, i) && tyBoundR(s, i + n)

def tyBoundL(s: String, i: Int): Bool =
  i == 0 || !isTyChar(Str.charAt(s, i - 1))

def tyBoundR(s: String, i: Int): Bool =
  i >= Str.len(s) || !isTyChar(Str.charAt(s, i))

def isTyChar(c: Int): Bool =
  c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95

def inStems(stems: List[String], mod: String): Bool =
  List.isEmpty(stems) || hasStem(stems, mod)

def hasStem(stems: List[String], mod: String): Bool =
  if (List.isEmpty(stems)) false else if (List.at(stems, 0) == mod) true else hasStem(List.tail(stems), mod)

def checkDefsRest(all: List[Fun], rest: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  if (List.isEmpty(rest)) checkMain(main, body, all, enums, mainFile(stems)) else checkDefsHit(List.at(rest, 0), all, List.tail(rest), enums, main, body, stems)

def checkDefsHit(d: Fun, all: List[Fun], rest: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  d match {
    case Fun(_, name, _, _, _, _, mod, off) => if (name == "#parse") bad("unexpected token", (mod, off)) else if (inStems(stems, mod)) checkDefsAfter(checkDef(d, all, enums), all, rest, enums, main, body, stems) else checkDefsRest(all, rest, enums, main, body, stems)
  }

def checkDefsAfter(o: Out, all: List[Fun], rest: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  if (hasErr(o)) o else checkDefsRest(all, rest, enums, main, body, stems)

def mainFile(stems: List[String]): String =
  if (List.isEmpty(stems)) "Main" else if (hasStem(stems, "Main")) "Main" else List.at(stems, 0)

def checkMain(name: String, body: Expr, funs: List[Fun], ens: List[En], file: String): Out =
  if (name == "") ok("IO[Unit]") else checkMainGot(infer(body, ("#mod", file) :: noEnv(), funs, ens), body, file)

def checkMainGot(o: Out, body: Expr, file: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else if (ty == "IO[Unit]") Out(ty, err, sp) else bad(Str.concat("@main body must be IO[Unit], got ", ty), spanPick(sp, spanPick(Parse.spanOf(body), (file, 0 - 1))))
  }

def lineCol(src: String, i: Int, j: Int, line: Int, col: Int, n: Int): (Int, Int) =
  if (j >= i) (line, col) else if (j >= n) (line, col) else if (Str.charAt(src, j) == 10) lineCol(src, i, j + 1, line + 1, 1, n) else lineCol(src, i, j + 1, line, col + 1, n)

def isIdentCh(c: Int): Bool =
  c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95

def skipIdent(src: String, i: Int): Int =
  if (i >= Str.len(src)) i else if (isIdentCh(Str.charAt(src, i))) skipIdent(src, i + 1) else i

def skipQual(src: String, i: Int): Int =
  skipQual2(src, skipIdent(src, i))

def skipQual2(src: String, j: Int): Int =
  if (j < Str.len(src) && Str.charAt(src, j) == 46 && j + 1 < Str.len(src) && isIdentCh(Str.charAt(src, j + 1))) skipQual(src, j + 1) else j

def skipStr(src: String, i: Int): Int =
  if (i >= Str.len(src)) i else if (Str.charAt(src, i) == 34) i + 1 else if (Str.charAt(src, i) == 92 && i + 1 < Str.len(src)) skipStr(src, i + 2) else skipStr(src, i + 1)

def tokenEnd(src: String, off: Int): Int =
  if (off < 0 || off >= Str.len(src)) off else tokenEndCh(src, off, Str.charAt(src, off))

def tokenEndCh(src: String, off: Int, c: Int): Int =
  if (c == 34) skipStr(src, off + 1) else if (isIdentCh(c)) skipQual(src, off) else off + 1

def locOf(src: String, off: Int): (Int, Int, Int, Int) =
  if (off < 0 || src == "") (1, 1, 1, 1) else locOf2(lineCol(src, off, 0, 1, 1, Str.len(src)), src, off)

def locOf2(p: (Int, Int), src: String, off: Int): (Int, Int, Int, Int) =
  p match {
    case (line, col) => locOf3(line, col, tokenEnd(src, off) - off)
  }

def locOf3(line: Int, col: Int, n: Int): (Int, Int, Int, Int) =
  (line, col, line, col + (if (n < 1) 1 else n))

def hexDigit(n: Int): String =
  Str.slice("0123456789abcdef", n, n + 1)

def hex2(n: Int): String =
  Str.concat(hexDigit(n / 16), hexDigit(n % 16))

def jsonStr(s: String): String =
  Str.concat("\"", Str.concat(_esc(s, 0, Builder.empty()), "\""))

def _esc(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else _esc2(s, i, b, Str.charAt(s, i))

def _esc2(s: String, i: Int, b: Builder, c: Int): String =
  _esc(s, i + 1, Builder.append(b, if (c == 34) "\\\"" else if (c == 92) "\\\\" else if (c == 10) "\\n" else if (c == 13) "\\r" else if (c == 9) "\\t" else if (c < 32) Str.concat("\\u00", hex2(c)) else Str.slice(s, i, i + 1)))

def fileOf(stem: String): String =
  if (stem == "") "Main.scuzz" else Str.concat(stem, ".scuzz")

def srcOfStem(files: List[(String, String)], stem: String): String =
  if (List.isEmpty(files)) "" else srcOfStemHd(List.at(files, 0), List.tail(files), stem)

def srcOfStemHd(h: (String, String), rest: List[(String, String)], stem: String): String =
  h match {
    case (s, src) => if (s == stem || stem == "" && s == "Main") src else srcOfStem(rest, stem)
  }

def diagJson(files: List[(String, String)], o: Out): String =
  diagJsonSp(files, o, o.span)

def diagJsonSp(files: List[(String, String)], o: Out, sp: (String, Int)): String =
  sp match {
    case (stem, off) => diagJson2(o, fileOf(stem), locOf(srcOfStem(files, stem), off))
  }

def diagJson2(o: Out, file: String, loc: (Int, Int, Int, Int)): String =
  loc match {
    case (line, col, eline, ecol) => diagJson3(o, file, line, col, eline, ecol)
  }

def errMsg(o: Out): String =
  if (o.err == "unexpected token") o.err else Str.concat("type error: ", o.err)

def diagJson3(o: Out, file: String, line: Int, col: Int, eline: Int, ecol: Int): String =
  Str.concat("{\"severity\":\"error\",\"message\":", Str.concat(jsonStr(errMsg(o)), Str.concat(",\"file\":", Str.concat(jsonStr(file), Str.concat(",\"line\":", Str.concat(Str.fromInt(line), Str.concat(",\"column\":", Str.concat(Str.fromInt(col), Str.concat(",\"end_line\":", Str.concat(Str.fromInt(eline), Str.concat(",\"end_column\":", Str.concat(Str.fromInt(ecol), "}"))))))))))))

def check(src: String): String =
  checkFiles(("Main", src) :: [])

def checkFiles(files: List[(String, String)]): String =
  checkFilesOwn(files, [])

def checkFilesOwn(files: List[(String, String)], stems: List[String]): String =
  check3(files, checkProgOwn(Parse.parseFiles(files), stems))

def check3(files: List[(String, String)], o: Out): String =
  if (hasErr(o)) Str.concat("[", Str.concat(diagJson(files, o), "]")) else "[]"

def unclaimedJson(files: List[(String, String)]): String =
  unclaimedOf(Parse.parseFiles(files))

def unclaimedOf(p: Prog): String =
  if (p.main == "") "[]" else Str.concat("[", Str.concat(unclaimedMain(p.main), "]"))

def unclaimedMain(name: String): String =
  Str.concat("{\"severity\":\"info\",\"message\":\"unclaimed def ", Str.concat(name, "\",\"line\":1,\"column\":1}"))

def humanLine(files: List[(String, String)], o: Out): String =
  humanLineSp(files, o, o.span)

def humanLineSp(files: List[(String, String)], o: Out, sp: (String, Int)): String =
  sp match {
    case (stem, off) => humanLine2(o, fileOf(stem), locOf(srcOfStem(files, stem), off))
  }

def humanLine2(o: Out, file: String, loc: (Int, Int, Int, Int)): String =
  loc match {
    case (line, col, _, _) => humanLine3(o, file, line, col)
  }

def humanLine3(o: Out, file: String, line: Int, col: Int): String =
  Str.concat(file, Str.concat(":", Str.concat(Str.fromInt(line), Str.concat(":", Str.concat(Str.fromInt(col), Str.concat(": error: ", errMsg(o)))))))

def human(src: String): String =
  humanFiles(("Main", src) :: [])

def humanFiles(files: List[(String, String)]): String =
  humanFilesOwn(files, [])

def humanFilesOwn(files: List[(String, String)], stems: List[String]): String =
  human3(files, checkProgOwn(Parse.parseFiles(files), stems))

def human3(files: List[(String, String)], o: Out): String =
  if (hasErr(o)) humanLine(files, o) else "scuzz check ok"

def typeOfEns(e: Expr, defs: List[Fun], ens: List[En], ps: List[Param], mod: String): String =
  infer(e, bindParams(ps, ("self", "A") :: ("#mod", mod) :: noEnv()), defs, ens).ty

def typeOf(e: Expr, defs: List[Fun], ps: List[Param]): String =
  typeOfEns(e, defs, [], ps, "Main")

