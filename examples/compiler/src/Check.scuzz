record Out(ty: String, err: String, span: String)

import Parse.Expr
import Parse.Fun
import Parse.Param
import Parse.Prog
import Parse.En
import Parse.EnCase
import Parse.Arm
import Parse.Bind
import Parse.Alias
import Parse.Imp

def noStr(): List[String] =
  []

def noEnv(): List[(String, String)] =
  []

def ok(ty: String): Out =
  Out(ty, "", "")

def bad(err: String, span: String): Out =
  Out("", err, span)

def hasErr(o: Out): Bool =
  Str.len(o.err) > 0

def getTy(env: List[(String, String)], name: String): String =
  if (List.isEmpty(env)) "" else getTyHd(List.head(env), List.tail(env), name)

def getTyHd(h: (String, String), rest: List[(String, String)], name: String): String =
  h match {
    case (k, v) => if (k == name) v else getTy(rest, name)
  }

def bindParams(ps: List[Param], acc: List[(String, String)]): List[(String, String)] =
  if (List.isEmpty(ps)) acc else bindParamsHd(List.head(ps), List.tail(ps), acc)

def bindParamsHd(p: Param, rest: List[Param], acc: List[(String, String)]): List[(String, String)] =
  p match {
    case Param(n, ty, _, _) => bindParams(rest, (n, ty) :: acc)
  }

def bindLam(p: String, env: List[(String, String)]): List[(String, String)] =
  if (p == "") env else (p, "Any") :: env

def lookupEnv(env: List[(String, String)], n: String): String =
  if (List.isEmpty(env)) "" else lookupEnv1(List.head(env), List.tail(env), n)

def lookupEnv1(h: (String, String), rest: List[(String, String)], n: String): String =
  h match {
    case (k, ty) => if (k == n) ty else lookupEnv(rest, n)
  }

def isFunTy(t: String): Bool =
  isFunTyAt(t, 0)

def isFunTyAt(t: String, i: Int): Bool =
  if (i + 1 >= Str.len(t)) false else isFunTyAt2(t, i)

def isFunTyAt2(t: String, i: Int): Bool =
  if (Str.charAt(t, i) == 61) isFunTyAt3(t, i) else isFunTyAt(t, i + 1)

def isFunTyAt3(t: String, i: Int): Bool =
  if (Str.charAt(t, i + 1) == 62) true else isFunTyAt(t, i + 1)

def funRetOf(t: String): String =
  funRetOfAt(t, 0)

def funRetOfAt(t: String, i: Int): String =
  if (i + 4 > Str.len(t)) t else funRetOfAt2(t, i)

def funRetOfAt2(t: String, i: Int): String =
  if (sliceEq(t, i, " => ")) Str.slice(t, i + 4, 8192) else funRetOfAt(t, i + 1)

def sliceEq(t: String, i: Int, w: String): Bool =
  Str.slice(t, i, i + Str.len(w)) == w

def findFunPrefer(funs: List[Fun], name: String, env: List[(String, String)]): List[Fun] =
  findFunPrefer2(funs, name, getTy(env, "#mod"))

def findFunPrefer2(funs: List[Fun], name: String, mod: String): List[Fun] =
  if (mod == "") findFun(funs, name) else findFunPrefer3(findFunMod(funs, mod, name), funs, name)

def findFunPrefer3(hit: List[Fun], funs: List[Fun], name: String): List[Fun] =
  if (List.isEmpty(hit)) findFun(funs, name) else hit

def findFun(funs: List[Fun], name: String): List[Fun] =
  if (List.isEmpty(funs)) [] else findFun1(List.head(funs), List.tail(funs), name)

def findFun1(h: Fun, rest: List[Fun], name: String): List[Fun] =
  h match {
    case Fun(priv, n, ts, ps, ret, body, mod) => if (n == name) Fun(priv, n, ts, ps, ret, body, mod) :: findFun(rest, name) else findFun(rest, name)
  }

def findFunMod(funs: List[Fun], mod: String, name: String): List[Fun] =
  if (List.isEmpty(funs)) [] else findFunMod1(List.head(funs), List.tail(funs), mod, name)

def findFunMod1(h: Fun, rest: List[Fun], mod: String, name: String): List[Fun] =
  h match {
    case Fun(priv, n, ts, ps, ret, body, m) => if (n == name && m == mod) Fun(priv, n, ts, ps, ret, body, m) :: findFunMod(rest, mod, name) else findFunMod(rest, mod, name)
  }

def paramTys(ps: List[Param]): List[String] =
  if (List.isEmpty(ps)) [] else paramTys1(List.head(ps), List.tail(ps))

def paramTys1(p: Param, rest: List[Param]): List[String] =
  p match {
    case Param(_, ty, _, _) => ty :: paramTys(rest)
  }

def stripNamed(e: Expr): Expr =
  e match {
    case Expr.ENamed(_, inner) => inner
    case _ => e
  }

def isKit(f: String): Bool =
  isKitA(f) || isKitB(f) || isKitC(f) || isKitD(f) || isKitE(f) || isKitF(f)

def isKitA(f: String): Bool =
  f == "Str.fromInt" || f == "Str.concat" || f == "Str.len" || f == "Str.fromBool" || f == "Str.charAt" || f == "Str.slice" || f == "Str.toInt" || f == "Str.repeat" || f == "Str.startsWith" || f == "Str.endsWith" || f == "Str.contains" || f == "Str.eq" || f == "Str.isEmpty" || f == "Str.nonEmpty" || f == "Str.isBlank" || f == "List.len" || f == "List.concat" || f == "List.reverse" || f == "List.head" || f == "List.tail" || f == "List.isEmpty" || f == "List.cons" || f == "List.at" || f == "List.join" || f == "List.take" || f == "List.drop" || f == "List.takeRight" || f == "List.dropRight" || f == "List.init" || f == "List.last" || f == "List.flatten"

def isKitB(f: String): Bool =
  f == "Builder.empty" || f == "Builder.append" || f == "Builder.result" || f == "Fs.read" || f == "Fs.write" || f == "Fs.list" || f == "Fs.mkdirs" || f == "Sys.args" || f == "Sys.getenv" || f == "Sys.write" || f == "Sys.read" || f == "Sys.readLine" || f == "Sys.spawn" || f == "Sys.alive" || f == "Sys.kill" || f == "Impurity.runKit" || f == "IO.pure" || f == "IO.println" || f == "Clock.monotonic" || f == "Clock.realTime" || f == "Map.empty" || f == "Map.set" || f == "Map.keys" || f == "Map.values" || f == "Map.size" || f == "Map.contains" || f == "Map.getOrElse" || f == "Map.remove" || f == "Map.toList"

def isKitC(f: String): Bool =
  f == "Set.empty" || f == "Set.add" || f == "Set.toList" || f == "Set.size" || f == "Set.contains" || f == "Set.remove" || f == "Set.union" || f == "Set.intersect" || f == "Set.diff" || f == "Json.keys" || f == "Json.get" || f == "Json.has" || f == "Json.parse" || f == "Json.getStr" || f == "Json.getBool" || f == "Json.getInt" || f == "Json.intOr" || f == "Json.arr" || f == "Json.at" || f == "Json.isNull" || f == "Json.isObj" || f == "Json.isArr" || f == "Json.pairs" || f == "Json.set" || f == "Json.remove" || f == "Json.append" || f == "Json.prepend" || f == "Json.setAt" || f == "Json.dropAt" || f == "Json.merge" || f == "Json.Int" || f == "Json.Null" || f == "Json.asInt" || f == "Json.asBool" || f == "Json.asStr" || f == "Json.asFloat" || f == "Json.Float" || f == "Json.floatOr" || f == "Json.Obj" || f == "Json.Str" || f == "Json.Bool" || f == "Json.Arr" || isSysProc(f)

def isKitD(f: String): Bool =
  f == "Str.startsWith" || f == "Str.endsWith" || f == "Str.contains" || f == "Str.eq" || f == "Str.isEmpty" || f == "Str.nonEmpty" || f == "Str.isBlank" || f == "Str.lines" || f == "Str.trim" || f == "Str.indexOf" || f == "Str.lastIndexOf" || f == "Str.take" || f == "Str.drop" || f == "Str.takeRight" || f == "Str.dropRight" || f == "Str.stripPrefix" || f == "Str.stripSuffix" || f == "Str.split" || f == "Fs.join" || f == "Fs.dirname" || f == "Fs.basename"

def isKitE(f: String): Bool =
  f == "Fs.exists" || f == "Fs.delete" || f == "Fs.walk" || f == "Fs.canonicalize" || f == "Fs.rename" || f == "Random.nextInt" || f == "Sys.childWrite" || f == "Sys.childRead" || f == "Sys.childClose"

def isKitF(f: String): Bool =
  isNetHttp(f) || isNetServe(f) || isNetTcp(f) || isNetUdp(f)

def isNetHttp(f: String): Bool =
  f == "Net.httpGet" || f == "Net.httpPost" || f == "Net.httpPut" || f == "Net.httpPatch" || f == "Net.httpDelete" || f == "Net.httpHead"

def isNetServe(f: String): Bool =
  f == "Net.serve" || f == "Net.serveOnce"

def isNetTcp(f: String): Bool =
  f == "Net.tcpConnect" || f == "Net.tcpListen" || f == "Net.tcpAccept" || f == "Net.tcpRead" || f == "Net.tcpWrite" || f == "Net.tcpClose"

def isNetUdp(f: String): Bool =
  f == "Net.udpBind" || f == "Net.udpSend" || f == "Net.udpRecv" || f == "Net.udpClose"

def isSysProc(f: String): Bool =
  Str.startsWith(f, "Sys.e") && f != "Sys.error"

def kitParams(f: String): List[String] =
  if (f == "Str.fromInt") "Int" :: noStr() else if (f == "Str.concat") "String" :: "String" :: noStr() else if (f == "Str.len") "String" :: noStr() else if (f == "Str.fromBool") "Bool" :: noStr() else if (f == "Str.charAt") "String" :: "Int" :: noStr() else if (f == "Str.slice") "String" :: "Int" :: "Int" :: noStr() else if (f == "Str.toInt") "String" :: "Int" :: noStr() else if (f == "Str.repeat") "String" :: "Int" :: noStr() else if (f == "Str.startsWith" || f == "Str.endsWith" || f == "Str.contains" || f == "Str.eq" || f == "Str.indexOf" || f == "Str.lastIndexOf") "String" :: "String" :: noStr() else if (f == "Str.isEmpty" || f == "Str.nonEmpty" || f == "Str.isBlank" || f == "Str.lines" || f == "Str.trim") "String" :: noStr() else if (f == "Str.take" || f == "Str.drop" || f == "Str.takeRight" || f == "Str.dropRight") "String" :: "Int" :: noStr() else if (f == "Str.stripPrefix" || f == "Str.stripSuffix" || f == "Str.split" || f == "Fs.join") "String" :: "String" :: noStr() else if (f == "Fs.dirname" || f == "Fs.basename") "String" :: noStr() else if (f == "List.len" || f == "List.reverse" || f == "List.head" || f == "List.tail" || f == "List.isEmpty" || f == "List.init" || f == "List.last" || f == "List.flatten") "List" :: noStr() else if (f == "List.concat") "List" :: "List" :: noStr() else if (f == "List.join") "Any" :: "String" :: noStr() else if (f == "List.cons") "Any" :: "List" :: noStr() else if (f == "List.at" || f == "List.take" || f == "List.drop" || f == "List.takeRight" || f == "List.dropRight") "List" :: "Int" :: noStr() else if (f == "Builder.empty" || f == "Clock.monotonic" || f == "Clock.realTime" || f == "Map.empty" || f == "Set.empty" || f == "Impurity.runKit" || f == "Sys.readLine") noStr() else if (f == "Sys.read" || f == "Sys.alive" || f == "Sys.kill" || f == "Sys.childClose" || f == "Random.nextInt") "Int" :: noStr() else if (f == "Sys.spawn") "String" :: noStr() else if (f == "Builder.append") "Builder" :: "String" :: noStr() else if (f == "Builder.result") "Builder" :: noStr() else if (f == "Fs.read" || f == "Fs.list" || f == "Fs.mkdirs" || f == "Fs.exists" || f == "Fs.delete" || f == "Fs.walk" || f == "Fs.canonicalize" || f == "Sys.getenv" || f == "Sys.write" || isSysProc(f)) "String" :: noStr() else if (f == "Fs.write" || f == "Fs.rename") "String" :: "String" :: noStr() else if (f == "IO.pure") "Any" :: noStr() else kitParams2(f)

def kitParams2(f: String): List[String] =
  if (f == "Sys.childWrite") "Int" :: "String" :: noStr() else if (f == "Sys.childRead") "Int" :: "Int" :: noStr() else if (f == "IO.println") "String" :: noStr() else if (f == "Map.set") "Map" :: "String" :: "Any" :: noStr() else if (f == "Map.keys" || f == "Map.values" || f == "Map.size" || f == "Map.toList") "Map" :: noStr() else if (f == "Map.contains" || f == "Map.remove") "Map" :: "String" :: noStr() else if (f == "Map.getOrElse") "Map" :: "String" :: "Any" :: noStr() else if (f == "Set.add" || f == "Set.contains" || f == "Set.remove") "Set" :: "String" :: noStr() else if (f == "Set.toList" || f == "Set.size") "Set" :: noStr() else if (f == "Set.union" || f == "Set.intersect" || f == "Set.diff") "Set" :: "Set" :: noStr() else if (f == "Json.keys" || f == "Json.parse" || f == "Json.arr" || f == "Json.pairs" || f == "Json.isNull" || f == "Json.isObj" || f == "Json.isArr" || f == "Json.asInt" || f == "Json.asBool" || f == "Json.asStr" || f == "Json.asFloat") "Any" :: noStr() else if (f == "Json.get" || f == "Json.has" || f == "Json.remove") "Any" :: "String" :: noStr() else if (f == "Json.getStr") "Any" :: "String" :: "String" :: noStr() else if (f == "Json.getBool") "Any" :: "String" :: "Bool" :: noStr() else if (f == "Json.getInt") "Any" :: "String" :: "Int" :: noStr() else if (f == "Json.intOr" || f == "Json.at" || f == "Json.dropAt") "Any" :: "Int" :: noStr() else if (f == "Json.set") "Any" :: "String" :: "Any" :: noStr() else if (f == "Json.append" || f == "Json.prepend" || f == "Json.merge") "Any" :: "Any" :: noStr() else if (f == "Json.setAt") "Any" :: "Int" :: "Any" :: noStr() else if (f == "Json.Int") "Int" :: noStr() else if (f == "Json.Float") "Float" :: noStr() else if (f == "Json.floatOr") "Any" :: "Float" :: noStr() else if (f == "Json.Obj" || f == "Json.Arr") "List" :: noStr() else if (f == "Json.Str") "String" :: noStr() else if (f == "Json.Bool") "Bool" :: noStr() else if (f == "Json.Null") noStr() else kitParams3(f)

def kitParams3(f: String): List[String] =
  if (f == "Net.httpGet" || f == "Net.httpDelete" || f == "Net.httpHead") "String" :: noStr() else if (f == "Net.httpPost" || f == "Net.httpPut" || f == "Net.httpPatch") "String" :: "String" :: noStr() else if (f == "Net.serve" || f == "Net.serveOnce") "Int" :: "Any" :: noStr() else if (f == "Net.tcpConnect") "String" :: "Int" :: noStr() else if (f == "Net.tcpListen" || f == "Net.udpBind") "Int" :: noStr() else if (f == "Net.tcpAccept" || f == "Net.tcpClose" || f == "Net.udpClose") "Any" :: noStr() else if (f == "Net.tcpRead" || f == "Net.udpRecv") "Any" :: "Int" :: noStr() else if (f == "Net.tcpWrite") "Any" :: "String" :: noStr() else if (f == "Net.udpSend") "Any" :: "String" :: "Int" :: "String" :: noStr() else noStr()

def kitRet(f: String): String =
  if (f == "Str.len" || f == "List.len" || f == "Str.charAt" || f == "Str.toInt" || f == "Str.indexOf" || f == "Str.lastIndexOf" || f == "Map.size" || f == "Set.size" || f == "Json.getInt" || f == "Json.intOr") "Int" else if (f == "List.head" || f == "List.at" || f == "List.last" || f == "Map.getOrElse") "Any" else if (f == "List.isEmpty" || f == "Map.contains" || f == "Set.contains" || f == "Json.has" || f == "Json.getBool" || f == "Json.isNull" || f == "Json.isObj" || f == "Json.isArr" || f == "Str.startsWith" || f == "Str.endsWith" || f == "Str.contains" || f == "Str.eq" || f == "Str.isEmpty" || f == "Str.nonEmpty" || f == "Str.isBlank") "Bool" else if (f == "List.concat" || f == "List.reverse" || f == "List.tail" || f == "List.cons" || f == "List.take" || f == "List.drop" || f == "List.takeRight" || f == "List.dropRight" || f == "List.init" || f == "List.flatten" || f == "Str.lines" || f == "Str.split") "List" else if (f == "Json.floatOr" || f == "Json.Float" || f == "Json.asFloat") "Float" else if (f == "Map.keys" || f == "Map.values" || f == "Map.toList" || f == "Set.toList" || f == "Json.keys" || f == "Json.arr" || f == "Json.at" || f == "Json.pairs" || f == "Json.asInt" || f == "Json.asBool" || f == "Json.asStr" || f == "Json.asFloat") "List" else if (f == "Builder.empty" || f == "Builder.append") "Builder" else if (f == "Fs.read" || f == "Sys.getenv" || f == "Sys.read" || f == "Sys.readLine" || f == "Fs.canonicalize" || f == "Sys.childRead" || isNetHttp(f) || f == "Net.tcpRead") "IO[String]" else if (f == "Fs.write" || f == "Fs.mkdirs" || f == "Fs.delete" || f == "Fs.rename" || f == "Impurity.runKit" || f == "Sys.write" || f == "Sys.kill" || f == "Sys.childWrite" || f == "Sys.childClose" || f == "IO.println" || isNetServe(f) || f == "Net.tcpWrite" || f == "Net.tcpClose" || f == "Net.udpSend" || f == "Net.udpClose") "IO[Unit]" else if (f == "Fs.list" || f == "Fs.walk") "IO[List[(String, Bool)]]" else if (f == "Sys.args") "IO[List[String]]" else if (f == "Sys.spawn" || f == "Sys.alive" || f == "Fs.exists" || f == "Random.nextInt") "IO[Int]" else if (isSysProc(f)) "IO[(Int, String, String)]" else if (f == "Net.udpRecv") "IO[(String, Int, String)]" else if (f == "Net.tcpConnect" || f == "Net.tcpListen" || f == "Net.tcpAccept" || f == "Net.udpBind") "IO[Any]" else if (f == "IO.pure") "IO[Any]" else if (f == "Clock.monotonic" || f == "Clock.realTime") "IO[Int]" else if (f == "Map.empty" || f == "Map.set" || f == "Map.remove") "Map" else if (f == "Set.empty" || f == "Set.add" || f == "Set.remove" || f == "Set.union" || f == "Set.intersect" || f == "Set.diff") "Set" else if (f == "Json.parse" || f == "Json.get" || f == "Json.set" || f == "Json.remove" || f == "Json.append" || f == "Json.prepend" || f == "Json.setAt" || f == "Json.dropAt" || f == "Json.merge" || f == "Json.Int" || f == "Json.Null" || f == "Json.Float" || f == "Json.Obj" || f == "Json.Str" || f == "Json.Bool" || f == "Json.Arr") "Any" else "Any"

def isArith(op: String): Bool =
  op == "+" || op == "-" || op == "*" || op == "/" || op == "%"

def isEq(op: String): Bool =
  op == "==" || op == "!="

def isOrd(op: String): Bool =
  op == "<" || op == "<=" || op == ">" || op == ">="

def isLogic(op: String): Bool =
  op == "&&" || op == "||"

def isBit(op: String): Bool =
  op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>"

def firstArgErr(args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(args)) ok("") else firstArgErr2(infer(stripNamed(List.head(args)), env, funs, ens), List.tail(args), env, funs, ens)

def firstArgErr2(o: Out, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(o)) o else firstArgErr(rest, env, funs, ens)

def zipCheck(callee: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, acc: String): Out =
  if (List.isEmpty(want)) ok(acc) else zipCheckHd(callee, List.head(want), List.tail(want), args, env, funs, ens, span, acc)

def zipCheckHd(callee: String, w: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, acc: String): Out =
  zipCheckArg(callee, w, want, List.head(args), List.tail(args), env, funs, ens, span, acc)

def zipCheckArg(callee: String, w: String, want: List[String], arg: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, acc: String): Out =
  if (List.isEmpty(args)) zipCheckLast(infer(stripNamed(arg), env, funs, ens), callee, w, span, acc) else zipCheck2(callee, w, infer(stripNamed(arg), env, funs, ens), want, args, env, funs, ens, span, acc)

def zipCheckLast(o: Out, callee: String, w: String, span: String, acc: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else if (tyEq(ty, w) || w == "Any") ok(if (acc == "") ty else acc) else argMismatch(callee, w, ty, span)
  }

def zipCheck2(callee: String, w: String, o: Out, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, acc: String): Out =
  o match {
    case Out(ty, err, sp) => zipCheckErr(callee, w, ty, err, sp, want, args, env, funs, ens, span, acc)
  }

def zipCheckErr(callee: String, w: String, ty: String, err: String, sp: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, acc: String): Out =
  if (Str.len(err) > 0) Out(ty, err, sp) else zipCheckEq(callee, w, ty, want, args, env, funs, ens, span, acc)

def zipCheckEq(callee: String, w: String, got: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, acc: String): Out =
  if (tyEq(got, w) || w == "Any") zipCheck(callee, want, args, env, funs, ens, span, if (acc == "") got else acc) else argMismatch(callee, w, got, span)

def argMismatch(callee: String, w: String, got: String, span: String): Out =
  bad(argMismatchMsg(argMismatchWant(callee, w), got), span)

def argMismatchWant(callee: String, w: String): String =
  if (callee == "IO.println") "expected String, got " else Str.concat(callee, Str.concat(" arg type mismatch: expected ", Str.concat(w, ", got ")))

def argMismatchMsg(prefix: String, got: String): String =
  Str.concat(prefix, got)

def listMatch(w: String, g: String): Bool =
  w == "List" && isListTy(g) || g == "List" && isListTy(w)

def isListTy(t: String): Bool =
  t == "List" || Str.startsWith(t, "List[")

def tyEq(a: String, b: String): Bool =
  a == b || a == "Any" || b == "Any" || isTyParam(a) || isTyParam(b) || listMatch(a, b) || appMatch(a, b) || tupEq(a, b) || funEq(a, b) || appInnerEq(a, b)

def isTyParam(t: String): Bool =
  Str.len(t) == 1 && Str.charAt(t, 0) >= 65 && Str.charAt(t, 0) <= 90

def appInnerEq(a: String, b: String): Bool =
  appInnerEq2(brackAt(a, 0), brackAt(b, 0), a, b)

def appInnerEq2(ba: Int, bb: Int, a: String, b: String): Bool =
  ba >= 0 && bb >= 0 && Str.slice(a, 0, ba) == Str.slice(b, 0, bb) && argsFit(splitComma(elemOf(a)), splitComma(elemOf(b)))

def argsFit(xs: List[String], ys: List[String]): Bool =
  partsEq(xs, ys) || argsPrefix(xs, ys) || argsPrefix(ys, xs) || argsTail(xs, ys) || argsTail(ys, xs)

def argsTail(xs: List[String], ys: List[String]): Bool =
  if (List.isEmpty(xs)) true else if (List.isEmpty(ys)) false else if (partsEq(xs, ys)) true else argsTail(xs, List.tail(ys))

def argsPrefix(xs: List[String], ys: List[String]): Bool =
  if (List.isEmpty(xs)) true else if (List.isEmpty(ys)) false else tyEq(List.head(xs), List.head(ys)) && argsPrefix(List.tail(xs), List.tail(ys))

def funEq(a: String, b: String): Bool =
  isFunTy(a) && isFunTy(b) && tyEq(funArgOf(a), funArgOf(b)) && tyEq(funRetOf(a), funRetOf(b))

def funArgOf(t: String): String =
  funArgOfAt(t, 0)

def funArgOfAt(t: String, i: Int): String =
  if (i + 4 > Str.len(t)) t else if (sliceEq(t, i, " => ")) Str.slice(t, 0, i) else funArgOfAt(t, i + 1)

def appMatch(w: String, g: String): Bool =
  isAppOf(w, g) || isAppOf(g, w)

def isAppOf(bare: String, app: String): Bool =
  Str.len(app) > Str.len(bare) && Str.slice(app, 0, Str.len(bare)) == bare && Str.charAt(app, Str.len(bare)) == 91

def isTup(t: String): Bool =
  Str.len(t) > 0 && Str.charAt(t, 0) == 40

def tupEq(a: String, b: String): Bool =
  isTup(a) && isTup(b) && partsEq(splitComma(tupleInner(a)), splitComma(tupleInner(b)))

def partsEq(xs: List[String], ys: List[String]): Bool =
  if (List.isEmpty(xs)) List.isEmpty(ys) else if (List.isEmpty(ys)) false else tyEq(List.head(xs), List.head(ys)) && partsEq(List.tail(xs), List.tail(ys))

def prefer(a: String, b: String): String =
  if (a == b) a else if (isAppOf(a, b)) b else if (isAppOf(b, a)) a else if (a == "List") b else if (b == "List") a else if (isTup(a) && isTup(b)) preferTup(a, b) else a

def preferTup(a: String, b: String): String =
  Str.concat("(", Str.concat(preferParts(splitComma(tupleInner(a)), splitComma(tupleInner(b))), ")"))

def preferParts(xs: List[String], ys: List[String]): String =
  if (List.isEmpty(xs) || List.isEmpty(ys)) "" else if (List.len(xs) == 1 || List.len(ys) == 1) prefer(List.head(xs), List.head(ys)) else Str.concat(prefer(List.head(xs), List.head(ys)), Str.concat(", ", preferParts(List.tail(xs), List.tail(ys))))

def checkKnown(f: String, want: List[String], ret: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String): Out =
  if (List.len(want) != List.len(args)) bad(Str.concat(f, Str.concat(" expects ", Str.concat(Str.fromInt(List.len(want)), Str.concat(" args, got ", Str.fromInt(List.len(args)))))), span) else checkKnownRet(f, zipCheck(f, want, args, env, funs, ens, span, ""), ret)

def checkKnownRet(f: String, o: Out, ret: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else ok(kitRetFromTy(f, ty, ret))
  }

def kitRetFromTy(f: String, ty: String, ret: String): String =
  if (f == "List.head" || f == "List.at") elemOf(ty) else if (f == "List.tail" || f == "List.reverse" || f == "List.concat") kitRetList(ty, ret) else if (f == "List.cons") kitRetCons(ty, ret) else if (f == "IO.pure") Str.concat("IO[", Str.concat(ty, "]")) else ret

def kitRetList(ty: String, ret: String): String =
  if (isListTy(ty)) ty else ret

def kitRetCons(ty: String, ret: String): String =
  if (ty == "") ret else Str.concat("List[", Str.concat(ty, "]"))

def resolveCall(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  resolveCall2(f, args, env, funs, ens, Parse.pretty0(Expr.ECall(f, args)))

def resolveCall2(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String): Out =
  if (isKit(f) || isOpenKit(f)) resolveKit(f, args, env, funs, ens, span) else if (hasEn(ens, f)) inferCtor(f, args, env, funs, ens) else if (enOfCase(ens, f) != "") inferCtor(enOfCase(ens, f), args, env, funs, ens) else resolveFunOrUser(f, args, env, funs, ens, span, lookupEnv(env, f))

def resolveKit(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String): Out =
  if (List.isEmpty(args) && isKit(f) && !List.isEmpty(kitParams(f))) ok(funTyFrom(kitParams(f), kitRet(f))) else if (isKit(f)) checkKnown(f, kitParams(f), kitRet(f), args, env, funs, ens, span) else checkKnown(f, anyParams(List.len(args)), openKitRet(f), args, env, funs, ens, span)

def enOfCase(ens: List[En], ctor: String): String =
  if (List.isEmpty(ens)) "" else enOfCase1(List.head(ens), List.tail(ens), ctor)

def enOfCase1(h: En, rest: List[En], ctor: String): String =
  h match {
    case En(_, name, _, cases) => if (hasCase(cases, ctor)) name else enOfCase(rest, ctor)
  }

def hasCase(cs: List[EnCase], ctor: String): Bool =
  if (List.isEmpty(cs)) false else hasCase1(List.head(cs), List.tail(cs), ctor)

def hasCase1(c: EnCase, rest: List[EnCase], ctor: String): Bool =
  c match {
    case EnCase(name, _) => name == ctor || hasCase(rest, ctor)
  }

def isOpenKit(f: String): Bool =
  Str.startsWith(f, "List.") || Str.startsWith(f, "Map.") || Str.startsWith(f, "Set.") || Str.startsWith(f, "Str.") || Str.startsWith(f, "IO.") || Str.startsWith(f, "Json.") || Str.startsWith(f, "Float.") || Str.startsWith(f, "Signal.") || Str.startsWith(f, "Property.") || Str.startsWith(f, "View.") || Str.startsWith(f, "Ui.") || Str.startsWith(f, "Fiber.") || Str.startsWith(f, "Timeline.") || Str.startsWith(f, "Verdict.") || Str.startsWith(f, "Color.") || Str.startsWith(f, "Theme.") || Str.startsWith(f, "Ref.") || Str.startsWith(f, "Queue.") || Str.startsWith(f, "Deferred.") || Str.startsWith(f, "Stream.") || Str.startsWith(f, "Resource.") || Str.startsWith(f, "Builder.") || Str.startsWith(f, "Oracle.") || Str.startsWith(f, ".")

def anyParams(n: Int): List[String] =
  if (n <= 0) noStr() else "Any" :: anyParams(n - 1)

def openKitRet(f: String): String =
  if (openKitBool(f)) "Bool" else if (openKitInt(f) || Str.startsWith(f, "Color.") || Str.startsWith(f, "Theme.")) "Int" else if (f == "Property.sometimes") "Unit" else if (openKitAny(f) || Str.startsWith(f, "Signal.") || Str.startsWith(f, "View.") || Str.startsWith(f, "Property.") || Str.startsWith(f, "Json.")) "Any" else if (Str.startsWith(f, "Map.")) "Map" else if (Str.startsWith(f, "Set.")) "Set" else if (Str.startsWith(f, "IO.") || Str.startsWith(f, "Ui.") || Str.startsWith(f, "Fiber.") || Str.startsWith(f, "Ref.") || Str.startsWith(f, "Queue.") || Str.startsWith(f, "Deferred.") || Str.startsWith(f, "Stream.") || Str.startsWith(f, "Resource.")) "IO[Any]" else if (Str.startsWith(f, "Str.")) "String" else if (Str.startsWith(f, "Float.")) "Float" else if (Str.startsWith(f, "Builder.") || Str.startsWith(f, "Oracle.") || Str.startsWith(f, ".")) "Any" else "Any"

def openKitBool(f: String): Bool =
  f == "List.exists" || f == "List.forall" || f == "List.contains" || f == "List.nonEmpty" || f == "List.isEmpty"

def openKitInt(f: String): Bool =
  f == "List.count" || f == "List.indexWhere" || f == "List.lastIndexWhere" || f == "List.indexOf" || f == "List.lastIndexOf" || f == "Float.toInt"

def openKitAny(f: String): Bool =
  f == "List.foldLeft" || f == "List.foldRight" || f == "List.reduceLeft" || f == "List.reduceRight" || f == "List.getOrElse" || f == "List.head" || f == "List.last" || f == "List.at"

def resolveFunOrUser(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, ty: String): Out =
  if (isFunTy(ty)) inferFunApply(ty, args, env, funs, ens, span) else resolveUser(f, args, env, funs, ens, span, findFunPrefer(funs, f, env))

def inferFunApply(ty: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String): Out =
  inferFunApplyRet(funRetOf(ty), args, env, funs, ens, span)

def inferFunApplyRet(ret: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String): Out =
  if (List.len(args) == 1) inferFunApply1(ret, infer(List.head(args), env, funs, ens), span) else if (List.isEmpty(args)) bad("apply expects 1 arg", span) else inferFunApply1(ret, firstArgErr(args, env, funs, ens), span)

def inferFunApply1(ret: String, o: Out, _span: String): Out =
  if (hasErr(o)) o else ok(ret)

def elemOf(t: String): String =
  elemOf2(brackAt(t, 0), t)

def brackAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 91) i else brackAt(s, i + 1)

def elemOf2(b: Int, t: String): String =
  if (b < 0) "Any" else Str.slice(t, b + 1, Str.len(t) - 1)

def resolveUser(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, hit: List[Fun]): Out =
  if (List.isEmpty(hit)) bad(Str.concat("unknown function ", f), span) else resolveUserHit(f, args, env, funs, ens, span, List.head(hit))

def resolveUserHit(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, d: Fun): Out =
  d match {
    case Fun(_, _, _, ps, ret, _, _) => checkKnown(f, paramTys(ps), ret, args, env, funs, ens, span)
  }

def inferCall(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  resolveCall(f, args, env, funs, ens)

def inferPrint(inner: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferPrint2(infer(inner, env, funs, ens), e)

def inferPrint2(o: Out, e: Expr): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) o else if (ty == "String" || ty == "Any") ok("IO[Unit]") else bad(Str.concat("expected String, got ", ty), Parse.pretty0(e))
  }

def inferBin(op: String, l: Expr, r: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferBin2(op, infer(l, env, funs, ens), r, env, funs, ens, e)

def inferBin2(op: String, lo: Out, r: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(lo)) lo else inferBin3(op, lo, infer(r, env, funs, ens), e)

def inferBin3(op: String, lo: Out, ro: Out, e: Expr): Out =
  if (hasErr(ro)) ro else inferBin4(op, lo.ty, ro.ty, Parse.pretty0(e))

def inferBin4(op: String, lt: String, rt: String, span: String): Out =
  if (isArith(op)) inferArith(lt, rt, span) else if (isEq(op)) inferEq(lt, rt, span) else if (isOrd(op)) inferOrd(lt, rt, span) else if (isLogic(op)) inferLogic(lt, rt, span) else if (isBit(op)) inferBit(lt, rt, span) else if (op == "::") ok(Str.concat("List[", Str.concat(lt, "]"))) else ok(lt)

def inferArith(lt: String, rt: String, span: String): Out =
  if (numTy(lt) && numTy(rt)) ok(if (lt == "Float" || rt == "Float") "Float" else "Int") else bad(Str.concat("arithmetic needs Int or Float, got ", Str.concat(lt, Str.concat(" and ", rt))), span)

def numTy(t: String): Bool =
  t == "Int" || t == "Float" || t == "Any"

def inferEq(lt: String, rt: String, span: String): Out =
  if (tyEq(lt, rt)) ok("Bool") else bad(Str.concat("comparison type mismatch ", Str.concat(lt, Str.concat(" vs ", rt))), span)

def inferOrd(lt: String, rt: String, span: String): Out =
  if (numTy(lt) && numTy(rt)) ok("Bool") else bad("ordered compare needs Int or Float", span)

def inferLogic(lt: String, rt: String, span: String): Out =
  if (logicTy(lt) && logicTy(rt)) ok("Bool") else bad(Str.concat("logic needs Bool, got ", Str.concat(lt, Str.concat(" and ", rt))), span)

def logicTy(t: String): Bool =
  t == "Bool" || t == "Any"

def inferBit(lt: String, rt: String, span: String): Out =
  if (lt == "Int" && rt == "Int") ok("Int") else bad(Str.concat("bitwise needs Int, got ", Str.concat(lt, Str.concat(" and ", rt))), span)

def inferUn(op: String, inner: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferUn2(op, infer(inner, env, funs, ens), e)

def inferUn2(op: String, o: Out, e: Expr): Out =
  if (hasErr(o)) o else if (op == "!") inferUnBool(o, e) else inferUnInt(o, e)

def inferUnBool(o: Out, e: Expr): Out =
  if (o.ty == "Bool" || o.ty == "Any") ok("Bool") else bad(Str.concat("expected Bool, got ", o.ty), Parse.pretty0(e))

def inferUnInt(o: Out, e: Expr): Out =
  if (o.ty == "Int" || o.ty == "Any") ok("Int") else bad(Str.concat("expected Int, got ", o.ty), Parse.pretty0(e))

def inferIf(c: Expr, t: Expr, el: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferIf2(infer(c, env, funs, ens), t, el, env, funs, ens)

def inferIf2(co: Out, t: Expr, el: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(co)) co else inferIf3(infer(t, env, funs, ens), el, env, funs, ens)

def inferIf3(to: Out, el: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(to)) to else inferIf4(to, infer(el, env, funs, ens))

def inferIf4(to: Out, eo: Out): Out =
  if (hasErr(eo)) eo else if (tyEq(to.ty, eo.ty)) ok(prefer(to.ty, eo.ty)) else if (ifIoUnit(to.ty, eo.ty)) ok(ifIoPick(to.ty, eo.ty)) else bad(Str.concat("type mismatch: expected ", Str.concat(to.ty, Str.concat(", got ", eo.ty))), "")

def ifIoUnit(a: String, b: String): Bool =
  isIo(a) && b == "Unit" || isIo(b) && a == "Unit"

def ifIoPick(a: String, b: String): String =
  if (isIo(a)) a else b

def infer(e: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  e match {
    case Expr.EInt(_) => ok("Int")
    case Expr.EBool(_) => ok("Bool")
    case Expr.EStr(_) => ok("String")
    case Expr.EFloat(_) => ok("Float")
    case Expr.EInterp(_) => ok("String")
    case Expr.EUnit => ok("Unit")
    case Expr.EHole => ok("Int")
    case Expr.EVar(s) => inferVar(s, env, funs, ens)
    case Expr.EPrint(inner) => inferPrint(inner, env, funs, ens, e)
    case Expr.ECall(f, args) => inferCall(f, args, env, funs, ens)
    case Expr.EBin(op, l, r) => inferBin(op, l, r, env, funs, ens, e)
    case Expr.EUn(op, inner) => inferUn(op, inner, env, funs, ens, e)
    case Expr.EIf(c, t, el) => inferIf(c, t, el, env, funs, ens)
    case Expr.ENamed(_, inner) => infer(inner, env, funs, ens)
    case Expr.EList(xs) => inferList(xs, env, funs, ens)
    case Expr.ETuple(xs) => inferTuple(xs, env, funs, ens)
    case Expr.EMethod(recv, name, args) => inferMethod(recv, name, args, env, funs, ens, e)
    case Expr.EField(recv, name) => inferField(recv, name, env, funs, ens)
    case Expr.ELam(p, body) => inferLam(infer(body, bindLam(p, env), funs, ens))
    case Expr.EMatch(s, arms) => inferMatch(s, arms, env, funs, ens)
    case Expr.EFor(bs, body) => inferFor(bs, body, env, funs, ens)
  }

def inferLam(o: Out): Out =
  if (hasErr(o)) o else ok(Str.concat("Any => ", o.ty))

def inferFor(bs: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferForGo(bs, body, env, funs, ens)

def inferForGo(bs: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(bs)) inferFor2(infer(body, env, funs, ens)) else inferForBind(List.head(bs), List.tail(bs), body, env, funs, ens)

def inferForBind(b: Bind, rest: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  b match {
    case Bind(d, name, v) => inferForBind2(d, name, infer(v, env, funs, ens), rest, body, env, funs, ens)
  }

def inferForBind2(d: Bool, name: String, vo: Out, rest: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(vo)) vo else inferForGo(rest, body, bindFor(d, name, vo.ty, env, ens), funs, ens)

def bindFor(d: Bool, name: String, ty: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  if (name == "_" || name == "") env else bindPat(name, if (d) ioPayload(ty) else ty, env, ens)

def inferFor2(o: Out): Out =
  if (hasErr(o)) o else ok(Str.concat("IO[", Str.concat(o.ty, "]")))

def forHasDraw(bs: List[Bind]): Bool =
  if (List.isEmpty(bs)) false else forHasDraw1(List.head(bs), List.tail(bs))

def forHasDraw1(b: Bind, rest: List[Bind]): Bool =
  b match {
    case Bind(d, _, _) => d || forHasDraw(rest)
  }

def hasEn(ens: List[En], name: String): Bool =
  hasEnAt(ens, name, 0)

def hasEnAt(ens: List[En], name: String, i: Int): Bool =
  if (i >= List.len(ens)) false else hasEnHit(List.at(ens, i), ens, name, i)

def hasEnHit(h: En, ens: List[En], name: String, i: Int): Bool =
  if (h.name == name) true else hasEnAt(ens, name, i + 1)

def inferField(recv: Expr, name: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  recv match {
    case Expr.EVar(en) => if (hasEn(ens, en)) ok(en) else inferFieldVar(en, name, env, funs, ens)
    case _ => fieldOf(infer(recv, env, funs, ens), name, ens)
  }

def inferFieldVar(en: String, name: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferFieldHit(findFunMod(funs, en, name), en, name, env, funs, ens)

def inferFieldHit(hit: List[Fun], en: String, name: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(hit)) fieldOf(inferVar(en, env, funs, ens), name, ens) else ok(funTyOf(List.head(hit)))

def fieldOf(o: Out, name: String, ens: List[En]): Out =
  if (hasErr(o)) o else fieldOf2(o.ty, name, ens)

def fieldOf2(ty: String, name: String, ens: List[En]): Out =
  if (isTup(ty) && isTupField(name)) tupFieldOf(ty, name) else fieldOf3(fieldNamed(ens, ty, name), ty)

def isTupField(name: String): Bool =
  name == "_1" || name == "_2" || name == "_3" || name == "_4"

def tupFieldOf(ty: String, name: String): Out =
  tupFieldAt(splitComma(tupleInner(ty)), tupIdx(name))

def tupIdx(name: String): Int =
  if (name == "_1") 0 else if (name == "_2") 1 else if (name == "_3") 2 else 3

def tupFieldAt(parts: List[String], i: Int): Out =
  if (i < 0 || i >= List.len(parts)) ok("Any") else ok(List.at(parts, i))

def fieldOf3(ft: String, ty: String): Out =
  if (ft == "") ok(ty) else ok(ft)

def fieldNamed(ens: List[En], ty: String, name: String): String =
  if (List.isEmpty(ens)) "" else fieldNamed1(List.head(ens), List.tail(ens), ty, name)

def fieldNamed1(h: En, rest: List[En], ty: String, name: String): String =
  h match {
    case En(_, n, _, cases) => if (n == ty) fieldNamed2(cases, name) else fieldNamed(rest, ty, name)
  }

def fieldNamed2(cs: List[EnCase], name: String): String =
  if (List.isEmpty(cs)) "" else fieldNamed3(List.head(cs), List.tail(cs), name)

def fieldNamed3(h: EnCase, rest: List[EnCase], name: String): String =
  h match {
    case EnCase(_, fields) => fieldNamed4(fields, name, rest)
  }

def fieldNamed4(fs: List[Param], name: String, rest: List[EnCase]): String =
  if (List.isEmpty(fs)) fieldNamed2(rest, name) else fieldNamed5(List.head(fs), List.tail(fs), name, rest)

def fieldNamed5(p: Param, rest: List[Param], name: String, restCs: List[EnCase]): String =
  p match {
    case Param(n, ty, _, _) => if (n == name) ty else fieldNamed4(rest, name, restCs)
  }

def inferMatch(s: Expr, arms: List[Arm], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferMatch2(infer(s, env, funs, ens), arms, env, funs, ens)

def inferMatch2(o: Out, arms: List[Arm], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(o)) o else if (List.isEmpty(arms)) o else inferMatchArm(List.head(arms), o.ty, env, funs, ens)

def inferMatchArm(arm: Arm, scrutTy: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  arm match {
    case Arm(pat, _, body) => infer(body, bindPat(pat, scrutTy, env, ens), funs, ens)
  }

def parenAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 40) i else parenAt(s, i + 1)

def patBind(pat: String): String =
  patBind2(parenAt(pat, 0), pat)

def patBind2(p: Int, pat: String): String =
  if (p < 0) "" else patBind3(p, closeParen(pat, p + 1, 1), pat)

def patBind3(p: Int, c: Int, pat: String): String =
  if (c < 0) Str.slice(pat, p + 1, Str.len(pat) - 1) else Str.slice(pat, p + 1, c)

def closeParen(s: String, i: Int, d: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else closeParenCh(s, i, d, Str.charAt(s, i))

def closeParenCh(s: String, i: Int, d: Int, c: Int): Int =
  if (c == 40) closeParen(s, i + 1, d + 1) else if (c == 41) closeParenDone(s, i, d) else closeParen(s, i + 1, d)

def closeParenDone(s: String, i: Int, d: Int): Int =
  if (d == 1) i else closeParen(s, i + 1, d - 1)

def patCore(pat: String): String =
  patCore2(parenAt(pat, 0), pat)

def patCore2(p: Int, pat: String): String =
  if (p < 0) pat else Str.slice(pat, 0, p)

def bindPat(pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindPat2(patBind(pat), pat, scrutTy, env, ens)

def bindPat2(b: String, pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  if (asAt(pat, 0) >= 0) bindAs(pat, scrutTy, env, ens) else if (consAt(pat, 0) >= 0) bindCons(pat, scrutTy, env, ens) else if (isTuplePat(pat)) bindTuple(pat, scrutTy, env) else if (hasComma(b)) bindTuple2(splitComma(b), recFieldTys(ens, patCore(pat)), env) else if (asAt(b, 0) >= 0) bindAs(b, bindTy(pat, scrutTy, ens), env, ens) else if (eqAt(b, 0) >= 0) bindEq(b, bindTy(pat, scrutTy, ens), env, ens) else if (consAt(b, 0) >= 0) bindCons(b, bindTy(pat, scrutTy, ens), env, ens) else if (b == "") bindBare(pat, scrutTy, env) else (b, bindTy(pat, scrutTy, ens)) :: env

def eqAt(s: String, i: Int): Int =
  eqAtD(s, i, 0)

def eqAtD(s: String, i: Int, d: Int): Int =
  if (i + 3 > Str.len(s)) 0 - 1 else if (d == 0 && Str.slice(s, i, i + 3) == " = ") i else eqAtD(s, i + 1, asDepth(s, i, d))

def bindEq(b: String, ty: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindPat(Str.slice(b, eqAt(b, 0) + 3, Str.len(b)), ty, env, ens)

def consAt(s: String, i: Int): Int =
  consAtD(s, i, 0)

def consAtD(s: String, i: Int, d: Int): Int =
  if (i + 4 > Str.len(s)) 0 - 1 else if (d == 0 && Str.slice(s, i, i + 4) == " :: ") i else consAtD(s, i + 1, asDepth(s, i, d))

def bindCons(pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindConsAt(consAt(pat, 0), pat, scrutTy, env, ens)

def bindConsAt(i: Int, pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindPat(Str.slice(pat, i + 4, Str.len(pat)), scrutTy, bindPat(Str.slice(pat, 0, i), elemOf(scrutTy), env, ens), ens)

def bindBare(pat: String, scrutTy: String, env: List[(String, String)]): List[(String, String)] =
  if (isBareName(pat)) (pat, scrutTy) :: env else env

def isBareName(s: String): Bool =
  Str.len(s) > 0 && isBareStart(Str.charAt(s, 0)) && s != "_"

def isBareStart(c: Int): Bool =
  c >= 65 && c <= 90 || c >= 97 && c <= 122

def asAt(s: String, i: Int): Int =
  asAtD(s, i, 0)

def asAtD(s: String, i: Int, d: Int): Int =
  if (i + 3 > Str.len(s)) 0 - 1 else if (d == 0 && Str.slice(s, i, i + 3) == " @ ") i else asAtD(s, i + 1, asDepth(s, i, d))

def asDepth(s: String, i: Int, d: Int): Int =
  asDepthCh(Str.charAt(s, i), d)

def asDepthCh(c: Int, d: Int): Int =
  if (c == 40) d + 1 else if (c == 41 && d > 0) d - 1 else if (c == 41) 0 else d

def bindAs(pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindAsAt(asAt(pat, 0), pat, scrutTy, env, ens)

def bindAsAt(i: Int, pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindPat(Str.slice(pat, i + 3, Str.len(pat)), scrutTy, (Str.slice(pat, 0, i), scrutTy) :: env, ens)

def isTuplePat(pat: String): Bool =
  Str.len(pat) > 0 && Str.charAt(pat, 0) == 40

def bindTuple(pat: String, scrutTy: String, env: List[(String, String)]): List[(String, String)] =
  bindTuple2(splitComma(Str.slice(pat, 1, Str.len(pat) - 1)), splitComma(tupleInner(scrutTy)), env)

def tupleInner(ty: String): String =
  if (Str.len(ty) > 0 && Str.charAt(ty, 0) == 40) Str.slice(ty, 1, Str.len(ty) - 1) else ty

def splitComma(s: String): List[String] =
  splitCommaAt(s, commaAt(s, 0))

def commaAt(s: String, i: Int): Int =
  commaAtD(s, i, 0)

def commaAtD(s: String, i: Int, d: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else commaAtC(s, i, d, Str.charAt(s, i))

def commaAtC(s: String, i: Int, d: Int, c: Int): Int =
  if (c == 40) commaAtD(s, i + 1, d + 1) else if (c == 41) commaAtD(s, i + 1, if (d > 0) d - 1 else 0) else if (c == 44 && d == 0) i else commaAtD(s, i + 1, d)

def splitCommaAt(s: String, c: Int): List[String] =
  if (c < 0) trimName(s) :: noStr() else trimName(Str.slice(s, 0, c)) :: splitComma(Str.slice(s, c + 1, Str.len(s)))

def trimName(s: String): String =
  trimName2(s, 0, Str.len(s))

def trimName2(s: String, a: Int, b: Int): String =
  if (a >= b) "" else if (Str.charAt(s, a) == 32) trimName2(s, a + 1, b) else if (Str.charAt(s, b - 1) == 32) trimName2(s, a, b - 1) else Str.slice(s, a, b)

def bindTuple2(ns: List[String], ts: List[String], env: List[(String, String)]): List[(String, String)] =
  if (List.isEmpty(ns)) env else bindSlot(List.head(ns), if (List.isEmpty(ts)) "Any" else List.head(ts), bindTuple2(List.tail(ns), if (List.isEmpty(ts)) ts else List.tail(ts), env))

def bindSlot(n: String, ty: String, env: List[(String, String)]): List[(String, String)] =
  if (isTuplePat(n)) bindTuple(n, ty, env) else (n, ty) :: env

def bindTy(pat: String, scrutTy: String, ens: List[En]): String =
  bindTyGot(patCore(pat), fieldTy(ens, patCore(pat)), scrutTy)

def bindTyGot(core: String, ft: String, scrutTy: String): String =
  if (ft == "") ctorElem(core, scrutTy) else ft

def ctorElem(core: String, scrutTy: String): String =
  ctorElem2(ctorName(core), splitComma(elemOf(scrutTy)))

def ctorName(core: String): String =
  ctorName2(dotAt(core, 0), core)

def ctorName2(d: Int, core: String): String =
  if (d < 0) core else Str.slice(core, d + 1, Str.len(core))

def ctorElem2(name: String, args: List[String]): String =
  if (List.isEmpty(args)) "Any" else if (name == "Right" || name == "Err") ctorSecond(args) else List.head(args)

def ctorSecond(args: List[String]): String =
  if (List.isEmpty(List.tail(args))) List.head(args) else List.head(List.tail(args))

def fieldTy(ens: List[En], core: String): String =
  fieldTy2(dotAt(core, 0), core, ens)

def dotAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 46) i else dotAt(s, i + 1)

def fieldTy2(dot: Int, core: String, ens: List[En]): String =
  if (dot < 0) "" else caseFieldTy(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def caseFieldTy(ens: List[En], en: String, ctor: String): String =
  if (List.isEmpty(ens)) "" else caseFieldTy1(List.head(ens), List.tail(ens), en, ctor)

def caseFieldTy1(h: En, rest: List[En], en: String, ctor: String): String =
  h match {
    case En(_, name, _, cases) => if (name == en) caseFieldTy2(cases, ctor) else caseFieldTy(rest, en, ctor)
  }

def caseFieldTy2(cs: List[EnCase], ctor: String): String =
  if (List.isEmpty(cs)) "" else caseFieldTy3(List.head(cs), List.tail(cs), ctor)

def caseFieldTy3(h: EnCase, rest: List[EnCase], ctor: String): String =
  h match {
    case EnCase(name, fields) => if (name == ctor) firstFieldTy(fields) else caseFieldTy2(rest, ctor)
  }

def firstFieldTy(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else paramTyOf(List.head(ps))

def paramTyOf(p: Param): String =
  p match {
    case Param(_, ty, _, _) => ty
  }

def hasComma(s: String): Bool =
  commaAt(s, 0) >= 0

def recFieldTys(ens: List[En], core: String): List[String] =
  recFieldTys2(dotAt(core, 0), core, ens)

def recFieldTys2(dot: Int, core: String, ens: List[En]): List[String] =
  if (dot < 0) enFieldTys(ens, core) else caseFieldTys(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def enFieldTys(ens: List[En], name: String): List[String] =
  if (List.isEmpty(ens)) noStr() else enFieldTys1(List.head(ens), List.tail(ens), name)

def enFieldTys1(h: En, rest: List[En], name: String): List[String] =
  h match {
    case En(_, n, _, cases) => if (n == name) firstCaseTys(cases) else enFieldTys(rest, name)
  }

def firstCaseTys(cs: List[EnCase]): List[String] =
  if (List.isEmpty(cs)) noStr() else firstCaseTys1(List.head(cs))

def firstCaseTys1(c: EnCase): List[String] =
  c match {
    case EnCase(_, fields) => paramTys(fields)
  }

def caseFieldTys(ens: List[En], en: String, ctor: String): List[String] =
  if (List.isEmpty(ens)) noStr() else caseFieldTys1(List.head(ens), List.tail(ens), en, ctor)

def caseFieldTys1(h: En, rest: List[En], en: String, ctor: String): List[String] =
  h match {
    case En(_, name, _, cases) => if (name == en) caseFieldTys2(cases, ctor) else caseFieldTys(rest, en, ctor)
  }

def caseFieldTys2(cs: List[EnCase], ctor: String): List[String] =
  if (List.isEmpty(cs)) noStr() else caseFieldTys3(List.head(cs), List.tail(cs), ctor)

def caseFieldTys3(h: EnCase, rest: List[EnCase], ctor: String): List[String] =
  h match {
    case EnCase(name, fields) => if (name == ctor) paramTys(fields) else caseFieldTys2(rest, ctor)
  }

def inferMethod(recv: Expr, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (name == "flatMap") inferFlatMap(recv, args, env, funs, ens, e) else inferMethod2(recv, name, args, env, funs, ens)

def inferMethod2(recv: Expr, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  recv match {
    case Expr.EVar(en) => if (getTy(env, en) != "") inferCall(Str.concat(".", name), recv :: args, env, funs, ens) else inferMethodEn(en, name, args, env, funs, ens)
    case _ => inferCall(Str.concat(".", name), recv :: args, env, funs, ens)
  }

def inferMethodEn(en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferMethodQual(Str.concat(en, Str.concat(".", name)), en, name, args, env, funs, ens)

def inferMethodQual(q: String, en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (isKit(q) || isOpenKit(q)) inferCall(q, args, env, funs, ens) else if (hasEn(ens, en)) inferCtor(en, args, env, funs, ens) else resolveQual(en, name, args, env, funs, ens)

def resolveQual(en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  resolveQualHit(en, name, args, env, funs, ens, findFunMod(funs, en, name))

def resolveQualHit(en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], hit: List[Fun]): Out =
  if (List.isEmpty(hit)) checkKnown(Str.concat(en, Str.concat(".", name)), anyParams(List.len(args)), "Any", args, env, funs, ens, Parse.pretty0(Expr.EMethod(Expr.EVar(en), name, args))) else resolveUser(Str.concat(en, Str.concat(".", name)), args, env, funs, ens, Parse.pretty0(Expr.EMethod(Expr.EVar(en), name, args)), hit)

def inferCtor(en: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(args)) ok(en) else inferCtorHead(en, List.head(args), List.tail(args), env, funs, ens)

def inferCtorHead(en: String, h: Expr, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferCtorFrom(en, infer(h, env, funs, ens), rest, env, funs, ens)

def inferCtorFrom(en: String, o: Out, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(o)) o else inferCtorRest(en, o, firstArgErr(rest, env, funs, ens), ens)

def inferCtorRest(en: String, o: Out, restErr: Out, ens: List[En]): Out =
  if (hasErr(restErr)) restErr else inferCtor2(en, o, ens)

def inferCtor2(en: String, o: Out, ens: List[En]): Out =
  if (hasErr(o)) o else if (enHasParams(ens, en)) ok(Str.concat(en, Str.concat("[", Str.concat(o.ty, "]")))) else ok(en)

def enHasParams(ens: List[En], name: String): Bool =
  if (List.isEmpty(ens)) false else enHasParams1(List.head(ens), List.tail(ens), name)

def enHasParams1(h: En, rest: List[En], name: String): Bool =
  h match {
    case En(_, n, tps, _) => if (n == name) List.len(tps) > 0 else enHasParams(rest, name)
  }

def isIo(t: String): Bool =
  Str.startsWith(t, "IO[")

def inferFlatMap(recv: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferFlatMap2(infer(recv, env, funs, ens), args, env, funs, ens, e)

def inferFlatMap2(o: Out, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (List.len(args) != 1) bad(Str.concat("flatMap expects 1 args, got ", Str.fromInt(List.len(args))), Parse.pretty0(e)) else inferFlatMapLam(o, List.head(args), env, funs, ens, e)

def inferFlatMapLam(recv: Out, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  lam match {
    case Expr.ELam(p, body) => inferFlatMap3(recv, infer(body, bindIo(p, recv.ty, env), funs, ens), e)
    case _ => inferFlatMap3(recv, infer(lam, env, funs, ens), e)
  }

def bindIo(p: String, ioTy: String, env: List[(String, String)]): List[(String, String)] =
  if (p == "_" || p == "") env else (p, ioPayload(ioTy)) :: env

def ioPayload(t: String): String =
  if (isIo(t) && Str.len(t) > 4) Str.slice(t, 3, Str.len(t) - 1) else "Any"

def inferFlatMap3(recv: Out, body: Out, e: Expr): Out =
  if (hasErr(body)) body else if (isIo(recv.ty) && isIo(body.ty)) ok(body.ty) else if (isIo(recv.ty) && body.ty == "Any") ok(recv.ty) else if (recv.ty == "Any") ok(if (isIo(body.ty)) body.ty else "IO[Any]") else bad(Str.concat("flatMap needs IO, got ", Str.concat(recv.ty, Str.concat(" and ", body.ty))), Parse.pretty0(e))

def inferVar(s: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferVar2(s, getTy(env, s), env, funs, ens)

def inferVar2(s: String, t: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (t == "") inferVarFun(s, findFunPrefer(funs, s, env), ens) else ok(t)

def inferVarFun(s: String, hit: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(hit)) inferVarCase(s, ens) else ok(funTyOf(List.head(hit)))

def inferVarCase(s: String, ens: List[En]): Out =
  if (enOfCase(ens, s) == "") bad(Str.concat("unbound variable ", s), s) else ok(enOfCase(ens, s))

def funTyOf(d: Fun): String =
  d match {
    case Fun(_, _, _, ps, ret, _, _) => funTyFrom(paramTys(ps), ret)
  }

def funTyFrom(ps: List[String], ret: String): String =
  if (List.isEmpty(ps)) ret else if (List.len(ps) == 1) Str.concat(List.head(ps), Str.concat(" => ", ret)) else Str.concat("(", Str.concat(joinComma(ps), Str.concat(") => ", ret)))

def joinComma(ps: List[String]): String =
  if (List.isEmpty(ps)) "" else if (List.isEmpty(List.tail(ps))) List.head(ps) else Str.concat(List.head(ps), Str.concat(", ", joinComma(List.tail(ps))))

def inferList(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(xs)) ok("List") else inferList2(infer(List.head(xs), env, funs, ens))

def inferList2(o: Out): Out =
  if (hasErr(o)) o else ok(Str.concat("List[", Str.concat(o.ty, "]")))

def inferTuple(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferTupleAcc(xs, env, funs, ens, "")

def inferTupleAcc(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  if (List.isEmpty(xs)) inferTupleDone(acc) else inferTupleHd(List.head(xs), xs, env, funs, ens, acc)

def inferTupleDone(acc: String): Out =
  if (acc == "") ok("Unit") else ok(Str.concat("(", Str.concat(acc, ")")))

def inferTupleHd(h: Expr, xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  inferTupleGot(infer(stripNamed(h), env, funs, ens), xs, env, funs, ens, acc)

def inferTupleGot(o: Out, xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else inferTupleRest(List.tail(xs), env, funs, ens, if (acc == "") ty else Str.concat(acc, Str.concat(", ", ty)))
  }

def inferTupleRest(rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  inferTupleAcc(rest, env, funs, ens, acc)

def checkDef(d: Fun, funs: List[Fun], ens: List[En]): Out =
  d match {
    case Fun(_, name, _, ps, ret, body, mod) => checkDefWrap(name, ret, body, infer(body, bindParams(ps, ("self", "Any") :: ("#mod", mod) :: noEnv()), funs, ens))
  }

def checkDefWrap(name: String, ret: String, body: Expr, o: Out): Out =
  if (hasErr(o)) bad(Str.concat("in ", Str.concat(name, Str.concat(": ", o.err))), o.span) else checkDefGot(name, ret, body, o)

def checkDefGot(name: String, ret: String, body: Expr, o: Out): Out =
  if (hasErr(o)) o else if (tyEq(o.ty, ret) || funBodyEq(o.ty, ret)) o else bad(Str.concat("def ", Str.concat(name, Str.concat(" body ", Str.concat(o.ty, Str.concat(" does not match declared ", ret))))), Parse.pretty0(body))

def funBodyEq(got: String, ret: String): Bool =
  isFunTy(ret) && tyEq(got, funRetOf(ret))

def checkProg(p: Prog): Out =
  checkProgOwn(p, [])

def checkProgOwn(p: Prog, stems: List[String]): Out =
  p match {
    case Prog(_, enums, aliases, _, _, imps, defs, main, body) => checkProgGo(expandDefs(withImportFuns(imps, defs), aliases), enums, main, body, stems)
  }

def checkProgGo(ds: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  checkDefsRest(ds, ds, enums, main, body, stems)

def withImportFuns(imps: List[Imp], defs: List[Fun]): List[Fun] =
  List.concat(importFuns(imps, defs), defs)

def importFuns(imps: List[Imp], defs: List[Fun]): List[Fun] =
  if (List.isEmpty(imps)) [] else importFunsGo(List.head(imps), List.tail(imps), defs)

def importFunsGo(h: Imp, rest: List[Imp], defs: List[Fun]): List[Fun] =
  List.concat(importFun1(h, defs), importFuns(rest, defs))

def importFun1(h: Imp, defs: List[Fun]): List[Fun] =
  h match {
    case Imp(mod, name, alias) => if (alias == "") [] else renameHits(findFunMod(defs, mod, name), alias)
  }

def renameHits(hit: List[Fun], alias: String): List[Fun] =
  if (List.isEmpty(hit)) [] else renameFun(List.head(hit), alias) :: []

def renameFun(d: Fun, alias: String): Fun =
  d match {
    case Fun(priv, _, ts, ps, ret, body, mod) => Fun(priv, alias, ts, ps, ret, body, mod)
  }

def expandDefs(defs: List[Fun], als: List[Alias]): List[Fun] =
  List.reverse(expandDefsGo(defs, als, []))

def expandDefsGo(defs: List[Fun], als: List[Alias], acc: List[Fun]): List[Fun] =
  if (List.isEmpty(defs)) acc else expandDefsGo(List.tail(defs), als, expandDef(List.head(defs), als) :: acc)

def expandDef(d: Fun, als: List[Alias]): Fun =
  d match {
    case Fun(priv, name, ts, ps, ret, body, mod) => Fun(priv, name, ts, expandParams(ps, als), expandTy(ret, als), body, mod)
  }

def expandParams(ps: List[Param], als: List[Alias]): List[Param] =
  if (List.isEmpty(ps)) ps else expandParam(List.head(ps), als) :: expandParams(List.tail(ps), als)

def expandParam(p: Param, als: List[Alias]): Param =
  p match {
    case Param(n, ty, w, d) => Param(n, expandTy(ty, als), w, d)
  }

def expandTy(t: String, als: List[Alias]): String =
  if (List.isEmpty(als)) t else expandTyGo(t, List.head(als), als)

def expandTyGo(t: String, h: Alias, als: List[Alias]): String =
  h match {
    case Alias(name, tps, target) => expandTyHit(t, name, tps, target, als)
  }

def expandTyHit(t: String, name: String, tps: List[String], target: String, als: List[Alias]): String =
  if (t == name && List.isEmpty(tps)) target else if (isTyApp(t, name) && !List.isEmpty(tps)) expandTy(substTy(target, List.head(tps), tyAppArg(t, name)), List.tail(als)) else expandTy(t, List.tail(als))

def isTyApp(t: String, name: String): Bool =
  Str.len(t) > Str.len(name) + 1 && Str.slice(t, 0, Str.len(name) + 1) == Str.concat(name, "[") && Str.charAt(t, Str.len(t) - 1) == 93

def tyAppArg(t: String, name: String): String =
  Str.slice(t, Str.len(name) + 1, Str.len(t) - 1)

def substTy(target: String, param: String, arg: String): String =
  substTyAt(target, param, arg, 0)

def substTyAt(target: String, param: String, arg: String, i: Int): String =
  if (i + Str.len(param) > Str.len(target)) target else if (Str.slice(target, i, i + Str.len(param)) == param && tyBound(target, i, Str.len(param))) Str.concat(Str.slice(target, 0, i), Str.concat(arg, substTy(Str.slice(target, i + Str.len(param), Str.len(target)), param, arg))) else substTyAt(target, param, arg, i + 1)

def tyBound(s: String, i: Int, n: Int): Bool =
  tyBoundL(s, i) && tyBoundR(s, i + n)

def tyBoundL(s: String, i: Int): Bool =
  i == 0 || !isTyChar(Str.charAt(s, i - 1))

def tyBoundR(s: String, i: Int): Bool =
  i >= Str.len(s) || !isTyChar(Str.charAt(s, i))

def isTyChar(c: Int): Bool =
  c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95

def inStems(stems: List[String], mod: String): Bool =
  List.isEmpty(stems) || hasStem(stems, mod)

def hasStem(stems: List[String], mod: String): Bool =
  if (List.isEmpty(stems)) false else if (List.head(stems) == mod) true else hasStem(List.tail(stems), mod)

def checkDefsRest(all: List[Fun], rest: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  if (List.isEmpty(rest)) checkMain(main, body, all, enums) else checkDefsHit(List.head(rest), all, List.tail(rest), enums, main, body, stems)

def checkDefsHit(d: Fun, all: List[Fun], rest: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  d match {
    case Fun(_, _, _, _, _, _, mod) => if (inStems(stems, mod)) checkDefsAfter(checkDef(d, all, enums), all, rest, enums, main, body, stems) else checkDefsRest(all, rest, enums, main, body, stems)
  }

def checkDefsAfter(o: Out, all: List[Fun], rest: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  if (hasErr(o)) o else checkDefsRest(all, rest, enums, main, body, stems)

def checkMain(name: String, body: Expr, funs: List[Fun], ens: List[En]): Out =
  if (name == "") ok("IO[Unit]") else checkMainGot(infer(body, noEnv(), funs, ens))

def checkMainGot(o: Out): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else if (ty == "IO[Unit]") Out(ty, err, sp) else bad(Str.concat("@main body must be IO[Unit], got ", ty), if (Str.len(sp) > 0) sp else "1")
  }

def findIdx(src: String, needle: String, i: Int): Int =
  if (Str.len(needle) == 0 || i + Str.len(needle) > Str.len(src)) 0 - 1 else if (Str.slice(src, i, i + Str.len(needle)) == needle) i else findIdx(src, needle, i + 1)

def lineCol(src: String, i: Int, j: Int, line: Int, col: Int): (Int, Int) =
  if (j >= i) (line, col) else if (Str.charAt(src, j) == 10) lineCol(src, i, j + 1, line + 1, 1) else lineCol(src, i, j + 1, line, col + 1)

def locOf(src: String, needle: String): (Int, Int, Int, Int) =
  locOf2(src, needle, findIdx(src, needle, 0))

def locOf2(src: String, needle: String, i: Int): (Int, Int, Int, Int) =
  if (i < 0) (1, 1, 1, 1) else locOf3(lineCol(src, i, 0, 1, 1), needle)

def locOf3(p: (Int, Int), needle: String): (Int, Int, Int, Int) =
  p match {
    case (line, col) => locOf4(line, col, needle)
  }

def locOf4(line: Int, col: Int, needle: String): (Int, Int, Int, Int) =
  (line, col, line, if (Str.len(needle) > 0 && Str.charAt(needle, Str.len(needle) - 1) == 41) col + Str.len(needle) - 1 else col + Str.len(needle))

def jsonStr(s: String): String =
  Str.concat("\"", Str.concat(_esc(s, 0, Builder.empty()), "\""))

def _esc(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else _esc2(s, i, b, Str.charAt(s, i))

def _esc2(s: String, i: Int, b: Builder, c: Int): String =
  _esc(s, i + 1, Builder.append(b, if (c == 34) "\\\"" else if (c == 92) "\\\\" else if (c == 10) "\\n" else Str.slice(s, i, i + 1)))

def diagJson(src: String, o: Out): String =
  diagJson2(o, locOf(src, o.span))

def diagJson2(o: Out, loc: (Int, Int, Int, Int)): String =
  loc match {
    case (line, col, eline, ecol) => diagJson3(o, line, col, eline, ecol)
  }

def diagJson3(o: Out, line: Int, col: Int, eline: Int, ecol: Int): String =
  Str.concat("{\"severity\":\"error\",\"message\":", Str.concat(jsonStr(Str.concat("type error: ", o.err)), Str.concat(",\"file\":\"t/src/Main.scuzz\",\"line\":", Str.concat(Str.fromInt(line), Str.concat(",\"column\":", Str.concat(Str.fromInt(col), Str.concat(",\"end_line\":", Str.concat(Str.fromInt(eline), Str.concat(",\"end_column\":", Str.concat(Str.fromInt(ecol), "}"))))))))))

def check(src: String): String =
  check2(src, checkProg(Parse.parse(Lexer.lex(src))))

def checkFiles(files: List[(String, String)]): String =
  checkFilesOwn(files, [])

def checkFilesOwn(files: List[(String, String)], stems: List[String]): String =
  check2(filesSrc(files), checkProgOwn(Parse.parseFiles(files), stems))

def filesSrc(files: List[(String, String)]): String =
  if (List.isEmpty(files)) "" else filesSrc2(List.head(files), List.tail(files))

def filesSrc2(f: (String, String), rest: List[(String, String)]): String =
  f match {
    case (_, src) => Str.concat(src, filesSrc(rest))
  }

def check2(src: String, o: Out): String =
  if (hasErr(o)) Str.concat("[", Str.concat(diagJson(src, o), "]")) else "[]"

def unclaimedJson(files: List[(String, String)]): String =
  unclaimedOf(Parse.parseFiles(files))

def unclaimedOf(p: Prog): String =
  if (p.main == "") "[]" else Str.concat("[", Str.concat(unclaimedMain(p.main), "]"))

def unclaimedMain(name: String): String =
  Str.concat("{\"severity\":\"info\",\"message\":\"unclaimed def ", Str.concat(name, "\",\"line\":1,\"column\":1}"))

def humanLine(src: String, o: Out): String =
  humanLine2(o, locOf(src, o.span))

def humanLine2(o: Out, loc: (Int, Int, Int, Int)): String =
  loc match {
    case (line, col, _, _) => humanLine3(o, line, col)
  }

def humanLine3(o: Out, line: Int, col: Int): String =
  Str.concat("t/src/Main.scuzz:", Str.concat(Str.fromInt(line), Str.concat(":", Str.concat(Str.fromInt(col), Str.concat(": error: type error: ", o.err)))))

def human(src: String): String =
  human2(src, checkProg(Parse.parse(Lexer.lex(src))))

def humanFiles(files: List[(String, String)]): String =
  humanFilesOwn(files, [])

def humanFilesOwn(files: List[(String, String)], stems: List[String]): String =
  human2(filesSrc(files), checkProgOwn(Parse.parseFiles(files), stems))

def human2(src: String, o: Out): String =
  if (hasErr(o)) humanLine(src, o) else "scuzz check ok"

