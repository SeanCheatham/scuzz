record Out(ty: String, err: String, span: String)

import Parse.Expr
import Parse.Fun
import Parse.Param
import Parse.Prog
import Parse.En
import Parse.EnCase
import Parse.Arm

def noStr(): List[String] =
  []

def noEnv(): List[(String, String)] =
  []

def ok(ty: String): Out =
  Out(ty, "", "")

def bad(err: String, span: String): Out =
  Out("", err, span)

def hasErr(o: Out): Bool =
  Str.len(o.err) > 0

def getTy(env: List[(String, String)], name: String): String =
  if (List.isEmpty(env)) "" else if (List.head(env)._1 == name) List.head(env)._2 else getTy(List.tail(env), name)

def bindParams(ps: List[Param], acc: List[(String, String)]): List[(String, String)] =
  if (List.isEmpty(ps)) acc else bindParams(List.tail(ps), (List.head(ps).name, List.head(ps).ty) :: acc)

def findFun(funs: List[Fun], name: String): List[Fun] =
  if (List.isEmpty(funs)) [] else findFun1(List.head(funs), List.tail(funs), name)

def findFun1(h: Fun, rest: List[Fun], name: String): List[Fun] =
  h match {
    case Fun(priv, n, ts, ps, ret, body, mod) => if (n == name) Fun(priv, n, ts, ps, ret, body, mod) :: findFun(rest, name) else findFun(rest, name)
  }

def findFunMod(funs: List[Fun], mod: String, name: String): List[Fun] =
  if (List.isEmpty(funs)) [] else findFunMod1(List.head(funs), List.tail(funs), mod, name)

def findFunMod1(h: Fun, rest: List[Fun], mod: String, name: String): List[Fun] =
  h match {
    case Fun(priv, n, ts, ps, ret, body, m) => if (n == name && m == mod) Fun(priv, n, ts, ps, ret, body, m) :: findFunMod(rest, mod, name) else findFunMod(rest, mod, name)
  }

def paramTys(ps: List[Param]): List[String] =
  if (List.isEmpty(ps)) [] else paramTys1(List.head(ps), List.tail(ps))

def paramTys1(p: Param, rest: List[Param]): List[String] =
  p match {
    case Param(_, ty, _, _) => ty :: paramTys(rest)
  }

def stripNamed(e: Expr): Expr =
  e match {
    case Expr.ENamed(_, inner) => inner
    case _ => e
  }

def isKit(f: String): Bool =
  f == "Str.fromInt" || f == "Str.concat" || f == "Str.len" || f == "Str.fromBool" || f == "Str.charAt" || f == "Str.slice" || f == "Str.toInt" || f == "Str.repeat" || f == "List.len" || f == "List.concat" || f == "List.reverse" || f == "List.head" || f == "List.tail" || f == "List.isEmpty" || f == "List.cons" || f == "List.at" || f == "Builder.empty" || f == "Builder.append" || f == "Builder.result" || f == "Fs.read" || f == "Fs.write" || f == "Fs.list" || f == "Sys.args" || f == "IO.pure"

def kitParams(f: String): List[String] =
  if (f == "Str.fromInt") "Int" :: noStr() else if (f == "Str.concat") "String" :: "String" :: noStr() else if (f == "Str.len") "String" :: noStr() else if (f == "Str.fromBool") "Bool" :: noStr() else if (f == "Str.charAt") "String" :: "Int" :: noStr() else if (f == "Str.slice") "String" :: "Int" :: "Int" :: noStr() else if (f == "Str.toInt") "String" :: "Int" :: noStr() else if (f == "Str.repeat") "String" :: "Int" :: noStr() else if (f == "List.len" || f == "List.reverse" || f == "List.head" || f == "List.tail" || f == "List.isEmpty") "List" :: noStr() else if (f == "List.concat") "List" :: "List" :: noStr() else if (f == "List.cons") "Any" :: "List" :: noStr() else if (f == "List.at") "List" :: "Int" :: noStr() else if (f == "Builder.empty") noStr() else if (f == "Builder.append") "Builder" :: "String" :: noStr() else if (f == "Builder.result") "Builder" :: noStr() else if (f == "Fs.read" || f == "Fs.list") "String" :: noStr() else if (f == "Fs.write") "String" :: "String" :: noStr() else if (f == "IO.pure") "Any" :: noStr() else noStr()

def kitRet(f: String): String =
  if (f == "Str.len" || f == "List.len" || f == "Str.charAt" || f == "Str.toInt" || f == "List.head" || f == "List.at") "Int" else if (f == "List.concat" || f == "List.reverse" || f == "List.tail" || f == "List.cons") "List[Int]" else if (f == "List.isEmpty") "Bool" else if (f == "Builder.empty" || f == "Builder.append") "Builder" else if (f == "Fs.read") "IO[String]" else if (f == "Fs.write") "IO[Unit]" else if (f == "Fs.list") "IO[List[(String, Bool)]]" else if (f == "Sys.args") "IO[List[String]]" else if (f == "IO.pure") "IO[Any]" else "String"

def isArith(op: String): Bool =
  op == "+" || op == "-" || op == "*" || op == "/" || op == "%"

def isEq(op: String): Bool =
  op == "==" || op == "!="

def isOrd(op: String): Bool =
  op == "<" || op == "<=" || op == ">" || op == ">="

def isLogic(op: String): Bool =
  op == "&&" || op == "||"

def isBit(op: String): Bool =
  op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>"

def firstArgErr(args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(args)) ok("") else firstArgErr2(infer(stripNamed(List.head(args)), env, funs, ens), List.tail(args), env, funs, ens)

def firstArgErr2(o: Out, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(o)) o else firstArgErr(rest, env, funs, ens)

def zipCheck(callee: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, acc: String): Out =
  if (List.isEmpty(want)) ok(acc) else zipCheckHd(callee, List.head(want), List.tail(want), args, env, funs, ens, span, acc)

def zipCheckHd(callee: String, w: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, acc: String): Out =
  zipCheckArg(callee, w, want, List.head(args), List.tail(args), env, funs, ens, span, acc)

def zipCheckArg(callee: String, w: String, want: List[String], arg: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, acc: String): Out =
  if (List.isEmpty(args)) zipCheckLast(infer(stripNamed(arg), env, funs, ens), callee, w, span, acc) else zipCheck2(callee, w, infer(stripNamed(arg), env, funs, ens), want, args, env, funs, ens, span, acc)

def zipCheckLast(o: Out, callee: String, w: String, span: String, acc: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else if (tyEq(ty, w) || w == "Any") ok(if (acc == "") ty else acc) else argMismatch(callee, w, ty, span)
  }

def zipCheck2(callee: String, w: String, o: Out, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, acc: String): Out =
  o match {
    case Out(ty, err, sp) => zipCheckErr(callee, w, ty, err, sp, want, args, env, funs, ens, span, acc)
  }

def zipCheckErr(callee: String, w: String, ty: String, err: String, sp: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, acc: String): Out =
  if (Str.len(err) > 0) Out(ty, err, sp) else zipCheckEq(callee, w, ty, want, args, env, funs, ens, span, acc)

def zipCheckEq(callee: String, w: String, got: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, acc: String): Out =
  if (tyEq(got, w) || w == "Any") zipCheck(callee, want, args, env, funs, ens, span, if (acc == "") got else acc) else argMismatch(callee, w, got, span)

def argMismatch(callee: String, w: String, got: String, span: String): Out =
  bad(argMismatchMsg(argMismatchWant(callee, w), got), span)

def argMismatchWant(callee: String, w: String): String =
  Str.concat(callee, Str.concat(" arg type mismatch: expected ", Str.concat(w, ", got ")))

def argMismatchMsg(prefix: String, got: String): String =
  Str.concat(prefix, got)

def listMatch(w: String, g: String): Bool =
  w == "List" && isListTy(g) || g == "List" && isListTy(w)

def isListTy(t: String): Bool =
  t == "List" || Str.startsWith(t, "List[")

def tyEq(a: String, b: String): Bool =
  a == b || listMatch(a, b) || tupEq(a, b)

def isTup(t: String): Bool =
  Str.len(t) > 0 && Str.charAt(t, 0) == 40

def tupEq(a: String, b: String): Bool =
  isTup(a) && isTup(b) && partsEq(splitComma(tupleInner(a)), splitComma(tupleInner(b)))

def partsEq(xs: List[String], ys: List[String]): Bool =
  if (List.isEmpty(xs)) List.isEmpty(ys) else if (List.isEmpty(ys)) false else tyEq(List.head(xs), List.head(ys)) && partsEq(List.tail(xs), List.tail(ys))

def prefer(a: String, b: String): String =
  if (a == b) a else if (a == "List") b else if (b == "List") a else if (isTup(a) && isTup(b)) preferTup(a, b) else a

def preferTup(a: String, b: String): String =
  Str.concat("(", Str.concat(preferParts(splitComma(tupleInner(a)), splitComma(tupleInner(b))), ")"))

def preferParts(xs: List[String], ys: List[String]): String =
  if (List.isEmpty(xs) || List.isEmpty(ys)) "" else if (List.len(xs) == 1 || List.len(ys) == 1) prefer(List.head(xs), List.head(ys)) else Str.concat(prefer(List.head(xs), List.head(ys)), Str.concat(", ", preferParts(List.tail(xs), List.tail(ys))))

def checkKnown(f: String, want: List[String], ret: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String): Out =
  if (List.len(want) != List.len(args)) bad(Str.concat(f, Str.concat(" expects ", Str.concat(Str.fromInt(List.len(want)), Str.concat(" args, got ", Str.fromInt(List.len(args)))))), span) else checkKnownRet(f, zipCheck(f, want, args, env, funs, ens, span, ""), ret)

def checkKnownRet(f: String, o: Out, ret: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else ok(kitRetFromTy(f, ty, ret))
  }

def kitRetFromTy(f: String, ty: String, ret: String): String =
  if (f == "List.head" || f == "List.at") elemOf(ty) else if (f == "List.tail" || f == "List.reverse" || f == "List.concat") kitRetList(ty, ret) else if (f == "List.cons") kitRetCons(ty, ret) else if (f == "IO.pure") Str.concat("IO[", Str.concat(ty, "]")) else ret

def kitRetList(ty: String, ret: String): String =
  if (isListTy(ty)) ty else ret

def kitRetCons(ty: String, ret: String): String =
  if (ty == "") ret else Str.concat("List[", Str.concat(ty, "]"))

def resolveCall(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  resolveCall2(f, args, env, funs, ens, Parse.pretty0(Expr.ECall(f, args)))

def resolveCall2(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String): Out =
  if (isKit(f)) checkKnown(f, kitParams(f), kitRet(f), args, env, funs, ens, span) else if (hasEn(ens, f)) inferCtor(f, args, env, funs, ens) else resolveUser(f, args, env, funs, ens, span, findFun(funs, f))

def elemOf(t: String): String =
  elemOf2(brackAt(t, 0), t)

def brackAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 91) i else brackAt(s, i + 1)

def elemOf2(b: Int, t: String): String =
  if (b < 0) "Int" else Str.slice(t, b + 1, Str.len(t) - 1)

def resolveUser(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: String, hit: List[Fun]): Out =
  if (List.isEmpty(hit)) bad(Str.concat("unknown function ", f), span) else checkKnown(f, paramTys(List.head(hit).params), List.head(hit).ret, args, env, funs, ens, span)

def inferCall(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  resolveCall(f, args, env, funs, ens)

def inferPrint(inner: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferPrint2(infer(inner, env, funs, ens), e)

def inferPrint2(o: Out, e: Expr): Out =
  if (hasErr(o)) o else if (o.ty == "String") ok("IO[Unit]") else bad(Str.concat("expected String, got ", o.ty), Parse.pretty0(e))

def inferBin(op: String, l: Expr, r: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferBin2(op, infer(l, env, funs, ens), r, env, funs, ens, e)

def inferBin2(op: String, lo: Out, r: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(lo)) lo else inferBin3(op, lo, infer(r, env, funs, ens), e)

def inferBin3(op: String, lo: Out, ro: Out, e: Expr): Out =
  if (hasErr(ro)) ro else inferBin4(op, lo.ty, ro.ty, Parse.pretty0(e))

def inferBin4(op: String, lt: String, rt: String, span: String): Out =
  if (isArith(op)) inferArith(lt, rt, span) else if (isEq(op)) inferEq(lt, rt, span) else if (isOrd(op)) inferOrd(lt, rt, span) else if (isLogic(op)) inferLogic(lt, rt, span) else if (isBit(op)) inferBit(lt, rt, span) else if (op == "::") ok(Str.concat("List[", Str.concat(lt, "]"))) else ok(lt)

def inferArith(lt: String, rt: String, span: String): Out =
  if (lt == "Int" && rt == "Int") ok("Int") else if (lt == "Float" && rt == "Float") ok("Float") else bad(Str.concat("arithmetic needs Int or Float, got ", Str.concat(lt, Str.concat(" and ", rt))), span)

def inferEq(lt: String, rt: String, span: String): Out =
  if (lt == rt) ok("Bool") else bad(Str.concat("comparison type mismatch ", Str.concat(lt, Str.concat(" vs ", rt))), span)

def inferOrd(lt: String, rt: String, span: String): Out =
  if (lt == rt && (lt == "Int" || lt == "Float")) ok("Bool") else bad("ordered compare needs Int or Float", span)

def inferLogic(lt: String, rt: String, span: String): Out =
  if (lt == "Bool" && rt == "Bool") ok("Bool") else bad(Str.concat("logic needs Bool, got ", Str.concat(lt, Str.concat(" and ", rt))), span)

def inferBit(lt: String, rt: String, span: String): Out =
  if (lt == "Int" && rt == "Int") ok("Int") else bad(Str.concat("bitwise needs Int, got ", Str.concat(lt, Str.concat(" and ", rt))), span)

def inferUn(op: String, inner: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferUn2(op, infer(inner, env, funs, ens), e)

def inferUn2(op: String, o: Out, e: Expr): Out =
  if (hasErr(o)) o else if (op == "!") inferUnBool(o, e) else inferUnInt(o, e)

def inferUnBool(o: Out, e: Expr): Out =
  if (o.ty == "Bool") ok("Bool") else bad(Str.concat("expected Bool, got ", o.ty), Parse.pretty0(e))

def inferUnInt(o: Out, e: Expr): Out =
  if (o.ty == "Int") ok("Int") else bad(Str.concat("expected Int, got ", o.ty), Parse.pretty0(e))

def inferIf(c: Expr, t: Expr, el: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferIf2(infer(c, env, funs, ens), t, el, env, funs, ens)

def inferIf2(co: Out, t: Expr, el: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(co)) co else inferIf3(infer(t, env, funs, ens), el, env, funs, ens)

def inferIf3(to: Out, el: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(to)) to else inferIf4(to, infer(el, env, funs, ens))

def inferIf4(to: Out, eo: Out): Out =
  if (hasErr(eo)) eo else if (tyEq(to.ty, eo.ty)) ok(prefer(to.ty, eo.ty)) else bad(Str.concat("type mismatch: expected ", Str.concat(to.ty, Str.concat(", got ", eo.ty))), "")

def infer(e: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  e match {
    case Expr.EInt(_) => ok("Int")
    case Expr.EBool(_) => ok("Bool")
    case Expr.EStr(_) => ok("String")
    case Expr.EFloat(_) => ok("Float")
    case Expr.EInterp(_) => ok("String")
    case Expr.EUnit => ok("Unit")
    case Expr.EHole => ok("Int")
    case Expr.EVar(s) => inferVar(s, env)
    case Expr.EPrint(inner) => inferPrint(inner, env, funs, ens, e)
    case Expr.ECall(f, args) => inferCall(f, args, env, funs, ens)
    case Expr.EBin(op, l, r) => inferBin(op, l, r, env, funs, ens, e)
    case Expr.EUn(op, inner) => inferUn(op, inner, env, funs, ens, e)
    case Expr.EIf(c, t, el) => inferIf(c, t, el, env, funs, ens)
    case Expr.ENamed(_, inner) => infer(inner, env, funs, ens)
    case Expr.EList(xs) => inferList(xs, env, funs, ens)
    case Expr.ETuple(xs) => inferTuple(xs, env, funs, ens)
    case Expr.EMethod(recv, name, args) => inferMethod(recv, name, args, env, funs, ens, e)
    case Expr.EField(recv, name) => inferField(recv, name, env, funs, ens)
    case Expr.ELam(_, body) => infer(body, env, funs, ens)
    case Expr.EMatch(s, arms) => inferMatch(s, arms, env, funs, ens)
    case Expr.EFor(_, body) => infer(body, env, funs, ens)
  }

def hasEn(ens: List[En], name: String): Bool =
  hasEnAt(ens, name, 0)

def hasEnAt(ens: List[En], name: String, i: Int): Bool =
  if (i >= List.len(ens)) false else hasEnHit(List.at(ens, i), ens, name, i)

def hasEnHit(h: En, ens: List[En], name: String, i: Int): Bool =
  if (h.name == name) true else hasEnAt(ens, name, i + 1)

def inferField(recv: Expr, name: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  recv match {
    case Expr.EVar(en) => if (hasEn(ens, en)) ok(en) else fieldOf(inferVar(en, env), name, ens)
    case _ => fieldOf(infer(recv, env, funs, ens), name, ens)
  }

def fieldOf(o: Out, name: String, ens: List[En]): Out =
  if (hasErr(o)) o else fieldOf2(o.ty, name, ens)

def fieldOf2(ty: String, name: String, ens: List[En]): Out =
  fieldOf3(fieldNamed(ens, ty, name), ty)

def fieldOf3(ft: String, ty: String): Out =
  if (ft == "") ok(ty) else ok(ft)

def fieldNamed(ens: List[En], ty: String, name: String): String =
  if (List.isEmpty(ens)) "" else fieldNamed1(List.head(ens), List.tail(ens), ty, name)

def fieldNamed1(h: En, rest: List[En], ty: String, name: String): String =
  h match {
    case En(_, n, _, cases) => if (n == ty) fieldNamed2(cases, name) else fieldNamed(rest, ty, name)
  }

def fieldNamed2(cs: List[EnCase], name: String): String =
  if (List.isEmpty(cs)) "" else fieldNamed3(List.head(cs), List.tail(cs), name)

def fieldNamed3(h: EnCase, rest: List[EnCase], name: String): String =
  h match {
    case EnCase(_, fields) => fieldNamed4(fields, name, rest)
  }

def fieldNamed4(fs: List[Param], name: String, rest: List[EnCase]): String =
  if (List.isEmpty(fs)) fieldNamed2(rest, name) else fieldNamed5(List.head(fs), List.tail(fs), name, rest)

def fieldNamed5(p: Param, rest: List[Param], name: String, restCs: List[EnCase]): String =
  p match {
    case Param(n, ty, _, _) => if (n == name) ty else fieldNamed4(rest, name, restCs)
  }

def inferMatch(s: Expr, arms: List[Arm], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferMatch2(infer(s, env, funs, ens), arms, env, funs, ens)

def inferMatch2(o: Out, arms: List[Arm], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(o)) o else if (List.isEmpty(arms)) o else inferMatchArm(List.head(arms), o.ty, env, funs, ens)

def inferMatchArm(arm: Arm, scrutTy: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  arm match {
    case Arm(pat, _, body) => infer(body, bindPat(pat, scrutTy, env, ens), funs, ens)
  }

def parenAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 40) i else parenAt(s, i + 1)

def patBind(pat: String): String =
  patBind2(parenAt(pat, 0), pat)

def patBind2(p: Int, pat: String): String =
  if (p < 0) "" else Str.slice(pat, p + 1, Str.len(pat) - 1)

def patCore(pat: String): String =
  patCore2(parenAt(pat, 0), pat)

def patCore2(p: Int, pat: String): String =
  if (p < 0) pat else Str.slice(pat, 0, p)

def bindPat(pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindPat2(patBind(pat), pat, scrutTy, env, ens)

def bindPat2(b: String, pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  if (isTuplePat(pat)) bindTuple(pat, scrutTy, env) else if (hasComma(b)) bindTuple2(splitComma(b), recFieldTys(ens, patCore(pat)), env) else if (b == "") env else (b, bindTy(pat, scrutTy, ens)) :: env

def isTuplePat(pat: String): Bool =
  Str.len(pat) > 0 && Str.charAt(pat, 0) == 40

def bindTuple(pat: String, scrutTy: String, env: List[(String, String)]): List[(String, String)] =
  bindTuple2(splitComma(Str.slice(pat, 1, Str.len(pat) - 1)), splitComma(tupleInner(scrutTy)), env)

def tupleInner(ty: String): String =
  if (Str.len(ty) > 0 && Str.charAt(ty, 0) == 40) Str.slice(ty, 1, Str.len(ty) - 1) else ty

def splitComma(s: String): List[String] =
  splitCommaAt(s, commaAt(s, 0))

def commaAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 44) i else commaAt(s, i + 1)

def splitCommaAt(s: String, c: Int): List[String] =
  if (c < 0) trimName(s) :: noStr() else trimName(Str.slice(s, 0, c)) :: splitComma(Str.slice(s, c + 1, Str.len(s)))

def trimName(s: String): String =
  trimName2(s, 0, Str.len(s))

def trimName2(s: String, a: Int, b: Int): String =
  if (a >= b) "" else if (Str.charAt(s, a) == 32) trimName2(s, a + 1, b) else if (Str.charAt(s, b - 1) == 32) trimName2(s, a, b - 1) else Str.slice(s, a, b)

def bindTuple2(ns: List[String], ts: List[String], env: List[(String, String)]): List[(String, String)] =
  if (List.isEmpty(ns)) env else (List.head(ns), if (List.isEmpty(ts)) "Int" else List.head(ts)) :: bindTuple2(List.tail(ns), if (List.isEmpty(ts)) ts else List.tail(ts), env)

def bindTy(pat: String, scrutTy: String, ens: List[En]): String =
  bindTy2(fieldTy(ens, patCore(pat)), scrutTy)

def bindTy2(ft: String, scrutTy: String): String =
  if (ft == "Int" || ft == "Bool" || ft == "String" || ft == "Float") ft else elemOf(scrutTy)

def fieldTy(ens: List[En], core: String): String =
  fieldTy2(dotAt(core, 0), core, ens)

def dotAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 46) i else dotAt(s, i + 1)

def fieldTy2(dot: Int, core: String, ens: List[En]): String =
  if (dot < 0) "" else caseFieldTy(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def caseFieldTy(ens: List[En], en: String, ctor: String): String =
  if (List.isEmpty(ens)) "" else caseFieldTy1(List.head(ens), List.tail(ens), en, ctor)

def caseFieldTy1(h: En, rest: List[En], en: String, ctor: String): String =
  h match {
    case En(_, name, _, cases) => if (name == en) caseFieldTy2(cases, ctor) else caseFieldTy(rest, en, ctor)
  }

def caseFieldTy2(cs: List[EnCase], ctor: String): String =
  if (List.isEmpty(cs)) "" else caseFieldTy3(List.head(cs), List.tail(cs), ctor)

def caseFieldTy3(h: EnCase, rest: List[EnCase], ctor: String): String =
  h match {
    case EnCase(name, fields) => if (name == ctor) firstFieldTy(fields) else caseFieldTy2(rest, ctor)
  }

def firstFieldTy(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else List.head(ps).ty

def hasComma(s: String): Bool =
  commaAt(s, 0) >= 0

def recFieldTys(ens: List[En], core: String): List[String] =
  recFieldTys2(dotAt(core, 0), core, ens)

def recFieldTys2(dot: Int, core: String, ens: List[En]): List[String] =
  if (dot < 0) enFieldTys(ens, core) else caseFieldTys(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def enFieldTys(ens: List[En], name: String): List[String] =
  if (List.isEmpty(ens)) noStr() else enFieldTys1(List.head(ens), List.tail(ens), name)

def enFieldTys1(h: En, rest: List[En], name: String): List[String] =
  h match {
    case En(_, n, _, cases) => if (n == name) firstCaseTys(cases) else enFieldTys(rest, name)
  }

def firstCaseTys(cs: List[EnCase]): List[String] =
  if (List.isEmpty(cs)) noStr() else paramTys(List.head(cs).fields)

def caseFieldTys(ens: List[En], en: String, ctor: String): List[String] =
  if (List.isEmpty(ens)) noStr() else caseFieldTys1(List.head(ens), List.tail(ens), en, ctor)

def caseFieldTys1(h: En, rest: List[En], en: String, ctor: String): List[String] =
  h match {
    case En(_, name, _, cases) => if (name == en) caseFieldTys2(cases, ctor) else caseFieldTys(rest, en, ctor)
  }

def caseFieldTys2(cs: List[EnCase], ctor: String): List[String] =
  if (List.isEmpty(cs)) noStr() else caseFieldTys3(List.head(cs), List.tail(cs), ctor)

def caseFieldTys3(h: EnCase, rest: List[EnCase], ctor: String): List[String] =
  h match {
    case EnCase(name, fields) => if (name == ctor) paramTys(fields) else caseFieldTys2(rest, ctor)
  }

def inferMethod(recv: Expr, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (name == "flatMap") inferFlatMap(recv, args, env, funs, ens, e) else inferMethod2(recv, name, args, env, funs, ens)

def inferMethod2(recv: Expr, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  recv match {
    case Expr.EVar(en) => inferMethodEn(en, name, args, env, funs, ens)
    case _ => inferCall(Str.concat(".", name), recv :: args, env, funs, ens)
  }

def inferMethodEn(en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasEn(ens, en)) inferCtor(en, args, env, funs, ens) else resolveQual(en, name, args, env, funs, ens)

def resolveQual(en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  resolveUser(Str.concat(en, Str.concat(".", name)), args, env, funs, ens, Parse.pretty0(Expr.EMethod(Expr.EVar(en), name, args)), findFunMod(funs, en, name))

def inferCtor(en: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(args)) ok(en) else inferCtorHead(en, List.head(args), List.tail(args), env, funs, ens)

def inferCtorHead(en: String, h: Expr, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferCtorFrom(en, infer(h, env, funs, ens), rest, env, funs, ens)

def inferCtorFrom(en: String, o: Out, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(o)) o else inferCtorRest(en, o, firstArgErr(rest, env, funs, ens), ens)

def inferCtorRest(en: String, o: Out, restErr: Out, ens: List[En]): Out =
  if (hasErr(restErr)) restErr else inferCtor2(en, o, ens)

def inferCtor2(en: String, o: Out, ens: List[En]): Out =
  if (hasErr(o)) o else if (enHasParams(ens, en)) ok(Str.concat(en, Str.concat("[", Str.concat(o.ty, "]")))) else ok(en)

def enHasParams(ens: List[En], name: String): Bool =
  if (List.isEmpty(ens)) false else enHasParams1(List.head(ens), List.tail(ens), name)

def enHasParams1(h: En, rest: List[En], name: String): Bool =
  h match {
    case En(_, n, tps, _) => if (n == name) List.len(tps) > 0 else enHasParams(rest, name)
  }

def isIo(t: String): Bool =
  Str.startsWith(t, "IO[")

def inferFlatMap(recv: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferFlatMap2(infer(recv, env, funs, ens), args, env, funs, ens, e)

def inferFlatMap2(o: Out, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (List.len(args) != 1) bad(Str.concat("flatMap expects 1 args, got ", Str.fromInt(List.len(args))), Parse.pretty0(e)) else inferFlatMapLam(o, List.head(args), env, funs, ens, e)

def inferFlatMapLam(recv: Out, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  lam match {
    case Expr.ELam(p, body) => inferFlatMap3(recv, infer(body, bindIo(p, recv.ty, env), funs, ens), e)
    case _ => inferFlatMap3(recv, infer(lam, env, funs, ens), e)
  }

def bindIo(p: String, ioTy: String, env: List[(String, String)]): List[(String, String)] =
  if (p == "_" || p == "") env else (p, ioPayload(ioTy)) :: env

def ioPayload(t: String): String =
  if (isIo(t) && Str.len(t) > 4) Str.slice(t, 3, Str.len(t) - 1) else "Any"

def inferFlatMap3(recv: Out, body: Out, e: Expr): Out =
  if (hasErr(body)) body else if (isIo(recv.ty) && isIo(body.ty)) ok(body.ty) else bad(Str.concat("flatMap needs IO, got ", Str.concat(recv.ty, Str.concat(" and ", body.ty))), Parse.pretty0(e))

def inferVar(s: String, env: List[(String, String)]): Out =
  inferVar2(s, getTy(env, s))

def inferVar2(s: String, t: String): Out =
  if (t == "") bad(Str.concat("unbound variable ", s), s) else ok(t)

def inferList(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(xs)) ok("List") else inferList2(infer(List.head(xs), env, funs, ens))

def inferList2(o: Out): Out =
  if (hasErr(o)) o else ok(Str.concat("List[", Str.concat(o.ty, "]")))

def inferTuple(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferTupleAcc(xs, env, funs, ens, "")

def inferTupleAcc(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  if (List.isEmpty(xs)) inferTupleDone(acc) else inferTupleHd(List.head(xs), xs, env, funs, ens, acc)

def inferTupleDone(acc: String): Out =
  if (acc == "") ok("Unit") else ok(Str.concat("(", Str.concat(acc, ")")))

def inferTupleHd(h: Expr, xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  inferTupleGot(infer(stripNamed(h), env, funs, ens), xs, env, funs, ens, acc)

def inferTupleGot(o: Out, xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else inferTupleRest(List.tail(xs), env, funs, ens, if (acc == "") ty else Str.concat(acc, Str.concat(", ", ty)))
  }

def inferTupleRest(rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  inferTupleAcc(rest, env, funs, ens, acc)

def checkDef(d: Fun, funs: List[Fun], ens: List[En]): Out =
  d match {
    case Fun(_, name, _, ps, ret, body, _) => checkDefGot(name, ret, body, infer(body, bindParams(ps, noEnv()), funs, ens))
  }

def checkDefGot(name: String, ret: String, body: Expr, o: Out): Out =
  if (hasErr(o)) o else if (tyEq(o.ty, ret)) o else bad(Str.concat("def ", Str.concat(name, Str.concat(" body ", Str.concat(o.ty, Str.concat(" does not match declared ", ret))))), Parse.pretty0(body))

def checkProg(p: Prog): Out =
  p match {
    case Prog(_, enums, _, _, _, _, defs, main, body) => checkDefsAt(defs, enums, main, body, 0, List.len(defs))
  }

def checkDefsAt(defs: List[Fun], enums: List[En], main: String, body: Expr, i: Int, n: Int): Out =
  if (i >= n) checkMain(main, body, defs, enums) else checkDefsGo(defs, enums, main, body, i, n)

def checkDefsGo(defs: List[Fun], enums: List[En], main: String, body: Expr, i: Int, n: Int): Out =
  checkDefsHit(List.at(defs, i), defs, enums, main, body, i, n)

def checkDefsHit(d: Fun, defs: List[Fun], enums: List[En], main: String, body: Expr, i: Int, n: Int): Out =
  checkDefsAfter(checkDef(d, defs, enums), defs, enums, main, body, i, n)

def checkDefsAfter(o: Out, defs: List[Fun], enums: List[En], main: String, body: Expr, i: Int, n: Int): Out =
  if (hasErr(o)) o else checkDefsAt(defs, enums, main, body, i + 1, n)

def checkMain(name: String, body: Expr, funs: List[Fun], ens: List[En]): Out =
  if (name == "") ok("IO[Unit]") else checkMainGot(infer(body, noEnv(), funs, ens))

def checkMainGot(o: Out): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else if (ty == "IO[Unit]") Out(ty, err, sp) else bad(Str.concat("@main body must be IO[Unit], got ", ty), if (Str.len(sp) > 0) sp else "1")
  }

def findIdx(src: String, needle: String, i: Int): Int =
  if (Str.len(needle) == 0 || i + Str.len(needle) > Str.len(src)) 0 - 1 else if (Str.slice(src, i, i + Str.len(needle)) == needle) i else findIdx(src, needle, i + 1)

def lineCol(src: String, i: Int, j: Int, line: Int, col: Int): (Int, Int) =
  if (j >= i) (line, col) else if (Str.charAt(src, j) == 10) lineCol(src, i, j + 1, line + 1, 1) else lineCol(src, i, j + 1, line, col + 1)

def locOf(src: String, needle: String): (Int, Int, Int, Int) =
  locOf2(src, needle, findIdx(src, needle, 0))

def locOf2(src: String, needle: String, i: Int): (Int, Int, Int, Int) =
  if (i < 0) (1, 1, 1, 1) else locOf3(lineCol(src, i, 0, 1, 1), needle)

def locOf3(p: (Int, Int), needle: String): (Int, Int, Int, Int) =
  p match {
    case (line, col) => locOf4(line, col, needle)
  }

def locOf4(line: Int, col: Int, needle: String): (Int, Int, Int, Int) =
  (line, col, line, if (Str.len(needle) > 0 && Str.charAt(needle, Str.len(needle) - 1) == 41) col + Str.len(needle) - 1 else col + Str.len(needle))

def jsonStr(s: String): String =
  Str.concat("\"", Str.concat(_esc(s, 0, Builder.empty()), "\""))

def _esc(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else _esc2(s, i, b, Str.charAt(s, i))

def _esc2(s: String, i: Int, b: Builder, c: Int): String =
  _esc(s, i + 1, Builder.append(b, if (c == 34) "\\\"" else if (c == 92) "\\\\" else if (c == 10) "\\n" else Str.slice(s, i, i + 1)))

def diagJson(src: String, o: Out): String =
  diagJson2(o, locOf(src, o.span))

def diagJson2(o: Out, loc: (Int, Int, Int, Int)): String =
  loc match {
    case (line, col, eline, ecol) => diagJson3(o, line, col, eline, ecol)
  }

def diagJson3(o: Out, line: Int, col: Int, eline: Int, ecol: Int): String =
  Str.concat("{\"severity\":\"error\",\"message\":", Str.concat(jsonStr(Str.concat("type error: ", o.err)), Str.concat(",\"file\":\"t/src/Main.scuzz\",\"line\":", Str.concat(Str.fromInt(line), Str.concat(",\"column\":", Str.concat(Str.fromInt(col), Str.concat(",\"end_line\":", Str.concat(Str.fromInt(eline), Str.concat(",\"end_column\":", Str.concat(Str.fromInt(ecol), "}"))))))))))

def check(src: String): String =
  check2(src, checkProg(Parse.parse(Lexer.lex(src))))

def checkFiles(files: List[(String, String)]): String =
  check2(filesSrc(files), checkProg(Parse.parseFiles(files)))

def filesSrc(files: List[(String, String)]): String =
  if (List.isEmpty(files)) "" else filesSrc2(List.head(files), List.tail(files))

def filesSrc2(f: (String, String), rest: List[(String, String)]): String =
  f match {
    case (_, src) => Str.concat(src, filesSrc(rest))
  }

def check2(src: String, o: Out): String =
  if (hasErr(o)) Str.concat("[", Str.concat(diagJson(src, o), "]")) else "[]"

def humanLine(src: String, o: Out): String =
  humanLine2(o, locOf(src, o.span))

def humanLine2(o: Out, loc: (Int, Int, Int, Int)): String =
  loc match {
    case (line, col, _, _) => humanLine3(o, line, col)
  }

def humanLine3(o: Out, line: Int, col: Int): String =
  Str.concat("t/src/Main.scuzz:", Str.concat(Str.fromInt(line), Str.concat(":", Str.concat(Str.fromInt(col), Str.concat(": error: type error: ", o.err)))))

def human(src: String): String =
  human2(src, checkProg(Parse.parse(Lexer.lex(src))))

def human2(src: String, o: Out): String =
  if (hasErr(o)) humanLine(src, o) else "scuzz check ok"

