  if (f == "Str.fromInt") "Int" :: noStr() else if (f == "Str.concat") "String" :: "String" :: noStr() else if (f == "Str.len") "String" :: noStr() else if (f == "Str.fromBool") "Bool" :: noStr() else if (f == "Str.charAt") "String" :: "Int" :: noStr() else if (f == "Str.slice") "String" :: "Int" :: "Int" :: noStr() else if (f == "Str.toInt") "String" :: "Int" :: noStr() else if (f == "Str.repeat") "String" :: "Int" :: noStr() else if (f == "Str.startsWith" || f == "Str.endsWith" || f == "Str.contains" || f == "Str.eq" || f == "Str.indexOf" || f == "Str.lastIndexOf") "String" :: "String" :: noStr() else if (f == "Str.isEmpty" || f == "Str.nonEmpty" || f == "Str.isBlank" || f == "Str.lines" || f == "Str.trim" || f == "Str.byteLen") "String" :: noStr() else if (f == "Str.take" || f == "Str.drop" || f == "Str.takeRight" || f == "Str.dropRight") "String" :: "Int" :: noStr() else if (f == "Str.byteSlice") "String" :: "Int" :: "Int" :: noStr() else if (f == "Str.stripPrefix" || f == "Str.stripSuffix" || f == "Str.split" || f == "Fs.join") "String" :: "String" :: noStr() else if (f == "Fs.dirname" || f == "Fs.basename") "String" :: noStr() else if (f == "List.len" || f == "List.reverse" || f == "List.head" || f == "List.tail" || f == "List.isEmpty" || f == "List.init" || f == "List.last" || f == "List.flatten") "List" :: noStr() else if (f == "List.concat") "List" :: "List" :: noStr() else if (f == "List.join") "List[String]" :: "String" :: noStr() else if (f == "List.cons") "Any" :: "List" :: noStr() else if (f == "List.at" || f == "List.take" || f == "List.drop" || f == "List.takeRight" || f == "List.dropRight") "List" :: "Int" :: noStr() else if (f == "Builder.empty" || f == "Clock.monotonic" || f == "Clock.realTime" || f == "Map.empty" || f == "Set.empty" || f == "Impurity.runKit" || f == "Sys.readLine") noStr() else if (f == "Sys.read" || f == "Sys.alive" || f == "Sys.kill" || f == "Sys.childClose" || f == "Random.nextInt") "Int" :: noStr() else if (f == "Sys.spawn") "String" :: noStr() else if (f == "Builder.append") "Builder" :: "String" :: noStr() else if (f == "Builder.result") "Builder" :: noStr() else if (f == "Fs.read" || f == "Fs.list" || f == "Fs.mkdirs" || f == "Fs.exists" || f == "Fs.delete" || f == "Fs.walk" || f == "Fs.canonicalize" || f == "Sys.getenv" || f == "Sys.write" || isSysProc(f)) "String" :: noStr() else if (f == "Fs.write" || f == "Fs.rename") "String" :: "String" :: noStr() else if (f == "IO.pure") "Any" :: noStr() else kitParams2(f)

