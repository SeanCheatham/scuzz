def kitNames(): List[String] =
  List.concat(kitNamesA(), List.concat(kitNamesB(), List.concat(kitNamesC(), List.concat(kitNamesD(), List.concat(kitNamesE(), List.concat(kitNamesF(), kitNamesG()))))))

def kitNamesA(): List[String] =
  "Str.fromInt" :: "Str.concat" :: "Str.len" :: "Str.byteLen" :: "Str.byteSlice" :: "Str.fromBool" :: "Str.charAt" :: "Str.slice" :: "Str.toInt" :: "Str.repeat" :: "List.len" :: "List.concat" :: "List.reverse" :: "List.head" :: "List.tail" :: "List.isEmpty" :: "List.cons" :: "List.at" :: "List.join" :: "List.take" :: "List.drop" :: "List.takeRight" :: "List.dropRight" :: "List.init" :: "List.last" :: "List.flatten" :: noStr()

def kitNamesB(): List[String] =
  "Builder.empty" :: "Builder.append" :: "Builder.result" :: "Fs.read" :: "Fs.write" :: "Fs.list" :: "Fs.mkdirs" :: "Sys.args" :: "Sys.getenv" :: "Sys.write" :: "Sys.read" :: "Sys.readLine" :: "Sys.spawn" :: "Sys.alive" :: "Sys.kill" :: "Impurity.runKit" :: "IO.pure" :: "IO.println" :: "Clock.monotonic" :: "Clock.realTime" :: "Map.empty" :: "Map.set" :: "Map.keys" :: "Map.values" :: "Map.size" :: "Map.contains" :: "Map.getOrElse" :: "Map.remove" :: "Map.toList" :: noStr()

def kitNamesC(): List[String] =
  "Set.empty" :: "Set.add" :: "Set.toList" :: "Set.size" :: "Set.contains" :: "Set.remove" :: "Set.union" :: "Set.intersect" :: "Set.diff" :: "Json.keys" :: "Json.get" :: "Json.has" :: "Json.parse" :: "Json.getStr" :: "Json.getBool" :: "Json.getInt" :: "Json.intOr" :: "Json.arr" :: "Json.at" :: "Json.isNull" :: "Json.isObj" :: "Json.isArr" :: "Json.pairs" :: "Json.set" :: "Json.remove" :: "Json.append" :: "Json.prepend" :: "Json.setAt" :: "Json.dropAt" :: "Json.merge" :: "Json.Int" :: "Json.Null" :: "Json.asInt" :: "Json.asBool" :: "Json.asStr" :: "Json.asFloat" :: "Json.Float" :: "Json.floatOr" :: "Json.Obj" :: "Json.Str" :: "Json.Bool" :: "Json.Arr" :: noStr()

def kitNamesD(): List[String] =
  "Str.startsWith" :: "Str.endsWith" :: "Str.contains" :: "Str.eq" :: "Str.isEmpty" :: "Str.nonEmpty" :: "Str.isBlank" :: "Str.lines" :: "Str.trim" :: "Str.indexOf" :: "Str.lastIndexOf" :: "Str.take" :: "Str.drop" :: "Str.takeRight" :: "Str.dropRight" :: "Str.stripPrefix" :: "Str.stripSuffix" :: "Str.split" :: "Fs.join" :: "Fs.dirname" :: "Fs.basename" :: noStr()

def kitNamesE(): List[String] =
  "Fs.exists" :: "Fs.delete" :: "Fs.walk" :: "Fs.canonicalize" :: "Fs.rename" :: "Random.nextInt" :: "Sys.childWrite" :: "Sys.childRead" :: "Sys.childClose" :: noStr()

def kitNamesF(): List[String] =
  "Net.httpGet" :: "Net.httpPost" :: "Net.httpPut" :: "Net.httpPatch" :: "Net.httpDelete" :: "Net.httpHead" :: "Net.serve" :: "Net.serveOnce" :: "Net.tcpConnect" :: "Net.tcpListen" :: "Net.tcpAccept" :: "Net.tcpRead" :: "Net.tcpWrite" :: "Net.tcpClose" :: "Net.udpBind" :: "Net.udpSend" :: "Net.udpRecv" :: "Net.udpClose" :: noStr()

def kitNamesG(): List[String] =
  "Timeline.signalInt" :: "Timeline.signalListLen" :: "Timeline.signalStrHas" :: "Property.signalInt" :: "Property.signalStr" :: "Property.signalListLen" :: "Property.signalListAt" :: "Verdict.alwaysHas" :: "Verdict.afterHit" :: noStr()

def kitRet(f: String): String =
  if (f == "Timeline.signalInt" || f == "Timeline.signalListLen" || f == "Property.signalInt" || f == "Property.signalListLen") "Int" else if (f == "Timeline.signalStrHas") "Bool" else if (f == "Property.signalStr" || f == "Property.signalListAt" || f == "List.join") "String" else if (f == "Verdict.alwaysHas" || f == "Verdict.afterHit") "Verdict" else if (f == "Str.len" || f == "Str.byteLen" || f == "List.len" || f == "Str.charAt" || f == "Str.toInt" || f == "Str.indexOf" || f == "Str.lastIndexOf" || f == "Map.size" || f == "Set.size" || f == "Json.getInt" || f == "Json.intOr") "Int" else if (f == "List.head") "Option" else if (f == "List.at" || f == "Map.getOrElse") "Any" else if (f == "List.isEmpty" || f == "Map.contains" || f == "Set.contains" || f == "Json.has" || f == "Json.getBool" || f == "Json.isNull" || f == "Json.isObj" || f == "Json.isArr" || f == "Str.startsWith" || f == "Str.endsWith" || f == "Str.contains" || f == "Str.eq" || f == "Str.isEmpty" || f == "Str.nonEmpty" || f == "Str.isBlank") "Bool" else if (f == "List.concat" || f == "List.reverse" || f == "List.tail" || f == "List.cons" || f == "List.take" || f == "List.drop" || f == "List.takeRight" || f == "List.dropRight" || f == "List.init" || f == "List.last" || f == "List.flatten" || f == "Str.lines" || f == "Str.split") "List" else if (f == "Json.floatOr" || f == "Json.Float" || f == "Json.asFloat") "Float" else if (f == "Map.keys" || f == "Map.values" || f == "Map.toList" || f == "Set.toList" || f == "Json.keys" || f == "Json.arr" || f == "Json.at" || f == "Json.pairs" || f == "Json.asInt" || f == "Json.asBool" || f == "Json.asStr" || f == "Json.asFloat") "List" else if (f == "Builder.empty" || f == "Builder.append") "Builder" else if (f == "Fs.read" || f == "Sys.getenv" || f == "Sys.read" || f == "Sys.readLine" || f == "Fs.canonicalize" || f == "Sys.childRead" || isNetHttp(f) || f == "Net.tcpRead") "IO[String]" else if (f == "Fs.write" || f == "Fs.mkdirs" || f == "Fs.delete" || f == "Fs.rename" || f == "Impurity.runKit" || f == "Sys.write" || f == "Sys.kill" || f == "Sys.childWrite" || f == "Sys.childClose" || f == "IO.println" || isNetServe(f) || f == "Net.tcpWrite" || f == "Net.tcpClose" || f == "Net.udpSend" || f == "Net.udpClose") "IO[Unit]" else if (f == "Fs.list" || f == "Fs.walk") "IO[List[(String, Bool)]]" else if (f == "Sys.args") "IO[List[String]]" else if (f == "Sys.spawn" || f == "Sys.alive" || f == "Fs.exists" || f == "Random.nextInt") "IO[Int]" else if (isSysProc(f)) "IO[(Int, String, String)]" else if (f == "Net.udpRecv") "IO[(String, Int, String)]" else if (f == "Net.tcpConnect" || f == "Net.tcpListen" || f == "Net.tcpAccept" || f == "Net.udpBind") "IO[Any]" else if (f == "IO.pure") "IO[Any]" else if (f == "Clock.monotonic" || f == "Clock.realTime") "IO[Int]" else if (f == "Map.empty" || f == "Map.set" || f == "Map.remove") "Map" else if (f == "Set.empty" || f == "Set.add" || f == "Set.remove" || f == "Set.union" || f == "Set.intersect" || f == "Set.diff") "Set" else if (f == "Json.parse" || f == "Json.get" || f == "Json.set" || f == "Json.remove" || f == "Json.append" || f == "Json.prepend" || f == "Json.setAt" || f == "Json.dropAt" || f == "Json.merge" || f == "Json.Int" || f == "Json.Null" || f == "Json.Float" || f == "Json.Obj" || f == "Json.Str" || f == "Json.Bool" || f == "Json.Arr") "Any" else "Any"

def isArith(op: String): Bool =
  op == "+" || op == "-" || op == "*" || op == "/" || op == "%"

def isEq(op: String): Bool =
  op == "==" || op == "!="

def isOrd(op: String): Bool =
  op == "<" || op == "<=" || op == ">" || op == ">="

def isLogic(op: String): Bool =
  op == "&&" || op == "||"

def isBit(op: String): Bool =
  op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>"

def firstArgErr(args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(args)) ok("") else firstArgErr2(infer(stripNamed(List.at(args, 0)), env, funs, ens), List.tail(args), env, funs, ens)

def firstArgErr2(o: Out, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(o)) o else firstArgErr(rest, env, funs, ens)

def zipCheck(callee: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), acc: String): Out =
  if (List.isEmpty(want)) ok(acc) else zipCheckHd(callee, List.at(want, 0), List.tail(want), args, env, funs, ens, span, acc)

def zipCheckHd(callee: String, w: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), acc: String): Out =
  zipCheckArg(callee, w, want, List.at(args, 0), List.tail(args), env, funs, ens, span, acc)

def zipCheckArg(callee: String, w: String, want: List[String], arg: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), acc: String): Out =
  if (List.isEmpty(args)) zipCheckLast(infer(stripNamed(arg), env, funs, ens), callee, w, span, acc) else zipCheck2(callee, w, infer(stripNamed(arg), env, funs, ens), want, args, env, funs, ens, span, acc)

def zipCheckLast(o: Out, callee: String, w: String, span: (String, Int), acc: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else if (tyEq(ty, w) || w == "Any") ok(if (acc == "") ty else acc) else argMismatch(callee, w, ty, span)
  }

def zipCheck2(callee: String, w: String, o: Out, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), acc: String): Out =
  o match {
    case Out(ty, err, sp) => zipCheckErr(callee, w, ty, err, sp, want, args, env, funs, ens, span, acc)
  }

def zipCheckErr(callee: String, w: String, ty: String, err: String, sp: (String, Int), want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), acc: String): Out =
  if (Str.len(err) > 0) Out(ty, err, sp) else zipCheckEq(callee, w, ty, want, args, env, funs, ens, span, acc)

def zipCheckEq(callee: String, w: String, got: String, want: List[String], args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), acc: String): Out =
  if (tyEq(got, w) || w == "Any") zipCheck(callee, want, args, env, funs, ens, span, if (acc == "") got else acc) else argMismatch(callee, w, got, span)

def argMismatch(callee: String, w: String, got: String, span: (String, Int)): Out =
  bad(argMismatchMsg(argMismatchWant(callee, w), got), span)

def argMismatchWant(callee: String, w: String): String =
  if (callee == "IO.println") "expected String, got " else Str.concat(callee, Str.concat(" arg type mismatch: expected ", Str.concat(w, ", got ")))

def argMismatchMsg(prefix: String, got: String): String =
  Str.concat(prefix, got)

def listMatch(w: String, g: String): Bool =
  w == "List" && isListTy(g) || g == "List" && isListTy(w)

def isListTy(t: String): Bool =
  t == "List" || Str.startsWith(t, "List[")

def tyEq(a: String, b: String): Bool =
  a == b || a == "Any" || b == "Any" || isTyParam(a) || isTyParam(b) || listMatch(a, b) || appMatch(a, b) || tupEq(a, b) || funEq(a, b) || ioEq(a, b) || appInnerEq(a, b) && !isIo(a) && !isIo(b)

def isTyParam(t: String): Bool =
  Str.len(t) == 1 && Str.charAt(t, 0) >= 65 && Str.charAt(t, 0) <= 90

def appInnerEq(a: String, b: String): Bool =
  appInnerEq2(brackAt(a, 0), brackAt(b, 0), a, b)

def appInnerEq2(ba: Int, bb: Int, a: String, b: String): Bool =
  ba >= 0 && bb >= 0 && Str.slice(a, 0, ba) == Str.slice(b, 0, bb) && argsFit(splitComma(elemOf(a)), splitComma(elemOf(b)))

def argsFit(xs: List[String], ys: List[String]): Bool =
  partsEq(xs, ys) || argsPrefix(xs, ys) || argsPrefix(ys, xs) || argsTail(xs, ys) || argsTail(ys, xs)

def argsTail(xs: List[String], ys: List[String]): Bool =
  if (List.isEmpty(xs)) true else if (List.isEmpty(ys)) false else if (partsEq(xs, ys)) true else argsTail(xs, List.tail(ys))

def argsPrefix(xs: List[String], ys: List[String]): Bool =
  if (List.isEmpty(xs)) true else if (List.isEmpty(ys)) false else tyEq(List.at(xs, 0), List.at(ys, 0)) && argsPrefix(List.tail(xs), List.tail(ys))

def funEq(a: String, b: String): Bool =
  isFunTy(a) && isFunTy(b) && tyEq(funArgOf(a), funArgOf(b)) && tyEq(funRetOf(a), funRetOf(b))

def funArgOf(t: String): String =
  funArgOfAt(t, 0)

def funArgOfAt(t: String, i: Int): String =
  if (i + 4 > Str.len(t)) t else if (sliceEq(t, i, " => ")) Str.slice(t, 0, i) else funArgOfAt(t, i + 1)

def appMatch(w: String, g: String): Bool =
  isAppOf(w, g) || isAppOf(g, w)

def isAppOf(bare: String, app: String): Bool =
  Str.len(app) > Str.len(bare) && Str.slice(app, 0, Str.len(bare)) == bare && Str.charAt(app, Str.len(bare)) == 91

def isTup(t: String): Bool =
  Str.len(t) > 0 && Str.charAt(t, 0) == 40

def tupEq(a: String, b: String): Bool =
  isTup(a) && isTup(b) && partsEq(splitComma(tupleInner(a)), splitComma(tupleInner(b)))

def partsEq(xs: List[String], ys: List[String]): Bool =
  if (List.isEmpty(xs)) List.isEmpty(ys) else if (List.isEmpty(ys)) false else tyEq(List.at(xs, 0), List.at(ys, 0)) && partsEq(List.tail(xs), List.tail(ys))

def prefer(a: String, b: String): String =
  if (a == b) a else if (a == "Any") b else if (b == "Any") a else if (isIo(a) && isIo(b)) ioTy(prefer(ioErr(a), ioErr(b)), prefer(ioOk(a), ioOk(b))) else if (isAppOf(a, b)) b else if (isAppOf(b, a)) a else if (a == "List") b else if (b == "List") a else if (isTup(a) && isTup(b)) preferTup(a, b) else a

def preferTup(a: String, b: String): String =
  Str.concat("(", Str.concat(preferParts(splitComma(tupleInner(a)), splitComma(tupleInner(b))), ")"))

def preferParts(xs: List[String], ys: List[String]): String =
  if (List.isEmpty(xs) || List.isEmpty(ys)) "" else if (List.len(xs) == 1 || List.len(ys) == 1) prefer(List.at(xs, 0), List.at(ys, 0)) else Str.concat(prefer(List.at(xs, 0), List.at(ys, 0)), Str.concat(", ", preferParts(List.tail(xs), List.tail(ys))))

def checkKnown(f: String, want: List[String], ret: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.len(want) != List.len(args)) bad(Str.concat(f, Str.concat(" expects ", Str.concat(Str.fromInt(List.len(want)), Str.concat(" args, got ", Str.fromInt(List.len(args)))))), span) else checkKnownRet(f, zipCheck(f, want, args, env, funs, ens, span, ""), ret)

def checkKnownRet(f: String, o: Out, ret: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else ok(kitRetFromTy(f, ty, ret))
  }

def kitRetFromTy(f: String, ty: String, ret: String): String =
  if (f == "List.head") kitRetOption(ty) else if (f == "List.at") elemOf(ty) else if (f == "List.tail" || f == "List.reverse" || f == "List.concat" || f == "List.last" || f == "List.find" || f == "List.findLast") kitRetList(ty, ret) else if (f == "List.cons") kitRetCons(ty, ret) else if (f == "IO.pure") ioTy("Any", ty) else if (f == "IO.fail") ioTy(ty, "Any") else ret

def kitRetOption(ty: String): String =
  Str.concat("Option[", Str.concat(elemOf(ty), "]"))

def kitRetList(ty: String, ret: String): String =
  if (isListTy(ty)) ty else ret

def kitRetCons(ty: String, ret: String): String =
  if (ty == "") ret else Str.concat("List[", Str.concat(ty, "]"))

def resolveCall(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  resolveCall2(f, args, env, funs, ens, span)

def resolveCall2(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (isKit(f) || isOpenKit(f)) resolveKit(f, args, env, funs, ens, span) else if (hasEn(ens, f)) inferCtor(f, args, env, funs, ens) else if (enOfCase(ens, f) != "") inferCtor(enOfCase(ens, f), args, env, funs, ens) else resolveFunOrUser(f, args, env, funs, ens, span, lookupEnv(env, f))

def resolveKit(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(args) && isKit(f) && !List.isEmpty(kitParams(f))) ok(funTyFrom(kitParams(f), kitRet(f))) else if (isKit(f)) checkKnown(f, kitParams(f), kitRet(f), args, env, funs, ens, span) else checkKnown(f, anyParams(List.len(args)), openKitRet(f), args, env, funs, ens, span)

def enOfCase(ens: List[En], ctor: String): String =
  if (List.isEmpty(ens)) "" else enOfCase1(List.at(ens, 0), List.tail(ens), ctor)

def enOfCase1(h: En, rest: List[En], ctor: String): String =
  h match {
    case En(_, name, _, cases) => if (hasCase(cases, ctor)) name else enOfCase(rest, ctor)
  }

def hasCase(cs: List[EnCase], ctor: String): Bool =
  if (List.isEmpty(cs)) false else hasCase1(List.at(cs, 0), List.tail(cs), ctor)

def hasCase1(c: EnCase, rest: List[EnCase], ctor: String): Bool =
  c match {
    case EnCase(name, _) => name == ctor || hasCase(rest, ctor)
  }

def isOpenKit(f: String): Bool =
  Str.startsWith(f, "List.") || Str.startsWith(f, "Map.") || Str.startsWith(f, "Set.") || Str.startsWith(f, "Str.") || Str.startsWith(f, "IO.") || Str.startsWith(f, "Json.") || Str.startsWith(f, "Float.") || Str.startsWith(f, "Signal.") || Str.startsWith(f, "Property.") || Str.startsWith(f, "View.") || Str.startsWith(f, "Ui.") || Str.startsWith(f, "Fiber.") || Str.startsWith(f, "Timeline.") || Str.startsWith(f, "Verdict.") || Str.startsWith(f, "Color.") || Str.startsWith(f, "Theme.") || Str.startsWith(f, "Ref.") || Str.startsWith(f, "Queue.") || Str.startsWith(f, "Deferred.") || Str.startsWith(f, "Stream.") || Str.startsWith(f, "Resource.") || Str.startsWith(f, "Builder.") || Str.startsWith(f, "Oracle.") || Str.startsWith(f, ".")

def anyParams(n: Int): List[String] =
  if (n <= 0) noStr() else "Any" :: anyParams(n - 1)

def openKitRet(f: String): String =
  if (openKitBool(f)) "Bool" else if (openKitInt(f) || Str.startsWith(f, "Color.") || Str.startsWith(f, "Theme.")) "Int" else if (f == "Property.sometimes") "Unit" else if (openKitAny(f) || Str.startsWith(f, "Signal.") || Str.startsWith(f, "View.") || Str.startsWith(f, "Property.") || Str.startsWith(f, "Json.")) "Any" else if (Str.startsWith(f, "Map.")) "Map" else if (Str.startsWith(f, "Set.")) "Set" else if (Str.startsWith(f, "Stream.")) streamKitRet(f) else if (Str.startsWith(f, "IO.") || Str.startsWith(f, "Ui.") || Str.startsWith(f, "Fiber.") || Str.startsWith(f, "Ref.") || Str.startsWith(f, "Queue.") || Str.startsWith(f, "Deferred.") || Str.startsWith(f, "Resource.")) "IO[Any]" else if (Str.startsWith(f, "Str.")) "String" else if (Str.startsWith(f, "Float.")) "Float" else if (Str.startsWith(f, "Builder.") || Str.startsWith(f, "Oracle.") || Str.startsWith(f, ".")) "Any" else "Any"

def streamKitRet(f: String): String =
  if (f == "Stream.exists" || f == "Stream.forall" || f == "Stream.none") "IO[Bool]" else if (f == "Stream.count") "IO[Int]" else if (f == "Stream.compileToList" || f == "Stream.drain" || f == "Stream.head" || f == "Stream.last" || f == "Stream.fold") "IO[Any]" else "Stream"

def openKitBool(f: String): Bool =
  f == "List.exists" || f == "List.forall" || f == "List.contains" || f == "List.nonEmpty" || f == "List.isEmpty"

def openKitInt(f: String): Bool =
  f == "List.count" || f == "List.indexWhere" || f == "List.lastIndexWhere" || f == "List.indexOf" || f == "List.lastIndexOf" || f == "Float.toInt"

def openKitAny(f: String): Bool =
  f == "List.foldLeft" || f == "List.foldRight" || f == "List.reduceLeft" || f == "List.reduceRight" || f == "List.getOrElse" || f == "List.at"

def resolveFunOrUser(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), ty: String): Out =
  if (isFunTy(ty)) inferFunApply(ty, args, env, funs, ens, span) else resolveUser(f, args, env, funs, ens, span, findFunPrefer(funs, f, env))

def inferFunApply(ty: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  inferFunApplyRet(funRetOf(ty), args, env, funs, ens, span)

def inferFunApplyRet(ret: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.len(args) == 1) inferFunApply1(ret, infer(List.at(args, 0), env, funs, ens), span) else if (List.isEmpty(args)) bad("apply expects 1 arg", span) else inferFunApply1(ret, firstArgErr(args, env, funs, ens), span)

def inferFunApply1(ret: String, o: Out, _span: (String, Int)): Out =
  if (hasErr(o)) o else ok(ret)

def elemOf(t: String): String =
  elemOf2(brackAt(t, 0), t)

def brackAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 91) i else brackAt(s, i + 1)

def elemOf2(b: Int, t: String): String =
  if (b < 0) "Any" else Str.slice(t, b + 1, Str.len(t) - 1)

def resolveUser(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), hit: List[Fun]): Out =
  if (List.isEmpty(hit)) bad(Str.concat("unknown function ", f), span) else resolveUserHit(f, args, env, funs, ens, span, List.at(hit, 0))

def resolveUserHit(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), d: Fun): Out =
  d match {
    case Fun(_, _, _, ps, ret, _, _, _) => checkUser(f, ps, ret, args, env, funs, ens, span)
  }

def checkUser(f: String, ps: List[Param], ret: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  checkUserAl(f, ps, ret, args, env, funs, ens, span, alignCall(ps, args))

def checkUserAl(f: String, ps: List[Param], ret: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int), al: (List[Expr], String)): Out =
  al match {
    case (xs, err) => if (err != "") bad(alignErr(f, err, ps, args), span) else checkKnown(f, paramTys(ps), ret, xs, env, funs, ens, span)
  }

def inferCall(f: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  resolveCall(f, args, env, funs, ens, span)

def inferPrint(inner: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferPrint2(infer(inner, env, funs, ens), env, e)

def inferPrint2(o: Out, env: List[(String, String)], e: Expr): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) o else if (ty == "String" || ty == "Any") ok("IO[Unit]") else bad(Str.concat("expected String, got ", ty), exprSpan(env, e))
  }

def inferBin(op: String, l: Expr, r: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferBin2(op, infer(l, env, funs, ens), r, env, funs, ens, e)

def inferBin2(op: String, lo: Out, r: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(lo)) lo else inferBin3(op, lo, infer(r, env, funs, ens), env, e)

def inferBin3(op: String, lo: Out, ro: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(ro)) ro else inferBin4(op, lo.ty, ro.ty, exprSpan(env, e))

def inferBin4(op: String, lt: String, rt: String, span: (String, Int)): Out =
  if (isArith(op)) inferArith(lt, rt, span) else if (isEq(op)) inferEq(lt, rt, span) else if (isOrd(op)) inferOrd(lt, rt, span) else if (isLogic(op)) inferLogic(lt, rt, span) else if (isBit(op)) inferBit(lt, rt, span) else if (op == "::") ok(Str.concat("List[", Str.concat(lt, "]"))) else ok(lt)

def inferArith(lt: String, rt: String, span: (String, Int)): Out =
  if (numTy(lt) && numTy(rt)) ok(if (lt == "Float" || rt == "Float") "Float" else "Int") else bad(Str.concat("arithmetic needs Int or Float, got ", Str.concat(lt, Str.concat(" and ", rt))), span)

def numTy(t: String): Bool =
  t == "Int" || t == "Float" || t == "Any"

def inferEq(lt: String, rt: String, span: (String, Int)): Out =
  if (tyEq(lt, rt)) ok("Bool") else bad(Str.concat("comparison type mismatch ", Str.concat(lt, Str.concat(" vs ", rt))), span)

def inferOrd(lt: String, rt: String, span: (String, Int)): Out =
  if (numTy(lt) && numTy(rt)) ok("Bool") else bad("ordered compare needs Int or Float", span)

def inferLogic(lt: String, rt: String, span: (String, Int)): Out =
  if (logicTy(lt) && logicTy(rt)) ok("Bool") else bad(Str.concat("logic needs Bool, got ", Str.concat(lt, Str.concat(" and ", rt))), span)

def logicTy(t: String): Bool =
  t == "Bool" || t == "Any"

def inferBit(lt: String, rt: String, span: (String, Int)): Out =
  if (lt == "Int" && rt == "Int") ok("Int") else bad(Str.concat("bitwise needs Int, got ", Str.concat(lt, Str.concat(" and ", rt))), span)

def inferUn(op: String, inner: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferUn2(op, infer(inner, env, funs, ens), env, e)

def inferUn2(op: String, o: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(o)) o else if (op == "!") inferUnBool(o, env, e) else inferUnInt(o, env, e)

def inferUnBool(o: Out, env: List[(String, String)], e: Expr): Out =
  if (o.ty == "Bool" || o.ty == "Any") ok("Bool") else bad(Str.concat("expected Bool, got ", o.ty), exprSpan(env, e))

def inferUnInt(o: Out, env: List[(String, String)], e: Expr): Out =
  if (o.ty == "Int" || o.ty == "Any") ok("Int") else bad(Str.concat("expected Int, got ", o.ty), exprSpan(env, e))

def inferIf(c: Expr, t: Expr, el: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferIf2(infer(c, env, funs, ens), t, el, env, funs, ens, e)

def inferIf2(co: Out, t: Expr, el: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(co)) co else inferIf3(infer(t, env, funs, ens), el, env, funs, ens, e)

def inferIf3(to: Out, el: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(to)) to else inferIf4(to, infer(el, env, funs, ens), env, e)

def inferIf4(to: Out, eo: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(eo)) eo else if (tyEq(to.ty, eo.ty)) ok(prefer(to.ty, eo.ty)) else if (ifIoUnit(to.ty, eo.ty)) ok(ifIoPick(to.ty, eo.ty)) else bad(Str.concat("type mismatch: expected ", Str.concat(to.ty, Str.concat(", got ", eo.ty))), exprSpan(env, e))

def ifIoUnit(a: String, b: String): Bool =
  isIo(a) && b == "Unit" || isIo(b) && a == "Unit"

def ifIoPick(a: String, b: String): String =
  if (isIo(a)) a else b

def infer(e: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  e match {
    case Expr.EInt(_, _) => ok("Int")
    case Expr.EBool(_) => ok("Bool")
    case Expr.EStr(_, _) => ok("String")
    case Expr.EFloat(_) => ok("Float")
    case Expr.EInterp(_) => ok("String")
    case Expr.EUnit => ok("Unit")
    case Expr.EHole => ok("Int")
    case Expr.EVar(s, off) => inferVar(s, env, funs, ens, (modFile(env), off))
    case Expr.EPrint(inner, _) => inferPrint(inner, env, funs, ens, e)
    case Expr.ECall(f, args, off) => inferCall(f, args, env, funs, ens, (modFile(env), off))
    case Expr.EBin(op, l, r, _) => inferBin(op, l, r, env, funs, ens, e)
    case Expr.EUn(op, inner, _) => inferUn(op, inner, env, funs, ens, e)
    case Expr.EIf(c, t, el, _) => inferIf(c, t, el, env, funs, ens, e)
    case Expr.ENamed(_, inner) => infer(inner, env, funs, ens)
    case Expr.EList(xs) => inferList(xs, env, funs, ens)
    case Expr.ETuple(xs) => inferTuple(xs, env, funs, ens)
    case Expr.EMethod(recv, name, args, _) => inferMethod(recv, name, args, env, funs, ens, e)
    case Expr.EField(recv, name, _) => inferField(recv, name, env, funs, ens)
    case Expr.ELam(p, body) => inferLam(infer(body, bindLam(p, env), funs, ens))
    case Expr.EMatch(s, arms, _) => inferMatch(s, arms, env, funs, ens)
    case Expr.EFor(bs, body, _) => inferFor(bs, body, env, funs, ens)
  }

def inferLam(o: Out): Out =
  if (hasErr(o)) o else ok(Str.concat("Any => ", o.ty))

def inferFor(bs: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferForGo(bs, body, env, funs, ens, "")

def inferForGo(bs: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], errTy: String): Out =
  if (List.isEmpty(bs)) inferFor2(infer(body, env, funs, ens), errTy) else inferForBind(List.at(bs, 0), List.tail(bs), body, env, funs, ens, errTy)

def inferForBind(b: Bind, rest: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], errTy: String): Out =
  b match {
    case Bind(d, name, v) => inferForBind2(d, name, infer(v, env, funs, ens), rest, body, env, funs, ens, errTy, exprSpan(env, v))
  }

def inferForBind2(d: Bool, name: String, vo: Out, rest: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], errTy: String, span: (String, Int)): Out =
  if (hasErr(vo)) vo else if (d) inferForDraw(name, vo.ty, rest, body, env, funs, ens, errTy, span) else inferForGo(rest, body, bindFor(false, name, vo.ty, env, ens), funs, ens, errTy)

def inferForDraw(name: String, ty: String, rest: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], errTy: String, span: (String, Int)): Out =
  if (Str.startsWith(ty, "Stream")) bad(Str.concat("<- needs IO, got ", ty), span) else inferForDraw2(name, ty, rest, body, env, funs, ens, unifyErr(errTy, ioErr(ty), span))

def inferForDraw2(name: String, ty: String, rest: List[Bind], body: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], u: Out): Out =
  if (hasErr(u)) u else inferForGo(rest, body, bindFor(true, name, ty, env, ens), funs, ens, u.ty)

def bindFor(d: Bool, name: String, ty: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  if (name == "_" || name == "") env else bindPat(name, if (d) ioPayload(ty) else ty, env, ens)

def inferFor2(o: Out, errTy: String): Out =
  if (hasErr(o)) o else ok(ioTy(errTy, o.ty))

def forHasDraw(bs: List[Bind]): Bool =
  if (List.isEmpty(bs)) false else forHasDraw1(List.at(bs, 0), List.tail(bs))

def forHasDraw1(b: Bind, rest: List[Bind]): Bool =
  b match {
    case Bind(d, _, _) => d || forHasDraw(rest)
  }

def hasEn(ens: List[En], name: String): Bool =
  hasEnAt(ens, name, 0)

def hasEnAt(ens: List[En], name: String, i: Int): Bool =
  if (i >= List.len(ens)) false else hasEnHit(List.at(ens, i), ens, name, i)

def hasEnHit(h: En, ens: List[En], name: String, i: Int): Bool =
  if (h.name == name) true else hasEnAt(ens, name, i + 1)

def inferField(recv: Expr, name: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  recv match {
    case Expr.EVar(en, _) => if (hasEn(ens, en)) ok(en) else inferFieldVar(en, name, env, funs, ens)
    case _ => fieldOf(infer(recv, env, funs, ens), name, ens)
  }

def inferFieldVar(en: String, name: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferFieldHit(findFunMod(funs, en, name), en, name, env, funs, ens)

def inferFieldHit(hit: List[Fun], en: String, name: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(hit)) fieldOf(inferVar(en, env, funs, ens, noSpan()), name, ens) else ok(funTyOf(List.at(hit, 0)))

def fieldOf(o: Out, name: String, ens: List[En]): Out =
  if (hasErr(o)) o else fieldOf2(o.ty, name, ens, o.span)

def fieldOf2(ty: String, name: String, ens: List[En], span: (String, Int)): Out =
  if (isTup(ty) && isTupField(name)) tupFieldAt(splitComma(tupleInner(ty)), tupIdx(name), name, span) else if (isTup(ty) && tupBadName(name)) bad(Str.concat("tuple has no field ", name), span) else fieldOf3(fieldNamed(ens, ty, name), ty)

def isTupField(name: String): Bool =
  tupIdx(name) >= 0

def tupIdx(name: String): Int =
  if (Str.len(name) == 2 && Str.charAt(name, 0) == 95) tupIdxDig(Str.charAt(name, 1)) else 0 - 1

def tupIdxDig(c: Int): Int =
  if (c >= 49 && c <= 56) c - 49 else 0 - 1

def tupBadName(name: String): Bool =
  Str.len(name) >= 2 && Str.charAt(name, 0) == 95 && Str.charAt(name, 1) >= 48 && Str.charAt(name, 1) <= 57

def tupFieldAt(parts: List[String], i: Int, name: String, span: (String, Int)): Out =
  if (i < 0 || i >= List.len(parts)) bad(Str.concat("tuple has no field ", name), span) else ok(List.at(parts, i))

def fieldOf3(ft: String, ty: String): Out =
  if (ft == "") ok(ty) else ok(ft)

def fieldNamed(ens: List[En], ty: String, name: String): String =
  if (List.isEmpty(ens)) "" else fieldNamed1(List.at(ens, 0), List.tail(ens), ty, name)

def fieldNamed1(h: En, rest: List[En], ty: String, name: String): String =
  h match {
    case En(_, n, _, cases) => if (n == ty) fieldNamed2(cases, name) else fieldNamed(rest, ty, name)
  }

def fieldNamed2(cs: List[EnCase], name: String): String =
  if (List.isEmpty(cs)) "" else fieldNamed3(List.at(cs, 0), List.tail(cs), name)

def fieldNamed3(h: EnCase, rest: List[EnCase], name: String): String =
  h match {
    case EnCase(_, fields) => fieldNamed4(fields, name, rest)
  }

def fieldNamed4(fs: List[Param], name: String, rest: List[EnCase]): String =
  if (List.isEmpty(fs)) fieldNamed2(rest, name) else fieldNamed5(List.at(fs, 0), List.tail(fs), name, rest)

def fieldNamed5(p: Param, rest: List[Param], name: String, restCs: List[EnCase]): String =
  p match {
    case Param(n, ty, _, _) => if (n == name) ty else fieldNamed4(rest, name, restCs)
  }

def inferMatch(s: Expr, arms: List[Arm], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferMatch2(infer(s, env, funs, ens), arms, env, funs, ens)

def inferMatch2(o: Out, arms: List[Arm], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(o)) o else if (List.isEmpty(arms)) o else inferMatchArm(List.at(arms, 0), o.ty, env, funs, ens)

def inferMatchArm(arm: Arm, scrutTy: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  arm match {
    case Arm(pat, _, body) => infer(body, bindPat(pat, scrutTy, env, ens), funs, ens)
  }

def parenAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 40) i else parenAt(s, i + 1)

def patBind(pat: String): String =
  patBind2(parenAt(pat, 0), pat)

def patBind2(p: Int, pat: String): String =
  if (p < 0) "" else patBind3(p, closeParen(pat, p + 1, 1), pat)

def patBind3(p: Int, c: Int, pat: String): String =
  if (c < 0) Str.slice(pat, p + 1, Str.len(pat) - 1) else Str.slice(pat, p + 1, c)

def closeParen(s: String, i: Int, d: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else closeParenCh(s, i, d, Str.charAt(s, i))

def closeParenCh(s: String, i: Int, d: Int, c: Int): Int =
  if (c == 40) closeParen(s, i + 1, d + 1) else if (c == 41) closeParenDone(s, i, d) else closeParen(s, i + 1, d)

def closeParenDone(s: String, i: Int, d: Int): Int =
  if (d == 1) i else closeParen(s, i + 1, d - 1)

def patCore(pat: String): String =
  patCore2(parenAt(pat, 0), pat)

def patCore2(p: Int, pat: String): String =
  if (p < 0) pat else Str.slice(pat, 0, p)

def bindPat(pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindPat2(patBind(pat), pat, scrutTy, env, ens)

def bindPat2(b: String, pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  if (asAt(pat, 0) >= 0) bindAs(pat, scrutTy, env, ens) else if (consAt(pat, 0) >= 0) bindCons(pat, scrutTy, env, ens) else if (isTuplePat(pat)) bindTuple(pat, scrutTy, env) else if (hasComma(b)) bindTuple2(splitComma(b), recFieldTys(ens, patCore(pat)), env) else if (asAt(b, 0) >= 0) bindAs(b, bindTy(pat, scrutTy, ens), env, ens) else if (eqAt(b, 0) >= 0) bindEq(b, bindTy(pat, scrutTy, ens), env, ens) else if (consAt(b, 0) >= 0) bindCons(b, bindTy(pat, scrutTy, ens), env, ens) else if (b == "") bindBare(pat, scrutTy, env) else (b, bindTy(pat, scrutTy, ens)) :: env

def eqAt(s: String, i: Int): Int =
  eqAtD(s, i, 0)

def eqAtD(s: String, i: Int, d: Int): Int =
  if (i + 3 > Str.len(s)) 0 - 1 else if (d == 0 && Str.slice(s, i, i + 3) == " = ") i else eqAtD(s, i + 1, asDepth(s, i, d))

def bindEq(b: String, ty: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindPat(Str.slice(b, eqAt(b, 0) + 3, Str.len(b)), ty, env, ens)

def consAt(s: String, i: Int): Int =
  consAtD(s, i, 0)

def consAtD(s: String, i: Int, d: Int): Int =
  if (i + 4 > Str.len(s)) 0 - 1 else if (d == 0 && Str.slice(s, i, i + 4) == " :: ") i else consAtD(s, i + 1, asDepth(s, i, d))

def bindCons(pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindConsAt(consAt(pat, 0), pat, scrutTy, env, ens)

def bindConsAt(i: Int, pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindPat(Str.slice(pat, i + 4, Str.len(pat)), scrutTy, bindPat(Str.slice(pat, 0, i), elemOf(scrutTy), env, ens), ens)

def bindBare(pat: String, scrutTy: String, env: List[(String, String)]): List[(String, String)] =
  if (isBareName(pat)) (pat, scrutTy) :: env else env

def isBareName(s: String): Bool =
  Str.len(s) > 0 && isBareStart(Str.charAt(s, 0)) && s != "_"

def isBareStart(c: Int): Bool =
  c >= 65 && c <= 90 || c >= 97 && c <= 122

def asAt(s: String, i: Int): Int =
  asAtD(s, i, 0)

def asAtD(s: String, i: Int, d: Int): Int =
  if (i + 3 > Str.len(s)) 0 - 1 else if (d == 0 && Str.slice(s, i, i + 3) == " @ ") i else asAtD(s, i + 1, asDepth(s, i, d))

def asDepth(s: String, i: Int, d: Int): Int =
  asDepthCh(Str.charAt(s, i), d)

def asDepthCh(c: Int, d: Int): Int =
  if (c == 40) d + 1 else if (c == 41 && d > 0) d - 1 else if (c == 41) 0 else d

def bindAs(pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindAsAt(asAt(pat, 0), pat, scrutTy, env, ens)

def bindAsAt(i: Int, pat: String, scrutTy: String, env: List[(String, String)], ens: List[En]): List[(String, String)] =
  bindPat(Str.slice(pat, i + 3, Str.len(pat)), scrutTy, (Str.slice(pat, 0, i), scrutTy) :: env, ens)

def isTuplePat(pat: String): Bool =
  Str.len(pat) > 0 && Str.charAt(pat, 0) == 40

def bindTuple(pat: String, scrutTy: String, env: List[(String, String)]): List[(String, String)] =
  bindTuple2(splitComma(Str.slice(pat, 1, Str.len(pat) - 1)), splitComma(tupleInner(scrutTy)), env)

def tupleInner(ty: String): String =
  if (Str.len(ty) > 0 && Str.charAt(ty, 0) == 40) Str.slice(ty, 1, Str.len(ty) - 1) else ty

def splitComma(s: String): List[String] =
  splitCommaAt(s, commaAt(s, 0))

def commaAt(s: String, i: Int): Int =
  commaAtD(s, i, 0)

def commaAtD(s: String, i: Int, d: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else commaAtC(s, i, d, Str.charAt(s, i))

def commaAtC(s: String, i: Int, d: Int, c: Int): Int =
  if (c == 40) commaAtD(s, i + 1, d + 1) else if (c == 41) commaAtD(s, i + 1, if (d > 0) d - 1 else 0) else if (c == 44 && d == 0) i else commaAtD(s, i + 1, d)

def splitCommaAt(s: String, c: Int): List[String] =
  if (c < 0) trimName(s) :: noStr() else trimName(Str.slice(s, 0, c)) :: splitComma(Str.slice(s, c + 1, Str.len(s)))

def trimName(s: String): String =
  trimName2(s, 0, Str.len(s))

def trimName2(s: String, a: Int, b: Int): String =
  if (a >= b) "" else if (Str.charAt(s, a) == 32) trimName2(s, a + 1, b) else if (Str.charAt(s, b - 1) == 32) trimName2(s, a, b - 1) else Str.slice(s, a, b)

def bindTuple2(ns: List[String], ts: List[String], env: List[(String, String)]): List[(String, String)] =
  if (List.isEmpty(ns)) env else bindSlot(List.at(ns, 0), if (List.isEmpty(ts)) "Any" else List.at(ts, 0), bindTuple2(List.tail(ns), if (List.isEmpty(ts)) ts else List.tail(ts), env))

def bindSlot(n: String, ty: String, env: List[(String, String)]): List[(String, String)] =
  if (isTuplePat(n)) bindTuple(n, ty, env) else (n, ty) :: env

def bindTy(pat: String, scrutTy: String, ens: List[En]): String =
  bindTyGot(patCore(pat), fieldTy(ens, patCore(pat)), scrutTy)

def bindTyGot(core: String, ft: String, scrutTy: String): String =
  if (ft == "") ctorElem(core, scrutTy) else ft

def ctorElem(core: String, scrutTy: String): String =
  ctorElem2(ctorName(core), splitComma(elemOf(scrutTy)))

def ctorName(core: String): String =
  ctorName2(dotAt(core, 0), core)

def ctorName2(d: Int, core: String): String =
  if (d < 0) core else Str.slice(core, d + 1, Str.len(core))

def ctorElem2(name: String, args: List[String]): String =
  if (List.isEmpty(args)) "Any" else if (name == "Right" || name == "Err") ctorSecond(args) else List.at(args, 0)

def ctorSecond(args: List[String]): String =
  if (List.isEmpty(List.tail(args))) List.at(args, 0) else List.at(List.tail(args), 0)

def fieldTy(ens: List[En], core: String): String =
  fieldTy2(dotAt(core, 0), core, ens)

def dotAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 46) i else dotAt(s, i + 1)

def fieldTy2(dot: Int, core: String, ens: List[En]): String =
  if (dot < 0) "" else caseFieldTy(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def caseFieldTy(ens: List[En], en: String, ctor: String): String =
  if (List.isEmpty(ens)) "" else caseFieldTy1(List.at(ens, 0), List.tail(ens), en, ctor)

def caseFieldTy1(h: En, rest: List[En], en: String, ctor: String): String =
  h match {
    case En(_, name, _, cases) => if (name == en) caseFieldTy2(cases, ctor) else caseFieldTy(rest, en, ctor)
  }

def caseFieldTy2(cs: List[EnCase], ctor: String): String =
  if (List.isEmpty(cs)) "" else caseFieldTy3(List.at(cs, 0), List.tail(cs), ctor)

def caseFieldTy3(h: EnCase, rest: List[EnCase], ctor: String): String =
  h match {
    case EnCase(name, fields) => if (name == ctor) firstFieldTy(fields) else caseFieldTy2(rest, ctor)
  }

def firstFieldTy(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else paramTyOf(List.at(ps, 0))

def paramTyOf(p: Param): String =
  p match {
    case Param(_, ty, _, _) => ty
  }

def hasComma(s: String): Bool =
  commaAt(s, 0) >= 0

def recFieldTys(ens: List[En], core: String): List[String] =
  recFieldTys2(dotAt(core, 0), core, ens)

def recFieldTys2(dot: Int, core: String, ens: List[En]): List[String] =
  if (dot < 0) enFieldTys(ens, core) else caseFieldTys(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def enFieldTys(ens: List[En], name: String): List[String] =
  if (List.isEmpty(ens)) noStr() else enFieldTys1(List.at(ens, 0), List.tail(ens), name)

def enFieldTys1(h: En, rest: List[En], name: String): List[String] =
  h match {
    case En(_, n, _, cases) => if (n == name) firstCaseTys(cases) else enFieldTys(rest, name)
  }

def firstCaseTys(cs: List[EnCase]): List[String] =
  if (List.isEmpty(cs)) noStr() else firstCaseTys1(List.at(cs, 0))

def firstCaseTys1(c: EnCase): List[String] =
  c match {
    case EnCase(_, fields) => paramTys(fields)
  }

def caseFieldTys(ens: List[En], en: String, ctor: String): List[String] =
  if (List.isEmpty(ens)) noStr() else caseFieldTys1(List.at(ens, 0), List.tail(ens), en, ctor)

def caseFieldTys1(h: En, rest: List[En], en: String, ctor: String): List[String] =
  h match {
    case En(_, name, _, cases) => if (name == en) caseFieldTys2(cases, ctor) else caseFieldTys(rest, en, ctor)
  }

def caseFieldTys2(cs: List[EnCase], ctor: String): List[String] =
  if (List.isEmpty(cs)) noStr() else caseFieldTys3(List.at(cs, 0), List.tail(cs), ctor)

def caseFieldTys3(h: EnCase, rest: List[EnCase], ctor: String): List[String] =
  h match {
    case EnCase(name, fields) => if (name == ctor) paramTys(fields) else caseFieldTys2(rest, ctor)
  }

def inferMethod(recv: Expr, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (name == "flatMap") inferFlatMap(recv, args, env, funs, ens, e) else if (name == "handleErrorWith") inferHandle(recv, args, env, funs, ens, e) else if (name == "map") inferIoMap(recv, args, env, funs, ens, e) else inferMethod2(recv, name, args, env, funs, ens, e)

def inferMethod2(recv: Expr, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  recv match {
    case Expr.EVar(en, _) => if (getTy(env, en) != "") inferCall(Str.concat(".", name), recv :: args, env, funs, ens, exprSpan(env, e)) else inferMethodEn(en, name, args, env, funs, ens, e)
    case _ => inferCall(Str.concat(".", name), recv :: args, env, funs, ens, exprSpan(env, e))
  }

def inferMethodEn(en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferMethodQual(Str.concat(en, Str.concat(".", name)), en, name, args, env, funs, ens, e)

def inferMethodQual(q: String, en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (isKit(q) || isOpenKit(q)) inferCall(q, args, env, funs, ens, exprSpan(env, e)) else if (hasEn(ens, en)) inferCtor(en, args, env, funs, ens) else resolveQual(en, name, args, env, funs, ens, e)

def resolveQual(en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  resolveQualHit(en, name, args, env, funs, ens, findFunMod(funs, en, name), e)

def resolveQualHit(en: String, name: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], hit: List[Fun], e: Expr): Out =
  if (List.isEmpty(hit)) checkKnown(Str.concat(en, Str.concat(".", name)), anyParams(List.len(args)), "Any", args, env, funs, ens, exprSpan(env, e)) else resolveUser(Str.concat(en, Str.concat(".", name)), args, env, funs, ens, exprSpan(env, e), hit)

def inferCtor(en: String, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(args)) ok(en) else inferCtorHead(en, List.at(args, 0), List.tail(args), env, funs, ens)

def inferCtorHead(en: String, h: Expr, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferCtorFrom(en, infer(h, env, funs, ens), rest, env, funs, ens)

def inferCtorFrom(en: String, o: Out, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (hasErr(o)) o else inferCtorRest(en, o, firstArgErr(rest, env, funs, ens), ens)

def inferCtorRest(en: String, o: Out, restErr: Out, ens: List[En]): Out =
  if (hasErr(restErr)) restErr else inferCtor2(en, o, ens)

def inferCtor2(en: String, o: Out, ens: List[En]): Out =
  if (hasErr(o)) o else if (enHasParams(ens, en)) ok(Str.concat(en, Str.concat("[", Str.concat(o.ty, "]")))) else ok(en)

def enHasParams(ens: List[En], name: String): Bool =
  if (List.isEmpty(ens)) false else enHasParams1(List.at(ens, 0), List.tail(ens), name)

def enHasParams1(h: En, rest: List[En], name: String): Bool =
  h match {
    case En(_, n, tps, _) => if (n == name) List.len(tps) > 0 else enHasParams(rest, name)
  }

def isIo(t: String): Bool =
  Str.startsWith(t, "IO[")

def ioEq(a: String, b: String): Bool =
  isIo(a) && isIo(b) && tyEq(ioErr(a), ioErr(b)) && tyEq(ioOk(a), ioOk(b))

def ioParts(t: String): List[String] =
  if (isIo(t)) splitComma(elemOf(t)) else noStr()

def ioErr(t: String): String =
  ioErrParts(ioParts(t))

def ioErrParts(ps: List[String]): String =
  if (List.len(ps) >= 2) List.at(ps, 0) else "String"

def ioOk(t: String): String =
  ioOkParts(ioParts(t))

def ioOkParts(ps: List[String]): String =
  if (List.isEmpty(ps)) "Any" else if (List.len(ps) == 1) List.at(ps, 0) else List.at(ps, List.len(ps) - 1)

def ioTy(e: String, a: String): String =
  if (e == "" || e == "String") Str.concat("IO[", Str.concat(a, "]")) else Str.concat("IO[", Str.concat(e, Str.concat(", ", Str.concat(a, "]"))))

def unifyErr(a: String, b: String, span: (String, Int)): Out =
  if (a == "") ok(if (b == "") "String" else b) else if (b == "") ok(a) else if (tyEq(a, b)) ok(prefer(a, b)) else bad(Str.concat("fail type mismatch: expected ", Str.concat(a, Str.concat(", got ", b))), span)

def inferFlatMap(recv: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferFlatMap2(infer(recv, env, funs, ens), args, env, funs, ens, e)

def inferIoMap(recv: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferIoMap2(infer(recv, env, funs, ens), recv, args, env, funs, ens, e)

def inferIoMap2(o: Out, recv: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (!isIo(o.ty)) inferMethod2(recv, "map", args, env, funs, ens, e) else if (List.len(args) != 1) bad(Str.concat("map expects 1 args, got ", Str.fromInt(List.len(args))), exprSpan(env, e)) else inferIoMapLam(o, List.at(args, 0), env, funs, ens, e)

def inferIoMapLam(recv: Out, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  lam match {
    case Expr.ELam(p, body) => inferIoMap3(recv, infer(body, bindIo(p, recv.ty, env), funs, ens), env, e)
    case Expr.EMatch(_, _, _) => inferIoMap3(recv, infer(lam, env, funs, ens), env, e)
    case _ => bad("map needs a lambda", exprSpan(env, e))
  }

def inferIoMap3(recv: Out, body: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(body)) body else ok(ioTy(ioErr(recv.ty), body.ty))

def inferFlatMap2(o: Out, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (List.len(args) != 1) bad(Str.concat("flatMap expects 1 args, got ", Str.fromInt(List.len(args))), exprSpan(env, e)) else inferFlatMapLam(o, List.at(args, 0), env, funs, ens, e)

def inferFlatMapLam(recv: Out, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  lam match {
    case Expr.ELam(p, body) => inferFlatMap3(recv, infer(body, bindIo(p, recv.ty, env), funs, ens), env, e)
    case _ => inferFlatMap3(recv, infer(lam, env, funs, ens), env, e)
  }

def bindIo(p: String, ioTy: String, env: List[(String, String)]): List[(String, String)] =
  if (p == "_" || p == "") env else (p, ioPayload(ioTy)) :: env

def ioPayload(t: String): String =
  if (isIo(t)) ioOk(t) else "Any"

def inferFlatMap3(recv: Out, body: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(body)) body else inferFlatMap4(recv, body, env, e)

def inferFlatMap4(recv: Out, body: Out, env: List[(String, String)], e: Expr): Out =
  if (isIo(recv.ty) && isIo(body.ty)) inferFlatMapErr(recv, body, env, e) else if (isIo(recv.ty) && body.ty == "Any") ok(recv.ty) else if (recv.ty == "Any") ok(if (isIo(body.ty)) body.ty else "IO[Any]") else bad(Str.concat("flatMap needs IO, got ", Str.concat(recv.ty, Str.concat(" and ", body.ty))), exprSpan(env, e))

def inferFlatMapErr(recv: Out, body: Out, env: List[(String, String)], e: Expr): Out =
  inferFlatMapErr2(unifyErr(ioErr(recv.ty), ioErr(body.ty), exprSpan(env, e)), recv, body)

def inferFlatMapErr2(u: Out, recv: Out, body: Out): Out =
  if (hasErr(u)) u else ok(ioTy(u.ty, ioOk(body.ty)))

def inferHandle(recv: Expr, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  inferHandle2(infer(recv, env, funs, ens), args, env, funs, ens, e)

def inferHandle2(o: Out, args: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (List.len(args) != 1) bad(Str.concat("handleErrorWith expects 1 args, got ", Str.fromInt(List.len(args))), exprSpan(env, e)) else inferHandleLam(o, List.at(args, 0), env, funs, ens, e)

def inferHandleLam(recv: Out, lam: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], e: Expr): Out =
  lam match {
    case Expr.ELam(p, body) => inferHandle3(recv, infer(body, bindHandle(p, recv.ty, env), funs, ens), env, e)
    case _ => inferHandle3(recv, infer(lam, env, funs, ens), env, e)
  }

def bindHandle(p: String, ioTy: String, env: List[(String, String)]): List[(String, String)] =
  if (p == "_" || p == "") env else (p, ioErr(ioTy)) :: env

def inferHandle3(recv: Out, body: Out, env: List[(String, String)], e: Expr): Out =
  if (hasErr(body)) body else if (isIo(recv.ty) && isIo(body.ty)) inferHandleOk(recv, body, env, e) else if (isIo(recv.ty) && body.ty == "Any") ok(recv.ty) else bad(Str.concat("handleErrorWith needs IO, got ", Str.concat(recv.ty, Str.concat(" and ", body.ty))), exprSpan(env, e))

def inferHandleOk(recv: Out, body: Out, env: List[(String, String)], e: Expr): Out =
  if (tyEq(ioOk(recv.ty), ioOk(body.ty))) ok(ioTy(ioErr(body.ty), ioOk(recv.ty))) else bad(Str.concat("handleErrorWith type mismatch: expected ", Str.concat(ioOk(recv.ty), Str.concat(", got ", ioOk(body.ty)))), exprSpan(env, e))

def inferVar(s: String, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  inferVar2(s, getTy(env, s), env, funs, ens, span)

def inferVar2(s: String, t: String, env: List[(String, String)], funs: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (t == "") inferVarFun(s, findFunPrefer(funs, s, env), ens, span) else ok(t)

def inferVarFun(s: String, hit: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(hit)) inferVarCase(s, ens, span) else ok(funTyOf(List.at(hit, 0)))

def inferVarCase(s: String, ens: List[En], span: (String, Int)): Out =
  if (enOfCase(ens, s) == "") bad(Str.concat("unbound variable ", s), span) else ok(enOfCase(ens, s))

def funTyOf(d: Fun): String =
  d match {
    case Fun(_, _, _, ps, ret, _, _, _) => funTyFrom(paramTys(ps), ret)
  }

def funTyFrom(ps: List[String], ret: String): String =
  if (List.isEmpty(ps)) ret else if (List.len(ps) == 1) Str.concat(List.at(ps, 0), Str.concat(" => ", ret)) else Str.concat("(", Str.concat(joinComma(ps), Str.concat(") => ", ret)))

def joinComma(ps: List[String]): String =
  if (List.isEmpty(ps)) "" else if (List.isEmpty(List.tail(ps))) List.at(ps, 0) else Str.concat(List.at(ps, 0), Str.concat(", ", joinComma(List.tail(ps))))

def inferList(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  if (List.isEmpty(xs)) ok("List") else inferList2(infer(List.at(xs, 0), env, funs, ens))

def inferList2(o: Out): Out =
  if (hasErr(o)) o else ok(Str.concat("List[", Str.concat(o.ty, "]")))

def inferTuple(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): Out =
  inferTupleAcc(xs, env, funs, ens, "")

def inferTupleAcc(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  if (List.isEmpty(xs)) inferTupleDone(acc) else inferTupleHd(List.at(xs, 0), xs, env, funs, ens, acc)

def inferTupleDone(acc: String): Out =
  if (acc == "") ok("Unit") else ok(Str.concat("(", Str.concat(acc, ")")))

def inferTupleHd(h: Expr, xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  inferTupleGot(infer(stripNamed(h), env, funs, ens), xs, env, funs, ens, acc)

def inferTupleGot(o: Out, xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else inferTupleRest(List.tail(xs), env, funs, ens, if (acc == "") ty else Str.concat(acc, Str.concat(", ", ty)))
  }

def inferTupleRest(rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], acc: String): Out =
  inferTupleAcc(rest, env, funs, ens, acc)

def checkDef(d: Fun, funs: List[Fun], ens: List[En]): Out =
  d match {
    case Fun(_, name, _, ps, ret, body, mod, off) => checkDefWrap(name, ret, body, infer(body, bindParams(ps, ("self", "Any") :: ("#mod", mod) :: noEnv()), funs, ens), (mod, off))
  }

def checkDefWrap(name: String, ret: String, body: Expr, o: Out, span: (String, Int)): Out =
  if (hasErr(o)) bad(Str.concat("in ", Str.concat(name, Str.concat(": ", o.err))), o.span) else checkDefGot(name, ret, body, o, span)

def checkDefGot(name: String, ret: String, body: Expr, o: Out, span: (String, Int)): Out =
  if (hasErr(o)) o else if (tyEq(o.ty, ret) || funBodyEq(o.ty, ret)) o else bad(Str.concat("def ", Str.concat(name, Str.concat(" body ", Str.concat(o.ty, Str.concat(" does not match declared ", ret))))), spanPick(Parse.spanOf(body), span))

def spanPick(a: (String, Int), b: (String, Int)): (String, Int) =
  a match {
    case (sa, oa) => b match {
  case (sb, _) => if (oa < 0) b else (if (sa == "") sb else sa, oa)
}
  }

def funBodyEq(got: String, ret: String): Bool =
  isFunTy(ret) && tyEq(got, funRetOf(ret))

def checkProg(p: Prog): Out =
  checkProgOwn(p, [])

def checkProgOwn(p: Prog, stems: List[String]): Out =
  p match {
    case Prog(_, enums, aliases, _, _, imps, defs, main, body) => checkProgGo(expandDefs(withImportFuns(imps, defs), aliases), Parse.builtins(enums), main, body, stems)
  }

def checkProgGo(ds: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  checkDefsRest(ds, ds, enums, main, body, stems)

def withImportFuns(imps: List[Imp], defs: List[Fun]): List[Fun] =
  List.concat(importFuns(imps, defs), defs)

def importFuns(imps: List[Imp], defs: List[Fun]): List[Fun] =
  if (List.isEmpty(imps)) [] else importFunsGo(List.at(imps, 0), List.tail(imps), defs)

def importFunsGo(h: Imp, rest: List[Imp], defs: List[Fun]): List[Fun] =
  List.concat(importFun1(h, defs), importFuns(rest, defs))

def importFun1(h: Imp, defs: List[Fun]): List[Fun] =
  h match {
    case Imp(mod, name, alias) => if (alias == "") [] else renameHits(findFunMod(defs, mod, name), alias)
  }

def renameHits(hit: List[Fun], alias: String): List[Fun] =
  if (List.isEmpty(hit)) [] else renameFun(List.at(hit, 0), alias) :: []

def renameFun(d: Fun, alias: String): Fun =
  d match {
    case Fun(priv, _, ts, ps, ret, body, mod, off) => Fun(priv, alias, ts, ps, ret, body, mod, off)
  }

def expandDefs(defs: List[Fun], als: List[Alias]): List[Fun] =
  List.reverse(expandDefsGo(defs, als, []))

def expandDefsGo(defs: List[Fun], als: List[Alias], acc: List[Fun]): List[Fun] =
  if (List.isEmpty(defs)) acc else expandDefsGo(List.tail(defs), als, expandDef(List.at(defs, 0), als) :: acc)

def expandDef(d: Fun, als: List[Alias]): Fun =
  d match {
    case Fun(priv, name, ts, ps, ret, body, mod, off) => Fun(priv, name, ts, expandParams(ps, als), expandTy(ret, als), body, mod, off)
  }

def expandParams(ps: List[Param], als: List[Alias]): List[Param] =
  if (List.isEmpty(ps)) ps else expandParam(List.at(ps, 0), als) :: expandParams(List.tail(ps), als)

def expandParam(p: Param, als: List[Alias]): Param =
  p match {
    case Param(n, ty, w, d) => Param(n, expandTy(ty, als), w, d)
  }

def expandTy(t: String, als: List[Alias]): String =
  if (List.isEmpty(als)) t else expandTyGo(t, List.at(als, 0), als)

def expandTyGo(t: String, h: Alias, als: List[Alias]): String =
  h match {
    case Alias(name, tps, target) => expandTyHit(t, name, tps, target, als)
  }

def expandTyHit(t: String, name: String, tps: List[String], target: String, als: List[Alias]): String =
  if (t == name && List.isEmpty(tps)) target else if (isTyApp(t, name) && !List.isEmpty(tps)) expandTy(substTy(target, List.at(tps, 0), tyAppArg(t, name)), List.tail(als)) else expandTy(t, List.tail(als))

def isTyApp(t: String, name: String): Bool =
  Str.len(t) > Str.len(name) + 1 && Str.slice(t, 0, Str.len(name) + 1) == Str.concat(name, "[") && Str.charAt(t, Str.len(t) - 1) == 93

def tyAppArg(t: String, name: String): String =
  Str.slice(t, Str.len(name) + 1, Str.len(t) - 1)

def substTy(target: String, param: String, arg: String): String =
  substTyAt(target, param, arg, 0)

def substTyAt(target: String, param: String, arg: String, i: Int): String =
  if (i + Str.len(param) > Str.len(target)) target else if (Str.slice(target, i, i + Str.len(param)) == param && tyBound(target, i, Str.len(param))) Str.concat(Str.slice(target, 0, i), Str.concat(arg, substTy(Str.slice(target, i + Str.len(param), Str.len(target)), param, arg))) else substTyAt(target, param, arg, i + 1)

def tyBound(s: String, i: Int, n: Int): Bool =
  tyBoundL(s, i) && tyBoundR(s, i + n)

def tyBoundL(s: String, i: Int): Bool =
  i == 0 || !isTyChar(Str.charAt(s, i - 1))

def tyBoundR(s: String, i: Int): Bool =
  i >= Str.len(s) || !isTyChar(Str.charAt(s, i))

def isTyChar(c: Int): Bool =
  c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95

def inStems(stems: List[String], mod: String): Bool =
  List.isEmpty(stems) || hasStem(stems, mod)

def hasStem(stems: List[String], mod: String): Bool =
  if (List.isEmpty(stems)) false else if (List.at(stems, 0) == mod) true else hasStem(List.tail(stems), mod)

def checkDefsRest(all: List[Fun], rest: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  if (List.isEmpty(rest)) checkMain(main, body, all, enums, mainFile(stems)) else checkDefsHit(List.at(rest, 0), all, List.tail(rest), enums, main, body, stems)

def checkDefsHit(d: Fun, all: List[Fun], rest: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  d match {
    case Fun(_, _, _, _, _, _, mod, _) => if (inStems(stems, mod)) checkDefsAfter(checkDef(d, all, enums), all, rest, enums, main, body, stems) else checkDefsRest(all, rest, enums, main, body, stems)
  }

def checkDefsAfter(o: Out, all: List[Fun], rest: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  if (hasErr(o)) o else checkDefsRest(all, rest, enums, main, body, stems)

def mainFile(stems: List[String]): String =
  if (List.isEmpty(stems)) "Main" else if (hasStem(stems, "Main")) "Main" else List.at(stems, 0)

def checkMain(name: String, body: Expr, funs: List[Fun], ens: List[En], file: String): Out =
  if (name == "") ok("IO[Unit]") else checkMainGot(infer(body, ("#mod", file) :: noEnv(), funs, ens), body, file)

def checkMainGot(o: Out, body: Expr, file: String): Out =
  o match {
    case Out(ty, err, sp) => if (Str.len(err) > 0) Out(ty, err, sp) else if (ty == "IO[Unit]") Out(ty, err, sp) else bad(Str.concat("@main body must be IO[Unit], got ", ty), spanPick(sp, spanPick(Parse.spanOf(body), (file, 0 - 1))))
  }

def lineCol(src: String, i: Int, j: Int, line: Int, col: Int, n: Int): (Int, Int) =
  if (j >= i) (line, col) else if (j >= n) (line, col) else if (Str.charAt(src, j) == 10) lineCol(src, i, j + 1, line + 1, 1, n) else lineCol(src, i, j + 1, line, col + 1, n)

def isIdentCh(c: Int): Bool =
  c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95

def skipIdent(src: String, i: Int): Int =
  if (i >= Str.len(src)) i else if (isIdentCh(Str.charAt(src, i))) skipIdent(src, i + 1) else i

def skipQual(src: String, i: Int): Int =
  skipQual2(src, skipIdent(src, i))

def skipQual2(src: String, j: Int): Int =
  if (j < Str.len(src) && Str.charAt(src, j) == 46 && j + 1 < Str.len(src) && isIdentCh(Str.charAt(src, j + 1))) skipQual(src, j + 1) else j

def skipStr(src: String, i: Int): Int =
  if (i >= Str.len(src)) i else if (Str.charAt(src, i) == 34) i + 1 else if (Str.charAt(src, i) == 92 && i + 1 < Str.len(src)) skipStr(src, i + 2) else skipStr(src, i + 1)

def tokenEnd(src: String, off: Int): Int =
  if (off < 0 || off >= Str.len(src)) off else tokenEndCh(src, off, Str.charAt(src, off))

def tokenEndCh(src: String, off: Int, c: Int): Int =
  if (c == 34) skipStr(src, off + 1) else if (isIdentCh(c)) skipQual(src, off) else off + 1

def locOf(src: String, off: Int): (Int, Int, Int, Int) =
  if (off < 0 || src == "") (1, 1, 1, 1) else locOf2(lineCol(src, off, 0, 1, 1, Str.len(src)), src, off)

def locOf2(p: (Int, Int), src: String, off: Int): (Int, Int, Int, Int) =
  p match {
    case (line, col) => locOf3(line, col, tokenEnd(src, off) - off)
  }

def locOf3(line: Int, col: Int, n: Int): (Int, Int, Int, Int) =
  (line, col, line, col + (if (n < 1) 1 else n))

def hexDigit(n: Int): String =
  Str.slice("0123456789abcdef", n, n + 1)

def hex2(n: Int): String =
  Str.concat(hexDigit(n / 16), hexDigit(n % 16))

def jsonStr(s: String): String =
  Str.concat("\"", Str.concat(_esc(s, 0, Builder.empty()), "\""))

def _esc(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else _esc2(s, i, b, Str.charAt(s, i))

def _esc2(s: String, i: Int, b: Builder, c: Int): String =
  _esc(s, i + 1, Builder.append(b, if (c == 34) "\\\"" else if (c == 92) "\\\\" else if (c == 10) "\\n" else if (c == 13) "\\r" else if (c == 9) "\\t" else if (c < 32) Str.concat("\\u00", hex2(c)) else Str.slice(s, i, i + 1)))

def fileOf(stem: String): String =
  if (stem == "") "Main.scuzz" else Str.concat(stem, ".scuzz")

def srcOfStem(files: List[(String, String)], stem: String): String =
  if (List.isEmpty(files)) "" else srcOfStemHd(List.at(files, 0), List.tail(files), stem)

def srcOfStemHd(h: (String, String), rest: List[(String, String)], stem: String): String =
  h match {
    case (s, src) => if (s == stem || stem == "" && s == "Main") src else srcOfStem(rest, stem)
  }

def diagJson(files: List[(String, String)], o: Out): String =
  diagJsonSp(files, o, o.span)

def diagJsonSp(files: List[(String, String)], o: Out, sp: (String, Int)): String =
  sp match {
    case (stem, off) => diagJson2(o, fileOf(stem), locOf(srcOfStem(files, stem), off))
  }

def diagJson2(o: Out, file: String, loc: (Int, Int, Int, Int)): String =
  loc match {
    case (line, col, eline, ecol) => diagJson3(o, file, line, col, eline, ecol)
  }

def diagJson3(o: Out, file: String, line: Int, col: Int, eline: Int, ecol: Int): String =
  Str.concat("{\"severity\":\"error\",\"message\":", Str.concat(jsonStr(Str.concat("type error: ", o.err)), Str.concat(",\"file\":", Str.concat(jsonStr(file), Str.concat(",\"line\":", Str.concat(Str.fromInt(line), Str.concat(",\"column\":", Str.concat(Str.fromInt(col), Str.concat(",\"end_line\":", Str.concat(Str.fromInt(eline), Str.concat(",\"end_column\":", Str.concat(Str.fromInt(ecol), "}"))))))))))))

def check(src: String): String =
  checkFiles(("Main", src) :: [])

def checkFiles(files: List[(String, String)]): String =
  checkFilesOwn(files, [])

def checkFilesOwn(files: List[(String, String)], stems: List[String]): String =
  check3(files, checkProgOwn(Parse.parseFiles(files), stems))

def check3(files: List[(String, String)], o: Out): String =
  if (hasErr(o)) Str.concat("[", Str.concat(diagJson(files, o), "]")) else "[]"

def unclaimedJson(files: List[(String, String)]): String =
  unclaimedOf(Parse.parseFiles(files))

def unclaimedOf(p: Prog): String =
  if (p.main == "") "[]" else Str.concat("[", Str.concat(unclaimedMain(p.main), "]"))

def unclaimedMain(name: String): String =
  Str.concat("{\"severity\":\"info\",\"message\":\"unclaimed def ", Str.concat(name, "\",\"line\":1,\"column\":1}"))

def humanLine(files: List[(String, String)], o: Out): String =
  humanLineSp(files, o, o.span)

def humanLineSp(files: List[(String, String)], o: Out, sp: (String, Int)): String =
  sp match {
    case (stem, off) => humanLine2(o, fileOf(stem), locOf(srcOfStem(files, stem), off))
  }

def humanLine2(o: Out, file: String, loc: (Int, Int, Int, Int)): String =
  loc match {
    case (line, col, _, _) => humanLine3(o, file, line, col)
  }

def humanLine3(o: Out, file: String, line: Int, col: Int): String =
  Str.concat(file, Str.concat(":", Str.concat(Str.fromInt(line), Str.concat(":", Str.concat(Str.fromInt(col), Str.concat(": error: type error: ", o.err))))))

def human(src: String): String =
  humanFiles(("Main", src) :: [])

def humanFiles(files: List[(String, String)]): String =
  humanFilesOwn(files, [])

def humanFilesOwn(files: List[(String, String)], stems: List[String]): String =
  human3(files, checkProgOwn(Parse.parseFiles(files), stems))

def human3(files: List[(String, String)], o: Out): String =
  if (hasErr(o)) humanLine(files, o) else "scuzz check ok"

