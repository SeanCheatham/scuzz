record Out(ty: Ty, err: String, span: (String, Int), binds: List[(String, Ty)], origin: String)

record Ftab(list: List[Fun], tab: Map[String, List[Fun]], kits: Map[String, KitSig])

import Parse.Expr
import Parse.Fun
import Parse.Param
import Parse.Prog
import Parse.En
import Parse.EnCase
import Parse.Arm
import Parse.Bind
import Parse.Alias
import Parse.Imp
import Parse.Im
import Parse.Tr
import Parse.TrMethod
import Lexer.lex
import Type.preferStr
import Type.eqPinned
import Type.isTyParam
import Type.Ty
import Kits.Kit
import Kits.KitSig
import Kits.names

def noStr(): List[String] =
  []

def noEnv(): List[(String, Ty)] =
  []

def envMod(mod: String): List[(String, Ty)] =
  ("#mod", Type.tNamed(mod)) :: noEnv()

def envSelfMod(mod: String): List[(String, Ty)] =
  ("self", Type.tParam("A")) :: envMod(mod)

def envBind(n: String, ty: String, env: List[(String, Ty)]): List[(String, Ty)] =
  if (n == "" || n == "_") env else (n, Type.parse(if (ty == "") "A" else ty)) :: env

def modFile(env: List[(String, Ty)]): String =
  Type.show(getTy(env, "#mod"))

def exprSpan(env: List[(String, Ty)], e: Expr): (String, Int) =
  spanPick(Parse.spanOf(e), (modFile(env), 0 - 1))

def noSpan(): (String, Int) =
  ("", 0 - 1)

def noBinds(): List[(String, Ty)] =
  []

def ok(ty: String): Out =
  Out(Type.parse(ty), "", noSpan(), noBinds(), "")

def okTy(t: Ty): Out =
  Out(t, "", noSpan(), noBinds(), "")

def tyStr(o: Out): String =
  Type.show(o.ty)

def bad(err: String, span: (String, Int)): Out =
  Out(Type.tNamed(""), err, span, noBinds(), "")

def ret(o: Out, ty: String): Out =
  if (hasErr(o)) o else Out(Type.parse(ty), "", noSpan(), o.binds, "")

def retTy(o: Out, t: Ty): Out =
  if (hasErr(o)) o else Out(t, "", noSpan(), o.binds, "")

def withSpan(o: Out, span: (String, Int)): Out =
  Out(o.ty, o.err, span, o.binds, o.origin)

def varOut(t: Ty, name: String, ens: List[En]): Out =
  if (isLooseTy(t, ens)) Out(t, "", noSpan(), noBinds(), name) else okTy(t)

def bindGet(bs: List[(String, Ty)], n: String): Ty =
  if (List.isEmpty(bs)) Type.tNamed("") else bindGet1(List.at(bs, 0), List.tail(bs), n)

def bindGet1(h: (String, Ty), rest: List[(String, Ty)], n: String): Ty =
  h match {
    case (k, ty) => if (k == n) ty else bindGet(rest, n)
  }

def addBinds(o: Out, bs: List[(String, Ty)]): Out =
  if (hasErr(o) || List.isEmpty(bs)) o else addBind(o, List.at(bs, 0), List.tail(bs))

def addBind(o: Out, h: (String, Ty), rest: List[(String, Ty)]): Out =
  h match {
    case (n, ty) => addBind1(o, n, ty, bindGet(o.binds, n), rest)
  }

def addBind1(o: Out, n: String, ty: Ty, prev: Ty, rest: List[(String, Ty)]): Out =
  if (Type.isEmpty(prev)) addBinds(Out(o.ty, o.err, o.span, (n, ty) :: o.binds, o.origin), rest) else if (Type.eqStruct(prev, ty)) addBinds(o, rest) else bad(Str.concat("type parameter ", Str.concat(n, Str.concat(" bound to ", Str.concat(Type.show(prev), Str.concat(" and ", Type.show(ty)))))), o.span)

def andBinds(prev: Out, next: Out): Out =
  if (hasErr(prev)) prev else if (hasErr(next)) next else addBinds(next, prev.binds)

def bindOrigin(o: Out, origin: String, ty: Ty, concrete: Ty, ens: List[En], span: (String, Int)): Out =
  if (origin != "" && isLooseTy(ty, ens) && Type.ground(concrete)) addBinds(withSpan(o, span), (origin, concrete) :: noBinds()) else o

def bindLoose(o: Out, concrete: Ty, ens: List[En], span: (String, Int)): Out =
  bindOrigin(o, o.origin, o.ty, concrete, ens, span)

def hasErr(o: Out): Bool =
  Str.len(o.err) > 0

def getTy(env: List[(String, Ty)], name: String): Ty =
  lookupEnv(env, name)

def bindParams(ps: List[Param], acc: List[(String, Ty)]): List[(String, Ty)] =
  if (List.isEmpty(ps)) acc else bindParamsHd(List.at(ps, 0), List.tail(ps), acc)

def bindParamsHd(p: Param, rest: List[Param], acc: List[(String, Ty)]): List[(String, Ty)] =
  p match {
    case Param(n, ty, _, _) => bindParams(rest, envBind(n, ty, acc))
  }

def bindLam(p: String, ty: String, env: List[(String, Ty)]): List[(String, Ty)] =
  envBind(p, ty, env)

def annOk(ann: String, expect: String, span: (String, Int), ens: List[En]): Out =
  if (ann == "" || tyEqEn(ann, expect, ens)) ok(expect) else bad(Str.concat("type mismatch: expected ", Str.concat(ann, Str.concat(", got ", expect))), span)

def lookupEnv(env: List[(String, Ty)], n: String): Ty =
  if (List.isEmpty(env)) Type.tNamed("") else lookupEnv1(List.at(env, 0), List.tail(env), n)

def lookupEnv1(h: (String, Ty), rest: List[(String, Ty)], n: String): Ty =
  h match {
    case (k, ty) => if (k == n) ty else lookupEnv(rest, n)
  }

def isFunTy(t: String): Bool =
  Type.isFunStr(t)

def funRetOf(t: String): String =
  Type.funRetStr(t)

def findFunPrefer(funs: Ftab, name: String, env: List[(String, Ty)]): List[Fun] =
  findFunPrefer2(funs, name, modFile(env))

def findFunPrefer2(funs: Ftab, name: String, mod: String): List[Fun] =
  if (mod == "") ftabGet(funs.tab, name) else findFunPrefer3(ftabGet(funs.tab, name), mod)

def findFunPrefer3(all: List[Fun], mod: String): List[Fun] =
  if (List.len(all) <= 1) all else findFunPrefer4(List.filter(all, h => h.mod == mod), all)

def findFunPrefer4(hit: List[Fun], all: List[Fun]): List[Fun] =
  if (List.isEmpty(hit)) all else hit

def findFun(funs: List[Fun], name: String): List[Fun] =
  List.filter(funs, h => h.name == name)

def findFunMod(funs: List[Fun], mod: String, name: String): List[Fun] =
  List.filter(funs, h => h.name == name && h.mod == mod)

def ftabOfList(ds: List[Fun]): Ftab =
  Ftab(ds, ftabOf(ds), Kits.tab())

def ftabOf(ds: List[Fun]): Map[String, List[Fun]] =
  if (List.isEmpty(ds)) Map.empty() else ftabAdd(ftabOf(List.tail(ds)), List.at(ds, 0))

def ftabAdd(m: Map[String, List[Fun]], d: Fun): Map[String, List[Fun]] =
  Map.set(m, d.name, d :: ftabGet(m, d.name))

def ftabGet(t: Map[String, List[Fun]], name: String): List[Fun] =
  Map.get(t, name) match {
    case Some(xs) => xs
    case None => []
  }

def ftabGetMod(t: Map[String, List[Fun]], mod: String, name: String): List[Fun] =
  List.filter(ftabGet(t, name), h => h.mod == mod)

def paramTys(ps: List[Param]): List[String] =
  if (List.isEmpty(ps)) [] else paramTys1(List.at(ps, 0), List.tail(ps))

def paramTys1(p: Param, rest: List[Param]): List[String] =
  p match {
    case Param(_, ty, _, _) => ty :: paramTys(rest)
  }

def stripNamed(e: Expr): Expr =
  e match {
    case Expr.ENamed(_, inner) => inner
    case _ => e
  }

def noExpr(): List[Expr] =
  []

def hasNamedArg(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (isNamedArg(List.at(xs, 0)) || hasNamedArg(List.tail(xs)))

def isNamedArg(e: Expr): Bool =
  e match {
    case Expr.ENamed(_, _) => true
    case _ => false
  }

def dfltExpr(d: String): Expr =
  dfltExprOf(Parse.parseExprList(lex(d), 0))

def dfltExprOf(p: (Expr, Int)): Expr =
  p match {
    case (e, _) => e
  }

def namedHas(n: String, args: List[Expr]): Bool =
  !List.isEmpty(args) && namedHas1(List.at(args, 0), List.tail(args), n)

def namedHas1(h: Expr, rest: List[Expr], n: String): Bool =
  h match {
    case Expr.ENamed(nm, _) => nm == n || namedHas(n, rest)
    case _ => namedHas(n, rest)
  }

def namedLookup(n: String, args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EUnit else namedLookup1(List.at(args, 0), List.tail(args), n)

def namedLookup1(h: Expr, rest: List[Expr], n: String): Expr =
  h match {
    case Expr.ENamed(nm, inner) => if (nm == n) inner else namedLookup(n, rest)
    case _ => namedLookup(n, rest)
  }

def paramHasName(ps: List[Param], n: String): Bool =
  if (List.isEmpty(ps)) false else paramHasName1(List.at(ps, 0), List.tail(ps), n)

def paramHasName1(p: Param, rest: List[Param], n: String): Bool =
  p match {
    case Param(nm, _, _, _) => nm == n || paramHasName(rest, n)
  }

def alignCall(ps: List[Param], args: List[Expr]): (List[Expr], String) =
  if (List.isEmpty(ps)) (args, "") else alignAfterSplit(ps, alignSplit(args, noExpr(), noExpr(), false))

def alignSplit(args: List[Expr], pos: List[Expr], named: List[Expr], seenN: Bool): (List[Expr], List[Expr], String) =
  if (List.isEmpty(args)) (List.reverse(pos), List.reverse(named), "") else alignSplit1(List.at(args, 0), List.tail(args), pos, named, seenN)

def alignSplit1(h: Expr, rest: List[Expr], pos: List[Expr], named: List[Expr], seenN: Bool): (List[Expr], List[Expr], String) =
  h match {
    case Expr.ENamed(_, _) => alignSplit(rest, pos, h :: named, true)
    case _ => if (seenN) (List.reverse(pos), List.reverse(named), "positional argument after named argument") else alignSplit(rest, h :: pos, named, false)
  }

def alignAfterSplit(ps: List[Param], sp: (List[Expr], List[Expr], String)): (List[Expr], String) =
  sp match {
    case (pos, named, err) => if (err != "") (noExpr(), err) else alignAfterUnknown(ps, pos, named, alignUnknown(named, ps))
  }

def alignUnknown(named: List[Expr], ps: List[Param]): String =
  if (List.isEmpty(named)) "" else alignUnknown1(List.at(named, 0), List.tail(named), ps)

def alignUnknown1(h: Expr, rest: List[Expr], ps: List[Param]): String =
  h match {
    case Expr.ENamed(nm, _) => if (paramHasName(ps, nm)) alignUnknown(rest, ps) else Str.concat("unknown argument ", nm)
    case _ => alignUnknown(rest, ps)
  }

def alignAfterUnknown(ps: List[Param], pos: List[Expr], named: List[Expr], err: String): (List[Expr], String) =
  if (err != "") (noExpr(), err) else alignFillPs(ps, pos, named, 0, noExpr())

def alignFillPs(ps: List[Param], pos: List[Expr], named: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  if (List.isEmpty(ps)) alignDone(pos, i, acc) else alignFillHd(List.at(ps, 0), List.tail(ps), pos, named, i, acc)

def alignDone(pos: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  if (i < List.len(pos)) (List.reverse(acc), "too many arguments") else (List.reverse(acc), "")

def alignFillHd(p: Param, rest: List[Param], pos: List[Expr], named: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  p match {
    case Param(n, _, _, d) => alignFillOne(n, d, rest, pos, named, i, acc)
  }

def alignFillOne(n: String, d: String, rest: List[Param], pos: List[Expr], named: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  if (i < List.len(pos)) alignFillPos(n, rest, pos, named, i, acc) else alignFillNamed(n, d, rest, pos, named, i, acc)

def alignFillPos(n: String, rest: List[Param], pos: List[Expr], named: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  if (namedHas(n, named)) (noExpr(), Str.concat("duplicate argument ", n)) else alignFillPs(rest, pos, named, i + 1, List.at(pos, i) :: acc)

def alignFillNamed(n: String, d: String, rest: List[Param], pos: List[Expr], named: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  if (namedHas(n, named)) alignFillPs(rest, pos, named, i, namedLookup(n, named) :: acc) else alignFillDflt(n, d, rest, pos, named, i, acc)

def alignFillDflt(n: String, d: String, rest: List[Param], pos: List[Expr], named: List[Expr], i: Int, acc: List[Expr]): (List[Expr], String) =
  if (d != "") alignFillPs(rest, pos, named, i, dfltExpr(d) :: acc) else (noExpr(), Str.concat("missing argument ", n))

def alignErr(f: String, err: String, ps: List[Param], args: List[Expr]): String =
  if (arityErr(err, args)) Str.concat(f, Str.concat(" expects ", Str.concat(Str.fromInt(List.len(ps)), Str.concat(" args, got ", Str.fromInt(List.len(args)))))) else err

def arityErr(err: String, args: List[Expr]): Bool =
  (err == "too many arguments" || Str.startsWith(err, "missing argument ")) && !hasNamedArg(args)

def isKit(f: String, funs: Ftab): Bool =
  Kits.hasTab(funs.kits, f)

def kitOf(funs: Ftab, f: String): KitSig =
  Kits.findTab(funs.kits, f)

def kitRow(funs: Ftab, f: String): Kit =
  kitOf(funs, f).kit

def kitParams(f: String, funs: Ftab): List[String] =
  Kits.kitParamsOf(kitRow(funs, f))

def kitNames(): List[String] =
  names()

def kitRet(f: String, funs: Ftab): String =
  Kits.kitRetOf(kitRow(funs, f))

def isNetTlsFiles(f: String): Bool =
  f == "Net.serveTlsFiles" || f == "Net.serveOnceTlsFiles"

def isNetServe(f: String): Bool =
  f == "Net.serve" || f == "Net.serveOnce" || f == "Net.serveTls" || f == "Net.serveOnceTls" || isNetTlsFiles(f)

def isArith(op: String): Bool =
  op == "+" || op == "-" || op == "*" || op == "/" || op == "%"

def isEq(op: String): Bool =
  op == "==" || op == "!="

def isOrd(op: String): Bool =
  op == "<" || op == "<=" || op == ">" || op == ">="

def isLogic(op: String): Bool =
  op == "&&" || op == "||"

def isBit(op: String): Bool =
  op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>"

def firstArgErr(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  if (List.isEmpty(args)) ok("") else firstArgErr2(infer(stripNamed(List.at(args, 0)), env, funs, ens), List.tail(args), env, funs, ens)

def firstArgErr2(o: Out, rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  if (hasErr(o)) o else firstArgErr(rest, env, funs, ens)

def zipCheck(callee: String, want: List[Ty], args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), acc: Ty): Out =
  if (List.isEmpty(want)) okTy(acc) else zipCheckHd(callee, List.at(want, 0), List.tail(want), args, env, funs, ens, span, acc)

def zipCheckHd(callee: String, w: Ty, want: List[Ty], args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), acc: Ty): Out =
  zipCheckArg(callee, w, want, List.at(args, 0), List.tail(args), env, funs, ens, span, acc)

def zipCheckArg(callee: String, w: Ty, want: List[Ty], arg: Expr, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), acc: Ty): Out =
  zipCheckGo(callee, w, want, arg, args, env, funs, ens, span, acc, spanPick(exprSpan(env, stripNamed(arg)), span))

def zipCheckGo(callee: String, w: Ty, want: List[Ty], arg: Expr, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), acc: Ty, asp: (String, Int)): Out =
  if (List.isEmpty(args)) zipCheckLast(inferExpectedTy(stripNamed(arg), w, env, funs, ens), callee, w, asp, acc, ens) else zipCheck2(callee, w, inferExpectedTy(stripNamed(arg), w, env, funs, ens), want, args, env, funs, ens, span, acc, asp)

def zipCheckLast(o: Out, callee: String, w: Ty, span: (String, Int), acc: Ty, ens: List[En]): Out =
  if (hasErr(o)) o else if (tyEq(o.ty, w, ens)) retTy(bindOrigin(o, o.origin, o.ty, w, ens, span), zipAcc(acc, o)) else argMismatch(callee, Type.show(w), tyStr(o), span)

def zipCheck2(callee: String, w: Ty, o: Out, want: List[Ty], args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), acc: Ty, asp: (String, Int)): Out =
  if (hasErr(o)) o else zipCheckEq(callee, w, o, want, args, env, funs, ens, span, acc, asp)

def zipCheckEq(callee: String, w: Ty, o: Out, want: List[Ty], args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), acc: Ty, asp: (String, Int)): Out =
  if (tyEq(o.ty, w, ens)) zipCheckBound(bindOrigin(o, o.origin, o.ty, w, ens, asp), callee, kitWantFromTy(callee, zipAcc(acc, o), want), args, env, funs, ens, span, zipAcc(acc, o)) else argMismatch(callee, Type.show(w), tyStr(o), asp)

def zipCheckBound(o: Out, callee: String, want: List[Ty], args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), acc: Ty): Out =
  if (hasErr(o)) o else andBinds(o, zipCheck(callee, want, args, env, funs, ens, span, acc))

def zipAcc(acc: Ty, o: Out): Ty =
  if (Type.isEmpty(acc)) o.ty else acc

def kitWantFromTy(f: String, handle: Ty, want: List[Ty]): List[Ty] =
  if (List.isEmpty(want)) want else if (f == "Queue.offer" || f == "Deferred.complete") offerElemTy(handle) :: List.tail(want) else want

def offerElemTy(handle: Ty): Ty =
  if (Type.appName(handle) == "Queue" || Type.appName(handle) == "Deferred") Type.elem(handle) else Type.tParam("A")

def argMismatch(callee: String, w: String, got: String, span: (String, Int)): Out =
  bad(argMismatchMsg(argMismatchWant(callee, w), got), span)

def argMismatchWant(callee: String, w: String): String =
  if (callee == "IO.println") "expected String, got " else Str.concat(callee, Str.concat(" arg type mismatch: expected ", Str.concat(w, ", got ")))

def argMismatchMsg(prefix: String, got: String): String =
  Str.concat(prefix, got)

def isListTy(t: String): Bool =
  t == "List" || Str.startsWith(t, "List[")

def enNames(ens: List[En]): List[String] =
  if (List.isEmpty(ens)) noStr() else enNamesHd(List.at(ens, 0), List.tail(ens))

def enNamesHd(h: En, rest: List[En]): List[String] =
  h match {
    case En(_, name, ts, _) => if (name == "#pin") List.concat(ts, enNames(rest)) else []
  }

def letterEns(ens: List[En]): List[String] =
  if (List.isEmpty(ens)) [] else letterEnsHd(List.at(ens, 0), List.tail(ens))

def letterEnsHd(h: En, rest: List[En]): List[String] =
  h match {
    case En(_, name, _, _) => if (isTyParam(name)) name :: letterEns(rest) else letterEns(rest)
  }

def withLetterPins(ens: List[En]): List[En] =
  pinEns(ens, letterEns(ens))

def tyEq(a: Ty, b: Ty, ens: List[En]): Bool =
  Type.eqPinnedTy(a, b, enNames(ens))

def tyEqEn(a: String, b: String, ens: List[En]): Bool =
  tyEq(Type.parse(a), Type.parse(b), ens)

def pinEns(ens: List[En], ts: List[String]): List[En] =
  if (List.isEmpty(ts)) ens else En(false, "#pin", ts, noCase()) :: ens

def noCase(): List[EnCase] =
  []

def preferTy(a: Ty, b: Ty, ens: List[En]): Ty =
  Type.preferPinnedTy(a, b, enNames(ens))

def preferEn(a: String, b: String, ens: List[En]): String =
  Type.show(preferTy(Type.parse(a), Type.parse(b), ens))

def prefer(a: String, b: String): String =
  preferStr(a, b)

def isLoose(t: String): Bool =
  isTyParam(t)

def isLooseTy(t: Ty, ens: List[En]): Bool =
  t match {
    case Ty.TVar(n) => !nameIn(enNames(ens), n)
    case Ty.Named(n) => isTyParam(n) && !nameIn(enNames(ens), n)
    case _ => false
  }

def isLooseEn(t: String, ens: List[En]): Bool =
  isLooseTy(Type.parse(t), ens)

def nameIn(ns: List[String], n: String): Bool =
  if (List.isEmpty(ns)) false else if (List.at(ns, 0) == n) true else nameIn(List.tail(ns), n)

def funArgOf(t: String): String =
  Type.funArgStr(t)

def isTup(t: String): Bool =
  Type.isTupStr(t)

def checkKnown(f: String, want: List[String], ret: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  checkKnownTy(f, Kits.parseTys(want), Type.parse(ret), args, env, funs, ens, span)

def checkKnownTy(f: String, want: List[Ty], ret: Ty, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (List.len(want) != List.len(args)) bad(Str.concat(f, Str.concat(" expects ", Str.concat(Str.fromInt(List.len(want)), Str.concat(" args, got ", Str.fromInt(List.len(args)))))), span) else checkKnownRet(f, zipCheck(f, want, args, env, funs, ens, span, Type.tNamed("")), ret)

def checkKnownRet(f: String, o: Out, ret: Ty): Out =
  if (hasErr(o)) o else retTy(o, kitRetFromGot(f, o.ty, ret))

def kitRetFromGot(f: String, got: Ty, ret: Ty): Ty =
  if (f == "List.head") Type.tApp("Option", Type.elem(got) :: Type.noTy()) else if (f == "List.tail" || f == "List.reverse" || f == "List.last") kitRetListTy(got, ret) else if (f == "IO.pure") Type.tIo(Type.tStr(), got) else if (f == "IO.fail") Type.tIo(if (Type.isEmpty(got)) Type.tStr() else got, Type.tParam("A")) else if (f == "Deferred.get") handleGetRet(got, "Deferred") else if (f == "Queue.take") handleGetRet(got, "Queue") else substKitETy(ret, got)

def kitRetListTy(got: Ty, ret: Ty): Ty =
  if (Type.appName(got) == "List") got else ret

def handleGetRet(got: Ty, n: String): Ty =
  if (Type.appName(got) == n && !List.isEmpty(Type.appArgs(got))) Type.tIo(Type.tStr(), Type.elem(got)) else Type.tIo(Type.tStr(), Type.tParam("A"))

def substKitETy(ret: Ty, got: Ty): Ty =
  if (Type.isEmpty(got)) ret else Type.subst(ret, "E", got)

def resolveCall(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  resolveCall2(f, args, env, funs, ens, span)

def resolveCall2(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (isKit(f, funs)) resolveKit(f, args, env, funs, ens, span) else if (isInstMeth(f)) resolveInst(f, args, env, funs, ens, span) else if (hasEn(ens, f)) inferNamedCtor(f, f, args, env, funs, ens, span, ens) else if (enOfCase(ens, f) != "") inferNamedCtor(enOfCase(ens, f), f, args, env, funs, ens, span, ens) else resolveFunOrUser(f, args, env, funs, ens, span, lookupEnv(env, f))

def resolveKit(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (isGenericKit(f)) resolveGenericKit(f, args, env, funs, ens, span) else resolveKitRest(f, args, env, funs, ens, span)

def isGenericKit(f: String): Bool =
  f == "List.map" || f == "List.concat" || f == "List.cons" || f == "List.at" || f == "List.filter" || f == "List.filterNot" || f == "List.take" || f == "List.drop" || f == "List.takeWhile" || f == "List.dropWhile" || f == "List.takeRight" || f == "List.dropRight" || f == "List.flatten" || f == "List.flatMap" || f == "IO.attempt" || f == "IO.race" || f == "IO.both" || f == "IO.ensure" || f == "IO.timeout" || f == "IO.forever" || f == "IO.repeatN" || f == "IO.retryN" || f == "IO.foreach" || f == "IO.foreachDiscard" || f == "IO.when" || f == "IO.unless" || Str.startsWith(f, "Ref.") || Str.startsWith(f, "Fiber.") || Str.startsWith(f, "Map.") || Str.startsWith(f, "Set.") || f == "Stream.emit" || f == "Stream.emits" || f == "Stream.eval" || f == "Stream.concat" || f == "Stream.map" || f == "Stream.evalMap" || f == "Stream.filter" || f == "Stream.filterNot" || f == "Stream.take" || f == "Stream.drop" || f == "Stream.takeWhile" || f == "Stream.dropWhile" || f == "Stream.repeatN" || f == "Stream.compileToList" || f == "Stream.head" || f == "Stream.last" || f == "Stream.flatten" || f == "Stream.flatMap" || f == "Stream.mapConcat" || f == "Stream.grouped" || f == "Stream.sliding" || f == "List.foldLeft" || f == "List.foldRight" || f == "List.scanLeft" || f == "List.scanRight" || f == "List.reduceLeft" || f == "List.reduceRight" || f == "Stream.fold" || f == "Stream.scan" || f == "List.zip" || f == "List.zipAll" || f == "List.unzip" || f == "List.zipWithIndex" || f == "Stream.zip" || f == "Stream.zipAll" || f == "Stream.zipWithIndex" || f == "Stream.iterate" || f == "Stream.unfold" || f == "List.fill" || f == "List.tabulate" || f == "List.append" || f == "List.grouped" || f == "List.sliding" || f == "List.intersperse" || f == "List.interleave" || f == "List.getOrElse" || f == "Stream.zipWith" || f == "List.init" || f == "List.distinct" || f == "List.toSet" || f == "List.padTo" || f == "List.contains" || f == "List.groupBy" || f == "Stream.interleave" || f == "Stream.takeRight" || f == "Stream.dropRight" || f == "Stream.evalTap" || f == "Stream.find" || f == "Stream.findLast" || f == "Stream.orElse" || f == "Stream.intersperse" || f == "List.inits" || f == "List.tails" || f == "List.sort" || f == "List.sortBy" || f == "List.distinctBy" || f == "List.max" || f == "List.min" || f == "List.maxBy" || f == "List.minBy" || f == "List.toMap" || f == "List.diff" || f == "List.intersect" || f == "List.setAt" || f == "List.indexOf" || f == "List.lastIndexOf" || f == "List.span" || f == "List.partition" || f == "List.transpose" || f == "List.splitAt" || f == "List.slice" || f == "List.patch" || f == "List.indexOfSlice" || f == "List.lastIndexOfSlice" || f == "List.startsWith" || f == "List.endsWith" || f == "List.sameElements" || f == "Stream.changes" || f == "Stream.exists" || f == "Stream.forall" || f == "Stream.none" || f == "List.find" || f == "List.findLast" || f == "List.exists" || f == "List.forall" || f == "List.count" || f == "List.indexWhere" || f == "List.lastIndexWhere" || f == "List.prefixLength" || f == "List.segmentLength" || f == "Property.force"

def resolveGenericKit(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  resolveGenericKitSig(f, args, env, funs, ens, span, kitOf(funs, f))

def resolveGenericKitSig(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), kit: KitSig): Out =
  if (List.isEmpty(args)) ok(funTyFrom(Kits.kitParamsOf(kit.kit), Kits.kitRetOf(kit.kit))) else if (List.len(args) != List.len(kit.params)) bad(Str.concat(f, " has wrong arity"), span) else genericArgsTy(f, ["A", "B", "E", "S", "C"], kit.params, kit.ret, args, env, funs, ens, span)

def resolveKitRest(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (f == "Scenario.context") resolveScenarioCtx(funs, span) else if (Str.startsWith(f, "Signal.")) resolveGenericKit(f, args, env, funs, ens, span) else if (f == "Resource.make" || f == "Resource.use") resolveResource(f, args, env, funs, ens, span) else if (isNetServe(f)) resolveNetServe(f, args, env, funs, ens, span) else if (f == "View.each") resolveViewEach(args, env, funs, ens, span) else if (f == "Property.check") resolvePropCheck(args, env, funs, ens, span) else resolveKnownKit(f, args, env, funs, ens, span, kitOf(funs, f))

def resolveScenarioCtx(funs: Ftab, span: (String, Int)): Out =
  resolveScenarioCtx2(ftabGet(funs.tab, "setup"), span)

def resolveScenarioCtx2(hit: List[Fun], span: (String, Int)): Out =
  if (List.isEmpty(hit)) bad("Scenario.context needs a setup entrypoint", span) else resolveScenarioCtx3(List.at(hit, 0), span)

def resolveScenarioCtx3(d: Fun, span: (String, Int)): Out =
  if (!isIo(d.ret)) bad("setup must return IO", span) else ok(ioOk(d.ret))

def resolveKnownKit(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), kit: KitSig): Out =
  if (List.isEmpty(args) && !List.isEmpty(kit.params)) ok(funTyFrom(Kits.kitParamsOf(kit.kit), Kits.kitRetOf(kit.kit))) else if (!Kits.arityOf(kit.kit, List.len(args))) bad(Str.concat(f, Str.concat(" expects ", Str.concat(Str.fromInt(List.len(Kits.kitParamsOf(kit.kit))), Str.concat(" args, got ", Str.fromInt(List.len(args)))))), span) else checkKnownTy(f, Kits.wantOfSig(kit, List.len(args)), kit.ret, args, env, funs, ens, span)

def enOfCase(ens: List[En], ctor: String): String =
  if (List.isEmpty(ens)) "" else enOfCase1(List.at(ens, 0), List.tail(ens), ctor)

def enOfCase1(h: En, rest: List[En], ctor: String): String =
  h match {
    case En(_, name, _, cases) => if (hasCase(cases, ctor)) name else enOfCase(rest, ctor)
  }

def hasCase(cs: List[EnCase], ctor: String): Bool =
  if (List.isEmpty(cs)) false else hasCase1(List.at(cs, 0), List.tail(cs), ctor)

def hasCase1(c: EnCase, rest: List[EnCase], ctor: String): Bool =
  c match {
    case EnCase(name, _) => name == ctor || hasCase(rest, ctor)
  }

def isInstMeth(f: String): Bool =
  Str.startsWith(f, ".") && f != ".apply"

def resolveInst(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(args)) bad(Str.concat("unknown function ", f), span) else resolveInst2(f, infer(stripNamed(List.at(args, 0)), env, funs, ens), args, env, funs, ens, span)

def resolveInst2(f: String, recv: Out, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (hasErr(recv)) recv else resolveInst3(f, recv.ty, args, env, funs, ens, span, ftabGetMod(funs.tab, tyHead(recv.ty), Str.slice(f, 1, Str.len(f))))

def resolveInst3(f: String, ty: Ty, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), hit: List[Fun]): Out =
  if (!List.isEmpty(hit)) resolveUser(f, args, env, funs, ens, span, hit) else resolveInstKit(f, ty, args, env, funs, ens, span)

def kitNs(ty: Ty): String =
  kitNsH(tyHead(ty))

def kitNsH(h: String): String =
  if (h == "String") "Str" else h

def resolveInstKit(f: String, ty: Ty, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  resolveInstKit2(f, ty, args, env, funs, ens, span, Str.concat(kitNs(ty), Str.concat(".", Str.slice(f, 1, Str.len(f)))))

def resolveInstKit2(f: String, ty: Ty, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), q: String): Out =
  if (isKit(q, funs)) resolveKit(q, args, env, funs, ens, span) else resolveInstCopy(f, ty, args, env, funs, ens, span)

def resolveInstCopy(f: String, ty: Ty, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (f == ".copy") resolveInstArgs(List.tail(args), env, funs, ens, ok(Type.show(ty))) else resolveInstNamed(f, Type.show(ty), args, env, funs, ens, span, ftabGet(funs.tab, Str.slice(f, 1, Str.len(f))))

def resolveInstNamed(f: String, ty: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), hit: List[Fun]): Out =
  if (List.isEmpty(hit)) bad(Str.concat("unknown function ", f), span) else resolveInstHit(f, ty, args, env, funs, ens, span, List.at(hit, 0))

def resolveInstHit(f: String, ty: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), d: Fun): Out =
  d match {
    case Fun(_, _, _, _, ps, ret, _, _, _) => checkKnown(f, instWant(ps, ty), ret, args, env, funs, ens, span)
  }

def instWant(ps: List[Param], recvTy: String): List[String] =
  if (hasSelfParam(ps)) paramTys(ps) else recvTy :: paramTys(ps)

def hasSelfParam(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) false else hasSelfParam1(List.at(ps, 0))

def hasSelfParam1(p: Param): Bool =
  p match {
    case Param(n, _, _, _) => n == "self"
  }

def resolveInstArgs(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], o: Out): Out =
  if (hasErr(o)) o else if (List.isEmpty(args)) o else resolveInstArgsGo(infer(stripNamed(List.at(args, 0)), env, funs, ens), List.tail(args), env, funs, ens, o)

def resolveInstArgsGo(h: Out, rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], o: Out): Out =
  if (hasErr(h)) h else resolveInstArgs(rest, env, funs, ens, o)

def tyHead(t: Ty): String =
  Type.headName(t)

def resourceKitRet(f: String): String =
  if (f == "Resource.make") "Resource" else if (f == "Resource.use") "IO[A]" else deferredKitRet(f)

def deferredKitRet(f: String): String =
  if (f == "Deferred.empty") "IO[Deferred]" else if (f == "Deferred.get") "IO[A]" else if (f == "Deferred.complete" || f == "Deferred.fail") "IO[Unit]" else queueKitRet(f)

def queueKitRet(f: String): String =
  if (f == "Queue.unbounded") "IO[Queue]" else if (f == "Queue.take") "IO[A]" else if (f == "Queue.offer") "IO[Unit]" else "A"

def resolveResource(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(args)) ok(funTyFrom(kitParams(f, funs), resourceKitRet(f))) else if (List.len(args) != 2) bad(Str.concat(f, Str.concat(" expects 2 args, got ", Str.fromInt(List.len(args)))), span) else resolveResource2(f, infer(stripNamed(List.at(args, 0)), env, funs, ens), List.at(args, 1), env, funs, ens, span)

def resolveResource2(f: String, ao: Out, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (hasErr(ao)) ao else if (f == "Resource.make") resolveResMake(ao, lam, env, funs, ens, span) else resolveResUse(ao, lam, env, funs, ens, span)

def isRes(t: String): Bool =
  Type.isResStr(t)

def resTy(a: String, ens: List[En]): String =
  if (a == "" || isLooseEn(a, ens)) "Resource" else Str.concat("Resource[", Str.concat(a, "]"))

def resPayload(t: String): String =
  if (isRes(t) && brackAt(t, 0) >= 0) elemOf(t) else "A"

def bindRes(p: String, ty: String, env: List[(String, Ty)]): List[(String, Ty)] =
  envBind(p, ty, env)

def resolveResMake(ao: Out, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (isIo(tyStr(ao)) || isLooseEn(tyStr(ao), ens)) resolveResLam(tyStr(ao), ioPayload(tyStr(ao)), lam, env, funs, ens, span, resTy(ioPayload(tyStr(ao)), ens)) else bad(Str.concat("Resource.make needs IO, got ", tyStr(ao)), span)

def resolveResUse(ao: Out, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (isRes(tyStr(ao)) || isLooseEn(tyStr(ao), ens)) resolveResLam(tyStr(ao), resPayload(tyStr(ao)), lam, env, funs, ens, span, "") else bad(Str.concat("Resource.use needs Resource, got ", tyStr(ao)), span)

def resolveResLam(recv: String, bind: String, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), makeRet: String): Out =
  lam match {
    case Expr.ELam(p, ty, body) => resolveResAnn(annOk(ty, bind, span, ens), recv, p, body, env, funs, ens, span, makeRet)
    case Expr.ENamed(_, inner) => resolveResLam(recv, bind, inner, env, funs, ens, span, makeRet)
    case _ => bad(Str.concat(if (makeRet == "") "Resource.use" else "Resource.make", " needs a lambda"), span)
  }

def resolveResAnn(a: Out, recv: String, p: String, body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), makeRet: String): Out =
  if (hasErr(a)) a else resolveResBody(recv, infer(body, bindRes(p, bindOfAnn(a), env), funs, ens), span, makeRet, ens)

def bindOfAnn(a: Out): String =
  tyStr(a)

def resolveResBody(recv: String, body: Out, span: (String, Int), makeRet: String, ens: List[En]): Out =
  if (hasErr(body)) body else if (isIo(tyStr(body)) || isLooseEn(tyStr(body), ens)) ok(if (makeRet != "") makeRet else if (isIo(tyStr(body))) tyStr(body) else "IO[A]") else bad(Str.concat(if (makeRet == "") "Resource.use" else "Resource.make", Str.concat(" needs IO, got ", Str.concat(recv, Str.concat(" and ", tyStr(body))))), span)

def netReqTy(): String =
  "(String, String, Map[String, String], String)"

def netRespTy(): String =
  "(Int, Map[String, String], String)"

def isIoHttpResp(t: String, ens: List[En]): Bool =
  isIo(t) && tyEqEn(ioOk(t), netRespTy(), ens)

def netFunOk(ty: String, ens: List[En]): Bool =
  isFunTy(ty) && tyEqEn(funArgOf(ty), netReqTy(), ens) && isIoHttpResp(funRetOf(ty), ens)

def resolveNetServe(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(args)) ok(funTyFrom(kitParams(f, funs), kitRet(f, funs))) else if (isNetTlsFiles(f)) resolveNetFiles(f, args, env, funs, ens, span) else if (List.len(args) != 2) bad(Str.concat(f, Str.concat(" expects 2 args, got ", Str.fromInt(List.len(args)))), span) else resolveNetServe2(f, infer(stripNamed(List.at(args, 0)), env, funs, ens), List.at(args, 1), env, funs, ens, span)

def resolveNetFiles(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (List.len(args) != 4) bad(Str.concat(f, Str.concat(" expects 4 args, got ", Str.fromInt(List.len(args)))), span) else resolveNetFilesPort(f, infer(stripNamed(List.at(args, 0)), env, funs, ens), List.tail(args), env, funs, ens, span)

def resolveNetFilesPort(f: String, po: Out, rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (hasErr(po)) po else if (tyEqEn(tyStr(po), "Int", ens)) resolveNetFilesStr(f, "cert", infer(stripNamed(List.at(rest, 0)), env, funs, ens), List.tail(rest), env, funs, ens, span) else argMismatch(f, "Int", tyStr(po), span)

def resolveNetFilesStr(f: String, what: String, so: Out, rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (hasErr(so)) so else if (tyEqEn(tyStr(so), "String", ens)) resolveNetFilesNext(f, what, rest, env, funs, ens, span) else argMismatch(f, "String", tyStr(so), span)

def resolveNetFilesNext(f: String, what: String, rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (what == "cert") resolveNetFilesStr(f, "key", infer(stripNamed(List.at(rest, 0)), env, funs, ens), List.tail(rest), env, funs, ens, span) else resolveNetLam(f, List.at(rest, 0), env, funs, ens, span)

def resolveNetServe2(f: String, po: Out, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (hasErr(po)) po else if (tyEqEn(tyStr(po), "Int", ens)) resolveNetLam(f, lam, env, funs, ens, span) else argMismatch(f, "Int", tyStr(po), span)

def resolveNetLam(f: String, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  lam match {
    case Expr.ELam(p, ty, body) => resolveNetAnn(annOk(ty, netReqTy(), span, ens), f, p, body, env, funs, ens, span)
    case Expr.ENamed(_, inner) => resolveNetLam(f, inner, env, funs, ens, span)
    case Expr.EAscribe(inner, _, _) => resolveNetLam(f, inner, env, funs, ens, span)
    case _ => resolveNetFun(f, infer(stripNamed(lam), env, funs, ens), span, ens)
  }

def resolveNetAnn(a: Out, f: String, p: String, body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (hasErr(a)) a else resolveNetBody(f, infer(body, bindRes(p, bindOfAnn(a), env), funs, ens), span, ens)

def resolveNetBody(f: String, body: Out, span: (String, Int), ens: List[En]): Out =
  if (hasErr(body)) body else if (isIoHttpResp(tyStr(body), ens) || isLooseEn(tyStr(body), ens)) ok("IO[Unit]") else bad(Str.concat(f, Str.concat(" needs IO[(Int, Map[String, String], String)], got ", tyStr(body))), span)

def resolveNetFun(f: String, o: Out, span: (String, Int), ens: List[En]): Out =
  if (hasErr(o)) o else if (netFunOk(tyStr(o), ens)) ok("IO[Unit]") else bad(Str.concat(f, " needs a lambda"), span)

def isListHead(t: Ty): Bool =
  Type.isNamed(t, "List") || Type.isAppNamed(t, "List")

def isSigList(t: Ty): Bool =
  Type.isAppNamed(t, "Signal") && isListHead(Type.elem(t))

def eachElemOf(t: Ty): String =
  Type.show(Type.elem(Type.elem(t)))

def resolveViewEach(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(args)) ok(funTyFrom(kitParams("View.each", funs), kitRet("View.each", funs))) else resolveViewEach2(infer(stripNamed(List.at(args, 0)), env, funs, ens), List.tail(args), env, funs, ens, span)

def resolveViewEach2(src: Out, rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (hasErr(src)) src else if (!isSigList(src.ty)) argMismatch("View.each", "Signal[List[A]]", tyStr(src), span) else if (List.len(rest) > 1) bad("View.each has wrong arity", span) else if (List.isEmpty(rest)) ok("View") else resolveViewEachLam(src.ty, List.at(rest, 0), env, funs, ens, span)

def resolveViewEachLam(sigTy: Ty, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  lam match {
    case Expr.ELam(p, ty, body) => resolveViewEachAnn(annOk(ty, eachElemOf(sigTy), span, ens), p, body, env, funs, ens, span)
    case Expr.ENamed(_, inner) => resolveViewEachLam(sigTy, inner, env, funs, ens, span)
    case Expr.EAscribe(inner, _, _) => resolveViewEachLam(sigTy, inner, env, funs, ens, span)
    case _ => resolveViewEachFun(infer(stripNamed(lam), env, funs, ens), eachElemOf(sigTy), span, ens)
  }

def resolveViewEachAnn(a: Out, p: String, body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (hasErr(a)) a else resolveViewEachBody(infer(body, bindRes(p, bindOfAnn(a), env), funs, ens), span, ens)

def resolveViewEachFun(o: Out, elem: String, span: (String, Int), ens: List[En]): Out =
  if (hasErr(o)) o else if (Type.isFun(o.ty) && tyEqEn(Type.show(Type.funArg(o.ty)), elem, ens) && (tyEqEn(Type.show(Type.funRet(o.ty)), "View", ens) || isLooseEn(Type.show(Type.funRet(o.ty)), ens))) ok("View") else bad("View.each needs A => View", span)

def resolveViewEachBody(body: Out, span: (String, Int), ens: List[En]): Out =
  if (hasErr(body)) body else if (tyEqEn(tyStr(body), "View", ens) || isLooseEn(tyStr(body), ens)) ok("View") else bad(Str.concat("View.each needs View, got ", tyStr(body)), span)

def resolvePropCheck(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (List.len(args) != 3) bad(Str.concat("Property.check expects 3 args, got ", Str.fromInt(List.len(args))), span) else resolvePropCheckName(infer(stripNamed(List.at(args, 0)), env, funs, ens), List.tail(args), env, funs, ens, span)

def resolvePropCheckName(name: Out, rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (hasErr(name)) name else if (tyEqEn(tyStr(name), "String", ens) || isLooseEn(tyStr(name), ens)) resolvePropCheckPred(infer(stripNamed(List.at(rest, 0)), env, funs, ens), List.tail(rest), env, funs, ens, span) else argMismatch("Property.check", "String", tyStr(name), span)

def resolvePropCheckPred(pred: Out, rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (hasErr(pred)) pred else if (requirePredOk(tyStr(pred), ens)) resolvePropCheckVal(infer(stripNamed(List.at(rest, 0)), env, funs, ens), span) else argMismatch("Property.check", "Bool", tyStr(pred), span)

def resolvePropCheckVal(val: Out, span: (String, Int)): Out =
  if (hasErr(val)) val else okTy(val.ty)

def resolveFunOrUser(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), ty: Ty): Out =
  if (Type.isFun(ty)) inferFunApply(ty, args, env, funs, ens, span) else resolveUser(f, args, env, funs, ens, span, findFunPrefer(funs, f, env))

def inferFunApply(ty: Ty, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(args)) bad("apply expects 1 arg", span) else if (List.len(args) == 1) inferFunApply1(ty, infer(List.at(args, 0), env, funs, ens), spanPick(exprSpan(env, List.at(args, 0)), span), ens) else inferFunApply1(ty, inferTuple(args, env, funs, ens), span, ens)

def inferFunApply1(ty: Ty, o: Out, span: (String, Int), ens: List[En]): Out =
  if (hasErr(o)) o else if (Type.isParam(Type.funArg(ty)) && !isLoose(tyStr(o))) bad("lambda parameter type is unresolved; annotate the parameter", span) else if (tyEq(o.ty, Type.funArg(ty), ens)) retTy(bindOrigin(o, o.origin, o.ty, Type.funArg(ty), ens, span), Type.funRet(ty)) else argMismatch("apply", Type.show(Type.funArg(ty)), tyStr(o), span)

def elemOf(t: String): String =
  elemOf2(brackAt(t, 0), t)

def brackAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 91) i else brackAt(s, i + 1)

def elemOf2(b: Int, t: String): String =
  if (b < 0) "A" else Str.slice(t, b + 1, Str.len(t) - 1)

def resolveUser(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), hit: List[Fun]): Out =
  if (List.isEmpty(hit)) bad(Str.concat("unknown function ", f), span) else resolveUserHit(f, args, env, funs, ens, span, List.at(hit, 0))

def resolveUserHit(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), d: Fun): Out =
  d match {
    case Fun(_, _, _, ts, ps, ret, _, _, _) => if (List.isEmpty(ts)) checkUser(f, ps, ret, args, env, funs, ens, span) else checkGeneric(f, ts, ps, ret, args, env, funs, ens, span, alignCall(ps, args))
  }

def checkGeneric(f: String, ts: List[String], ps: List[Param], ret: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), aligned: (List[Expr], String)): Out =
  if (aligned._2 != "") bad(alignErr(f, aligned._2, ps, args), span) else genericArgs(f, ts, paramTys(ps), ret, aligned._1, env, funs, ens, span)

def genericArgs(f: String, ts: List[String], want: List[String], ret: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  genericArgsTy(f, ts, Kits.parseTys(want), Type.parse(ret), args, env, funs, ens, span)

def genericArgsTy(f: String, ts: List[String], want: List[Ty], ret: Ty, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(args)) okTy(ret) else genericArgTy(f, ts, want, ret, args, env, funs, ens, span, inferExpectedTy(stripNamed(List.at(args, 0)), List.at(want, 0), env, funs, ens))

def inferExpected(e: Expr, want: String, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  e match {
    case Expr.ELam(p, ann, body) => if (isFunTy(want)) inferExpectedLam(p, ann, body, Type.show(Type.funArg(Type.parse(want))), env, funs, ens, e) else infer(e, env, funs, ens)
    case _ => infer(e, env, funs, ens)
  }

def inferExpectedTy(e: Expr, want: Ty, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  e match {
    case Expr.ELam(p, ann, body) => if (Type.isFun(want)) inferExpectedLam(p, ann, body, Type.show(Type.funArg(want)), env, funs, ens, e) else infer(e, env, funs, ens)
    case _ => infer(e, env, funs, ens)
  }

def inferExpectedLam(p: String, ann: String, body: Expr, arg: String, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (ann != "" && !tyEqEn(ann, arg, ens)) argMismatch("lambda", arg, ann, exprSpan(env, e)) else expectedLamBody(if (ann == "") arg else ann, infer(body, bindLam(p, if (ann == "") arg else ann, env), funs, ens))

def expectedLamBody(arg: String, body: Out): Out =
  if (hasErr(body)) body else okTy(Type.tFun(Type.parse(arg), body.ty))

def genericArgTy(f: String, ts: List[String], want: List[Ty], ret: Ty, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), got: Out): Out =
  if (hasErr(got)) got else andBinds(got, genericBoundTy(f, ts, want, ret, args, env, funs, ens, span, got.ty, Type.bindings(List.at(want, 0), got.ty, ts)))

def genericBoundTy(f: String, ts: List[String], want: List[Ty], ret: Ty, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), got: Ty, bindings: List[(String, Ty)]): Out =
  genericBoundEq(f, ts, want, ret, args, env, funs, ens, span, got, bindings, applyBindingsTy(List.at(want, 0), bindings))

def genericBoundEq(f: String, ts: List[String], want: List[Ty], ret: Ty, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), got: Ty, bindings: List[(String, Ty)], w: Ty): Out =
  if (!Type.eqPinGotTy(w, got, enNames(ens))) argMismatch(f, Type.show(w), Type.show(got), span) else genericArgsTy(f, ts, bindWantTy(List.tail(want), bindings), applyBindingsTy(ret, bindings), List.tail(args), env, funs, ens, span)

def applyBindingsTy(ty: Ty, bindings: List[(String, Ty)]): Ty =
  if (List.isEmpty(bindings)) ty else applyBindingsTy(Type.subst(ty, List.at(bindings, 0)._1, List.at(bindings, 0)._2), List.tail(bindings))

def bindWantTy(want: List[Ty], bindings: List[(String, Ty)]): List[Ty] =
  if (List.isEmpty(want)) want else applyBindingsTy(List.at(want, 0), bindings) :: bindWantTy(List.tail(want), bindings)

def checkUser(f: String, ps: List[Param], ret: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  checkUserAl(f, ps, ret, args, env, funs, ens, span, alignCall(ps, args))

def checkUserAl(f: String, ps: List[Param], ret: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), al: (List[Expr], String)): Out =
  al match {
    case (xs, err) => if (err != "") bad(alignErr(f, err, ps, args), span) else checkKnown(f, paramTys(ps), ret, xs, env, funs, ens, span)
  }

def inferCall(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  resolveCall(f, args, env, funs, ens, span)

def inferPrint(inner: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  inferPrint2(infer(inner, env, funs, ens), env, inner, e, ens)

def inferPrint2(o: Out, env: List[(String, Ty)], inner: Expr, e: Expr, ens: List[En]): Out =
  if (hasErr(o)) o else if (Type.isStr(o.ty) || isLooseTy(o.ty, ens)) ret(bindLoose(o, Type.tStr(), ens, spanPick(exprSpan(env, inner), exprSpan(env, e))), "IO[Unit]") else bad(Str.concat("expected String, got ", tyStr(o)), spanPick(exprSpan(env, inner), exprSpan(env, e)))

def inferBin(op: String, l: Expr, r: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  inferBin2(op, infer(l, env, funs, ens), r, env, funs, ens, e)

def inferBin2(op: String, lo: Out, r: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (hasErr(lo)) lo else inferBin3(op, lo, infer(r, env, funs, ens), env, ens, e)

def inferBin3(op: String, lo: Out, ro: Out, env: List[(String, Ty)], ens: List[En], e: Expr): Out =
  if (hasErr(ro)) ro else inferBinJoin(op, lo, ro, exprSpan(env, e), ens)

def inferBinJoin(op: String, lo: Out, ro: Out, span: (String, Int), ens: List[En]): Out =
  inferBin4(op, lo, ro, span, ens, andBinds(lo, ro))

def inferBin4(op: String, lo: Out, ro: Out, span: (String, Int), ens: List[En], base: Out): Out =
  if (hasErr(base)) base else if (isArith(op)) inferArith(lo, ro, span, ens, base) else if (isEq(op)) inferEq(lo, ro, span, ens, base) else if (isOrd(op)) inferOrd(lo, ro, span, ens, base) else if (isLogic(op)) inferLogic(lo, ro, span, ens, base) else if (isBit(op)) inferBit(tyStr(lo), tyStr(ro), span, base) else if (op == "::") ret(base, Str.concat("List[", Str.concat(tyStr(lo), "]"))) else ret(base, tyStr(lo))

def numConcrete(lo: Out, ro: Out): Ty =
  if (Type.isFloat(lo.ty) || Type.isFloat(ro.ty)) Type.tFloat() else Type.tInt()

def inferArith(lo: Out, ro: Out, span: (String, Int), ens: List[En], base: Out): Out =
  if (numTy(tyStr(lo), ens) && numTy(tyStr(ro), ens)) ret(bindOrigin(bindOrigin(base, lo.origin, lo.ty, numConcrete(lo, ro), ens, span), ro.origin, ro.ty, numConcrete(lo, ro), ens, span), Type.show(numConcrete(lo, ro))) else bad(Str.concat("arithmetic needs Int or Float, got ", Str.concat(tyStr(lo), Str.concat(" and ", tyStr(ro)))), span)

def numTy(t: String, ens: List[En]): Bool =
  t == "Int" || t == "Float" || isLooseEn(t, ens)

def inferEq(lo: Out, ro: Out, span: (String, Int), ens: List[En], base: Out): Out =
  if (tyEq(lo.ty, ro.ty, ens)) ret(bindOrigin(bindOrigin(base, lo.origin, lo.ty, ro.ty, ens, span), ro.origin, ro.ty, lo.ty, ens, span), "Bool") else bad(Str.concat("comparison type mismatch ", Str.concat(tyStr(lo), Str.concat(" vs ", tyStr(ro)))), span)

def inferOrd(lo: Out, ro: Out, span: (String, Int), ens: List[En], base: Out): Out =
  if (numTy(tyStr(lo), ens) && numTy(tyStr(ro), ens)) ret(bindOrigin(bindOrigin(base, lo.origin, lo.ty, numConcrete(lo, ro), ens, span), ro.origin, ro.ty, numConcrete(lo, ro), ens, span), "Bool") else bad("ordered compare needs Int or Float", span)

def inferLogic(lo: Out, ro: Out, span: (String, Int), ens: List[En], base: Out): Out =
  if (logicTy(tyStr(lo), ens) && logicTy(tyStr(ro), ens)) ret(bindOrigin(bindOrigin(base, lo.origin, lo.ty, Type.tBool(), ens, span), ro.origin, ro.ty, Type.tBool(), ens, span), "Bool") else bad(Str.concat("logic needs Bool, got ", Str.concat(tyStr(lo), Str.concat(" and ", tyStr(ro)))), span)

def logicTy(t: String, ens: List[En]): Bool =
  t == "Bool" || isLooseEn(t, ens)

def inferBit(lt: String, rt: String, span: (String, Int), base: Out): Out =
  if (lt == "Int" && rt == "Int") ret(base, "Int") else bad(Str.concat("bitwise needs Int, got ", Str.concat(lt, Str.concat(" and ", rt))), span)

def inferUn(op: String, inner: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  inferUn2(op, infer(inner, env, funs, ens), env, ens, e)

def inferUn2(op: String, o: Out, env: List[(String, Ty)], ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (op == "!") inferUnBool(o, env, ens, e) else if (op == "-") inferUnNum(o, env, ens, e) else inferUnInt(o, env, ens, e)

def inferUnNum(o: Out, env: List[(String, Ty)], ens: List[En], e: Expr): Out =
  if (Type.isInt(o.ty) || Type.isFloat(o.ty) || isLooseTy(o.ty, ens)) bindLoose(o, if (Type.isFloat(o.ty)) Type.tFloat() else Type.tInt(), ens, exprSpan(env, e)) else bad(Str.concat("expected Int or Float, got ", tyStr(o)), exprSpan(env, e))

def inferUnBool(o: Out, env: List[(String, Ty)], ens: List[En], e: Expr): Out =
  if (Type.isBool(o.ty) || isLooseTy(o.ty, ens)) retTy(bindLoose(o, Type.tBool(), ens, exprSpan(env, e)), Type.tBool()) else bad(Str.concat("expected Bool, got ", tyStr(o)), exprSpan(env, e))

def inferUnInt(o: Out, env: List[(String, Ty)], ens: List[En], e: Expr): Out =
  if (Type.isInt(o.ty) || isLooseTy(o.ty, ens)) retTy(bindLoose(o, Type.tInt(), ens, exprSpan(env, e)), Type.tInt()) else bad(Str.concat("expected Int, got ", tyStr(o)), exprSpan(env, e))

def inferIf(c: Expr, t: Expr, el: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  inferIf2(infer(c, env, funs, ens), t, el, env, funs, ens, e)

def inferIf2(co: Out, t: Expr, el: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (hasErr(co)) co else inferIf3(infer(t, env, funs, ens), el, env, funs, ens, e)

def inferIf3(to: Out, el: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (hasErr(to)) to else inferIf4(to, infer(el, env, funs, ens), env, ens, e)

def inferIf4(to: Out, eo: Out, env: List[(String, Ty)], ens: List[En], e: Expr): Out =
  if (hasErr(eo)) eo else if (tyEq(to.ty, eo.ty, ens)) retTy(bindOrigin(bindOrigin(andBinds(to, eo), to.origin, to.ty, eo.ty, ens, exprSpan(env, e)), eo.origin, eo.ty, to.ty, ens, exprSpan(env, e)), preferTy(to.ty, eo.ty, ens)) else if (ifIoUnit(tyStr(to), tyStr(eo))) andBinds(to, ret(eo, ifIoPick(tyStr(to), tyStr(eo)))) else bad(Str.concat("type mismatch: expected ", Str.concat(tyStr(to), Str.concat(", got ", tyStr(eo)))), exprSpan(env, e))

def ifIoUnit(a: String, b: String): Bool =
  isIo(a) && b == "Unit" || isIo(b) && a == "Unit"

def ifIoPick(a: String, b: String): String =
  if (isIo(a)) a else b

def infer(e: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  if (needsPh(e, funs)) infer(Expr.ELam("_ph", "", rewriteHole(e, "_ph")), env, funs, ens) else inferGo(e, env, funs, ens)

def needsPh(e: Expr, funs: Ftab): Bool =
  e match {
    case Expr.ELam(_, _, _) => false
    case Expr.EHole => true
    case Expr.EBin(_, l, r, _) => hasHole(l) || hasHole(r)
    case Expr.EUn(_, inner, _) => hasHole(inner)
    case Expr.ECall(f, args, _) => needsPhCall(f, args, funs)
    case Expr.EMethod(recv, _, args, _) => (isBareHole(recv) || hasBareHoleArg(args)) && !isCompoundPh(recv) && !hasCompoundPhArg(args)
    case Expr.EField(recv, _, _) => isBareHole(recv)
    case _ => false
  }

def needsPhCall(f: String, args: List[Expr], funs: Ftab): Bool =
  hasBareHoleArg(args) && !hasCompoundPhArg(args) && !isHoKit(f, funs)

def isHoKit(f: String, funs: Ftab): Bool =
  isKit(f, funs) && kitHasFun(kitParams(f, funs))

def kitHasFun(ps: List[String]): Bool =
  !List.isEmpty(ps) && (isFunTy(List.at(ps, 0)) || kitHasFun(List.tail(ps)))

def isBareHole(e: Expr): Bool =
  e match {
    case Expr.EHole => true
    case _ => false
  }

def isCompoundPh(e: Expr): Bool =
  hasHole(e) && !isBareHole(e)

def hasBareHoleArg(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (isBareHole(List.at(xs, 0)) || hasBareHoleArg(List.tail(xs)))

def hasCompoundPhArg(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (isCompoundPh(List.at(xs, 0)) || hasCompoundPhArg(List.tail(xs)))

def hasHole(e: Expr): Bool =
  e match {
    case Expr.EHole => true
    case Expr.EPrint(inner, _) => hasHole(inner)
    case Expr.ECall(_, args, _) => hasHoleList(args)
    case Expr.EMethod(recv, _, args, _) => hasHole(recv) || hasHoleList(args)
    case Expr.EField(recv, _, _) => hasHole(recv)
    case Expr.EBin(_, l, r, _) => hasHole(l) || hasHole(r)
    case Expr.EUn(_, inner, _) => hasHole(inner)
    case Expr.ELam(_, _, body) => hasHole(body)
    case Expr.EIf(c, t, el, _) => hasHole(c) || hasHole(t) || hasHole(el)
    case Expr.ENamed(_, inner) => hasHole(inner)
    case Expr.EAscribe(inner, _, _) => hasHole(inner)
    case Expr.EList(xs) => hasHoleList(xs)
    case Expr.ETuple(xs) => hasHoleList(xs)
    case _ => false
  }

def hasHoleList(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (hasHole(List.at(xs, 0)) || hasHoleList(List.tail(xs)))

def rewriteHole(e: Expr, n: String): Expr =
  e match {
    case Expr.EHole => Expr.EVar(n, 0)
    case Expr.EPrint(inner, _) => Expr.EPrint(rewriteHole(inner, n), 0)
    case Expr.ECall(f, args, _) => Expr.ECall(f, rewriteHoleList(args, n), 0)
    case Expr.EMethod(recv, name, args, _) => Expr.EMethod(rewriteHole(recv, n), name, rewriteHoleList(args, n), 0)
    case Expr.EField(recv, name, _) => Expr.EField(rewriteHole(recv, n), name, 0)
    case Expr.EBin(op, l, r, _) => Expr.EBin(op, rewriteHole(l, n), rewriteHole(r, n), 0)
    case Expr.EUn(op, inner, _) => Expr.EUn(op, rewriteHole(inner, n), 0)
    case Expr.ELam(p, ty, body) => Expr.ELam(p, ty, rewriteHole(body, n))
    case Expr.EIf(c, t, el, _) => Expr.EIf(rewriteHole(c, n), rewriteHole(t, n), rewriteHole(el, n), 0)
    case Expr.ENamed(nm, inner) => Expr.ENamed(nm, rewriteHole(inner, n))
    case Expr.EAscribe(inner, ty, off) => Expr.EAscribe(rewriteHole(inner, n), ty, off)
    case Expr.EList(xs) => Expr.EList(rewriteHoleList(xs, n))
    case Expr.ETuple(xs) => Expr.ETuple(rewriteHoleList(xs, n))
    case _ => e
  }

def rewriteHoleList(xs: List[Expr], n: String): List[Expr] =
  if (List.isEmpty(xs)) xs else rewriteHole(List.at(xs, 0), n) :: rewriteHoleList(List.tail(xs), n)

def inferGo(e: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  e match {
    case Expr.EInt(_, _) => okTy(Type.tInt())
    case Expr.EBool(_) => okTy(Type.tBool())
    case Expr.EStr(_, _) => okTy(Type.tStr())
    case Expr.EFloat(_) => okTy(Type.tFloat())
    case Expr.EInterp(_) => okTy(Type.tStr())
    case Expr.EUnit => okTy(Type.tUnit())
    case Expr.EHole => okTy(Type.tInt())
    case Expr.EVar(s, off) => inferVar(s, env, funs, ens, (modFile(env), off))
    case Expr.EPrint(inner, _) => inferPrint(inner, env, funs, ens, e)
    case Expr.ECall(f, args, off) => inferCall(f, args, env, funs, ens, (modFile(env), off))
    case Expr.EBin(op, l, r, _) => inferBin(op, l, r, env, funs, ens, e)
    case Expr.EUn(op, inner, _) => inferUn(op, inner, env, funs, ens, e)
    case Expr.EIf(c, t, el, _) => inferIf(c, t, el, env, funs, ens, e)
    case Expr.ENamed(_, inner) => infer(inner, env, funs, ens)
    case Expr.EList(xs) => inferList(xs, env, funs, ens)
    case Expr.ETuple(xs) => inferTuple(xs, env, funs, ens)
    case Expr.EMethod(recv, name, args, _) => inferMethod(recv, name, args, env, funs, ens, e)
    case Expr.EField(recv, name, _) => inferField(recv, name, env, funs, ens)
    case Expr.ELam(p, ty, body) => inferLam(ty, infer(body, bindLam(p, ty, env), funs, ens))
    case Expr.EMatch(s, arms, off) => inferMatch(s, arms, env, funs, ens, (modFile(env), off))
    case Expr.EFor(bs, body, _) => inferFor(bs, body, env, funs, ens)
    case Expr.EAscribe(inner, ty, off) => inferAscribe(inner, ty, off, env, funs, ens)
  }

def inferAscribe(inner: Expr, ty: String, off: Int, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  inferAscribe2(infer(inner, env, funs, ens), ty, (modFile(env), off), ens)

def inferAscribe2(o: Out, ty: String, span: (String, Int), ens: List[En]): Out =
  inferAscribe3(o, Type.parse(ty), ty, span, ens)

def inferAscribe3(o: Out, want: Ty, ty: String, span: (String, Int), ens: List[En]): Out =
  if (hasErr(o)) o else if (tyEq(o.ty, want, ens)) retTy(bindOrigin(o, o.origin, o.ty, want, ens, span), preferTy(want, o.ty, ens)) else bad(Str.concat("type mismatch: expected ", Str.concat(ty, Str.concat(", got ", tyStr(o)))), span)

def inferLam(ty: String, o: Out): Out =
  if (hasErr(o)) o else okTy(Type.tFun(Type.parse(if (ty == "") "A" else ty), o.ty))

def inferFor(bs: List[Bind], body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  inferForGo(bs, body, env, funs, ens, "")

def inferForGo(bs: List[Bind], body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], errTy: String): Out =
  if (List.isEmpty(bs)) inferFor2(infer(body, env, funs, ens), errTy) else inferForBind(List.at(bs, 0), List.tail(bs), body, env, funs, ens, errTy)

def inferForBind(b: Bind, rest: List[Bind], body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], errTy: String): Out =
  b match {
    case Bind(d, name, v) => inferForBind2(d, name, inferBindVal(d, name, v, rest, body, env, funs, ens), rest, body, refineEnv(v, env, funs, ens), funs, ens, errTy, exprSpan(env, v))
  }

def inferBindVal(d: Bool, name: String, v: Expr, rest: List[Bind], body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  inferBindVal2(d, name, v, rest, body, env, funs, ens, infer(v, env, funs, ens))

def inferBindVal2(d: Bool, name: String, v: Expr, rest: List[Bind], body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], vo: Out): Out =
  if (d || hasErr(vo) || !lamPinCand(name, v, vo, ens)) vo else lamPinDo(lamPinArg(name, "", rest, body, bindFor(false, name, tyStr(vo), env, ens), funs, ens), v, env, funs, ens, vo)

def lamPinDo(pin: String, v: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], vo: Out): Out =
  if (pin == "") vo else inferExpected(v, Type.show(Type.tFun(Type.parse(pin), Type.tParam("B"))), env, funs, ens)

def lamPinCand(name: String, v: Expr, vo: Out, ens: List[En]): Bool =
  v match {
    case Expr.ELam(p, ann, _) => ann == "" && lamPinName(p) && lamPinName(name) && Type.isFun(vo.ty) && isLooseEn(Type.show(Type.funArg(vo.ty)), ens)
    case _ => false
  }

def lamPinName(n: String): Bool =
  Str.len(n) > 0 && lamPinNameHead(Str.charAt(n, 0))

def lamPinNameHead(c: Int): Bool =
  c >= 97 && c <= 122 || c >= 65 && c <= 90

def lamPinArg(name: String, al: String, rest: List[Bind], body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  if (List.isEmpty(rest)) lamPinExpr(name, al, body, env, funs, ens) else lamPinArgB(name, al, List.at(rest, 0), List.tail(rest), body, env, funs, ens)

def lamPinArgB(name: String, al: String, b: Bind, rest: List[Bind], body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  b match {
    case Bind(d, bn, v) => lamPinArgB2(name, al, d, bn, v, lamPinExpr(name, al, v, refineEnv(v, env, funs, ens), funs, ens), rest, body, env, funs, ens)
  }

def lamPinArgB2(name: String, al: String, d: Bool, bn: String, v: Expr, found: String, rest: List[Bind], body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  if (found != "") found else if (bn == name) "" else lamPinArgB3(name, lamPinNext(al, d, bn, v, name), d, bn, infer(v, env, funs, ens), rest, body, refineEnv(v, env, funs, ens), funs, ens)

def lamPinNext(al: String, d: Bool, bn: String, v: Expr, name: String): String =
  if (!d && lamPinAliasVal(v, name, al)) bn else if (al != "" && bn == al) "" else al

def lamPinAliasVal(v: Expr, name: String, al: String): Bool =
  v match {
    case Expr.EVar(n, _) => n == name || al != "" && n == al
    case _ => false
  }

def lamPinSame(name: String, al: String, f: String): Bool =
  f == name || al != "" && f == al

def lamPinHide(al: String, p: String): String =
  if (al != "" && al == p) "" else al

def lamPinArgB3(name: String, al: String, d: Bool, bn: String, vo: Out, rest: List[Bind], body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  if (hasErr(vo)) "" else lamPinArg(name, al, rest, body, bindFor(d, bn, tyStr(vo), env, ens), funs, ens)

def lamPinExpr(name: String, al: String, e: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  e match {
    case Expr.ECall(f, args, _) => lamPinCall(name, al, f, args, env, funs, ens)
    case Expr.EMethod(recv, m, args, _) => lamPinMeth(name, al, recv, m, args, env, funs, ens)
    case Expr.EAscribe(inner, _, _) => lamPinExpr(name, al, inner, env, funs, ens)
    case Expr.ENamed(_, inner) => lamPinExpr(name, al, inner, env, funs, ens)
    case Expr.ELam(p, ann, lbody) => if (p == name) "" else lamPinExpr(name, lamPinHide(al, p), lbody, lamPinAnnEnv(p, ann, env), funs, ens)
    case Expr.EPrint(inner, _) => lamPinExpr(name, al, inner, env, funs, ens)
    case Expr.EField(recv, _, _) => lamPinExpr(name, al, recv, env, funs, ens)
    case Expr.EBin(_, l, r, _) => lamPinExprs(name, al, l :: r :: noExpr(), env, funs, ens)
    case Expr.EUn(_, inner, _) => lamPinExpr(name, al, inner, env, funs, ens)
    case Expr.EIf(c, t, el, _) => lamPinExprs(name, al, c :: t :: el :: noExpr(), env, funs, ens)
    case Expr.EMatch(s, arms, _) => lamPinArms(name, al, arms, env, funs, ens, lamPinExpr(name, al, s, env, funs, ens))
    case Expr.EFor(bs, fb, _) => lamPinArg(name, al, bs, fb, env, funs, ens)
    case Expr.EList(xs) => lamPinExprs(name, al, xs, env, funs, ens)
    case Expr.ETuple(xs) => lamPinExprs(name, al, xs, env, funs, ens)
    case _ => ""
  }

def lamPinPick(found: String, name: String, al: String, xs: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  if (found != "") found else lamPinExprs(name, al, xs, env, funs, ens)

def lamPinCall(name: String, al: String, f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  if (lamPinSame(name, al, f)) lamPinPick(lamPinApplyTy(args, env, funs, ens), name, al, args, env, funs, ens) else if ((f == "IO.foreach" || f == "IO.foreachDiscard") && List.len(args) == 2) lamPinForeach(name, al, args, env, funs, ens) else lamPinExprs(name, al, args, env, funs, ens)

def lamPinForeach(name: String, al: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  lamPinForeach2(lamPinExpr(name, al, List.at(args, 0), env, funs, ens), name, al, args, env, funs, ens)

def lamPinForeach2(found: String, name: String, al: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  if (found != "") found else lamPinIterLam(name, al, List.at(args, 0), List.at(args, 1), env, funs, ens)

def lamPinMeth(name: String, al: String, recv: Expr, m: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  recv match {
    case Expr.EVar(n, _) => if (m == "apply" && lamPinSame(name, al, n)) lamPinPick(lamPinApplyTy(args, env, funs, ens), name, al, args, env, funs, ens) else lamPinMethRest(name, al, recv, m, args, env, funs, ens)
    case Expr.ELam(p, ann, cont) => if (m == "apply" && List.len(args) == 1) lamPinBindCont(name, al, p, ann, cont, List.at(args, 0), env, funs, ens) else lamPinMethRest(name, al, recv, m, args, env, funs, ens)
    case _ => lamPinMethRest(name, al, recv, m, args, env, funs, ens)
  }

def lamPinBindCont(name: String, al: String, p: String, ann: String, cont: Expr, v: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  lamPinBindCont2(lamPinExpr(name, al, v, env, funs, ens), name, al, p, ann, cont, v, env, funs, ens)

def lamPinBindCont2(found: String, name: String, al: String, p: String, ann: String, cont: Expr, v: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  if (found != "") found else if (p == name) "" else lamPinBindCont3(name, lamPinHide(al, p), p, ann, cont, infer(v, env, funs, ens), env, funs, ens)

def lamPinBindCont3(name: String, al: String, p: String, ann: String, cont: Expr, vo: Out, env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  if (hasErr(vo)) "" else lamPinExpr(name, al, cont, lamPinContEnv(p, ann, tyStr(vo), env), funs, ens)

def lamPinContEnv(p: String, ann: String, ty: String, env: List[(String, Ty)]): List[(String, Ty)] =
  if (ann != "") envBind(p, ann, env) else envBind(p, ty, env)

def lamPinMethRest(name: String, al: String, recv: Expr, m: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  lamPinMethRest2(lamPinExpr(name, al, recv, env, funs, ens), name, al, recv, m, args, env, funs, ens)

def lamPinMethRest2(found: String, name: String, al: String, recv: Expr, m: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  if (found != "") found else if ((m == "foreach" || m == "map" || m == "flatMap" || m == "filter") && List.len(args) == 1) lamPinIterLam(name, al, recv, List.at(args, 0), env, funs, ens) else lamPinExprs(name, al, args, env, funs, ens)

def lamPinIterLam(name: String, al: String, xs: Expr, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  lam match {
    case Expr.ELam(p, ann, lbody) => if (p == name) "" else lamPinExpr(name, lamPinHide(al, p), lbody, lamPinIterEnv(p, ann, xs, env, funs, ens), funs, ens)
    case _ => lamPinExpr(name, al, lam, env, funs, ens)
  }

def lamPinIterEnv(p: String, ann: String, xs: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (ann != "") bindLam(p, ann, env) else lamPinIterEnv2(p, lamPinIterTy(xs, env, funs, ens), env)

def lamPinIterEnv2(p: String, el: String, env: List[(String, Ty)]): List[(String, Ty)] =
  if (el == "") env else bindLam(p, el, env)

def lamPinIterTy(xs: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  lamPinIterTy2(infer(xs, env, funs, ens))

def lamPinIterTy2(o: Out): String =
  if (hasErr(o)) "" else lamPinIterTy3(tyStr(o))

def lamPinIterTy3(t: String): String =
  if (Str.startsWith(t, "List[")) elemOf(t) else if (isIo(t)) ioPayload(t) else ""

def lamPinAnnEnv(p: String, ann: String, env: List[(String, Ty)]): List[(String, Ty)] =
  if (ann == "") env else bindLam(p, ann, env)

def lamPinApplyTy(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  if (List.isEmpty(args)) "" else lamPinArgTy(lamPinApplyOut(args, env, funs, ens), ens)

def lamPinApplyOut(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  if (List.len(args) == 1) infer(List.at(args, 0), env, funs, ens) else inferTuple(args, env, funs, ens)

def lamPinArgTy(o: Out, ens: List[En]): String =
  if (hasErr(o)) "" else lamPinTy(tyStr(o), ens)

def lamPinTy(t: String, ens: List[En]): String =
  if (t != "" && lamPinTyOk(Type.parse(t), ens)) t else ""

def lamPinTyOk(t: Ty, ens: List[En]): Bool =
  t match {
    case Ty.TVar(n) => nameIn(enNames(ens), n)
    case Ty.Named(n) => n != "" && n != "Any"
    case Ty.App(_, args) => lamPinTyList(args, ens)
    case Ty.Tuple(ps) => lamPinTyList(ps, ens)
    case Ty.Arrow(a, r) => lamPinTyOk(a, ens) && lamPinTyOk(r, ens)
    case _ => false
  }

def lamPinTyList(xs: List[Ty], ens: List[En]): Bool =
  if (List.isEmpty(xs)) true else lamPinTyOk(List.at(xs, 0), ens) && lamPinTyList(List.tail(xs), ens)

def lamPinExprs(name: String, al: String, xs: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  if (List.isEmpty(xs)) "" else lamPinPick(lamPinExpr(name, al, List.at(xs, 0), env, funs, ens), name, al, List.tail(xs), env, funs, ens)

def lamPinArms(name: String, al: String, arms: List[Arm], env: List[(String, Ty)], funs: Ftab, ens: List[En], found: String): String =
  if (found != "") found else if (List.isEmpty(arms)) "" else lamPinArms(name, al, List.tail(arms), env, funs, ens, lamPinArm(name, al, List.at(arms, 0), env, funs, ens))

def lamPinArm(name: String, al: String, a: Arm, env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  a match {
    case Arm(_, _, abody) => lamPinExpr(name, al, abody, env, funs, ens)
  }

def lamPinTyOf(name: String, v: Expr, cont: Expr, defs: Ftab, ens: List[En], ps: List[Param], mod: String): String =
  lamPinTyOf2(name, v, cont, infer(v, bindParams(ps, envSelfMod(mod)), defs, ens), defs, ens, ps, mod)

def lamPinTyOf2(name: String, v: Expr, cont: Expr, vo: Out, defs: Ftab, ens: List[En], ps: List[Param], mod: String): String =
  if (hasErr(vo) || !lamPinCand(name, v, vo, ens)) "" else lamPinTyOf3(v, vo, lamPinExpr(name, "", cont, bindParams(ps, envBind(name, tyStr(vo), envSelfMod(mod))), defs, ens), bindParams(ps, envSelfMod(mod)), defs, ens)

def lamPinTyOf3(v: Expr, vo: Out, pin: String, env: List[(String, Ty)], defs: Ftab, ens: List[En]): String =
  if (pin == "") "" else tyStr(lamPinDo(pin, v, env, defs, ens, vo))

def inferForBind2(d: Bool, name: String, vo: Out, rest: List[Bind], body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], errTy: String, span: (String, Int)): Out =
  if (hasErr(vo)) vo else if (d) andBinds(vo, inferForDraw(name, tyStr(vo), rest, body, env, funs, ens, errTy, span)) else andBinds(vo, inferForGo(rest, body, bindFor(false, name, tyStr(vo), env, ens), funs, ens, errTy))

def inferForDraw(name: String, ty: String, rest: List[Bind], body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], errTy: String, span: (String, Int)): Out =
  if (Str.startsWith(ty, "Stream") || Str.startsWith(ty, "Resource")) bad(Str.concat("<- needs IO, got ", ty), span) else inferForDraw2(name, ty, rest, body, env, funs, ens, unifyErr(errTy, ioErr(ty), span, ens))

def inferForDraw2(name: String, ty: String, rest: List[Bind], body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], u: Out): Out =
  if (hasErr(u)) u else inferForGo(rest, body, bindFor(true, name, ty, env, ens), funs, ens, tyStr(u))

def bindFor(d: Bool, name: String, ty: String, env: List[(String, Ty)], ens: List[En]): List[(String, Ty)] =
  if (name == "_" || name == "") env else bindPat(name, if (d) ioPayload(ty) else ty, env, ens)

def refineEnv(e: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  e match {
    case Expr.ECall(f, args, _) => refineExprs(args, refineUserPin(f, args, refineListPin(f, args, refineIterCall(f, args, refineOfferCall(f, args, env, funs, ens), funs, ens), funs, ens), funs, ens), funs, ens)
    case Expr.EMethod(recv, name, args, _) => refineExprs(args, pinListMeth(name, recv, args, refineEnv(recv, refineIterMeth(recv, name, args, refineOfferMeth(recv, name, args, env, funs, ens), funs, ens), funs, ens), funs, ens), funs, ens)
    case Expr.EAscribe(inner, _, _) => refineEnv(inner, env, funs, ens)
    case Expr.ENamed(_, inner) => refineEnv(inner, env, funs, ens)
    case Expr.ELam(_, _, body) => refineEnv(body, env, funs, ens)
    case Expr.EPrint(inner, _) => refineEnv(inner, env, funs, ens)
    case Expr.EField(recv, _, _) => refineEnv(recv, env, funs, ens)
    case Expr.EBin(op, l, r, _) => pinColon(op, l, r, refineEnv(r, refineEnv(l, env, funs, ens), funs, ens), funs, ens)
    case Expr.EUn(_, inner, _) => refineEnv(inner, env, funs, ens)
    case Expr.EIf(c, t, el, _) => refineEnv(el, refineEnv(t, refineEnv(c, env, funs, ens), funs, ens), funs, ens)
    case Expr.EMatch(s, arms, _) => refineArms(arms, refineEnv(s, env, funs, ens), funs, ens)
    case Expr.EFor(bs, body, _) => refineEnv(body, refineBinds(bs, env, funs, ens), funs, ens)
    case Expr.EList(xs) => refineExprs(xs, env, funs, ens)
    case Expr.ETuple(xs) => refineExprs(xs, env, funs, ens)
    case _ => env
  }

def refineExprs(xs: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (List.isEmpty(xs)) env else refineExprs(List.tail(xs), refineEnv(List.at(xs, 0), env, funs, ens), funs, ens)

def refineArms(xs: List[Arm], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (List.isEmpty(xs)) env else refineArms(List.tail(xs), refineArm(List.at(xs, 0), env, funs, ens), funs, ens)

def refineArm(a: Arm, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  a match {
    case Arm(_, _, body) => refineEnv(body, env, funs, ens)
  }

def refineBinds(xs: List[Bind], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (List.isEmpty(xs)) env else refineBinds(List.tail(xs), refineBind(List.at(xs, 0), env, funs, ens), funs, ens)

def refineBind(b: Bind, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  b match {
    case Bind(_, _, v) => refineEnv(v, env, funs, ens)
  }

def refineUserPin(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (isKit(f, funs) || List.isEmpty(args)) env else pinUserHit(findFunPrefer(funs, f, env), args, env, funs, ens)

def pinUserHit(hit: List[Fun], args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (List.isEmpty(hit)) env else pinUserFun(List.at(hit, 0), args, env, funs, ens)

def pinUserFun(d: Fun, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (!List.isEmpty(d.tparams)) env else pinWantArgs(paramTys(d.params), args, env, funs, ens)

def refineListPin(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (!isKit(f, funs)) env else pinColl(f, args, pinListSib(f, args, pinWantArgs(Kits.wantOf(kitRow(funs, f), List.len(args)), args, env, funs, ens), funs, ens), funs, ens)

def pinColl(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (f == "Map.set" && List.len(args) == 3) pinMapAt(args, 1, 2, env, funs, ens) else if (f == "Map.getOrElse" && List.len(args) == 3) pinMapAt(args, 1, 2, env, funs, ens) else if (mapKeyFn(f) && List.len(args) == 2) pinMapKey(args, env, funs, ens) else if (setElemFn(f) && List.len(args) == 2) pinSetAdd(args, env, funs, ens) else if (mapBin(f) && List.len(args) == 2) pinMapBin(args, env, funs, ens) else if (setBin(f) && List.len(args) == 2) pinSetBin(args, env, funs, ens) else if (foldFn(f) && List.len(args) == 3) pinFold(args, foldElemIx(f), env, funs, ens) else if (listPredFn(f) && List.len(args) == 2) pinListPred(args, env, funs, ens) else if (listRedFn(f) && List.len(args) == 2) pinListRed(args, env, funs, ens) else if (setPredFn(f) && List.len(args) == 2) pinListPred(args, env, funs, ens) else if (mapPredFn(f) && List.len(args) == 2) pinListPred(args, env, funs, ens) else if (listByFn(f) && List.len(args) == 2) pinListBy(args, env, funs, ens) else if (streamPredFn(f) && List.len(args) == 2) pinListPred(args, env, funs, ens) else if (streamBin(f) && List.len(args) == 2) pinStreamBin(args, env, funs, ens) else if (ioForFn(f) && List.len(args) == 2) pinListPred(args, env, funs, ens) else env

def mapKeyFn(f: String): Bool =
  f == "Map.contains" || f == "Map.remove" || f == "Map.get"

def pinMapKey(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinMapKeyGot(List.at(args, 0), infer(stripNamed(List.at(args, 1)), env, funs, ens), env)

def pinMapKeyGot(mapE: Expr, ko: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  if (hasErr(ko) || !concreteTy(tyStr(ko))) env else pinMapKeyVar(stripNamed(mapE), tyStr(ko), env)

def pinMapKeyVar(e: Expr, key: String, env: List[(String, Ty)]): List[(String, Ty)] =
  e match {
    case Expr.EVar(n, _) => pinMapKeyName(n, key, getTy(env, n), env)
    case _ => env
  }

def pinMapKeyName(n: String, key: String, ty: Ty, env: List[(String, Ty)]): List[(String, Ty)] =
  if (mapKeyOpenTy(ty)) envBind(n, mapTy(key, "A"), env) else if (mapKeySlotTy(ty)) envBind(n, mapTy(key, mapShownValTy(ty)), env) else env

def mapKeySlotTy(t: Ty): Bool =
  t match {
    case Ty.App(n, args) => n == "Map" && List.len(args) >= 2 && looseTy(List.at(args, 0)) && concreteTy(Type.show(List.at(args, 1)))
    case _ => false
  }

def mapShownValTy(t: Ty): String =
  t match {
    case Ty.App(_, args) => if (List.len(args) < 2) "" else Type.show(List.at(args, 1))
    case _ => ""
  }

def mapKeyOpenTy(t: Ty): Bool =
  Type.isNamed(t, "Map") || mapOneA(t) || mapBothLoose(t)

def mapOneA(t: Ty): Bool =
  t match {
    case Ty.App(n, args) => n == "Map" && List.len(args) == 1 && paramIsA(List.at(args, 0))
    case _ => false
  }

def paramIsA(t: Ty): Bool =
  t match {
    case Ty.TVar(n) => n == "A"
    case _ => false
  }

def mapBothLoose(t: Ty): Bool =
  t match {
    case Ty.App(n, args) => n == "Map" && List.len(args) >= 2 && looseTy(List.at(args, 0)) && looseTy(List.at(args, 1))
    case _ => false
  }

def mapBin(f: String): Bool =
  f == "Map.union" || f == "Map.intersect" || f == "Map.diff"

def pinMapBin(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinMapBinGo(stripNamed(List.at(args, 0)), stripNamed(List.at(args, 1)), infer(stripNamed(List.at(args, 0)), env, funs, ens), infer(stripNamed(List.at(args, 1)), env, funs, ens), env)

def pinMapBinGo(a: Expr, b: Expr, ao: Out, bo: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  pinFromColl(a, "Map", bo, pinFromColl(b, "Map", ao, env))

def setBin(f: String): Bool =
  f == "Set.union" || f == "Set.intersect" || f == "Set.diff" || f == "Set.isSubset" || f == "Set.isDisjoint"

def pinSetBin(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinMapBinGoSet(stripNamed(List.at(args, 0)), stripNamed(List.at(args, 1)), infer(stripNamed(List.at(args, 0)), env, funs, ens), infer(stripNamed(List.at(args, 1)), env, funs, ens), env)

def streamBin(f: String): Bool =
  f == "Stream.concat" || f == "Stream.orElse"

def pinStreamBin(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinStreamBinGo(stripNamed(List.at(args, 0)), stripNamed(List.at(args, 1)), infer(stripNamed(List.at(args, 0)), env, funs, ens), infer(stripNamed(List.at(args, 1)), env, funs, ens), env)

def pinStreamBinGo(a: Expr, b: Expr, ao: Out, bo: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  pinFromColl(a, "Stream", bo, pinFromColl(b, "Stream", ao, env))

def pinMapBinGoSet(a: Expr, b: Expr, ao: Out, bo: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  pinFromColl(a, "Set", bo, pinFromColl(b, "Set", ao, env))

def pinFromColl(e: Expr, ctor: String, o: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  if (hasErr(o) || !concreteTy(tyStr(o)) || !Str.startsWith(tyStr(o), Str.concat(ctor, "["))) env else pinBareNamed(e, ctor, tyStr(o), env)

def pinMapAt(args: List[Expr], ki: Int, vi: Int, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinMapPair(List.at(args, 0), infer(stripNamed(List.at(args, ki)), env, funs, ens), infer(stripNamed(List.at(args, vi)), env, funs, ens), env)

def pinMapPair(mapE: Expr, ko: Out, vo: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  if (hasErr(ko) || hasErr(vo) || !concreteTy(tyStr(ko)) || !concreteTy(tyStr(vo))) env else pinMapGrow(stripNamed(mapE), tyStr(ko), tyStr(vo), env)

def pinMapGrow(e: Expr, key: String, val: String, env: List[(String, Ty)]): List[(String, Ty)] =
  e match {
    case Expr.EVar(n, _) => pinMapGrowName(n, key, val, getTy(env, n), env)
    case _ => env
  }

def pinMapGrowName(n: String, key: String, val: String, ty: Ty, env: List[(String, Ty)]): List[(String, Ty)] =
  if (isBareHandleTy(ty, "Map")) envBind(n, mapTy(key, val), env) else if (mapValLoose(ty) && mapShownKeyTy(ty) == key) envBind(n, mapTy(key, val), env) else if (mapKeySlotTy(ty) && mapShownValTy(ty) == val) envBind(n, mapTy(key, val), env) else env

def mapValLoose(t: Ty): Bool =
  t match {
    case Ty.App(n, args) => n == "Map" && List.len(args) >= 2 && concreteTy(Type.show(List.at(args, 0))) && looseTy(List.at(args, 1))
    case _ => false
  }

def mapShownKeyTy(t: Ty): String =
  t match {
    case Ty.App(_, args) => if (List.isEmpty(args)) "" else Type.show(List.at(args, 0))
    case _ => ""
  }

def mapTy(k: String, v: String): String =
  Str.concat("Map[", Str.concat(k, Str.concat(", ", Str.concat(v, "]"))))

def setElemFn(f: String): Bool =
  f == "Set.add" || f == "Set.contains" || f == "Set.remove"

def pinSetAdd(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinSetElem(List.at(args, 0), infer(stripNamed(List.at(args, 1)), env, funs, ens), env)

def pinSetElem(e: Expr, o: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  if (hasErr(o) || !concreteTy(tyStr(o))) env else pinBareNamed(stripNamed(e), "Set", Str.concat("Set[", Str.concat(tyStr(o), "]")), env)

def pinBareNamed(e: Expr, ctor: String, ty: String, env: List[(String, Ty)]): List[(String, Ty)] =
  e match {
    case Expr.EVar(n, _) => if (isBareHandleTy(getTy(env, n), ctor)) envBind(n, ty, env) else env
    case _ => env
  }

def pinListSib(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (f == "List.cons" && List.len(args) == 2) pinCons(args, env, funs, ens) else if (f == "List.concat" && List.len(args) == 2) pinConcat(args, env, funs, ens) else if (f == "List.getOrElse" && List.len(args) == 3) pinGet(args, env, funs, ens) else if (f == "List.setAt" && List.len(args) == 3) pinListElemAt(args, 2, env, funs, ens) else if (listSeek(f) && List.len(args) == 2) pinListElemAt(args, 1, env, funs, ens) else if (listJoin(f) && List.len(args) == 2) pinListElemAt(args, 1, env, funs, ens) else if (f == "List.zipAll" && List.len(args) == 4) pinZipAll(args, env, funs, ens) else env

def listJoin(f: String): Bool =
  f == "List.append" || f == "List.intersperse"

def listSeek(f: String): Bool =
  f == "List.contains" || f == "List.indexOf" || f == "List.lastIndexOf"

def pinListElemAt(args: List[Expr], ei: Int, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinElemOn(List.at(args, 0), infer(stripNamed(List.at(args, ei)), env, funs, ens), env)

def pinZipAll(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinElemOn(List.at(args, 1), infer(stripNamed(List.at(args, 3)), env, funs, ens), pinListElemAt(args, 2, env, funs, ens))

def pinListMeth(name: String, recv: Expr, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (name == "concat" && List.len(args) == 1) pinConcat(recv :: args, env, funs, ens) else if (name == "getOrElse" && List.len(args) == 2) pinMapAt(recv :: args, 1, 2, pinGet(recv :: args, env, funs, ens), funs, ens) else if (name == "set" && List.len(args) == 2) pinMapAt(recv :: args, 1, 2, env, funs, ens) else if (name == "add" && List.len(args) == 1) pinSetAdd(recv :: args, env, funs, ens) else if (name == "setAt" && List.len(args) == 2) pinListElemAt(recv :: args, 2, env, funs, ens) else if (listSeekMeth(name) && List.len(args) == 1) pinSetAdd(recv :: args, pinMapKey(recv :: args, pinListElemAt(recv :: args, 1, env, funs, ens), funs, ens), funs, ens) else if ((name == "remove" || name == "get") && List.len(args) == 1) pinSetAdd(recv :: args, pinMapKey(recv :: args, env, funs, ens), funs, ens) else if (listJoinMeth(name) && List.len(args) == 1) pinListElemAt(recv :: args, 1, env, funs, ens) else if (collBinMeth(name) && List.len(args) == 1) pinSetBin(recv :: args, pinMapBin(recv :: args, env, funs, ens), funs, ens) else if (foldMeth(name) && List.len(args) == 2) pinFold(recv :: args, foldElemIx(name), env, funs, ens) else if (listPredMeth(name) && List.len(args) == 1) pinListPred(recv :: args, env, funs, ens) else if (name == "mapValues" && List.len(args) == 1) pinListPred(recv :: args, env, funs, ens) else if (listRedMeth(name) && List.len(args) == 1) pinListRed(recv :: args, env, funs, ens) else if (listByMeth(name) && List.len(args) == 1) pinListBy(recv :: args, env, funs, ens) else if (streamPredMeth(name) && List.len(args) == 1) pinListPred(recv :: args, env, funs, ens) else if (name == "orElse" && List.len(args) == 1) pinStreamBin(recv :: args, env, funs, ens) else if (name == "zipAll" && List.len(args) == 3) pinZipAll(recv :: args, env, funs, ens) else if (setRelMeth(name) && List.len(args) == 1) pinSetBin(recv :: args, env, funs, ens) else env

def listJoinMeth(name: String): Bool =
  name == "append" || name == "intersperse"

def setRelMeth(name: String): Bool =
  name == "isSubset" || name == "isDisjoint"

def collBinMeth(name: String): Bool =
  name == "union" || name == "intersect" || name == "diff"

def listSeekMeth(name: String): Bool =
  name == "contains" || name == "indexOf" || name == "lastIndexOf"

def foldFn(f: String): Bool =
  f == "List.foldLeft" || f == "List.foldRight" || f == "List.scanLeft" || f == "List.scanRight" || f == "Stream.fold" || f == "Stream.scan"

def foldMeth(name: String): Bool =
  name == "foldLeft" || name == "foldRight" || name == "scanLeft" || name == "scanRight" || name == "fold" || name == "scan"

def foldElemIx(name: String): Int =
  if (name == "List.foldRight" || name == "List.scanRight" || name == "foldRight" || name == "scanRight") 0 else 1

def pinFold(args: List[Expr], ei: Int, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinFoldSeed(List.at(args, 0), infer(stripNamed(List.at(args, 1)), env, funs, ens), stripNamed(List.at(args, 2)), ei, env, funs, ens)

def pinFoldSeed(listE: Expr, so: Out, lam: Expr, ei: Int, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (hasErr(so) || !concreteTy(tyStr(so))) env else pinFoldLam(stripNamed(listE), tyStr(so), lam, ei, env, funs, ens)

def pinFoldLam(listE: Expr, seed: String, lam: Expr, ei: Int, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  lam match {
    case Expr.ELam(_, _, body) => pinFoldMatch(listE, seed, body, ei, env, funs, ens)
    case Expr.ENamed(_, inner) => pinFoldLam(listE, seed, inner, ei, env, funs, ens)
    case Expr.EAscribe(inner, _, _) => pinFoldLam(listE, seed, inner, ei, env, funs, ens)
    case _ => env
  }

def pinFoldMatch(listE: Expr, seed: String, body: Expr, ei: Int, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  body match {
    case Expr.EMatch(_, arms, _) => if (List.isEmpty(arms)) env else pinFoldArm(listE, seed, List.at(arms, 0), ei, env, funs, ens)
    case _ => env
  }

def pinFoldArm(listE: Expr, seed: String, arm: Arm, ei: Int, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  arm match {
    case Arm(pat, _, abody) => pinFoldNames(listE, seed, foldPatNames(pat), abody, ei, env, funs, ens)
  }

def foldPatNames(pat: String): List[String] =
  if (isTuplePat(pat)) splitComma(Str.slice(pat, 1, Str.len(pat) - 1)) else []

def pinFoldNames(listE: Expr, seed: String, names: List[String], body: Expr, ei: Int, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (List.len(names) != 2) env else pinFoldBody(listE, seed, List.at(names, ei), body, envBind(List.at(names, if (ei == 0) 1 else 0), seed, env), funs, ens)

def pinFoldBody(listE: Expr, seed: String, elem: String, body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (elem == "" || elem == "_") env else pinFoldExpr(listE, seed, elem, body, env, funs, ens)

def pinFoldExpr(listE: Expr, seed: String, elem: String, e: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  e match {
    case Expr.EBin(op, l, r, _) => pinFoldBin(op, listE, seed, elem, l, r, env, funs, ens)
    case Expr.ECall(f, args, _) => pinFoldCall(f, listE, seed, elem, args, env, funs, ens)
    case Expr.ENamed(_, inner) => pinFoldExpr(listE, seed, elem, inner, env, funs, ens)
    case Expr.EAscribe(inner, _, _) => pinFoldExpr(listE, seed, elem, inner, env, funs, ens)
    case Expr.EUn(_, inner, _) => pinFoldExpr(listE, seed, elem, inner, env, funs, ens)
    case Expr.EIf(_, t, el, _) => pinFoldExpr(listE, seed, elem, el, pinFoldExpr(listE, seed, elem, t, env, funs, ens), funs, ens)
    case Expr.ELam(p, _, body) => if (p == elem) env else pinFoldExpr(listE, seed, elem, body, env, funs, ens)
    case _ => env
  }

def pinFoldBin(op: String, listE: Expr, seed: String, elem: String, l: Expr, r: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (isArith(op)) pinFoldHit(listE, seed, elem, l, r, pinFoldExpr(listE, seed, elem, r, pinFoldExpr(listE, seed, elem, l, env, funs, ens), funs, ens), funs, ens) else pinFoldExpr(listE, seed, elem, r, pinFoldExpr(listE, seed, elem, l, env, funs, ens), funs, ens)

def pinFoldCall(f: String, listE: Expr, seed: String, elem: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (f == "Str.concat" && List.len(args) == 2) pinFoldHit(listE, seed, elem, List.at(args, 0), List.at(args, 1), pinFoldArgs(listE, seed, elem, args, env, funs, ens), funs, ens) else pinFoldArgs(listE, seed, elem, args, env, funs, ens)

def pinFoldArgs(listE: Expr, seed: String, elem: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (List.isEmpty(args)) env else pinFoldArgs(listE, seed, elem, List.tail(args), pinFoldExpr(listE, seed, elem, List.at(args, 0), env, funs, ens), funs, ens)

def pinFoldHit(listE: Expr, seed: String, elem: String, l: Expr, r: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinFoldPair(listE, seed, elem, stripNamed(l), stripNamed(r), env, funs, ens)

def pinFoldPair(listE: Expr, seed: String, elem: String, l: Expr, r: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (foldElemVar(l, elem) && foldSideIs(r, seed, env, funs, ens)) pinFoldColl(listE, seed, env) else if (foldElemVar(r, elem) && foldSideIs(l, seed, env, funs, ens)) pinFoldColl(listE, seed, env) else env

def pinFoldColl(e: Expr, ty: String, env: List[(String, Ty)]): List[(String, Ty)] =
  pinBareNamed(e, "Stream", Str.concat("Stream[", Str.concat(ty, "]")), pinBareList(e, ty, env))

def foldElemVar(e: Expr, elem: String): Bool =
  e match {
    case Expr.EVar(n, _) => n == elem
    case _ => false
  }

def foldSideIs(e: Expr, seed: String, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Bool =
  foldSideGot(infer(e, env, funs, ens), seed)

def foldSideGot(o: Out, seed: String): Bool =
  !hasErr(o) && tyStr(o) == seed

def listPredFn(f: String): Bool =
  f == "List.map" || f == "List.flatMap" || f == "List.filter" || f == "List.filterNot" || f == "List.span" || f == "List.partition" || f == "List.exists" || f == "List.forall" || f == "List.find" || f == "List.findLast" || f == "List.count" || f == "List.groupBy" || f == "List.distinctBy"

def ioForFn(f: String): Bool =
  f == "IO.foreach" || f == "IO.foreachDiscard"

def listPredMeth(name: String): Bool =
  name == "map" || name == "flatMap" || name == "filter" || name == "filterNot" || name == "span" || name == "partition" || name == "exists" || name == "forall" || name == "find" || name == "findLast" || name == "count" || name == "groupBy" || name == "distinctBy"

def pinListPred(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinPredLam(stripNamed(List.at(args, 0)), stripNamed(List.at(args, 1)), env, funs, ens)

def listByFn(f: String): Bool =
  f == "List.sortBy" || f == "List.maxBy" || f == "List.minBy"

def listByMeth(name: String): Bool =
  name == "sortBy" || name == "maxBy" || name == "minBy"

def pinListBy(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinByLam(stripNamed(List.at(args, 0)), stripNamed(List.at(args, 1)), pinListPred(args, env, funs, ens), funs, ens)

def pinByLam(listE: Expr, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  lam match {
    case Expr.ELam(p, ann, body) => pinByBody(listE, p, ann, stripNamed(body), env)
    case Expr.ENamed(_, inner) => pinByLam(listE, inner, env, funs, ens)
    case Expr.EAscribe(inner, _, _) => pinByLam(listE, inner, env, funs, ens)
    case _ => env
  }

def pinByBody(listE: Expr, p: String, ann: String, body: Expr, env: List[(String, Ty)]): List[(String, Ty)] =
  if (ann == "" && p != "" && p != "_" && foldElemVar(body, p)) pinBareList(listE, "Int", env) else env

def pinPredLam(listE: Expr, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  lam match {
    case Expr.ELam(p, ann, body) => pinPredAnn(listE, p, ann, body, env, funs, ens)
    case Expr.ENamed(_, inner) => pinPredLam(listE, inner, env, funs, ens)
    case Expr.EAscribe(inner, _, _) => pinPredLam(listE, inner, env, funs, ens)
    case _ => env
  }

def pinPredAnn(listE: Expr, p: String, ann: String, body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (concreteTy(ann)) pinPredColl(listE, ann, env) else if (p == "" || p == "_" || p == "__tup") env else pinPredExpr(listE, p, body, env, funs, ens)

def pinPredExpr(listE: Expr, elem: String, e: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  e match {
    case Expr.EBin(op, l, r, _) => pinPredBin(op, listE, elem, l, r, env, funs, ens)
    case Expr.ECall(f, args, _) => pinPredCall(f, listE, elem, args, env, funs, ens)
    case Expr.EList(xs) => pinPredExprs(listE, elem, xs, env, funs, ens)
    case Expr.ETuple(xs) => pinPredExprs(listE, elem, xs, env, funs, ens)
    case Expr.ENamed(_, inner) => pinPredExpr(listE, elem, inner, env, funs, ens)
    case Expr.EAscribe(inner, _, _) => pinPredExpr(listE, elem, inner, env, funs, ens)
    case Expr.EUn(_, inner, _) => pinPredExpr(listE, elem, inner, env, funs, ens)
    case Expr.EIf(_, t, el, _) => pinPredExpr(listE, elem, el, pinPredExpr(listE, elem, t, env, funs, ens), funs, ens)
    case Expr.ELam(p, _, body) => if (p == elem) env else pinPredExpr(listE, elem, body, env, funs, ens)
    case _ => env
  }

def pinPredExprs(listE: Expr, elem: String, xs: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (List.isEmpty(xs)) env else pinPredExprs(listE, elem, List.tail(xs), pinPredExpr(listE, elem, List.at(xs, 0), env, funs, ens), funs, ens)

def pinPredBin(op: String, listE: Expr, elem: String, l: Expr, r: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinPredBin2(predBin(op), listE, elem, l, r, pinPredExpr(listE, elem, r, pinPredExpr(listE, elem, l, env, funs, ens), funs, ens), funs, ens)

def predBin(op: String): Bool =
  isArith(op) || isEq(op) || isOrd(op) || isLogic(op)

def pinPredBin2(on: Bool, listE: Expr, elem: String, l: Expr, r: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (!on) env else pinPredPair(listE, elem, stripNamed(l), stripNamed(r), env, funs, ens)

def pinPredPair(listE: Expr, elem: String, l: Expr, r: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (foldElemVar(l, elem)) pinPredSide(listE, r, env, funs, ens) else if (foldElemVar(r, elem)) pinPredSide(listE, l, env, funs, ens) else env

def pinPredSide(listE: Expr, e: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinPredGot(listE, infer(e, env, funs, ens), env)

def pinPredGot(listE: Expr, o: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  if (hasErr(o) || !concreteTy(tyStr(o))) env else pinPredColl(listE, tyStr(o), env)

def pinPredCall(f: String, listE: Expr, elem: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinPredWants(listE, elem, args, Kits.wantOf(kitRow(funs, f), List.len(args)), pinPredExprs(listE, elem, args, env, funs, ens))

def pinPredWants(listE: Expr, elem: String, args: List[Expr], wants: List[String], env: List[(String, Ty)]): List[(String, Ty)] =
  if (List.isEmpty(args) || List.isEmpty(wants)) env else pinPredWants(listE, elem, List.tail(args), List.tail(wants), pinPredWant(listE, elem, List.at(args, 0), List.at(wants, 0), env))

def pinPredWant(listE: Expr, elem: String, arg: Expr, want: String, env: List[(String, Ty)]): List[(String, Ty)] =
  if (foldElemVar(stripNamed(arg), elem) && concreteTy(want)) pinPredColl(listE, want, env) else env

def pinPredColl(e: Expr, ty: String, env: List[(String, Ty)]): List[(String, Ty)] =
  pinBareNamed(e, "Stream", Str.concat("Stream[", Str.concat(ty, "]")), pinPredMap(e, ty, pinBareNamed(e, "Set", Str.concat("Set[", Str.concat(ty, "]")), pinBareList(e, ty, env))))

def streamPredFn(f: String): Bool =
  f == "Stream.map" || f == "Stream.flatMap" || f == "Stream.mapConcat" || f == "Stream.evalMap" || f == "Stream.evalTap" || f == "Stream.filter" || f == "Stream.filterNot" || f == "Stream.takeWhile" || f == "Stream.dropWhile" || f == "Stream.find" || f == "Stream.findLast" || f == "Stream.exists" || f == "Stream.forall"

def streamPredMeth(name: String): Bool =
  name == "takeWhile" || name == "dropWhile" || name == "mapConcat" || name == "evalMap" || name == "evalTap"

def pinPredMap(e: Expr, ty: String, env: List[(String, Ty)]): List[(String, Ty)] =
  e match {
    case Expr.EVar(n, _) => pinPredMapName(n, ty, getTy(env, n), env)
    case _ => env
  }

def pinPredMapName(n: String, ty: String, cur: Ty, env: List[(String, Ty)]): List[(String, Ty)] =
  if (mapKeyOpenTy(cur)) envBind(n, mapTy("A", ty), env) else if (mapValLoose(cur)) envBind(n, mapTy(mapShownKeyTy(cur), ty), env) else env

def mapPredFn(f: String): Bool =
  f == "Map.filter" || f == "Map.exists" || f == "Map.forall" || f == "Map.mapValues"

def setPredFn(f: String): Bool =
  f == "Set.map" || f == "Set.filter" || f == "Set.exists" || f == "Set.forall"

def listRedFn(f: String): Bool =
  f == "List.reduceLeft" || f == "List.reduceRight"

def listRedMeth(name: String): Bool =
  name == "reduceLeft" || name == "reduceRight"

def pinListRed(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinRedLam(stripNamed(List.at(args, 0)), stripNamed(List.at(args, 1)), env, funs, ens)

def pinRedLam(listE: Expr, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  lam match {
    case Expr.ELam(_, _, body) => pinRedMatch(listE, body, env, funs, ens)
    case Expr.ENamed(_, inner) => pinRedLam(listE, inner, env, funs, ens)
    case Expr.EAscribe(inner, _, _) => pinRedLam(listE, inner, env, funs, ens)
    case _ => env
  }

def pinRedMatch(listE: Expr, body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  body match {
    case Expr.EMatch(_, arms, _) => if (List.isEmpty(arms)) env else pinRedArm(listE, List.at(arms, 0), env, funs, ens)
    case _ => env
  }

def pinRedArm(listE: Expr, arm: Arm, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  arm match {
    case Arm(pat, _, abody) => pinRedNames(listE, foldPatNames(pat), abody, env, funs, ens)
  }

def pinRedNames(listE: Expr, names: List[String], body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (List.len(names) != 2) env else pinRedOne(listE, List.at(names, 1), body, pinRedOne(listE, List.at(names, 0), body, env, funs, ens), funs, ens)

def pinRedOne(listE: Expr, elem: String, body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (elem == "" || elem == "_") env else pinPredExpr(listE, elem, body, env, funs, ens)

def pinColon(op: String, l: Expr, r: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (op != "::") env else pinElemOn(r, infer(stripNamed(l), env, funs, ens), env)

def pinCons(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinElemOn(List.at(args, 1), infer(stripNamed(List.at(args, 0)), env, funs, ens), env)

def pinGet(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinElemOn(List.at(args, 0), infer(stripNamed(List.at(args, 2)), env, funs, ens), env)

def pinElemOn(listE: Expr, o: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  if (hasErr(o) || !concreteTy(tyStr(o))) env else pinBareList(stripNamed(listE), tyStr(o), env)

def pinConcat(args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinConcatGo(stripNamed(List.at(args, 0)), stripNamed(List.at(args, 1)), infer(stripNamed(List.at(args, 0)), env, funs, ens), infer(stripNamed(List.at(args, 1)), env, funs, ens), env)

def pinConcatGo(a: Expr, b: Expr, ao: Out, bo: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  pinStreamBinGo(a, b, ao, bo, pinFromList(a, bo, pinFromList(b, ao, env)))

def pinFromList(e: Expr, o: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  if (hasErr(o) || !concreteTy(listElemTy(tyStr(o)))) env else pinBareList(e, listElemTy(tyStr(o)), env)

def listElemTy(t: String): String =
  if (Str.startsWith(t, "List[")) elemOf(t) else ""

def pinWantArgs(want: List[String], args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (List.isEmpty(want) || List.isEmpty(args)) env else pinWantArgs(List.tail(want), List.tail(args), pinWantArg(List.at(want, 0), List.at(args, 0), env, funs, ens), funs, ens)

def pinWantArg(w: String, arg: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  pinWantGot(w, stripNamed(arg), infer(stripNamed(arg), env, funs, ens), env)

def pinWantGot(w: String, arg: Expr, o: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  if (hasErr(o)) env else if (isLoose(tyStr(o)) && concreteTy(w)) pinLooseSrc(arg, w, env) else pinWantColl(w, arg, o, env)

def pinWantColl(w: String, arg: Expr, o: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  if (!concreteTy(w)) env else if (isBareHandle(tyStr(o), "List") && Str.startsWith(w, "List[") && concreteTy(listElemTy(w))) pinBareList(stripNamed(arg), listElemTy(w), env) else if (isBareHandle(tyStr(o), "Map") && Str.startsWith(w, "Map[")) pinBareNamed(stripNamed(arg), "Map", w, env) else if (isBareHandle(tyStr(o), "Set") && Str.startsWith(w, "Set[")) pinBareNamed(stripNamed(arg), "Set", w, env) else env

def concreteTy(t: String): Bool =
  t != "" && t != "Any" && (!hasTypeParamToken(t, 0, Str.len(t)) || !looseTy(Type.parse(t)))

def hasTypeParamToken(t: String, i: Int, n: Int): Bool =
  if (i >= n) false else if (typeParamTokenAt(t, i, n)) true else hasTypeParamToken(t, i + 1, n)

def typeParamTokenAt(t: String, i: Int, n: Int): Bool =
  Str.charAt(t, i) >= 65 && Str.charAt(t, i) <= 90 && (i == 0 || typeTokenEdge(Str.charAt(t, i - 1))) && (i + 1 == n || typeTokenEdge(Str.charAt(t, i + 1)))

def typeTokenEdge(c: Int): Bool =
  c == 32 || c == 44 || c == 91 || c == 93 || c == 40 || c == 41

def looseTy(t: Ty): Bool =
  t match {
    case Ty.TVar(_) => true
    case Ty.App(_, args) => looseTys(args)
    case Ty.Tuple(ps) => looseTys(ps)
    case Ty.Arrow(a, r) => looseTy(a) || looseTy(r)
    case _ => false
  }

def looseTys(xs: List[Ty]): Bool =
  if (List.isEmpty(xs)) false else looseTy(List.at(xs, 0)) || looseTys(List.tail(xs))

def pinLooseSrc(e: Expr, ty: String, env: List[(String, Ty)]): List[(String, Ty)] =
  e match {
    case Expr.ECall(f, args, _) => if (f == "List.at") pinAtList(args, ty, env) else env
    case Expr.EMethod(recv, name, _, _) => if (name == "at") pinBareList(stripNamed(recv), ty, env) else env
    case _ => env
  }

def pinAtList(args: List[Expr], ty: String, env: List[(String, Ty)]): List[(String, Ty)] =
  if (List.isEmpty(args)) env else pinBareList(stripNamed(List.at(args, 0)), ty, env)

def pinBareList(e: Expr, ty: String, env: List[(String, Ty)]): List[(String, Ty)] =
  e match {
    case Expr.EVar(n, _) => if (isBareHandleTy(getTy(env, n), "List")) envBind(n, Str.concat("List[", Str.concat(ty, "]")), env) else env
    case _ => env
  }

def refineOfferCall(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (f == "Queue.offer" || f == "Deferred.complete") refineOfferArgs(offerCtor(f), args, env, funs, ens) else env

def offerCtor(f: String): String =
  if (Str.startsWith(f, "Queue.")) "Queue" else "Deferred"

def refineOfferMeth(recv: Expr, name: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (name == "offer") refineOfferRecv(recv, "Queue", args, env, funs, ens) else if (name == "complete") refineOfferRecv(recv, "Deferred", args, env, funs, ens) else env

def refineIterCall(f: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if ((f == "IO.foreach" || f == "IO.foreachDiscard") && List.len(args) == 2) refineIterLam(List.at(args, 0), List.at(args, 1), env, funs, ens) else env

def refineIterMeth(recv: Expr, name: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if ((name == "foreach" || name == "map" || name == "flatMap" || name == "filter") && List.len(args) == 1) refineIterLam(recv, List.at(args, 0), env, funs, ens) else env

def refineIterLam(xs: Expr, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  lam match {
    case Expr.ELam(p, ann, body) => refineIterLam2(xs, p, body, iterParamTy(ann, iterElemTy(xs, env, funs, ens)), env, funs, ens)
    case _ => env
  }

def iterElemTy(xs: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): String =
  iterElemTy2(infer(xs, env, funs, ens))

def iterElemTy2(o: Out): String =
  if (hasErr(o) || !Str.startsWith(tyStr(o), "List[")) "" else elemOf(tyStr(o))

def iterParamTy(ann: String, el: String): String =
  if (ann != "") ann else el

def refineIterLam2(xs: Expr, p: String, body: Expr, pt: String, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (p == "" || p == "_") env else if (!isBareHandle(pt, "Queue") && !isBareHandle(pt, "Deferred")) env else refineIterPin(xs, p, pt, refineEnv(body, envBind(p, pt, env), funs, ens))

def refineIterPin(xs: Expr, p: String, pt: String, env: List[(String, Ty)]): List[(String, Ty)] =
  refineIterPin2(xs, p, pt, Type.show(lookupEnv(env, p)), List.filter(env, e => e._1 != p))

def refineIterPin2(xs: Expr, p: String, pt: String, pinned: String, env: List[(String, Ty)]): List[(String, Ty)] =
  if (pinned == "" || pinned == pt) env else pinIterSource(xs, pinned, env)

def pinIterSource(xs: Expr, pay: String, env: List[(String, Ty)]): List[(String, Ty)] =
  xs match {
    case Expr.EVar(n, _) => pinIterVar(n, pay, env)
    case Expr.EList(es) => pinIterElems(es, pay, env)
    case _ => env
  }

def pinIterVar(n: String, pay: String, env: List[(String, Ty)]): List[(String, Ty)] =
  if (isBareHandleTy(listElemTyOf(getTy(env, n)), Type.headNameStr(pay))) envBind(n, Str.concat("List[", Str.concat(pay, "]")), env) else env

def listElemTyOf(t: Ty): Ty =
  t match {
    case Ty.App(n, args) => if (n == "List" && !List.isEmpty(args)) Type.elem(t) else Type.tNamed("")
    case _ => Type.tNamed("")
  }

def pinIterElems(es: List[Expr], pay: String, env: List[(String, Ty)]): List[(String, Ty)] =
  if (List.isEmpty(es)) env else pinIterElems(List.tail(es), pay, pinIterElem(List.at(es, 0), pay, env))

def pinIterElem(e: Expr, pay: String, env: List[(String, Ty)]): List[(String, Ty)] =
  e match {
    case Expr.EVar(n, _) => if (isBareHandleTy(getTy(env, n), Type.headNameStr(pay))) envBind(n, pay, env) else env
    case _ => env
  }

def refineOfferArgs(ctor: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (List.len(args) < 2) env else refineHandlePay(ctor, List.at(args, 0), List.at(args, 1), env, funs, ens)

def refineOfferRecv(recv: Expr, ctor: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  if (List.isEmpty(args)) env else refineHandlePay(ctor, recv, List.at(args, 0), env, funs, ens)

def refineHandlePay(ctor: String, h: Expr, payE: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En]): List[(String, Ty)] =
  refineHandlePay2(ctor, stripNamed(h), infer(stripNamed(payE), env, funs, ens), env)

def refineHandlePay2(ctor: String, h: Expr, po: Out, env: List[(String, Ty)]): List[(String, Ty)] =
  if (hasErr(po) || isLoose(tyStr(po)) || tyStr(po) == "") env else refineHandleVar(ctor, h, tyStr(po), env)

def refineHandleVar(ctor: String, h: Expr, pay: String, env: List[(String, Ty)]): List[(String, Ty)] =
  h match {
    case Expr.EVar(name, _) => refineHandleName(ctor, name, pay, env)
    case _ => env
  }

def refineHandleName(ctor: String, name: String, pay: String, env: List[(String, Ty)]): List[(String, Ty)] =
  if (name == "_" || name == "") env else refineHandleName2(ctor, name, pay, lookupEnv(env, name), env)

def refineHandleName2(ctor: String, name: String, pay: String, cur: Ty, env: List[(String, Ty)]): List[(String, Ty)] =
  if (!isBareHandleTy(cur, ctor)) env else envBind(name, Str.concat(ctor, Str.concat("[", Str.concat(pay, "]"))), env)

def isBareHandle(ty: String, ctor: String): Bool =
  ty == ctor || ty == Str.concat(ctor, "[A]")

def isBareHandleTy(t: Ty, ctor: String): Bool =
  Type.namedName(t) == ctor || appBareA(t, ctor)

def appBareA(t: Ty, ctor: String): Bool =
  t match {
    case Ty.App(n, args) => n == ctor && List.len(args) == 1 && paramIsA(List.at(args, 0))
    case _ => false
  }

def inferFor2(o: Out, errTy: String): Out =
  if (hasErr(o) || errTy == "") o else ret(o, ioTy(errTy, tyStr(o)))

def forHasDraw(bs: List[Bind]): Bool =
  if (List.isEmpty(bs)) false else forHasDraw1(List.at(bs, 0), List.tail(bs))

def forHasDraw1(b: Bind, rest: List[Bind]): Bool =
  b match {
    case Bind(d, _, _) => d || forHasDraw(rest)
  }

def hasEn(ens: List[En], name: String): Bool =
  hasEnAt(ens, name)

def hasEnAt(ens: List[En], name: String): Bool =
  if (List.isEmpty(ens)) false else hasEnHit(List.at(ens, 0), List.tail(ens), name)

def hasEnHit(h: En, rest: List[En], name: String): Bool =
  if (h.name == name) true else hasEnAt(rest, name)

def inferField(recv: Expr, name: String, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  recv match {
    case Expr.EVar(en, _) => if (hasEn(ens, en)) ok(en) else inferFieldVar(en, name, env, funs, ens)
    case _ => fieldOf(infer(recv, env, funs, ens), name, ens)
  }

def inferFieldVar(en: String, name: String, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  inferFieldHit(ftabGetMod(funs.tab, en, name), en, name, env, funs, ens)

def inferFieldHit(hit: List[Fun], en: String, name: String, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  if (List.isEmpty(hit)) fieldOf(inferVar(en, env, funs, ens, noSpan()), name, ens) else okTy(funTyOf(List.at(hit, 0)))

def fieldOf(o: Out, name: String, ens: List[En]): Out =
  if (hasErr(o)) o else fieldOf2(tyStr(o), name, ens, o.span)

def fieldOf2(ty: String, name: String, ens: List[En], span: (String, Int)): Out =
  if (isTup(ty) && isTupField(name)) tupFieldAt(Type.tupPartsStr(ty), tupIdx(name), name, span) else if (isTup(ty) && tupBadName(name)) bad(Str.concat("tuple has no field ", name), span) else if (Type.isFunStr(ty) && tupBadName(name)) bad(Str.concat("tuple has no field ", name), span) else fieldOf3(fieldNamed(specializeEnums(ens, ty), Type.headNameStr(ty), name), ty)

def isTupField(name: String): Bool =
  tupIdx(name) >= 0

def tupIdx(name: String): Int =
  if (Str.len(name) == 2 && Str.charAt(name, 0) == 95) tupIdxDig(Str.charAt(name, 1)) else 0 - 1

def tupIdxDig(c: Int): Int =
  if (c >= 49 && c <= 56) c - 49 else 0 - 1

def tupBadName(name: String): Bool =
  Str.len(name) >= 2 && Str.charAt(name, 0) == 95 && Str.charAt(name, 1) >= 48 && Str.charAt(name, 1) <= 57

def tupFieldAt(parts: List[String], i: Int, name: String, span: (String, Int)): Out =
  if (i < 0 || i >= List.len(parts)) bad(Str.concat("tuple has no field ", name), span) else ok(List.at(parts, i))

def fieldOf3(ft: String, ty: String): Out =
  if (ft == "") ok(ty) else ok(ft)

def fieldNamed(ens: List[En], ty: String, name: String): String =
  if (List.isEmpty(ens)) "" else fieldNamed1(List.at(ens, 0), List.tail(ens), ty, name)

def fieldNamed1(h: En, rest: List[En], ty: String, name: String): String =
  h match {
    case En(_, n, _, cases) => if (n == ty) fieldNamed2(cases, name) else fieldNamed(rest, ty, name)
  }

def fieldNamed2(cs: List[EnCase], name: String): String =
  if (List.isEmpty(cs)) "" else fieldNamed3(List.at(cs, 0), List.tail(cs), name)

def fieldNamed3(h: EnCase, rest: List[EnCase], name: String): String =
  h match {
    case EnCase(_, fields) => fieldNamed4(fields, name, rest)
  }

def fieldNamed4(fs: List[Param], name: String, rest: List[EnCase]): String =
  if (List.isEmpty(fs)) fieldNamed2(rest, name) else fieldNamed5(List.at(fs, 0), List.tail(fs), name, rest)

def fieldNamed5(p: Param, rest: List[Param], name: String, restCs: List[EnCase]): String =
  p match {
    case Param(n, ty, _, _) => if (n == name) ty else fieldNamed4(rest, name, restCs)
  }

def inferMatch(s: Expr, arms: List[Arm], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  inferMatch2(infer(s, env, funs, ens), arms, env, funs, ens, span)

def inferMatch2(o: Out, arms: List[Arm], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (hasErr(o)) o else if (List.isEmpty(arms)) o else andBinds(o, inferMatchNest(nestArmsErr(arms, span), arms, tyStr(o), env, funs, ens, span))

def inferMatchNest(v: Out, arms: List[Arm], scrutTy: String, env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (hasErr(v)) v else inferMatchRest(inferMatchChecked(altArmsErr(arms, scrutTy, ens, span), List.at(arms, 0), scrutTy, env, funs, ens), List.tail(arms), scrutTy, env, funs, ens)

def nestArmsErr(arms: List[Arm], span: (String, Int)): Out =
  if (List.isEmpty(arms)) ok("Unit") else nestArmsErr2(nestArmErr(List.at(arms, 0)), List.tail(arms), span)

def nestArmsErr2(err: String, rest: List[Arm], span: (String, Int)): Out =
  if (Str.len(err) > 0) bad(err, span) else nestArmsErr(rest, span)

def nestArmErr(arm: Arm): String =
  arm match {
    case Arm(pat, _, _) => nestAltErr(pat, Parse.patternAlternativeAt(pat, 0, 0))
  }

def nestAltErr(pat: String, i: Int): String =
  if (i < 0) nestPatErr(trimName(pat)) else nestAltErr2(nestPatErr(trimName(Str.take(pat, i))), Str.drop(pat, i + 3))

def nestAltErr2(err: String, rest: String): String =
  if (Str.len(err) > 0) err else nestAltErr(rest, Parse.patternAlternativeAt(rest, 0, 0))

def nestPatErr(pat: String): String =
  if (asAt(pat, 0) >= 0) nestPatErr(trimName(Str.drop(pat, asAt(pat, 0) + 3))) else if (consAt(pat, 0) >= 0) nestConsHeadErr(trimName(Str.take(pat, consAt(pat, 0))), trimName(Str.drop(pat, consAt(pat, 0) + 4))) else if (isTuplePat(pat)) nestFieldsErr(splitComma(Str.slice(pat, 1, Str.len(pat) - 1)), true) else if (patBind(pat) == "") "" else nestFieldsErr(splitComma(patBind(pat)), false)

def nestConsHeadErr(head: String, tail: String): String =
  nestConsHeadErr2(nestPatErr(head), tail)

def nestConsHeadErr2(err: String, tail: String): String =
  if (Str.len(err) > 0) err else nestPatErr(tail)

def nestFieldsErr(fs: List[String], inTuple: Bool): String =
  if (List.isEmpty(fs)) "" else nestFieldsErr2(nestFieldErr(List.at(fs, 0), inTuple), List.tail(fs), inTuple)

def nestFieldsErr2(err: String, rest: List[String], inTuple: Bool): String =
  if (Str.len(err) > 0) err else nestFieldsErr(rest, inTuple)

def nestFieldErr(f: String, inTuple: Bool): String =
  nestFieldErrAt(eqAt(f, 0), f, inTuple)

def nestFieldErrAt(i: Int, f: String, inTuple: Bool): String =
  nestCompErr(trimName(if (i < 0) f else Str.drop(f, i + 3)), inTuple)

def nestCompErr(c: String, _inTuple: Bool): String =
  if (nestPatOk(c)) nestPatErr(c) else "nested patterns are not supported here"

def nestPatOk(s: String): Bool =
  s == "" || s == "_" || s == "[]" || altStrPat(s) || altIntPat(s) || altBoolPat(s) || isBareName(s) || isTuplePat(s) || consAt(s, 0) >= 0 || asAt(s, 0) >= 0

def inferMatchRest(first: Out, rest: List[Arm], scrutTy: String, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  if (hasErr(first)) first else if (List.isEmpty(rest)) first else inferMatchArm2(first, inferMatchArm(List.at(rest, 0), scrutTy, env, funs, ens), List.at(rest, 0), List.tail(rest), scrutTy, env, funs, ens)

def inferMatchArm2(first: Out, cur: Out, arm: Arm, rest: List[Arm], scrutTy: String, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  if (hasErr(cur)) cur else if (tyEq(first.ty, cur.ty, ens)) inferMatchRest(andBinds(first, retTy(cur, preferTy(first.ty, cur.ty, ens))), rest, scrutTy, env, funs, ens) else bad(Str.concat("type mismatch: expected ", Str.concat(tyStr(first), Str.concat(", got ", tyStr(cur)))), armSpan(arm, env))

def armSpan(arm: Arm, env: List[(String, Ty)]): (String, Int) =
  arm match {
    case Arm(_, _, body) => exprSpan(env, body)
  }

def inferMatchChecked(v: Out, arm: Arm, scrutTy: String, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  if (hasErr(v)) v else inferMatchArm(arm, scrutTy, env, funs, ens)

def inferMatchArm(arm: Arm, scrutTy: String, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  arm match {
    case Arm(pat, _, body) => infer(body, bindPat(pat, scrutTy, env, ens), funs, ens)
  }

def altArmsErr(arms: List[Arm], scrutTy: String, ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(arms)) ok("Unit") else altArmsErr2(altArmErr(List.at(arms, 0), scrutTy, ens), List.tail(arms), scrutTy, ens, span)

def altArmsErr2(err: String, rest: List[Arm], scrutTy: String, ens: List[En], span: (String, Int)): Out =
  if (Str.len(err) > 0) bad(err, span) else altArmsErr(rest, scrutTy, ens, span)

def altArmErr(arm: Arm, scrutTy: String, ens: List[En]): String =
  arm match {
    case Arm(pat, _, _) => altPatErr(pat, scrutTy, ens)
  }

def altPatErr(pat: String, scrutTy: String, ens: List[En]): String =
  altPatErrAt(Parse.patternAlternativeAt(pat, 0, 0), pat, scrutTy, ens)

def altPatErrAt(i: Int, pat: String, scrutTy: String, ens: List[En]): String =
  if (i < 0) "" else altRestErr(altBinds(Str.take(pat, i), scrutTy, ens), Str.drop(pat, i + 3), scrutTy, ens)

def altRestErr(ref: List[(String, String)], rest: String, scrutTy: String, ens: List[En]): String =
  altRestErrAt(Parse.patternAlternativeAt(rest, 0, 0), ref, rest, scrutTy, ens)

def altRestErrAt(i: Int, ref: List[(String, String)], rest: String, scrutTy: String, ens: List[En]): String =
  if (i < 0) altCmpErr(ref, altBinds(rest, scrutTy, ens), ens) else altRestErr2(altCmpErr(ref, altBinds(Str.take(rest, i), scrutTy, ens), ens), ref, Str.drop(rest, i + 3), scrutTy, ens)

def altRestErr2(err: String, ref: List[(String, String)], rest: String, scrutTy: String, ens: List[En]): String =
  if (Str.len(err) > 0) err else altRestErr(ref, rest, scrutTy, ens)

def altBinds(alt: String, scrutTy: String, ens: List[En]): List[(String, String)] =
  if (patBind(alt) == "") noAltBind() else List.map(List.filter(bindPat(alt, scrutTy, noEnv(), ens), b => altKeepName(b._1)), b => (b._1, Type.show(b._2)))

def noAltBind(): List[(String, String)] =
  []

def altKeepName(n: String): Bool =
  n != "" && n != "_" && !altStrPat(n) && !altIntPat(n) && !altBoolPat(n)

def altStrPat(s: String): Bool =
  Str.len(s) >= 2 && Str.charAt(s, 0) == 34

def altIntPat(s: String): Bool =
  if (Str.len(s) == 0) false else altIntPat2(s, if (Str.charAt(s, 0) == 45) 1 else 0)

def altIntPat2(s: String, i: Int): Bool =
  if (i >= Str.len(s)) i > 0 && (Str.charAt(s, 0) != 45 || Str.len(s) > 1) else if (Str.charAt(s, i) >= 48 && Str.charAt(s, i) <= 57) altIntPat2(s, i + 1) else false

def altBoolPat(s: String): Bool =
  s == "true" || s == "false"

def altCmpErr(ref: List[(String, String)], got: List[(String, String)], ens: List[En]): String =
  if (List.len(ref) != List.len(got)) "pattern alternatives must bind the same names" else altCmpEach(ref, got, ens)

def altCmpEach(ref: List[(String, String)], got: List[(String, String)], ens: List[En]): String =
  if (List.isEmpty(ref)) "" else altCmpHit(List.at(ref, 0), List.filter(got, b => b._1 == List.at(ref, 0)._1), List.tail(ref), got, ens)

def altCmpHit(b: (String, String), hit: List[(String, String)], rest: List[(String, String)], got: List[(String, String)], ens: List[En]): String =
  if (List.isEmpty(hit)) "pattern alternatives must bind the same names" else altCmpTy(b, List.at(hit, 0), rest, got, ens)

def altCmpTy(ref: (String, String), got: (String, String), rest: List[(String, String)], all: List[(String, String)], ens: List[En]): String =
  if (tyEqEn(ref._2, got._2, ens)) altCmpEach(rest, all, ens) else Str.concat("pattern alternative binding ", Str.concat(ref._1, Str.concat(" has type ", Str.concat(got._2, Str.concat(", expected ", ref._2)))))

def parenAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 40) i else parenAt(s, i + 1)

def patBind(pat: String): String =
  patBind2(parenAt(pat, 0), pat)

def patBind2(p: Int, pat: String): String =
  if (p < 0) "" else patBind3(p, closeParen(pat, p + 1, 1), pat)

def patBind3(p: Int, c: Int, pat: String): String =
  if (c < 0) Str.slice(pat, p + 1, Str.len(pat) - 1) else Str.slice(pat, p + 1, c)

def closeParen(s: String, i: Int, d: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 34) closeParen(s, Parse.quotedEnd(s, i), d) else closeParenCh(s, i, d, Str.charAt(s, i))

def closeParenCh(s: String, i: Int, d: Int, c: Int): Int =
  if (c == 40) closeParen(s, i + 1, d + 1) else if (c == 41) closeParenDone(s, i, d) else closeParen(s, i + 1, d)

def closeParenDone(s: String, i: Int, d: Int): Int =
  if (d == 1) i else closeParen(s, i + 1, d - 1)

def patCore(pat: String): String =
  patCore2(parenAt(pat, 0), pat)

def patCore2(p: Int, pat: String): String =
  if (p < 0) pat else Str.slice(pat, 0, p)

def bindPat(pat: String, scrutTy: String, env: List[(String, Ty)], ens: List[En]): List[(String, Ty)] =
  if (Parse.patternAlternativeAt(pat, 0, 0) >= 0) bindPat(Str.take(pat, Parse.patternAlternativeAt(pat, 0, 0)), scrutTy, env, ens) else bindPat2(patBind(pat), pat, scrutTy, env, ens)

def bindPat2(b: String, pat: String, scrutTy: String, env: List[(String, Ty)], ens: List[En]): List[(String, Ty)] =
  if (asAt(pat, 0) >= 0) bindAs(pat, scrutTy, env, ens) else if (consAt(pat, 0) >= 0) bindCons(pat, scrutTy, env, ens) else if (isTuplePat(pat)) bindTuple(pat, scrutTy, env, ens) else if (hasComma(b) || eqAt(b, 0) >= 0) bindConstructorFields(splitComma(b), constructorFields(specializeEnums(ens, scrutTy), patCore(pat)), 0, env, ens) else if (asAt(b, 0) >= 0) bindAs(b, bindTy(pat, scrutTy, ens), env, ens) else if (eqAt(b, 0) >= 0) bindEq(b, bindTy(pat, scrutTy, ens), env, ens) else if (consAt(b, 0) >= 0) bindCons(b, bindTy(pat, scrutTy, ens), env, ens) else if (isTuplePat(b)) bindTuple(b, bindTy(pat, scrutTy, ens), env, ens) else if (b == "") bindBare(pat, scrutTy, env) else envBind(b, bindTy(pat, scrutTy, ens), env)

def constructorFields(ens: List[En], core: String): List[Param] =
  if (List.exists(ens, en => en.name == core)) List.flatMap(List.filter(ens, en => en.name == core), en => List.flatMap(en.cases, c => c.fields)) else List.flatMap(ens, en => constructorFieldsIn(en, core))

def constructorFieldsIn(en: En, core: String): List[Param] =
  List.flatMap(en.cases, c => if (core == Str.concat(en.name, Str.concat(".", c.name)) || core == en.name && en.isRec || core == c.name) c.fields else [])

def bindConstructorFields(names: List[String], fields: List[Param], i: Int, scope: List[(String, Ty)], ens: List[En]): List[(String, Ty)] =
  if (List.isEmpty(names)) scope else bindConstructorField(List.at(names, 0), List.tail(names), fields, i, scope, ens)

def bindConstructorField(name: String, rest: List[String], fields: List[Param], i: Int, scope: List[(String, Ty)], ens: List[En]): List[(String, Ty)] =
  if (eqAt(name, 0) >= 0) bindNamedConstructorField(name, rest, fields, i, scope, ens, List.filter(fields, p => p.name == Str.take(name, eqAt(name, 0)))) else bindConstructorFields(rest, fields, i + 1, bindPat(name, if (i < List.len(fields)) List.at(fields, i).ty else "A", scope, ens), ens)

def bindNamedConstructorField(name: String, rest: List[String], fields: List[Param], i: Int, scope: List[(String, Ty)], ens: List[En], selected: List[Param]): List[(String, Ty)] =
  bindConstructorFields(rest, fields, i + 1, bindPat(Str.drop(name, eqAt(name, 0) + 3), if (List.isEmpty(selected)) "A" else List.at(selected, 0).ty, scope, ens), ens)

def eqAt(s: String, i: Int): Int =
  eqAtD(s, i, 0)

def eqAtD(s: String, i: Int, d: Int): Int =
  if (i + 3 > Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 34) eqAtD(s, Parse.quotedEnd(s, i), d) else if (d == 0 && Parse.at3(s, i, 32, 61, 32)) i else eqAtD(s, i + 1, asDepth(s, i, d))

def bindEq(b: String, ty: String, env: List[(String, Ty)], ens: List[En]): List[(String, Ty)] =
  bindPat(Str.slice(b, eqAt(b, 0) + 3, Str.len(b)), ty, env, ens)

def consAt(s: String, i: Int): Int =
  consAtD(s, i, 0)

def consAtD(s: String, i: Int, d: Int): Int =
  if (i + 4 > Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 34) consAtD(s, Parse.quotedEnd(s, i), d) else if (d == 0 && Parse.at3(s, i, 32, 58, 58) && Str.charAt(s, i + 3) == 32) i else consAtD(s, i + 1, asDepth(s, i, d))

def bindCons(pat: String, scrutTy: String, env: List[(String, Ty)], ens: List[En]): List[(String, Ty)] =
  bindConsAt(consAt(pat, 0), pat, scrutTy, env, ens)

def bindConsAt(i: Int, pat: String, scrutTy: String, env: List[(String, Ty)], ens: List[En]): List[(String, Ty)] =
  bindPat(Str.slice(pat, i + 4, Str.len(pat)), scrutTy, bindPat(Str.slice(pat, 0, i), elemOf(scrutTy), env, ens), ens)

def bindBare(pat: String, scrutTy: String, env: List[(String, Ty)]): List[(String, Ty)] =
  if (isBareName(pat) && dotAt(pat, 0) < 0) envBind(pat, scrutTy, env) else env

def isBareName(s: String): Bool =
  Str.len(s) > 0 && isBareStart(Str.charAt(s, 0)) && s != "_"

def isBareStart(c: Int): Bool =
  c == 95 || c >= 65 && c <= 90 || c >= 97 && c <= 122

def asAt(s: String, i: Int): Int =
  asAtD(s, i, 0)

def asAtD(s: String, i: Int, d: Int): Int =
  if (i + 3 > Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 34) asAtD(s, Parse.quotedEnd(s, i), d) else if (d == 0 && Parse.at3(s, i, 32, 64, 32)) i else asAtD(s, i + 1, asDepth(s, i, d))

def asDepth(s: String, i: Int, d: Int): Int =
  asDepthCh(Str.charAt(s, i), d)

def asDepthCh(c: Int, d: Int): Int =
  if (c == 40) d + 1 else if (c == 41 && d > 0) d - 1 else if (c == 41) 0 else d

def bindAs(pat: String, scrutTy: String, env: List[(String, Ty)], ens: List[En]): List[(String, Ty)] =
  bindAsAt(asAt(pat, 0), pat, scrutTy, env, ens)

def bindAsAt(i: Int, pat: String, scrutTy: String, env: List[(String, Ty)], ens: List[En]): List[(String, Ty)] =
  bindPat(Str.slice(pat, i + 3, Str.len(pat)), scrutTy, envBind(Str.slice(pat, 0, i), scrutTy, env), ens)

def isTuplePat(pat: String): Bool =
  Str.len(pat) > 0 && Str.charAt(pat, 0) == 40

def bindTuple(pat: String, scrutTy: String, env: List[(String, Ty)], ens: List[En]): List[(String, Ty)] =
  bindTuple2(splitComma(Str.slice(pat, 1, Str.len(pat) - 1)), Type.tupPartsStr(scrutTy), env, ens)

def splitComma(s: String): List[String] =
  splitCommaAt(s, commaAt(s, 0))

def commaAt(s: String, i: Int): Int =
  commaAtD(s, i, 0)

def commaAtD(s: String, i: Int, d: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 34) commaAtD(s, Parse.quotedEnd(s, i), d) else commaAtC(s, i, d, Str.charAt(s, i))

def commaAtC(s: String, i: Int, d: Int, c: Int): Int =
  if (c == 40 || c == 91) commaAtD(s, i + 1, d + 1) else if (c == 41 || c == 93) commaAtD(s, i + 1, if (d > 0) d - 1 else 0) else if (c == 44 && d == 0) i else commaAtD(s, i + 1, d)

def splitCommaAt(s: String, c: Int): List[String] =
  if (c < 0) trimName(s) :: noStr() else trimName(Str.slice(s, 0, c)) :: splitComma(Str.slice(s, c + 1, Str.len(s)))

def trimName(s: String): String =
  trimName2(s, 0, Str.len(s))

def trimName2(s: String, a: Int, b: Int): String =
  if (a >= b) "" else if (Str.charAt(s, a) == 32) trimName2(s, a + 1, b) else if (Str.charAt(s, b - 1) == 32) trimName2(s, a, b - 1) else Str.slice(s, a, b)

def bindTuple2(ns: List[String], ts: List[String], env: List[(String, Ty)], ens: List[En]): List[(String, Ty)] =
  if (List.isEmpty(ns)) env else bindPat(List.at(ns, 0), if (List.isEmpty(ts)) "A" else List.at(ts, 0), bindTuple2(List.tail(ns), if (List.isEmpty(ts)) ts else List.tail(ts), env, ens), ens)

def bindTy(pat: String, scrutTy: String, ens: List[En]): String =
  bindTyGot(patCore(pat), fieldTy(specializeEnums(ens, scrutTy), patCore(pat)), scrutTy)

def bindTyGot(core: String, ft: String, scrutTy: String): String =
  if (ft == "") ctorElem(core, scrutTy) else ft

def ctorElem(core: String, scrutTy: String): String =
  ctorElem2(ctorName(core), splitComma(elemOf(scrutTy)))

def ctorName(core: String): String =
  ctorName2(dotAt(core, 0), core)

def ctorName2(d: Int, core: String): String =
  if (d < 0) core else Str.slice(core, d + 1, Str.len(core))

def ctorElem2(name: String, args: List[String]): String =
  if (List.isEmpty(args)) "A" else if (name == "Right" || name == "Ok") ctorSecond(args) else List.at(args, 0)

def ctorSecond(args: List[String]): String =
  if (List.isEmpty(List.tail(args))) List.at(args, 0) else List.at(List.tail(args), 0)

def fieldTy(ens: List[En], core: String): String =
  fieldTy2(dotAt(core, 0), core, ens)

def dotAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 46) i else dotAt(s, i + 1)

def fieldTy2(dot: Int, core: String, ens: List[En]): String =
  if (dot < 0) caseFieldTy(ens, core, core) else caseFieldTy(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def caseFieldTy(ens: List[En], en: String, ctor: String): String =
  if (List.isEmpty(ens)) "" else caseFieldTy1(List.at(ens, 0), List.tail(ens), en, ctor)

def caseFieldTy1(h: En, rest: List[En], en: String, ctor: String): String =
  h match {
    case En(_, name, _, cases) => if (name == en) caseFieldTy2(cases, ctor) else caseFieldTy(rest, en, ctor)
  }

def caseFieldTy2(cs: List[EnCase], ctor: String): String =
  if (List.isEmpty(cs)) "" else caseFieldTy3(List.at(cs, 0), List.tail(cs), ctor)

def caseFieldTy3(h: EnCase, rest: List[EnCase], ctor: String): String =
  h match {
    case EnCase(name, fields) => if (name == ctor) firstFieldTy(fields) else caseFieldTy2(rest, ctor)
  }

def firstFieldTy(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else paramTyOf(List.at(ps, 0))

def paramTyOf(p: Param): String =
  p match {
    case Param(_, ty, _, _) => ty
  }

def hasComma(s: String): Bool =
  commaAt(s, 0) >= 0

def recFieldTys(ens: List[En], core: String): List[String] =
  recFieldTys2(dotAt(core, 0), core, ens)

def recFieldTys2(dot: Int, core: String, ens: List[En]): List[String] =
  if (dot < 0) enFieldTys(ens, core) else caseFieldTys(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def enFieldTys(ens: List[En], name: String): List[String] =
  if (List.isEmpty(ens)) noStr() else enFieldTys1(List.at(ens, 0), List.tail(ens), name)

def enFieldTys1(h: En, rest: List[En], name: String): List[String] =
  h match {
    case En(_, n, _, cases) => if (n == name) firstCaseTys(cases) else enFieldTys(rest, name)
  }

def firstCaseTys(cs: List[EnCase]): List[String] =
  if (List.isEmpty(cs)) noStr() else firstCaseTys1(List.at(cs, 0))

def firstCaseTys1(c: EnCase): List[String] =
  c match {
    case EnCase(_, fields) => paramTys(fields)
  }

def caseFieldTys(ens: List[En], en: String, ctor: String): List[String] =
  if (List.isEmpty(ens)) noStr() else caseFieldTys1(List.at(ens, 0), List.tail(ens), en, ctor)

def caseFieldTys1(h: En, rest: List[En], en: String, ctor: String): List[String] =
  h match {
    case En(_, name, _, cases) => if (name == en) caseFieldTys2(cases, ctor) else caseFieldTys(rest, en, ctor)
  }

def caseFieldTys2(cs: List[EnCase], ctor: String): List[String] =
  if (List.isEmpty(cs)) noStr() else caseFieldTys3(List.at(cs, 0), List.tail(cs), ctor)

def caseFieldTys3(h: EnCase, rest: List[EnCase], ctor: String): List[String] =
  h match {
    case EnCase(name, fields) => if (name == ctor) paramTys(fields) else caseFieldTys2(rest, ctor)
  }

def inferMethod(recv: Expr, name: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (name == "require") inferRequire(recv, args, env, funs, ens, e) else if (name == "flatMap") inferFlatMap(recv, args, env, funs, ens, e) else if (name == "handleErrorWith") inferHandle(recv, args, env, funs, ens, e) else if (name == "map") inferIoMap(recv, args, env, funs, ens, e) else if (name == "apply") inferApply(recv, args, env, funs, ens, e) else inferMethod2(recv, name, args, env, funs, ens, e)

def inferRequire(recv: Expr, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  inferRequire2(infer(recv, env, funs, ens), args, env, funs, ens, e)

def inferRequire2(o: Out, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (List.len(args) > 2) bad("require expects at most 2 args", exprSpan(env, e)) else inferRequirePred(o, requirePredExpr(args), env, funs, ens, e)

def requirePredExpr(args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EBool(true) else if (List.len(args) == 1) List.at(args, 0) else List.at(List.tail(args), 0)

def inferRequirePred(recv: Out, pred: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  pred match {
    case Expr.ELam(p, ty, body) => inferRequireLam(recv, infer(body, bindLam(p, requireBindTy(ty, tyStr(recv)), env), funs, ens), env, ens, e)
    case Expr.ENamed(_, inner) => inferRequirePred(recv, inner, env, funs, ens, e)
    case _ => inferRequirePredTy(recv, infer(pred, env, funs, ens), env, ens, e)
  }

def requireBindTy(ann: String, recvTy: String): String =
  if (ann != "") ann else if (isIo(recvTy)) ioOk(recvTy) else recvTy

def inferRequireLam(recv: Out, body: Out, env: List[(String, Ty)], ens: List[En], e: Expr): Out =
  if (hasErr(body)) body else if (tyStr(body) == "Bool" || isLooseEn(tyStr(body), ens)) okTy(recv.ty) else bad(Str.concat("require pred must be Bool, got ", tyStr(body)), exprSpan(env, e))

def inferRequirePredTy(recv: Out, po: Out, env: List[(String, Ty)], ens: List[En], e: Expr): Out =
  if (hasErr(po)) po else if (requirePredOk(tyStr(po), ens)) okTy(recv.ty) else bad(Str.concat("require pred must be Bool, IO[Bool], or A => Bool, got ", tyStr(po)), exprSpan(env, e))

def requirePredOk(ty: String, ens: List[En]): Bool =
  ty == "Bool" || isLooseEn(ty, ens) || isIo(ty) && (ioOk(ty) == "Bool" || isLooseEn(ioOk(ty), ens)) || isFunTy(ty) && (funRetOf(ty) == "Bool" || isLooseEn(funRetOf(ty), ens))

def inferApply(recv: Expr, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  recv match {
    case Expr.ELam(_, _, _) => inferApplyLam(recv, args, env, funs, ens, e)
    case _ => inferApply2(infer(recv, env, funs, ens), args, env, funs, ens, e)
  }

def inferApplyLam(lam: Expr, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (List.len(args) != 1) bad("apply expects 1 arg", exprSpan(env, e)) else inferApplyLam2(infer(stripNamed(List.at(args, 0)), env, funs, ens), lam, env, funs, ens, spanPick(exprSpan(env, stripNamed(List.at(args, 0))), exprSpan(env, e)))

def inferApplyLam2(a: Out, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], asp: (String, Int)): Out =
  if (hasErr(a)) a else inferApplyLam3(inferApplyExpected(lam, tyStr(a), env, funs, ens), tyStr(a), env, ens, asp)

def inferApplyExpected(lam: Expr, argTy: String, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  lam match {
    case Expr.ELam(p, ann, body) => if (ann == "") inferExpected(lam, Str.concat(argTy, " => B"), env, funs, ens) else infer(lam, env, funs, ens)
    case _ => infer(lam, env, funs, ens)
  }

def inferApplyLam3(lo: Out, argTy: String, env: List[(String, Ty)], ens: List[En], asp: (String, Int)): Out =
  if (hasErr(lo)) lo else if (tyEqEn(argTy, Type.show(Type.funArg(lo.ty)), ens)) okTy(Type.funRet(lo.ty)) else argMismatch("apply", Type.show(Type.funArg(lo.ty)), argTy, asp)

def inferApply2(o: Out, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (Type.isFun(o.ty) || isLooseTy(o.ty, ens)) inferFunApply(o.ty, args, env, funs, ens, exprSpan(env, e)) else bad(Str.concat("apply needs a function, got ", tyStr(o)), exprSpan(env, e))

def inferMethod2(recv: Expr, name: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  recv match {
    case Expr.EVar(en, _) => if (!Type.isEmpty(getTy(env, en))) inferCall(Str.concat(".", name), recv :: args, env, funs, ens, exprSpan(env, e)) else inferMethodEn(en, name, args, env, funs, ens, e)
    case _ => inferCall(Str.concat(".", name), recv :: args, env, funs, ens, exprSpan(env, e))
  }

def inferMethodEn(en: String, name: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  inferMethodQual(Str.concat(en, Str.concat(".", name)), en, name, args, env, funs, ens, e)

def inferMethodQual(q: String, en: String, name: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (isKit(q, funs)) inferCall(q, args, env, funs, ens, exprSpan(env, e)) else if (hasEn(ens, en)) inferNamedCtor(en, name, args, env, funs, ens, exprSpan(env, e), ens) else resolveQual(en, name, args, env, funs, ens, e)

def resolveQual(en: String, name: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  resolveQualHit(en, name, args, env, funs, ens, ftabGetMod(funs.tab, en, name), e)

def resolveQualHit(en: String, name: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], hit: List[Fun], e: Expr): Out =
  if (List.isEmpty(hit)) bad(Str.concat("unknown function ", Str.concat(en, Str.concat(".", name))), exprSpan(env, e)) else resolveUser(Str.concat(en, Str.concat(".", name)), args, env, funs, ens, exprSpan(env, e), hit)

def inferCtor(en: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  if (List.isEmpty(args)) ok(en) else inferCtorHead(en, List.at(args, 0), List.tail(args), env, funs, ens)

def inferCtorHead(en: String, h: Expr, rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  inferCtorFrom(en, infer(h, env, funs, ens), rest, env, funs, ens)

def inferCtorFrom(en: String, o: Out, rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  if (hasErr(o)) o else inferCtorRest(en, o, firstArgErr(rest, env, funs, ens), ens)

def inferCtorRest(en: String, o: Out, restErr: Out, ens: List[En]): Out =
  if (hasErr(restErr)) restErr else inferCtor2(en, o, ens)

def inferCtor2(en: String, o: Out, ens: List[En]): Out =
  if (hasErr(o)) o else if (enHasParams(ens, en)) ok(Str.concat(en, Str.concat("[", Str.concat(tyStr(o), "]")))) else ok(en)

def enHasParams(ens: List[En], name: String): Bool =
  if (List.isEmpty(ens)) false else enHasParams1(List.at(ens, 0), List.tail(ens), name)

def enHasParams1(h: En, rest: List[En], name: String): Bool =
  h match {
    case En(_, n, tps, _) => if (n == name) List.len(tps) > 0 else enHasParams(rest, name)
  }

def isIo(t: String): Bool =
  Type.isIoStr(t)

def ioErr(t: String): String =
  Type.show(Type.ioErr(Type.parse(t)))

def ioOk(t: String): String =
  Type.show(Type.ioOk(Type.parse(t)))

def ioTy(e: String, a: String): String =
  if (e == "" || e == "String") Str.concat("IO[", Str.concat(a, "]")) else Str.concat("IO[", Str.concat(e, Str.concat(", ", Str.concat(a, "]"))))

def unifyErr(a: String, b: String, span: (String, Int), ens: List[En]): Out =
  if (a == "") ok(if (b == "") "String" else b) else if (b == "") ok(a) else if (tyEqEn(a, b, ens)) ok(preferEn(a, b, ens)) else bad(Str.concat("fail type mismatch: expected ", Str.concat(a, Str.concat(", got ", b))), span)

def inferFlatMap(recv: Expr, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  inferFlatMap2(infer(recv, env, funs, ens), args, env, funs, ens, e)

def inferIoMap(recv: Expr, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  inferIoMap2(infer(recv, env, funs, ens), recv, args, env, funs, ens, e)

def inferIoMap2(o: Out, recv: Expr, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (!isIo(tyStr(o))) inferMethod2(recv, "map", args, env, funs, ens, e) else if (List.len(args) != 1) bad(Str.concat("map expects 1 args, got ", Str.fromInt(List.len(args))), exprSpan(env, e)) else inferIoMapLam(o, List.at(args, 0), env, funs, ens, e)

def inferIoMapLam(recv: Out, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  lam match {
    case Expr.ELam(p, ty, body) => inferIoMapAnn(annOk(ty, ioPayload(tyStr(recv)), exprSpan(env, e), ens), recv, p, body, env, funs, ens, e)
    case Expr.EMatch(_, _, _) => inferIoMap3(recv, infer(lam, env, funs, ens), env, e)
    case _ => bad("map needs a lambda", exprSpan(env, e))
  }

def inferIoMapAnn(a: Out, recv: Out, p: String, body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (hasErr(a)) a else inferIoMap3(recv, infer(body, bindIo(p, tyStr(recv), env), funs, ens), env, e)

def inferIoMap3(recv: Out, body: Out, env: List[(String, Ty)], e: Expr): Out =
  if (hasErr(body)) body else ok(ioTy(ioErr(tyStr(recv)), tyStr(body)))

def inferFlatMap2(o: Out, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (List.len(args) != 1) bad(Str.concat("flatMap expects 1 args, got ", Str.fromInt(List.len(args))), exprSpan(env, e)) else inferFlatMapLam(o, List.at(args, 0), env, funs, ens, e)

def inferFlatMapLam(recv: Out, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  lam match {
    case Expr.ELam(p, ty, body) => inferFlatMapAnn(annOk(ty, ioPayload(tyStr(recv)), exprSpan(env, e), ens), recv, p, body, env, funs, ens, e)
    case _ => inferFlatMap3(recv, infer(lam, env, funs, ens), env, ens, e)
  }

def inferFlatMapAnn(a: Out, recv: Out, p: String, body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (hasErr(a)) a else inferFlatMap3(recv, infer(body, bindIo(p, tyStr(recv), env), funs, ens), env, ens, e)

def bindIo(p: String, ioTy: String, env: List[(String, Ty)]): List[(String, Ty)] =
  envBind(p, ioPayload(ioTy), env)

def ioPayload(t: String): String =
  if (isIo(t)) ioOk(t) else "A"

def inferFlatMap3(recv: Out, body: Out, env: List[(String, Ty)], ens: List[En], e: Expr): Out =
  if (hasErr(body)) body else inferFlatMap4(recv, body, env, ens, e)

def inferFlatMap4(recv: Out, body: Out, env: List[(String, Ty)], ens: List[En], e: Expr): Out =
  if (isIo(tyStr(recv)) && isIo(tyStr(body))) inferFlatMapErr(recv, body, env, ens, e) else if (isIo(tyStr(recv)) && isLooseEn(tyStr(body), ens)) okTy(recv.ty) else if (isLooseEn(tyStr(recv), ens)) ok(if (isIo(tyStr(body))) tyStr(body) else "IO[A]") else bad(Str.concat("flatMap needs IO, got ", Str.concat(tyStr(recv), Str.concat(" and ", tyStr(body)))), exprSpan(env, e))

def inferFlatMapErr(recv: Out, body: Out, env: List[(String, Ty)], ens: List[En], e: Expr): Out =
  inferFlatMapErr2(unifyErr(ioErr(tyStr(recv)), ioErr(tyStr(body)), exprSpan(env, e), ens), recv, body)

def inferFlatMapErr2(u: Out, recv: Out, body: Out): Out =
  if (hasErr(u)) u else ok(ioTy(tyStr(u), ioOk(tyStr(body))))

def inferHandle(recv: Expr, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  inferHandle2(infer(recv, env, funs, ens), args, env, funs, ens, e)

def inferHandle2(o: Out, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (hasErr(o)) o else if (List.len(args) != 1) bad(Str.concat("handleErrorWith expects 1 args, got ", Str.fromInt(List.len(args))), exprSpan(env, e)) else inferHandleLam(o, List.at(args, 0), env, funs, ens, e)

def inferHandleLam(recv: Out, lam: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  lam match {
    case Expr.ELam(p, ty, body) => inferHandleAnn(annOk(ty, ioErr(tyStr(recv)), exprSpan(env, e), ens), recv, p, body, env, funs, ens, e)
    case _ => inferHandle3(recv, infer(lam, env, funs, ens), env, ens, e)
  }

def inferHandleAnn(a: Out, recv: Out, p: String, body: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], e: Expr): Out =
  if (hasErr(a)) a else inferHandle3(recv, infer(body, bindHandle(p, tyStr(recv), env), funs, ens), env, ens, e)

def bindHandle(p: String, ioTy: String, env: List[(String, Ty)]): List[(String, Ty)] =
  envBind(p, ioErr(ioTy), env)

def inferHandle3(recv: Out, body: Out, env: List[(String, Ty)], ens: List[En], e: Expr): Out =
  if (hasErr(body)) body else if (isIo(tyStr(recv)) && isIo(tyStr(body))) inferHandleOk(recv, body, env, ens, e) else if (isIo(tyStr(recv)) && isLooseEn(tyStr(body), ens)) okTy(recv.ty) else bad(Str.concat("handleErrorWith needs IO, got ", Str.concat(tyStr(recv), Str.concat(" and ", tyStr(body)))), exprSpan(env, e))

def inferHandleOk(recv: Out, body: Out, env: List[(String, Ty)], ens: List[En], e: Expr): Out =
  if (tyEqEn(ioOk(tyStr(recv)), ioOk(tyStr(body)), ens)) ok(ioTy(ioErr(tyStr(body)), preferEn(ioOk(tyStr(recv)), ioOk(tyStr(body)), ens))) else bad(Str.concat("handleErrorWith type mismatch: expected ", Str.concat(ioOk(tyStr(recv)), Str.concat(", got ", ioOk(tyStr(body))))), exprSpan(env, e))

def inferVar(s: String, env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  inferVar2(s, lookupEnv(env, s), env, funs, ens, span)

def inferVar2(s: String, t: Ty, env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (s == "") bad("unexpected token", span) else if (Type.show(t) == "") inferVarFun(s, findFunPrefer(funs, s, env), ens, span) else varOut(t, s, ens)

def inferVarFun(s: String, hit: List[Fun], ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(hit)) inferVarCase(s, ens, span) else okTy(funTyOf(List.at(hit, 0)))

def inferVarCase(s: String, ens: List[En], span: (String, Int)): Out =
  if (enOfCase(ens, s) == "") bad(Str.concat("unbound variable ", s), span) else ok(enOfCase(ens, s))

def funTyOf(d: Fun): Ty =
  d match {
    case Fun(_, _, _, _, ps, ret, _, _, _) => Type.funFromTy(paramTys(ps), ret)
  }

def funTyFrom(ps: List[String], ret: String): String =
  Type.funFrom(ps, ret)

def inferList(xs: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  if (List.isEmpty(xs)) ok("List") else inferListRest(infer(List.at(xs, 0), env, funs, ens), List.tail(xs), env, funs, ens)

def inferListRest(head: Out, rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  if (hasErr(head)) head else if (List.isEmpty(rest)) inferList2(head) else inferListNext(head, infer(List.at(rest, 0), env, funs, ens), rest, env, funs, ens)

def inferListNext(head: Out, next: Out, rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  if (hasErr(next)) next else if (!tyEq(head.ty, next.ty, ens)) argMismatch("list element", tyStr(head), tyStr(next), exprSpan(env, List.at(rest, 0))) else inferListRest(retTy(bindOrigin(bindOrigin(andBinds(head, next), head.origin, head.ty, next.ty, ens, exprSpan(env, List.at(rest, 0))), next.origin, next.ty, head.ty, ens, exprSpan(env, List.at(rest, 0))), preferTy(head.ty, next.ty, ens)), List.tail(rest), env, funs, ens)

def inferList2(o: Out): Out =
  if (hasErr(o)) o else ret(o, Str.concat("List[", Str.concat(tyStr(o), "]")))

def inferTuple(xs: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En]): Out =
  inferTupleAcc(xs, env, funs, ens, "")

def inferTupleAcc(xs: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], acc: String): Out =
  if (List.isEmpty(xs)) inferTupleDone(acc) else inferTupleHd(List.at(xs, 0), xs, env, funs, ens, acc)

def inferTupleDone(acc: String): Out =
  if (acc == "") ok("Unit") else ok(Str.concat("(", Str.concat(acc, ")")))

def inferTupleHd(h: Expr, xs: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], acc: String): Out =
  inferTupleGot(infer(stripNamed(h), env, funs, ens), xs, env, funs, ens, acc)

def inferTupleGot(o: Out, xs: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], acc: String): Out =
  if (hasErr(o)) o else inferTupleRest(List.tail(xs), env, funs, ens, if (acc == "") tyStr(o) else Str.concat(acc, Str.concat(", ", tyStr(o))))

def inferTupleRest(rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], acc: String): Out =
  inferTupleAcc(rest, env, funs, ens, acc)

def checkDef(d: Fun, funs: Ftab, ens: List[En]): Out =
  d match {
    case Fun(_, ora, name, ts, ps, ret, body, mod, off) => checkDefTypes(ora, name, ts, ps, ret, body, mod, off, funs, pinEns(ens, ts))
  }

def checkDefTypes(ora: Bool, name: String, ts: List[String], ps: List[Param], ret: String, body: Expr, mod: String, off: Int, funs: Ftab, ens: List[En]): Out =
  checkTyList(ps, ens, ts, (mod, off)) match {
    case Out(_, err, span, _, _) => if (err != "") bad(err, span) else checkDefRet(ora, name, ts, ps, ret, body, mod, off, funs, ens)
  }

def checkDefRet(ora: Bool, name: String, ts: List[String], ps: List[Param], ret: String, body: Expr, mod: String, off: Int, funs: Ftab, ens: List[En]): Out =
  if (!knownTy(Type.parse(ret), ens, ts)) bad(Str.concat("unknown type ", ret), (mod, off)) else checkDefOra(ora, name, ret, body, ps, funs, ens, ts, mod, off)

def checkTyList(ps: List[Param], ens: List[En], ts: List[String], span: (String, Int)): Out =
  if (List.isEmpty(ps)) ok("Unit") else checkTyParam(List.at(ps, 0), List.tail(ps), ens, ts, span)

def checkTyParam(p: Param, rest: List[Param], ens: List[En], ts: List[String], span: (String, Int)): Out =
  p match {
    case Param(_, ty, _, _) => if (!knownTy(Type.parse(ty), ens, ts)) bad(Str.concat("unknown type ", ty), span) else checkTyList(rest, ens, ts, span)
  }

def knownTy(t: Ty, ens: List[En], ts: List[String]): Bool =
  t match {
    case Ty.TVar(_) => true
    case Ty.Named(n) => builtinTyName(n) || hasEn(ens, n) || List.contains(ts, n)
    case Ty.App(n, args) => (builtinTyName(n) || hasEn(ens, n) || List.contains(ts, n)) && knownTys(args, ens, ts)
    case Ty.Tuple(parts) => knownTys(parts, ens, ts)
    case Ty.Arrow(arg, ret) => knownTy(arg, ens, ts) && knownTy(ret, ens, ts)
  }

def knownTys(ts0: List[Ty], ens: List[En], ts: List[String]): Bool =
  if (List.isEmpty(ts0)) true else knownTy(List.at(ts0, 0), ens, ts) && knownTys(List.tail(ts0), ens, ts)

def builtinTyName(n: String): Bool =
  n == "Any" || n == "Bool" || n == "Builder" || n == "Bytes" || n == "Deferred" || n == "Fiber" || n == "Float" || n == "IO" || n == "Int" || n == "Json" || n == "List" || n == "Map" || n == "Option" || n == "Queue" || n == "Ref" || n == "Resource" || n == "Result" || n == "Set" || n == "Signal" || n == "Stream" || n == "String" || n == "Tcp" || n == "Timeline" || n == "Udp" || n == "Unit" || n == "Verdict" || n == "View"

def builtinTyArity(n: String): Int =
  if (n == "Map" || n == "Result") 2 else if (n == "List" || n == "Option" || n == "Set" || n == "Ref" || n == "Queue" || n == "Deferred" || n == "Fiber" || n == "Stream" || n == "Resource" || n == "Signal") 1 else 0

def enumTyArity(ens: List[En], n: String): Int =
  if (List.isEmpty(ens)) 0 - 1 else enumTyArityAt(List.at(ens, 0), List.tail(ens), n)

def enumTyArityAt(en: En, rest: List[En], n: String): Int =
  en match {
    case En(_, name, ts, _) => if (name == n) List.len(ts) else enumTyArity(rest, n)
  }

def aliasTyArity(aliases: List[Alias], n: String): Int =
  if (List.isEmpty(aliases)) 0 - 1 else aliasTyArityAt(List.at(aliases, 0), List.tail(aliases), n)

def aliasTyArityAt(a: Alias, rest: List[Alias], n: String): Int =
  a match {
    case Alias(name, ts, _) => if (name == n) List.len(ts) else aliasTyArity(rest, n)
  }

def arityMsg(n: String, want: Int): String =
  Str.concat(n, Str.concat(" expects ", Str.concat(Str.fromInt(want), if (want == 1) " type arg" else " type args")))

def typeArityError(t: Ty, ens: List[En], aliases: List[Alias], ts: List[String]): String =
  t match {
    case Ty.TVar(_) => ""
    case Ty.Named(_) => ""
    case Ty.App(n, args) => appArityError(n, args, ens, aliases, ts)
    case Ty.Tuple(parts) => typeArityErrors(parts, ens, aliases, ts)
    case Ty.Arrow(arg, ret) => typeArityArrow(typeArityError(arg, ens, aliases, ts), ret, ens, aliases, ts)
  }

def typeArityArrow(err: String, ret: Ty, ens: List[En], aliases: List[Alias], ts: List[String]): String =
  if (err != "") err else typeArityError(ret, ens, aliases, ts)

def typeArityErrors(types: List[Ty], ens: List[En], aliases: List[Alias], ts: List[String]): String =
  if (List.isEmpty(types)) "" else typeArityErrorsNext(typeArityError(List.at(types, 0), ens, aliases, ts), List.tail(types), ens, aliases, ts)

def typeArityErrorsNext(err: String, rest: List[Ty], ens: List[En], aliases: List[Alias], ts: List[String]): String =
  if (err != "") err else typeArityErrors(rest, ens, aliases, ts)

def appArityError(n: String, args: List[Ty], ens: List[En], aliases: List[Alias], ts: List[String]): String =
  if (enumTyArity(ens, n) >= 0) appArityFixed(n, List.len(args), enumTyArity(ens, n), args, ens, aliases, ts) else if (aliasTyArity(aliases, n) >= 0) appArityFixed(n, List.len(args), aliasTyArity(aliases, n), args, ens, aliases, ts) else if (n == "IO") appArityIo(args, ens, aliases, ts) else if (builtinTyName(n)) appArityFixed(n, List.len(args), builtinTyArity(n), args, ens, aliases, ts) else if (Type.isTyParam(n) || List.contains(ts, n)) Str.concat("type parameter ", Str.concat(n, " cannot take type args")) else ""

def appArityFixed(n: String, got: Int, want: Int, args: List[Ty], ens: List[En], aliases: List[Alias], ts: List[String]): String =
  if (got != want) arityMsg(n, want) else typeArityErrors(args, ens, aliases, ts)

def appArityIo(args: List[Ty], ens: List[En], aliases: List[Alias], ts: List[String]): String =
  if (List.len(args) != 1 && List.len(args) != 2) "IO expects 1 or 2 type args" else typeArityErrors(args, ens, aliases, ts)

def checkDefOra(ora: Bool, name: String, ret: String, body: Expr, ps: List[Param], funs: Ftab, ens: List[En], ts: List[String], mod: String, off: Int): Out =
  if (ora && ret != "Bool") bad(Str.concat("oracle ", Str.concat(name, " must return Bool")), (mod, off)) else checkDefGo(name, ret, body, ps, funs, ens, ts, mod, off)

def checkDefGo(name: String, ret: String, body: Expr, ps: List[Param], funs: Ftab, ens: List[En], ts: List[String], mod: String, off: Int): Out =
  checkDefWhere(name, ret, body, ps, funs, ens, ts, mod, off, checkWheres(ps, bindParams(ps, envSelfMod(mod)), funs, ens, (mod, off)))

def checkDefWhere(name: String, ret: String, body: Expr, ps: List[Param], funs: Ftab, ens: List[En], ts: List[String], mod: String, off: Int, wo: Out): Out =
  if (hasErr(wo)) checkDefWrap(name, ret, body, wo, (mod, off), ens, ts) else checkDefWrap(name, ret, body, inferExpected(body, ret, bindParams(ps, envSelfMod(mod)), funs, ens), (mod, off), ens, ts)

def checkWheres(ps: List[Param], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(ps)) ok("Bool") else checkWhereHd(List.at(ps, 0), List.tail(ps), env, funs, ens, span)

def checkWhereHd(p: Param, rest: List[Param], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  p match {
    case Param(n, _, w, _) => checkWhereGo(n, w, rest, env, funs, ens, span)
  }

def checkWhereGo(n: String, w: String, rest: List[Param], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (w == "") checkWheres(rest, env, funs, ens, span) else checkWhereTy(infer(dfltExpr(w), env, funs, ens), n, rest, env, funs, ens, span)

def checkWhereTy(o: Out, n: String, rest: List[Param], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (hasErr(o)) o else if (tyStr(o) == "Bool") checkWheres(rest, env, funs, ens, span) else bad(Str.concat("where on ", Str.concat(n, Str.concat(" must be Bool, got ", tyStr(o)))), span)

def checkEns(ens: List[En], names: List[String], funs: Ftab): Out =
  checkEnsGo(ens, ens, names, funs)

def checkEnsGo(rest: List[En], ens: List[En], names: List[String], funs: Ftab): Out =
  if (List.isEmpty(rest)) ok("Bool") else checkEnHd(List.at(rest, 0), List.tail(rest), ens, names, funs)

def checkEnHd(h: En, rest: List[En], ens: List[En], names: List[String], funs: Ftab): Out =
  h match {
    case En(_, _, ts, cases) => checkEnsAfter(checkEnCases(cases, ens, List.concat(ts, names), funs), rest, ens, names, funs)
  }

def checkEnsAfter(o: Out, rest: List[En], ens: List[En], names: List[String], funs: Ftab): Out =
  if (hasErr(o)) o else checkEnsGo(rest, ens, names, funs)

def checkEnCases(cs: List[EnCase], ens: List[En], ts: List[String], funs: Ftab): Out =
  if (List.isEmpty(cs)) ok("Bool") else checkEnCaseHd(List.at(cs, 0), List.tail(cs), ens, ts, funs)

def checkEnCaseHd(c: EnCase, rest: List[EnCase], ens: List[En], ts: List[String], funs: Ftab): Out =
  c match {
    case EnCase(_, fs) => checkEnCaseTypes(checkTyList(fs, ens, ts, noSpan()), fs, rest, ens, ts, funs)
  }

def checkEnCaseTypes(o: Out, fs: List[Param], rest: List[EnCase], ens: List[En], ts: List[String], funs: Ftab): Out =
  if (hasErr(o)) o else checkEnCasesAfter(checkWheres(fs, bindParams(fs, noEnv()), funs, ens, noSpan()), rest, ens, ts, funs)

def checkEnCasesAfter(o: Out, rest: List[EnCase], ens: List[En], ts: List[String], funs: Ftab): Out =
  if (hasErr(o)) o else checkEnCases(rest, ens, ts, funs)

def checkDefWrap(name: String, ret: String, body: Expr, o: Out, span: (String, Int), ens: List[En], ts: List[String]): Out =
  if (hasErr(o)) bad(Str.concat("in ", Str.concat(name, Str.concat(": ", o.err))), o.span) else checkDefGot(name, ret, body, o, span, ens, ts)

def checkDefGot(name: String, ret: String, body: Expr, o: Out, span: (String, Int), ens: List[En], ts: List[String]): Out =
  if (hasErr(o)) o else if (tyEqParams(tyStr(o), ret, ens, ts)) bindOrigin(o, o.origin, o.ty, Type.parse(ret), ens, span) else bad(Str.concat("def ", Str.concat(name, Str.concat(" body ", Str.concat(tyStr(o), Str.concat(" does not match declared ", ret))))), spanPick(Parse.spanOf(body), span))

def tyEqParams(a: String, b: String, ens: List[En], ts: List[String]): Bool =
  eqPinned(a, b, List.concat(ts, enNames(ens)))

def spanPick(a: (String, Int), b: (String, Int)): (String, Int) =
  a match {
    case (sa, oa) => b match {
  case (sb, _) => if (oa < 0) b else (if (sa == "") sb else sa, oa)
}
  }

def checkProgOwn(p: Prog, stems: List[String]): Out =
  checkProgArities(checkTypeArities(p, stems), p, stems)

def checkProgArities(o: Out, p: Prog, stems: List[String]): Out =
  if (hasErr(o)) o else checkProgAliases(checkAliases(p.aliases, Parse.builtins(p.enums), aliasNames(p.aliases)), p, stems)

def checkTypeArities(p: Prog, stems: List[String]): Out =
  checkArityAliasesNext(checkArityAliases(p.aliases, p.enums, p.aliases), p, stems)

def checkArityAliasesNext(o: Out, p: Prog, stems: List[String]): Out =
  if (hasErr(o)) o else checkArityEnumsNext(checkArityEnums(p.enums, p.enums, p.aliases), p, stems)

def checkArityEnumsNext(o: Out, p: Prog, stems: List[String]): Out =
  if (hasErr(o)) o else checkArityTraitsNext(checkArityTraits(p.traits, p.enums, p.aliases), p, stems)

def checkArityTraitsNext(o: Out, p: Prog, stems: List[String]): Out =
  if (hasErr(o)) o else checkArityImplsNext(checkArityImpls(p.impls, p.enums, p.aliases), p, stems)

def checkArityImplsNext(o: Out, p: Prog, stems: List[String]): Out =
  if (hasErr(o)) o else checkArityMain(checkArityDefs(p.defs, stems, p.enums, p.aliases), p)

def checkArityMain(o: Out, p: Prog): Out =
  if (hasErr(o)) o else checkExprTypes(p.body, p.enums, p.aliases, [], noSpan())

def checkArityTy(ty: String, ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  checkArityTyError(typeArityError(Type.parse(ty), ens, aliases, ts), span)

def checkArityTyError(err: String, span: (String, Int)): Out =
  if (err == "") ok("Unit") else bad(err, span)

def checkArityParams(ps: List[Param], ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (List.isEmpty(ps)) ok("Unit") else checkArityParam(List.at(ps, 0), List.tail(ps), ens, aliases, ts, span)

def checkArityParam(p: Param, rest: List[Param], ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  p match {
    case Param(_, ty, _, _) => checkArityParamsNext(checkArityTy(ty, ens, aliases, ts, span), rest, ens, aliases, ts, span)
  }

def checkArityParamsNext(o: Out, rest: List[Param], ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (hasErr(o)) o else checkArityParams(rest, ens, aliases, ts, span)

def checkArityStrings(types: List[String], ens: List[En], aliases: List[Alias]): Out =
  if (List.isEmpty(types)) ok("Unit") else checkArityStringsNext(checkArityTy(List.at(types, 0), ens, aliases, [], noSpan()), List.tail(types), ens, aliases)

def checkArityStringsNext(o: Out, rest: List[String], ens: List[En], aliases: List[Alias]): Out =
  if (hasErr(o)) o else checkArityStrings(rest, ens, aliases)

def checkArityAliases(rest: List[Alias], ens: List[En], aliases: List[Alias]): Out =
  if (List.isEmpty(rest)) ok("Unit") else checkArityAlias(List.at(rest, 0), List.tail(rest), ens, aliases)

def checkArityAlias(a: Alias, rest: List[Alias], ens: List[En], aliases: List[Alias]): Out =
  a match {
    case Alias(_, ts, target) => checkArityAliasesAfter(checkArityTy(target, ens, aliases, ts, noSpan()), rest, ens, aliases)
  }

def checkArityAliasesAfter(o: Out, rest: List[Alias], ens: List[En], aliases: List[Alias]): Out =
  if (hasErr(o)) o else checkArityAliases(rest, ens, aliases)

def checkArityEnums(rest: List[En], ens: List[En], aliases: List[Alias]): Out =
  if (List.isEmpty(rest)) ok("Unit") else checkArityEnum(List.at(rest, 0), List.tail(rest), ens, aliases)

def checkArityEnum(en: En, rest: List[En], ens: List[En], aliases: List[Alias]): Out =
  en match {
    case En(_, _, ts, cases) => checkArityEnumsAfter(checkArityCases(cases, ens, aliases, ts), rest, ens, aliases)
  }

def checkArityEnumsAfter(o: Out, rest: List[En], ens: List[En], aliases: List[Alias]): Out =
  if (hasErr(o)) o else checkArityEnums(rest, ens, aliases)

def checkArityCases(cases: List[EnCase], ens: List[En], aliases: List[Alias], ts: List[String]): Out =
  if (List.isEmpty(cases)) ok("Unit") else checkArityCase(List.at(cases, 0), List.tail(cases), ens, aliases, ts)

def checkArityCase(c: EnCase, rest: List[EnCase], ens: List[En], aliases: List[Alias], ts: List[String]): Out =
  c match {
    case EnCase(_, ps) => checkArityCasesAfter(checkArityParams(ps, ens, aliases, ts, noSpan()), rest, ens, aliases, ts)
  }

def checkArityCasesAfter(o: Out, rest: List[EnCase], ens: List[En], aliases: List[Alias], ts: List[String]): Out =
  if (hasErr(o)) o else checkArityCases(rest, ens, aliases, ts)

def checkArityTraits(rest: List[Tr], ens: List[En], aliases: List[Alias]): Out =
  if (List.isEmpty(rest)) ok("Unit") else checkArityTrait(List.at(rest, 0), List.tail(rest), ens, aliases)

def checkArityTrait(t: Tr, rest: List[Tr], ens: List[En], aliases: List[Alias]): Out =
  t match {
    case Tr(_, ts, methods) => checkArityTraitsAfter(checkArityTraitMethods(methods, ens, aliases, ts), rest, ens, aliases)
  }

def checkArityTraitsAfter(o: Out, rest: List[Tr], ens: List[En], aliases: List[Alias]): Out =
  if (hasErr(o)) o else checkArityTraits(rest, ens, aliases)

def checkArityTraitMethods(methods: List[TrMethod], ens: List[En], aliases: List[Alias], ts: List[String]): Out =
  if (List.isEmpty(methods)) ok("Unit") else checkArityTraitMethod(List.at(methods, 0), List.tail(methods), ens, aliases, ts)

def checkArityTraitMethod(m: TrMethod, rest: List[TrMethod], ens: List[En], aliases: List[Alias], ts: List[String]): Out =
  m match {
    case TrMethod(_, ps, ret) => checkArityTraitMethodRet(checkArityParams(ps, ens, aliases, ts, noSpan()), ret, rest, ens, aliases, ts)
  }

def checkArityTraitMethodRet(o: Out, ret: String, rest: List[TrMethod], ens: List[En], aliases: List[Alias], ts: List[String]): Out =
  if (hasErr(o)) o else checkArityTraitMethodsAfter(checkArityTy(ret, ens, aliases, ts, noSpan()), rest, ens, aliases, ts)

def checkArityTraitMethodsAfter(o: Out, rest: List[TrMethod], ens: List[En], aliases: List[Alias], ts: List[String]): Out =
  if (hasErr(o)) o else checkArityTraitMethods(rest, ens, aliases, ts)

def checkArityImpls(impls: List[Im], ens: List[En], aliases: List[Alias]): Out =
  if (List.isEmpty(impls)) ok("Unit") else checkArityImpl(List.at(impls, 0), List.tail(impls), ens, aliases)

def checkArityImpl(im: Im, rest: List[Im], ens: List[En], aliases: List[Alias]): Out =
  im match {
    case Im(_, args, forTy, methods) => checkArityImplArgs(checkArityStrings(args, ens, aliases), forTy, methods, rest, ens, aliases)
  }

def checkArityImplArgs(o: Out, forTy: String, methods: List[Fun], rest: List[Im], ens: List[En], aliases: List[Alias]): Out =
  if (hasErr(o)) o else checkArityImplFor(checkArityTy(forTy, ens, aliases, [], noSpan()), methods, rest, ens, aliases)

def checkArityImplFor(o: Out, methods: List[Fun], rest: List[Im], ens: List[En], aliases: List[Alias]): Out =
  if (hasErr(o)) o else checkArityImplMethods(checkArityDefs(methods, [], ens, aliases), rest, ens, aliases)

def checkArityImplMethods(o: Out, rest: List[Im], ens: List[En], aliases: List[Alias]): Out =
  if (hasErr(o)) o else checkArityImpls(rest, ens, aliases)

def checkArityDefs(defs: List[Fun], stems: List[String], ens: List[En], aliases: List[Alias]): Out =
  if (List.isEmpty(defs)) ok("Unit") else checkArityDefHd(List.at(defs, 0), List.tail(defs), stems, ens, aliases)

def checkArityDefHd(d: Fun, rest: List[Fun], stems: List[String], ens: List[En], aliases: List[Alias]): Out =
  if (d.name == "#parse" || !inStems(stems, d.mod)) checkArityDefs(rest, stems, ens, aliases) else checkArityDefsAfter(checkArityDef(d, ens, aliases), rest, stems, ens, aliases)

def checkArityDefsAfter(o: Out, rest: List[Fun], stems: List[String], ens: List[En], aliases: List[Alias]): Out =
  if (hasErr(o)) o else checkArityDefs(rest, stems, ens, aliases)

def checkArityDef(d: Fun, ens: List[En], aliases: List[Alias]): Out =
  checkArityDefBody(checkArityDefRet(checkArityParams(d.params, ens, aliases, d.tparams, (d.mod, d.off)), d.ret, ens, aliases, d.tparams, (d.mod, d.off)), d, ens, aliases)

def checkArityDefBody(o: Out, d: Fun, ens: List[En], aliases: List[Alias]): Out =
  if (hasErr(o)) o else checkExprTypes(d.body, ens, aliases, d.tparams, (d.mod, d.off))

def checkArityDefRet(o: Out, ret: String, ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (hasErr(o)) o else checkArityTy(ret, ens, aliases, ts, span)

def checkExprType(ty: String, ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (ty == "") ok("Unit") else checkExprTypeKnown(checkArityTy(ty, ens, aliases, ts, span), ty, ens, aliases, ts, span)

def checkExprTypeKnown(o: Out, ty: String, ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (hasErr(o)) o else if (knownTy(Type.parse(ty), ens, List.concat(ts, aliasNames(aliases)))) ok("Unit") else bad(Str.concat("unknown type ", ty), span)

def checkExprTypes(e: Expr, ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  e match {
    case Expr.EAscribe(inner, ty, _) => checkExprTypesNext(checkExprType(ty, ens, aliases, ts, span), inner, ens, aliases, ts, span)
    case Expr.ELam(_, ty, body) => checkExprTypesNext(checkExprType(ty, ens, aliases, ts, span), body, ens, aliases, ts, span)
    case Expr.EPrint(inner, _) => checkExprTypes(inner, ens, aliases, ts, span)
    case Expr.ECall(_, args, _) => checkExprTypesList(args, ens, aliases, ts, span)
    case Expr.EMethod(recv, _, args, _) => checkExprTypesAfter(checkExprTypes(recv, ens, aliases, ts, span), args, ens, aliases, ts, span)
    case Expr.EField(recv, _, _) => checkExprTypes(recv, ens, aliases, ts, span)
    case Expr.EBin(_, l, r, _) => checkExprTypesNext(checkExprTypes(l, ens, aliases, ts, span), r, ens, aliases, ts, span)
    case Expr.EUn(_, inner, _) => checkExprTypes(inner, ens, aliases, ts, span)
    case Expr.EIf(c, t, el, _) => checkExprTypesIf(checkExprTypes(c, ens, aliases, ts, span), t, el, ens, aliases, ts, span)
    case Expr.EMatch(s, arms, _) => checkExprTypesArmsNext(checkExprTypes(s, ens, aliases, ts, span), arms, ens, aliases, ts, span)
    case Expr.EFor(bs, body, _) => checkExprTypesFor(checkExprTypesBinds(bs, ens, aliases, ts, span), body, ens, aliases, ts, span)
    case Expr.EList(xs) => checkExprTypesList(xs, ens, aliases, ts, span)
    case Expr.ETuple(xs) => checkExprTypesList(xs, ens, aliases, ts, span)
    case Expr.ENamed(_, inner) => checkExprTypes(inner, ens, aliases, ts, span)
    case _ => ok("Unit")
  }

def checkExprTypesNext(o: Out, e: Expr, ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (hasErr(o)) o else checkExprTypes(e, ens, aliases, ts, span)

def checkExprTypesAfter(o: Out, xs: List[Expr], ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (hasErr(o)) o else checkExprTypesList(xs, ens, aliases, ts, span)

def checkExprTypesIf(o: Out, t: Expr, el: Expr, ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (hasErr(o)) o else checkExprTypesNext(checkExprTypes(t, ens, aliases, ts, span), el, ens, aliases, ts, span)

def checkExprTypesList(xs: List[Expr], ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (List.isEmpty(xs)) ok("Unit") else checkExprTypesAfter(checkExprTypes(List.at(xs, 0), ens, aliases, ts, span), List.tail(xs), ens, aliases, ts, span)

def checkExprTypesArmsNext(o: Out, arms: List[Arm], ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (hasErr(o)) o else checkExprTypesArms(arms, ens, aliases, ts, span)

def checkExprTypesArms(arms: List[Arm], ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (List.isEmpty(arms)) ok("Unit") else checkExprTypesArm(List.at(arms, 0), List.tail(arms), ens, aliases, ts, span)

def checkExprTypesArm(arm: Arm, rest: List[Arm], ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  arm match {
    case Arm(_, _, body) => checkExprTypesArmsNext(checkExprTypes(body, ens, aliases, ts, span), rest, ens, aliases, ts, span)
  }

def checkExprTypesFor(o: Out, body: Expr, ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (hasErr(o)) o else checkExprTypes(body, ens, aliases, ts, span)

def checkExprTypesBinds(bs: List[Bind], ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (List.isEmpty(bs)) ok("Unit") else checkExprTypesBind(List.at(bs, 0), List.tail(bs), ens, aliases, ts, span)

def checkExprTypesBind(b: Bind, rest: List[Bind], ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  b match {
    case Bind(_, _, value) => checkExprTypesBindsNext(checkExprTypes(value, ens, aliases, ts, span), rest, ens, aliases, ts, span)
  }

def checkExprTypesBindsNext(o: Out, rest: List[Bind], ens: List[En], aliases: List[Alias], ts: List[String], span: (String, Int)): Out =
  if (hasErr(o)) o else checkExprTypesBinds(rest, ens, aliases, ts, span)

def checkProgAliases(o: Out, p: Prog, stems: List[String]): Out =
  if (hasErr(o)) o else checkProgTraits(checkTraits(p.traits, Parse.builtins(p.enums), aliasNames(p.aliases)), p, stems)

def checkProgTraits(o: Out, p: Prog, stems: List[String]): Out =
  if (hasErr(o)) o else checkProgImpls(checkImplHeaders(p.impls, p.traits, Parse.builtins(p.enums), p.aliases, aliasNames(p.aliases)), p, stems)

def checkProgImpls(o: Out, p: Prog, stems: List[String]): Out =
  if (hasErr(o)) o else checkProgGo(expandDefs(withImportFuns(p.imps, implFuns(p.impls, p.defs)), p.aliases), Parse.builtins(p.enums), aliasNames(p.aliases), p.main, expandExpr(p.body, p.aliases), stems)

def aliasNames(aliases: List[Alias]): List[String] =
  if (List.isEmpty(aliases)) [] else aliasName(List.at(aliases, 0), List.tail(aliases))

def aliasName(a: Alias, rest: List[Alias]): List[String] =
  a match {
    case Alias(name, _, _) => name :: aliasNames(rest)
  }

def checkAliases(aliases: List[Alias], ens: List[En], names: List[String]): Out =
  if (List.isEmpty(aliases)) ok("Unit") else checkAlias(List.at(aliases, 0), List.tail(aliases), ens, names)

def checkAlias(a: Alias, rest: List[Alias], ens: List[En], names: List[String]): Out =
  a match {
    case Alias(_, ts, target) => if (!knownTy(Type.parse(target), ens, List.concat(ts, names))) bad(Str.concat("unknown type ", target), noSpan()) else checkAliases(rest, ens, names)
  }

def checkTraits(traits: List[Tr], ens: List[En], names: List[String]): Out =
  if (List.isEmpty(traits)) ok("Unit") else checkTrait(List.at(traits, 0), List.tail(traits), ens, names)

def checkTrait(t: Tr, rest: List[Tr], ens: List[En], names: List[String]): Out =
  t match {
    case Tr(_, ts, methods) => checkTraitRest(checkTraitMethods(methods, ens, List.concat(ts, names)), rest, ens, names)
  }

def checkTraitRest(o: Out, rest: List[Tr], ens: List[En], names: List[String]): Out =
  if (hasErr(o)) o else checkTraits(rest, ens, names)

def checkTraitMethods(methods: List[TrMethod], ens: List[En], names: List[String]): Out =
  if (List.isEmpty(methods)) ok("Unit") else checkTraitMethod(List.at(methods, 0), List.tail(methods), ens, names)

def checkTraitMethod(m: TrMethod, rest: List[TrMethod], ens: List[En], names: List[String]): Out =
  m match {
    case TrMethod(_, ps, ret) => checkTraitMethodParams(checkTyList(ps, ens, names, noSpan()), ret, rest, ens, names)
  }

def checkTraitMethodParams(o: Out, ret: String, rest: List[TrMethod], ens: List[En], names: List[String]): Out =
  if (hasErr(o)) o else if (!knownTy(Type.parse(ret), ens, names)) bad(Str.concat("unknown type ", ret), noSpan()) else checkTraitMethods(rest, ens, names)

def checkImplHeaders(impls: List[Im], traits: List[Tr], ens: List[En], aliases: List[Alias], names: List[String]): Out =
  if (List.isEmpty(impls)) ok("Unit") else checkImplHeader(List.at(impls, 0), List.tail(impls), traits, ens, aliases, names)

def checkImplHeader(im: Im, rest: List[Im], traits: List[Tr], ens: List[En], aliases: List[Alias], names: List[String]): Out =
  im match {
    case Im(tn, args, forTy, methods) => checkImplHeaderTrait(findTrait(traits, tn), tn, args, forTy, methods, rest, traits, ens, aliases, names)
  }

def checkImplHeaderTrait(t: Tr, tn: String, args: List[String], forTy: String, methods: List[Fun], rest: List[Im], traits: List[Tr], ens: List[En], aliases: List[Alias], names: List[String]): Out =
  if (t.name == "") bad(Str.concat("unknown trait ", tn), noSpan()) else if (List.len(t.tparams) != List.len(args)) bad(Str.concat(tn, Str.concat(" expects ", Str.concat(Str.fromInt(List.len(t.tparams)), " type args"))), noSpan()) else checkImplArgs(checkTypeStrings(args, ens, names), t, args, forTy, methods, rest, traits, ens, aliases, names)

def checkImplArgs(o: Out, t: Tr, args: List[String], forTy: String, methods: List[Fun], rest: List[Im], traits: List[Tr], ens: List[En], aliases: List[Alias], names: List[String]): Out =
  if (hasErr(o)) o else if (!knownTy(Type.parse(forTy), ens, names)) bad(Str.concat("unknown type ", forTy), noSpan()) else checkImplMethodsAfter(checkImplMethods(t.methods, methods, t.tparams, args, aliases), rest, traits, ens, aliases, names)

def checkImplMethodsAfter(o: Out, rest: List[Im], traits: List[Tr], ens: List[En], aliases: List[Alias], names: List[String]): Out =
  if (hasErr(o)) o else checkImplHeaders(rest, traits, ens, aliases, names)

def findTrait(traits: List[Tr], name: String): Tr =
  if (List.isEmpty(traits)) Tr("", [], []) else findTraitAt(List.at(traits, 0), List.tail(traits), name)

def findTraitAt(t: Tr, rest: List[Tr], name: String): Tr =
  t match {
    case Tr(n, _, _) => if (n == name) t else findTrait(rest, name)
  }

def checkImplMethods(decls: List[TrMethod], methods: List[Fun], tps: List[String], args: List[String], aliases: List[Alias]): Out =
  if (List.isEmpty(decls)) ok("Unit") else checkImplMethod(List.at(decls, 0), List.tail(decls), methods, tps, args, aliases)

def checkImplMethod(decl: TrMethod, rest: List[TrMethod], methods: List[Fun], tps: List[String], args: List[String], aliases: List[Alias]): Out =
  decl match {
    case TrMethod(name, ps, ret) => checkImplMethodFound(name, ps, ret, List.filter(methods, m => m.name == name), rest, methods, tps, args, aliases)
  }

def checkImplMethodFound(name: String, ps: List[Param], ret: String, hit: List[Fun], rest: List[TrMethod], methods: List[Fun], tps: List[String], args: List[String], aliases: List[Alias]): Out =
  if (List.isEmpty(hit)) bad(Str.concat("missing trait method ", name), noSpan()) else if (List.len(hit) != 1) bad(Str.concat("duplicate trait method ", name), noSpan()) else checkImplMethodSig(List.at(hit, 0), name, ps, ret, rest, methods, tps, args, aliases)

def checkImplMethodSig(method: Fun, name: String, ps: List[Param], ret: String, rest: List[TrMethod], methods: List[Fun], tps: List[String], args: List[String], aliases: List[Alias]): Out =
  method match {
    case Fun(_, _, _, _, gotPs, gotRet, _, _, _) => if (List.len(ps) != List.len(gotPs)) bad(Str.concat("trait method ", Str.concat(name, " parameter count")), noSpan()) else checkImplMethodParams(checkImplParamTypes(name, ps, gotPs, tps, args, aliases), name, ret, gotRet, rest, methods, tps, args, aliases)
  }

def checkImplMethodParams(o: Out, name: String, ret: String, gotRet: String, rest: List[TrMethod], methods: List[Fun], tps: List[String], args: List[String], aliases: List[Alias]): Out =
  if (hasErr(o)) o else if (!contractTypeEq(ret, gotRet, tps, args, aliases)) bad(Str.concat("trait method ", Str.concat(name, " return type")), noSpan()) else checkImplMethods(rest, methods, tps, args, aliases)

def checkImplParamTypes(name: String, ps: List[Param], gotPs: List[Param], tps: List[String], args: List[String], aliases: List[Alias]): Out =
  if (List.isEmpty(ps)) ok("Unit") else checkImplParamType(name, List.at(ps, 0), List.at(gotPs, 0), List.tail(ps), List.tail(gotPs), tps, args, aliases)

def checkImplParamType(name: String, want: Param, got: Param, ps: List[Param], gotPs: List[Param], tps: List[String], args: List[String], aliases: List[Alias]): Out =
  if (!contractTypeEq(want.ty, got.ty, tps, args, aliases)) bad(Str.concat("trait method ", Str.concat(name, " parameter type")), noSpan()) else checkImplParamTypes(name, ps, gotPs, tps, args, aliases)

def contractTypeEq(want: String, got: String, tps: List[String], args: List[String], aliases: List[Alias]): Bool =
  contractTyEq(Type.parse(expandTy(specializeType(want, tps, Type.mapParse(args)), aliases)), Type.parse(expandTy(got, aliases)))

def contractTyEq(a: Ty, b: Ty): Bool =
  if (Type.isIo(a) && Type.isIo(b)) contractTyEq(Type.ioErr(a), Type.ioErr(b)) && contractTyEq(Type.ioOk(a), Type.ioOk(b)) else contractTyEqGo(a, b)

def contractTyEqGo(a: Ty, b: Ty): Bool =
  a match {
    case Ty.TVar(n) => b match {
  case Ty.TVar(m) => n == m
  case _ => false
}
    case Ty.Named(n) => b match {
  case Ty.Named(m) => n == m
  case _ => false
}
    case Ty.App(n, args) => b match {
  case Ty.App(m, bs) => n == m && contractTyListEq(args, bs)
  case _ => false
}
    case Ty.Tuple(parts) => b match {
  case Ty.Tuple(bs) => contractTyListEq(parts, bs)
  case _ => false
}
    case Ty.Arrow(arg, ret) => b match {
  case Ty.Arrow(barg, bret) => contractTyEq(arg, barg) && contractTyEq(ret, bret)
  case _ => false
}
  }

def contractTyListEq(a: List[Ty], b: List[Ty]): Bool =
  if (List.isEmpty(a)) List.isEmpty(b) else if (List.isEmpty(b)) false else contractTyEq(List.at(a, 0), List.at(b, 0)) && contractTyListEq(List.tail(a), List.tail(b))

def checkTypeStrings(types: List[String], ens: List[En], names: List[String]): Out =
  if (List.isEmpty(types)) ok("Unit") else if (!knownTy(Type.parse(List.at(types, 0)), ens, names)) bad(Str.concat("unknown type ", List.at(types, 0)), noSpan()) else checkTypeStrings(List.tail(types), ens, names)

def checkProgGo(ds: List[Fun], enums: List[En], names: List[String], main: String, body: Expr, stems: List[String]): Out =
  checkProgGoTab(ds, withLetterPins(enums), names, main, body, stems, ftabOfList(ds))

def checkProgGoTab(ds: List[Fun], enums: List[En], names: List[String], main: String, body: Expr, stems: List[String], tab: Ftab): Out =
  checkProgAfterEns(checkEns(enums, names, tab), tab, ds, enums, main, body, stems)

def checkProgAfterEns(o: Out, tab: Ftab, ds: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  if (hasErr(o)) o else checkDefsRest(tab, ds, enums, main, body, stems)

def implFuns(impls: List[Im], defs: List[Fun]): List[Fun] =
  if (List.isEmpty(impls)) defs else implFuns(List.tail(impls), implMeths(List.at(impls, 0), defs))

def implMeths(im: Im, defs: List[Fun]): List[Fun] =
  im match {
    case Im(_, _, forTy, methods) => stampMod(methods, forTy, defs)
  }

def stampMod(ms: List[Fun], mod: String, defs: List[Fun]): List[Fun] =
  if (List.isEmpty(ms)) defs else stampFun(List.at(ms, 0), mod) :: stampMod(List.tail(ms), mod, defs)

def stampFun(d: Fun, mod: String): Fun =
  d match {
    case Fun(priv, ora, name, ts, ps, ret, body, _, off) => Fun(priv, ora, name, ts, Param("self", mod, "", "") :: ps, ret, body, mod, off)
  }

def withImportFuns(imps: List[Imp], defs: List[Fun]): List[Fun] =
  List.concat(importFuns(imps, defs), defs)

def importFuns(imps: List[Imp], defs: List[Fun]): List[Fun] =
  if (List.isEmpty(imps)) [] else importFunsGo(List.at(imps, 0), List.tail(imps), defs)

def importFunsGo(h: Imp, rest: List[Imp], defs: List[Fun]): List[Fun] =
  List.concat(importFun1(h, defs), importFuns(rest, defs))

def importFun1(h: Imp, defs: List[Fun]): List[Fun] =
  h match {
    case Imp(mod, name, alias) => if (alias == "") [] else renameHits(findFunMod(defs, mod, name), alias)
  }

def renameHits(hit: List[Fun], alias: String): List[Fun] =
  if (List.isEmpty(hit)) [] else renameFun(List.at(hit, 0), alias) :: []

def renameFun(d: Fun, alias: String): Fun =
  d match {
    case Fun(priv, ora, _, ts, ps, ret, body, mod, off) => Fun(priv, ora, alias, ts, ps, ret, body, mod, off)
  }

def expandDefs(defs: List[Fun], als: List[Alias]): List[Fun] =
  List.reverse(expandDefsGo(defs, als, []))

def expandDefsGo(defs: List[Fun], als: List[Alias], acc: List[Fun]): List[Fun] =
  if (List.isEmpty(defs)) acc else expandDefsGo(List.tail(defs), als, expandDef(List.at(defs, 0), als) :: acc)

def expandDef(d: Fun, als: List[Alias]): Fun =
  d match {
    case Fun(priv, ora, name, ts, ps, ret, body, mod, off) => Fun(priv, ora, name, ts, expandParams(ps, als), expandTy(ret, als), expandExpr(body, als), mod, off)
  }

def expandExpr(e: Expr, als: List[Alias]): Expr =
  e match {
    case Expr.EAscribe(inner, ty, off) => Expr.EAscribe(expandExpr(inner, als), expandTy(ty, als), off)
    case Expr.ELam(p, ty, body) => Expr.ELam(p, expandTy(ty, als), expandExpr(body, als))
    case Expr.EPrint(inner, off) => Expr.EPrint(expandExpr(inner, als), off)
    case Expr.ECall(f, args, off) => Expr.ECall(f, expandExprs(args, als), off)
    case Expr.EMethod(recv, name, args, off) => Expr.EMethod(expandExpr(recv, als), name, expandExprs(args, als), off)
    case Expr.EField(recv, name, off) => Expr.EField(expandExpr(recv, als), name, off)
    case Expr.EBin(op, l, r, off) => Expr.EBin(op, expandExpr(l, als), expandExpr(r, als), off)
    case Expr.EUn(op, inner, off) => Expr.EUn(op, expandExpr(inner, als), off)
    case Expr.EIf(c, t, el, off) => Expr.EIf(expandExpr(c, als), expandExpr(t, als), expandExpr(el, als), off)
    case Expr.EMatch(s, arms, off) => Expr.EMatch(expandExpr(s, als), expandArms(arms, als), off)
    case Expr.EFor(bs, body, off) => Expr.EFor(expandBinds(bs, als), expandExpr(body, als), off)
    case Expr.EList(xs) => Expr.EList(expandExprs(xs, als))
    case Expr.ETuple(xs) => Expr.ETuple(expandExprs(xs, als))
    case Expr.ENamed(n, inner) => Expr.ENamed(n, expandExpr(inner, als))
    case _ => e
  }

def expandExprs(xs: List[Expr], als: List[Alias]): List[Expr] =
  if (List.isEmpty(xs)) xs else expandExpr(List.at(xs, 0), als) :: expandExprs(List.tail(xs), als)

def expandArms(xs: List[Arm], als: List[Alias]): List[Arm] =
  if (List.isEmpty(xs)) xs else expandArm(List.at(xs, 0), als) :: expandArms(List.tail(xs), als)

def expandArm(a: Arm, als: List[Alias]): Arm =
  a match {
    case Arm(pat, g, body) => Arm(pat, g, expandExpr(body, als))
  }

def expandBinds(xs: List[Bind], als: List[Alias]): List[Bind] =
  if (List.isEmpty(xs)) xs else expandBind(List.at(xs, 0), als) :: expandBinds(List.tail(xs), als)

def expandBind(b: Bind, als: List[Alias]): Bind =
  b match {
    case Bind(d, name, v) => Bind(d, name, expandExpr(v, als))
  }

def expandParams(ps: List[Param], als: List[Alias]): List[Param] =
  if (List.isEmpty(ps)) ps else expandParam(List.at(ps, 0), als) :: expandParams(List.tail(ps), als)

def expandParam(p: Param, als: List[Alias]): Param =
  p match {
    case Param(n, ty, w, d) => Param(n, expandTy(ty, als), w, d)
  }

def expandTy(t: String, als: List[Alias]): String =
  if (List.isEmpty(als) || t == "") t else Type.show(expandFuel(Type.parse(t), als, 8))

def expandFuel(t: Ty, als: List[Alias], fuel: Int): Ty =
  if (fuel <= 0) t else expandApply(expandKids(t, als, fuel), als, fuel)

def expandKids(t: Ty, als: List[Alias], fuel: Int): Ty =
  t match {
    case Ty.App(name, args) => Type.tApp(name, expandTyList(args, als, fuel))
    case Ty.Tuple(ps) => Type.tTuple(expandTyList(ps, als, fuel))
    case Ty.Arrow(a, r) => Type.tFun(expandFuel(a, als, fuel), expandFuel(r, als, fuel))
    case _ => t
  }

def expandTyList(xs: List[Ty], als: List[Alias], fuel: Int): List[Ty] =
  if (List.isEmpty(xs)) xs else expandFuel(List.at(xs, 0), als, fuel) :: expandTyList(List.tail(xs), als, fuel)

def expandApply(t: Ty, als: List[Alias], fuel: Int): Ty =
  if (List.isEmpty(als)) t else expandApplyGo(t, List.at(als, 0), List.tail(als), als, fuel)

def expandApplyGo(t: Ty, h: Alias, rest: List[Alias], als: List[Alias], fuel: Int): Ty =
  h match {
    case Alias(name, tps, target) => if (aliasHits(t, name, tps)) expandFuel(aliasFill(t, tps, target), als, fuel - 1) else expandApply(t, rest, fuel)
  }

def aliasHits(t: Ty, name: String, tps: List[String]): Bool =
  t match {
    case Ty.Named(n) => n == name && List.isEmpty(tps)
    case Ty.TVar(n) => n == name && List.isEmpty(tps)
    case Ty.App(n, _) => n == name && !List.isEmpty(tps)
    case _ => false
  }

def aliasFill(t: Ty, tps: List[String], target: String): Ty =
  Type.parse(specializeType(target, tps, Type.appArgs(t)))

def substTy(target: String, param: String, arg: String): String =
  Type.substStr(target, param, arg)

def inStems(stems: List[String], mod: String): Bool =
  List.isEmpty(stems) || hasStem(stems, mod)

def hasStem(stems: List[String], mod: String): Bool =
  if (List.isEmpty(stems)) false else if (List.at(stems, 0) == mod) true else hasStem(List.tail(stems), mod)

def checkDefsRest(all: Ftab, rest: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  if (List.isEmpty(rest)) checkMain(main, body, all, enums, mainFile(stems)) else checkDefsHit(List.at(rest, 0), all, List.tail(rest), enums, main, body, stems)

def checkDefsHit(d: Fun, all: Ftab, rest: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  d match {
    case Fun(_, _, name, _, _, _, _, mod, off) => if (name == "#parse") bad("unexpected token", (mod, off)) else if (inStems(stems, mod)) checkDefsAfter(checkDef(d, all, enums), all, rest, enums, main, body, stems) else checkDefsRest(all, rest, enums, main, body, stems)
  }

def checkDefsAfter(o: Out, all: Ftab, rest: List[Fun], enums: List[En], main: String, body: Expr, stems: List[String]): Out =
  if (hasErr(o)) o else checkDefsRest(all, rest, enums, main, body, stems)

def mainFile(stems: List[String]): String =
  if (List.isEmpty(stems)) "Main" else if (hasStem(stems, "Main")) "Main" else List.at(stems, 0)

def checkMain(name: String, body: Expr, funs: Ftab, ens: List[En], file: String): Out =
  if (name == "") ok("IO[Unit]") else checkMainGot(infer(body, envMod(file), funs, ens), body, file)

def checkMainGot(o: Out, body: Expr, file: String): Out =
  if (hasErr(o)) o else if (tyStr(o) == "IO[Unit]") o else bad(Str.concat("@main body must be IO[Unit], got ", tyStr(o)), spanPick(o.span, spanPick(Parse.spanOf(body), (file, 0 - 1))))

def lineIndex(src: String): List[Int] =
  if (src == "") [0] else List.reverse(lineIndexGo(src, 0, Str.len(src), [0]))

def lineIndexGo(src: String, i: Int, n: Int, acc: List[Int]): List[Int] =
  if (i >= n) acc else lineIndexGo(src, i + 256, n, lineScan(src, i, if (i + 256 < n) i + 256 else n, acc))

def lineScan(src: String, i: Int, bound: Int, acc: List[Int]): List[Int] =
  if (i >= bound) acc else if (Str.charAt(src, i) == 10) lineScan(src, i + 1, bound, i + 1 :: acc) else lineScan(src, i + 1, bound, acc)

def lineCol(src: String, off: Int): (Int, Int) =
  lineColIdx(lineIndex(src), src, off)

def lineColIdx(starts: List[Int], src: String, off: Int): (Int, Int) =
  if (src == "") (1, 1) else lineColIdxOff(starts, clampOff(off, Str.len(src)))

def clampOff(off: Int, n: Int): Int =
  if (off < 0) 0 else if (off > n) n else off

def lineColIdxOff(starts: List[Int], o: Int): (Int, Int) =
  lineColIdxFound(lastStartLe(starts, o, 0, 0), o)

def lineColIdxFound(found: (Int, Int), o: Int): (Int, Int) =
  found match {
    case (line, last) => (if (line < 1) 1 else line, o - last + 1)
  }

def lastStartLe(xs: List[Int], off: Int, line: Int, last: Int): (Int, Int) =
  if (List.isEmpty(xs)) (if (line < 1) 1 else line, last) else lastStartChunk(xs, off, line, last, 64)

def lastStartChunk(xs: List[Int], off: Int, line: Int, last: Int, k: Int): (Int, Int) =
  xs match {
    case [] => (if (line < 1) 1 else line, last)
    case s :: rest => if (k <= 0) lastStartLe(xs, off, line, last) else lastStartOne(s, rest, off, line, last, k)
  }

def lastStartOne(s: Int, rest: List[Int], off: Int, line: Int, last: Int, k: Int): (Int, Int) =
  if (s > off) (if (line < 1) 1 else line, last) else lastStartChunk(rest, off, line + 1, s, k - 1)

def fileIndex(files: List[(String, String)]): Map[String, List[Int]] =
  fileIndexGo(files, Map.empty())

def fileIndexGo(files: List[(String, String)], acc: Map[String, List[Int]]): Map[String, List[Int]] =
  if (List.isEmpty(files)) acc else fileIndexHd(List.at(files, 0), List.tail(files), acc)

def fileIndexHd(h: (String, String), rest: List[(String, String)], acc: Map[String, List[Int]]): Map[String, List[Int]] =
  h match {
    case (stem, src) => fileIndexGo(rest, Map.set(acc, stem, lineIndex(src)))
  }

def startsOf(idx: Map[String, List[Int]], stem: String): List[Int] =
  Map.get(idx, stem) match {
    case Some(xs) => xs
    case None => startsOfMiss(idx, stem)
  }

def startsOfMiss(idx: Map[String, List[Int]], stem: String): List[Int] =
  if (stem == "") Map.get(idx, "Main") match {
  case Some(xs) => xs
  case None => [0]
} else [0]

def isIdentCh(c: Int): Bool =
  c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 95

def skipIdent(src: String, i: Int): Int =
  if (i >= Str.len(src)) i else if (isIdentCh(Str.charAt(src, i))) skipIdent(src, i + 1) else i

def skipQual(src: String, i: Int): Int =
  skipQual2(src, skipIdent(src, i))

def skipQual2(src: String, j: Int): Int =
  if (j < Str.len(src) && Str.charAt(src, j) == 46 && j + 1 < Str.len(src) && isIdentCh(Str.charAt(src, j + 1))) skipQual(src, j + 1) else j

def skipStr(src: String, i: Int): Int =
  if (i >= Str.len(src)) i else if (Str.charAt(src, i) == 34) i + 1 else if (Str.charAt(src, i) == 92 && i + 1 < Str.len(src)) skipStr(src, i + 2) else skipStr(src, i + 1)

def tokenEnd(src: String, off: Int): Int =
  if (off < 0 || off >= Str.len(src)) off else tokenEndCh(src, off, Str.charAt(src, off))

def tokenEndCh(src: String, off: Int, c: Int): Int =
  if (c == 34) skipStr(src, off + 1) else if (isIdentCh(c)) skipQual(src, off) else off + 1

def locOf(src: String, off: Int): (Int, Int, Int, Int) =
  locOfIdx(lineIndex(src), src, off)

def locOfIdx(starts: List[Int], src: String, off: Int): (Int, Int, Int, Int) =
  if (off < 0 || src == "") (1, 1, 1, 1) else locOf2(lineColIdx(starts, src, off), src, off)

def locOf2(p: (Int, Int), src: String, off: Int): (Int, Int, Int, Int) =
  p match {
    case (line, col) => locOf3(line, col, tokenEnd(src, off) - off)
  }

def locOf3(line: Int, col: Int, n: Int): (Int, Int, Int, Int) =
  (line, col, line, col + (if (n < 1) 1 else n))

def hexDigit(n: Int): String =
  Str.slice("0123456789abcdef", n, n + 1)

def hex2(n: Int): String =
  Str.concat(hexDigit(n / 16), hexDigit(n % 16))

def jsonStr(s: String): String =
  Str.concat("\"", Str.concat(_esc(s, 0, Builder.empty()), "\""))

def covKeyOf(loc: String, off: Int, tag: String): String =
  Str.concat(loc, Str.concat("@", Str.concat(Str.fromInt(off), Str.concat("#", tag))))

def _esc(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else _esc2(s, i, b, Str.charAt(s, i))

def _esc2(s: String, i: Int, b: Builder, c: Int): String =
  _esc(s, i + 1, Builder.append(b, if (c == 34) "\\\"" else if (c == 92) "\\\\" else if (c == 10) "\\n" else if (c == 13) "\\r" else if (c == 9) "\\t" else if (c < 32) Str.concat("\\u00", hex2(c)) else Str.slice(s, i, i + 1)))

def fileOf(stem: String): String =
  if (stem == "") "Main.scuzz" else Str.concat(stem, ".scuzz")

def srcOfStem(files: List[(String, String)], stem: String): String =
  if (List.isEmpty(files)) "" else srcOfStemHd(List.at(files, 0), List.tail(files), stem)

def srcOfStemHd(h: (String, String), rest: List[(String, String)], stem: String): String =
  h match {
    case (s, src) => if (s == stem || stem == "" && s == "Main") src else srcOfStem(rest, stem)
  }

def diagJson(files: List[(String, String)], o: Out): String =
  diagJsonSp(files, o, o.span)

def diagJsonSp(files: List[(String, String)], o: Out, sp: (String, Int)): String =
  sp match {
    case (stem, off) => diagJson2(o, fileOf(stem), locOf(srcOfStem(files, stem), off))
  }

def diagJson2(o: Out, file: String, loc: (Int, Int, Int, Int)): String =
  loc match {
    case (line, col, eline, ecol) => diagJson3(o, file, line, col, eline, ecol)
  }

def errMsg(o: Out): String =
  if (o.err == "unexpected token") o.err else Str.concat("type error: ", o.err)

def diagJson3(o: Out, file: String, line: Int, col: Int, eline: Int, ecol: Int): String =
  Str.concat("{\"severity\":\"error\",\"message\":", Str.concat(jsonStr(errMsg(o)), Str.concat(",\"file\":", Str.concat(jsonStr(file), Str.concat(",\"line\":", Str.concat(Str.fromInt(line), Str.concat(",\"column\":", Str.concat(Str.fromInt(col), Str.concat(",\"end_line\":", Str.concat(Str.fromInt(eline), Str.concat(",\"end_column\":", Str.concat(Str.fromInt(ecol), "}"))))))))))))

def check(src: String): String =
  checkFiles(("Main", src) :: [])

def checkFiles(files: List[(String, String)]): String =
  checkFilesOwn(files, [])

def checkFilesOwn(files: List[(String, String)], stems: List[String]): String =
  check3(files, checkProgOwn(Parse.parseFiles(files), stems))

def check3(files: List[(String, String)], o: Out): String =
  if (hasErr(o)) Str.concat("[", Str.concat(diagJson(files, o), "]")) else "[]"

def unclaimedJsonVer(files: List[(String, String)], vers: List[String]): String =
  unclaimedWrap(unclaimedLines(files, vers))

def unclaimedWrap(xs: List[String]): String =
  if (List.isEmpty(xs)) "[]" else Str.concat("[", Str.concat(List.join(List.map(xs, s => unclaimedItem(s)), ","), "]"))

def unclaimedItem(s: String): String =
  Str.concat("{\"severity\":\"info\",\"message\":\"unclaimed ", Str.concat(s, "\",\"line\":1,\"column\":1}"))

def unclaimedLines(files: List[(String, String)], vers: List[String]): List[String] =
  unclaimedOf(Parse.parseFiles(files), files, List.join(vers, """
"""))

def unclaimedOf(p: Prog, files: List[(String, String)], ver: String): List[String] =
  List.concat(unclaimedDefs(p, ver), List.concat(unclaimedSignals(files, ver), unclaimedControls(files, ver)))

def unclaimedDefs(p: Prog, ver: String): List[String] =
  unclaimedDefNames(if (p.main == "") p.defs else Fun(false, false, p.main, [], [], "IO[Unit]", p.body, "Main", 0) :: p.defs, ver)

def unclaimedDefNames(ds: List[Fun], ver: String): List[String] =
  if (List.isEmpty(ds)) [] else unclaimedDefHd(List.at(ds, 0), List.tail(ds), ver)

def unclaimedDefHd(d: Fun, rest: List[Fun], ver: String): List[String] =
  d match {
    case Fun(priv, ora, name, _, _, _, _, _, _) => if (priv || Str.startsWith(name, "_") || mentioned(ver, name)) unclaimedDefNames(rest, ver) else Str.concat(if (ora) "oracle " else "def ", name) :: unclaimedDefNames(rest, ver)
  }

def mentioned(ver: String, name: String): Bool =
  ver != "" && Str.contains(ver, name)

def unclaimedSignals(files: List[(String, String)], ver: String): List[String] =
  if (List.isEmpty(files)) [] else List.concat(scanSignals(fileSrcOf(List.at(files, 0)), ver), unclaimedSignals(List.tail(files), ver))

def unclaimedControls(files: List[(String, String)], ver: String): List[String] =
  if (List.isEmpty(files)) [] else List.concat(scanControls(fileSrcOf(List.at(files, 0)), ver), unclaimedControls(List.tail(files), ver))

def fileSrcOf(h: (String, String)): String =
  h match {
    case (_, src) => src
  }

def scanSignals(src: String, ver: String): List[String] =
  scanNeedle(src, " = Signal.make", ver, "signal ", 0, [])

def scanControls(src: String, ver: String): List[String] =
  List.concat(scanQuoted(src, "View.button(\"", ver, "control ", 0, []), List.concat(scanQuoted(src, "View.outlinedButton(\"", ver, "control ", 0, []), scanQuoted(src, "View.textButton(\"", ver, "control ", 0, [])))

def scanNeedle(src: String, needle: String, ver: String, kind: String, i: Int, acc: List[String]): List[String] =
  if (i + Str.len(needle) > Str.len(src)) acc else if (Str.slice(src, i, i + Str.len(needle)) == needle) scanNeedleHit(src, needle, ver, kind, i, acc) else scanNeedle(src, needle, ver, kind, i + 1, acc)

def scanNeedleHit(src: String, needle: String, ver: String, kind: String, i: Int, acc: List[String]): List[String] =
  scanNeedle(src, needle, ver, kind, i + Str.len(needle), identBefore(src, i, kind, ver, acc))

def identBefore(src: String, i: Int, kind: String, ver: String, acc: List[String]): List[String] =
  identTake(src, identStartAt(src, i - 1), i, kind, ver, acc)

def identStartAt(src: String, i: Int): Int =
  if (i < 0) 0 else if (isIdentCh(Str.charAt(src, i))) identStartAt(src, i - 1) else i + 1

def identTake(src: String, start: Int, end: Int, kind: String, ver: String, acc: List[String]): List[String] =
  if (start >= end) acc else unclaimedAdd(Str.concat(kind, Str.slice(src, start, end)), ver, acc)

def scanQuoted(src: String, needle: String, ver: String, kind: String, i: Int, acc: List[String]): List[String] =
  if (i + Str.len(needle) > Str.len(src)) acc else if (Str.slice(src, i, i + Str.len(needle)) == needle) scanQuotedHit(src, needle, ver, kind, i, acc) else scanQuoted(src, needle, ver, kind, i + 1, acc)

def scanQuotedHit(src: String, needle: String, ver: String, kind: String, i: Int, acc: List[String]): List[String] =
  scanQuoted(src, needle, ver, kind, i + Str.len(needle), unclaimedAdd(Str.concat(kind, quoteTo(src, i + Str.len(needle))), ver, acc))

def quoteTo(src: String, i: Int): String =
  if (i >= Str.len(src) || Str.charAt(src, i) == 34) "" else Str.concat(Str.slice(src, i, i + 1), quoteTo(src, i + 1))

def unclaimedAdd(item: String, ver: String, acc: List[String]): List[String] =
  if (mentioned(ver, afterKind(item))) acc else item :: acc

def afterKind(item: String): String =
  if (Str.startsWith(item, "def ")) Str.slice(item, 4, Str.len(item)) else if (Str.startsWith(item, "signal ")) Str.slice(item, 7, Str.len(item)) else if (Str.startsWith(item, "control ")) Str.slice(item, 8, Str.len(item)) else item

def humanLine(files: List[(String, String)], o: Out): String =
  humanLineSp(files, o, o.span)

def humanLineSp(files: List[(String, String)], o: Out, sp: (String, Int)): String =
  sp match {
    case (stem, off) => humanLine2(o, fileOf(stem), locOf(srcOfStem(files, stem), off))
  }

def humanLine2(o: Out, file: String, loc: (Int, Int, Int, Int)): String =
  loc match {
    case (line, col, _, _) => humanLine3(o, file, line, col)
  }

def humanLine3(o: Out, file: String, line: Int, col: Int): String =
  Str.concat(file, Str.concat(":", Str.concat(Str.fromInt(line), Str.concat(":", Str.concat(Str.fromInt(col), Str.concat(": error: ", errMsg(o)))))))

def human(src: String): String =
  humanFiles(("Main", src) :: [])

def humanFiles(files: List[(String, String)]): String =
  humanFilesOwn(files, [])

def humanFilesOwn(files: List[(String, String)], stems: List[String]): String =
  human3(files, checkProgOwn(Parse.parseFiles(files), stems))

def human3(files: List[(String, String)], o: Out): String =
  if (hasErr(o)) humanLine(files, o) else "scuzz check ok"

def typeOfEns(e: Expr, defs: Ftab, ens: List[En], ps: List[Param], mod: String): String =
  tyStr(infer(e, bindParams(ps, envSelfMod(mod)), defs, ens))

def specializeEnums(ens: List[En], ty: String): List[En] =
  if (!Str.contains(ty, "[")) ens else specializeEnumsGo(ens, ty)

def specializeEnumsGo(ens: List[En], ty: String): List[En] =
  if (List.isEmpty(ens)) ens else specializeEnum(List.at(ens, 0), ty) :: specializeEnumsGo(List.tail(ens), ty)

def specializeEnum(en: En, ty: String): En =
  en match {
    case En(priv, name, tps, cases) => if (!List.isEmpty(tps) && Str.startsWith(ty, Str.concat(name, "["))) En(priv, name, tps, specializeCases(cases, tps, Type.appArgs(Type.parse(ty)))) else En(priv, name, tps, cases)
  }

def specializeCases(cs: List[EnCase], tps: List[String], args: List[Ty]): List[EnCase] =
  if (List.isEmpty(cs)) cs else specializeCase(List.at(cs, 0), tps, args) :: specializeCases(List.tail(cs), tps, args)

def specializeCase(c: EnCase, tps: List[String], args: List[Ty]): EnCase =
  c match {
    case EnCase(name, fs) => EnCase(name, specializeFields(fs, tps, args))
  }

def specializeFields(ps: List[Param], tps: List[String], args: List[Ty]): List[Param] =
  if (List.isEmpty(ps)) ps else specializeField(List.at(ps, 0), tps, args) :: specializeFields(List.tail(ps), tps, args)

def specializeField(p: Param, tps: List[String], args: List[Ty]): Param =
  p match {
    case Param(n, ty, w, d) => Param(n, specializeType(ty, tps, args), w, d)
  }

def specializeType(ty: String, tps: List[String], args: List[Ty]): String =
  if (List.isEmpty(tps) || List.isEmpty(args)) ty else specializeType(substTy(ty, List.at(tps, 0), Type.show(List.at(args, 0))), List.tail(tps), List.tail(args))

def inferNamedCtor(en: String, ctor: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int), rest: List[En]): Out =
  if (List.isEmpty(rest)) inferCtor(en, args, env, funs, ens) else inferNamedCtorEn(List.at(rest, 0), List.tail(rest), en, ctor, args, env, funs, ens, span)

def inferNamedCtorEn(head: En, rest: List[En], en: String, ctor: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  head match {
    case En(_, name, tps, cases) => if (name != en) inferNamedCtor(en, ctor, args, env, funs, ens, span, rest) else if (List.isEmpty(tps)) inferCtor(en, args, env, funs, ens) else inferGenericCtor(en, ctor, tps, cases, args, env, funs, ens, span)
  }

def inferGenericCtor(en: String, ctor: String, tps: List[String], cases: List[EnCase], args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  if (List.isEmpty(cases)) bad(Str.concat("unknown constructor ", ctor), span) else inferGenericCtorCase(en, ctor, tps, List.at(cases, 0), List.tail(cases), args, env, funs, ens, span)

def inferGenericCtorCase(en: String, ctor: String, tps: List[String], c: EnCase, rest: List[EnCase], args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], span: (String, Int)): Out =
  c match {
    case EnCase(name, ps) => if (name != ctor) inferGenericCtor(en, ctor, tps, rest, args, env, funs, ens, span) else checkGeneric(ctor, tps, ps, Type.show(Type.tApp(en, Type.mapParse(tps))), args, env, funs, ens, span, alignCall(ps, args))
  }

