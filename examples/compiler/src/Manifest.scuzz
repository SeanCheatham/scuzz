record UiMan(width: String, height: String, scale: String, tapN: String, bundleId: String, runtime: String)

record Man(ok: Bool, name: String, version: String, hasUi: Bool, deps: List[(String, String)], ui: UiMan, err: String)

record St(sec: String, name: String, version: String, hasUi: Bool, deps: List[(String, String)], ui: UiMan, err: String)

def noPairs(): List[(String, String)] =
  []

def noLines(): List[String] =
  []

def defUi(): UiMan =
  UiMan("200", "120", "1", "", "dev.scuzz.app", "headless")

def fail(msg: String): Man =
  Man(false, "", "0.0.0", false, noPairs(), defUi(), msg)

def isSpace(c: Int): Bool =
  c == 32 || c == 9 || c == 13

def ltrim(s: String, i: Int): Int =
  if (i >= Str.len(s)) i else if (isSpace(Str.charAt(s, i))) ltrim(s, i + 1) else i

def rtrim(s: String, i: Int): Int =
  if (i <= 0) 0 else if (isSpace(Str.charAt(s, i - 1))) rtrim(s, i - 1) else i

def trim(s: String): String =
  Str.slice(s, ltrim(s, 0), rtrim(s, Str.len(s)))

def linesOf(s: String): List[String] =
  linesOf2(s, 0, 0, noLines())

def linesOf2(s: String, start: Int, i: Int, acc: List[String]): List[String] =
  if (i >= Str.len(s)) List.reverse(Str.slice(s, start, i) :: acc) else if (Str.charAt(s, i) == 10) linesOf2(s, i + 1, i + 1, Str.slice(s, start, i) :: acc) else linesOf2(s, start, i + 1, acc)

def findEq(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 61) i else findEq(s, i + 1)

def findComma(s: String, i: Int): Int =
  findCommaQ(s, i, false)

def findCommaQ(s: String, i: Int, q: Bool): Int =
  if (i >= Str.len(s)) 0 - 1 else findCommaC(Str.charAt(s, i), s, i, q)

def findCommaC(c: Int, s: String, i: Int, q: Bool): Int =
  if (!q && c == 44) i else findCommaQ(s, i + 1, if (c == 34) !q else q)

def unquote(s: String): String =
  unquote2(trim(s))

def unquote2(s: String): String =
  if (Str.len(s) >= 2 && Str.charAt(s, 0) == 34 && Str.charAt(s, Str.len(s) - 1) == 34) Str.slice(s, 1, Str.len(s) - 1) else s

def unquoteName(s: String): String =
  trim(unquote(s))

def splitEq(s: String): (String, String) =
  splitEq2(s, findEq(s, 0))

def splitEq2(s: String, i: Int): (String, String) =
  if (i < 0) (trim(s), "") else (trim(Str.slice(s, 0, i)), trim(Str.slice(s, i + 1, Str.len(s))))

def tableOf(line: String): String =
  tableOf2(trim(line))

def tableOf2(line: String): String =
  if (Str.len(line) >= 2 && Str.charAt(line, 0) == 91 && Str.charAt(line, Str.len(line) - 1) == 93) trim(Str.slice(line, 1, Str.len(line) - 1)) else ""

def knownTable(t: String): Bool =
  t == "package" || t == "dependencies" || t == "ui"

def pkgKey(k: String): Bool =
  k == "name" || k == "version" || k == "description"

def uiKey(k: String): Bool =
  k == "default_runtime" || k == "headless_size" || k == "headless_scale" || k == "tap_button" || k == "bundle_id"

def unkTable(t: String): String =
  Str.concat("unknown scuzz.toml table [", Str.concat(t, "]; known tables: package, dependencies, ui"))

def unkPkg(k: String): String =
  Str.concat("unknown scuzz.toml key `", Str.concat(k, "` in [package]; known keys: name, version, description"))

def unkUi(k: String): String =
  Str.concat("unknown scuzz.toml key `", Str.concat(k, "` in [ui]; known keys: default_runtime, headless_size, headless_scale, tap_button, bundle_id"))

def strDep(): String =
  "string dependencies are unsupported; use `{ path = \"...\" }`"

def gitDep(k: String): String =
  Str.concat("unsupported dependency key `", Str.concat(k, "`; only `path` is supported in v0"))

def needPath(): String =
  "dependency requires `path = \"...\"`"

def emptyPath(): String =
  "dependency path must not be empty"

def missName(): String =
  "missing field `name`"

def emptyBundle(): String =
  "bundle_id must not be empty"

def badRuntime(): String =
  "default_runtime must be headless, desktop, or mobile"

def badSize(): String =
  "headless_size must be a pair of positive integers"

def badScale(): String =
  "headless_scale must be positive"

def keyOutside(): String =
  "key outside a table"

def unclosedDep(): String =
  "unclosed `{` in dependency"

def dupDep(name: String): String =
  Str.concat("duplicate dependency name `", Str.concat(name, "`"))

def badPkgName(): String =
  "package name must be [A-Za-z_][A-Za-z0-9_]*"

def okPkgName(s: String): Bool =
  s != "" && okNameStart(Str.charAt(s, 0)) && okNameRest(s, 1)

def okNameStart(c: Int): Bool =
  c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95

def okNameRest(s: String, i: Int): Bool =
  if (i >= Str.len(s)) true else okNameChar(Str.charAt(s, i)) && okNameRest(s, i + 1)

def okNameChar(c: Int): Bool =
  okNameStart(c) || c >= 48 && c <= 57

def start(): St =
  St("", "", "0.0.0", false, noPairs(), defUi(), "")

def withErr(st: St, msg: String): St =
  St(st.sec, st.name, st.version, st.hasUi, st.deps, stUi(st), msg)

def withUi(st: St, ui: UiMan): St =
  St(st.sec, st.name, st.version, st.hasUi, st.deps, ui, st.err)

def stUi(st: St): UiMan =
  st match {
    case St(_sec, _name, _ver, _has, _deps, ui, _err) => ui
  }

def manUi(m: Man): UiMan =
  m match {
    case Man(_ok, _name, _ver, _has, _deps, ui, _err) => ui
  }

def uiWidth(ui: UiMan): String =
  ui match {
    case UiMan(w, _h, _sc, _t, _id, _rt) => w
  }

def uiHeight(ui: UiMan): String =
  ui match {
    case UiMan(_w, h, _sc, _t, _id, _rt) => h
  }

def uiScale(ui: UiMan): String =
  ui match {
    case UiMan(_w, _h, sc, _t, _id, _rt) => sc
  }

def uiTap(ui: UiMan): String =
  ui match {
    case UiMan(_w, _h, _sc, t, _id, _rt) => t
  }

def uiBundle(ui: UiMan): String =
  ui match {
    case UiMan(_w, _h, _sc, _t, id, _rt) => id
  }

def uiRuntime(ui: UiMan): String =
  ui match {
    case UiMan(_w, _h, _sc, _t, _id, rt) => rt
  }

def finish(st: St): Man =
  if (Str.len(st.err) > 0) fail(st.err) else if (st.name == "") fail(missName()) else Man(true, st.name, st.version, st.hasUi, List.reverse(st.deps), stUi(st), "")

def parse(text: String): Man =
  finish(parseLines(linesOf(text), start()))

def parseLines(xs: List[String], st: St): St =
  if (Str.len(st.err) > 0) st else if (List.isEmpty(xs)) st else parseLine(trim(List.at(xs, 0)), List.tail(xs), st)

def parseLine(line: String, rest: List[String], st: St): St =
  parseLine2(trim(cutHash(line)), rest, st)

def cutHash(s: String): String =
  cutHash2(s, 0, false)

def cutHash2(s: String, i: Int, q: Bool): String =
  if (i >= Str.len(s)) s else cutHash3(Str.charAt(s, i), s, i, q)

def cutHash3(c: Int, s: String, i: Int, q: Bool): String =
  if (!q && c == 35) Str.slice(s, 0, i) else cutHash2(s, i + 1, if (c == 34) !q else q)

def parseLine2(line: String, rest: List[String], st: St): St =
  if (line == "" || Str.startsWith(line, "#")) parseLines(rest, st) else if (Str.startsWith(line, "[")) parseSec(tableOf(line), rest, st) else parseKey(line, rest, st)

def parseSec(t: String, rest: List[String], st: St): St =
  if (t == "") withErr(st, unkTable(t)) else if (!knownTable(t)) withErr(st, unkTable(t)) else parseLines(rest, St(t, st.name, st.version, st.hasUi || t == "ui", st.deps, stUi(st), st.err))

def parseKey(line: String, rest: List[String], st: St): St =
  parseKey2(splitEq(line), rest, st)

def parseKey2(kv: (String, String), rest: List[String], st: St): St =
  if (st.sec == "package") parsePkg(kv._1, kv._2, rest, st) else if (st.sec == "dependencies") parseDep(kv._1, kv._2, rest, st) else if (st.sec == "ui") parseUi(kv._1, kv._2, rest, st) else withErr(st, if (st.sec == "") keyOutside() else unkTable(st.sec))

def parsePkg(k: String, v: String, rest: List[String], st: St): St =
  if (!pkgKey(k)) withErr(st, unkPkg(k)) else if (k == "name") parsePkgName(unquoteName(v), rest, st) else if (k == "version") parseLines(rest, St(st.sec, st.name, unquote(v), st.hasUi, st.deps, stUi(st), st.err)) else parseLines(rest, st)

def parsePkgName(name: String, rest: List[String], st: St): St =
  if (!okPkgName(name)) withErr(st, badPkgName()) else parseLines(rest, St(st.sec, name, st.version, st.hasUi, st.deps, stUi(st), st.err))

def parseUi(k: String, v: String, rest: List[String], st: St): St =
  if (!uiKey(k)) withErr(st, unkUi(k)) else parseUiVal(k, v, rest, st)

def parseUiVal(k: String, v: String, rest: List[String], st: St): St =
  if (k == "default_runtime") parseRuntime(unquote(v), rest, st) else if (k == "headless_size") parseSize(v, rest, st) else if (k == "headless_scale") parseScale(trim(v), rest, st) else if (k == "tap_button") parseTap(trim(v), rest, st) else parseBundle(unquote(v), rest, st)

def parseRuntime(v: String, rest: List[String], st: St): St =
  if (v == "headless" || v == "desktop" || v == "mobile") parseLines(rest, withUi(st, UiMan(uiWidth(stUi(st)), uiHeight(stUi(st)), uiScale(stUi(st)), uiTap(stUi(st)), uiBundle(stUi(st)), v))) else withErr(st, badRuntime())

def parseSize(raw: String, rest: List[String], st: St): St =
  parseSizeGot(sizePairVal(trim(raw)), rest, st)

def parseSizeGot(wh: (Bool, String, String), rest: List[String], st: St): St =
  wh match {
    case (ok, w, h) => if (!ok) withErr(st, badSize()) else parseLines(rest, withUi(st, UiMan(w, h, uiScale(stUi(st)), uiTap(stUi(st)), uiBundle(stUi(st)), uiRuntime(stUi(st)))))
  }

def sizePairVal(v: String): (Bool, String, String) =
  if (Str.len(v) < 5 || Str.charAt(v, 0) != 91 || Str.charAt(v, Str.len(v) - 1) != 93) (false, "", "") else sizePairInner(trim(Str.slice(v, 1, Str.len(v) - 1)))

def sizePairInner(inner: String): (Bool, String, String) =
  sizePairComma(inner, findComma(inner, 0))

def sizePairComma(inner: String, c: Int): (Bool, String, String) =
  if (c < 0) (false, "", "") else sizePairWH(trim(Str.slice(inner, 0, c)), trim(Str.slice(inner, c + 1, Str.len(inner))))

def sizePairWH(w: String, h: String): (Bool, String, String) =
  if (!isPosInt(w) || !isPosInt(h)) (false, "", "") else (true, w, h)

def isPosInt(s: String): Bool =
  s != "" && allDigits(s, 0) && Str.toInt(s, 0) > 0

def allDigits(s: String, i: Int): Bool =
  if (i >= Str.len(s)) true else if (Str.charAt(s, i) < 48 || Str.charAt(s, i) > 57) false else allDigits(s, i + 1)

def parseScale(v: String, rest: List[String], st: St): St =
  if (!isPosScale(v)) withErr(st, badScale()) else parseLines(rest, withUi(st, UiMan(uiWidth(stUi(st)), uiHeight(stUi(st)), v, uiTap(stUi(st)), uiBundle(stUi(st)), uiRuntime(stUi(st)))))

def isPosScale(s: String): Bool =
  if (s == "" || Str.charAt(s, 0) == 45) false else scaleForm(s, 0, 0, false) && hasNonZero(s, 0)

def scaleForm(s: String, i: Int, dots: Int, digit: Bool): Bool =
  if (i >= Str.len(s)) digit else scaleFormC(Str.charAt(s, i), s, i, dots, digit)

def scaleFormC(c: Int, s: String, i: Int, dots: Int, digit: Bool): Bool =
  if (c == 46) if (dots >= 1) false else scaleForm(s, i + 1, 1, false) else if (c >= 48 && c <= 57) scaleForm(s, i + 1, dots, true) else false

def hasNonZero(s: String, i: Int): Bool =
  if (i >= Str.len(s)) false else if (Str.charAt(s, i) >= 49 && Str.charAt(s, i) <= 57) true else hasNonZero(s, i + 1)

def parseTap(v: String, rest: List[String], st: St): St =
  if (!allDigits(v, 0) || v == "") withErr(st, "tap_button must be a non-negative integer") else parseLines(rest, withUi(st, UiMan(uiWidth(stUi(st)), uiHeight(stUi(st)), uiScale(stUi(st)), v, uiBundle(stUi(st)), uiRuntime(stUi(st)))))

def parseBundle(v: String, rest: List[String], st: St): St =
  if (v == "") withErr(st, emptyBundle()) else parseLines(rest, withUi(st, UiMan(uiWidth(stUi(st)), uiHeight(stUi(st)), uiScale(stUi(st)), uiTap(stUi(st)), v, uiRuntime(stUi(st)))))

def parseDep(name: String, raw: String, rest: List[String], st: St): St =
  parseDep2(trim(name), trim(raw), rest, st)

def parseDep2(name: String, raw: String, rest: List[String], st: St): St =
  if (Str.len(raw) > 0 && Str.charAt(raw, 0) == 34) withErr(st, strDep()) else if (Str.len(raw) > 0 && Str.charAt(raw, 0) == 123) parseInline(name, raw, rest, st) else withErr(st, needPath())

def parseInline(name: String, raw: String, rest: List[String], st: St): St =
  if (Str.len(raw) < 2 || Str.charAt(raw, Str.len(raw) - 1) != 125) withErr(st, unclosedDep()) else parseInline2(name, trim(Str.slice(raw, 1, Str.len(raw) - 1)), rest, st)

def parseInline2(name: String, inner: String, rest: List[String], st: St): St =
  if (inner == "") withErr(st, needPath()) else takePath(name, kvs(inner, noPairs()), rest, st)

def kvs(s: String, acc: List[(String, String)]): List[(String, String)] =
  kvs2(trim(s), acc)

def kvs2(s: String, acc: List[(String, String)]): List[(String, String)] =
  if (s == "") List.reverse(acc) else kvs3(s, acc, findComma(s, 0))

def kvs3(s: String, acc: List[(String, String)], c: Int): List[(String, String)] =
  if (c < 0) List.reverse(splitEq(s) :: acc) else kvs(Str.slice(s, c + 1, Str.len(s)), splitEq(Str.slice(s, 0, c)) :: acc)

def takePath(name: String, xs: List[(String, String)], rest: List[String], st: St): St =
  takePath2(name, xs, "", false, rest, st)

def takePath2(name: String, xs: List[(String, String)], path: String, found: Bool, rest: List[String], st: St): St =
  if (List.isEmpty(xs)) takePath3(name, path, found, rest, st) else takePathHd(name, List.at(xs, 0), List.tail(xs), path, found, rest, st)

def takePathHd(name: String, h: (String, String), restXs: List[(String, String)], _path: String, _found: Bool, rest: List[String], st: St): St =
  h match {
    case (k, v) => if (k != "path") withErr(st, gitDep(k)) else takePath2(name, restXs, unquote(v), true, rest, st)
  }

def takePath3(name: String, path: String, found: Bool, rest: List[String], st: St): St =
  if (!found) withErr(st, needPath()) else if (path == "") withErr(st, emptyPath()) else if (hasDep(st.deps, name)) withErr(st, dupDep(name)) else parseLines(rest, St(st.sec, st.name, st.version, st.hasUi, (name, path) :: st.deps, stUi(st), st.err))

def hasDep(xs: List[(String, String)], name: String): Bool =
  if (List.isEmpty(xs)) false else hasDepHd(List.at(xs, 0), List.tail(xs), name)

def hasDepHd(h: (String, String), rest: List[(String, String)], name: String): Bool =
  h match {
    case (n, _p) => n == name || hasDep(rest, name)
  }

