record DecodeCtx(enums: List[En], aliases: List[Alias], off: Int, recs: List[String], helps: List[String])

import Parse.Prog
import Parse.En
import Parse.EnCase
import Parse.Alias
import Parse.Fun
import Parse.Param
import Parse.Expr
import Parse.Arm
import Parse.Bind
import Parse.Im
import Type.Ty

def prog(p: Prog): Prog =
  progHelp(p, scanProg(p))

def progHelp(p: Prog, help: (List[String], List[String])): Prog =
  help match {
    case (recs, helps) => rewrite(p, DecodeCtx(p.enums, p.aliases, 0, recs, helps))
  }

def rewrite(p: Prog, dec: DecodeCtx): Prog =
  p.copy(impls = List.map(p.impls, im => rewriteImpl(im, dec)), defs = List.concat(List.map(p.defs, fn => rewriteFun(fn, dec)), List.concat(recHelpers(dec.recs, dec), enumHelpers(dec.helps, dec))), body = walk(p.body, "", dec))

def rewriteImpl(im: Im, dec: DecodeCtx): Im =
  im.copy(methods = List.map(im.methods, fn => rewriteFun(fn, dec)))

def rewriteFun(fn: Fun, dec: DecodeCtx): Fun =
  fn.copy(body = walk(fn.body, fn.ret, dec))

def walk(e: Expr, expected: String, dec: DecodeCtx): Expr =
  e match {
    case Expr.EMethod(recv, name, args, off) => walkMethod(recv, name, args, off, expected, dec)
    case Expr.ECall(name, args, off) => walkCall(name, args, off, expected, dec)
    case Expr.EAscribe(value, ann, off) => Expr.EAscribe(walk(value, ann, dec), ann, off)
    case Expr.EMatch(value, arms, off) => Expr.EMatch(walk(value, "", dec), List.map(arms, arm => walkArm(arm, expected, dec)), off)
    case Expr.EIf(cond, yes, no, off) => Expr.EIf(walk(cond, "", dec), walk(yes, expected, dec), walk(no, expected, dec), off)
    case Expr.EFor(binds, body, off) => Expr.EFor(List.map(binds, bind => walkBind(bind, dec)), walk(body, forBody(expected, binds), dec), off)
    case Expr.EPrint(value, off) => Expr.EPrint(walk(value, "", dec), off)
    case Expr.EBin(op, left, right, off) => Expr.EBin(op, walk(left, "", dec), walk(right, "", dec), off)
    case Expr.EUn(op, value, off) => Expr.EUn(op, walk(value, "", dec), off)
    case Expr.ELam(name, ann, body) => Expr.ELam(name, ann, walk(body, "", dec))
    case Expr.EInterp(text, parts, off) => Expr.EInterp(text, walkExprs(parts, dec), off)
    case Expr.EList(values) => Expr.EList(walkExprs(values, dec))
    case Expr.ETuple(values) => Expr.ETuple(walkExprs(values, dec))
    case Expr.ENamed(name, value) => Expr.ENamed(name, walk(value, "", dec))
    case Expr.EField(recv, name, off) => Expr.EField(walk(recv, "", dec), name, off)
    case _ => e
  }

def walkArm(arm: Arm, expected: String, dec: DecodeCtx): Arm =
  arm.copy(body = walk(arm.body, expected, dec))

def walkBind(bind: Bind, dec: DecodeCtx): Bind =
  bind.copy(value = walk(bind.value, "", dec))

def walkExprs(values: List[Expr], dec: DecodeCtx): List[Expr] =
  List.map(values, value => walk(value, "", dec))

def forBody(expected: String, binds: List[Bind]): String =
  if (draws(binds)) ioSuccess(expected) else expected

def draws(binds: List[Bind]): Bool =
  if (List.isEmpty(binds)) false else if (List.at(binds, 0).draw) true else draws(List.tail(binds))

def ioSuccess(expected: String): String =
  if (Type.appName(Type.parse(expected)) == "IO") Type.show(Type.ioOk(Type.parse(expected))) else expected

def walkMethod(recv: Expr, name: String, args: List[Expr], off: Int, expected: String, dec: DecodeCtx): Expr =
  if (isDecode(recv, name, args)) decodeAt(List.at(args, 0), off, expected, dec) else Expr.EMethod(walk(recv, "", dec), name, walkExprs(args, dec), off)

def walkCall(name: String, args: List[Expr], off: Int, expected: String, dec: DecodeCtx): Expr =
  if (name == "Json.decode" && List.len(args) == 1) decodeAt(List.at(args, 0), off, expected, dec) else Expr.ECall(name, walkExprs(args, dec), off)

def isDecode(recv: Expr, name: String, args: List[Expr]): Bool =
  name == "decode" && isJsonRecv(recv) && List.len(args) == 1

def isJsonRecv(recv: Expr): Bool =
  recv match {
    case Expr.EVar(name, _) => name == "Json"
    case _ => false
  }

def decodeAt(arg: Expr, off: Int, expected: String, dec: DecodeCtx): Expr =
  decodeUse(walk(arg, "", dec), resultPayload(expected, dec.aliases), dec.copy(off = off))

def decodeUse(arg: Expr, payload: String, dec: DecodeCtx): Expr =
  if (payload == "") keepDecode(arg, dec.off) else decodeReady(arg, payload, dec)

def keepDecode(arg: Expr, off: Int): Expr =
  Expr.EMethod(Expr.EVar("Json", off), "decode", arg :: [], off)

def decodeReady(arg: Expr, payload: String, dec: DecodeCtx): Expr =
  decodeChecked(arg, expandTy(payload, dec.aliases), dec)

def decodeChecked(arg: Expr, ty: String, dec: DecodeCtx): Expr =
  decodeReason(arg, ty, topReason(ty, dec), dec)

def decodeReason(arg: Expr, ty: String, reason: String, dec: DecodeCtx): Expr =
  if (reason != "") Expr.ECall("Json.decode", Expr.EStr(reason, dec.off) :: [], dec.off) else decodeTarget(arg, ty, dec)

def decodeTarget(arg: Expr, ty: String, dec: DecodeCtx): Expr =
  if (isStringMapTy(ty)) bindStringMap(arg, dec) else if (isRecordMapTy(ty, dec)) bindRecordMap(arg, recordMapName(ty), dec) else if (isStringSetTy(ty)) bindStringSet(arg, dec) else bindDecode(arg, recordName(ty), dec)

def topReason(ty: String, dec: DecodeCtx): String =
  if (isStringMapTy(ty) || isStringSetTy(ty)) "" else if (isRecordMapTy(ty, dec)) fieldProblems(recordFields(recordMapName(ty), dec.enums), "", dec, 32, recordMapName(ty) :: []) else if (isRecordTy(ty, dec)) fieldProblems(recordFields(recordName(ty), dec.enums), "", dec, 32, recordName(ty) :: []) else "Json.decode needs a record result"

def isStringMapTy(ty: String): Bool =
  isStringMap(Type.parse(ty))

def isStringMap(ty: Ty): Bool =
  ty match {
    case Ty.App(name, args) => name == "Map" && List.len(args) == 2 && isStringTy(List.at(args, 0)) && isStringTy(List.at(args, 1))
    case _ => false
  }

def isStringSetTy(ty: String): Bool =
  isStringSet(Type.parse(ty))

def isStringSet(ty: Ty): Bool =
  ty match {
    case Ty.App(name, args) => name == "Set" && List.len(args) == 1 && isStringTy(List.at(args, 0))
    case _ => false
  }

def isRecordMapTy(ty: String, dec: DecodeCtx): Bool =
  isRecordMap(Type.parse(ty), dec)

def isRecordMap(ty: Ty, dec: DecodeCtx): Bool =
  ty match {
    case Ty.App(name, args) => name == "Map" && List.len(args) == 2 && isStringTy(List.at(args, 0)) && isPlainRecord(recordNameOf(List.at(args, 1)), dec.enums)
    case _ => false
  }

def recordMapName(ty: String): String =
  recordNameOf(List.at(Type.appArgs(Type.parse(ty)), 1))

def bindStringMap(arg: Expr, dec: DecodeCtx): Expr =
  Expr.EFor(Bind(false, recvName(dec.off), arg) :: [], stringMapBody(recvName(dec.off), dec), dec.off)

def stringMapBody(recv: String, dec: DecodeCtx): Expr =
  Expr.EAscribe(Expr.EIf(jsonIsObj(recv, dec.off), stringMapFold(recv, dec), errText(dec.off, "Json.decode: wrong case"), dec.off), "Result[String, Map[String, String]]", dec.off)

def stringMapFold(recv: String, dec: DecodeCtx): Expr =
  call3("List.foldLeft", jsonPairs(recv, dec.off), mapSeed(dec.off), mapLam(dec), dec.off)

def jsonPairs(name: String, off: Int): Expr =
  Expr.EMethod(Expr.EVar("Json", off), "pairs", Expr.EVar(name, off) :: [], off)

def mapSeed(off: Int): Expr =
  Expr.EAscribe(okValue(Expr.EAscribe(Expr.EMethod(Expr.EVar("Map", off), "empty", [], off), "Map[String, String]", off), off), "Result[String, Map[String, String]]", off)

def mapLam(dec: DecodeCtx): Expr =
  Expr.ELam("__tup", "", Expr.EMatch(Expr.EVar("__tup", dec.off), Arm(pairPat(mapAccName(dec), mapPairName(dec)), "", mapOnPair(dec)) :: [], dec.off))

def mapOnPair(dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EVar(mapPairName(dec), dec.off), Arm(pairPat(mapKeyName(dec), mapValName(dec)), "", mapOnAcc(dec)) :: [], dec.off)

def mapOnAcc(dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EVar(mapAccName(dec), dec.off), Arm(okBind(dec.off, "m"), "", mapOnValue(dec)) :: Arm(errPat(dec.off, "m"), "", errPass("m", dec.off)) :: [], dec.off)

def mapOnValue(dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EVar(mapValName(dec), dec.off), Arm(jsonPat("Str", dec.off, "s"), "", mapPut(dec)) :: Arm("_", "", mapKeyErr(dec)) :: [], dec.off)

def mapPut(dec: DecodeCtx): Expr =
  okValue(Expr.EMethod(Expr.EVar("Map", dec.off), "set", Expr.EVar(valName(dec.off, "m"), dec.off) :: Expr.EVar(mapKeyName(dec), dec.off) :: Expr.EVar(valName(dec.off, "s"), dec.off) :: [], dec.off), dec.off)

def mapKeyErr(dec: DecodeCtx): Expr =
  errExpr(dec.off, call2("Str.concat", strExpr("Json.decode: wrong case at ", dec.off), Expr.EVar(mapKeyName(dec), dec.off), dec.off))

def mapAccName(dec: DecodeCtx): String =
  accName(dec.off, "m")

def mapPairName(dec: DecodeCtx): String =
  pairName(dec.off, "m")

def mapKeyName(dec: DecodeCtx): String =
  idxName(dec.off, "m")

def mapValName(dec: DecodeCtx): String =
  itemName(dec.off, "m")

def bindRecordMap(arg: Expr, typeName: String, dec: DecodeCtx): Expr =
  Expr.EFor(Bind(false, recvName(dec.off), arg) :: [], recordMapBody(recvName(dec.off), typeName, dec), dec.off)

def recordMapBody(recv: String, typeName: String, dec: DecodeCtx): Expr =
  Expr.EAscribe(Expr.EIf(jsonIsObj(recv, dec.off), recordMapFold(recv, typeName, dec), errText(dec.off, "Json.decode: wrong case"), dec.off), resultOf(mapTy(typeName)), dec.off)

def mapTy(typeName: String): String =
  Str.concat("Map[String, ", Str.concat(typeName, "]"))

def recordMapFold(recv: String, typeName: String, dec: DecodeCtx): Expr =
  call3("List.foldLeft", jsonPairs(recv, dec.off), recordMapSeed(typeName, dec.off), recordMapLam(typeName, dec), dec.off)

def recordMapSeed(typeName: String, off: Int): Expr =
  Expr.EAscribe(okValue(Expr.EAscribe(Expr.EMethod(Expr.EVar("Map", off), "empty", [], off), mapTy(typeName), off), off), resultOf(mapTy(typeName)), off)

def recordMapLam(typeName: String, dec: DecodeCtx): Expr =
  Expr.ELam("__tup", "", Expr.EMatch(Expr.EVar("__tup", dec.off), Arm(pairPat(mapAccName(dec), mapPairName(dec)), "", recordMapOnPair(typeName, dec)) :: [], dec.off))

def recordMapOnPair(typeName: String, dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EVar(mapPairName(dec), dec.off), Arm(pairPat(mapKeyName(dec), mapValName(dec)), "", recordMapOnAcc(typeName, dec)) :: [], dec.off)

def recordMapOnAcc(typeName: String, dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EVar(mapAccName(dec), dec.off), Arm(okBind(dec.off, "m"), "", recordMapOnValue(typeName, dec)) :: Arm(errPat(dec.off, "m"), "", errPass("m", dec.off)) :: [], dec.off)

def recordMapOnValue(typeName: String, dec: DecodeCtx): Expr =
  Expr.EIf(jsonIsObj(mapValName(dec), dec.off), recordMapPut(typeName, dec), mapKeyErr(dec), dec.off)

def recordMapPut(typeName: String, dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EAscribe(recordMapRead(typeName, dec), resultOf(typeName), dec.off), Arm(okBind(dec.off, "mv"), "", recordMapSet(dec)) :: Arm(errPat(dec.off, "mv"), "", errPass("mv", dec.off)) :: [], dec.off)

def recordMapRead(typeName: String, dec: DecodeCtx): Expr =
  if (List.contains(dec.recs, typeName)) callDec(recFun(typeName), Expr.EVar(mapValName(dec), dec.off), Expr.EVar(mapKeyName(dec), dec.off), dec.off) else genRecord(mapValName(dec), typeName, Expr.EVar(mapKeyName(dec), dec.off), "mv", dec, 32)

def recordMapSet(dec: DecodeCtx): Expr =
  okValue(Expr.EMethod(Expr.EVar("Map", dec.off), "set", Expr.EVar(valName(dec.off, "m"), dec.off) :: Expr.EVar(mapKeyName(dec), dec.off) :: Expr.EVar(valName(dec.off, "mv"), dec.off) :: [], dec.off), dec.off)

def bindStringSet(arg: Expr, dec: DecodeCtx): Expr =
  Expr.EFor(Bind(false, recvName(dec.off), arg) :: [], stringSetBody(recvName(dec.off), dec), dec.off)

def stringSetBody(recv: String, dec: DecodeCtx): Expr =
  Expr.EAscribe(Expr.EIf(jsonIsArr(recv, dec.off), stringSetFold(recv, dec), errText(dec.off, "Json.decode: wrong case"), dec.off), "Result[String, Set[String]]", dec.off)

def stringSetFold(recv: String, dec: DecodeCtx): Expr =
  call3("List.foldLeft", call1("List.zipWithIndex", jsonArr(recv, dec.off), dec.off), setSeed(dec.off), setLam(dec), dec.off)

def setSeed(off: Int): Expr =
  Expr.EAscribe(okValue(Expr.EAscribe(Expr.EMethod(Expr.EVar("Set", off), "empty", [], off), "Set[String]", off), off), "Result[String, Set[String]]", off)

def setLam(dec: DecodeCtx): Expr =
  Expr.ELam("__tup", "", Expr.EMatch(Expr.EVar("__tup", dec.off), Arm(pairPat(setAccName(dec), setPairName(dec)), "", setOnPair(dec)) :: [], dec.off))

def setOnPair(dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EVar(setPairName(dec), dec.off), Arm(pairPat(setIdxName(dec), setItemName(dec)), "", setOnAcc(dec)) :: [], dec.off)

def setOnAcc(dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EVar(setAccName(dec), dec.off), Arm(okBind(dec.off, "s"), "", setOnItem(dec)) :: Arm(errPat(dec.off, "s"), "", errPass("s", dec.off)) :: [], dec.off)

def setOnItem(dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EVar(setItemName(dec), dec.off), Arm(jsonPat("Str", dec.off, "t"), "", setAdd(dec)) :: Arm("_", "", setIdxErr(dec)) :: [], dec.off)

def setAdd(dec: DecodeCtx): Expr =
  okValue(Expr.EMethod(Expr.EVar("Set", dec.off), "add", Expr.EVar(valName(dec.off, "s"), dec.off) :: Expr.EVar(valName(dec.off, "t"), dec.off) :: [], dec.off), dec.off)

def setIdxErr(dec: DecodeCtx): Expr =
  errExpr(dec.off, wrongExpr(indexPath(strExpr("", dec.off), setIdxName(dec), dec.off), dec.off))

def setAccName(dec: DecodeCtx): String =
  accName(dec.off, "s")

def setPairName(dec: DecodeCtx): String =
  pairName(dec.off, "s")

def setIdxName(dec: DecodeCtx): String =
  idxName(dec.off, "s")

def setItemName(dec: DecodeCtx): String =
  itemName(dec.off, "s")

def resultPayload(expected: String, aliases: List[Alias]): String =
  payloadOf(Type.parse(expandTy(expected, aliases)))

def payloadOf(ty: Ty): String =
  ty match {
    case Ty.App(name, args) => if (name == "Result" && List.len(args) == 2 && isStringTy(List.at(args, 0))) Type.show(List.at(args, 1)) else ""
    case _ => ""
  }

def isStringTy(ty: Ty): Bool =
  ty match {
    case Ty.Named(name) => name == "String"
    case Ty.TVar(name) => name == "String"
    case _ => false
  }

def recordName(ty: String): String =
  recordNameOf(Type.parse(ty))

def recordNameOf(ty: Ty): String =
  ty match {
    case Ty.Named(name) => name
    case _ => ""
  }

def isRecordTy(ty: String, dec: DecodeCtx): Bool =
  isPlainRecord(recordName(expandTy(ty, dec.aliases)), dec.enums)

def isPlainRecord(name: String, enums: List[En]): Bool =
  if (name == "" || List.isEmpty(enums)) false else plainRecord(List.at(enums, 0), List.tail(enums), name)

def plainRecord(en: En, rest: List[En], name: String): Bool =
  if (en.isRec && en.name == name && List.isEmpty(en.tparams)) true else isPlainRecord(name, rest)

def recordFields(name: String, enums: List[En]): List[Param] =
  if (List.isEmpty(enums)) [] else recordFieldsEn(List.at(enums, 0), List.tail(enums), name)

def recordFieldsEn(en: En, rest: List[En], name: String): List[Param] =
  if (en.isRec && en.name == name) caseFields(en.cases) else recordFields(name, rest)

def caseFields(cases: List[EnCase]): List[Param] =
  if (List.isEmpty(cases)) [] else List.at(cases, 0).fields

def fieldProblems(fields: List[Param], prefix: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  if (List.isEmpty(fields)) "" else fieldProblem(List.at(fields, 0), List.tail(fields), prefix, dec, fuel, seen)

def fieldProblem(field: Param, rest: List[Param], prefix: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  problemNext(typeProblem(expandTy(field.ty, dec.aliases), joinPath(prefix, field.name), dec, fuel - 1, seen), rest, prefix, dec, fuel, seen)

def problemNext(reason: String, rest: List[Param], prefix: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  if (reason != "") reason else fieldProblems(rest, prefix, dec, fuel, seen)

def typeProblem(ty: String, path: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  if (fuel <= 0) badRead(path) else typeProblemOf(Type.parse(ty), path, dec, fuel, seen)

def typeProblemOf(ty: Ty, path: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  ty match {
    case Ty.Named(name) => nameProblem(name, path, dec, fuel, seen)
    case Ty.App(name, args) => if (name == "List" && List.len(args) == 1) listProblem(List.at(args, 0), path, dec, fuel, seen, true) else if (name == "Option" && List.len(args) == 1) optionProblem(List.at(args, 0), path, dec, fuel, seen) else badRead(path)
    case _ => badRead(path)
  }

def nameProblem(name: String, path: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  if (isScalar(name) || name == "Json" || isUnitEnum(name, dec)) "" else if (isPayloadEnum(name, dec)) payloadProblem(name, path, dec, fuel, seen) else recordProblem(name, path, dec, fuel, seen)

def listProblem(elem: Ty, path: String, dec: DecodeCtx, fuel: Int, seen: List[String], optOk: Bool): String =
  elem match {
    case Ty.Named(name) => namedListProblem(name, path, dec, fuel, seen)
    case Ty.App(name, args) => if (name == "List" && List.len(args) == 1 && fuel > 0) listProblem(List.at(args, 0), path, dec, fuel - 1, seen, false) else if (optOk && name == "Option" && List.len(args) == 1) optionElemProblem(List.at(args, 0), path, dec, fuel, seen) else badRead(path)
    case _ => badRead(path)
  }

def namedListProblem(name: String, path: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  if (isScalar(name) || isUnitEnum(name, dec)) "" else if (isPlainRecord(name, dec.enums) && List.contains(seen, name)) "" else recordProblem(name, path, dec, fuel, seen)

def optionElemProblem(inner: Ty, path: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  inner match {
    case Ty.Named(name) => if (isScalar(name)) "" else if (isPlainRecord(name, dec.enums)) recordProblem(name, path, dec, fuel, seen) else badRead(path)
    case _ => badRead(path)
  }

def optionProblem(inner: Ty, path: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  inner match {
    case Ty.Named(name) => if (isScalar(name) || isUnitEnum(name, dec)) "" else recordProblem(name, path, dec, fuel, seen)
    case Ty.App(name, args) => if (name == "List" && List.len(args) == 1 && isStringTy(List.at(args, 0))) "" else badRead(path)
    case _ => badRead(path)
  }

def recordProblem(name: String, path: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  if (!isPlainRecord(name, dec.enums) || List.contains(seen, name)) badRead(path) else fieldProblems(recordFields(name, dec.enums), path, dec, fuel, name :: seen)

def isScalar(name: String): Bool =
  name == "String" || name == "Int" || name == "Bool" || name == "Float"

def isUnitEnum(name: String, dec: DecodeCtx): Bool =
  unitHit(name, dec.enums)

def unitHit(name: String, enums: List[En]): Bool =
  if (name == "" || List.isEmpty(enums)) false else unitHead(name, List.at(enums, 0), List.tail(enums))

def unitHead(name: String, en: En, rest: List[En]): Bool =
  if (en.name == name) unitEn(en) else unitHit(name, rest)

def unitEn(en: En): Bool =
  if (en.isRec || !List.isEmpty(en.tparams)) false else unitCases(en.cases)

def unitCases(cases: List[EnCase]): Bool =
  if (List.isEmpty(cases)) false else if (!List.isEmpty(List.at(cases, 0).fields)) false else unitTail(List.tail(cases))

def unitTail(cases: List[EnCase]): Bool =
  if (List.isEmpty(cases)) true else if (!List.isEmpty(List.at(cases, 0).fields)) false else unitTail(List.tail(cases))

def isPayloadEnum(name: String, dec: DecodeCtx): Bool =
  payloadFound(name, dec.enums)

def payloadFound(name: String, enums: List[En]): Bool =
  if (name == "" || List.isEmpty(enums)) false else payloadHead(name, List.at(enums, 0), List.tail(enums))

def payloadHead(name: String, en: En, rest: List[En]): Bool =
  if (en.name == name) payloadEn(en) else payloadFound(name, rest)

def payloadEn(en: En): Bool =
  if (en.isRec || !List.isEmpty(en.tparams) || List.isEmpty(en.cases)) false else oneFieldCases(en.cases)

def oneFieldCases(cases: List[EnCase]): Bool =
  if (List.isEmpty(cases)) true else if (List.len(List.at(cases, 0).fields) == 1) oneFieldCases(List.tail(cases)) else false

def payloadProblem(name: String, path: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  if (fuel <= 0 || List.contains(seen, name)) badRead(path) else payloadCaseProblems(enumCasesOf(name, dec.enums), path, dec, fuel, name :: seen)

def payloadCaseProblems(cases: List[EnCase], path: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  if (List.isEmpty(cases)) "" else payloadCaseProblem(List.at(cases, 0), List.tail(cases), path, dec, fuel, seen)

def payloadCaseProblem(c: EnCase, rest: List[EnCase], path: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  if (List.isEmpty(c.fields)) badRead(path) else payloadNext(payloadTypeProblem(expandTy(List.at(c.fields, 0).ty, dec.aliases), joinPath(path, List.at(c.fields, 0).name), dec, fuel - 1, seen), rest, path, dec, fuel, seen)

def payloadNext(reason: String, rest: List[EnCase], path: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  if (reason != "") reason else payloadCaseProblems(rest, path, dec, fuel, seen)

def payloadTypeProblem(ty: String, path: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  if (fuel <= 0) badRead(path) else payloadTypeOf(Type.parse(ty), path, dec, fuel, seen)

def payloadTypeOf(ty: Ty, path: String, dec: DecodeCtx, fuel: Int, seen: List[String]): String =
  ty match {
    case Ty.Named(name) => if (isScalar(name) || name == "Json" || isUnitEnum(name, dec)) "" else if (isPayloadEnum(name, dec)) payloadProblem(name, path, dec, fuel, seen) else if (isPlainRecord(name, dec.enums)) recordProblem(name, path, dec, fuel, seen) else badRead(path)
    case Ty.App(name, args) => if (name == "List" && List.len(args) == 1) payloadListProblem(List.at(args, 0), path, dec, seen) else badRead(path)
    case _ => badRead(path)
  }

def payloadListProblem(elem: Ty, path: String, dec: DecodeCtx, seen: List[String]): String =
  elem match {
    case Ty.Named(name) => if (isPayloadEnum(name, dec) && List.contains(seen, name)) "" else badRead(path)
    case _ => badRead(path)
  }

def enumCasesOf(name: String, enums: List[En]): List[EnCase] =
  if (List.isEmpty(enums)) [] else enumCasesHead(name, List.at(enums, 0), List.tail(enums))

def enumCasesHead(name: String, en: En, rest: List[En]): List[EnCase] =
  if (en.name == name) en.cases else enumCasesOf(name, rest)

def bindDecode(arg: Expr, ctor: String, dec: DecodeCtx): Expr =
  if (List.contains(dec.recs, ctor)) callDec(recFun(ctor), arg, strExpr("", dec.off), dec.off) else Expr.EFor(Bind(false, recvName(dec.off), arg) :: [], genRecord(recvName(dec.off), ctor, strExpr("", dec.off), "", dec, 32), dec.off)

def genRecord(recv: String, ctor: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  if (fuel <= 0) errText(dec.off, badRead(pathText(path))) else readFields(recv, ctor, recordFields(ctor, dec.enums), [], path, slot, dec, fuel)

def readFields(recv: String, ctor: String, fields: List[Param], done: List[Expr], path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  if (List.isEmpty(fields)) if (List.isEmpty(done)) emptyObj(recv, ctor, path, dec) else okRecord(ctor, done, dec.off) else readOne(recv, ctor, List.at(fields, 0), List.tail(fields), done, path, slot, dec, fuel)

def readOne(recv: String, ctor: String, field: Param, rest: List[Param], done: List[Expr], path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  readTyped(recv, ctor, field.name, expandTy(field.ty, dec.aliases), rest, done, joinPathExpr(path, field.name, dec.off), joinSlot(slot, field.name), path, slot, dec, fuel)

def readTyped(recv: String, ctor: String, name: String, ty: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  readDecoded(Type.parse(ty), recv, ctor, name, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel)

def readDecoded(ty: Ty, recv: String, ctor: String, name: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  ty match {
    case Ty.App(app, args) => if (app == "Option" && List.len(args) == 1) readOption(List.at(args, 0), recv, ctor, name, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel) else matchField(ty, recv, ctor, name, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel)
    case _ => matchField(ty, recv, ctor, name, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel)
  }

def matchField(ty: Ty, recv: String, ctor: String, name: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(jsonField(recv, name, dec.off), kindArms(ty, recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel), dec.off)

def readOption(inner: Ty, recv: String, ctor: String, name: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(Expr.EAscribe(optionDecoded(inner, recv, name, fieldPath, fieldSlot, dec, fuel), optionResult(inner), dec.off), Arm(okBind(dec.off, optSlot(fieldSlot)), "", nextField(recv, ctor, rest, snoc(done, Expr.EVar(valName(dec.off, optSlot(fieldSlot)), dec.off)), path, slot, dec, fuel)) :: Arm(errPat(dec.off, optSlot(fieldSlot)), "", errPass(optSlot(fieldSlot), dec.off)) :: [], dec.off)

def optionDecoded(inner: Ty, recv: String, name: String, fieldPath: Expr, fieldSlot: String, dec: DecodeCtx, fuel: Int): Expr =
  inner match {
    case Ty.Named(typeName) => if (isScalar(typeName)) scalarOption(if (typeName == "String") "Str" else typeName, typeName, recv, name, fieldPath, fieldSlot, dec) else if (isUnitEnum(typeName, dec)) enumOption(typeName, recv, name, fieldPath, fieldSlot, dec) else recordOption(typeName, recv, name, fieldPath, fieldSlot, dec, fuel)
    case Ty.App(typeName, args) => if (typeName == "List" && List.len(args) == 1 && isStringTy(List.at(args, 0))) stringListOption(recv, name, fieldPath, fieldSlot, dec) else errExpr(dec.off, wrongExpr(fieldPath, dec.off))
    case _ => errExpr(dec.off, wrongExpr(fieldPath, dec.off))
  }

def stringListOption(recv: String, name: String, fieldPath: Expr, fieldSlot: String, dec: DecodeCtx): Expr =
  Expr.EMatch(jsonField(recv, name, dec.off), Arm(nullPat(), "", okValue(optionNone("List[String]", dec.off), dec.off)) :: Arm(okBind(dec.off, fieldSlot), "", stringListSome(fieldPath, fieldSlot, dec)) :: Arm(errPat(dec.off, fieldSlot), "", missingOption("List[String]", fieldPath, fieldSlot, dec)) :: [], dec.off)

def stringListSome(fieldPath: Expr, fieldSlot: String, dec: DecodeCtx): Expr =
  Expr.EIf(jsonIsArr(valName(dec.off, fieldSlot), dec.off), stringListFold(valName(dec.off, fieldSlot), fieldPath, fieldSlot, dec), errExpr(dec.off, wrongExpr(fieldPath, dec.off)), dec.off)

def stringListFold(jsonVar: String, fieldPath: Expr, fieldSlot: String, dec: DecodeCtx): Expr =
  Expr.EMatch(call3("List.foldLeft", call1("List.zipWithIndex", jsonArr(jsonVar, dec.off), dec.off), okSeed(Type.tNamed("String"), dec.off), foldLam(Type.tNamed("String"), fieldPath, fieldSlot, dec, 32), dec.off), Arm(okBind(dec.off, joinSlot(fieldSlot, "x")), "", okValue(optionSome(call1("List.reverse", Expr.EVar(valName(dec.off, joinSlot(fieldSlot, "x")), dec.off), dec.off), dec.off), dec.off)) :: Arm(errPat(dec.off, joinSlot(fieldSlot, "x")), "", errPass(joinSlot(fieldSlot, "x"), dec.off)) :: [], dec.off)

def scalarOption(tag: String, typeName: String, recv: String, name: String, fieldPath: Expr, fieldSlot: String, dec: DecodeCtx): Expr =
  Expr.EMatch(jsonField(recv, name, dec.off), Arm(nullPat(), "", okValue(optionNone(typeName, dec.off), dec.off)) :: Arm(okTag(tag, dec.off, fieldSlot), "", okValue(optionSome(Expr.EVar(valName(dec.off, fieldSlot), dec.off), dec.off), dec.off)) :: Arm("Result.Ok(_)", "", errExpr(dec.off, wrongExpr(fieldPath, dec.off))) :: Arm(errPat(dec.off, fieldSlot), "", missingOption(typeName, fieldPath, fieldSlot, dec)) :: [], dec.off)

def recordOption(typeName: String, recv: String, name: String, fieldPath: Expr, fieldSlot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(jsonField(recv, name, dec.off), Arm(nullPat(), "", okValue(optionNone(typeName, dec.off), dec.off)) :: Arm(okBind(dec.off, fieldSlot), "", optionRecordValue(typeName, fieldPath, fieldSlot, dec, fuel)) :: Arm(errPat(dec.off, fieldSlot), "", missingOption(typeName, fieldPath, fieldSlot, dec)) :: [], dec.off)

def enumOption(typeName: String, recv: String, name: String, fieldPath: Expr, fieldSlot: String, dec: DecodeCtx): Expr =
  Expr.EMatch(jsonField(recv, name, dec.off), Arm(nullPat(), "", okValue(optionNone(typeName, dec.off), dec.off)) :: Arm(okTag("Str", dec.off, fieldSlot), "", enumOptionText(typeName, fieldPath, fieldSlot, dec)) :: Arm(okBind(dec.off, joinSlot(fieldSlot, "b")), "", wrongEnum(fieldPath, joinSlot(fieldSlot, "b"), dec)) :: Arm(errPat(dec.off, fieldSlot), "", missingOption(typeName, fieldPath, fieldSlot, dec)) :: [], dec.off)

def enumOptionText(typeName: String, fieldPath: Expr, fieldSlot: String, dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EAscribe(enumValue(typeName, valName(dec.off, fieldSlot), enumCasesOf(typeName, dec.enums), fieldPath, dec), enumResult(typeName), dec.off), Arm(okBind(dec.off, joinSlot(fieldSlot, "e")), "", okValue(optionSome(Expr.EVar(valName(dec.off, joinSlot(fieldSlot, "e")), dec.off), dec.off), dec.off)) :: Arm(errPat(dec.off, joinSlot(fieldSlot, "e")), "", errPass(joinSlot(fieldSlot, "e"), dec.off)) :: [], dec.off)

def optionRecordValue(typeName: String, fieldPath: Expr, fieldSlot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(genRecord(valName(dec.off, fieldSlot), typeName, fieldPath, fieldSlot, dec, fuel - 1), Arm(okRec(dec.off, fieldSlot), "", okValue(optionSome(Expr.EVar(recName(dec.off, fieldSlot), dec.off), dec.off), dec.off)) :: Arm(errPat(dec.off, fieldSlot), "", errPass(fieldSlot, dec.off)) :: [], dec.off)

def missingOption(typeName: String, fieldPath: Expr, fieldSlot: String, dec: DecodeCtx): Expr =
  Expr.EIf(missingField(fieldSlot, dec.off), okValue(optionNone(typeName, dec.off), dec.off), errExpr(dec.off, wrongExpr(fieldPath, dec.off)), dec.off)

def missingField(slot: String, off: Int): Expr =
  Expr.EBin("==", Expr.EVar(errName(off, slot), off), Expr.EStr("Json.field: missing field", off), off)

def optionNone(typeName: String, off: Int): Expr =
  Expr.EAscribe(Expr.EMethod(Expr.EVar("Option", off), "None", [], off), Str.concat("Option[", Str.concat(typeName, "]")), off)

def optionSome(value: Expr, off: Int): Expr =
  Expr.EMethod(Expr.EVar("Option", off), "Some", value :: [], off)

def okValue(value: Expr, off: Int): Expr =
  Expr.EMethod(Expr.EVar("Result", off), "Ok", value :: [], off)

def nullPat(): String =
  "Result.Ok(Json.Null)"

def optSlot(slot: String): String =
  joinSlot(slot, "o")

def optionResult(inner: Ty): String =
  Str.concat("Result[String, Option[", Str.concat(Type.show(inner), "]]"))

def kindArms(ty: Ty, recv: String, ctor: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): List[Arm] =
  ty match {
    case Ty.Named(name) => namedArms(name, recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel)
    case Ty.App(name, args) => if (name == "List" && List.len(args) == 1) listArms(List.at(args, 0), recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel) else badArms(fieldPath, fieldSlot, dec)
    case _ => badArms(fieldPath, fieldSlot, dec)
  }

def namedArms(name: String, recv: String, ctor: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): List[Arm] =
  if (name == "String") scalarArms("Str", recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel) else if (name == "Int") scalarArms("Int", recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel) else if (name == "Bool") scalarArms("Bool", recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel) else if (name == "Float") scalarArms("Float", recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel) else if (name == "Json") jsonArms(recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel) else if (isUnitEnum(name, dec)) enumArms(name, recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel) else if (isPayloadEnum(name, dec)) payloadArms(name, recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel) else recordArms(name, recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel)

def enumArms(typeName: String, recv: String, ctor: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): List[Arm] =
  Arm(okTag("Str", dec.off, fieldSlot), "", enumMatched(typeName, recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel)) :: Arm(okBind(dec.off, joinSlot(fieldSlot, "b")), "", wrongEnum(fieldPath, joinSlot(fieldSlot, "b"), dec)) :: Arm(errPat(dec.off, fieldSlot), "", errMap(fieldPath, fieldSlot, dec.off)) :: []

def enumMatched(typeName: String, recv: String, ctor: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(Expr.EAscribe(enumValue(typeName, valName(dec.off, fieldSlot), enumCasesOf(typeName, dec.enums), fieldPath, dec), enumResult(typeName), dec.off), Arm(okBind(dec.off, joinSlot(fieldSlot, "e")), "", nextField(recv, ctor, rest, snoc(done, Expr.EVar(valName(dec.off, joinSlot(fieldSlot, "e")), dec.off)), path, slot, dec, fuel)) :: Arm(errPat(dec.off, joinSlot(fieldSlot, "e")), "", errPass(joinSlot(fieldSlot, "e"), dec.off)) :: [], dec.off)

def enumValue(typeName: String, text: String, cases: List[EnCase], path: Expr, dec: DecodeCtx): Expr =
  if (List.isEmpty(cases)) unknownEnum(path, text, dec) else enumOne(typeName, text, List.at(cases, 0), List.tail(cases), path, dec)

def enumOne(typeName: String, text: String, c: EnCase, rest: List[EnCase], path: Expr, dec: DecodeCtx): Expr =
  Expr.EIf(Expr.EBin("==", Expr.EVar(text, dec.off), Expr.EStr(c.name, dec.off), dec.off), okValue(enumCtor(typeName, c.name, dec.off), dec.off), enumValue(typeName, text, rest, path, dec), dec.off)

def enumCtor(typeName: String, caseName: String, off: Int): Expr =
  Expr.EMethod(Expr.EVar(typeName, off), caseName, [], off)

def enumResult(typeName: String): String =
  Str.concat("Result[String, ", Str.concat(typeName, "]"))

def unknownEnum(path: Expr, text: String, dec: DecodeCtx): Expr =
  errExpr(dec.off, namedValue("Json.decode: unknown case at ", path, Expr.EVar(text, dec.off), dec.off))

def wrongEnum(path: Expr, slot: String, dec: DecodeCtx): Expr =
  Expr.EMatch(call1("Json.stringify", Expr.EVar(valName(dec.off, slot), dec.off), dec.off), Arm(okBind(dec.off, joinSlot(slot, "w")), "", errExpr(dec.off, namedValue("Json.decode: wrong case at ", path, Expr.EVar(valName(dec.off, joinSlot(slot, "w")), dec.off), dec.off))) :: Arm(errPat(dec.off, joinSlot(slot, "w")), "", errExpr(dec.off, wrongExpr(path, dec.off))) :: [], dec.off)

def payloadArms(typeName: String, recv: String, ctor: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): List[Arm] =
  Arm(okBind(dec.off, fieldSlot), "", payloadMatched(typeName, recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel)) :: Arm(errPat(dec.off, fieldSlot), "", errMap(fieldPath, fieldSlot, dec.off)) :: []

def payloadMatched(typeName: String, recv: String, ctor: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(Expr.EAscribe(payloadValue(typeName, valName(dec.off, fieldSlot), fieldPath, fieldSlot, dec, fuel), enumResult(typeName), dec.off), Arm(okBind(dec.off, joinSlot(fieldSlot, "e")), "", nextField(recv, ctor, rest, snoc(done, Expr.EVar(valName(dec.off, joinSlot(fieldSlot, "e")), dec.off)), path, slot, dec, fuel)) :: Arm(errPat(dec.off, joinSlot(fieldSlot, "e")), "", errPass(joinSlot(fieldSlot, "e"), dec.off)) :: [], dec.off)

def payloadValue(typeName: String, recv: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  if (List.contains(dec.helps, typeName)) callDec(enumFun(typeName), Expr.EVar(recv, dec.off), path, dec.off) else payloadRead(typeName, recv, path, slot, dec, fuel)

def payloadRead(typeName: String, recv: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  if (fuel <= 0) errText(dec.off, badRead(pathText(path))) else payloadObj(typeName, recv, enumCasesOf(typeName, dec.enums), path, slot, dec, fuel)

def payloadObj(typeName: String, recv: String, cases: List[EnCase], path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EIf(jsonIsObj(recv, dec.off), payloadKeyed(typeName, recv, cases, path, slot, dec, fuel), valueCase("Json.decode: wrong case at ", path, recv, slot, dec), dec.off)

def payloadKeyed(typeName: String, recv: String, cases: List[EnCase], path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EIf(Expr.EBin(">", caseKeyCount(recv, cases, dec.off), intExpr(1, dec.off), dec.off), valueCase("Json.decode: wrong case at ", path, recv, slot, dec), payloadPick(typeName, recv, cases, path, slot, dec, fuel), dec.off)

def payloadPick(typeName: String, recv: String, cases: List[EnCase], path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  if (List.isEmpty(cases)) valueCase("Json.decode: unknown case at ", path, recv, slot, dec) else payloadHit(typeName, recv, List.at(cases, 0), List.tail(cases), path, slot, dec, fuel)

def payloadHit(typeName: String, recv: String, c: EnCase, rest: List[EnCase], path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EIf(jsonHas(recv, c.name, dec.off), payloadTake(typeName, recv, c, path, slot, dec, fuel), payloadPick(typeName, recv, rest, path, slot, dec, fuel), dec.off)

def payloadTake(typeName: String, recv: String, c: EnCase, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  if (List.isEmpty(c.fields)) valueCase("Json.decode: wrong case at ", path, recv, slot, dec) else payloadWrap(typeName, recv, c.name, List.at(c.fields, 0), path, slot, dec, fuel)

def payloadWrap(typeName: String, recv: String, caseName: String, field: Param, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(jsonField(recv, caseName, dec.off), Arm(okBind(dec.off, joinSlot(slot, caseName)), "", payloadField(typeName, caseName, field, joinPathExpr(path, field.name, dec.off), joinSlot(slot, caseName), dec, fuel)) :: Arm(errPat(dec.off, joinSlot(slot, caseName)), "", errMap(joinPathExpr(path, field.name, dec.off), joinSlot(slot, caseName), dec.off)) :: [], dec.off)

def payloadField(typeName: String, caseName: String, field: Param, fieldPath: Expr, caseSlot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(Expr.EAscribe(decodeHeld(Type.parse(expandTy(field.ty, dec.aliases)), valName(dec.off, caseSlot), fieldPath, joinSlot(caseSlot, "h"), dec, fuel), resultOf(expandTy(field.ty, dec.aliases)), dec.off), Arm(okBind(dec.off, joinSlot(caseSlot, "v")), "", okValue(payloadCtor(typeName, caseName, Expr.EVar(valName(dec.off, joinSlot(caseSlot, "v")), dec.off), dec.off), dec.off)) :: Arm(errPat(dec.off, joinSlot(caseSlot, "v")), "", errPass(joinSlot(caseSlot, "v"), dec.off)) :: [], dec.off)

def payloadCtor(typeName: String, caseName: String, arg: Expr, off: Int): Expr =
  Expr.EMethod(Expr.EVar(typeName, off), caseName, arg :: [], off)

def decodeHeld(ty: Ty, recv: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  ty match {
    case Ty.Named(name) => heldName(name, recv, path, slot, dec, fuel)
    case Ty.App(name, args) => if (name == "List" && List.len(args) == 1) heldList(List.at(args, 0), recv, path, slot, dec, fuel) else errExpr(dec.off, wrongExpr(path, dec.off))
    case _ => errExpr(dec.off, wrongExpr(path, dec.off))
  }

def heldList(elem: Ty, recv: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  if (fuel <= 0) errText(dec.off, badRead(pathText(path))) else heldListTy(elem, recv, path, slot, dec, fuel)

def heldListTy(elem: Ty, recv: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  elem match {
    case Ty.Named(name) => if (isPayloadEnum(name, dec)) heldEnumList(name, recv, path, slot, dec, fuel) else errExpr(dec.off, wrongExpr(path, dec.off))
    case _ => errExpr(dec.off, wrongExpr(path, dec.off))
  }

def heldEnumList(typeName: String, recv: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EIf(jsonIsArr(recv, dec.off), heldEnumFold(typeName, recv, path, slot, dec, fuel), errExpr(dec.off, wrongExpr(path, dec.off)), dec.off)

def heldEnumFold(typeName: String, recv: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(call3("List.foldLeft", call1("List.zipWithIndex", jsonArr(recv, dec.off), dec.off), okSeed(Type.tNamed(typeName), dec.off), foldLam(Type.tNamed(typeName), path, slot, dec, fuel), dec.off), Arm(okBind(dec.off, joinSlot(slot, "x")), "", okValue(call1("List.reverse", Expr.EVar(valName(dec.off, joinSlot(slot, "x")), dec.off), dec.off), dec.off)) :: Arm(errPat(dec.off, joinSlot(slot, "x")), "", errPass(joinSlot(slot, "x"), dec.off)) :: [], dec.off)

def heldName(name: String, recv: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  if (name == "String") heldScalar("Str", recv, path, slot, dec) else if (name == "Int") heldScalar("Int", recv, path, slot, dec) else if (name == "Bool") heldScalar("Bool", recv, path, slot, dec) else if (name == "Float") heldScalar("Float", recv, path, slot, dec) else if (name == "Json") okValue(Expr.EVar(recv, dec.off), dec.off) else if (isUnitEnum(name, dec)) heldUnit(name, recv, path, slot, dec) else if (isPayloadEnum(name, dec)) payloadRead(name, recv, path, slot, dec, fuel - 1) else if (isPlainRecord(name, dec.enums)) genRecord(recv, name, path, slot, dec, fuel - 1) else errExpr(dec.off, wrongExpr(path, dec.off))

def heldScalar(tag: String, recv: String, path: Expr, slot: String, dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EVar(recv, dec.off), Arm(jsonPat(tag, dec.off, slot), "", okValue(Expr.EVar(valName(dec.off, slot), dec.off), dec.off)) :: Arm("_", "", errExpr(dec.off, wrongExpr(path, dec.off))) :: [], dec.off)

def heldUnit(typeName: String, recv: String, path: Expr, slot: String, dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EVar(recv, dec.off), Arm(jsonPat("Str", dec.off, slot), "", enumValue(typeName, valName(dec.off, slot), enumCasesOf(typeName, dec.enums), path, dec)) :: Arm(valName(dec.off, joinSlot(slot, "b")), "", wrongEnum(path, joinSlot(slot, "b"), dec)) :: [], dec.off)

def valueCase(prefix: String, path: Expr, recv: String, slot: String, dec: DecodeCtx): Expr =
  Expr.EMatch(call1("Json.stringify", Expr.EVar(recv, dec.off), dec.off), Arm(okBind(dec.off, joinSlot(slot, "w")), "", errExpr(dec.off, namedValue(prefix, path, Expr.EVar(valName(dec.off, joinSlot(slot, "w")), dec.off), dec.off))) :: Arm(errPat(dec.off, joinSlot(slot, "w")), "", errExpr(dec.off, wrongExpr(path, dec.off))) :: [], dec.off)

def caseKeyCount(recv: String, cases: List[EnCase], off: Int): Expr =
  if (List.isEmpty(cases)) intExpr(0, off) else Expr.EBin("+", Expr.EIf(jsonHas(recv, List.at(cases, 0).name, off), intExpr(1, off), intExpr(0, off), off), caseKeyCount(recv, List.tail(cases), off), off)

def intExpr(n: Int, off: Int): Expr =
  Expr.EInt(n, off)

def jsonHas(recv: String, name: String, off: Int): Expr =
  Expr.EMethod(Expr.EVar("Json", off), "has", Expr.EVar(recv, off) :: Expr.EStr(name, off) :: [], off)

def jsonIsObj(name: String, off: Int): Expr =
  Expr.EMethod(Expr.EVar("Json", off), "isObj", Expr.EVar(name, off) :: [], off)

def resultOf(ty: String): String =
  Str.concat("Result[String, ", Str.concat(ty, "]"))

def namedValue(prefix: String, path: Expr, value: Expr, off: Int): Expr =
  call2("Str.concat", call2("Str.concat", call2("Str.concat", strExpr(prefix, off), path, off), strExpr(": ", off), off), value, off)

def scalarArms(tag: String, recv: String, ctor: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): List[Arm] =
  Arm(okTag(tag, dec.off, fieldSlot), "", nextField(recv, ctor, rest, snoc(done, Expr.EVar(valName(dec.off, fieldSlot), dec.off)), path, slot, dec, fuel)) :: Arm("Result.Ok(_)", "", errExpr(dec.off, wrongExpr(fieldPath, dec.off))) :: Arm(errPat(dec.off, fieldSlot), "", errMap(fieldPath, fieldSlot, dec.off)) :: []

def jsonArms(recv: String, ctor: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): List[Arm] =
  Arm(okBind(dec.off, fieldSlot), "", nextField(recv, ctor, rest, snoc(done, Expr.EVar(valName(dec.off, fieldSlot), dec.off)), path, slot, dec, fuel)) :: Arm(errPat(dec.off, fieldSlot), "", errMap(fieldPath, fieldSlot, dec.off)) :: []

def recordArms(typeName: String, recv: String, ctor: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): List[Arm] =
  Arm(okBind(dec.off, fieldSlot), "", nestRecord(typeName, recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel)) :: Arm(errPat(dec.off, fieldSlot), "", errMap(fieldPath, fieldSlot, dec.off)) :: []

def listArms(elem: Ty, recv: String, ctor: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): List[Arm] =
  Arm(okBind(dec.off, fieldSlot), "", listValue(elem, valName(dec.off, fieldSlot), recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel)) :: Arm(errPat(dec.off, fieldSlot), "", errMap(fieldPath, fieldSlot, dec.off)) :: []

def badArms(fieldPath: Expr, fieldSlot: String, dec: DecodeCtx): List[Arm] =
  Arm(errPat(dec.off, fieldSlot), "", errMap(fieldPath, fieldSlot, dec.off)) :: []

def nestRecord(typeName: String, recv: String, ctor: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(genRecord(valName(dec.off, fieldSlot), typeName, fieldPath, fieldSlot, dec, fuel - 1), Arm(okRec(dec.off, fieldSlot), "", nextField(recv, ctor, rest, snoc(done, Expr.EVar(recName(dec.off, fieldSlot), dec.off)), path, slot, dec, fuel)) :: Arm(errPat(dec.off, fieldSlot), "", errPass(fieldSlot, dec.off)) :: [], dec.off)

def listValue(elem: Ty, jsonVar: String, recv: String, ctor: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EIf(jsonIsArr(jsonVar, dec.off), listFold(elem, jsonVar, recv, ctor, rest, done, fieldPath, fieldSlot, path, slot, dec, fuel), errExpr(dec.off, wrongExpr(fieldPath, dec.off)), dec.off)

def listFold(elem: Ty, jsonVar: String, recv: String, ctor: String, rest: List[Param], done: List[Expr], fieldPath: Expr, fieldSlot: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(call3("List.foldLeft", call1("List.zipWithIndex", jsonArr(jsonVar, dec.off), dec.off), okSeed(elem, dec.off), foldLam(elem, fieldPath, fieldSlot, dec, fuel), dec.off), Arm(okBind(dec.off, joinSlot(fieldSlot, "x")), "", nextField(recv, ctor, rest, snoc(done, call1("List.reverse", Expr.EVar(valName(dec.off, joinSlot(fieldSlot, "x")), dec.off), dec.off)), path, slot, dec, fuel)) :: Arm(errPat(dec.off, joinSlot(fieldSlot, "x")), "", errPass(joinSlot(fieldSlot, "x"), dec.off)) :: [], dec.off)

def foldLam(elem: Ty, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.ELam("__tup", "", Expr.EMatch(Expr.EVar("__tup", dec.off), Arm(pairPat(accName(dec.off, slot), pairName(dec.off, slot)), "", foldPair(elem, path, slot, dec, fuel)) :: [], dec.off))

def foldPair(elem: Ty, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(Expr.EVar(pairName(dec.off, slot), dec.off), Arm(pairPat(idxName(dec.off, slot), itemName(dec.off, slot)), "", foldAcc(elem, path, slot, dec, fuel)) :: [], dec.off)

def foldAcc(elem: Ty, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(Expr.EVar(accName(dec.off, slot), dec.off), Arm(okBind(dec.off, joinSlot(slot, "x")), "", elemBody(elem, itemName(dec.off, slot), idxName(dec.off, slot), valName(dec.off, joinSlot(slot, "x")), path, slot, dec, fuel)) :: Arm(errPat(dec.off, joinSlot(slot, "x")), "", errPass(joinSlot(slot, "x"), dec.off)) :: [], dec.off)

def elemBody(elem: Ty, item: String, idx: String, xs: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  elem match {
    case Ty.Named(name) => namedElem(name, item, idx, xs, path, slot, dec, fuel)
    case Ty.App(name, args) => if (name == "List" && List.len(args) == 1) listElem(List.at(args, 0), item, idx, xs, path, slot, dec, fuel) else if (name == "Option" && List.len(args) == 1) optionListElem(List.at(args, 0), item, idx, xs, path, slot, dec, fuel) else errExpr(dec.off, wrongExpr(indexPath(path, idx, dec.off), dec.off))
    case _ => errExpr(dec.off, wrongExpr(indexPath(path, idx, dec.off), dec.off))
  }

def listElem(elem: Ty, item: String, idx: String, xs: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EIf(jsonIsArr(item, dec.off), listElemFold(elem, item, xs, indexPath(path, idx, dec.off), joinSlot(slot, "n"), dec, fuel), errExpr(dec.off, wrongExpr(indexPath(path, idx, dec.off), dec.off)), dec.off)

def listElemFold(elem: Ty, item: String, xs: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(call3("List.foldLeft", call1("List.zipWithIndex", jsonArr(item, dec.off), dec.off), okSeed(elem, dec.off), foldLam(elem, path, slot, dec, fuel), dec.off), Arm(okBind(dec.off, joinSlot(slot, "x")), "", okConsExpr(call1("List.reverse", Expr.EVar(valName(dec.off, joinSlot(slot, "x")), dec.off), dec.off), xs, dec.off)) :: Arm(errPat(dec.off, joinSlot(slot, "x")), "", errPass(joinSlot(slot, "x"), dec.off)) :: [], dec.off)

def optionListElem(inner: Ty, item: String, idx: String, xs: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  inner match {
    case Ty.Named(name) => if (isScalar(name)) scalarOptionElem(if (name == "String") "Str" else name, name, item, idx, xs, path, slot, dec) else if (isPlainRecord(name, dec.enums)) recordOptionElem(name, item, idx, xs, path, slot, dec, fuel) else errExpr(dec.off, wrongExpr(indexPath(path, idx, dec.off), dec.off))
    case _ => errExpr(dec.off, wrongExpr(indexPath(path, idx, dec.off), dec.off))
  }

def recordOptionElem(typeName: String, item: String, idx: String, xs: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(Expr.EVar(item, dec.off), Arm(jsonNullPat(), "", okConsExpr(optionNone(typeName, dec.off), xs, dec.off)) :: Arm("_", "", recordOptionPresent(typeName, item, idx, xs, path, slot, dec, fuel)) :: [], dec.off)

def recordOptionPresent(typeName: String, item: String, idx: String, xs: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EIf(jsonIsObj(item, dec.off), recordOptionTake(typeName, item, idx, xs, path, slot, dec, fuel), errExpr(dec.off, wrongExpr(indexPath(path, idx, dec.off), dec.off)), dec.off)

def recordOptionTake(typeName: String, item: String, idx: String, xs: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(Expr.EAscribe(recordOptionRead(typeName, item, idx, path, slot, dec, fuel), resultOf(typeName), dec.off), Arm(okRec(dec.off, joinSlot(slot, "e")), "", okConsExpr(optionSome(Expr.EVar(recName(dec.off, joinSlot(slot, "e")), dec.off), dec.off), xs, dec.off)) :: Arm(errPat(dec.off, joinSlot(slot, "e")), "", errPass(joinSlot(slot, "e"), dec.off)) :: [], dec.off)

def recordOptionRead(typeName: String, item: String, idx: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  if (List.contains(dec.recs, typeName)) callDec(recFun(typeName), Expr.EVar(item, dec.off), indexPath(path, idx, dec.off), dec.off) else genRecord(item, typeName, indexPath(path, idx, dec.off), joinSlot(slot, "e"), dec, fuel - 1)

def scalarOptionElem(tag: String, typeName: String, item: String, idx: String, xs: String, path: Expr, slot: String, dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EVar(item, dec.off), Arm(jsonNullPat(), "", okConsExpr(optionNone(typeName, dec.off), xs, dec.off)) :: Arm(jsonPat(tag, dec.off, joinSlot(slot, "v")), "", okConsExpr(optionSome(Expr.EVar(valName(dec.off, joinSlot(slot, "v")), dec.off), dec.off), xs, dec.off)) :: Arm("_", "", errExpr(dec.off, wrongExpr(indexPath(path, idx, dec.off), dec.off))) :: [], dec.off)

def namedElem(name: String, item: String, idx: String, xs: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  if (name == "String") scalarElem("Str", item, idx, xs, path, slot, dec) else if (name == "Int") scalarElem("Int", item, idx, xs, path, slot, dec) else if (name == "Bool") scalarElem("Bool", item, idx, xs, path, slot, dec) else if (name == "Float") scalarElem("Float", item, idx, xs, path, slot, dec) else if (isUnitEnum(name, dec)) enumElem(name, item, idx, xs, path, slot, dec) else if (isPayloadEnum(name, dec)) payloadElem(name, item, idx, xs, path, slot, dec, fuel) else recordElem(name, item, idx, xs, path, slot, dec, fuel)

def payloadElem(typeName: String, item: String, idx: String, xs: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(if (List.contains(dec.helps, typeName)) callDec(enumFun(typeName), Expr.EVar(item, dec.off), indexPath(path, idx, dec.off), dec.off) else payloadRead(typeName, item, indexPath(path, idx, dec.off), joinSlot(slot, "e"), dec, fuel - 1), Arm(okBind(dec.off, joinSlot(slot, "e")), "", okCons(valName(dec.off, joinSlot(slot, "e")), xs, dec.off)) :: Arm(errPat(dec.off, joinSlot(slot, "e")), "", errPass(joinSlot(slot, "e"), dec.off)) :: [], dec.off)

def scalarElem(tag: String, item: String, idx: String, xs: String, path: Expr, slot: String, dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EVar(item, dec.off), Arm(jsonPat(tag, dec.off, joinSlot(slot, "v")), "", okCons(valName(dec.off, joinSlot(slot, "v")), xs, dec.off)) :: Arm("_", "", errExpr(dec.off, wrongExpr(indexPath(path, idx, dec.off), dec.off))) :: [], dec.off)

def recordElem(typeName: String, item: String, idx: String, xs: String, path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  Expr.EMatch(if (List.contains(dec.recs, typeName)) callDec(recFun(typeName), Expr.EVar(item, dec.off), indexPath(path, idx, dec.off), dec.off) else genRecord(item, typeName, indexPath(path, idx, dec.off), joinSlot(slot, "e"), dec, fuel - 1), Arm(okRec(dec.off, joinSlot(slot, "e")), "", okCons(recName(dec.off, joinSlot(slot, "e")), xs, dec.off)) :: Arm(errPat(dec.off, joinSlot(slot, "e")), "", errPass(joinSlot(slot, "e"), dec.off)) :: [], dec.off)

def enumElem(typeName: String, item: String, idx: String, xs: String, path: Expr, slot: String, dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EVar(item, dec.off), Arm(jsonPat("Str", dec.off, joinSlot(slot, "v")), "", enumElemText(typeName, valName(dec.off, joinSlot(slot, "v")), idx, xs, path, slot, dec)) :: Arm(valName(dec.off, joinSlot(slot, "b")), "", wrongEnum(indexPath(path, idx, dec.off), joinSlot(slot, "b"), dec)) :: [], dec.off)

def enumElemText(typeName: String, text: String, idx: String, xs: String, path: Expr, slot: String, dec: DecodeCtx): Expr =
  Expr.EMatch(Expr.EAscribe(enumValue(typeName, text, enumCasesOf(typeName, dec.enums), indexPath(path, idx, dec.off), dec), enumResult(typeName), dec.off), Arm(okBind(dec.off, joinSlot(slot, "e")), "", okCons(valName(dec.off, joinSlot(slot, "e")), xs, dec.off)) :: Arm(errPat(dec.off, joinSlot(slot, "e")), "", errPass(joinSlot(slot, "e"), dec.off)) :: [], dec.off)

def nextField(recv: String, ctor: String, rest: List[Param], done: List[Expr], path: Expr, slot: String, dec: DecodeCtx, fuel: Int): Expr =
  readFields(recv, ctor, rest, done, path, slot, dec, fuel)

def emptyObj(recv: String, ctor: String, path: Expr, dec: DecodeCtx): Expr =
  Expr.EIf(Expr.EMethod(Expr.EVar("Json", dec.off), "isObj", Expr.EVar(recv, dec.off) :: [], dec.off), okRecord(ctor, [], dec.off), errExpr(dec.off, wrongExpr(path, dec.off)), dec.off)

def jsonField(recv: String, name: String, off: Int): Expr =
  Expr.EMethod(Expr.EVar("Json", off), "field", Expr.EVar(recv, off) :: Expr.EStr(name, off) :: [], off)

def jsonIsArr(name: String, off: Int): Expr =
  Expr.EMethod(Expr.EVar("Json", off), "isArr", Expr.EVar(name, off) :: [], off)

def jsonArr(name: String, off: Int): Expr =
  Expr.EMethod(Expr.EVar("Json", off), "arr", Expr.EVar(name, off) :: [], off)

def okRecord(ctor: String, args: List[Expr], off: Int): Expr =
  Expr.EMethod(Expr.EVar("Result", off), "Ok", Expr.ECall(ctor, args, off) :: [], off)

def okSeed(elem: Ty, off: Int): Expr =
  Expr.EAscribe(Expr.EMethod(Expr.EVar("Result", off), "Ok", Expr.EAscribe(Expr.EList([]), listTy(elem), off) :: [], off), Str.concat("Result[String, ", Str.concat(listTy(elem), "]")), off)

def okCons(elem: String, xs: String, off: Int): Expr =
  okConsExpr(Expr.EVar(elem, off), xs, off)

def okConsExpr(elem: Expr, xs: String, off: Int): Expr =
  Expr.EMethod(Expr.EVar("Result", off), "Ok", call2("List.cons", elem, Expr.EVar(xs, off), off) :: [], off)

def errText(off: Int, message: String): Expr =
  Expr.EMethod(Expr.EVar("Result", off), "Err", Expr.EStr(message, off) :: [], off)

def errExpr(off: Int, message: Expr): Expr =
  Expr.EMethod(Expr.EVar("Result", off), "Err", message :: [], off)

def errMap(path: Expr, slot: String, off: Int): Expr =
  Expr.EMethod(Expr.EVar("Result", off), "Err", Expr.EIf(Expr.EBin("==", Expr.EVar(errName(off, slot), off), Expr.EStr("Json.field: missing field", off), off), missingExpr(path, off), wrongExpr(path, off), off) :: [], off)

def errPass(slot: String, off: Int): Expr =
  Expr.EMethod(Expr.EVar("Result", off), "Err", Expr.EVar(errName(off, slot), off) :: [], off)

def snoc(args: List[Expr], arg: Expr): List[Expr] =
  List.concat(args, arg :: [])

def call1(name: String, arg: Expr, off: Int): Expr =
  Expr.ECall(name, arg :: [], off)

def call2(name: String, left: Expr, right: Expr, off: Int): Expr =
  Expr.ECall(name, left :: right :: [], off)

def call3(name: String, a: Expr, b: Expr, c: Expr, off: Int): Expr =
  Expr.ECall(name, a :: b :: c :: [], off)

def okTag(tag: String, off: Int, slot: String): String =
  Str.concat("Result.Ok(Json.", Str.concat(tag, Str.concat("(", Str.concat(valName(off, slot), "))"))))

def jsonNullPat(): String =
  "Json.Null"

def jsonPat(tag: String, off: Int, slot: String): String =
  Str.concat("Json.", Str.concat(tag, Str.concat("(", Str.concat(valName(off, slot), ")"))))

def okBind(off: Int, slot: String): String =
  Str.concat("Result.Ok(", Str.concat(valName(off, slot), ")"))

def okRec(off: Int, slot: String): String =
  Str.concat("Result.Ok(", Str.concat(recName(off, slot), ")"))

def errPat(off: Int, slot: String): String =
  Str.concat("Result.Err(", Str.concat(errName(off, slot), ")"))

def pairPat(left: String, right: String): String =
  Str.concat("(", Str.concat(left, Str.concat(", ", Str.concat(right, ")"))))

def recvName(off: Int): String =
  Str.concat("__ScuzzJson", Str.fromInt(off))

def valName(off: Int, slot: String): String =
  Str.concat("__ScuzzV", Str.concat(Str.fromInt(off), Str.concat("_", slot)))

def errName(off: Int, slot: String): String =
  Str.concat("__ScuzzE", Str.concat(Str.fromInt(off), Str.concat("_", slot)))

def recName(off: Int, slot: String): String =
  Str.concat("__ScuzzR", Str.concat(Str.fromInt(off), Str.concat("_", slot)))

def accName(off: Int, slot: String): String =
  Str.concat("__ScuzzA", Str.concat(Str.fromInt(off), Str.concat("_", slot)))

def pairName(off: Int, slot: String): String =
  Str.concat("__ScuzzP", Str.concat(Str.fromInt(off), Str.concat("_", slot)))

def idxName(off: Int, slot: String): String =
  Str.concat("__ScuzzI", Str.concat(Str.fromInt(off), Str.concat("_", slot)))

def itemName(off: Int, slot: String): String =
  Str.concat("__ScuzzJ", Str.concat(Str.fromInt(off), Str.concat("_", slot)))

def joinSlot(slot: String, name: String): String =
  if (slot == "") name else Str.concat(slot, Str.concat("_", name))

def joinPath(prefix: String, name: String): String =
  if (prefix == "") name else Str.concat(prefix, Str.concat(".", name))

def strExpr(text: String, off: Int): Expr =
  Expr.EStr(text, off)

def pathText(path: Expr): String =
  path match {
    case Expr.EStr(text, _) => text
    case _ => ""
  }

def joinPathExpr(path: Expr, name: String, off: Int): Expr =
  path match {
    case Expr.EStr(text, _) => if (text == "") strExpr(name, off) else strExpr(Str.concat(text, Str.concat(".", name)), off)
    case _ => Expr.EIf(Expr.EBin("==", path, strExpr("", off), off), strExpr(name, off), call2("Str.concat", path, strExpr(Str.concat(".", name), off), off), off)
  }

def indexPath(path: Expr, idx: String, off: Int): Expr =
  call2("Str.concat", pathDot(path, off), call1("Str.fromInt", Expr.EVar(idx, off), off), off)

def pathDot(path: Expr, off: Int): Expr =
  path match {
    case Expr.EStr(text, _) => if (text == "") strExpr("", off) else strExpr(Str.concat(text, "."), off)
    case _ => Expr.EIf(Expr.EBin("==", path, strExpr("", off), off), strExpr("", off), call2("Str.concat", path, strExpr(".", off), off), off)
  }

def listTy(elem: Ty): String =
  Str.concat("List[", Str.concat(Type.show(elem), "]"))

def missingExpr(path: Expr, off: Int): Expr =
  path match {
    case Expr.EStr(text, _) => strExpr(missingMsg(text), off)
    case _ => call2("Str.concat", strExpr("Json.decode: missing field ", off), path, off)
  }

def wrongExpr(path: Expr, off: Int): Expr =
  path match {
    case Expr.EStr(text, _) => strExpr(wrongMsg(text), off)
    case _ => call2("Str.concat", strExpr("Json.decode: wrong case at ", off), path, off)
  }

def missingMsg(path: String): String =
  Str.concat("Json.decode: missing field ", path)

def wrongMsg(path: String): String =
  if (path == "") "Json.decode: wrong case" else Str.concat("Json.decode: wrong case at ", path)

def badRead(path: String): String =
  if (path == "") "Json.decode: cannot read record" else Str.concat("Json.decode: cannot read ", path)

def expandTy(ty: String, aliases: List[Alias]): String =
  if (ty == "" || List.isEmpty(aliases)) ty else Type.show(expandFuel(Type.parse(ty), aliases, 8))

def expandFuel(ty: Ty, aliases: List[Alias], fuel: Int): Ty =
  if (fuel <= 0) ty else expandApply(expandKids(ty, aliases, fuel), aliases, fuel)

def expandKids(ty: Ty, aliases: List[Alias], fuel: Int): Ty =
  ty match {
    case Ty.App(name, args) => Type.tApp(name, expandList(args, aliases, fuel))
    case Ty.Tuple(parts) => Type.tTuple(expandList(parts, aliases, fuel))
    case Ty.Arrow(arg, ret) => Type.tFun(expandFuel(arg, aliases, fuel), expandFuel(ret, aliases, fuel))
    case _ => ty
  }

def expandList(types: List[Ty], aliases: List[Alias], fuel: Int): List[Ty] =
  if (List.isEmpty(types)) types else expandFuel(List.at(types, 0), aliases, fuel) :: expandList(List.tail(types), aliases, fuel)

def expandApply(ty: Ty, aliases: List[Alias], fuel: Int): Ty =
  if (List.isEmpty(aliases)) ty else expandHit(ty, List.at(aliases, 0), List.tail(aliases), aliases, fuel)

def expandHit(ty: Ty, alias: Alias, rest: List[Alias], aliases: List[Alias], fuel: Int): Ty =
  if (aliasHits(ty, alias.name, alias.tparams)) expandFuel(aliasFill(ty, alias.tparams, alias.target), aliases, fuel - 1) else expandApply(ty, rest, fuel)

def aliasHits(ty: Ty, name: String, params: List[String]): Bool =
  ty match {
    case Ty.Named(n) => n == name && List.isEmpty(params)
    case Ty.TVar(n) => n == name && List.isEmpty(params)
    case Ty.App(n, _) => n == name && !List.isEmpty(params)
    case _ => false
  }

def aliasFill(ty: Ty, params: List[String], target: String): Ty =
  Type.parse(substAll(target, params, Type.appArgs(ty)))

def substAll(target: String, params: List[String], args: List[Ty]): String =
  if (List.isEmpty(params) || List.isEmpty(args)) target else substAll(Type.substStr(target, List.at(params, 0), Type.show(List.at(args, 0))), List.tail(params), List.tail(args))

def callDec(name: String, arg: Expr, path: Expr, off: Int): Expr =
  Expr.ECall(name, arg :: path :: [], off)

def recFun(name: String): String =
  Str.concat("__ScuzzDecR_", name)

def enumFun(name: String): String =
  Str.concat("__ScuzzDecE_", name)

def decParams(): List[Param] =
  Param("json", "Json", "", "") :: Param("path", "String", "", "") :: []

def recHelpers(names: List[String], dec: DecodeCtx): List[Fun] =
  if (List.isEmpty(names)) [] else recHelper(List.at(names, 0), dec) :: recHelpers(List.tail(names), dec)

def recHelper(name: String, dec: DecodeCtx): Fun =
  Fun(false, false, recFun(name), [], decParams(), resultOf(name), genRecord("json", name, Expr.EVar("path", 0), "", dec.copy(off = 0), 32), modOf(name, dec.enums), 0)

def enumHelpers(names: List[String], dec: DecodeCtx): List[Fun] =
  if (List.isEmpty(names)) [] else enumHelper(List.at(names, 0), dec) :: enumHelpers(List.tail(names), dec)

def enumHelper(name: String, dec: DecodeCtx): Fun =
  Fun(false, false, enumFun(name), [], decParams(), resultOf(name), payloadRead(name, "json", Expr.EVar("path", 0), "", dec.copy(off = 0), 32), modOf(name, dec.enums), 0)

def modOf(name: String, ens: List[En]): String =
  if (List.isEmpty(ens)) "" else if (List.at(ens, 0).name == name) List.at(ens, 0).mod else modOf(name, List.tail(ens))

def noStr(): List[String] =
  []

def noHelp(): (List[String], List[String]) =
  (noStr(), noStr())

def oneRec(name: String): (List[String], List[String]) =
  (name :: noStr(), noStr())

def oneEnum(name: String): (List[String], List[String]) =
  (noStr(), name :: noStr())

def helpRecs(help: (List[String], List[String])): List[String] =
  help match {
    case (recs, _) => recs
  }

def helpEns(help: (List[String], List[String])): List[String] =
  help match {
    case (_, ens) => ens
  }

def addName(xs: List[String], name: String): List[String] =
  if (name == "" || List.contains(xs, name)) xs else name :: xs

def addNames(xs: List[String], ys: List[String]): List[String] =
  if (List.isEmpty(ys)) xs else addNames(addName(xs, List.at(ys, 0)), List.tail(ys))

def mergeHelp(left: (List[String], List[String]), right: (List[String], List[String])): (List[String], List[String]) =
  (addNames(helpRecs(left), helpRecs(right)), addNames(helpEns(left), helpEns(right)))

def scanProg(p: Prog): (List[String], List[String]) =
  scanFuns(List.concat(p.defs, implMethods(p.impls)), p, scanExpr(p.body, "", p, noHelp()))

def implMethods(ims: List[Im]): List[Fun] =
  if (List.isEmpty(ims)) [] else List.concat(List.at(ims, 0).methods, implMethods(List.tail(ims)))

def scanFuns(fns: List[Fun], p: Prog, acc: (List[String], List[String])): (List[String], List[String]) =
  if (List.isEmpty(fns)) acc else scanFuns(List.tail(fns), p, scanExpr(List.at(fns, 0).body, List.at(fns, 0).ret, p, acc))

def scanExprs(xs: List[Expr], p: Prog, acc: (List[String], List[String])): (List[String], List[String]) =
  if (List.isEmpty(xs)) acc else scanExprs(List.tail(xs), p, scanExpr(List.at(xs, 0), "", p, acc))

def scanBinds(xs: List[Bind], p: Prog, acc: (List[String], List[String])): (List[String], List[String]) =
  if (List.isEmpty(xs)) acc else scanBinds(List.tail(xs), p, scanExpr(List.at(xs, 0).value, "", p, acc))

def scanArms(xs: List[Arm], expected: String, p: Prog, acc: (List[String], List[String])): (List[String], List[String]) =
  if (List.isEmpty(xs)) acc else scanArms(List.tail(xs), expected, p, scanExpr(List.at(xs, 0).body, expected, p, acc))

def scanExpr(e: Expr, expected: String, p: Prog, acc: (List[String], List[String])): (List[String], List[String]) =
  e match {
    case Expr.EMethod(recv, name, args, _) => scanDecode(isDecode(recv, name, args), expected, recv :: args, p, acc)
    case Expr.ECall(name, args, _) => scanDecode(name == "Json.decode" && List.len(args) == 1, expected, args, p, acc)
    case Expr.EAscribe(value, ann, _) => scanExpr(value, ann, p, acc)
    case Expr.EMatch(value, arms, _) => scanArms(arms, expected, p, scanExpr(value, "", p, acc))
    case Expr.EIf(cond, yes, no, _) => scanExpr(no, expected, p, scanExpr(yes, expected, p, scanExpr(cond, "", p, acc)))
    case Expr.EFor(binds, body, _) => scanExpr(body, forBody(expected, binds), p, scanBinds(binds, p, acc))
    case Expr.EPrint(value, _) => scanExpr(value, "", p, acc)
    case Expr.EBin(_, left, right, _) => scanExpr(right, "", p, scanExpr(left, "", p, acc))
    case Expr.EUn(_, value, _) => scanExpr(value, "", p, acc)
    case Expr.ELam(_, _, body) => scanExpr(body, "", p, acc)
    case Expr.EInterp(_, parts, _) => scanExprs(parts, p, acc)
    case Expr.EList(values) => scanExprs(values, p, acc)
    case Expr.ETuple(values) => scanExprs(values, p, acc)
    case Expr.ENamed(_, value) => scanExpr(value, "", p, acc)
    case Expr.EField(recv, _, _) => scanExpr(recv, "", p, acc)
    case _ => acc
  }

def scanDecode(hit: Bool, expected: String, args: List[Expr], p: Prog, acc: (List[String], List[String])): (List[String], List[String]) =
  scanExprs(args, p, if (hit) addReach(expected, p, acc) else acc)

def addReach(expected: String, p: Prog, acc: (List[String], List[String])): (List[String], List[String]) =
  addPayload(resultPayload(expected, p.aliases), p, acc)

def addPayload(payload: String, p: Prog, acc: (List[String], List[String])): (List[String], List[String]) =
  if (payload == "") acc else mergeHelp(acc, reachTy(payload, p.enums, p.aliases, 32, noStr()))

def reachTy(ty: String, ens: List[En], aliases: List[Alias], fuel: Int, seen: List[String]): (List[String], List[String]) =
  if (fuel <= 0) noHelp() else reachParsed(Type.parse(expandTy(ty, aliases)), ens, aliases, fuel, seen)

def reachParsed(ty: Ty, ens: List[En], aliases: List[Alias], fuel: Int, seen: List[String]): (List[String], List[String]) =
  ty match {
    case Ty.Named(name) => reachName(name, ens, aliases, fuel, seen)
    case Ty.App(name, args) => if ((name == "List" || name == "Option") && List.len(args) == 1) reachParsed(List.at(args, 0), ens, aliases, fuel - 1, seen) else if (name == "Map" && List.len(args) == 2 && isStringTy(List.at(args, 0))) reachParsed(List.at(args, 1), ens, aliases, fuel - 1, seen) else noHelp()
    case _ => noHelp()
  }

def reachName(name: String, ens: List[En], aliases: List[Alias], fuel: Int, seen: List[String]): (List[String], List[String]) =
  if (List.contains(seen, name)) noHelp() else if (isPlainRecord(name, ens)) reachRecord(name, ens, aliases, fuel, name :: seen) else if (isPayloadEnum(name, DecodeCtx(ens, aliases, 0, noStr(), noStr()))) reachEnum(name, ens, aliases, fuel, name :: seen) else noHelp()

def reachRecord(name: String, ens: List[En], aliases: List[Alias], fuel: Int, seen: List[String]): (List[String], List[String]) =
  mergeHelp(if (fieldsListName(recordFields(name, ens), name, aliases)) oneRec(name) else noHelp(), reachParams(recordFields(name, ens), ens, aliases, fuel, seen))

def reachEnum(name: String, ens: List[En], aliases: List[Alias], fuel: Int, seen: List[String]): (List[String], List[String]) =
  mergeHelp(if (casesListName(enumCasesOf(name, ens), name, aliases)) oneEnum(name) else noHelp(), reachCases(enumCasesOf(name, ens), ens, aliases, fuel, seen))

def reachParams(fs: List[Param], ens: List[En], aliases: List[Alias], fuel: Int, seen: List[String]): (List[String], List[String]) =
  if (List.isEmpty(fs)) noHelp() else mergeHelp(reachTy(List.at(fs, 0).ty, ens, aliases, fuel - 1, seen), reachParams(List.tail(fs), ens, aliases, fuel, seen))

def reachCases(cs: List[EnCase], ens: List[En], aliases: List[Alias], fuel: Int, seen: List[String]): (List[String], List[String]) =
  if (List.isEmpty(cs)) noHelp() else mergeHelp(reachCase(List.at(cs, 0), ens, aliases, fuel, seen), reachCases(List.tail(cs), ens, aliases, fuel, seen))

def reachCase(c: EnCase, ens: List[En], aliases: List[Alias], fuel: Int, seen: List[String]): (List[String], List[String]) =
  if (List.isEmpty(c.fields)) noHelp() else reachTy(List.at(c.fields, 0).ty, ens, aliases, fuel - 1, seen)

def fieldsListName(fs: List[Param], name: String, aliases: List[Alias]): Bool =
  if (List.isEmpty(fs)) false else typeListsName(expandTy(List.at(fs, 0).ty, aliases), name) || fieldsListName(List.tail(fs), name, aliases)

def casesListName(cs: List[EnCase], name: String, aliases: List[Alias]): Bool =
  if (List.isEmpty(cs)) false else caseListsName(List.at(cs, 0), name, aliases) || casesListName(List.tail(cs), name, aliases)

def caseListsName(c: EnCase, name: String, aliases: List[Alias]): Bool =
  if (List.isEmpty(c.fields)) false else typeListsName(expandTy(List.at(c.fields, 0).ty, aliases), name)

def typeListsName(ty: String, name: String): Bool =
  typeListsParsed(Type.parse(ty), name)

def typeListsParsed(ty: Ty, name: String): Bool =
  ty match {
    case Ty.App(app, args) => app == "List" && List.len(args) == 1 && (typeNamed(List.at(args, 0), name) || typeListsParsed(List.at(args, 0), name))
    case _ => false
  }

def typeNamed(ty: Ty, name: String): Bool =
  ty match {
    case Ty.Named(n) => n == name
    case _ => false
  }

