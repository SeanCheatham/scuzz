import Parse.Fun
import Parse.Param
import Parse.Prog
import Parse.Expr
import Parse.Arm
import Parse.Bind
import Parse.En
import Parse.EnCase
import Parse.pretty

def nl(): String =
  """
"""

def findIdx(s: String, needle: String, i: Int): Int =
  if (Str.len(needle) == 0 || i + Str.len(needle) > Str.len(s)) 0 - 1 else if (Str.slice(s, i, i + Str.len(needle)) == needle) i else findIdx(s, needle, i + 1)

def afterOp(w: String, op: String): String =
  afterOp2(w, findIdx(w, op, 0), op)

def afterOp2(w: String, i: Int, op: String): String =
  if (i < 0) "" else Str.slice(w, i + Str.len(op), Str.len(w))

def trimNum(s: String): String =
  trimNum2(s, 0)

def trimNum2(s: String, i: Int): String =
  if (i >= Str.len(s)) s else if (Str.charAt(s, i) == 32) trimNum2(s, i + 1) else Str.slice(s, i, Str.len(s))

def noStr(): List[String] =
  []

def noFun(): List[Fun] =
  []

def noEn(): List[En] =
  []

def kindTokE(p: Param, ens: List[En]): String =
  if (p.ty == "Int") intTok(p.w) else if (p.ty == "String") "s" else if (p.ty == "Bool") "b" else if (isListTy(p.ty)) listTok(p.ty, ens, 0) else adtTok(p.ty, ens, 0)

def isListTy(t: String): Bool =
  Str.len(t) > 6 && Str.slice(t, 0, 5) == "List[" && Str.charAt(t, Str.len(t) - 1) == 93

def listInner(t: String): String =
  Str.slice(t, 5, Str.len(t) - 1)

def listTok(t: String, ens: List[En], depth: Int): String =
  Str.concat("[", Str.concat(typeTok(listInner(t), ens, depth + 1), "]"))

def typeTok(t: String, ens: List[En], depth: Int): String =
  if (t == "Int") "i" else if (t == "String") "s" else if (t == "Bool") "b" else if (isListTy(t)) listTok(t, ens, depth) else adtTok(t, ens, depth)

def adtTok(ty: String, ens: List[En], depth: Int): String =
  adtTokHit(findEn(ens, tyHead(ty)), ty, ens, depth)

def tyHead(t: String): String =
  tyHeadAt(t, 0)

def tyHeadAt(t: String, i: Int): String =
  if (i >= Str.len(t)) t else if (Str.charAt(t, i) == 91) Str.slice(t, 0, i) else tyHeadAt(t, i + 1)

def findEn(ens: List[En], name: String): List[En] =
  if (List.isEmpty(ens)) noEn() else findEn1(List.at(ens, 0), List.tail(ens), name)

def findEn1(h: En, rest: List[En], name: String): List[En] =
  h match {
    case En(_, n, _, _) => if (n == name) h :: noEn() else findEn(rest, name)
  }

def adtTokHit(hit: List[En], ty: String, ens: List[En], depth: Int): String =
  if (List.isEmpty(hit)) ty else adtTokEn(List.at(hit, 0), ens, depth)

def adtTokEn(e: En, ens: List[En], depth: Int): String =
  e match {
    case En(isRec, name, _, cases) => if (isRec || recLike(name, cases)) recTok(name, cases, ens, depth) else enumTok(cases, ens, depth)
  }

def recLike(name: String, cs: List[EnCase]): Bool =
  List.len(cs) == 1 && recLikeName(List.at(cs, 0), name)

def recLikeName(c: EnCase, name: String): Bool =
  c match {
    case EnCase(n, _) => n == name
  }

def recTok(name: String, cs: List[EnCase], ens: List[En], depth: Int): String =
  Str.concat(name, Str.concat("(", Str.concat(caseFields(List.at(cs, 0), ens, depth), ")")))

def caseFields(c: EnCase, ens: List[En], depth: Int): String =
  c match {
    case EnCase(_, fs) => fieldToks(fs, ens, depth)
  }

def fieldToks(fs: List[Param], ens: List[En], depth: Int): String =
  if (List.isEmpty(fs)) "" else if (List.len(fs) == 1) fieldTok(List.at(fs, 0), ens, depth) else Str.concat(fieldTok(List.at(fs, 0), ens, depth), Str.concat(",", fieldToks(List.tail(fs), ens, depth)))

def fieldTok(p: Param, ens: List[En], depth: Int): String =
  if (p.ty == "Int") intTok(p.w) else typeTok(p.ty, ens, depth + 1)

def enumTok(cs: List[EnCase], ens: List[En], depth: Int): String =
  Str.concat("e:", enumCases(if (depth >= 3) leafCases(cs) else cs, ens, depth))

def leafCases(cs: List[EnCase]): List[EnCase] =
  if (List.isEmpty(cs)) noCase() else leafCases1(List.at(cs, 0), List.tail(cs))

def leafCases1(c: EnCase, rest: List[EnCase]): List[EnCase] =
  if (isLeafCase(c)) c :: leafCases(rest) else leafCases(rest)

def isLeafCase(c: EnCase): Bool =
  c match {
    case EnCase(_, fs) => allLeaf(fs)
  }

def allLeaf(fs: List[Param]): Bool =
  if (List.isEmpty(fs)) true else allLeafGo(List.at(fs, 0), List.tail(fs))

def allLeafGo(h: Param, rest: List[Param]): Bool =
  h match {
    case Param(_, ty, _, _) => leafTy(ty) && allLeaf(rest)
  }

def leafTy(t: String): Bool =
  t == "Int" || t == "String" || t == "Bool"

def enumCases(cs: List[EnCase], ens: List[En], depth: Int): String =
  if (List.isEmpty(cs)) "" else if (List.len(cs) == 1) caseTok(List.at(cs, 0), ens, depth) else Str.concat(caseTok(List.at(cs, 0), ens, depth), Str.concat("|", enumCases(List.tail(cs), ens, depth)))

def caseTok(c: EnCase, ens: List[En], depth: Int): String =
  c match {
    case EnCase(name, fs) => if (List.isEmpty(fs)) name else Str.concat(name, Str.concat("(", Str.concat(fieldToks(fs, ens, depth), ")")))
  }

def noCase(): List[EnCase] =
  []

def intTok(w: String): String =
  if (w == "") "i" else if (findIdx(w, ">=", 0) >= 0) Str.concat("i>=", trimNum(afterOp(w, ">="))) else if (findIdx(w, "<=", 0) >= 0) Str.concat("i<=", trimNum(afterOp(w, "<="))) else if (findIdx(w, ">", 0) >= 0) Str.concat("i>", trimNum(afterOp(w, ">"))) else if (findIdx(w, "<", 0) >= 0) Str.concat("i<", trimNum(afterOp(w, "<"))) else "i"

def friendly(p: Param, ens: List[En]): Bool =
  friendlyTy(p.ty, ens)

def friendlyTy(t: String, ens: List[En]): Bool =
  if (t == "Int" || t == "String" || t == "Bool") true else if (isListTy(t)) friendlyTy(listInner(t), ens) else if (opaqueTy(tyHead(t))) false else if (t == "" || t == "Unit" || t == "Any" || t == "Float" || t == "Timeline" || t == "Verdict") false else if (Str.startsWith(t, "IO")) false else if (hasSub(t, "=>")) false else !List.isEmpty(findEn(ens, tyHead(t)))

def opaqueTy(t: String): Bool =
  t == "Fiber" || t == "Ref" || t == "Queue" || t == "Deferred" || t == "Resource" || t == "Stream" || t == "Map" || t == "Set"

def hasSub(s: String, n: String): Bool =
  findIdx(s, n, 0) >= 0

def allFriendly(ps: List[Param], ens: List[En]): Bool =
  List.isEmpty(ps) || friendly(List.at(ps, 0), ens) && allFriendly(List.tail(ps), ens)

def isAdtOrList(p: Param): Bool =
  isListTy(p.ty) || !(p.ty == "Int" || p.ty == "String" || p.ty == "Bool")

def hasAdtOrList(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) false else isAdtOrList(List.at(ps, 0)) || hasAdtOrList(List.tail(ps))

def unaryAdtOk(ps: List[Param]): Bool =
  List.len(ps) <= 1 || !hasAdtOrList(ps)

def simpleWhere(w: String): Bool =
  w == "" || !hasSub(w, "&&") && !hasSub(w, "||")

def allSimpleWhere(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) true else allSimpleWhere1(List.at(ps, 0), List.tail(ps))

def allSimpleWhere1(p: Param, rest: List[Param]): Bool =
  p match {
    case Param(_, _, w, _) => simpleWhere(w) && allSimpleWhere(rest)
  }

def isDrive(d: Fun, ens: List[En]): Bool =
  !d.priv && d.ret == "Bool" && List.len(d.params) <= 3 && allFriendly(d.params, ens) && unaryAdtOk(d.params) && allSimpleWhere(d.params)

def isClaim(d: Fun): Bool =
  !d.priv && d.ret == "Verdict" && claimPs(d.params)

def claimPs(ps: List[Param]): Bool =
  (List.len(ps) == 1 || List.len(ps) == 2) && allTimeline(ps)

def allTimeline(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) true else allTimeline1(List.at(ps, 0), List.tail(ps))

def allTimeline1(p: Param, rest: List[Param]): Bool =
  p match {
    case Param(_, ty, _, _) => ty == "Timeline" && allTimeline(rest)
  }

def drives(ds: List[Fun], ens: List[En]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else drives1(List.at(ds, 0), List.tail(ds), ens)

def drives1(d: Fun, rest: List[Fun], ens: List[En]): List[Fun] =
  if (isDrive(d, ens)) d :: drives(rest, ens) else drives(rest, ens)

def specOfE(d: Fun, ens: List[En]): String =
  if (List.isEmpty(d.params)) d.name else Str.concat(d.name, Str.concat(" ", specs(d.params, ens)))

def specs(ps: List[Param], ens: List[En]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) kindTokE(List.at(ps, 0), ens) else Str.concat(kindTokE(List.at(ps, 0), ens), Str.concat(" ", specs(List.tail(ps), ens)))

def cmpStr(a: String, b: String): Int =
  cmpStr2(a, b, 0)

def cmpStr2(a: String, b: String, i: Int): Int =
  if (i >= Str.len(a) && i >= Str.len(b)) 0 else if (i >= Str.len(a)) 0 - 1 else if (i >= Str.len(b)) 1 else if (Str.charAt(a, i) < Str.charAt(b, i)) 0 - 1 else if (Str.charAt(a, i) > Str.charAt(b, i)) 1 else cmpStr2(a, b, i + 1)

def ins(x: String, ys: List[String]): List[String] =
  if (List.isEmpty(ys)) x :: noStr() else if (cmpStr(x, List.at(ys, 0)) <= 0) x :: ys else List.at(ys, 0) :: ins(x, List.tail(ys))

def sortStrs(xs: List[String]): List[String] =
  if (List.isEmpty(xs)) xs else ins(List.at(xs, 0), sortStrs(List.tail(xs)))

def nls(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else Str.concat(List.at(xs, 0), Str.concat(nl(), nls(List.tail(xs))))

def linesOf(s: String): List[String] =
  linesFrom(s, 0)

def linesFrom(s: String, start: Int): List[String] =
  if (start >= Str.len(s)) noStr() else linesFrom2(s, start, nextNl(s, start))

def nextNl(s: String, i: Int): Int =
  if (i >= Str.len(s)) i else if (Str.charAt(s, i) == 10) i else nextNl(s, i + 1)

def linesFrom2(s: String, start: Int, nl: Int): List[String] =
  if (nl >= Str.len(s)) lineRest(s, start, nl) else Str.slice(s, start, nl) :: linesFrom(s, nl + 1)

def lineRest(s: String, start: Int, i: Int): List[String] =
  if (start >= i) noStr() else Str.slice(s, start, i) :: noStr()

def eventsKey(): String =
  "events = ["

def parseEvents(src: String): List[String] =
  parseEventsAt(src, findIdx(src, eventsKey(), 0))

def parseEventsAt(src: String, i: Int): List[String] =
  if (i < 0) noStr() else parseEvSkip(src, i + Str.len(eventsKey()))

def parseEvSkip(src: String, i: Int): List[String] =
  if (i >= Str.len(src)) noStr() else parseEvCh(src, i, Str.charAt(src, i))

def parseEvCh(src: String, i: Int, c: Int): List[String] =
  if (c == 32 || c == 10 || c == 13 || c == 9 || c == 44) parseEvSkip(src, i + 1) else if (c == 93) noStr() else if (c == 34) parseEvStr(src, i + 1, "") else parseEvSkip(src, i + 1)

def parseEvStr(src: String, i: Int, acc: String): List[String] =
  if (i >= Str.len(src)) noStr() else parseEvStrCh(src, i, Str.charAt(src, i), acc)

def parseEvStrCh(src: String, i: Int, c: Int, acc: String): List[String] =
  if (c == 92) parseEvEsc(src, i + 1, acc) else if (c == 34) acc :: parseEvSkip(src, i + 1) else parseEvStr(src, i + 1, Str.concat(acc, Str.slice(src, i, i + 1)))

def parseEvEsc(src: String, i: Int, acc: String): List[String] =
  if (i >= Str.len(src)) acc :: noStr() else parseEvStr(src, i + 1, Str.concat(acc, Str.slice(src, i, i + 1)))

def tomlQuoted(src: String, key: String): String =
  tomlQuotedAt(src, findIdx(src, Str.concat(key, " = \""), 0), Str.len(key) + 4)

def tomlQuotedAt(src: String, i: Int, skip: Int): String =
  if (i < 0) "" else tomlQuotedEnd(src, i + skip, i + skip)

def tomlQuotedEnd(src: String, start: Int, i: Int): String =
  if (i >= Str.len(src) || Str.charAt(src, i) == 34) Str.slice(src, start, i) else tomlQuotedEnd(src, start, i + 1)

def quoteEvents(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else if (List.isEmpty(List.tail(xs))) quoteEv(List.at(xs, 0)) else Str.concat(quoteEv(List.at(xs, 0)), Str.concat(", ", quoteEvents(List.tail(xs))))

def quoteEv(e: String): String =
  Str.concat("\"", Str.concat(escEv(e, 0, Builder.empty()), "\""))

def escEv(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else escEv(s, i + 1, Builder.append(b, escEvCh(Str.charAt(s, i), s, i)))

def escEvCh(c: Int, s: String, i: Int): String =
  if (c == 92) "\\\\" else if (c == 34) "\\\"" else Str.slice(s, i, i + 1)

def reproText(seed: Int, sched: String, fault: String, events: List[String]): String =
  Str.concat("""[fuzz]
seed = """, Str.concat(Str.fromInt(seed), Str.concat(reproSched(sched), Str.concat(reproFault(fault), Str.concat("events = [", Str.concat(quoteEvents(events), """]
"""))))))

def reproSched(sched: String): String =
  if (sched == "") nl() else Str.concat("\nschedule_seed = \"", Str.concat(sched, Str.concat("\"\n", pctLines(sched))))

def pctLines(sched: String): String =
  Str.concat("pct_d = ", Str.concat(Str.fromInt(decodeD(parseSeed(sched))), Str.concat("""
pct_k = """, Str.concat(Str.fromInt(decodeK(parseSeed(sched))), """
"""))))

def reproFault(fault: String): String =
  if (fault == "") "" else Str.concat("fault_seed = \"", Str.concat(fault, "\"\n"))

def summaryToml(ok: Bool, seed: Int, iterations: Int, search: Int, failures: Int, corpus: Int, corpFail: Int, promo: String, repro: String, killed: Int, survived: Int, inert: Int, ran: Int, sites: Int, oracles: Bool, classText: String): String =
  Str.concat(summaryFuzz(ok, seed, iterations, search, failures, corpus, repro), summaryRest(corpus, corpFail, promo, killed, survived, inert, ran, sites, oracles, classText))

def kv(k: String, v: String): String =
  Str.concat(k, Str.concat(" = ", v))

def kvn(k: String, v: String): String =
  Str.concat(kv(k, v), nl())

def quote1(s: String): String =
  Str.concat("\"", Str.concat(s, "\""))

def summaryFuzz(ok: Bool, seed: Int, iterations: Int, search: Int, failures: Int, corpus: Int, repro: String): String =
  Str.concat("""[fuzz]
""", Str.concat(kvn("ok", if (ok) "true" else "false"), summaryFuzzNums(seed, iterations, search, failures, corpus, repro)))

def summaryFuzzNums(seed: Int, iterations: Int, search: Int, failures: Int, corpus: Int, repro: String): String =
  Str.concat(kvn("seed", Str.fromInt(seed)), Str.concat(kvn("iterations", Str.fromInt(iterations)), Str.concat(kvn("search", Str.fromInt(search)), Str.concat(kvn("search_failures", Str.fromInt(failures)), Str.concat(kvn("corpus", Str.fromInt(corpus)), summaryRepro(repro))))))

def summaryRepro(repro: String): String =
  if (repro == "") "" else kvn("repro", quote1(repro))

def summaryRest(corpus: Int, corpFail: Int, promo: String, killed: Int, survived: Int, inert: Int, ran: Int, sites: Int, oracles: Bool, classText: String): String =
  Str.concat(summaryCorpus(corpus, corpFail, promo), Str.concat(summaryClass(classText), summaryMut(killed, survived, inert, ran, sites, oracles)))

def summaryCorpus(corpus: Int, corpFail: Int, promo: String): String =
  Str.concat("""
[corpus]
""", Str.concat(kvn("entries", Str.fromInt(corpus)), Str.concat(kvn("failures", Str.fromInt(corpFail)), kvn("promoted", promo))))

def summaryClass(classText: String): String =
  if (classText == "") "" else Str.concat("""
[classify]
""", classText)

def summaryMut(killed: Int, survived: Int, inert: Int, ran: Int, sites: Int, oracles: Bool): String =
  Str.concat("""
[mutate]
""", Str.concat(kvn("killed", Str.fromInt(killed)), Str.concat(kvn("survived", Str.fromInt(survived)), Str.concat(kvn("inert", Str.fromInt(inert)), Str.concat(kvn("ran", Str.fromInt(ran)), Str.concat(kvn("sites", Str.fromInt(sites)), Str.concat(kvn("oracles", if (oracles) "true" else "false"), summaryScore(killed, sites))))))))

def summaryScore(killed: Int, sites: Int): String =
  if (sites <= 0) "" else kvn("score", score3(killed, sites))

def score3(killed: Int, sites: Int): String =
  score3n(killed * 1000 / sites)

def score3n(n: Int): String =
  Str.concat(Str.fromInt(n / 1000), Str.concat(".", pad3(n % 1000)))

def pad3(n: Int): String =
  if (n < 10) Str.concat("00", Str.fromInt(n)) else if (n < 100) Str.concat("0", Str.fromInt(n)) else Str.fromInt(n)

def classToml(text: String): String =
  classLines(linesOf(text))

def classLines(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else Str.concat(classRow(List.at(xs, 0)), classLines(List.tail(xs)))

def classRow(line: String): String =
  classRow2(className(line), classNums(line))

def className(line: String): String =
  classTok(line, 0)

def classNums(line: String): String =
  Str.slice(line, nextSp(line, 0) + 1, Str.len(line))

def classTok(line: String, i: Int): String =
  if (i >= Str.len(line) || Str.charAt(line, i) == 32) Str.slice(line, 0, i) else classTok(line, i + 1)

def nextSp(line: String, i: Int): Int =
  if (i >= Str.len(line)) i else if (Str.charAt(line, i) == 32) i else nextSp(line, i + 1)

def classRow2(name: String, rest: String): String =
  if (name == "") "" else Str.concat(name, Str.concat("_true = ", Str.concat(classYes(rest), Str.concat("""
""", Str.concat(name, Str.concat("_false = ", Str.concat(classNo(rest), """
""")))))))

def classYes(rest: String): String =
  classTok(rest, 0)

def classNo(rest: String): String =
  classTok(classNums(rest), 0)

def mapSeed(ds: List[Fun]): List[String] =
  mapSeedE(ds, noEn())

def mapSeedE(ds: List[Fun], ens: List[En]): List[String] =
  if (List.isEmpty(ds)) noStr() else seedOfE(List.at(ds, 0), ens) :: mapSeedE(List.tail(ds), ens)

def seedOfE(d: Fun, ens: List[En]): String =
  if (List.isEmpty(d.params)) Str.concat("drive ", d.name) else Str.concat("drive ", Str.concat(d.name, Str.concat(" ", seedArgsE(d.params, ens))))

def seedArgsE(ps: List[Param], ens: List[En]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) seedArgE(List.at(ps, 0), ens) else Str.concat(seedArgE(List.at(ps, 0), ens), Str.concat(" ", seedArgsE(List.tail(ps), ens)))

def seedArgE(p: Param, ens: List[En]): String =
  if (p.ty == "Int") "0" else if (p.ty == "Bool") "false" else if (p.ty == "String") "a" else if (isListTy(p.ty)) "[]" else seedAdt(p.ty, ens)

def seedAdt(ty: String, ens: List[En]): String =
  seedHit(findEn(ens, tyHead(ty)), ty, ens)

def seedHit(hit: List[En], ty: String, ens: List[En]): String =
  if (List.isEmpty(hit)) "0" else seedEn(List.at(hit, 0), ens)

def seedEn(e: En, ens: List[En]): String =
  e match {
    case En(isRec, name, _, cases) => if (isRec || recLike(name, cases)) seedRec(name, cases, ens) else seedEnum(cases, ens)
  }

def seedRec(name: String, cs: List[EnCase], ens: List[En]): String =
  if (List.isEmpty(cs)) name else seedCase(List.at(cs, 0), ens)

def seedEnum(cs: List[EnCase], ens: List[En]): String =
  seedEnumHit(leafCases(cs), cs, ens)

def seedEnumHit(leaf: List[EnCase], all: List[EnCase], ens: List[En]): String =
  if (List.isEmpty(leaf)) seedCase(List.at(all, 0), ens) else seedCase(List.at(leaf, 0), ens)

def seedCase(c: EnCase, ens: List[En]): String =
  c match {
    case EnCase(name, fs) => seedCtor(name, fs, ens)
  }

def seedCtor(name: String, fs: List[Param], ens: List[En]): String =
  if (List.isEmpty(fs)) name else Str.concat(name, Str.concat("(", Str.concat(seedFields(fs, ens), ")")))

def seedFields(fs: List[Param], ens: List[En]): String =
  if (List.isEmpty(fs)) "" else if (List.len(fs) == 1) seedArgE(List.at(fs, 0), ens) else Str.concat(seedArgE(List.at(fs, 0), ens), Str.concat(",", seedFields(List.tail(fs), ens)))

def mapSpec(ds: List[Fun]): List[String] =
  mapSpecE(ds, noEn())

def mapSpecE(ds: List[Fun], ens: List[En]): List[String] =
  if (List.isEmpty(ds)) noStr() else specOfE(List.at(ds, 0), ens) :: mapSpecE(List.tail(ds), ens)

def parseVerify(src: String): List[Fun] =
  parseVerifyEns(src, noEn())

def parseVerifyEns(src: String, ens: List[En]): List[Fun] =
  parseVerifyProg(Parse.parse(Lexer.lex(src)), ens)

def parseVerifyProg(p: Prog, ens: List[En]): List[Fun] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => drives(defs, ens)
  }

def parseClaims(src: String): List[Fun] =
  parseClaimsProg(Parse.parse(Lexer.lex(src)))

def parseClaimsProg(p: Prog): List[Fun] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => claims(defs)
  }

def claims(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else claims1(List.at(ds, 0), List.tail(ds))

def claims1(d: Fun, rest: List[Fun]): List[Fun] =
  if (isClaim(d)) d :: claims(rest) else claims(rest)

def wrapMod(): String =
  "__verify"

def wrapSrc(stem: String, src: String): String =
  wrapSrcEns(stem, src, noEn())

def wrapSrcEns(stem: String, src: String, ens: List[En]): String =
  Str.concat(wrapFuns(stem, parseVerifyEns(src, ens)), wrapRelFuns(parseClaims(src)))

def wrapFuns(stem: String, ds: List[Fun]): String =
  if (List.isEmpty(ds)) "" else Str.concat(wrapFun(stem, List.at(ds, 0)), wrapFuns(stem, List.tail(ds)))

def wrapFun(_stem: String, d: Fun): String =
  d match {
    case Fun(_, name, _, ps, _, body, _, _) => wrapFun2(name, wrapPs(ps), Parse.pretty0(body))
  }

def wrapFun2(name: String, ps: String, body: String): String =
  Str.concat("def _drv_", Str.concat(name, Str.concat("(", Str.concat(ps, Str.concat("): IO[Unit] =\n  Property.assert(\"", Str.concat(name, Str.concat("\", ", Str.concat(body, """)
"""))))))))

def wrapPs(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) wrapP(List.at(ps, 0)) else Str.concat(wrapP(List.at(ps, 0)), Str.concat(", ", wrapPs(List.tail(ps))))

def wrapP(p: Param): String =
  p match {
    case Param(n, ty, _, _) => Str.concat(n, Str.concat(": ", ty))
  }

def wrapRelFuns(ds: List[Fun]): String =
  if (List.isEmpty(ds)) "" else Str.concat(wrapRel(List.at(ds, 0)), wrapRelFuns(List.tail(ds)))

def wrapRel(d: Fun): String =
  d match {
    case Fun(_, name, _, ps, _, body, _, _) => wrapRel2(name, wrapPs(ps), Parse.pretty0(body))
  }

def wrapRel2(name: String, ps: String, body: String): String =
  Str.concat("def ", Str.concat(name, Str.concat("(", Str.concat(ps, Str.concat("""): Verdict =
  """, Str.concat(body, """

"""))))))

def wrapFiles(files: List[(String, String)]): String =
  wrapFilesEns(files, noEn())

def wrapFilesEns(files: List[(String, String)], ens: List[En]): String =
  if (List.isEmpty(files)) "" else wrapFilesEns2(List.at(files, 0), List.tail(files), ens)

def wrapFilesEns2(h: (String, String), rest: List[(String, String)], ens: List[En]): String =
  h match {
    case (stem, src) => Str.concat(wrapSrcEns(stem, src, ens), wrapFilesEns(rest, ens))
  }

def applySim(live: String, sim: String): String =
  applySimProg(Parse.parse(Lexer.lex(live)), Parse.parse(Lexer.lex(sim)))

def applySimProg(live: Prog, sim: Prog): String =
  sim match {
    case Prog(_, _, _, _, _, _, sdefs, _, _) => applySimLive(live, sdefs)
  }

def applySimLive(live: Prog, sdefs: List[Fun]): String =
  live match {
    case Prog(pkg, enums, aliases, traits, impls, imps, defs, main, body) => Parse.pretty(Prog(pkg, enums, aliases, traits, impls, imps, swapDefs(defs, sdefs), main, body))
  }

def swapDefs(ds: List[Fun], sim: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) ds else pickSim(List.at(ds, 0), sim) :: swapDefs(List.tail(ds), sim)

def pickSim(d: Fun, sim: List[Fun]): Fun =
  if (List.isEmpty(sim)) d else pickSim1(d, List.at(sim, 0), List.tail(sim))

def pickSim1(d: Fun, s: Fun, rest: List[Fun]): Fun =
  if (d.name == s.name) s else pickSim(d, rest)

def noExpr(): List[Expr] =
  []

def rewriteReqSrc(src: String): String =
  rewriteReqKeep(src, Parse.parse(Lexer.lex(src)))

def rewriteReqKeep(src: String, p: Prog): String =
  if (progHasReq(p)) rewriteReqProg(p) else src

def progHasReq(p: Prog): Bool =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, body) => exprHasReq(body) || defsHaveReq(defs)
  }

def defsHaveReq(ds: List[Fun]): Bool =
  if (List.isEmpty(ds)) false else funHasReq(List.at(ds, 0)) || defsHaveReq(List.tail(ds))

def funHasReq(d: Fun): Bool =
  d match {
    case Fun(_, _, _, _, _, body, _, _) => exprHasReq(body)
  }

def exprHasReq(e: Expr): Bool =
  e match {
    case Expr.EPrint(inner, _) => exprHasReq(inner)
    case Expr.ECall(_, args, _) => listHasReq(args)
    case Expr.EMethod(recv, name, args, _) => name == "require" || exprHasReq(recv) || listHasReq(args)
    case Expr.EField(recv, _, _) => exprHasReq(recv)
    case Expr.EBin(_, l, r, _) => exprHasReq(l) || exprHasReq(r)
    case Expr.EUn(_, inner, _) => exprHasReq(inner)
    case Expr.ELam(_, _, body) => exprHasReq(body)
    case Expr.EIf(c, t, el, _) => exprHasReq(c) || exprHasReq(t) || exprHasReq(el)
    case Expr.EMatch(s, arms, _) => exprHasReq(s) || armsHaveReq(arms)
    case Expr.EList(xs) => listHasReq(xs)
    case Expr.ETuple(xs) => listHasReq(xs)
    case Expr.ENamed(_, inner) => exprHasReq(inner)
    case Expr.EAscribe(inner, _, _) => exprHasReq(inner)
    case Expr.EFor(bs, body, _) => bindsHaveReq(bs) || exprHasReq(body)
    case _ => false
  }

def listHasReq(xs: List[Expr]): Bool =
  if (List.isEmpty(xs)) false else exprHasReq(List.at(xs, 0)) || listHasReq(List.tail(xs))

def armsHaveReq(xs: List[Arm]): Bool =
  if (List.isEmpty(xs)) false else armHasReq(List.at(xs, 0)) || armsHaveReq(List.tail(xs))

def armHasReq(a: Arm): Bool =
  a match {
    case Arm(_, _, body) => exprHasReq(body)
  }

def bindsHaveReq(xs: List[Bind]): Bool =
  if (List.isEmpty(xs)) false else bindHasReq(List.at(xs, 0)) || bindsHaveReq(List.tail(xs))

def bindHasReq(b: Bind): Bool =
  b match {
    case Bind(_, _, e) => exprHasReq(e)
  }

def rewriteReqProg(p: Prog): String =
  p match {
    case Prog(pkg, enums, aliases, traits, impls, imps, defs, main, body) => Parse.pretty(Prog(pkg, enums, aliases, traits, impls, imps, rewriteReqDefs(defs), main, rewriteReq(body)))
  }

def rewriteReqDefs(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) ds else rewriteReqFun(List.at(ds, 0)) :: rewriteReqDefs(List.tail(ds))

def rewriteReqFun(d: Fun): Fun =
  d match {
    case Fun(priv, name, tparams, params, ret, body, mod, off) => Fun(priv, name, tparams, params, ret, rewriteReq(body), mod, off)
  }

def rewriteReq(e: Expr): Expr =
  e match {
    case Expr.EPrint(inner, off) => Expr.EPrint(rewriteReq(inner), off)
    case Expr.ECall(f, args, off) => Expr.ECall(f, rewriteReqList(args), off)
    case Expr.EMethod(recv, name, args, off) => rewriteReqMeth(rewriteReq(recv), name, rewriteReqList(args), off)
    case Expr.EField(recv, name, off) => Expr.EField(rewriteReq(recv), name, off)
    case Expr.EBin(op, l, r, off) => Expr.EBin(op, rewriteReq(l), rewriteReq(r), off)
    case Expr.EUn(op, inner, off) => Expr.EUn(op, rewriteReq(inner), off)
    case Expr.ELam(p, ty, body) => Expr.ELam(p, ty, rewriteReq(body))
    case Expr.EIf(c, t, el, off) => Expr.EIf(rewriteReq(c), rewriteReq(t), rewriteReq(el), off)
    case Expr.EMatch(s, arms, off) => Expr.EMatch(rewriteReq(s), rewriteReqArms(arms), off)
    case Expr.EList(xs) => Expr.EList(rewriteReqList(xs))
    case Expr.ETuple(xs) => Expr.ETuple(rewriteReqList(xs))
    case Expr.ENamed(n, inner) => Expr.ENamed(n, rewriteReq(inner))
    case Expr.EAscribe(inner, ty, off) => Expr.EAscribe(rewriteReq(inner), ty, off)
    case Expr.EFor(bs, body, off) => Expr.EFor(rewriteReqBinds(bs), rewriteReq(body), off)
    case _ => e
  }

def rewriteReqMeth(recv: Expr, name: String, args: List[Expr], off: Int): Expr =
  if (name == "require") Expr.ECall("Property.check", reqNameE(args) :: reqPredE(args) :: recv :: noExpr(), off) else Expr.EMethod(recv, name, args, off)

def reqNameE(args: List[Expr]): Expr =
  if (List.len(args) < 2) Expr.EStr("require", 0) else reqNameHit(List.at(args, 0))

def reqNameHit(e: Expr): Expr =
  e match {
    case Expr.EStr(s, _) => Expr.EStr(s, 0)
    case _ => Expr.EStr("require", 0)
  }

def reqPredE(args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EBool(true) else if (List.len(args) == 1) forcePred(List.at(args, 0)) else forcePred(List.at(List.tail(args), 0))

def forcePred(e: Expr): Expr =
  if (isIoPred(e)) Expr.ECall("Property.force", e :: noExpr(), 0) else e

def isIoPred(e: Expr): Bool =
  e match {
    case Expr.EFor(bs, body, _) => hasDraw(bs) || isIoPred(body)
    case Expr.ECall(f, _, _) => ioCall(f)
    case Expr.EMethod(_, name, _, _) => name == "flatMap" || name == "map" || name == "handleErrorWith"
    case Expr.EIf(_, t, el, _) => isIoPred(t) || isIoPred(el)
    case _ => false
  }

def ioCall(f: String): Bool =
  Str.startsWith(f, "IO.") || Str.startsWith(f, "Fs.") || Str.startsWith(f, "Net.") || Str.startsWith(f, "Sys.") || Str.startsWith(f, "Clock.") || Str.startsWith(f, "Random.")

def hasDraw(bs: List[Bind]): Bool =
  if (List.isEmpty(bs)) false else bindIsDraw(List.at(bs, 0)) || hasDraw(List.tail(bs))

def bindIsDraw(b: Bind): Bool =
  b match {
    case Bind(draw, _, _) => draw
  }

def rewriteReqList(xs: List[Expr]): List[Expr] =
  if (List.isEmpty(xs)) xs else rewriteReq(List.at(xs, 0)) :: rewriteReqList(List.tail(xs))

def rewriteReqArms(xs: List[Arm]): List[Arm] =
  if (List.isEmpty(xs)) xs else rewriteReqArm(List.at(xs, 0)) :: rewriteReqArms(List.tail(xs))

def rewriteReqArm(a: Arm): Arm =
  a match {
    case Arm(pat, g, body) => Arm(pat, g, rewriteReq(body))
  }

def rewriteReqBinds(xs: List[Bind]): List[Bind] =
  if (List.isEmpty(xs)) xs else rewriteReqBind(List.at(xs, 0)) :: rewriteReqBinds(List.tail(xs))

def rewriteReqBind(b: Bind): Bind =
  b match {
    case Bind(draw, name, value) => Bind(draw, name, rewriteReq(value))
  }

def rewriteReqFiles(files: List[(String, String)]): List[(String, String)] =
  if (List.isEmpty(files)) files else rewriteReqHd(List.at(files, 0), List.tail(files))

def rewriteReqHd(h: (String, String), rest: List[(String, String)]): List[(String, String)] =
  h match {
    case (stem, src) => (stem, rewriteReqSrc(src)) :: rewriteReqFiles(rest)
  }

def seeds(src: String): String =
  nls(sortStrs(mapSeed(parseVerify(src))))

def drivers(src: String): String =
  nls(mapSpec(parseVerify(src)))

def driversFrom(srcs: List[String], ens: List[En]): String =
  nls(mapSpecE(parseVerifyAllEns(srcs, ens), ens))

def parseVerifyAll(srcs: List[String]): List[Fun] =
  parseVerifyAllEns(srcs, noEn())

def parseVerifyAllEns(srcs: List[String], ens: List[En]): List[Fun] =
  if (List.isEmpty(srcs)) noFun() else List.concat(parseVerifyEns(List.at(srcs, 0), ens), parseVerifyAllEns(List.tail(srcs), ens))

def ensOfFiles(files: List[(String, String)]): List[En] =
  if (List.isEmpty(files)) noEn() else List.concat(ensOfFile(List.at(files, 0)), ensOfFiles(List.tail(files)))

def ensOfFile(h: (String, String)): List[En] =
  h match {
    case (_, src) => ensOfProg(Parse.parse(Lexer.lex(src)))
  }

def ensOfProg(p: Prog): List[En] =
  p match {
    case Prog(_, enums, _, _, _, _, _, _, _) => enums
  }

def emptyVerify(file: String): String =
  Str.concat(file, ":1:1: error: verify file needs a Timeline => Verdict claim or a drive oracle; write a claim or delete the file")

def ioRet(d: Fun): Bool =
  Str.len(d.ret) >= 2 && Str.slice(d.ret, 0, 2) == "IO"

def drvNames(srcs: List[String]): List[String] =
  if (List.isEmpty(srcs)) noStr() else List.concat(drvFileNames(List.at(srcs, 0)), drvNames(List.tail(srcs)))

def drvFileNames(src: String): List[String] =
  drvFileNamesGo(Parse.parse(Lexer.lex(src)))

def drvFileNamesGo(p: Prog): List[String] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => ioDefNames(defs)
  }

def ioDefNames(ds: List[Fun]): List[String] =
  if (List.isEmpty(ds)) noStr() else ioDefNamesHd(List.at(ds, 0), List.tail(ds))

def ioDefNamesHd(d: Fun, rest: List[Fun]): List[String] =
  if (ioRet(d)) d.name :: ioDefNames(rest) else ioDefNames(rest)

def oracleNames(srcs: List[String]): List[String] =
  oracleNamesEns(srcs, noEn())

def oracleNamesEns(srcs: List[String], ens: List[En]): List[String] =
  funNames(parseVerifyAllEns(srcs, ens))

def funNames(ds: List[Fun]): List[String] =
  if (List.isEmpty(ds)) noStr() else funNamesHd(List.at(ds, 0), List.tail(ds))

def funNamesHd(d: Fun, rest: List[Fun]): List[String] =
  d.name :: funNames(rest)

def dupName(xs: List[String]): String =
  if (List.isEmpty(xs) || List.isEmpty(List.tail(xs))) "" else dupName2(List.at(xs, 0), List.at(xs, 1), List.tail(xs))

def dupName2(a: String, b: String, rest: List[String]): String =
  if (a == b) a else dupName(rest)

def driveCapMsg(n: Int): String =
  Str.concat("scuzz.toml:1:1: error: package declares ", Str.concat(Str.fromInt(n), " drive names; at most 32 drive names are allowed"))

def driveDupMsg(name: String): String =
  Str.concat("scuzz.toml:1:1: error: drive name ", Str.concat(name, " is declared more than once"))

def driveRule(names: List[String]): String =
  if (List.len(names) > 32) driveCapMsg(List.len(names)) else driveDupMsgGo(dupName(sortStrs(names)))

def driveDupMsgGo(dup: String): String =
  if (dup == "") "" else driveDupMsg(dup)

def intentMsg(file: String): String =
  Str.concat(file, ":1:1: error: leftover *.scuzz_intent; rename to *.scuzz_verify or delete the file")

def isBlank(s: String): Bool =
  isBlankAt(s, 0)

def isBlankAt(s: String, i: Int): Bool =
  if (i >= Str.len(s)) true else if (isWs(Str.charAt(s, i))) isBlankAt(s, i + 1) else false

def isWs(c: Int): Bool =
  c == 32 || c == 9 || c == 10 || c == 13

def firstTokOff(src: String): Int =
  firstTokOffAt(src, 0)

def firstTokOffAt(src: String, i: Int): Int =
  if (i >= Str.len(src)) 0 else if (isWs(Str.charAt(src, i))) firstTokOffAt(src, i + 1) else i

def atLoc(file: String, src: String, off: Int, msg: String): String =
  atLoc2(file, Check.locOf(src, off), msg)

def atLoc2(file: String, loc: (Int, Int, Int, Int), msg: String): String =
  loc match {
    case (line, col, _, _) => Str.concat(file, Str.concat(":", Str.concat(Str.fromInt(line), Str.concat(":", Str.concat(Str.fromInt(col), Str.concat(": error: ", msg))))))
  }

def fmtMsg(file: String): String =
  Str.concat(file, ":1:1: error: needs formatting (run scuzz fmt)")

def leftoverMsg(file: String, src: String): String =
  atLoc(file, src, firstTokOff(src), "leftover tokens after parse")

def checkVerify(src: String, file: String): String =
  checkVerifyEns(src, file, noEn())

def checkVerifyEns(src: String, file: String, ens: List[En]): String =
  if (isBlank(src)) emptyVerify(file) else checkVerifyProg(src, file, ens, Parse.parse(Lexer.lex(src)))

def checkVerifyProg(src: String, file: String, ens: List[En], p: Prog): String =
  if (List.isEmpty(p.defs) && p.main == "") leftoverMsg(file, src) else checkVerifyShape(src, file, ens, p)

def checkVerifyShape(src: String, file: String, ens: List[En], p: Prog): String =
  if (p.main != "") Str.concat(file, ":1:1: error: verify file must not define @main") else if (!List.isEmpty(p.enums)) Str.concat(file, ":1:1: error: verify file must not define enums") else if (!List.isEmpty(p.aliases)) Str.concat(file, ":1:1: error: verify file must not define aliases") else if (!List.isEmpty(p.traits)) Str.concat(file, ":1:1: error: verify file must not define traits") else if (!List.isEmpty(p.impls)) Str.concat(file, ":1:1: error: verify file must not define impls") else if (!List.isEmpty(p.imps)) Str.concat(file, ":1:1: error: verify file must not define imports") else checkVerifyBody(src, file, ens, p)

def checkVerifyBody(src: String, file: String, ens: List[En], p: Prog): String =
  if (defsHaveForbid(p.defs) || exprHasForbid(p.body)) Str.concat(file, ":1:1: error: verify bodies must not call Property.* or .require") else checkVerifyDefs(src, file, ens, p)

def checkVerifyDefs(src: String, file: String, ens: List[En], p: Prog): String =
  checkVerifyDefsGo(src, file, ens, p, p.defs)

def checkVerifyDefsGo(src: String, file: String, ens: List[En], p: Prog, ds: List[Fun]): String =
  if (List.isEmpty(ds)) checkVerifyEmpty(src, file, ens, p) else checkVerifyDefHit(src, file, ens, p, List.at(ds, 0), List.tail(ds))

def checkVerifyDefHit(src: String, file: String, ens: List[En], p: Prog, d: Fun, rest: List[Fun]): String =
  if (d.priv) checkVerifyDefsGo(src, file, ens, p, rest) else if (isDrive(d, ens)) checkVerifyDefsGo(src, file, ens, p, rest) else if (isClaim(d)) checkVerifyDefsGo(src, file, ens, p, rest) else defFail(d, file, src)

def defFail(d: Fun, file: String, src: String): String =
  if (d.ret == "Bool") atLoc(file, src, d.off, Str.concat("drive ", Str.concat(d.name, " params must be generator-friendly (at most 3; ADT or List only as the sole param)"))) else if (d.ret == "Verdict") atLoc(file, src, d.off, Str.concat("claim ", Str.concat(d.name, " must take 1 or 2 Timeline params"))) else atLoc(file, src, d.off, Str.concat("public def ", Str.concat(d.name, " is not a drive oracle or a Timeline => Verdict claim")))

def checkVerifyEmpty(src: String, file: String, ens: List[En], p: Prog): String =
  if (List.isEmpty(drives(p.defs, ens)) && List.isEmpty(claims(p.defs))) emptyVerify(file) else checkVerifyFmt(src, file, p)

def checkVerifyFmt(src: String, file: String, p: Prog): String =
  if (Parse.pretty(p) == src) "scuzz check ok" else fmtMsg(file)

def defsHaveForbid(ds: List[Fun]): Bool =
  if (List.isEmpty(ds)) false else funHasForbid(List.at(ds, 0)) || defsHaveForbid(List.tail(ds))

def funHasForbid(d: Fun): Bool =
  d match {
    case Fun(_, _, _, _, _, body, _, _) => exprHasForbid(body)
  }

def exprHasForbid(e: Expr): Bool =
  e match {
    case Expr.EPrint(inner, _) => exprHasForbid(inner)
    case Expr.ECall(f, args, _) => Str.startsWith(f, "Property.") || listHasForbid(args)
    case Expr.EMethod(recv, name, args, _) => name == "require" || exprHasForbid(recv) || listHasForbid(args)
    case Expr.EField(recv, _, _) => exprHasForbid(recv)
    case Expr.EBin(_, l, r, _) => exprHasForbid(l) || exprHasForbid(r)
    case Expr.EUn(_, inner, _) => exprHasForbid(inner)
    case Expr.ELam(_, _, body) => exprHasForbid(body)
    case Expr.EIf(c, t, el, _) => exprHasForbid(c) || exprHasForbid(t) || exprHasForbid(el)
    case Expr.EMatch(s, arms, _) => exprHasForbid(s) || armsHaveForbid(arms)
    case Expr.EList(xs) => listHasForbid(xs)
    case Expr.ETuple(xs) => listHasForbid(xs)
    case Expr.ENamed(_, inner) => exprHasForbid(inner)
    case Expr.EAscribe(inner, _, _) => exprHasForbid(inner)
    case Expr.EFor(bs, body, _) => bindsHaveForbid(bs) || exprHasForbid(body)
    case _ => false
  }

def listHasForbid(xs: List[Expr]): Bool =
  if (List.isEmpty(xs)) false else exprHasForbid(List.at(xs, 0)) || listHasForbid(List.tail(xs))

def armsHaveForbid(xs: List[Arm]): Bool =
  if (List.isEmpty(xs)) false else armHasForbid(List.at(xs, 0)) || armsHaveForbid(List.tail(xs))

def armHasForbid(a: Arm): Bool =
  a match {
    case Arm(_, _, body) => exprHasForbid(body)
  }

def bindsHaveForbid(xs: List[Bind]): Bool =
  if (List.isEmpty(xs)) false else bindHasForbid(List.at(xs, 0)) || bindsHaveForbid(List.tail(xs))

def bindHasForbid(b: Bind): Bool =
  b match {
    case Bind(_, _, e) => exprHasForbid(e)
  }

def testOut(checkOk: Bool): String =
  if (!checkOk) "scuzz test fail" else Str.concat("project compile smoke ok", Str.concat(nl(), Str.concat("IO smoke ok", Str.concat(nl(), "scuzz test ok"))))

def searchN(n: Int): Int =
  if (n <= 0) 0 else n * 5 / 8

def mutateN(n: Int): Int =
  n - searchN(n)

def fuzzHead(iterations: Int, corpus: Int, sites: Int): String =
  Str.concat(if (iterations <= 0) Str.concat("scuzz fuzz: corpus-only (--iterations 0)", nl()) else "", Str.concat(if (iterations <= 0 && corpus > 0) Str.concat("scuzz fuzz: replay ", Str.concat(Str.fromInt(corpus), Str.concat(" corpus entries", nl()))) else "", if (sites == 0) Str.concat("scuzz fuzz: no live-code mutation sites", nl()) else ""))

def fuzzOut(iterations: Int, seed: Int, corpus: Int, sites: Int, failures: Int, corpFail: Int): String =
  fuzzOut2(fuzzHead(iterations, corpus, sites), searchN(iterations), seed, corpus, sites, failures, corpFail, fuzzMut(sites))

def fuzzStatus(search: Int, failures: Int, seed: Int, corpus: Int): String =
  Str.concat("scuzz fuzz ", Str.concat(if (failures == 0) "ok" else "fail", Str.concat(" (", Str.concat(Str.fromInt(search), Str.concat(" search, ", Str.concat(Str.fromInt(failures), Str.concat(" search failures, seed ", Str.concat(Str.fromInt(seed), Str.concat(", ", Str.concat(Str.fromInt(corpus), " corpus)"))))))))))

def fuzzCorpus(corpus: Int, corpFail: Int): String =
  Str.concat("corpus: ", Str.concat(Str.fromInt(corpus), Str.concat(" stored, ", Str.concat(Str.fromInt(corpFail), " failed, 0 promoted"))))

def fuzzMut(sites: Int): String =
  Str.concat("mutate: 0 killed, 0 survived, 0 inert (0 of ", Str.concat(Str.fromInt(sites), " sites)"))

def fuzzOut2(head: String, search: Int, seed: Int, corpus: Int, _sites: Int, failures: Int, corpFail: Int, mut: String): String =
  Str.concat(head, Str.concat(fuzzStatus(search, failures, seed, corpus), Str.concat(nl(), Str.concat(fuzzCorpus(corpus, corpFail), Str.concat(nl(), Str.concat("coverage: (none)", Str.concat(nl(), Str.concat("declared: (none)", Str.concat(nl(), mut)))))))))

def remEuclid(a: Int, n: Int): Int =
  if (n <= 0) 0 else remEuclid2(a % n, n)

def remEuclid2(r: Int, n: Int): Int =
  if (r < 0) r + n else r

def parseSeed(s: String): Int =
  if (s == "") 0 else Str.toInt(s, 0)

def decodeK(s: Int): Int =
  remEuclid(if (s < 0) 0 else s, 8)

def decodeRest(s: Int): Int =
  (if (s < 0) 0 else s) / 8

def decodeD(s: Int): Int =
  2 + remEuclid(decodeRest(s), 4)

def decodeRng(s: Int): Int =
  decodeRest(s) / 4

def encodeSched(rng: Int, d: Int, k: Int): Int =
  rng * 32 + (d - 2) * 8 + k

def perturbSched(base: String, s: Int): String =
  perturbSched2(parseSeed(base), s)

def perturbSched2(seed: Int, s: Int): String =
  Str.fromInt(encodeSched(decodeRng(seed) + 1 + remEuclid(s, 16), decodeD(seed), decodeK(seed)))

def mixByte(h: Int, b: Int): Int =
  remEuclid((h ^ b) * 16777619, 2147483647)

def mixStr(h: Int, s: String): Int =
  mixStrAt(h, s, 0)

def mixStrAt(h: Int, s: String, i: Int): Int =
  if (i >= Str.len(s)) h else mixStrAt(mixByte(h, Str.charAt(s, i)), s, i + 1)

def relateSeed(label: String, sched: String, script: String, n: Int): Int =
  mixByte(mixStr(mixStr(mixStr(2166136261, label), sched), script), n)

