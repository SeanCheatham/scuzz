import Parse.Fun
import Parse.Param
import Parse.Prog
import Parse.Expr
import Parse.Arm
import Parse.Bind
import Parse.En
import Parse.EnCase
import Parse.Im
import Parse.pretty
import Check.Out

def nl(): String =
  """
"""

def findIdx(s: String, needle: String, i: Int): Int =
  if (Str.len(needle) == 0 || i + Str.len(needle) > Str.len(s)) 0 - 1 else if (Str.slice(s, i, i + Str.len(needle)) == needle) i else findIdx(s, needle, i + 1)

def afterOp(w: String, op: String): String =
  afterOp2(w, findIdx(w, op, 0), op)

def afterOp2(w: String, i: Int, op: String): String =
  if (i < 0) "" else Str.slice(w, i + Str.len(op), Str.len(w))

def trimNum(s: String): String =
  trimNum2(s, 0)

def trimNum2(s: String, i: Int): String =
  if (i >= Str.len(s)) s else if (Str.charAt(s, i) == 32) trimNum2(s, i + 1) else Str.slice(s, i, Str.len(s))

def noStr(): List[String] =
  []

def noFun(): List[Fun] =
  []

def noEn(): List[En] =
  []

def kindTokE(p: Param, ens: List[En]): String =
  if (p.ty == "Int") intTok(p.w) else if (p.ty == "String") "s" else if (p.ty == "Bool") "b" else if (isListTy(p.ty)) listTok(p.ty, ens, 0) else adtTok(p.ty, ens, 0)

def isListTy(t: String): Bool =
  Str.len(t) > 6 && Str.slice(t, 0, 5) == "List[" && Str.charAt(t, Str.len(t) - 1) == 93

def listInner(t: String): String =
  Str.slice(t, 5, Str.len(t) - 1)

def listTok(t: String, ens: List[En], depth: Int): String =
  Str.concat("[", Str.concat(typeTok(listInner(t), ens, depth + 1), "]"))

def typeTok(t: String, ens: List[En], depth: Int): String =
  if (t == "Int") "i" else if (t == "String") "s" else if (t == "Bool") "b" else if (isListTy(t)) listTok(t, ens, depth) else adtTok(t, ens, depth)

def adtTok(ty: String, ens: List[En], depth: Int): String =
  adtTokHit(findEn(ens, tyHead(ty)), ty, ens, depth)

def tyHead(t: String): String =
  tyHeadAt(t, 0)

def tyHeadAt(t: String, i: Int): String =
  if (i >= Str.len(t)) t else if (Str.charAt(t, i) == 91) Str.slice(t, 0, i) else tyHeadAt(t, i + 1)

def findEn(ens: List[En], name: String): List[En] =
  if (List.isEmpty(ens)) noEn() else findEn1(List.at(ens, 0), List.tail(ens), name)

def findEn1(h: En, rest: List[En], name: String): List[En] =
  h match {
    case En(_, n, _, _) => if (n == name) h :: noEn() else findEn(rest, name)
  }

def adtTokHit(hit: List[En], ty: String, ens: List[En], depth: Int): String =
  if (List.isEmpty(hit)) ty else adtTokEn(List.at(hit, 0), ens, depth)

def adtTokEn(e: En, ens: List[En], depth: Int): String =
  e match {
    case En(isRec, name, _, cases) => if (isRec || recLike(name, cases)) recTok(name, cases, ens, depth) else enumTok(cases, ens, depth)
  }

def recLike(name: String, cs: List[EnCase]): Bool =
  List.len(cs) == 1 && recLikeName(List.at(cs, 0), name)

def recLikeName(c: EnCase, name: String): Bool =
  c match {
    case EnCase(n, _) => n == name
  }

def recTok(name: String, cs: List[EnCase], ens: List[En], depth: Int): String =
  Str.concat(name, Str.concat("(", Str.concat(caseFields(List.at(cs, 0), ens, depth), ")")))

def caseFields(c: EnCase, ens: List[En], depth: Int): String =
  c match {
    case EnCase(_, fs) => fieldToks(fs, ens, depth)
  }

def fieldToks(fs: List[Param], ens: List[En], depth: Int): String =
  if (List.isEmpty(fs)) "" else if (List.len(fs) == 1) fieldTok(List.at(fs, 0), ens, depth) else Str.concat(fieldTok(List.at(fs, 0), ens, depth), Str.concat(",", fieldToks(List.tail(fs), ens, depth)))

def fieldTok(p: Param, ens: List[En], depth: Int): String =
  if (p.ty == "Int") intTok(p.w) else typeTok(p.ty, ens, depth + 1)

def enumTok(cs: List[EnCase], ens: List[En], depth: Int): String =
  Str.concat("e:", enumCases(if (depth >= 3) leafCases(cs) else cs, ens, depth))

def leafCases(cs: List[EnCase]): List[EnCase] =
  if (List.isEmpty(cs)) noCase() else leafCases1(List.at(cs, 0), List.tail(cs))

def leafCases1(c: EnCase, rest: List[EnCase]): List[EnCase] =
  if (isLeafCase(c)) c :: leafCases(rest) else leafCases(rest)

def isLeafCase(c: EnCase): Bool =
  c match {
    case EnCase(_, fs) => allLeaf(fs)
  }

def allLeaf(fs: List[Param]): Bool =
  if (List.isEmpty(fs)) true else allLeafGo(List.at(fs, 0), List.tail(fs))

def allLeafGo(h: Param, rest: List[Param]): Bool =
  h match {
    case Param(_, ty, _, _) => leafTy(ty) && allLeaf(rest)
  }

def leafTy(t: String): Bool =
  t == "Int" || t == "String" || t == "Bool"

def enumCases(cs: List[EnCase], ens: List[En], depth: Int): String =
  if (List.isEmpty(cs)) "" else if (List.len(cs) == 1) caseTok(List.at(cs, 0), ens, depth) else Str.concat(caseTok(List.at(cs, 0), ens, depth), Str.concat("|", enumCases(List.tail(cs), ens, depth)))

def caseTok(c: EnCase, ens: List[En], depth: Int): String =
  c match {
    case EnCase(name, fs) => if (List.isEmpty(fs)) name else Str.concat(name, Str.concat("(", Str.concat(fieldToks(fs, ens, depth), ")")))
  }

def noCase(): List[EnCase] =
  []

def intTok(w: String): String =
  if (w == "") "i" else if (findIdx(w, ">=", 0) >= 0) Str.concat("i>=", trimNum(afterOp(w, ">="))) else if (findIdx(w, "<=", 0) >= 0) Str.concat("i<=", trimNum(afterOp(w, "<="))) else if (findIdx(w, ">", 0) >= 0) Str.concat("i>", trimNum(afterOp(w, ">"))) else if (findIdx(w, "<", 0) >= 0) Str.concat("i<", trimNum(afterOp(w, "<"))) else "i"

def friendly(p: Param, ens: List[En]): Bool =
  friendlyTy(p.ty, ens)

def friendlyTy(t: String, ens: List[En]): Bool =
  if (t == "Int" || t == "String" || t == "Bool") true else if (isListTy(t)) friendlyTy(listInner(t), ens) else if (opaqueTy(tyHead(t))) false else if (t == "" || t == "Unit" || t == "Any" || t == "Float" || t == "Timeline" || t == "Verdict") false else if (Str.startsWith(t, "IO")) false else if (hasSub(t, "=>")) false else !List.isEmpty(findEn(ens, tyHead(t)))

def opaqueTy(t: String): Bool =
  t == "Fiber" || t == "Ref" || t == "Queue" || t == "Deferred" || t == "Resource" || t == "Stream" || t == "Map" || t == "Set"

def hasSub(s: String, n: String): Bool =
  findIdx(s, n, 0) >= 0

def allFriendly(ps: List[Param], ens: List[En]): Bool =
  List.isEmpty(ps) || friendly(List.at(ps, 0), ens) && allFriendly(List.tail(ps), ens)

def isAdtOrList(p: Param): Bool =
  isListTy(p.ty) || !(p.ty == "Int" || p.ty == "String" || p.ty == "Bool")

def hasAdtOrList(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) false else isAdtOrList(List.at(ps, 0)) || hasAdtOrList(List.tail(ps))

def unaryAdtOk(ps: List[Param]): Bool =
  List.len(ps) <= 1 || !hasAdtOrList(ps)

def simpleWhere(w: String): Bool =
  w == "" || !hasSub(w, "&&") && !hasSub(w, "||")

def allSimpleWhere(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) true else allSimpleWhere1(List.at(ps, 0), List.tail(ps))

def allSimpleWhere1(p: Param, rest: List[Param]): Bool =
  p match {
    case Param(_, _, w, _) => simpleWhere(w) && allSimpleWhere(rest)
  }

def isDrive(d: Fun, ens: List[En]): Bool =
  !d.priv && d.ret == "Bool" && List.len(d.params) <= 3 && allFriendly(d.params, ens) && unaryAdtOk(d.params) && allSimpleWhere(d.params)

def isClaim(d: Fun): Bool =
  !d.priv && d.ret == "Verdict" && claimPs(d.params)

def claimPs(ps: List[Param]): Bool =
  (List.len(ps) == 1 || List.len(ps) == 2) && allTimeline(ps)

def allTimeline(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) true else allTimeline1(List.at(ps, 0), List.tail(ps))

def allTimeline1(p: Param, rest: List[Param]): Bool =
  p match {
    case Param(_, ty, _, _) => ty == "Timeline" && allTimeline(rest)
  }

def drives(ds: List[Fun], ens: List[En]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else drives1(List.at(ds, 0), List.tail(ds), ens)

def drives1(d: Fun, rest: List[Fun], ens: List[En]): List[Fun] =
  if (isDrive(d, ens)) d :: drives(rest, ens) else drives(rest, ens)

def specOfE(d: Fun, ens: List[En]): String =
  if (List.isEmpty(d.params)) d.name else Str.concat(d.name, Str.concat(" ", specs(d.params, ens)))

def specs(ps: List[Param], ens: List[En]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) kindTokE(List.at(ps, 0), ens) else Str.concat(kindTokE(List.at(ps, 0), ens), Str.concat(" ", specs(List.tail(ps), ens)))

def cmpStr(a: String, b: String): Int =
  cmpStr2(a, b, 0)

def cmpStr2(a: String, b: String, i: Int): Int =
  if (i >= Str.len(a) && i >= Str.len(b)) 0 else if (i >= Str.len(a)) 0 - 1 else if (i >= Str.len(b)) 1 else if (Str.charAt(a, i) < Str.charAt(b, i)) 0 - 1 else if (Str.charAt(a, i) > Str.charAt(b, i)) 1 else cmpStr2(a, b, i + 1)

def ins(x: String, ys: List[String]): List[String] =
  if (List.isEmpty(ys)) x :: noStr() else if (cmpStr(x, List.at(ys, 0)) <= 0) x :: ys else List.at(ys, 0) :: ins(x, List.tail(ys))

def sortStrs(xs: List[String]): List[String] =
  if (List.isEmpty(xs)) xs else ins(List.at(xs, 0), sortStrs(List.tail(xs)))

def nls(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else Str.concat(List.at(xs, 0), Str.concat(nl(), nls(List.tail(xs))))

def linesOf(s: String): List[String] =
  linesFrom(s, 0)

def linesFrom(s: String, start: Int): List[String] =
  if (start >= Str.len(s)) noStr() else linesFrom2(s, start, nextNl(s, start))

def nextNl(s: String, i: Int): Int =
  if (i >= Str.len(s)) i else if (Str.charAt(s, i) == 10) i else nextNl(s, i + 1)

def linesFrom2(s: String, start: Int, nl: Int): List[String] =
  if (nl >= Str.len(s)) lineRest(s, start, nl) else Str.slice(s, start, nl) :: linesFrom(s, nl + 1)

def lineRest(s: String, start: Int, i: Int): List[String] =
  if (start >= i) noStr() else Str.slice(s, start, i) :: noStr()

def eventsKey(): String =
  "events = ["

def parseEvents(src: String): List[String] =
  parseEventsAt(src, findIdx(src, eventsKey(), 0))

def parseEventsAt(src: String, i: Int): List[String] =
  if (i < 0) noStr() else parseEvSkip(src, i + Str.len(eventsKey()))

def parseEvSkip(src: String, i: Int): List[String] =
  if (i >= Str.len(src)) noStr() else parseEvCh(src, i, Str.charAt(src, i))

def parseEvCh(src: String, i: Int, c: Int): List[String] =
  if (c == 32 || c == 10 || c == 13 || c == 9 || c == 44) parseEvSkip(src, i + 1) else if (c == 93) noStr() else if (c == 34) parseEvStr(src, i + 1, "") else parseEvSkip(src, i + 1)

def parseEvStr(src: String, i: Int, acc: String): List[String] =
  if (i >= Str.len(src)) noStr() else parseEvStrCh(src, i, Str.charAt(src, i), acc)

def parseEvStrCh(src: String, i: Int, c: Int, acc: String): List[String] =
  if (c == 92) parseEvEsc(src, i + 1, acc) else if (c == 34) acc :: parseEvSkip(src, i + 1) else parseEvStr(src, i + 1, Str.concat(acc, Str.slice(src, i, i + 1)))

def parseEvEsc(src: String, i: Int, acc: String): List[String] =
  if (i >= Str.len(src)) acc :: noStr() else parseEvStr(src, i + 1, Str.concat(acc, Str.slice(src, i, i + 1)))

def tomlQuoted(src: String, key: String): String =
  tomlQuotedAt(src, findIdx(src, Str.concat(key, " = \""), 0), Str.len(key) + 4)

def tomlQuotedAt(src: String, i: Int, skip: Int): String =
  if (i < 0) "" else tomlQuotedEnd(src, i + skip, i + skip)

def tomlQuotedEnd(src: String, start: Int, i: Int): String =
  if (i >= Str.len(src) || Str.charAt(src, i) == 34) Str.slice(src, start, i) else tomlQuotedEnd(src, start, i + 1)

def quoteEvents(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else if (List.isEmpty(List.tail(xs))) quoteEv(List.at(xs, 0)) else Str.concat(quoteEv(List.at(xs, 0)), Str.concat(", ", quoteEvents(List.tail(xs))))

def quoteEv(e: String): String =
  Str.concat("\"", Str.concat(escEv(e, 0, Builder.empty()), "\""))

def escEv(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else escEv(s, i + 1, Builder.append(b, escEvCh(Str.charAt(s, i), s, i)))

def escEvCh(c: Int, s: String, i: Int): String =
  if (c == 92) "\\\\" else if (c == 34) "\\\"" else Str.slice(s, i, i + 1)

def reproText(seed: Int, sched: String, fault: String, events: List[String]): String =
  Str.concat("""[fuzz]
""", Str.concat(reproOracle(events), Str.concat("seed = ", Str.concat(Str.fromInt(seed), Str.concat(reproSched(sched), Str.concat(reproFault(fault), Str.concat("events = [", Str.concat(quoteEvents(events), """]
"""))))))))

def reproOracle(events: List[String]): String =
  if (oracleName(events) == "") "" else Str.concat("oracle = \"", Str.concat(oracleName(events), "\"\n"))

def oracleName(events: List[String]): String =
  if (List.isEmpty(events)) "" else oracleNameLine(List.at(events, 0), List.tail(events))

def oracleNameLine(line: String, rest: List[String]): String =
  if (Str.startsWith(line, "drive ")) oracleDrive(line) else oracleName(rest)

def oracleDrive(line: String): String =
  if (List.len(Str.split(line, " ")) < 2) "" else List.at(Str.split(line, " "), 1)

def withOracle(src: String, events: List[String]): String =
  if (oracleName(events) == "" || Str.contains(src, "oracle =")) src else insertOracle(src, oracleName(events))

def scriptJson(script: String): String =
  Str.concat("{\"v\":1,\"kind\":\"inject\",\"events\":[", Str.concat(jJoin(jEvents(linesOf(script))), "]}"))

def jEvents(xs: List[String]): List[String] =
  List.filter(List.map(xs, l => jLine(l)), e => e != "")

def jJoin(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else if (List.isEmpty(List.tail(xs))) List.at(xs, 0) else Str.concat(List.at(xs, 0), Str.concat(",", jJoin(List.tail(xs))))

def jLine(line: String): String =
  if (line == "" || Str.startsWith(line, "#")) "" else jVerb(line, List.filter(Str.split(line, " "), t => t != ""))

def jVerb(line: String, toks: List[String]): String =
  jVerbGo(line, List.at(toks, 0), List.drop(toks, 1))

def jVerbGo(line: String, verb: String, args: List[String]): String =
  if (verb == "tap") jObj("tap", jNum("i", jAt(args, 0, "0"))) else if (verb == "pump") jObj("pump", jNum("k", jAt(args, 0, "1"))) else if (verb == "drive") jObj("drive", Str.concat(jStrK("name", jAt(args, 0, "")), jStrArr(List.drop(args, 1)))) else if (verb == "key") jKeyEvent(jAt(args, 0, ""), jRest(jRest(line))) else if (verb == "caret") jObj("caret", if (List.len(args) >= 2) Str.concat(jNum("i", List.at(args, 0)), jNum("offset", List.at(args, 1))) else jNum("offset", jAt(args, 0, "0"))) else if (verb == "select") jObj("select", if (List.len(args) >= 3) Str.concat(jNum("i", List.at(args, 0)), Str.concat(jNum("start", List.at(args, 1)), jNum("end", List.at(args, 2)))) else Str.concat(jNum("start", jAt(args, 0, "0")), jNum("end", jAt(args, 1, "0")))) else if (verb == "secondary") jObj("secondary", if (List.len(args) >= 2) Str.concat(jNum("x", List.at(args, 0)), jNum("y", List.at(args, 1))) else jNum("i", jAt(args, 0, "0"))) else if (verb == "text") jField("text", jRest(line)) else if (verb == "type") jField("type", jRest(line)) else if (verb == "backspace") jObj("backspace", if (List.len(args) >= 2) Str.concat(jNum("i", List.at(args, 0)), jNum("count", List.at(args, 1))) else if (List.len(args) == 1) jNum("count", List.at(args, 0)) else "") else if (verb == "scroll") jObj("scroll", if (List.len(args) >= 2) Str.concat(jNum("i", List.at(args, 0)), jNum("dy", List.at(args, 1))) else if (List.len(args) == 1) jNum("dy", List.at(args, 0)) else "") else if (verb == "xy") jObj("xy", Str.concat(jNum("x", jAt(args, 0, "0")), jNum("y", jAt(args, 1, "0")))) else if (verb == "drag") jObj("drag", Str.concat(jNum("x1", jAt(args, 0, "0")), Str.concat(jNum("y1", jAt(args, 1, "0")), Str.concat(jNum("x2", jAt(args, 2, "0")), jNum("y2", jAt(args, 3, "0")))))) else if (verb == "hover") jObj("hover", Str.concat(jNum("x", jAt(args, 0, "0")), jNum("y", jAt(args, 1, "0")))) else if (verb == "compose") jObj("compose", jStrK("value", jRest(line))) else if (verb == "paste") jObj("paste", if (jRest(line) == "") "" else jStrK("value", jRest(line))) else if (jBareOp(verb)) jObj(verb, "") else jObj("__bad_line__", jStrK("line", line))

def jBareOp(verb: String): Bool =
  verb == "copy" || verb == "cut" || verb == "commit" || verb == "dump" || verb == "reload" || verb == "quit" || verb == "resetpeak"

def jAt(xs: List[String], i: Int, d: String): String =
  if (i < List.len(xs)) List.at(xs, i) else d

def jRest(line: String): String =
  jRestAt(line, findIdx(line, " ", 0))

def jRestAt(line: String, i: Int): String =
  if (i < 0) "" else Str.drop(line, i + 1)

def jObj(op: String, body: String): String =
  Str.concat("{\"op\":\"", Str.concat(op, Str.concat("\"", Str.concat(body, "}"))))

def jNum(key: String, tok: String): String =
  Str.concat(",\"", Str.concat(key, Str.concat("\":", tok)))

def jStrK(key: String, v: String): String =
  Str.concat(",\"", Str.concat(key, Str.concat("\":", Check.jsonStr(v))))

def jStrArr(xs: List[String]): String =
  Str.concat(",\"args\":[", Str.concat(jStrArrGo(xs), "]"))

def jStrArrGo(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else if (List.isEmpty(List.tail(xs))) Check.jsonStr(List.at(xs, 0)) else Str.concat(Check.jsonStr(List.at(xs, 0)), Str.concat(",", jStrArrGo(List.tail(xs))))

def jField(op: String, rest: String): String =
  jFieldAt(op, rest, findIdx(rest, " ", 0))

def jFieldAt(op: String, rest: String, i: Int): String =
  if (i > 0 && allDigits(Str.take(rest, i))) jObj(op, Str.concat(jNum("i", Str.take(rest, i)), jStrK("value", Str.drop(rest, i + 1)))) else jObj(op, jStrK("value", rest))

def allDigits(s: String): Bool =
  Str.len(s) > 0 && allDigitsAt(s, 0)

def allDigitsAt(s: String, i: Int): Bool =
  if (i >= Str.len(s)) true else if (Str.charAt(s, i) < 48 || Str.charAt(s, i) > 57) false else allDigitsAt(s, i + 1)

def jKeyEvent(tok: String, text: String): String =
  jKeyAsm(List.filter(Str.split(tok, "+"), p => p != ""), text)

def jKeyAsm(ps: List[String], text: String): String =
  jObj("key", Str.concat(jStrK("key", jKeyName(ps)), Str.concat(if (text == "") "" else jStrK("text", text), Str.concat(jKeyModsBody(ps), if (List.exists(ps, p => Str.toLower(p) == "repeat")) ",\"repeat\":true" else ""))))

def jKeyIsMod(p: String): Bool =
  Str.toLower(p) == "shift" || Str.toLower(p) == "ctrl" || Str.toLower(p) == "cmd" || Str.toLower(p) == "alt"

def jKeyIsMeta(p: String): Bool =
  jKeyIsMod(p) || Str.toLower(p) == "repeat"

def jKeyName(ps: List[String]): String =
  if (List.isEmpty(List.filter(ps, p => !jKeyIsMeta(p)))) "" else List.at(List.filter(ps, p => !jKeyIsMeta(p)), 0)

def jKeyModsBody(ps: List[String]): String =
  if (List.isEmpty(List.filter(ps, p => jKeyIsMod(p)))) "" else Str.concat(",\"mods\":[", Str.concat(jJoin(List.map(List.filter(ps, p => jKeyIsMod(p)), p => Check.jsonStr(Str.toLower(p)))), "]"))

def insertOracle(src: String, name: String): String =
  insertOracleAt(src, name, findIdx(src, """[fuzz]
""", 0))

def insertOracleAt(src: String, name: String, i: Int): String =
  if (i < 0) Str.concat("oracle = \"", Str.concat(name, Str.concat("\"\n", src))) else Str.concat(Str.slice(src, 0, i + 7), Str.concat("oracle = \"", Str.concat(name, Str.concat("\"\n", Str.slice(src, i + 7, Str.len(src))))))

def reproSched(sched: String): String =
  if (sched == "") nl() else Str.concat("\nschedule_seed = \"", Str.concat(sched, Str.concat("\"\n", pctLines(sched))))

def pctLines(sched: String): String =
  Str.concat("pct_d = ", Str.concat(Str.fromInt(decodeD(parseSeed(sched))), Str.concat("""
pct_k = """, Str.concat(Str.fromInt(decodeK(parseSeed(sched))), """
"""))))

def reproFault(fault: String): String =
  if (fault == "") "" else Str.concat("fault_seed = \"", Str.concat(fault, "\"\n"))

def jb(b: Bool): String =
  if (b) "true" else "false"

def summaryJson(ok: Bool, seed: Int, iterations: Int, search: Int, failures: Int, corpus: Int, corpFail: Int, promo: String, repro: String, killed: Int, survived: Int, inert: Int, ran: Int, sites: Int, oracles: Bool, classRaw: String, invalid: Int, covRows: List[(String, Bool)]): String =
  Str.concat("{\"v\":1,\"kind\":\"fuzz\",\"fuzz\":", Str.concat(jFuzz(ok, seed, iterations, search, failures, corpus, repro), Str.concat(jCorpus(corpus, corpFail, promo), Str.concat(jClass(List.filter(linesOf(classRaw), l => l != "")), Str.concat(jMut(killed, survived, inert, ran, sites, oracles, invalid), Str.concat(jCoverage(covRows), "}"))))))

def jFuzz(ok: Bool, seed: Int, iterations: Int, search: Int, failures: Int, corpus: Int, repro: String): String =
  Str.concat("{\"ok\":", Str.concat(jb(ok), Str.concat(",\"seed\":", Str.concat(Str.fromInt(seed), Str.concat(",\"iterations\":", Str.concat(Str.fromInt(iterations), Str.concat(",\"search\":", Str.concat(Str.fromInt(search), Str.concat(",\"search_failures\":", Str.concat(Str.fromInt(failures), Str.concat(",\"corpus\":", Str.concat(Str.fromInt(corpus), Str.concat(jRepro(repro), "}")))))))))))))

def jRepro(repro: String): String =
  if (repro == "") "" else Str.concat(",\"repro\":", Check.jsonStr(repro))

def jCorpus(corpus: Int, corpFail: Int, promo: String): String =
  Str.concat(",\"corpus\":{\"entries\":", Str.concat(Str.fromInt(corpus), Str.concat(",\"failures\":", Str.concat(Str.fromInt(corpFail), Str.concat(",\"promoted\":", Str.concat(promo, "}"))))))

def jClass(lines: List[String]): String =
  if (List.isEmpty(lines)) "" else Str.concat(",\"classify\":[", Str.concat(jClassOne(List.at(lines, 0)), Str.concat(jClassRest(List.tail(lines)), "]")))

def jClassRest(lines: List[String]): String =
  if (List.isEmpty(lines)) "" else Str.concat(",", Str.concat(jClassOne(List.at(lines, 0)), jClassRest(List.tail(lines))))

def jClassOne(line: String): String =
  Str.concat("{\"name\":", Str.concat(Check.jsonStr(className(line)), Str.concat(",\"true\":", Str.concat(classYes(classNums(line)), Str.concat(",\"false\":", Str.concat(classNo(classNums(line)), "}"))))))

def jMut(killed: Int, survived: Int, inert: Int, ran: Int, sites: Int, oracles: Bool, invalid: Int): String =
  Str.concat(",\"mutate\":{\"killed\":", Str.concat(Str.fromInt(killed), Str.concat(",\"survived\":", Str.concat(Str.fromInt(survived), Str.concat(",\"inert\":", Str.concat(Str.fromInt(inert), Str.concat(",\"ran\":", Str.concat(Str.fromInt(ran), Str.concat(",\"sites\":", Str.concat(Str.fromInt(sites), Str.concat(",\"oracles\":", Str.concat(jb(oracles), Str.concat(",\"invalid\":", Str.concat(Str.fromInt(invalid), Str.concat(jScore(killed, ran - invalid - inert), "}")))))))))))))))

def jScore(killed: Int, sites: Int): String =
  if (sites <= 0) "" else Str.concat(",\"score\":", score3(killed, sites))

def jCoverage(rows: List[(String, Bool)]): String =
  Str.concat(",\"coverage\":{\"total\":", Str.concat(Str.fromInt(List.len(rows)), Str.concat(",\"reached\":", Str.concat(Str.fromInt(List.count(rows, r => r._2)), Str.concat(",\"regions\":[", Str.concat(jRegions(rows), "]}"))))))

def jRegions(rows: List[(String, Bool)]): String =
  if (List.isEmpty(rows)) "" else Str.concat(jRegion(List.at(rows, 0)), jRegionsRest(List.tail(rows)))

def jRegionsRest(rows: List[(String, Bool)]): String =
  if (List.isEmpty(rows)) "" else Str.concat(",", Str.concat(jRegion(List.at(rows, 0)), jRegionsRest(List.tail(rows))))

def jRegion(row: (String, Bool)): String =
  Str.concat("{\"location\":", Str.concat(Check.jsonStr(row._1), Str.concat(",\"reached\":", Str.concat(jb(row._2), "}"))))

def coverageRowsOf(files: List[(String, String)], compiled: List[(String, String)], hits: String): List[(String, Bool)] =
  coverageProgRows(Parse.parseFiles(files), Parse.parseFiles(rewriteReqFiles(files)), Parse.parseFiles(compiled), files, compiled, Str.lines(hits))

def coverageProgRows(p: Prog, expected: Prog, built: Prog, files: List[(String, String)], compiled: List[(String, String)], hits: List[String]): List[(String, Bool)] =
  List.distinct(List.concat(coverageDefs(Check.implFuns(p.impls, p.defs), Check.implFuns(expected.impls, expected.defs), Check.implFuns(built.impls, built.defs), files, compiled, hits), if (p.main == "") [] else [(Emit.panicLocExpr(files, p.body), Parse.pretty0(expected.body) == Parse.pretty0(built.body) && List.contains(hits, Emit.panicLocExpr(compiled, built.body)))]))

def coverageDefs(defs: List[Fun], expected: List[Fun], built: List[Fun], files: List[(String, String)], compiled: List[(String, String)], hits: List[String]): List[(String, Bool)] =
  if (List.isEmpty(defs)) [] else coverageDef(List.at(defs, 0), expected, built, files, compiled, hits) :: coverageDefs(List.tail(defs), expected, built, files, compiled, hits)

def coverageDef(d: Fun, expected: List[Fun], built: List[Fun], files: List[(String, String)], compiled: List[(String, String)], hits: List[String]): (String, Bool) =
  (Emit.panicLoc(files, d.mod, d.off), coverageMatched(Check.findFunMod(expected, d.mod, d.name), Check.findFunMod(built, d.mod, d.name), compiled, hits))

def coverageMatched(expected: List[Fun], built: List[Fun], compiled: List[(String, String)], hits: List[String]): Bool =
  if (List.isEmpty(expected) || List.isEmpty(built)) false else coverageBody(List.at(expected, 0), List.at(built, 0), compiled, hits)

def coverageBody(expected: Fun, built: Fun, compiled: List[(String, String)], hits: List[String]): Bool =
  Parse.pretty0(expected.body) == Parse.pretty0(built.body) && List.contains(hits, Emit.panicLoc(compiled, built.mod, built.off))

def score3(killed: Int, sites: Int): String =
  score3n(killed * 1000 / sites)

def score3n(n: Int): String =
  Str.concat(Str.fromInt(n / 1000), Str.concat(".", pad3(n % 1000)))

def pad3(n: Int): String =
  if (n < 10) Str.concat("00", Str.fromInt(n)) else if (n < 100) Str.concat("0", Str.fromInt(n)) else Str.fromInt(n)

def className(line: String): String =
  classTok(line, 0)

def classNums(line: String): String =
  Str.slice(line, nextSp(line, 0) + 1, Str.len(line))

def classTok(line: String, i: Int): String =
  if (i >= Str.len(line) || Str.charAt(line, i) == 32) Str.slice(line, 0, i) else classTok(line, i + 1)

def nextSp(line: String, i: Int): Int =
  if (i >= Str.len(line)) i else if (Str.charAt(line, i) == 32) i else nextSp(line, i + 1)

def classYes(rest: String): String =
  classTok(rest, 0)

def classNo(rest: String): String =
  classTok(classNums(rest), 0)

def mapSeed(ds: List[Fun]): List[String] =
  mapSeedE(ds, noEn())

def mapSeedE(ds: List[Fun], ens: List[En]): List[String] =
  if (List.isEmpty(ds)) noStr() else seedOfE(List.at(ds, 0), ens) :: mapSeedE(List.tail(ds), ens)

def seedOfE(d: Fun, ens: List[En]): String =
  if (List.isEmpty(d.params)) Str.concat("drive ", d.name) else Str.concat("drive ", Str.concat(d.name, Str.concat(" ", seedArgsE(d.params, ens))))

def seedArgsE(ps: List[Param], ens: List[En]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) seedArgE(List.at(ps, 0), ens) else Str.concat(seedArgE(List.at(ps, 0), ens), Str.concat(" ", seedArgsE(List.tail(ps), ens)))

def seedArgE(p: Param, ens: List[En]): String =
  if (p.ty == "Int") "0" else if (p.ty == "Bool") "false" else if (p.ty == "String") "a" else if (isListTy(p.ty)) "[]" else seedAdt(p.ty, ens)

def seedAdt(ty: String, ens: List[En]): String =
  seedHit(findEn(ens, tyHead(ty)), ty, ens)

def seedHit(hit: List[En], ty: String, ens: List[En]): String =
  if (List.isEmpty(hit)) "0" else seedEn(List.at(hit, 0), ens)

def seedEn(e: En, ens: List[En]): String =
  e match {
    case En(isRec, name, _, cases) => if (isRec || recLike(name, cases)) seedRec(name, cases, ens) else seedEnum(cases, ens)
  }

def seedRec(name: String, cs: List[EnCase], ens: List[En]): String =
  if (List.isEmpty(cs)) name else seedCase(List.at(cs, 0), ens)

def seedEnum(cs: List[EnCase], ens: List[En]): String =
  seedEnumHit(leafCases(cs), cs, ens)

def seedEnumHit(leaf: List[EnCase], all: List[EnCase], ens: List[En]): String =
  if (List.isEmpty(leaf)) seedCase(List.at(all, 0), ens) else seedCase(List.at(leaf, 0), ens)

def seedCase(c: EnCase, ens: List[En]): String =
  c match {
    case EnCase(name, fs) => seedCtor(name, fs, ens)
  }

def seedCtor(name: String, fs: List[Param], ens: List[En]): String =
  if (List.isEmpty(fs)) name else Str.concat(name, Str.concat("(", Str.concat(seedFields(fs, ens), ")")))

def seedFields(fs: List[Param], ens: List[En]): String =
  if (List.isEmpty(fs)) "" else if (List.len(fs) == 1) seedArgE(List.at(fs, 0), ens) else Str.concat(seedArgE(List.at(fs, 0), ens), Str.concat(",", seedFields(List.tail(fs), ens)))

def mapSpec(ds: List[Fun]): List[String] =
  mapSpecE(ds, noEn())

def mapSpecE(ds: List[Fun], ens: List[En]): List[String] =
  if (List.isEmpty(ds)) noStr() else specOfE(List.at(ds, 0), ens) :: mapSpecE(List.tail(ds), ens)

def parseVerify(src: String): List[Fun] =
  parseVerifyEns(src, noEn())

def parseVerifyEns(src: String, ens: List[En]): List[Fun] =
  parseVerifyProg(Parse.parse(Lexer.lex(src)), ens)

def parseVerifyProg(p: Prog, ens: List[En]): List[Fun] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => drives(defs, ens)
  }

def parseClaims(src: String): List[Fun] =
  parseClaimsProg(Parse.parse(Lexer.lex(src)))

def parseClaimsProg(p: Prog): List[Fun] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => claims(defs)
  }

def claims(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else claims1(List.at(ds, 0), List.tail(ds))

def claims1(d: Fun, rest: List[Fun]): List[Fun] =
  if (isClaim(d)) d :: claims(rest) else claims(rest)

def wrapMod(): String =
  "__verify"

def wrapSrc(stem: String, src: String): String =
  wrapSrcEns(stem, src, noEn())

def wrapSrcEns(stem: String, src: String, ens: List[En]): String =
  Str.concat(wrapFuns(stem, parseVerifyEns(src, ens)), wrapRelFuns(parseClaims(src)))

def wrapFuns(stem: String, ds: List[Fun]): String =
  if (List.isEmpty(ds)) "" else Str.concat(wrapFun(stem, List.at(ds, 0)), wrapFuns(stem, List.tail(ds)))

def wrapFun(_stem: String, d: Fun): String =
  d match {
    case Fun(_, name, _, ps, _, body, _, _) => wrapFunBody(name, wrapPs(ps), body)
  }

def wrapFunBody(name: String, ps: String, body: Expr): String =
  body match {
    case Expr.EBin("==", l, r, _) => wrapEq(name, ps, l, r)
    case _ => wrapFun2(name, ps, Parse.pretty0(body))
  }

def wrapEq(name: String, ps: String, l: Expr, r: Expr): String =
  Str.concat("def _drv_", Str.concat(name, Str.concat("(", Str.concat(ps, Str.concat("""): IO[Unit] =
  for {
    oraL = """, Str.concat(Parse.pretty0(l), Str.concat("""
    oraR = """, Str.concat(Parse.pretty0(r), Str.concat("\n    _ <- if (oraL == oraR) IO.pure(()) else IO.println(s\"oracle ", Str.concat(name, Str.concat(" rejected left=$oraL right=$oraR\").flatMap(_ => Property.assert(\"", Str.concat(name, "\", false))\n  } yield ()\n"))))))))))))

def wrapFun2(name: String, ps: String, body: String): String =
  Str.concat("def _drv_", Str.concat(name, Str.concat("(", Str.concat(ps, Str.concat("): IO[Unit] =\n  Property.assert(\"", Str.concat(name, Str.concat("\", ", Str.concat(body, """)
"""))))))))

def wrapPs(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) wrapP(List.at(ps, 0)) else Str.concat(wrapP(List.at(ps, 0)), Str.concat(", ", wrapPs(List.tail(ps))))

def wrapP(p: Param): String =
  p match {
    case Param(n, ty, _, _) => Str.concat(n, Str.concat(": ", ty))
  }

def wrapRelFuns(ds: List[Fun]): String =
  if (List.isEmpty(ds)) "" else Str.concat(wrapRel(List.at(ds, 0)), wrapRelFuns(List.tail(ds)))

def wrapRel(d: Fun): String =
  d match {
    case Fun(_, name, _, ps, _, body, _, _) => wrapRel2(name, wrapPs(ps), Parse.pretty0(body))
  }

def wrapRel2(name: String, ps: String, body: String): String =
  Str.concat("def ", Str.concat(name, Str.concat("(", Str.concat(ps, Str.concat("""): Verdict =
  """, Str.concat(body, """

"""))))))

def wrapFilesEns(files: List[(String, String)], ens: List[En]): String =
  if (List.isEmpty(files)) "" else wrapFilesEns2(List.at(files, 0), List.tail(files), ens)

def wrapFilesEns2(h: (String, String), rest: List[(String, String)], ens: List[En]): String =
  h match {
    case (stem, src) => Str.concat(wrapSrcEns(stem, src, ens), wrapFilesEns(rest, ens))
  }

def applySimLive(live: Prog, sdefs: List[Fun]): String =
  live match {
    case Prog(pkg, enums, aliases, traits, impls, imps, defs, main, body) => Parse.pretty(Prog(pkg, enums, aliases, traits, impls, imps, swapDefs(defs, sdefs), main, body))
  }

def swapDefs(ds: List[Fun], sim: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) ds else pickSim(List.at(ds, 0), sim) :: swapDefs(List.tail(ds), sim)

def pickSim(d: Fun, sim: List[Fun]): Fun =
  if (List.isEmpty(sim)) d else pickSim1(d, List.at(sim, 0), List.tail(sim))

def pickSim1(d: Fun, s: Fun, rest: List[Fun]): Fun =
  if (d.name == s.name) s else pickSim(d, rest)

def hasDot(name: String): Bool =
  findIdx(name, ".", 0) >= 0

def replMod(name: String): String =
  replSplit(name, findIdx(name, ".", 0), true)

def replLocal(name: String): String =
  replSplit(name, findIdx(name, ".", 0), false)

def replSplit(name: String, i: Int, left: Bool): String =
  if (i < 0) if (left) "" else name else if (left) Str.slice(name, 0, i) else Str.slice(name, i + 1, Str.len(name))

def applyScenarioFiles(files: List[(String, String)], src: String): List[(String, String)] =
  if (src == "") files else applyScenarioGo(files, replFuns(Parse.parse(Lexer.lex(src))))

def replFuns(p: Prog): List[Fun] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => replDefs(defs)
  }

def replDefs(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else replDefs1(List.at(ds, 0), List.tail(ds))

def replDefs1(d: Fun, rest: List[Fun]): List[Fun] =
  if (hasDot(d.name)) d :: replDefs(rest) else replDefs(rest)

def applyScenarioGo(files: List[(String, String)], repls: List[Fun]): List[(String, String)] =
  if (List.isEmpty(files)) files else applyScenarioHd(List.at(files, 0), List.tail(files), repls)

def applyScenarioHd(h: (String, String), rest: List[(String, String)], repls: List[Fun]): List[(String, String)] =
  h match {
    case (stem, src) => applyScenarioStem(stem, src, rest, repls, replsFor(stem, repls))
  }

def applyScenarioStem(stem: String, src: String, rest: List[(String, String)], repls: List[Fun], locals: List[Fun]): List[(String, String)] =
  (stem, if (List.isEmpty(locals)) src else applySimLive(Parse.parse(Lexer.lex(src)), locals)) :: applyScenarioGo(rest, repls)

def replsFor(stem: String, repls: List[Fun]): List[Fun] =
  if (List.isEmpty(repls)) noFun() else replsFor1(List.at(repls, 0), List.tail(repls), stem)

def replsFor1(d: Fun, rest: List[Fun], stem: String): List[Fun] =
  if (replMod(d.name) == stem) localRepl(d) :: replsFor(stem, rest) else replsFor(stem, rest)

def localRepl(d: Fun): Fun =
  d match {
    case Fun(priv, name, ts, ps, ret, body, mod, off) => Fun(priv, replLocal(name), ts, ps, ret, body, mod, off)
  }

def scenarioWrap(src: String): String =
  if (src == "") "" else scenarioWrapProg(Parse.parse(Lexer.lex(src)))

def scenarioWrapProg(p: Prog): String =
  p match {
    case Prog(_, enums, _, _, _, _, defs, _, _) => Parse.pretty(Prog("", enums, Parse.noAl(), Parse.noTr(), Parse.noIm(), Parse.noImp(), wrapScenarioDefs(defs, ctxTyOf(defs)), "", Expr.EUnit))
  }

def ctxTyOf(ds: List[Fun]): String =
  ctxTyHit(setupOf(ds))

def setupOf(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else setupOf1(List.at(ds, 0), List.tail(ds))

def setupOf1(d: Fun, rest: List[Fun]): List[Fun] =
  if (!d.priv && d.name == "setup") d :: noFun() else setupOf(rest)

def ctxTyHit(hit: List[Fun]): String =
  if (List.isEmpty(hit)) "" else ctxTyFun(List.at(hit, 0))

def ctxTyFun(d: Fun): String =
  if (Check.isIo(d.ret)) Check.ioOk(d.ret) else ""

def isCtxTy(t: String): Bool =
  t != "" && t != "Unit" && t != "Int" && t != "String" && t != "Bool" && !isListTy(t)

def wrapScenarioDefs(ds: List[Fun], ctxTy: String): List[Fun] =
  if (List.isEmpty(ds)) noFun() else List.concat(wrapScenarioOne(List.at(ds, 0), ctxTy), wrapScenarioDefs(List.tail(ds), ctxTy))

def wrapScenarioOne(d: Fun, ctxTy: String): List[Fun] =
  if (hasDot(d.name)) noFun() else if (d.priv || d.name == "setup" || !isCtxDriver(d, ctxTy)) d :: noFun() else wrapCtxDriver(d)

def isCtxDriver(d: Fun, ctxTy: String): Bool =
  isCtxTy(ctxTy) && Check.isIo(d.ret) && !d.priv && !List.isEmpty(d.params) && headTy(d.params) == ctxTy

def headTy(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else List.at(ps, 0) match {
  case Param(_, ty, _, _) => ty
}

def wrapCtxDriver(d: Fun): List[Fun] =
  d match {
    case Fun(_, name, ts, ps, ret, body, _, off) => Fun(true, Str.concat("_scn_", name), ts, ps, ret, body, "", off) :: Fun(false, name, ts, List.tail(ps), ret, wrapCall(d), "", off) :: noFun()
  }

def wrapCall(d: Fun): Expr =
  Expr.ECall(Str.concat("_scn_", d.name), Expr.ECall("Scenario.context", noExpr(), d.off) :: paramVars(List.tail(d.params), d.off), d.off)

def paramVars(ps: List[Param], off: Int): List[Expr] =
  if (List.isEmpty(ps)) noExpr() else paramVar(List.at(ps, 0), off) :: paramVars(List.tail(ps), off)

def paramVar(p: Param, off: Int): Expr =
  p match {
    case Param(n, _, _, _) => Expr.EVar(n, off)
  }

def scenarioDrvNames(src: String): List[String] =
  if (src == "") noStr() else scenarioDrvNamesGo(Parse.parse(Lexer.lex(src)))

def scenarioDrvNamesGo(p: Prog): List[String] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => scenarioIoNames(defs)
  }

def scenarioIoNames(ds: List[Fun]): List[String] =
  if (List.isEmpty(ds)) noStr() else scenarioIoNames1(List.at(ds, 0), List.tail(ds))

def scenarioIoNames1(d: Fun, rest: List[Fun]): List[String] =
  if (!d.priv && d.name != "setup" && !hasDot(d.name) && ioRet(d)) d.name :: scenarioIoNames(rest) else scenarioIoNames(rest)

def simLeftoverMsg(file: String): String =
  Str.concat(file, ":1:1: error: leftover *.scuzz_sim; move replacements into *.scuzz_scenario or delete the file")

def drvLeftoverMsg(file: String): String =
  Str.concat(file, ":1:1: error: leftover *.scuzz_drivers; move drivers into *.scuzz_scenario or delete the file")

def manyScenarioMsg(): String =
  "scuzz.toml:1:1: error: at most one *.scuzz_scenario file is allowed"

def checkScenario(src: String, file: String, live: List[(String, String)]): String =
  if (isBlank(src)) emptyScenario(file) else checkScenarioProg(src, file, live, Parse.parse(Lexer.lex(src)))

def emptyScenario(file: String): String =
  Str.concat(file, ":1:1: error: scenario file needs a setup entrypoint")

def checkScenarioProg(src: String, file: String, live: List[(String, String)], p: Prog): String =
  if (p.main != "") Str.concat(file, ":1:1: error: scenario file must not define @main") else if (!List.isEmpty(p.aliases)) Str.concat(file, ":1:1: error: scenario file must not define aliases") else if (!List.isEmpty(p.traits)) Str.concat(file, ":1:1: error: scenario file must not define traits") else if (!List.isEmpty(p.impls)) Str.concat(file, ":1:1: error: scenario file must not define impls") else if (!List.isEmpty(p.imps)) Str.concat(file, ":1:1: error: scenario file must not define imports") else checkScenarioBody(src, file, live, p)

def checkScenarioBody(src: String, file: String, live: List[(String, String)], p: Prog): String =
  if (defsHaveForbid(p.defs) || exprHasForbid(p.body)) Str.concat(file, ":1:1: error: scenario bodies must not call Property.* or .require") else checkScenarioSetup(src, file, live, p)

def checkScenarioSetup(src: String, file: String, live: List[(String, String)], p: Prog): String =
  checkScenarioSetup2(src, file, live, p, setupOf(p.defs))

def checkScenarioSetup2(src: String, file: String, live: List[(String, String)], p: Prog, setups: List[Fun]): String =
  if (List.isEmpty(setups)) emptyScenario(file) else if (!List.isEmpty(List.tail(setups))) Str.concat(file, ":1:1: error: scenario file must define one setup") else checkScenarioSetup3(src, file, live, p, List.at(setups, 0))

def checkScenarioSetup3(src: String, file: String, live: List[(String, String)], p: Prog, d: Fun): String =
  if (!Check.isIo(d.ret)) atLoc(file, src, d.off, "setup must return IO") else if (!List.isEmpty(d.params)) atLoc(file, src, d.off, "setup takes no generated params") else checkScenarioPublics(src, file, live, p, ctxTyFun(d), p.defs)

def checkScenarioPublics(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, ds: List[Fun]): String =
  if (List.isEmpty(ds)) checkScenarioReplDup(src, file, p) else checkScenarioPub(src, file, live, p, ctxTy, List.at(ds, 0), List.tail(ds))

def checkScenarioPub(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun]): String =
  if (d.priv) checkScenarioPublics(src, file, live, p, ctxTy, rest) else checkScenarioPub2(src, file, live, p, ctxTy, d, rest)

def checkScenarioPub2(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun]): String =
  if (d.name == "setup") checkScenarioPublics(src, file, live, p, ctxTy, rest) else if (hasDot(d.name)) checkScenarioRepl(src, file, live, p, ctxTy, d, rest) else if (Check.isIo(d.ret)) checkScenarioDrv(src, file, live, p, ctxTy, d, rest) else atLoc(file, src, d.off, Str.concat("public def ", Str.concat(d.name, " is not setup, a replacement, or a driver")))

def checkScenarioRepl(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun]): String =
  if (!Check.isIo(d.ret)) atLoc(file, src, d.off, "replacement must be IO") else checkScenarioRepl2(src, file, live, p, ctxTy, d, rest, liveFunOf(live, replMod(d.name), replLocal(d.name)))

def checkScenarioRepl2(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun], hit: List[Fun]): String =
  if (List.isEmpty(hit)) atLoc(file, src, d.off, Str.concat("replacement ", Str.concat(d.name, " has no production target"))) else checkScenarioRepl3(src, file, live, p, ctxTy, d, rest, List.at(hit, 0))

def checkScenarioRepl3(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun], liveD: Fun): String =
  if (!Check.isIo(liveD.ret)) atLoc(file, src, d.off, Str.concat("cannot replace pure helper ", d.name)) else if (isViewOrSig(liveD.ret)) atLoc(file, src, d.off, Str.concat("cannot replace View or Signal ", d.name)) else if (!sigEq(d, liveD)) atLoc(file, src, d.off, Str.concat("replacement ", Str.concat(d.name, " signature does not match production"))) else checkScenarioPublics(src, file, live, p, ctxTy, rest)

def isViewOrSig(t: String): Bool =
  t == "View" || Str.startsWith(t, "Signal")

def sigEq(a: Fun, b: Fun): Bool =
  a.ret == b.ret && paramTysEq(a.params, b.params)

def paramTysEq(a: List[Param], b: List[Param]): Bool =
  List.len(a) == List.len(b) && paramTysEqGo(a, b)

def paramTysEqGo(a: List[Param], b: List[Param]): Bool =
  if (List.isEmpty(a)) true else headTy(a) == headTy(b) && paramTysEq(List.tail(a), List.tail(b))

def liveFunOf(files: List[(String, String)], mod: String, name: String): List[Fun] =
  liveFunGo(liveFuns(files), mod, name)

def liveFuns(files: List[(String, String)]): List[Fun] =
  if (List.isEmpty(files)) noFun() else liveFunsHd(List.at(files, 0), List.tail(files))

def liveFunsHd(h: (String, String), rest: List[(String, String)]): List[Fun] =
  h match {
    case (stem, src) => List.concat(Parse.stampFuns(stem, Parse.parse(Lexer.lex(src)).defs), liveFuns(rest))
  }

def liveFunGo(ds: List[Fun], mod: String, name: String): List[Fun] =
  if (List.isEmpty(ds)) noFun() else liveFunGo1(List.at(ds, 0), List.tail(ds), mod, name)

def liveFunGo1(d: Fun, rest: List[Fun], mod: String, name: String): List[Fun] =
  if (d.name == name && d.mod == mod) d :: noFun() else liveFunGo(rest, mod, name)

def checkScenarioDrv(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun]): String =
  if (isCtxTy(ctxTy) && (List.isEmpty(d.params) || headTy(d.params) != ctxTy)) atLoc(file, src, d.off, Str.concat("driver ", Str.concat(d.name, Str.concat(" must take ", Str.concat(ctxTy, " as the first param"))))) else checkScenarioDrv2(src, file, live, p, ctxTy, d, rest, drvGenPs(d.params, ctxTy))

def checkScenarioDrv2(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun], ps: List[Param]): String =
  if (List.len(ps) > 3 || !allFriendly(ps, ensOfProg(p)) || !unaryAdtOk(ps) || !allSimpleWhere(ps)) atLoc(file, src, d.off, Str.concat("drive ", Str.concat(d.name, " params must be generator-friendly (at most 3; ADT or List only as the sole param)"))) else checkScenarioPublics(src, file, live, p, ctxTy, rest)

def drvGenPs(ps: List[Param], ctxTy: String): List[Param] =
  if (isCtxTy(ctxTy) && !List.isEmpty(ps) && headTy(ps) == ctxTy) List.tail(ps) else ps

def checkScenarioReplDup(src: String, file: String, p: Prog): String =
  checkScenarioReplDup2(src, file, p, dupName(sortStrs(replTargets(replFuns(p)))))

def replTargets(ds: List[Fun]): List[String] =
  if (List.isEmpty(ds)) noStr() else List.at(ds, 0).name :: replTargets(List.tail(ds))

def checkScenarioReplDup2(src: String, file: String, p: Prog, dup: String): String =
  if (dup != "") Str.concat(file, Str.concat(":1:1: error: replacement ", Str.concat(dup, " is declared more than once"))) else checkScenarioFmt(src, file, p)

def checkScenarioFmt(src: String, file: String, p: Prog): String =
  if (Parse.pretty(p) == src) "scuzz check ok" else fmtMsg(file)

def noExpr(): List[Expr] =
  []

def noParam(): List[Param] =
  []

def noBind(): List[Bind] =
  []

def rewriteReqFiles(files: List[(String, String)]): List[(String, String)] =
  rewriteReqFilesGot(files, Parse.parseFiles(files))

def rewriteReqFilesGot(files: List[(String, String)], p: Prog): List[(String, String)] =
  p match {
    case Prog(_, enums, _, _, _, _, defs, _, _) => rewriteReqGo(files, defs, enums)
  }

def rewriteReqGo(files: List[(String, String)], funs: List[Fun], ens: List[En]): List[(String, String)] =
  if (List.isEmpty(files)) files else rewriteReqHd(List.at(files, 0), List.tail(files), funs, ens)

def rewriteReqHd(h: (String, String), rest: List[(String, String)], funs: List[Fun], ens: List[En]): List[(String, String)] =
  h match {
    case (stem, src) => (stem, rewriteReqSrc(src, stem, funs, ens)) :: rewriteReqGo(rest, funs, ens)
  }

def rewriteReqSrc(src: String, stem: String, funs: List[Fun], ens: List[En]): String =
  rewriteReqKeep(src, Parse.parse(Lexer.lex(src)), stem, funs, ens)

def rewriteReqKeep(src: String, p: Prog, stem: String, funs: List[Fun], ens: List[En]): String =
  if (progHasReq(p) || progNeedsWhere(p, funs, ens)) rewriteReqProg(p, stem, funs, ens) else src

def progHasReq(p: Prog): Bool =
  p match {
    case Prog(_, _, _, _, impls, _, defs, _, body) => exprHasReq(body) || defsHaveReq(defs) || implsHaveReq(impls)
  }

def implsHaveReq(xs: List[Im]): Bool =
  if (List.isEmpty(xs)) false else imHasReq(List.at(xs, 0)) || implsHaveReq(List.tail(xs))

def imHasReq(im: Im): Bool =
  im match {
    case Im(_, _, _, methods) => defsHaveReq(methods)
  }

def progNeedsWhere(p: Prog, funs: List[Fun], ens: List[En]): Bool =
  p match {
    case Prog(_, _, _, _, impls, _, defs, _, body) => exprNeedsWhere(body, funs, ens) || defsNeedWhere(defs, funs, ens) || implsNeedWhere(impls, funs, ens)
  }

def defsNeedWhere(ds: List[Fun], funs: List[Fun], ens: List[En]): Bool =
  if (List.isEmpty(ds)) false else funNeedsWhere(List.at(ds, 0), funs, ens) || defsNeedWhere(List.tail(ds), funs, ens)

def funNeedsWhere(d: Fun, funs: List[Fun], ens: List[En]): Bool =
  d match {
    case Fun(_, _, _, _, _, body, _, _) => exprNeedsWhere(body, funs, ens)
  }

def implsNeedWhere(xs: List[Im], funs: List[Fun], ens: List[En]): Bool =
  if (List.isEmpty(xs)) false else imNeedsWhere(List.at(xs, 0), funs, ens) || implsNeedWhere(List.tail(xs), funs, ens)

def imNeedsWhere(im: Im, funs: List[Fun], ens: List[En]): Bool =
  im match {
    case Im(_, _, _, methods) => defsNeedWhere(methods, funs, ens)
  }

def exprNeedsWhere(e: Expr, funs: List[Fun], ens: List[En]): Bool =
  e match {
    case Expr.EPrint(inner, _) => exprNeedsWhere(inner, funs, ens)
    case Expr.ECall(f, args, _) => paramsHaveWhere(paramsOfCall(f, funs, ens)) || listNeedsWhere(args, funs, ens)
    case Expr.EMethod(recv, _, args, _) => exprNeedsWhere(recv, funs, ens) || listNeedsWhere(args, funs, ens)
    case Expr.EField(recv, _, _) => exprNeedsWhere(recv, funs, ens)
    case Expr.EBin(_, l, r, _) => exprNeedsWhere(l, funs, ens) || exprNeedsWhere(r, funs, ens)
    case Expr.EUn(_, inner, _) => exprNeedsWhere(inner, funs, ens)
    case Expr.ELam(_, _, body) => exprNeedsWhere(body, funs, ens)
    case Expr.EIf(c, t, el, _) => exprNeedsWhere(c, funs, ens) || exprNeedsWhere(t, funs, ens) || exprNeedsWhere(el, funs, ens)
    case Expr.EMatch(s, arms, _) => exprNeedsWhere(s, funs, ens) || armsNeedWhere(arms, funs, ens)
    case Expr.EList(xs) => listNeedsWhere(xs, funs, ens)
    case Expr.ETuple(xs) => listNeedsWhere(xs, funs, ens)
    case Expr.ENamed(_, inner) => exprNeedsWhere(inner, funs, ens)
    case Expr.EAscribe(inner, _, _) => exprNeedsWhere(inner, funs, ens)
    case Expr.EFor(bs, body, _) => bindsNeedWhere(bs, funs, ens) || exprNeedsWhere(body, funs, ens)
    case _ => false
  }

def listNeedsWhere(xs: List[Expr], funs: List[Fun], ens: List[En]): Bool =
  if (List.isEmpty(xs)) false else exprNeedsWhere(List.at(xs, 0), funs, ens) || listNeedsWhere(List.tail(xs), funs, ens)

def armsNeedWhere(xs: List[Arm], funs: List[Fun], ens: List[En]): Bool =
  if (List.isEmpty(xs)) false else armNeedsWhere(List.at(xs, 0), funs, ens) || armsNeedWhere(List.tail(xs), funs, ens)

def armNeedsWhere(a: Arm, funs: List[Fun], ens: List[En]): Bool =
  a match {
    case Arm(_, _, body) => exprNeedsWhere(body, funs, ens)
  }

def bindsNeedWhere(xs: List[Bind], funs: List[Fun], ens: List[En]): Bool =
  if (List.isEmpty(xs)) false else bindNeedsWhere(List.at(xs, 0), funs, ens) || bindsNeedWhere(List.tail(xs), funs, ens)

def bindNeedsWhere(b: Bind, funs: List[Fun], ens: List[En]): Bool =
  b match {
    case Bind(_, _, e) => exprNeedsWhere(e, funs, ens)
  }

def paramsHaveWhere(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) false else paramHasWhere(List.at(ps, 0)) || paramsHaveWhere(List.tail(ps))

def paramHasWhere(p: Param): Bool =
  p match {
    case Param(_, _, w, _) => w != ""
  }

def paramsOfCall(f: String, funs: List[Fun], ens: List[En]): List[Param] =
  paramsOfFun(Check.findFun(funs, f), f, ens)

def paramsOfFun(hit: List[Fun], f: String, ens: List[En]): List[Param] =
  if (List.isEmpty(hit)) ctorParams(ens, f) else funParams(List.at(hit, 0))

def funParams(d: Fun): List[Param] =
  d match {
    case Fun(_, _, _, ps, _, _, _, _) => ps
  }

def ctorParams(ens: List[En], f: String): List[Param] =
  if (List.isEmpty(ens)) noParam() else ctorParams1(List.at(ens, 0), List.tail(ens), f)

def ctorParams1(h: En, rest: List[En], f: String): List[Param] =
  h match {
    case En(_, name, _, cases) => if (name == f) firstCaseParams(cases) else ctorParamsCase(cases, f, rest)
  }

def firstCaseParams(cs: List[EnCase]): List[Param] =
  if (List.isEmpty(cs)) noParam() else caseParams(List.at(cs, 0))

def caseParams(c: EnCase): List[Param] =
  c match {
    case EnCase(_, fs) => fs
  }

def ctorParamsCase(cs: List[EnCase], f: String, rest: List[En]): List[Param] =
  if (List.isEmpty(cs)) ctorParams(rest, f) else ctorParamsCase1(List.at(cs, 0), List.tail(cs), f, rest)

def ctorParamsCase1(c: EnCase, restCs: List[EnCase], f: String, rest: List[En]): List[Param] =
  c match {
    case EnCase(name, fs) => if (name == f) fs else ctorParamsCase(restCs, f, rest)
  }

def defsHaveReq(ds: List[Fun]): Bool =
  if (List.isEmpty(ds)) false else funHasReq(List.at(ds, 0)) || defsHaveReq(List.tail(ds))

def funHasReq(d: Fun): Bool =
  d match {
    case Fun(_, _, _, _, _, body, _, _) => exprHasReq(body)
  }

def exprHasReq(e: Expr): Bool =
  e match {
    case Expr.EPrint(inner, _) => exprHasReq(inner)
    case Expr.ECall(_, args, _) => listHasReq(args)
    case Expr.EMethod(recv, name, args, _) => name == "require" || exprHasReq(recv) || listHasReq(args)
    case Expr.EField(recv, _, _) => exprHasReq(recv)
    case Expr.EBin(_, l, r, _) => exprHasReq(l) || exprHasReq(r)
    case Expr.EUn(_, inner, _) => exprHasReq(inner)
    case Expr.ELam(_, _, body) => exprHasReq(body)
    case Expr.EIf(c, t, el, _) => exprHasReq(c) || exprHasReq(t) || exprHasReq(el)
    case Expr.EMatch(s, arms, _) => exprHasReq(s) || armsHaveReq(arms)
    case Expr.EList(xs) => listHasReq(xs)
    case Expr.ETuple(xs) => listHasReq(xs)
    case Expr.ENamed(_, inner) => exprHasReq(inner)
    case Expr.EAscribe(inner, _, _) => exprHasReq(inner)
    case Expr.EFor(bs, body, _) => bindsHaveReq(bs) || exprHasReq(body)
    case _ => false
  }

def listHasReq(xs: List[Expr]): Bool =
  if (List.isEmpty(xs)) false else exprHasReq(List.at(xs, 0)) || listHasReq(List.tail(xs))

def armsHaveReq(xs: List[Arm]): Bool =
  if (List.isEmpty(xs)) false else armHasReq(List.at(xs, 0)) || armsHaveReq(List.tail(xs))

def armHasReq(a: Arm): Bool =
  a match {
    case Arm(_, _, body) => exprHasReq(body)
  }

def bindsHaveReq(xs: List[Bind]): Bool =
  if (List.isEmpty(xs)) false else bindHasReq(List.at(xs, 0)) || bindsHaveReq(List.tail(xs))

def bindHasReq(b: Bind): Bool =
  b match {
    case Bind(_, _, e) => exprHasReq(e)
  }

def rewriteReqProg(p: Prog, stem: String, funs: List[Fun], ens: List[En]): String =
  p match {
    case Prog(pkg, enums, aliases, traits, impls, imps, defs, main, body) => Parse.pretty(Prog(pkg, enums, aliases, traits, rewriteReqImpls(impls, funs, ens), imps, rewriteReqDefs(defs, funs, ens), main, rewriteReq(body, mainEnv(stem), funs, ens)))
  }

def mainEnv(stem: String): List[(String, String)] =
  ("#mod", stem) :: Check.noEnv()

def rewriteReqImpls(xs: List[Im], funs: List[Fun], ens: List[En]): List[Im] =
  if (List.isEmpty(xs)) xs else rewriteReqIm(List.at(xs, 0), funs, ens) :: rewriteReqImpls(List.tail(xs), funs, ens)

def rewriteReqIm(im: Im, funs: List[Fun], ens: List[En]): Im =
  im match {
    case Im(tn, targs, forTy, methods) => Im(tn, targs, forTy, rewriteReqDefs(methods, funs, ens))
  }

def rewriteReqDefs(ds: List[Fun], funs: List[Fun], ens: List[En]): List[Fun] =
  if (List.isEmpty(ds)) ds else rewriteReqFun(List.at(ds, 0), funs, ens) :: rewriteReqDefs(List.tail(ds), funs, ens)

def rewriteReqFun(d: Fun, funs: List[Fun], ens: List[En]): Fun =
  d match {
    case Fun(priv, name, tparams, params, ret, body, mod, off) => Fun(priv, name, tparams, params, ret, rewriteReq(body, Check.bindParams(params, ("self", "A") :: ("#mod", mod) :: Check.noEnv()), funs, ens), mod, off)
  }

def inferTy(e: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): String =
  inferTyGot(Check.infer(e, env, funs, ens))

def inferTyGot(o: Out): String =
  if (Check.hasErr(o)) "A" else o.ty

def rewriteReq(e: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Expr =
  e match {
    case Expr.EPrint(inner, off) => Expr.EPrint(rewriteReq(inner, env, funs, ens), off)
    case Expr.ECall(f, args, off) => wrapWhereCall(f, rewriteReqList(args, env, funs, ens), off, funs, ens)
    case Expr.EMethod(recv, name, args, off) => rewriteReqMeth(rewriteReq(recv, env, funs, ens), name, rewriteReqList(args, env, funs, ens), off, env, funs, ens)
    case Expr.EField(recv, name, off) => Expr.EField(rewriteReq(recv, env, funs, ens), name, off)
    case Expr.EBin(op, l, r, off) => Expr.EBin(op, rewriteReq(l, env, funs, ens), rewriteReq(r, env, funs, ens), off)
    case Expr.EUn(op, inner, off) => Expr.EUn(op, rewriteReq(inner, env, funs, ens), off)
    case Expr.ELam(p, ty, body) => Expr.ELam(p, ty, rewriteReq(body, Check.bindLam(p, ty, env), funs, ens))
    case Expr.EIf(c, t, el, off) => Expr.EIf(rewriteReq(c, env, funs, ens), rewriteReq(t, env, funs, ens), rewriteReq(el, env, funs, ens), off)
    case Expr.EMatch(s, arms, off) => Expr.EMatch(rewriteReq(s, env, funs, ens), rewriteReqArms(arms, env, funs, ens), off)
    case Expr.EList(xs) => Expr.EList(rewriteReqList(xs, env, funs, ens))
    case Expr.ETuple(xs) => Expr.ETuple(rewriteReqList(xs, env, funs, ens))
    case Expr.ENamed(n, inner) => Expr.ENamed(n, rewriteReq(inner, env, funs, ens))
    case Expr.EAscribe(inner, ty, off) => Expr.EAscribe(rewriteReq(inner, env, funs, ens), ty, off)
    case Expr.EFor(bs, body, off) => rewriteReqFor(bs, body, off, env, funs, ens)
    case _ => e
  }

def wrapWhereCall(f: String, args: List[Expr], off: Int, funs: List[Fun], ens: List[En]): Expr =
  wrapWhereHit(f, args, off, paramsOfCall(f, funs, ens))

def wrapWhereHit(f: String, args: List[Expr], off: Int, ps: List[Param]): Expr =
  if (!paramsHaveWhere(ps)) Expr.ECall(f, args, off) else wrapWhereAl(f, args, off, ps, Check.alignCall(ps, args))

def wrapWhereAl(f: String, args: List[Expr], off: Int, ps: List[Param], al: (List[Expr], String)): Expr =
  al match {
    case (xs, err) => if (err != "") Expr.ECall(f, args, off) else Expr.ECall(f, wrapWhereArgs(f, xs, ps), off)
  }

def wrapWhereArgs(f: String, xs: List[Expr], ps: List[Param]): List[Expr] =
  if (List.isEmpty(ps) || List.isEmpty(xs)) xs else wrapWhereArg(f, List.at(xs, 0), List.at(ps, 0)) :: wrapWhereArgs(f, List.tail(xs), List.tail(ps))

def wrapWhereArg(f: String, e: Expr, p: Param): Expr =
  p match {
    case Param(n, _, w, _) => if (w == "") e else Expr.ECall("Property.check", Expr.EStr(Str.concat(f, Str.concat(" ", w)), 0) :: Expr.ELam(n, "", Check.dfltExpr(w)) :: e :: noExpr(), 0)
  }

def rewriteReqFor(bs: List[Bind], body: Expr, off: Int, env: List[(String, String)], funs: List[Fun], ens: List[En]): Expr =
  rewriteReqForGo(bs, noBind(), env, body, off, funs, ens)

def rewriteReqForGo(bs: List[Bind], acc: List[Bind], env: List[(String, String)], body: Expr, off: Int, funs: List[Fun], ens: List[En]): Expr =
  if (List.isEmpty(bs)) Expr.EFor(List.reverse(acc), rewriteReq(body, env, funs, ens), off) else rewriteReqForHd(List.at(bs, 0), List.tail(bs), acc, env, body, off, funs, ens)

def rewriteReqForHd(b: Bind, rest: List[Bind], acc: List[Bind], env: List[(String, String)], body: Expr, off: Int, funs: List[Fun], ens: List[En]): Expr =
  b match {
    case Bind(d, name, v) => rewriteReqForVal(d, name, rewriteReq(v, env, funs, ens), rest, acc, env, body, off, funs, ens)
  }

def rewriteReqForVal(d: Bool, name: String, nv: Expr, rest: List[Bind], acc: List[Bind], env: List[(String, String)], body: Expr, off: Int, funs: List[Fun], ens: List[En]): Expr =
  rewriteReqForGo(rest, Bind(d, name, nv) :: acc, Check.bindFor(d, name, inferTy(nv, env, funs, ens), env, ens), body, off, funs, ens)

def rewriteReqMeth(recv: Expr, name: String, args: List[Expr], off: Int, env: List[(String, String)], funs: List[Fun], ens: List[En]): Expr =
  if (name == "require") rewriteRequire(recv, args, off, env, funs, ens) else Expr.EMethod(recv, name, args, off)

def rewriteRequire(recv: Expr, args: List[Expr], off: Int, env: List[(String, String)], funs: List[Fun], ens: List[En]): Expr =
  rewriteRequireTy(recv, args, off, env, funs, ens, Check.infer(recv, env, funs, ens))

def rewriteRequireTy(recv: Expr, args: List[Expr], off: Int, env: List[(String, String)], funs: List[Fun], ens: List[En], ro: Out): Expr =
  if (Check.hasErr(ro) || !Check.isIo(ro.ty)) Expr.ECall("Property.check", reqNameE(args) :: forceIoPred(reqPredE(args), env, funs, ens) :: recv :: noExpr(), off) else rewriteIoRequire(recv, reqNameE(args), reqPredE(args), off, env, funs, ens)

def forceIoPred(pred: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En]): Expr =
  forceIoPredTy(pred, Check.infer(pred, env, funs, ens))

def forceIoPredTy(pred: Expr, po: Out): Expr =
  if (!Check.hasErr(po) && Check.isIo(po.ty)) Expr.ECall("Property.force", pred :: noExpr(), 0) else pred

def rewriteIoRequire(recv: Expr, nameE: Expr, pred: Expr, off: Int, env: List[(String, String)], funs: List[Fun], ens: List[En]): Expr =
  rewriteIoPred(recv, nameE, pred, off, Check.infer(pred, env, funs, ens))

def rewriteIoPred(recv: Expr, nameE: Expr, pred: Expr, off: Int, po: Out): Expr =
  pred match {
    case Expr.ELam(_, _, _) => reqFor(recv, nameE, reqApply(pred, off), off)
    case _ => if (!Check.hasErr(po) && Check.isIo(po.ty)) reqForIoPred(recv, nameE, pred, off) else reqFor(recv, nameE, pred, off)
  }

def reqApply(pred: Expr, off: Int): Expr =
  Expr.EMethod(pred, "apply", Expr.EVar("reqv", off) :: noExpr(), off)

def reqFor(recv: Expr, nameE: Expr, pred: Expr, off: Int): Expr =
  Expr.EFor(Bind(true, "reqv", recv) :: Bind(true, "_", Expr.ECall("Property.assert", nameE :: pred :: noExpr(), off)) :: noBind(), Expr.EVar("reqv", off), off)

def reqForIoPred(recv: Expr, nameE: Expr, pred: Expr, off: Int): Expr =
  Expr.EFor(Bind(true, "reqv", recv) :: Bind(true, "reqok", pred) :: Bind(true, "_", Expr.ECall("Property.assert", nameE :: Expr.EVar("reqok", off) :: noExpr(), off)) :: noBind(), Expr.EVar("reqv", off), off)

def reqNameE(args: List[Expr]): Expr =
  if (List.len(args) < 2) Expr.EStr("require", 0) else reqNameHit(List.at(args, 0))

def reqNameHit(e: Expr): Expr =
  e match {
    case Expr.EStr(s, _) => Expr.EStr(s, 0)
    case _ => Expr.EStr("require", 0)
  }

def reqPredE(args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EBool(true) else if (List.len(args) == 1) List.at(args, 0) else List.at(List.tail(args), 0)

def rewriteReqList(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En]): List[Expr] =
  if (List.isEmpty(xs)) xs else rewriteReq(List.at(xs, 0), env, funs, ens) :: rewriteReqList(List.tail(xs), env, funs, ens)

def rewriteReqArms(xs: List[Arm], env: List[(String, String)], funs: List[Fun], ens: List[En]): List[Arm] =
  if (List.isEmpty(xs)) xs else rewriteReqArm(List.at(xs, 0), env, funs, ens) :: rewriteReqArms(List.tail(xs), env, funs, ens)

def rewriteReqArm(a: Arm, env: List[(String, String)], funs: List[Fun], ens: List[En]): Arm =
  a match {
    case Arm(pat, g, body) => Arm(pat, g, rewriteReq(body, env, funs, ens))
  }

def seeds(src: String): String =
  nls(sortStrs(mapSeed(parseVerify(src))))

def drivers(src: String): String =
  nls(mapSpec(parseVerify(src)))

def parseVerifyAllEns(srcs: List[String], ens: List[En]): List[Fun] =
  if (List.isEmpty(srcs)) noFun() else List.concat(parseVerifyEns(List.at(srcs, 0), ens), parseVerifyAllEns(List.tail(srcs), ens))

def ensOfFiles(files: List[(String, String)]): List[En] =
  if (List.isEmpty(files)) noEn() else List.concat(ensOfFile(List.at(files, 0)), ensOfFiles(List.tail(files)))

def ensOfFile(h: (String, String)): List[En] =
  h match {
    case (_, src) => ensOfProg(Parse.parse(Lexer.lex(src)))
  }

def ensOfProg(p: Prog): List[En] =
  p match {
    case Prog(_, enums, _, _, _, _, _, _, _) => enums
  }

def emptyVerify(file: String): String =
  Str.concat(file, ":1:1: error: verify file needs a Timeline => Verdict claim or a drive oracle; write a claim or delete the file")

def ioRet(d: Fun): Bool =
  Str.len(d.ret) >= 2 && Str.slice(d.ret, 0, 2) == "IO"

def ioDefNames(ds: List[Fun]): List[String] =
  if (List.isEmpty(ds)) noStr() else ioDefNamesHd(List.at(ds, 0), List.tail(ds))

def ioDefNamesHd(d: Fun, rest: List[Fun]): List[String] =
  if (ioRet(d)) d.name :: ioDefNames(rest) else ioDefNames(rest)

def oracleNames(srcs: List[String]): List[String] =
  oracleNamesEns(srcs, noEn())

def oracleNamesEns(srcs: List[String], ens: List[En]): List[String] =
  funNames(parseVerifyAllEns(srcs, ens))

def claimNames(srcs: List[String]): List[String] =
  funNames(parseClaimsAll(srcs))

def parseClaimsAll(srcs: List[String]): List[Fun] =
  if (List.isEmpty(srcs)) noFun() else List.concat(parseClaims(List.at(srcs, 0)), parseClaimsAll(List.tail(srcs)))

def funNames(ds: List[Fun]): List[String] =
  if (List.isEmpty(ds)) noStr() else funNamesHd(List.at(ds, 0), List.tail(ds))

def funNamesHd(d: Fun, rest: List[Fun]): List[String] =
  d.name :: funNames(rest)

def dupName(xs: List[String]): String =
  if (List.isEmpty(xs) || List.isEmpty(List.tail(xs))) "" else dupName2(List.at(xs, 0), List.at(xs, 1), List.tail(xs))

def dupName2(a: String, b: String, rest: List[String]): String =
  if (a == b) a else dupName(rest)

def driveCapMsg(n: Int): String =
  Str.concat("scuzz.toml:1:1: error: package declares ", Str.concat(Str.fromInt(n), " drive names; at most 32 drive names are allowed"))

def driveDupMsg(name: String): String =
  Str.concat("scuzz.toml:1:1: error: drive name ", Str.concat(name, " is declared more than once"))

def driveRule(names: List[String]): String =
  if (List.len(names) > 32) driveCapMsg(List.len(names)) else driveDupMsgGo(dupName(sortStrs(names)))

def driveDupMsgGo(dup: String): String =
  if (dup == "") "" else driveDupMsg(dup)

def intentMsg(file: String): String =
  Str.concat(file, ":1:1: error: leftover *.scuzz_intent; rename to *.scuzz_verify or delete the file")

def isBlank(s: String): Bool =
  isBlankAt(s, 0)

def isBlankAt(s: String, i: Int): Bool =
  if (i >= Str.len(s)) true else if (isWs(Str.charAt(s, i))) isBlankAt(s, i + 1) else false

def isWs(c: Int): Bool =
  c == 32 || c == 9 || c == 10 || c == 13

def firstTokOff(src: String): Int =
  firstTokOffAt(src, 0)

def firstTokOffAt(src: String, i: Int): Int =
  if (i >= Str.len(src)) 0 else if (isWs(Str.charAt(src, i))) firstTokOffAt(src, i + 1) else i

def atLoc(file: String, src: String, off: Int, msg: String): String =
  atLoc2(file, Check.locOf(src, off), msg)

def atLoc2(file: String, loc: (Int, Int, Int, Int), msg: String): String =
  loc match {
    case (line, col, _, _) => Str.concat(file, Str.concat(":", Str.concat(Str.fromInt(line), Str.concat(":", Str.concat(Str.fromInt(col), Str.concat(": error: ", msg))))))
  }

def fmtMsg(file: String): String =
  Str.concat(file, ":1:1: error: needs formatting (run scuzz fmt)")

def leftoverMsg(file: String, src: String): String =
  atLoc(file, src, firstTokOff(src), "leftover tokens after parse")

def checkVerify(src: String, file: String): String =
  checkVerifyEns(src, file, noEn())

def checkVerifyEns(src: String, file: String, ens: List[En]): String =
  if (isBlank(src)) emptyVerify(file) else checkVerifyProg(src, file, ens, Parse.parse(Lexer.lex(src)))

def checkVerifyProg(src: String, file: String, ens: List[En], p: Prog): String =
  if (List.isEmpty(p.defs) && p.main == "") leftoverMsg(file, src) else checkVerifyShape(src, file, ens, p)

def checkVerifyShape(src: String, file: String, ens: List[En], p: Prog): String =
  if (p.main != "") Str.concat(file, ":1:1: error: verify file must not define @main") else if (!List.isEmpty(p.enums)) Str.concat(file, ":1:1: error: verify file must not define enums") else if (!List.isEmpty(p.aliases)) Str.concat(file, ":1:1: error: verify file must not define aliases") else if (!List.isEmpty(p.traits)) Str.concat(file, ":1:1: error: verify file must not define traits") else if (!List.isEmpty(p.impls)) Str.concat(file, ":1:1: error: verify file must not define impls") else if (!List.isEmpty(p.imps)) Str.concat(file, ":1:1: error: verify file must not define imports") else checkVerifyBody(src, file, ens, p)

def checkVerifyBody(src: String, file: String, ens: List[En], p: Prog): String =
  if (defsHaveForbid(p.defs) || exprHasForbid(p.body)) Str.concat(file, ":1:1: error: verify bodies must not call Property.* or .require") else checkVerifyDefs(src, file, ens, p)

def checkVerifyDefs(src: String, file: String, ens: List[En], p: Prog): String =
  checkVerifyDefsGo(src, file, ens, p, p.defs)

def checkVerifyDefsGo(src: String, file: String, ens: List[En], p: Prog, ds: List[Fun]): String =
  if (List.isEmpty(ds)) checkVerifyEmpty(src, file, ens, p) else checkVerifyDefHit(src, file, ens, p, List.at(ds, 0), List.tail(ds))

def checkVerifyDefHit(src: String, file: String, ens: List[En], p: Prog, d: Fun, rest: List[Fun]): String =
  if (d.priv) checkVerifyDefsGo(src, file, ens, p, rest) else if (isDrive(d, ens)) checkVerifyDefsGo(src, file, ens, p, rest) else if (isClaim(d)) checkVerifyDefsGo(src, file, ens, p, rest) else defFail(d, file, src)

def defFail(d: Fun, file: String, src: String): String =
  if (d.ret == "Bool") atLoc(file, src, d.off, Str.concat("drive ", Str.concat(d.name, " params must be generator-friendly (at most 3; ADT or List only as the sole param)"))) else if (d.ret == "Verdict") atLoc(file, src, d.off, Str.concat("claim ", Str.concat(d.name, " must take 1 or 2 Timeline params"))) else atLoc(file, src, d.off, Str.concat("public def ", Str.concat(d.name, " is not a drive oracle or a Timeline => Verdict claim")))

def checkVerifyEmpty(src: String, file: String, ens: List[En], p: Prog): String =
  if (List.isEmpty(drives(p.defs, ens)) && List.isEmpty(claims(p.defs))) emptyVerify(file) else checkVerifyFmt(src, file, p)

def checkVerifyFmt(src: String, file: String, p: Prog): String =
  if (Parse.pretty(p) == src) "scuzz check ok" else fmtMsg(file)

def defsHaveForbid(ds: List[Fun]): Bool =
  if (List.isEmpty(ds)) false else funHasForbid(List.at(ds, 0)) || defsHaveForbid(List.tail(ds))

def funHasForbid(d: Fun): Bool =
  d match {
    case Fun(_, _, _, _, _, body, _, _) => exprHasForbid(body)
  }

def exprHasForbid(e: Expr): Bool =
  e match {
    case Expr.EPrint(inner, _) => exprHasForbid(inner)
    case Expr.ECall(f, args, _) => Str.startsWith(f, "Property.") || listHasForbid(args)
    case Expr.EMethod(recv, name, args, _) => name == "require" || exprHasForbid(recv) || listHasForbid(args)
    case Expr.EField(recv, _, _) => exprHasForbid(recv)
    case Expr.EBin(_, l, r, _) => exprHasForbid(l) || exprHasForbid(r)
    case Expr.EUn(_, inner, _) => exprHasForbid(inner)
    case Expr.ELam(_, _, body) => exprHasForbid(body)
    case Expr.EIf(c, t, el, _) => exprHasForbid(c) || exprHasForbid(t) || exprHasForbid(el)
    case Expr.EMatch(s, arms, _) => exprHasForbid(s) || armsHaveForbid(arms)
    case Expr.EList(xs) => listHasForbid(xs)
    case Expr.ETuple(xs) => listHasForbid(xs)
    case Expr.ENamed(_, inner) => exprHasForbid(inner)
    case Expr.EAscribe(inner, _, _) => exprHasForbid(inner)
    case Expr.EFor(bs, body, _) => bindsHaveForbid(bs) || exprHasForbid(body)
    case _ => false
  }

def listHasForbid(xs: List[Expr]): Bool =
  if (List.isEmpty(xs)) false else exprHasForbid(List.at(xs, 0)) || listHasForbid(List.tail(xs))

def armsHaveForbid(xs: List[Arm]): Bool =
  if (List.isEmpty(xs)) false else armHasForbid(List.at(xs, 0)) || armsHaveForbid(List.tail(xs))

def armHasForbid(a: Arm): Bool =
  a match {
    case Arm(_, _, body) => exprHasForbid(body)
  }

def bindsHaveForbid(xs: List[Bind]): Bool =
  if (List.isEmpty(xs)) false else bindHasForbid(List.at(xs, 0)) || bindsHaveForbid(List.tail(xs))

def bindHasForbid(b: Bind): Bool =
  b match {
    case Bind(_, _, e) => exprHasForbid(e)
  }

def searchN(n: Int): Int =
  if (n <= 0) 0 else n * 5 / 8

def mutateN(n: Int): Int =
  n - searchN(n)

def fuzzHead(iterations: Int, corpus: Int, sites: Int): String =
  Str.concat(if (iterations <= 0) Str.concat("scuzz fuzz: corpus-only (--iterations 0)", nl()) else "", Str.concat(if (iterations <= 0 && corpus > 0) Str.concat("scuzz fuzz: replay ", Str.concat(Str.fromInt(corpus), Str.concat(" corpus entries", nl()))) else "", if (sites == 0 && iterations > 0) Str.concat("scuzz fuzz: no live-code mutation sites", nl()) else ""))

def fuzzOut(iterations: Int, seed: Int, corpus: Int, sites: Int, failures: Int, corpFail: Int): String =
  fuzzOut2(fuzzHead(iterations, corpus, sites), searchN(iterations), seed, corpus, sites, failures, corpFail, "0", fuzzMut(sites))

def fuzzStatus(search: Int, failures: Int, seed: Int, corpus: Int): String =
  Str.concat("scuzz fuzz ", Str.concat(if (failures == 0) "ok" else "fail", Str.concat(" (", Str.concat(Str.fromInt(search), Str.concat(" search, ", Str.concat(Str.fromInt(failures), Str.concat(" search failures, seed ", Str.concat(Str.fromInt(seed), Str.concat(", ", Str.concat(Str.fromInt(corpus), " corpus)"))))))))))

def fuzzCorpus(corpus: Int, corpFail: Int, promoted: String): String =
  Str.concat("corpus: ", Str.concat(Str.fromInt(corpus), Str.concat(" stored, ", Str.concat(Str.fromInt(corpFail), Str.concat(" failed, ", Str.concat(promoted, " promoted"))))))

def fuzzMut(sites: Int): String =
  Str.concat("mutate: 0 killed, 0 survived, 0 inert (0 of ", Str.concat(Str.fromInt(sites), " sites)"))

def fuzzOut2(head: String, search: Int, seed: Int, corpus: Int, _sites: Int, failures: Int, corpFail: Int, promoted: String, mut: String): String =
  Str.concat(head, Str.concat(fuzzStatus(search, failures, seed, corpus), Str.concat(nl(), Str.concat(fuzzCorpus(corpus, corpFail, promoted), Str.concat(nl(), Str.concat("coverage: (none)", Str.concat(nl(), Str.concat("declared: (none)", Str.concat(nl(), mut)))))))))

def remEuclid(a: Int, n: Int): Int =
  if (n <= 0) 0 else remEuclid2(a % n, n)

def remEuclid2(r: Int, n: Int): Int =
  if (r < 0) r + n else r

def parseSeed(s: String): Int =
  if (s == "") 0 else Str.toInt(s, 0)

def decodeK(s: Int): Int =
  remEuclid(if (s < 0) 0 else s, 8)

def decodeRest(s: Int): Int =
  (if (s < 0) 0 else s) / 8

def decodeD(s: Int): Int =
  2 + remEuclid(decodeRest(s), 4)

def decodeRng(s: Int): Int =
  decodeRest(s) / 4

def encodeSched(rng: Int, d: Int, k: Int): Int =
  rng * 32 + (d - 2) * 8 + k

def perturbSched(base: String, s: Int): String =
  perturbSched2(parseSeed(base), s)

def perturbSched2(seed: Int, s: Int): String =
  Str.fromInt(encodeSched(decodeRng(seed) + 1 + remEuclid(s, 16), decodeD(seed), decodeK(seed)))

def mixByte(h: Int, b: Int): Int =
  remEuclid((h ^ b) * 16777619, 2147483647)

def mixStr(h: Int, s: String): Int =
  mixStrAt(h, s, 0)

def mixStrAt(h: Int, s: String, i: Int): Int =
  if (i >= Str.len(s)) h else mixStrAt(mixByte(h, Str.charAt(s, i)), s, i + 1)

def relateSeed(label: String, sched: String, script: String, n: Int): Int =
  mixByte(mixStr(mixStr(mixStr(2166136261, label), sched), script), n)

def workloadDefs(srcs: List[String], ens: List[En]): List[Fun] =
  if (List.isEmpty(srcs)) noFun() else List.concat(workloadProg(Parse.parse(Lexer.lex(List.at(srcs, 0))), ens), workloadDefs(List.tail(srcs), ens))

def workloadProg(p: Prog, ens: List[En]): List[Fun] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => workloadFuns(defs, ens, ctxTyOf(defs))
  }

def workloadFuns(ds: List[Fun], ens: List[En], ctxTy: String): List[Fun] =
  if (List.isEmpty(ds)) noFun() else workloadFun(List.at(ds, 0), List.tail(ds), ens, ctxTy)

def workloadFun(d: Fun, rest: List[Fun], ens: List[En], ctxTy: String): List[Fun] =
  if (d.name == "setup" || hasDot(d.name)) workloadFuns(rest, ens, ctxTy) else if (isDrive(d, ens) || !d.priv && Check.isIo(d.ret) && List.len(drvGenPs(d.params, ctxTy)) <= 3 && allFriendly(drvGenPs(d.params, ctxTy), ens) && unaryAdtOk(drvGenPs(d.params, ctxTy)) && allSimpleWhere(drvGenPs(d.params, ctxTy))) stripCtxFun(d, ctxTy) :: workloadFuns(rest, ens, ctxTy) else workloadFuns(rest, ens, ctxTy)

def stripCtxFun(d: Fun, ctxTy: String): Fun =
  d match {
    case Fun(priv, name, ts, ps, ret, body, mod, off) => Fun(priv, name, ts, drvGenPs(ps, ctxTy), ret, body, mod, off)
  }

def generatedDrive(ds: List[Fun], ens: List[En], seed: Int): String =
  if (List.isEmpty(ds)) "" else generatedEligible(List.at(ds, seed % List.len(ds)), ens, seed)

def generatedFun(d: Fun, ens: List[En], seed: Int): String =
  Str.concat("drive ", Str.concat(d.name, Str.concat(if (List.isEmpty(d.params)) "" else Str.concat(" ", generatedParams(d.params, ens, seed, 0, " ")), nl())))

def generatedParams(ps: List[Param], ens: List[En], seed: Int, depth: Int, sep: String): String =
  if (List.isEmpty(ps)) "" else Str.concat(generatedParam(List.at(ps, 0), ens, seed, depth), if (List.len(ps) == 1) "" else Str.concat(sep, generatedParams(List.tail(ps), ens, seed + 1, depth, sep)))

def generatedParam(p: Param, ens: List[En], seed: Int, depth: Int): String =
  if (p.ty == "Int") Str.fromInt(generatedInt(p.w, seed)) else generatedType(p.ty, ens, seed, depth)

def generatedInt(w: String, seed: Int): Int =
  if (w == "") generatedSigned(seed) else if (hasSub(w, ">=")) Str.toInt(trimNum(afterOp(w, ">=")), 0) + seed % 17 else if (hasSub(w, "<=")) Str.toInt(trimNum(afterOp(w, "<=")), 0) - seed % 17 else if (hasSub(w, ">")) Str.toInt(trimNum(afterOp(w, ">")), 0) + 1 + seed % 17 else if (hasSub(w, "<")) Str.toInt(trimNum(afterOp(w, "<")), 0) - 1 - seed % 17 else Str.toInt(trimNum(afterOp(w, "==")), 0)

def generatedType(ty: String, ens: List[En], seed: Int, depth: Int): String =
  if (ty == "Int") Str.fromInt(seed % 17) else if (ty == "Bool") generatedBool(seed) else if (ty == "String") Str.repeat("a", 1 + seed % 8) else if (isListTy(ty)) Str.concat("[", Str.concat(generatedList(listInner(ty), ens, seed, depth + 1, if (depth >= 3 || !generationType(listInner(ty), ens, depth + 1)) 0 else seed % 4), "]")) else generatedAdt(findEn(ens, tyHead(ty)), ens, seed, depth)

def generatedList(ty: String, ens: List[En], seed: Int, depth: Int, n: Int): String =
  if (n <= 0) "" else Str.concat(generatedType(ty, ens, seed, depth), if (n == 1) "" else Str.concat(",", generatedList(ty, ens, seed + 1, depth, n - 1)))

def generatedAdt(hit: List[En], ens: List[En], seed: Int, depth: Int): String =
  if (List.isEmpty(hit)) "0" else generatedEn(List.at(hit, 0), ens, seed, depth)

def generatedEn(en: En, ens: List[En], seed: Int, depth: Int): String =
  en match {
    case En(_, _, _, cases) => generatedCases(generationCases(cases, ens, depth), ens, seed, depth)
  }

def generatedCases(cases: List[EnCase], ens: List[En], seed: Int, depth: Int): String =
  if (List.isEmpty(cases)) "0" else generatedCase(List.at(cases, seed % List.len(cases)), ens, seed, depth)

def generatedCase(c: EnCase, ens: List[En], seed: Int, depth: Int): String =
  c match {
    case EnCase(name, fields) => if (List.isEmpty(fields)) name else Str.concat(name, Str.concat("(", Str.concat(generatedParams(fields, ens, seed + 1, depth + 1, ","), ")")))
  }

def varyWorkload(script: String, seed: Int): String =
  varyLines(linesOf(script), seed)

def varyLines(lines: List[String], seed: Int): String =
  if (List.isEmpty(lines)) "" else if (seed % 3 == 0) nls(List.reverse(lines)) else if (seed % 3 == 1) nls(List.concat(List.tail(lines), List.at(lines, 0) :: noStr())) else nls(List.concat(lines, List.at(lines, seed % List.len(lines)) :: noStr()))

def workloadSeed(seed: Int): Int =
  (seed % 2147483647 + 2147483647) % 2147483647

def generatedSigned(seed: Int): Int =
  if (seed % 2 == 0) 0 - seed % 17 else seed % 17

def generatedBool(seed: Int): String =
  if (seed % 2 == 0) "false" else "true"

def generatedEligible(d: Fun, ens: List[En], seed: Int): String =
  if (generationParams(d.params, ens, 0)) generatedFun(d, ens, seed) else ""

def generationParams(ps: List[Param], ens: List[En], depth: Int): Bool =
  if (List.isEmpty(ps)) true else generationParam(List.at(ps, 0), ens, depth) && generationParams(List.tail(ps), ens, depth)

def generationType(ty: String, ens: List[En], depth: Int): Bool =
  if (leafTy(ty) || isListTy(ty)) true else if (depth >= 3) false else generationEnum(findEn(ens, tyHead(ty)), ens, depth)

def generationEnum(hit: List[En], ens: List[En], depth: Int): Bool =
  if (List.isEmpty(hit)) false else generationEn(List.at(hit, 0), ens, depth)

def generationEn(en: En, ens: List[En], depth: Int): Bool =
  en match {
    case En(_, _, _, cases) => !List.isEmpty(generationCases(cases, ens, depth))
  }

def generationCases(cs: List[EnCase], ens: List[En], depth: Int): List[EnCase] =
  if (List.isEmpty(cs)) noCase() else generationCase(List.at(cs, 0), List.tail(cs), ens, depth)

def generationCase(c: EnCase, rest: List[EnCase], ens: List[En], depth: Int): List[EnCase] =
  c match {
    case EnCase(_, fs) => if (generationParams(fs, ens, depth + 1)) c :: generationCases(rest, ens, depth) else generationCases(rest, ens, depth)
  }

def generationParam(p: Param, ens: List[En], depth: Int): Bool =
  generationType(p.ty, ens, depth)

