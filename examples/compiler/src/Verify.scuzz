import Parse.Fun
import Parse.Param
import Parse.Prog
import Parse.pretty0

def nl(): String =
  """
"""

def findIdx(s: String, needle: String, i: Int): Int =
  if (Str.len(needle) == 0 || i + Str.len(needle) > Str.len(s)) 0 - 1 else if (Str.slice(s, i, i + Str.len(needle)) == needle) i else findIdx(s, needle, i + 1)

def afterOp(w: String, op: String): String =
  afterOp2(w, findIdx(w, op, 0), op)

def afterOp2(w: String, i: Int, op: String): String =
  if (i < 0) "" else Str.slice(w, i + Str.len(op), Str.len(w))

def trimNum(s: String): String =
  trimNum2(s, 0)

def trimNum2(s: String, i: Int): String =
  if (i >= Str.len(s)) s else if (Str.charAt(s, i) == 32) trimNum2(s, i + 1) else Str.slice(s, i, Str.len(s))

def noStr(): List[String] =
  []

def noFun(): List[Fun] =
  []

def kindTok(p: Param): String =
  if (p.ty == "Int") intTok(p.w) else if (p.ty == "String") "s" else if (p.ty == "Bool") "b" else ""

def intTok(w: String): String =
  if (w == "") "i" else if (findIdx(w, ">=", 0) >= 0) Str.concat("i>=", trimNum(afterOp(w, ">="))) else if (findIdx(w, "<=", 0) >= 0) Str.concat("i<=", trimNum(afterOp(w, "<="))) else if (findIdx(w, ">", 0) >= 0) Str.concat("i>", trimNum(afterOp(w, ">"))) else if (findIdx(w, "<", 0) >= 0) Str.concat("i<", trimNum(afterOp(w, "<"))) else "i"

def friendly(p: Param): Bool =
  p.ty == "Int" || p.ty == "String" || p.ty == "Bool"

def allFriendly(ps: List[Param]): Bool =
  List.isEmpty(ps) || friendly(List.head(ps)) && allFriendly(List.tail(ps))

def isDrive(d: Fun): Bool =
  d.ret == "Bool" && allFriendly(d.params)

def drives(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else drives1(List.head(ds), List.tail(ds))

def drives1(d: Fun, rest: List[Fun]): List[Fun] =
  if (isDrive(d)) d :: drives(rest) else drives(rest)

def specOf(d: Fun): String =
  if (List.isEmpty(d.params)) d.name else Str.concat(d.name, Str.concat(" ", specs(d.params)))

def specs(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) kindTok(List.head(ps)) else Str.concat(kindTok(List.head(ps)), Str.concat(" ", specs(List.tail(ps))))

def seedArg(p: Param): String =
  if (p.ty == "Int") "0" else if (p.ty == "Bool") "false" else "a"

def seedArgs(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) seedArg(List.head(ps)) else Str.concat(seedArg(List.head(ps)), Str.concat(" ", seedArgs(List.tail(ps))))

def seedOf(d: Fun): String =
  if (List.isEmpty(d.params)) Str.concat("drive ", d.name) else Str.concat("drive ", Str.concat(d.name, Str.concat(" ", seedArgs(d.params))))

def cmpStr(a: String, b: String): Int =
  cmpStr2(a, b, 0)

def cmpStr2(a: String, b: String, i: Int): Int =
  if (i >= Str.len(a) && i >= Str.len(b)) 0 else if (i >= Str.len(a)) 0 - 1 else if (i >= Str.len(b)) 1 else if (Str.charAt(a, i) < Str.charAt(b, i)) 0 - 1 else if (Str.charAt(a, i) > Str.charAt(b, i)) 1 else cmpStr2(a, b, i + 1)

def ins(x: String, ys: List[String]): List[String] =
  if (List.isEmpty(ys)) x :: noStr() else if (cmpStr(x, List.head(ys)) <= 0) x :: ys else List.head(ys) :: ins(x, List.tail(ys))

def sortStrs(xs: List[String]): List[String] =
  if (List.isEmpty(xs)) xs else ins(List.head(xs), sortStrs(List.tail(xs)))

def nls(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else Str.concat(List.head(xs), Str.concat(nl(), nls(List.tail(xs))))

def linesOf(s: String): List[String] =
  linesFrom(s, 0)

def linesFrom(s: String, start: Int): List[String] =
  if (start >= Str.len(s)) noStr() else linesFrom2(s, start, nextNl(s, start))

def nextNl(s: String, i: Int): Int =
  if (i >= Str.len(s)) i else if (Str.charAt(s, i) == 10) i else nextNl(s, i + 1)

def linesFrom2(s: String, start: Int, nl: Int): List[String] =
  if (nl >= Str.len(s)) lineRest(s, start, nl) else Str.slice(s, start, nl) :: linesFrom(s, nl + 1)

def lineRest(s: String, start: Int, i: Int): List[String] =
  if (start >= i) noStr() else Str.slice(s, start, i) :: noStr()

def eventsKey(): String =
  "events = ["

def parseEvents(src: String): List[String] =
  parseEventsAt(src, findIdx(src, eventsKey(), 0))

def parseEventsAt(src: String, i: Int): List[String] =
  if (i < 0) noStr() else parseEvSkip(src, i + Str.len(eventsKey()))

def parseEvSkip(src: String, i: Int): List[String] =
  if (i >= Str.len(src)) noStr() else parseEvCh(src, i, Str.charAt(src, i))

def parseEvCh(src: String, i: Int, c: Int): List[String] =
  if (c == 32 || c == 10 || c == 13 || c == 9 || c == 44) parseEvSkip(src, i + 1) else if (c == 93) noStr() else if (c == 34) parseEvStr(src, i + 1, i + 1) else parseEvSkip(src, i + 1)

def parseEvStr(src: String, start: Int, i: Int): List[String] =
  if (i >= Str.len(src)) noStr() else if (Str.charAt(src, i) == 34) Str.slice(src, start, i) :: parseEvSkip(src, i + 1) else parseEvStr(src, start, i + 1)

def tomlQuoted(src: String, key: String): String =
  tomlQuotedAt(src, findIdx(src, Str.concat(key, " = \""), 0), Str.len(key) + 4)

def tomlQuotedAt(src: String, i: Int, skip: Int): String =
  if (i < 0) "" else tomlQuotedEnd(src, i + skip, i + skip)

def tomlQuotedEnd(src: String, start: Int, i: Int): String =
  if (i >= Str.len(src) || Str.charAt(src, i) == 34) Str.slice(src, start, i) else tomlQuotedEnd(src, start, i + 1)

def quoteEvents(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else if (List.isEmpty(List.tail(xs))) quoteEv(List.head(xs)) else Str.concat(quoteEv(List.head(xs)), Str.concat(", ", quoteEvents(List.tail(xs))))

def quoteEv(e: String): String =
  Str.concat("\"", Str.concat(e, "\""))

def reproText(seed: Int, sched: String, fault: String, events: List[String]): String =
  Str.concat("[fuzz]\nseed = ", Str.concat(Str.fromInt(seed), Str.concat(reproSched(sched), Str.concat(reproFault(fault), Str.concat("events = [", Str.concat(quoteEvents(events), "]\n"))))))

def reproSched(sched: String): String =
  if (sched == "") "\n" else Str.concat("\nschedule_seed = \"", Str.concat(sched, "\"\n"))

def reproFault(fault: String): String =
  if (fault == "") "" else Str.concat("fault_seed = \"", Str.concat(fault, "\"\n"))

def summaryToml(ok: Bool, seed: Int, iterations: Int, search: Int, failures: Int, corpus: Int, corpFail: Int, repro: String): String =
  Str.concat(summaryFuzz(ok, seed, iterations, search, failures, corpus, repro), summaryRest(corpus, corpFail))

def summaryFuzz(ok: Bool, seed: Int, iterations: Int, search: Int, failures: Int, corpus: Int, repro: String): String =
  Str.concat("[fuzz]\nok = ", Str.concat(if (ok) "true" else "false", Str.concat("\nseed = ", Str.concat(Str.fromInt(seed), Str.concat("\niterations = ", Str.concat(Str.fromInt(iterations), Str.concat("\nsearch = ", Str.concat(Str.fromInt(search), Str.concat("\nsearch_failures = ", Str.concat(Str.fromInt(failures), Str.concat("\ncorpus = ", Str.concat(Str.fromInt(corpus), Str.concat("\ndrivers = []\nevents = []\ndeclared = []\nreachability = []\nmissing_budget = []\nmissing_corpus = []\nrepro = \"", Str.concat(repro, "\"\nreplay = \"\"\n\n"))))))))))))))

def summaryRest(corpus: Int, corpFail: Int): String =
  Str.concat("[coverage]\nunclaimed_varied = []\n\n[corpus]\nentries = ", Str.concat(Str.fromInt(corpus), Str.concat("\nfailures = ", Str.concat(Str.fromInt(corpFail), "\nreached = []\npromoted = 0\n\n[classify]\n[mutate]\nkilled = 0\nsurvived = 0\ninert = 0\nran = 0\nsites = 0\noracles = 0\nscore = 1.000\nsurvivors = []\n"))))

def mapSeed(ds: List[Fun]): List[String] =
  if (List.isEmpty(ds)) noStr() else seedOf(List.head(ds)) :: mapSeed(List.tail(ds))

def mapSpec(ds: List[Fun]): List[String] =
  if (List.isEmpty(ds)) noStr() else specOf(List.head(ds)) :: mapSpec(List.tail(ds))

def parseVerify(src: String): List[Fun] =
  parseVerifyProg(Parse.parse(Lexer.lex(src)))

def parseVerifyProg(p: Prog): List[Fun] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => drives(defs)
  }

def wrapMod(): String =
  "__verify"

def wrapSrc(stem: String, src: String): String =
  wrapFuns(stem, parseVerify(src))

def wrapFuns(stem: String, ds: List[Fun]): String =
  if (List.isEmpty(ds)) "" else Str.concat(wrapFun(stem, List.head(ds)), wrapFuns(stem, List.tail(ds)))

def wrapFun(stem: String, d: Fun): String =
  d match {
    case Fun(_, name, _, ps, _, body, _) => wrapFun2(name, wrapPs(ps), pretty0(body))
  }

def wrapFun2(name: String, ps: String, body: String): String =
  Str.concat("def _drv_", Str.concat(name, Str.concat("(", Str.concat(ps, Str.concat("): IO[Unit] =\n  Property.assert(\"", Str.concat(name, Str.concat("\", ", Str.concat(body, ")\n"))))))))

def wrapPs(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) wrapP(List.head(ps)) else Str.concat(wrapP(List.head(ps)), Str.concat(", ", wrapPs(List.tail(ps))))

def wrapP(p: Param): String =
  p match {
    case Param(n, ty, _, _) => Str.concat(n, Str.concat(": ", ty))
  }

def wrapFiles(files: List[(String, String)]): String =
  if (List.isEmpty(files)) "" else wrapFiles2(List.head(files), List.tail(files))

def wrapFiles2(h: (String, String), rest: List[(String, String)]): String =
  h match {
    case (stem, src) => Str.concat(wrapSrc(stem, src), wrapFiles(rest))
  }

def seeds(src: String): String =
  nls(sortStrs(mapSeed(parseVerify(src))))

def drivers(src: String): String =
  nls(mapSpec(parseVerify(src)))

def emptyVerify(file: String): String =
  Str.concat(file, Str.concat(":1:1: error: ", Str.concat(file, ": verify file needs a Timeline => Verdict claim or a drive oracle; write a claim or delete the file")))

def checkVerify(src: String, file: String): String =
  if (List.isEmpty(parseVerify(src))) emptyVerify(file) else "scuzz check ok"

def testOut(checkOk: Bool): String =
  if (!checkOk) "scuzz test fail" else Str.concat("project compile smoke ok", Str.concat(nl(), Str.concat("IO smoke ok", Str.concat(nl(), "scuzz test ok"))))

def searchN(n: Int): Int =
  if (n <= 0) 0 else n * 5 / 8

def fuzzHead(iterations: Int, corpus: Int, sites: Int): String =
  Str.concat(if (iterations <= 0) Str.concat("scuzz fuzz: corpus-only (--iterations 0)", nl()) else "", Str.concat(if (iterations <= 0 && corpus > 0) Str.concat("scuzz fuzz: replay ", Str.concat(Str.fromInt(corpus), Str.concat(" corpus entries", nl()))) else "", if (sites == 0) Str.concat("scuzz fuzz: no live-code mutation sites", nl()) else ""))

def fuzzOut(iterations: Int, seed: Int, corpus: Int, sites: Int, failures: Int, corpFail: Int): String =
  fuzzOut2(fuzzHead(iterations, corpus, sites), searchN(iterations), seed, corpus, sites, failures, corpFail)

def fuzzStatus(search: Int, failures: Int, seed: Int, corpus: Int): String =
  Str.concat("scuzz fuzz ", Str.concat(if (failures == 0) "ok" else "fail", Str.concat(" (", Str.concat(Str.fromInt(search), Str.concat(" search, ", Str.concat(Str.fromInt(failures), Str.concat(" search failures, seed ", Str.concat(Str.fromInt(seed), Str.concat(", ", Str.concat(Str.fromInt(corpus), " corpus)"))))))))))

def fuzzCorpus(corpus: Int, corpFail: Int): String =
  Str.concat("corpus: ", Str.concat(Str.fromInt(corpus), Str.concat(" stored, ", Str.concat(Str.fromInt(corpFail), " failed, 0 promoted"))))

def fuzzMut(sites: Int): String =
  Str.concat("mutate: 0 killed, 0 survived, 0 inert (0 of ", Str.concat(Str.fromInt(sites), " sites)"))

def fuzzOut2(head: String, search: Int, seed: Int, corpus: Int, sites: Int, failures: Int, corpFail: Int): String =
  Str.concat(head, Str.concat(fuzzStatus(search, failures, seed, corpus), Str.concat(nl(), Str.concat(fuzzCorpus(corpus, corpFail), Str.concat(nl(), Str.concat("coverage: (none)", Str.concat(nl(), Str.concat("declared: (none)", Str.concat(nl(), fuzzMut(sites))))))))))

