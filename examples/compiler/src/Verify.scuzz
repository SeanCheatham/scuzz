survived = """, Str.concat(Str.fromInt(survived), Str.concat("""
inert = """, Str.concat(Str.fromInt(inert), Str.concat("""
ran = """, Str.concat(Str.fromInt(ran), Str.concat("""
sites = """, Str.concat(Str.fromInt(sites), Str.concat("""
oracles = """, Str.concat(if (oracles) "true" else "false", """
score = 1.000
