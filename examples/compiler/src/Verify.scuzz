record Workload(label: String, required: Bool, script: String, schedule: String, fault: String, picks: List[String], engine: String, status: String, reason: String)

record InputScope(planned: Int, workloads: List[Workload], mutantExcluded: List[Int], inputs: List[String], claims: List[String], checkedClaims: List[String])

record Breadth(varied: List[String], signalInt: List[String], signalListLen: List[String], signalStrHas: List[String], a11yHas: List[String], lastHitHas: List[String], driveHas: List[String], effectHas: List[String], fileTextIs: List[String], fileSame: List[String], unclaimed: List[String])

record MutSurvivor(site: Int, kind: String, file: String, line: Int, column: Int, endLine: Int, endColumn: Int, divergedWorkloads: List[String], passedClaims: List[String])

record RuleSite(key: String, rejKind: String, kind: String, rule: String, file: String, line: Int, column: Int, endLine: Int, endColumn: Int)

record RuleFailure(kind: String, rule: String, file: String, line: Int, column: Int, endLine: Int, endColumn: Int, workload: String, repro: String, events: List[String])

record IBound(lo: Int, hi: Int, onLo: Bool, onHi: Bool, eq: Int, onEq: Bool, ok: Bool)

record RuleEntry(siteKey: String, rejKind: String, rule: String, forced: Bool)

record ReqStep(expr: Expr, next: Int)

record ReqListStep(exprs: List[Expr], next: Int)

record ReqArmsStep(arms: List[Arm], next: Int)

record ReqArmStep(arm: Arm, next: Int)

record TagHitStep(hit: Bool, next: Int)

record RuleKeyStep(entries: List[RuleEntry], next: Int)

record SiteWalk(sites: List[RuleSite], next: Int, reqOffs: List[Int])

record RewriteCtx(ftab: Ftab, funs: List[Fun], ens: List[En], wn: Set[String], ambig: Set[String])

import Parse.Fun
import Parse.Param
import Parse.Prog
import Parse.Expr
import Parse.Arm
import Parse.Bind
import Parse.En
import Parse.EnCase
import Parse.Im
import Parse.Alias
import Parse.pretty
import Lexer.Tok
import Lexer.SpTok
import Check.Out
import Check.Ftab
import Check.LineIndex
import Type.Ty

def nl(): String =
  """
"""

def findIdx(s: String, needle: String, i: Int): Int =
  if (Str.len(needle) == 0 || i + Str.len(needle) > Str.len(s)) 0 - 1 else if (Str.slice(s, i, i + Str.len(needle)) == needle) i else findIdx(s, needle, i + 1)

def noStr(): List[String] =
  []

def noFun(): List[Fun] =
  []

def noEn(): List[En] =
  []

def kindTokE(p: Param, ens: List[En]): String =
  if (p.ty == "Int") intTok(p.name, p.w) else if (p.ty == "String") "s" else if (p.ty == "Bool") "b" else if (isListTy(p.ty)) listTok(p.ty, ens, 0) else adtTok(p.ty, ens, 0)

def isListTy(t: String): Bool =
  Str.len(t) > 6 && Str.slice(t, 0, 5) == "List[" && Str.charAt(t, Str.len(t) - 1) == 93

def listInner(t: String): String =
  Str.slice(t, 5, Str.len(t) - 1)

def listTok(t: String, ens: List[En], depth: Int): String =
  Str.concat("[", Str.concat(typeTok(listInner(t), ens, depth + 1), "]"))

def typeTok(t: String, ens: List[En], depth: Int): String =
  if (t == "Int") "i" else if (t == "String") "s" else if (t == "Bool") "b" else if (isListTy(t)) listTok(t, ens, depth) else adtTok(t, ens, depth)

def adtTok(ty: String, ens: List[En], depth: Int): String =
  adtTokHit(findEnTy(ens, ty), ty, ens, depth)

def tyHead(t: String): String =
  tyHeadAt(t, 0)

def tyHeadAt(t: String, i: Int): String =
  if (i >= Str.len(t)) t else if (Str.charAt(t, i) == 91) Str.slice(t, 0, i) else tyHeadAt(t, i + 1)

def findEn(ens: List[En], name: String): List[En] =
  findEnResolved(ens, Resolve.typeName(Resolve.scopeEnums(ens), name))

def findEnResolved(ens: List[En], name: String): List[En] =
  List.filter(ens, en => en.name == name)

def findEnTy(ens: List[En], ty: String): List[En] =
  List.map(findEn(ens, tyHead(ty)), en => Check.specializeEnum(en, Type.show(if (List.isEmpty(Type.appArgs(Type.parse(ty)))) Type.tNamed(en.name) else Type.tApp(en.name, Type.appArgs(Type.parse(ty))))))

def adtTokHit(hit: List[En], ty: String, ens: List[En], depth: Int): String =
  if (List.isEmpty(hit)) ty else adtTokEn(List.at(hit, 0), ens, depth)

def adtTokEn(e: En, ens: List[En], depth: Int): String =
  e match {
    case En(isRec, name, _, cases) => if (isRec || recLike(name, cases)) recTok(name, cases, ens, depth) else enumTok(cases, ens, depth)
  }

def recLike(name: String, cs: List[EnCase]): Bool =
  List.len(cs) == 1 && recLikeName(List.at(cs, 0), name)

def recLikeName(c: EnCase, name: String): Bool =
  c match {
    case EnCase(n, _) => n == name
  }

def recTok(name: String, cs: List[EnCase], ens: List[En], depth: Int): String =
  Str.concat(Resolve.short(name), Str.concat("(", Str.concat(caseFields(List.at(cs, 0), ens, depth), ")")))

def caseFields(c: EnCase, ens: List[En], depth: Int): String =
  c match {
    case EnCase(_, fs) => fieldToks(fs, ens, depth)
  }

def fieldToks(fs: List[Param], ens: List[En], depth: Int): String =
  if (List.isEmpty(fs)) "" else if (List.len(fs) == 1) fieldTok(List.at(fs, 0), ens, depth) else Str.concat(fieldTok(List.at(fs, 0), ens, depth), Str.concat(",", fieldToks(List.tail(fs), ens, depth)))

def fieldTok(p: Param, ens: List[En], depth: Int): String =
  if (p.ty == "Int") intTok(p.name, p.w) else typeTok(p.ty, ens, depth + 1)

def enumTok(cs: List[EnCase], ens: List[En], depth: Int): String =
  Str.concat("e:", enumCases(if (depth >= 3) leafCases(cs) else cs, ens, depth))

def leafCases(cs: List[EnCase]): List[EnCase] =
  if (List.isEmpty(cs)) noCase() else leafCases1(List.at(cs, 0), List.tail(cs))

def leafCases1(c: EnCase, rest: List[EnCase]): List[EnCase] =
  if (isLeafCase(c)) c :: leafCases(rest) else leafCases(rest)

def isLeafCase(c: EnCase): Bool =
  c match {
    case EnCase(_, fs) => allLeaf(fs)
  }

def allLeaf(fs: List[Param]): Bool =
  if (List.isEmpty(fs)) true else allLeafGo(List.at(fs, 0), List.tail(fs))

def allLeafGo(h: Param, rest: List[Param]): Bool =
  h match {
    case Param(_, ty, _, _) => leafTy(ty) && allLeaf(rest)
  }

def leafTy(t: String): Bool =
  t == "Int" || t == "String" || t == "Bool"

def enumCases(cs: List[EnCase], ens: List[En], depth: Int): String =
  if (List.isEmpty(cs)) "" else if (List.len(cs) == 1) caseTok(List.at(cs, 0), ens, depth) else Str.concat(caseTok(List.at(cs, 0), ens, depth), Str.concat("|", enumCases(List.tail(cs), ens, depth)))

def caseTok(c: EnCase, ens: List[En], depth: Int): String =
  c match {
    case EnCase(name, fs) => if (List.isEmpty(fs)) name else Str.concat(name, Str.concat("(", Str.concat(fieldToks(fs, ens, depth), ")")))
  }

def noCase(): List[EnCase] =
  []

def intTok(name: String, w: String): String =
  intTokB(whereBounds(name, w))

def intTokB(b: IBound): String =
  if (!b.ok || !b.onLo && !b.onHi && !b.onEq) "i" else if (b.onEq) Str.concat("i==", Str.fromInt(b.eq)) else Str.concat(if (b.onLo) Str.concat("i>=", Str.fromInt(b.lo)) else "", if (b.onHi) Str.concat(if (b.onLo) "&&i" else "i", Str.concat("<=", Str.fromInt(b.hi))) else "")

def friendly(p: Param, ens: List[En]): Bool =
  friendlyTy(p.ty, ens)

def friendlyTy(t: String, ens: List[En]): Bool =
  if (t == "Int" || t == "String" || t == "Bool" || t == "View") true else if (isListTy(t)) friendlyTy(listInner(t), ens) else if (opaqueTy(tyHead(t))) false else if (t == "" || t == "Unit" || t == "Any" || t == "Float" || t == "Timeline" || t == "Verdict") false else if (Str.startsWith(t, "IO")) false else if (hasSub(t, "=>")) false else !List.isEmpty(findEn(ens, tyHead(t))) && !unsupportedDriveTy(t, ens, 0)

def unsupportedDriveTy(t: String, ens: List[En], depth: Int): Bool =
  if (t == "Float") true else if (t == "Int" || t == "String" || t == "Bool") false else if (depth >= 8) true else if (isListTy(t)) unsupportedDriveTy(listInner(t), ens, depth + 1) else unsupportedDriveEn(findEnTy(ens, t), ens, depth)

def unsupportedDriveEn(hit: List[En], ens: List[En], depth: Int): Bool =
  if (List.isEmpty(hit)) false else List.at(hit, 0).privateCtor || unsupportedDriveEnCases(List.at(hit, 0), ens, depth)

def unsupportedDriveEnCases(en: En, ens: List[En], depth: Int): Bool =
  en match {
    case En(isRec, name, _, cases) => unsupportedDriveCases(if (depth >= 3 && !isRec && !recLike(name, cases)) leafCases(cases) else cases, ens, depth)
  }

def unsupportedDriveCases(cases: List[EnCase], ens: List[En], depth: Int): Bool =
  if (List.isEmpty(cases)) false else unsupportedDriveCase(List.at(cases, 0), ens, depth) || unsupportedDriveCases(List.tail(cases), ens, depth)

def unsupportedDriveCase(c: EnCase, ens: List[En], depth: Int): Bool =
  c match {
    case EnCase(_, fields) => unsupportedDriveFields(fields, ens, depth)
  }

def unsupportedDriveFields(fields: List[Param], ens: List[En], depth: Int): Bool =
  if (List.isEmpty(fields)) false else unsupportedDriveTy(List.at(fields, 0).ty, ens, depth + 1) || unsupportedDriveFields(List.tail(fields), ens, depth)

def opaqueTy(t: String): Bool =
  t == "Fiber" || t == "Ref" || t == "Queue" || t == "Deferred" || t == "Resource" || t == "Stream" || t == "Map" || t == "Set"

def hasSub(s: String, n: String): Bool =
  findIdx(s, n, 0) >= 0

def allFriendly(ps: List[Param], ens: List[En]): Bool =
  List.isEmpty(ps) || friendly(List.at(ps, 0), ens) && allFriendly(List.tail(ps), ens)

def isAdtOrList(p: Param): Bool =
  isListTy(p.ty) || !(p.ty == "Int" || p.ty == "String" || p.ty == "Bool")

def hasAdtOrList(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) false else isAdtOrList(List.at(ps, 0)) || hasAdtOrList(List.tail(ps))

def unaryAdtOk(ps: List[Param]): Bool =
  List.len(ps) <= 1 || !hasAdtOrList(ps)

def simpleWhere(name: String, w: String): Bool =
  whereBounds(name, w).ok

def allSimpleWhere(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) true else allSimpleWhere1(List.at(ps, 0), List.tail(ps))

def allSimpleWhere1(p: Param, rest: List[Param]): Bool =
  p match {
    case Param(n, _, w, _) => simpleWhere(n, w) && allSimpleWhere(rest)
  }

def isDrive(d: Fun, ens: List[En]): Bool =
  !d.priv && d.ora && d.ret == "Bool" && List.len(d.params) <= 3 && allFriendly(d.params, ens) && unaryAdtOk(d.params) && allSimpleWhere(d.params)

def isClaim(d: Fun): Bool =
  !d.priv && d.ret == "Verdict" && claimPs(d.params)

def claimPs(ps: List[Param]): Bool =
  (List.len(ps) == 1 || List.len(ps) == 2) && allTimeline(ps)

def allTimeline(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) true else allTimeline1(List.at(ps, 0), List.tail(ps))

def allTimeline1(p: Param, rest: List[Param]): Bool =
  p match {
    case Param(_, ty, _, _) => ty == "Timeline" && allTimeline(rest)
  }

def drives(ds: List[Fun], ens: List[En]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else drives1(List.at(ds, 0), List.tail(ds), ens)

def drives1(d: Fun, rest: List[Fun], ens: List[En]): List[Fun] =
  if (isDrive(d, ens)) d :: drives(rest, ens) else drives(rest, ens)

def specOfE(d: Fun, ens: List[En]): String =
  if (List.isEmpty(d.params)) d.name else Str.concat(d.name, Str.concat(" ", specs(d.params, ens)))

def specs(ps: List[Param], ens: List[En]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) kindTokE(List.at(ps, 0), ens) else Str.concat(kindTokE(List.at(ps, 0), ens), Str.concat(" ", specs(List.tail(ps), ens)))

def cmpStr(a: String, b: String): Int =
  cmpStr2(a, b, 0)

def cmpStr2(a: String, b: String, i: Int): Int =
  if (i >= Str.len(a) && i >= Str.len(b)) 0 else if (i >= Str.len(a)) 0 - 1 else if (i >= Str.len(b)) 1 else if (Str.charAt(a, i) < Str.charAt(b, i)) 0 - 1 else if (Str.charAt(a, i) > Str.charAt(b, i)) 1 else cmpStr2(a, b, i + 1)

def ins(x: String, ys: List[String]): List[String] =
  if (List.isEmpty(ys)) x :: noStr() else if (cmpStr(x, List.at(ys, 0)) <= 0) x :: ys else List.at(ys, 0) :: ins(x, List.tail(ys))

def sortStrs(xs: List[String]): List[String] =
  if (List.isEmpty(xs)) xs else ins(List.at(xs, 0), sortStrs(List.tail(xs)))

def nls(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else Str.concat(List.at(xs, 0), Str.concat(nl(), nls(List.tail(xs))))

def linesOf(s: String): List[String] =
  linesFrom(s, 0)

def linesFrom(s: String, start: Int): List[String] =
  if (start >= Str.len(s)) noStr() else linesFrom2(s, start, nextNl(s, start))

def nextNl(s: String, i: Int): Int =
  if (i >= Str.len(s)) i else if (Str.charAt(s, i) == 10) i else nextNl(s, i + 1)

def linesFrom2(s: String, start: Int, nl: Int): List[String] =
  if (nl >= Str.len(s)) lineRest(s, start, nl) else Str.slice(s, start, nl) :: linesFrom(s, nl + 1)

def lineRest(s: String, start: Int, i: Int): List[String] =
  if (start >= i) noStr() else Str.slice(s, start, i) :: noStr()

def parseEvents(src: String): List[String] =
  parseStrArr(src, "events")

def parseStrArr(src: String, key: String): List[String] =
  parseStrArrAt(src, tomlFieldAt(src, key, 0))

def tomlFieldAt(src: String, key: String, start: Int): Int =
  if (start >= Str.len(src)) -1 else tomlFieldLine(src, key, start, nextNl(src, start))

def tomlFieldLine(src: String, key: String, start: Int, end: Int): Int =
  for {
    line = Str.slice(src, start, end)
    eq = Manifest.findEq(line, 0)
  } yield if (eq >= 0 && Str.trim(Str.take(line, eq)) == key) tomlSpace(src, start + eq + 1) else tomlFieldAt(src, key, end + 1)

def tomlSpace(src: String, i: Int): Int =
  if (i >= Str.len(src)) i else if (Str.charAt(src, i) == 32 || Str.charAt(src, i) == 9 || Str.charAt(src, i) == 10 || Str.charAt(src, i) == 13) tomlSpace(src, i + 1) else i

def parseStrArrAt(src: String, i: Int): List[String] =
  if (i < 0 || i >= Str.len(src) || Str.charAt(src, i) != 91) noStr() else parseEvSkip(src, i + 1)

def parseEvSkip(src: String, i: Int): List[String] =
  if (i >= Str.len(src)) noStr() else parseEvCh(src, i, Str.charAt(src, i))

def parseEvCh(src: String, i: Int, c: Int): List[String] =
  if (c == 32 || c == 10 || c == 13 || c == 9 || c == 44) parseEvSkip(src, i + 1) else if (c == 35) parseEvSkip(src, nextNl(src, i)) else if (c == 93) noStr() else if (c == 34) parseEvStr(src, i + 1, Builder.empty()) else parseEvSkip(src, i + 1)

def parseEvStr(src: String, i: Int, b: Builder): List[String] =
  if (i >= Str.len(src)) noStr() else parseEvStrCh(src, i, Str.charAt(src, i), b)

def parseEvStrCh(src: String, i: Int, c: Int, b: Builder): List[String] =
  if (c == 92) parseEvEsc(src, i + 1, b) else if (c == 34) Builder.result(b) :: parseEvSkip(src, i + 1) else parseEvStr(src, i + 1, Builder.append(b, Str.slice(src, i, i + 1)))

def parseEvEsc(src: String, i: Int, b: Builder): List[String] =
  if (i >= Str.len(src)) Builder.result(b) :: noStr() else parseEvStr(src, i + 1, Builder.append(b, Str.slice(src, i, i + 1)))

def tomlQuoted(src: String, key: String): String =
  tomlQuotedAt(src, tomlFieldAt(src, key, 0))

def tomlQuotedAt(src: String, i: Int): String =
  if (i < 0 || i >= Str.len(src) || Str.charAt(src, i) != 34) "" else tomlQuotedEnd(src, i + 1, i + 1)

def tomlQuotedEnd(src: String, start: Int, i: Int): String =
  if (i >= Str.len(src) || Str.charAt(src, i) == 34) Str.slice(src, start, i) else tomlQuotedEnd(src, start, i + 1)

def quoteEvents(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else if (List.isEmpty(List.tail(xs))) quoteEv(List.at(xs, 0)) else Str.concat(quoteEv(List.at(xs, 0)), Str.concat(", ", quoteEvents(List.tail(xs))))

def quoteEv(e: String): String =
  Str.concat("\"", Str.concat(escEv(e, 0, Builder.empty()), "\""))

def escEv(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else escEv(s, i + 1, Builder.append(b, escEvCh(Str.charAt(s, i), s, i)))

def escEvCh(c: Int, s: String, i: Int): String =
  if (c == 92) "\\\\" else if (c == 34) "\\\"" else Str.slice(s, i, i + 1)

def reproText(sched: String, fault: String, picks: List[String], events: List[String]): String =
  Str.concat("""[fuzz]
""", Str.concat(reproOracle(events), Str.concat(reproSched(sched), Str.concat(reproPicks(picks), Str.concat(reproFault(fault), Str.concat("events = [", Str.concat(quoteEvents(events), """]
""")))))))

def reproPicks(picks: List[String]): String =
  if (List.isEmpty(picks)) "" else Str.concat("schedule_picks = [", Str.concat(quoteEvents(picks), """]
"""))

def reproOracle(events: List[String]): String =
  if (oracleName(events) == "") "" else Str.concat("oracle = \"", Str.concat(oracleName(events), "\"\n"))

def oracleName(events: List[String]): String =
  if (List.isEmpty(events)) "" else oracleNameLine(List.at(events, 0), List.tail(events))

def scriptToks(line: String): List[String] =
  scriptToksGo(line, 0, Builder.empty(), noStr(), false)

def scriptToksGo(line: String, i: Int, cur: Builder, acc: List[String], q: Bool): List[String] =
  if (i >= Str.len(line)) scriptToksFin(cur, acc) else scriptToksCh(line, i, Str.charAt(line, i), cur, acc, q)

def scriptToksFin(cur: Builder, acc: List[String]): List[String] =
  if (Builder.result(cur) == "") acc else List.concat(acc, Builder.result(cur) :: noStr())

def scriptToksCh(line: String, i: Int, c: Int, cur: Builder, acc: List[String], q: Bool): List[String] =
  if (c == 32 && !q) scriptToksGo(line, i + 1, Builder.empty(), scriptToksFin(cur, acc), false) else if (c == 92 && q) scriptToksEsc(line, i, cur, acc, q) else if (c == 34) scriptToksGo(line, i + 1, Builder.append(cur, Str.slice(line, i, i + 1)), acc, !q) else scriptToksGo(line, i + 1, Builder.append(cur, Str.slice(line, i, i + 1)), acc, q)

def scriptToksEsc(line: String, i: Int, cur: Builder, acc: List[String], q: Bool): List[String] =
  if (i + 1 >= Str.len(line)) scriptToksGo(line, i + 1, Builder.append(cur, Str.slice(line, i, i + 1)), acc, q) else scriptToksGo(line, i + 2, Builder.append(cur, Str.slice(line, i, i + 2)), acc, q)

def quoteTok(s: String): String =
  Str.concat("\"", Str.concat(quoteTokGo(s, 0, Builder.empty()), "\""))

def quoteTokGo(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else quoteTokGo(s, i + 1, Builder.append(b, quoteTokCh(Str.charAt(s, i), s, i)))

def quoteTokCh(c: Int, s: String, i: Int): String =
  if (c == 92) "\\\\" else if (c == 34) "\\\"" else if (c == 10) "\\n" else if (c == 9) "\\t" else if (c == 13) "\\r" else Str.slice(s, i, i + 1)

def unquoteTok(tok: String): String =
  if (Str.len(tok) < 2 || Str.charAt(tok, 0) != 34) tok else unquoteTokGo(tok, 1, Builder.empty())

def unquoteTokGo(tok: String, i: Int, b: Builder): String =
  if (i >= Str.len(tok) - 1) Builder.result(b) else unquoteTokCh(tok, i, Str.charAt(tok, i), b)

def unquoteTokCh(tok: String, i: Int, c: Int, b: Builder): String =
  if (c == 92) unquoteTokEsc(tok, i + 1, b) else unquoteTokGo(tok, i + 1, Builder.append(b, Str.slice(tok, i, i + 1)))

def unquoteTokEsc(tok: String, i: Int, b: Builder): String =
  if (i >= Str.len(tok) - 1) unquoteTokGo(tok, i, Builder.append(b, "\\")) else unquoteTokGo(tok, i + 1, Builder.append(b, unquoteEscCh(Str.charAt(tok, i), tok, i)))

def unquoteEscCh(c: Int, s: String, i: Int): String =
  if (c == 110) """
""" else if (c == 116) "\t" else if (c == 114) "r" else if (c == 34) "\"" else if (c == 92) "\\" else Str.concat("\\", Str.slice(s, i, i + 1))

def oracleNameLine(line: String, rest: List[String]): String =
  if (Str.startsWith(line, "drive ")) oracleDrive(line) else oracleName(rest)

def oracleDrive(line: String): String =
  if (List.len(Str.split(line, " ")) < 2) "" else List.at(Str.split(line, " "), 1)

def withOracle(src: String, events: List[String]): String =
  if (oracleName(events) == "" || Str.contains(src, "oracle =")) src else insertOracle(src, oracleName(events))

def scriptJson(script: String): String =
  Str.concat("{\"v\":1,\"kind\":\"inject\",\"events\":[", Str.concat(jJoin(jEvents(linesOf(script))), "]}"))

def jEvents(xs: List[String]): List[String] =
  List.filter(List.map(xs, l => jLine(l)), e => e != "")

def jJoin(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else if (List.isEmpty(List.tail(xs))) List.at(xs, 0) else Str.concat(List.at(xs, 0), Str.concat(",", jJoin(List.tail(xs))))

def jLine(line: String): String =
  if (line == "" || Str.startsWith(line, "#")) "" else jVerb(line, scriptToks(line))

def jVerb(line: String, toks: List[String]): String =
  jVerbGo(line, List.at(toks, 0), List.drop(toks, 1))

def jVerbGo(line: String, verb: String, args: List[String]): String =
  if (verb == "accessibility") jAccessibility(line, args) else if (verb == "lifecycle") jObj("lifecycle", jStrK("phase", jAt(args, 0, ""))) else if (verb == "resize") jResize(args) else if (verb == "reduceMotion") jObj("reduceMotion", Str.concat(",\"value\":", jAt(args, 0, "false"))) else if (verb == "inputTime") jObj("inputTime", jNum("ms", jAt(args, 0, "0"))) else if (verb == "tap") jTap(if (List.isEmpty(args)) "0" else Str.trim(jRest(line))) else if (verb == "pump") jObj("pump", jNum("k", jAt(args, 0, "1"))) else if (verb == "drive") jObj("drive", Str.concat(jStrK("name", jAt(args, 0, "")), jStrArr(List.drop(args, 1)))) else if (verb == "key") jKeyEvent(jAt(args, 0, ""), jRest(jRest(line))) else if (verb == "caret") jObj("caret", if (List.len(args) >= 2) Str.concat(jNum("i", List.at(args, 0)), jNum("offset", List.at(args, 1))) else jNum("offset", jAt(args, 0, "0"))) else if (verb == "select") jObj("select", if (List.len(args) >= 3) Str.concat(jNum("i", List.at(args, 0)), Str.concat(jNum("start", List.at(args, 1)), jNum("end", List.at(args, 2)))) else Str.concat(jNum("start", jAt(args, 0, "0")), jNum("end", jAt(args, 1, "0")))) else if (verb == "secondary") jObj("secondary", if (List.len(args) >= 2) Str.concat(jNum("x", List.at(args, 0)), jNum("y", List.at(args, 1))) else jNum("i", jAt(args, 0, "0"))) else if (verb == "text") jField("text", jRest(line)) else if (verb == "type") jField("type", jRest(line)) else if (verb == "backspace") jObj("backspace", if (List.len(args) >= 2) Str.concat(jNum("i", List.at(args, 0)), jNum("count", List.at(args, 1))) else if (List.len(args) == 1) jNum("count", List.at(args, 0)) else "") else if (verb == "scroll") jObj("scroll", if (List.len(args) >= 2) Str.concat(jNum("i", List.at(args, 0)), jNum("dy", List.at(args, 1))) else if (List.len(args) == 1) jNum("dy", List.at(args, 0)) else "") else if (verb == "xy") jObj("xy", Str.concat(jNum("x", jAt(args, 0, "0")), jNum("y", jAt(args, 1, "0")))) else if (verb == "drag") jObj("drag", Str.concat(jNum("x1", jAt(args, 0, "0")), Str.concat(jNum("y1", jAt(args, 1, "0")), Str.concat(jNum("x2", jAt(args, 2, "0")), jNum("y2", jAt(args, 3, "0")))))) else if (verb == "hover") jObj("hover", Str.concat(jNum("x", jAt(args, 0, "0")), jNum("y", jAt(args, 1, "0")))) else if (verb == "compose") jObj("compose", jStrK("value", jRest(line))) else if (verb == "paste") jObj("paste", if (jRest(line) == "") "" else jStrK("value", jRest(line))) else if (jBareOp(verb)) jObj(verb, "") else jObj("__bad_line__", jStrK("line", line))

def jAccessibility(line: String, args: List[String]): String =
  for {
    action = jAt(args, 1, "")
    target = Str.concat(jNum("i", jAt(args, 0, "-1")), jStrK("action", action))
    payload = if (action == "setText") jStrK("text", jAfterTokens(line, 3)) else if (action == "setSelection") Str.concat(jNum("start", jAt(args, 2, "0")), jNum("end", jAt(args, 3, "0"))) else if (action == "setValue") jNum("value", jAt(args, 2, "0")) else ""
  } yield jObj("accessibility", Str.concat(target, payload))

def jAfterTokens(line: String, count: Int): String =
  if (count <= 0) line else if (Str.startsWith(line, " ")) jAfterTokens(Str.drop(line, 1), count) else jAfterTokens(jRest(line), count - 1)

def jResize(args: List[String]): String =
  jObj("resize", Str.concat(jNum("width", jAt(args, 0, "0")), Str.concat(jNum("height", jAt(args, 1, "0")), if (List.len(args) > 2) jNum("scale", List.at(args, 2)) else "")))

def jBareOp(verb: String): Bool =
  verb == "copy" || verb == "cut" || verb == "commit" || verb == "dump" || verb == "reload" || verb == "quit" || verb == "resetpeak"

def jAt(xs: List[String], i: Int, d: String): String =
  if (i < List.len(xs)) List.at(xs, i) else d

def jRest(line: String): String =
  jRestAt(line, findIdx(line, " ", 0))

def jRestAt(line: String, i: Int): String =
  if (i < 0) "" else Str.drop(line, i + 1)

def jObj(op: String, body: String): String =
  Str.concat("{\"op\":\"", Str.concat(op, Str.concat("\"", Str.concat(body, "}"))))

def jNum(key: String, tok: String): String =
  Str.concat(",\"", Str.concat(key, Str.concat("\":", tok)))

def jStrK(key: String, v: String): String =
  Str.concat(",\"", Str.concat(key, Str.concat("\":", Check.jsonStr(v))))

def jStrArr(xs: List[String]): String =
  Str.concat(",\"args\":[", Str.concat(jStrArrGo(xs), "]"))

def jStrArrGo(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else if (List.isEmpty(List.tail(xs))) Check.jsonStr(List.at(xs, 0)) else Str.concat(Check.jsonStr(List.at(xs, 0)), Str.concat(",", jStrArrGo(List.tail(xs))))

def jField(op: String, rest: String): String =
  jFieldAt(op, rest, findIdx(rest, " ", 0))

def jFieldAt(op: String, rest: String, i: Int): String =
  if (i > 0 && allDigits(Str.take(rest, i))) jObj(op, Str.concat(jNum("i", Str.take(rest, i)), jStrK("value", Str.drop(rest, i + 1)))) else jObj(op, jStrK("value", rest))

def jTap(tok: String): String =
  if (allDigits(tok)) jObj("tap", jNum("i", tok)) else jObj("tap", jStrK("id", tok))

def allDigits(s: String): Bool =
  Str.len(s) > 0 && allDigitsAt(s, 0)

def allDigitsAt(s: String, i: Int): Bool =
  if (i >= Str.len(s)) true else if (Str.charAt(s, i) < 48 || Str.charAt(s, i) > 57) false else allDigitsAt(s, i + 1)

def jKeyEvent(tok: String, text: String): String =
  jKeyAsm(List.filter(Str.split(tok, "+"), p => p != ""), text)

def jKeyAsm(ps: List[String], text: String): String =
  jObj("key", Str.concat(jStrK("key", jKeyName(ps)), Str.concat(if (text == "") "" else jStrK("text", text), Str.concat(jKeyModsBody(ps), if (List.exists(ps, p => Str.toLower(p) == "repeat")) ",\"repeat\":true" else ""))))

def jKeyIsMod(p: String): Bool =
  Str.toLower(p) == "shift" || Str.toLower(p) == "ctrl" || Str.toLower(p) == "cmd" || Str.toLower(p) == "alt"

def jKeyIsMeta(p: String): Bool =
  jKeyIsMod(p) || Str.toLower(p) == "repeat"

def jKeyName(ps: List[String]): String =
  if (List.isEmpty(List.filter(ps, p => !jKeyIsMeta(p)))) "" else List.at(List.filter(ps, p => !jKeyIsMeta(p)), 0)

def jKeyModsBody(ps: List[String]): String =
  if (List.isEmpty(List.filter(ps, p => jKeyIsMod(p)))) "" else Str.concat(",\"mods\":[", Str.concat(jJoin(List.map(List.filter(ps, p => jKeyIsMod(p)), p => Check.jsonStr(Str.toLower(p)))), "]"))

def insertOracle(src: String, name: String): String =
  insertOracleAt(src, name, findIdx(src, """[fuzz]
""", 0))

def insertOracleAt(src: String, name: String, i: Int): String =
  if (i < 0) Str.concat("oracle = \"", Str.concat(name, Str.concat("\"\n", src))) else Str.concat(Str.slice(src, 0, i + 7), Str.concat("oracle = \"", Str.concat(name, Str.concat("\"\n", Str.slice(src, i + 7, Str.len(src))))))

def reproSched(sched: String): String =
  if (sched == "") "" else Str.concat("schedule_seed = \"", Str.concat(sched, "\"\n"))

def reproFault(fault: String): String =
  if (fault == "") "" else Str.concat("fault_seed = \"", Str.concat(fault, "\"\n"))

def jb(b: Bool): String =
  if (b) "true" else "false"

def noRuleFailure(): RuleFailure =
  RuleFailure("", "", "", 0, 0, 0, 0, "", "", [])

def jRuleFailure(f: RuleFailure): String =
  if (f.kind == "") "" else Str.concat(",\"failure\":{\"kind\":", Str.concat(Check.jsonStr(f.kind), Str.concat(",\"rule\":", Str.concat(Check.jsonStr(f.rule), Str.concat(",\"file\":", Str.concat(Check.jsonStr(f.file), Str.concat(",\"line\":", Str.concat(Str.fromInt(f.line), Str.concat(",\"column\":", Str.concat(Str.fromInt(f.column), Str.concat(",\"end_line\":", Str.concat(Str.fromInt(f.endLine), Str.concat(",\"end_column\":", Str.concat(Str.fromInt(f.endColumn), Str.concat(",\"workload\":", Str.concat(Check.jsonStr(f.workload), Str.concat(",\"repro\":", Str.concat(Check.jsonStr(f.repro), Str.concat(",\"events\":", Str.concat(jStrList(f.events), "}"))))))))))))))))))))

def summaryJson(ok: Bool, seed: Int, iterations: Int, search: Int, failures: Int, corpus: Int, corpFail: Int, promo: String, repro: String, killed: Int, survived: Int, inert: Int, ran: Int, sites: Int, oracles: Bool, classRaw: String, invalid: Int, incomplete: Int, covRows: List[(String, Bool)], branchRows: List[(String, Bool)], somDec: List[String], somHit: List[String], trigDec: List[String], trigHit: List[String], claimDec: List[String], claimHit: List[String], br: Breadth, scope: InputScope, properties: List[String]): String =
  summaryJsonAt(ok, seed, iterations, search, failures, corpus, corpFail, promo, repro, jMut(killed, survived, inert, ran, sites, oracles, invalid - List.len(scope.mutantExcluded), List.len(scope.mutantExcluded), incomplete), classRaw, incomplete, covRows, branchRows, somDec, somHit, trigDec, trigHit, claimDec, claimHit, br, scope, properties, noRuleFailure())

def summaryJsonMut(ok: Bool, seed: Int, iterations: Int, search: Int, failures: Int, corpus: Int, corpFail: Int, promo: String, repro: String, killed: Int, survived: Int, inert: Int, ran: Int, sites: Int, oracles: Bool, classRaw: String, invalid: Int, incomplete: Int, incompleteSites: List[Int], excludedSites: List[Int], survivors: List[MutSurvivor], covRows: List[(String, Bool)], branchRows: List[(String, Bool)], somDec: List[String], somHit: List[String], trigDec: List[String], trigHit: List[String], claimDec: List[String], claimHit: List[String], br: Breadth, scope: InputScope, properties: List[String]): String =
  summaryJsonMutFail(ok, seed, iterations, search, failures, corpus, corpFail, promo, repro, killed, survived, inert, ran, sites, oracles, classRaw, invalid, incomplete, incompleteSites, excludedSites, survivors, covRows, branchRows, somDec, somHit, trigDec, trigHit, claimDec, claimHit, br, scope, properties, noRuleFailure())

def summaryJsonMutFail(ok: Bool, seed: Int, iterations: Int, search: Int, failures: Int, corpus: Int, corpFail: Int, promo: String, repro: String, killed: Int, survived: Int, inert: Int, ran: Int, sites: Int, oracles: Bool, classRaw: String, invalid: Int, incomplete: Int, incompleteSites: List[Int], excludedSites: List[Int], survivors: List[MutSurvivor], covRows: List[(String, Bool)], branchRows: List[(String, Bool)], somDec: List[String], somHit: List[String], trigDec: List[String], trigHit: List[String], claimDec: List[String], claimHit: List[String], br: Breadth, scope: InputScope, properties: List[String], failure: RuleFailure): String =
  summaryJsonAt(ok, seed, iterations, search, failures, corpus, corpFail, promo, repro, jMutReport(killed, survived, inert, ran, sites, oracles, invalid - List.len(excludedSites), List.len(excludedSites), incomplete, incompleteSites, excludedSites, survivors), classRaw, incomplete, covRows, branchRows, somDec, somHit, trigDec, trigHit, claimDec, claimHit, br, scope, properties, failure)

def summaryJsonAt(ok: Bool, seed: Int, iterations: Int, search: Int, failures: Int, corpus: Int, corpFail: Int, promo: String, repro: String, mutJson: String, classRaw: String, incomplete: Int, covRows: List[(String, Bool)], branchRows: List[(String, Bool)], somDec: List[String], somHit: List[String], trigDec: List[String], trigHit: List[String], claimDec: List[String], claimHit: List[String], br: Breadth, scope: InputScope, properties: List[String], failure: RuleFailure): String =
  Str.concat(Str.concat("{\"v\":1,\"kind\":\"fuzz\",\"status\":", Str.concat(Check.jsonStr(campaignStatus(ok, incomplete, scope)), ",\"fuzz\":")), Str.concat(jFuzz(ok, seed, iterations, search, failures, corpus, repro), Str.concat(jCorpus(corpus, corpFail, promo), Str.concat(jClass(List.filter(linesOf(classRaw), l => l != "")), Str.concat(mutJson, Str.concat(jCoverage(covRows, branchRows), Str.concat(jReachKey("sometimes", somDec, somHit), Str.concat(jReachKey("triggers", trigDec, trigHit), Str.concat(jReachKey("claim_drives", claimDec, claimHit), Str.concat(jBreadth(br), Str.concat(jScope(scope), Str.concat(jGuards(properties, scope.checkedClaims), Str.concat(jRuleFailure(failure), "}")))))))))))))

def replayJson(input: String, mode: String, asan: Bool, declaredPicks: List[String], scope: InputScope, properties: List[String]): String =
  replayJsonFail(input, mode, asan, declaredPicks, scope, properties, noRuleFailure())

def replayJsonFail(input: String, mode: String, asan: Bool, declaredPicks: List[String], scope: InputScope, properties: List[String], failure: RuleFailure): String =
  Str.concat("{\"v\":1,\"kind\":\"replay\",\"status\":", Str.concat(Check.jsonStr(List.at(scope.workloads, 0).status), Str.concat(jStrK("input", input), Str.concat(jStrK("mode", mode), Str.concat(",\"asan\":", Str.concat(jb(asan), Str.concat(",\"declared_schedule_picks\":", Str.concat(jStrList(declaredPicks), Str.concat(jScope(scope), Str.concat(jGuards(properties, scope.checkedClaims), Str.concat(jRuleFailure(failure), "}")))))))))))

def campaignStatus(ok: Bool, incomplete: Int, scope: InputScope): String =
  if (incomplete > 0 || List.exists(scope.workloads, w => w.status == "incomplete")) "incomplete" else if (ok) "passed" else "failed"

def propertyNames(raw: String): List[String] =
  sortStrs(List.distinct(List.map(List.filter(linesOf(raw), l => Str.startsWith(l, "R:")), l => stripRuleTag(Hex.decode(Str.drop(l, 2))))))

def jGuards(properties: List[String], claims: List[String]): String =
  Str.concat(",\"guards\":{\"status\":", Str.concat(Check.jsonStr(if (List.isEmpty(properties) && List.isEmpty(claims)) "unguarded" else "guarded"), Str.concat(",\"properties\":", Str.concat(jStrList(properties), Str.concat(",\"claims\":", Str.concat(jStrList(claims), "}"))))))

def jFuzz(ok: Bool, seed: Int, iterations: Int, search: Int, failures: Int, corpus: Int, repro: String): String =
  Str.concat("{\"ok\":", Str.concat(jb(ok), Str.concat(",\"seed\":", Str.concat(Str.fromInt(seed), Str.concat(",\"iterations\":", Str.concat(Str.fromInt(iterations), Str.concat(",\"search\":", Str.concat(Str.fromInt(search), Str.concat(",\"search_failures\":", Str.concat(Str.fromInt(failures), Str.concat(",\"corpus\":", Str.concat(Str.fromInt(corpus), Str.concat(jRepro(repro), "}")))))))))))))

def jRepro(repro: String): String =
  if (repro == "") "" else Str.concat(",\"repro\":", Check.jsonStr(repro))

def jCorpus(corpus: Int, corpFail: Int, promo: String): String =
  Str.concat(",\"corpus\":{\"entries\":", Str.concat(Str.fromInt(corpus), Str.concat(",\"failures\":", Str.concat(Str.fromInt(corpFail), Str.concat(",\"promoted\":", Str.concat(promo, "}"))))))

def jClass(lines: List[String]): String =
  if (List.isEmpty(lines)) "" else Str.concat(",\"classify\":[", Str.concat(jClassOne(List.at(lines, 0)), Str.concat(jClassRest(List.tail(lines)), "]")))

def jClassRest(lines: List[String]): String =
  if (List.isEmpty(lines)) "" else Str.concat(",", Str.concat(jClassOne(List.at(lines, 0)), jClassRest(List.tail(lines))))

def jClassOne(line: String): String =
  Str.concat("{\"name\":", Str.concat(Check.jsonStr(className(line)), Str.concat(",\"true\":", Str.concat(classYes(classNums(line)), Str.concat(",\"false\":", Str.concat(classNo(classNums(line)), "}"))))))

def jMut(killed: Int, survived: Int, inert: Int, ran: Int, sites: Int, oracles: Bool, invalid: Int, excluded: Int, incomplete: Int): String =
  Str.concat(jMutBase(killed, survived, inert, ran, sites, oracles, invalid, excluded, incomplete), Str.concat(jScore(killed, ran - invalid - inert), "}"))

def jMutReport(killed: Int, survived: Int, inert: Int, ran: Int, sites: Int, oracles: Bool, invalid: Int, excluded: Int, incomplete: Int, incompleteSites: List[Int], excludedSites: List[Int], survivors: List[MutSurvivor]): String =
  Str.concat(jMutBase(killed, survived, inert, ran, sites, oracles, invalid, excluded, incomplete), Str.concat(",\"incomplete_sites\":", Str.concat(jIntList(incompleteSites), Str.concat(",\"excluded_sites\":", Str.concat(jIntList(excludedSites), Str.concat(",\"survivors\":[", Str.concat(List.join(List.map(survivors, s => jMutSurvivor(s)), ","), Str.concat("]", Str.concat(jScore(killed, ran - invalid - inert), "}")))))))))

def jMutBase(killed: Int, survived: Int, inert: Int, ran: Int, sites: Int, oracles: Bool, invalid: Int, excluded: Int, incomplete: Int): String =
  Str.concat(",\"mutate\":{\"killed\":", Str.concat(Str.fromInt(killed), Str.concat(",\"survived\":", Str.concat(Str.fromInt(survived), Str.concat(",\"inert\":", Str.concat(Str.fromInt(inert), Str.concat(",\"ran\":", Str.concat(Str.fromInt(ran), Str.concat(",\"sites\":", Str.concat(Str.fromInt(sites), Str.concat(",\"oracles\":", Str.concat(jb(oracles), Str.concat(",\"invalid\":", Str.concat(Str.fromInt(invalid), Str.concat(Str.concat(",\"incomplete\":", Str.fromInt(incomplete)), Str.concat(",\"excluded\":", Str.fromInt(excluded)))))))))))))))))

def jIntList(xs: List[Int]): String =
  Str.concat("[", Str.concat(List.join(List.map(xs, n => Str.fromInt(n)), ","), "]"))

def jMutSurvivor(s: MutSurvivor): String =
  Str.concat("{\"site\":", Str.concat(Str.fromInt(s.site), Str.concat(",\"kind\":", Str.concat(Check.jsonStr(s.kind), Str.concat(",\"file\":", Str.concat(Check.jsonStr(s.file), Str.concat(",\"line\":", Str.concat(Str.fromInt(s.line), Str.concat(",\"column\":", Str.concat(Str.fromInt(s.column), Str.concat(",\"end_line\":", Str.concat(Str.fromInt(s.endLine), Str.concat(",\"end_column\":", Str.concat(Str.fromInt(s.endColumn), Str.concat(",\"diverged_workloads\":", Str.concat(jStrList(s.divergedWorkloads), Str.concat(",\"passed_claims\":", Str.concat(jStrList(s.passedClaims), "}"))))))))))))))))))

def jScore(killed: Int, sites: Int): String =
  if (sites <= 0) "" else Str.concat(",\"score\":", score3(killed, sites))

def jCoverage(rows: List[(String, Bool)], branches: List[(String, Bool)]): String =
  Str.concat(",\"coverage\":{", Str.concat(jCovRows(rows), Str.concat(",\"branches\":{", Str.concat(jCovRows(branches), "}}"))))

def jCovRows(rows: List[(String, Bool)]): String =
  Str.concat("\"total\":", Str.concat(Str.fromInt(List.len(rows)), Str.concat(",\"reached\":", Str.concat(Str.fromInt(List.count(rows, r => r._2)), Str.concat(",\"regions\":[", Str.concat(jRegions(rows), "]"))))))

def jRegions(rows: List[(String, Bool)]): String =
  if (List.isEmpty(rows)) "" else Str.concat(jRegion(List.at(rows, 0)), jRegionsRest(List.tail(rows)))

def jRegionsRest(rows: List[(String, Bool)]): String =
  if (List.isEmpty(rows)) "" else Str.concat(",", Str.concat(jRegion(List.at(rows, 0)), jRegionsRest(List.tail(rows))))

def jRegion(row: (String, Bool)): String =
  Str.concat("{\"location\":", Str.concat(Check.jsonStr(row._1), Str.concat(",\"reached\":", Str.concat(jb(row._2), "}"))))

def jKVList(k: String, xs: List[String]): String =
  Str.concat("\"", Str.concat(k, Str.concat("\":", jStrList(xs))))

def jClaimed(signalInt: List[String], signalListLen: List[String], signalStrHas: List[String], a11yHas: List[String], lastHitHas: List[String], driveHas: List[String], effectHas: List[String], fileTextIs: List[String], fileSame: List[String]): String =
  Str.concat("{", Str.concat(List.join(jKVList("signalInt", signalInt) :: jKVList("signalListLen", signalListLen) :: jKVList("signalStrHas", signalStrHas) :: jKVList("a11yHas", a11yHas) :: jKVList("lastHitHas", lastHitHas) :: jKVList("driveHas", driveHas) :: jKVList("effectHas", effectHas) :: jKVList("fileTextIs", fileTextIs) :: jKVList("fileSame", fileSame) :: noStr(), ","), "}"))

def jBreadth(br: Breadth): String =
  br match {
    case Breadth(varied, signalInt, signalListLen, signalStrHas, a11yHas, lastHitHas, driveHas, effectHas, fileTextIs, fileSame, unclaimed) => Str.concat(",\"breadth\":{\"varied\":", Str.concat(jStrList(varied), Str.concat(",\"claimed\":", Str.concat(jClaimed(signalInt, signalListLen, signalStrHas, a11yHas, lastHitHas, driveHas, effectHas, fileTextIs, fileSame), Str.concat(",\"unclaimed\":", Str.concat(jStrList(unclaimed), "}"))))))
  }

def noBreadth(): Breadth =
  Breadth(noStr(), noStr(), noStr(), noStr(), noStr(), noStr(), noStr(), noStr(), noStr(), noStr(), noStr())

def sampleBreadth(): Breadth =
  Breadth(["signals"], ["count"], noStr(), noStr(), ["text:count = -1"], noStr(), noStr(), noStr(), noStr(), noStr(), noStr())

def breadthOf(files: List[(String, String)], raw: String): Breadth =
  breadthFrom(dumpNames(raw), files)

def breadthFrom(varied: List[String], files: List[(String, String)]): Breadth =
  breadthFill(varied, sortStrs(List.distinct(callLitsFiles(files, "Timeline.signalInt", 2))), sortStrs(List.distinct(callLitsFiles(files, "Timeline.signalListLen", 2))), sortStrs(List.distinct(callLitsFiles(files, "Timeline.signalStrHas", 2))), sortStrs(List.distinct(callLitsFiles(files, "Timeline.a11yHas", 2))), sortStrs(List.distinct(callLitsFiles(files, "Timeline.lastHitHas", 2))), sortStrs(List.distinct(callLitsFiles(files, "Timeline.driveHas", 2))), sortStrs(List.distinct(callLitsFiles(files, "Timeline.effectHas", 2))), sortStrs(List.distinct(callLitsFiles(files, "Timeline.fileTextIs", 2))), sortStrs(List.distinct(callLitsFiles(files, "Timeline.fileSame", 3))))

def breadthFill(varied: List[String], signalInt: List[String], signalListLen: List[String], signalStrHas: List[String], a11yHas: List[String], lastHitHas: List[String], driveHas: List[String], effectHas: List[String], fileTextIs: List[String], fileSame: List[String]): Breadth =
  Breadth(varied, signalInt, signalListLen, signalStrHas, a11yHas, lastHitHas, driveHas, effectHas, fileTextIs, fileSame, breadthUnclaimed(varied, signalInt, signalListLen, signalStrHas, a11yHas, lastHitHas, driveHas, effectHas, fileTextIs, fileSame))

def breadthUnclaimed(varied: List[String], signalInt: List[String], signalListLen: List[String], signalStrHas: List[String], a11yHas: List[String], lastHitHas: List[String], driveHas: List[String], effectHas: List[String], fileTextIs: List[String], fileSame: List[String]): List[String] =
  List.filter(varied, b => breadthGap(b, signalInt, signalListLen, signalStrHas, a11yHas, lastHitHas, driveHas, effectHas, fileTextIs, fileSame))

def breadthGap(b: String, signalInt: List[String], signalListLen: List[String], signalStrHas: List[String], a11yHas: List[String], lastHitHas: List[String], driveHas: List[String], effectHas: List[String], fileTextIs: List[String], fileSame: List[String]): Bool =
  if (b == "signals") List.isEmpty(signalInt) && List.isEmpty(signalListLen) && List.isEmpty(signalStrHas) else if (b == "a11y") List.isEmpty(a11yHas) else if (b == "last_hit") List.isEmpty(lastHitHas) else if (b == "drive") List.isEmpty(driveHas) else if (b == "effects") List.isEmpty(effectHas) else if (b == "files") List.isEmpty(fileTextIs) && List.isEmpty(fileSame) else false

def jReachKey(key: String, declared: List[String], reached: List[String]): String =
  Str.concat(",\"", Str.concat(key, Str.concat("\":", jReach(declared, reached))))

def jReach(declared: List[String], reached: List[String]): String =
  Str.concat("{\"declared\":", Str.concat(jStrList(sortStrs(List.distinct(declared))), Str.concat(",\"reached\":", Str.concat(jStrList(sortStrs(reachKeep(declared, reached))), Str.concat(",\"never\":", Str.concat(jStrList(sortStrs(reachNever(declared, reached))), "}"))))))

def reachKeep(declared: List[String], reached: List[String]): List[String] =
  List.filter(reached, n => List.contains(declared, n))

def reachNever(declared: List[String], reached: List[String]): List[String] =
  List.filter(declared, n => !List.contains(reached, n))

def jStrList(xs: List[String]): String =
  if (List.isEmpty(xs)) "[]" else Str.concat("[", Str.concat(jStrHead(xs), "]"))

def jStrHead(xs: List[String]): String =
  Str.concat(Check.jsonStr(List.at(xs, 0)), jStrRest(List.tail(xs)))

def jStrRest(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else Str.concat(",", Str.concat(Check.jsonStr(List.at(xs, 0)), jStrRest(List.tail(xs))))

def dumpNames(raw: String): List[String] =
  sortStrs(List.distinct(List.filter(linesOf(raw), l => l != "")))

def triggerReached(raw: String): List[String] =
  sortStrs(List.distinct(List.filter(List.map(linesOf(raw), triggerFired), l => l != "")))

def triggerFired(line: String): String =
  if (!Str.startsWith(line, "claim\t")) "" else triggerFired2(Str.slice(line, 6, Str.len(line)))

def triggerFired2(rest: String): String =
  triggerFired3(rest, lastTab(rest, 0, 0 - 1))

def triggerFired3(rest: String, tab: Int): String =
  if (tab < 0) "" else if (Str.slice(rest, tab + 1, Str.len(rest)) == "triggered") Str.slice(rest, 0, tab) else ""

def lastTab(s: String, i: Int, acc: Int): Int =
  if (i >= Str.len(s)) acc else if (Str.charAt(s, i) == 9) lastTab(s, i + 1, i) else lastTab(s, i + 1, acc)

def sometimesOf(files: List[(String, String)]): List[String] =
  sortStrs(List.distinct(callLitsFiles(files, "Property.sometimes", 0)))

def triggersOf(files: List[(String, String)]): List[String] =
  sortStrs(List.distinct(List.concat(callLitsFiles(files, "Verdict.afterHit", 1), callLitsFiles(files, "Verdict.onHit", 1))))

def claimDriveOf(files: List[(String, String)]): List[String] =
  sortStrs(List.distinct(callLitsFiles(files, "Timeline.driveHas", 2)))

def claimDriveHit(raw: String, dec: List[String]): List[String] =
  sortStrs(List.filter(dec, n => List.exists(claimDriveLines(raw), h => hasSub(h, n))))

def claimDriveLines(raw: String): List[String] =
  List.filter(List.map(linesOf(raw), claimDriveFired), l => l != "")

def claimDriveFired(line: String): String =
  if (!Str.startsWith(line, "drive\t")) "" else Str.drop(line, 6)

def driftLine(err: String): String =
  driftLineGo(linesOf(err))

def driftLineGo(xs: List[String]): String =
  if (List.isEmpty(xs)) "scuzz fuzz: schedule drift" else if (Str.contains(List.at(xs, 0), "schedule drift")) List.at(xs, 0) else driftLineGo(List.tail(xs))

def callLitsFiles(files: List[(String, String)], f: String, idx: Int): List[String] =
  if (List.isEmpty(files)) noStr() else List.concat(callLitsFile(List.at(files, 0), f, idx), callLitsFiles(List.tail(files), f, idx))

def callLitsFile(file: (String, String), f: String, idx: Int): List[String] =
  file match {
    case (_stem, src) => callLitsOf(Parse.parse(Lexer.lex(src)), f, idx)
  }

def callLitsOf(p: Prog, f: String, idx: Int): List[String] =
  p match {
    case Prog(_, _, _, _, impls, _, defs, _, body) => List.concat(callLitsExpr(body, f, idx), List.concat(callLitsDefs(defs, f, idx), callLitsImpls(impls, f, idx)))
  }

def callLitsImpls(xs: List[Im], f: String, idx: Int): List[String] =
  if (List.isEmpty(xs)) noStr() else List.concat(callLitsIm(List.at(xs, 0), f, idx), callLitsImpls(List.tail(xs), f, idx))

def callLitsIm(im: Im, f: String, idx: Int): List[String] =
  im match {
    case Im(_, _, _, methods) => callLitsDefs(methods, f, idx)
  }

def callLitsDefs(ds: List[Fun], f: String, idx: Int): List[String] =
  if (List.isEmpty(ds)) noStr() else List.concat(callLitsFun(List.at(ds, 0), f, idx), callLitsDefs(List.tail(ds), f, idx))

def callLitsFun(d: Fun, f: String, idx: Int): List[String] =
  d match {
    case Fun(_, _, _, _, _, _, body, _, _) => callLitsExpr(body, f, idx)
  }

def callLitsExpr(e: Expr, f: String, idx: Int): List[String] =
  e match {
    case Expr.EPrint(inner, _) => callLitsExpr(inner, f, idx)
    case Expr.ECall(name, args, _) => List.concat(callLitHit(name, args, f, idx), callLitsList(args, f, idx))
    case Expr.EMethod(recv, name, args, _) => List.concat(callLitHit(qualCall(recv, name), args, f, idx), List.concat(callLitsExpr(recv, f, idx), callLitsList(args, f, idx)))
    case Expr.EField(recv, _, _) => callLitsExpr(recv, f, idx)
    case Expr.EBin(_, l, r, _) => List.concat(callLitsExpr(l, f, idx), callLitsExpr(r, f, idx))
    case Expr.EUn(_, inner, _) => callLitsExpr(inner, f, idx)
    case Expr.ELam(_, _, body) => callLitsExpr(body, f, idx)
    case Expr.EIf(c, t, el, _) => List.concat(callLitsExpr(c, f, idx), List.concat(callLitsExpr(t, f, idx), callLitsExpr(el, f, idx)))
    case Expr.EMatch(s, arms, _) => List.concat(callLitsExpr(s, f, idx), callLitsArms(arms, f, idx))
    case Expr.EList(xs) => callLitsList(xs, f, idx)
    case Expr.ETuple(xs) => callLitsList(xs, f, idx)
    case Expr.ENamed(_, inner) => callLitsExpr(inner, f, idx)
    case Expr.EAscribe(inner, _, _) => callLitsExpr(inner, f, idx)
    case Expr.EFor(bs, body, _) => List.concat(callLitsBinds(bs, f, idx), callLitsExpr(body, f, idx))
    case _ => noStr()
  }

def callLitHit(name: String, args: List[Expr], f: String, idx: Int): List[String] =
  if (name != f) noStr() else callLitAt(args, idx)

def qualCall(recv: Expr, name: String): String =
  recv match {
    case Expr.EVar(s, _) => Str.concat(s, Str.concat(".", name))
    case _ => ""
  }

def callLitAt(args: List[Expr], idx: Int): List[String] =
  if (List.len(args) <= idx) noStr() else callLitStr(List.at(args, idx))

def callLitStr(e: Expr): List[String] =
  e match {
    case Expr.EStr(s, _) => if (s == "") noStr() else s :: noStr()
    case _ => noStr()
  }

def callLitsList(xs: List[Expr], f: String, idx: Int): List[String] =
  if (List.isEmpty(xs)) noStr() else List.concat(callLitsExpr(List.at(xs, 0), f, idx), callLitsList(List.tail(xs), f, idx))

def callLitsArms(xs: List[Arm], f: String, idx: Int): List[String] =
  if (List.isEmpty(xs)) noStr() else List.concat(callLitsArm(List.at(xs, 0), f, idx), callLitsArms(List.tail(xs), f, idx))

def callLitsArm(a: Arm, f: String, idx: Int): List[String] =
  a match {
    case Arm(_, _, body) => callLitsExpr(body, f, idx)
  }

def callLitsBinds(xs: List[Bind], f: String, idx: Int): List[String] =
  if (List.isEmpty(xs)) noStr() else List.concat(callLitsBind(List.at(xs, 0), f, idx), callLitsBinds(List.tail(xs), f, idx))

def callLitsBind(b: Bind, f: String, idx: Int): List[String] =
  b match {
    case Bind(_, _, e) => callLitsExpr(e, f, idx)
  }

def coverageRowsOf(files: List[(String, String)], compiled: List[(String, String)], hits: String): List[(String, Bool)] =
  coverageBoth(files, compiled, hits)._1

def coverageBoth(files: List[(String, String)], compiled: List[(String, String)], hits: String): (List[(String, Bool)], List[(String, Bool)]) =
  coverageBothKept(parseKept(files), files, compiled, Str.lines(hits))

def coverageBothKept(kept: List[(String, String, Prog)], files: List[(String, String)], compiled: List[(String, String)], hits: List[String]): (List[(String, Bool)], List[(String, Bool)]) =
  coverageBothLive(mergeKept(kept), kept, files, compiled, hits)

def coverageBothLive(p: Prog, kept: List[(String, String, Prog)], files: List[(String, String)], compiled: List[(String, String)], hits: List[String]): (List[(String, Bool)], List[(String, Bool)]) =
  coverageBothBuilt(p, expectedFromKept(kept), compiledProg(p, files, compiled), files, compiled, hits)

def compiledProg(live: Prog, files: List[(String, String)], compiled: List[(String, String)]): Prog =
  if (sameFiles(files, compiled)) live else mergeKept(parseKept(compiled))

def sameFiles(a: List[(String, String)], b: List[(String, String)]): Bool =
  if (List.isEmpty(a)) List.isEmpty(b) else if (List.isEmpty(b)) false else sameFileHd(List.at(a, 0), List.at(b, 0)) && sameFiles(List.tail(a), List.tail(b))

def sameFileHd(x: (String, String), y: (String, String)): Bool =
  x._1 == y._1 && x._2 == y._2

def coverageBothBuilt(p: Prog, expected: Prog, built: Prog, files: List[(String, String)], compiled: List[(String, String)], hits: List[String]): (List[(String, Bool)], List[(String, Bool)]) =
  coverageBothIdx(p, expected, built, files, compiled, hits, Check.fileIndex(files), Check.fileIndex(compiled))

def coverageBothIdx(p: Prog, expected: Prog, built: Prog, files: List[(String, String)], compiled: List[(String, String)], hits: List[String], lidx: Map[String, LineIndex], cidx: Map[String, LineIndex]): (List[(String, Bool)], List[(String, Bool)]) =
  (coverageProgRows(p, expected, built, files, compiled, hits, lidx, cidx), branchProgRows(p, expected, built, files, compiled, hits, lidx, cidx))

def coverageProgRows(p: Prog, expected: Prog, built: Prog, files: List[(String, String)], compiled: List[(String, String)], hits: List[String], lidx: Map[String, LineIndex], cidx: Map[String, LineIndex]): List[(String, Bool)] =
  List.distinct(List.concat(coverageDefs(Check.implFuns(p.impls, p.defs), Check.ftabOf(Check.implFuns(expected.impls, expected.defs)), Check.ftabOf(Check.implFuns(built.impls, built.defs)), files, compiled, hits, lidx, cidx), if (p.main == "") [] else [(Emit.panicLocExprAt(files, lidx, p.body), Parse.pretty0(expected.body) == Parse.pretty0(built.body) && List.contains(hits, Emit.panicLocExprAt(compiled, cidx, built.body)))]))

def coverageDefs(defs: List[Fun], expected: Map[String, List[Fun]], built: Map[String, List[Fun]], files: List[(String, String)], compiled: List[(String, String)], hits: List[String], lidx: Map[String, LineIndex], cidx: Map[String, LineIndex]): List[(String, Bool)] =
  if (List.isEmpty(defs)) [] else coverageDef(List.at(defs, 0), expected, built, files, compiled, hits, lidx, cidx) :: coverageDefs(List.tail(defs), expected, built, files, compiled, hits, lidx, cidx)

def coverageDef(d: Fun, expected: Map[String, List[Fun]], built: Map[String, List[Fun]], files: List[(String, String)], compiled: List[(String, String)], hits: List[String], lidx: Map[String, LineIndex], cidx: Map[String, LineIndex]): (String, Bool) =
  (Emit.panicLocAt(files, lidx, d.mod, d.off), coverageMatched(Check.ftabGetMod(expected, d.mod, d.name), Check.ftabGetMod(built, d.mod, d.name), compiled, hits, cidx))

def coverageMatched(expected: List[Fun], built: List[Fun], compiled: List[(String, String)], hits: List[String], cidx: Map[String, LineIndex]): Bool =
  if (List.isEmpty(expected) || List.isEmpty(built)) false else coverageBody(List.at(expected, 0), List.at(built, 0), compiled, hits, cidx)

def coverageBody(expected: Fun, built: Fun, compiled: List[(String, String)], hits: List[String], cidx: Map[String, LineIndex]): Bool =
  Parse.pretty0(expected.body) == Parse.pretty0(built.body) && List.contains(hits, Emit.panicLocAt(compiled, cidx, built.mod, built.off))

def branchRowsOf(files: List[(String, String)], compiled: List[(String, String)], hits: String): List[(String, Bool)] =
  coverageBoth(files, compiled, hits)._2

def branchProgRows(p: Prog, expected: Prog, built: Prog, files: List[(String, String)], compiled: List[(String, String)], hits: List[String], lidx: Map[String, LineIndex], cidx: Map[String, LineIndex]): List[(String, Bool)] =
  List.concat(branchDefs(Check.implFuns(p.impls, p.defs), Check.ftabOf(Check.implFuns(expected.impls, expected.defs)), Check.ftabOf(Check.implFuns(built.impls, built.defs)), files, compiled, hits, lidx, cidx), branchMainRows(p, expected, built, files, compiled, hits, lidx, cidx))

def branchDefs(defs: List[Fun], expected: Map[String, List[Fun]], built: Map[String, List[Fun]], files: List[(String, String)], compiled: List[(String, String)], hits: List[String], lidx: Map[String, LineIndex], cidx: Map[String, LineIndex]): List[(String, Bool)] =
  if (List.isEmpty(defs)) [] else List.concat(branchDefRows(List.at(defs, 0), expected, built, files, compiled, hits, lidx, cidx), branchDefs(List.tail(defs), expected, built, files, compiled, hits, lidx, cidx))

def branchDefRows(d: Fun, expected: Map[String, List[Fun]], built: Map[String, List[Fun]], files: List[(String, String)], compiled: List[(String, String)], hits: List[String], lidx: Map[String, LineIndex], cidx: Map[String, LineIndex]): List[(String, Bool)] =
  branchDefMatched(d, Check.ftabGetMod(expected, d.mod, d.name), Check.ftabGetMod(built, d.mod, d.name), files, compiled, hits, branchSites(d.body, 0), lidx, cidx)

def branchDefMatched(d: Fun, expected: List[Fun], built: List[Fun], files: List[(String, String)], compiled: List[(String, String)], hits: List[String], sites: List[(Int, String)], lidx: Map[String, LineIndex], cidx: Map[String, LineIndex]): List[(String, Bool)] =
  if (List.isEmpty(expected) || List.isEmpty(built) || Parse.pretty0(List.at(expected, 0).body) != Parse.pretty0(List.at(built, 0).body)) branchMissRows(files, d, sites, lidx) else branchZipRows(files, d, compiled, List.at(built, 0), hits, sites, branchSites(List.at(built, 0).body, 0), lidx, cidx)

def branchMissRows(files: List[(String, String)], d: Fun, sites: List[(Int, String)], lidx: Map[String, LineIndex]): List[(String, Bool)] =
  if (List.isEmpty(sites)) [] else (Emit.panicLocAt(files, lidx, d.mod, sitesOff(List.at(sites, 0))), false) :: branchMissRows(files, d, List.tail(sites), lidx)

def sitesOff(site: (Int, String)): Int =
  site._1

def branchZipRows(files: List[(String, String)], d: Fun, compiled: List[(String, String)], bd: Fun, hits: List[String], live: List[(Int, String)], built: List[(Int, String)], lidx: Map[String, LineIndex], cidx: Map[String, LineIndex]): List[(String, Bool)] =
  if (List.isEmpty(live) || List.isEmpty(built)) branchMissRows(files, d, live, lidx) else branchZipRow(files, d, compiled, bd, hits, List.at(live, 0), List.at(built, 0), lidx, cidx) :: branchZipRows(files, d, compiled, bd, hits, List.tail(live), List.tail(built), lidx, cidx)

def branchZipRow(files: List[(String, String)], d: Fun, compiled: List[(String, String)], bd: Fun, hits: List[String], live: (Int, String), built: (Int, String), lidx: Map[String, LineIndex], cidx: Map[String, LineIndex]): (String, Bool) =
  (Emit.panicLocAt(files, lidx, d.mod, live._1), List.contains(hits, Check.covKeyOf(Emit.panicLocAt(compiled, cidx, bd.mod, bd.off), built._1, built._2)))

def branchMainRows(p: Prog, expected: Prog, built: Prog, files: List[(String, String)], compiled: List[(String, String)], hits: List[String], lidx: Map[String, LineIndex], cidx: Map[String, LineIndex]): List[(String, Bool)] =
  if (p.main == "" || Parse.pretty0(expected.body) != Parse.pretty0(built.body)) [] else branchMainZip(files, compiled, hits, branchSites(p.body, 0), branchSites(built.body, 0), panicLocMain(compiled, cidx, built.body), lidx)

def panicLocMain(files: List[(String, String)], cidx: Map[String, LineIndex], body: Expr): String =
  Emit.panicLocExprAt(files, cidx, body)

def branchMainZip(files: List[(String, String)], compiled: List[(String, String)], hits: List[String], live: List[(Int, String)], built: List[(Int, String)], locBuilt: String, lidx: Map[String, LineIndex]): List[(String, Bool)] =
  if (List.isEmpty(live)) [] else if (List.isEmpty(built)) branchMainMiss(files, List.at(live, 0), lidx) :: branchMainZip(files, compiled, hits, List.tail(live), built, locBuilt, lidx) else branchMainRow(files, hits, List.at(live, 0), List.at(built, 0), locBuilt, lidx) :: branchMainZip(files, compiled, hits, List.tail(live), List.tail(built), locBuilt, lidx)

def branchMainMiss(files: List[(String, String)], site: (Int, String), lidx: Map[String, LineIndex]): (String, Bool) =
  (Emit.panicLocAt(files, lidx, "Main", site._1), false)

def branchMainRow(files: List[(String, String)], hits: List[String], live: (Int, String), built: (Int, String), locBuilt: String, lidx: Map[String, LineIndex]): (String, Bool) =
  (Emit.panicLocAt(files, lidx, "Main", live._1), List.contains(hits, Check.covKeyOf(locBuilt, built._1, built._2)))

def branchSites(e: Expr, parentOff: Int): List[(Int, String)] =
  e match {
    case Expr.EIf(c, t, el, ioff) => List.concat(branchIfSite(t, ioff, "t"), List.concat(branchIfSite(el, ioff, "e"), List.concat(branchSites(c, ioff), List.concat(branchSites(t, ioff), branchSites(el, ioff)))))
    case Expr.EMatch(s, arms, moff) => List.concat(branchArmSites(arms, moff, 0), List.concat(branchSites(s, moff), branchArmsSites(arms, moff)))
    case Expr.ECall(_, args, _) => branchListSites(args, parentOff)
    case Expr.EMethod(recv, _, args, _) => List.concat(branchSites(recv, parentOff), branchListSites(args, parentOff))
    case Expr.EField(recv, _, _) => branchSites(recv, parentOff)
    case Expr.EBin(_, l, r, _) => List.concat(branchSites(l, parentOff), branchSites(r, parentOff))
    case Expr.EUn(_, inner, _) => branchSites(inner, parentOff)
    case Expr.ELam(_, _, body) => branchSites(body, parentOff)
    case Expr.EPrint(inner, _) => branchSites(inner, parentOff)
    case Expr.EFor(bs, body, _) => List.concat(branchBindSites(bs, parentOff), branchSites(body, parentOff))
    case Expr.EList(xs) => branchListSites(xs, parentOff)
    case Expr.ETuple(xs) => branchListSites(xs, parentOff)
    case Expr.ENamed(_, inner) => branchSites(inner, parentOff)
    case Expr.EAscribe(inner, _, _) => branchSites(inner, parentOff)
    case _ => []
  }

def branchIfSite(e: Expr, parentOff: Int, tag: String): List[(Int, String)] =
  e match {
    case Expr.EUnit => []
    case _ => (Parse.spanOff(e, parentOff), tag) :: []
  }

def branchArmSites(arms: List[Arm], moff: Int, i: Int): List[(Int, String)] =
  if (List.isEmpty(arms)) [] else branchArmSite(List.at(arms, 0), moff, i) :: branchArmSites(List.tail(arms), moff, i + 1)

def branchArmSite(a: Arm, moff: Int, i: Int): (Int, String) =
  a match {
    case Arm(_, _, body) => (Parse.spanOff(body, moff), Str.fromInt(i))
  }

def branchArmsSites(arms: List[Arm], moff: Int): List[(Int, String)] =
  if (List.isEmpty(arms)) [] else List.concat(branchArmBodySites(List.at(arms, 0), moff), branchArmsSites(List.tail(arms), moff))

def branchArmBodySites(a: Arm, moff: Int): List[(Int, String)] =
  a match {
    case Arm(_, _, body) => branchSites(body, moff)
  }

def branchListSites(xs: List[Expr], parentOff: Int): List[(Int, String)] =
  if (List.isEmpty(xs)) [] else List.concat(branchSites(List.at(xs, 0), parentOff), branchListSites(List.tail(xs), parentOff))

def branchBindSites(bs: List[Bind], parentOff: Int): List[(Int, String)] =
  if (List.isEmpty(bs)) [] else List.concat(branchBindSite(List.at(bs, 0), parentOff), branchBindSites(List.tail(bs), parentOff))

def branchBindSite(b: Bind, parentOff: Int): List[(Int, String)] =
  b match {
    case Bind(_, _, value) => branchSites(value, parentOff)
  }

def score3(killed: Int, sites: Int): String =
  score3n(killed * 1000 / sites)

def score3n(n: Int): String =
  Str.concat(Str.fromInt(n / 1000), Str.concat(".", pad3(n % 1000)))

def pad3(n: Int): String =
  if (n < 10) Str.concat("00", Str.fromInt(n)) else if (n < 100) Str.concat("0", Str.fromInt(n)) else Str.fromInt(n)

def className(line: String): String =
  classTok(line, 0)

def classNums(line: String): String =
  Str.slice(line, nextSp(line, 0) + 1, Str.len(line))

def classTok(line: String, i: Int): String =
  if (i >= Str.len(line) || Str.charAt(line, i) == 32) Str.slice(line, 0, i) else classTok(line, i + 1)

def nextSp(line: String, i: Int): Int =
  if (i >= Str.len(line)) i else if (Str.charAt(line, i) == 32) i else nextSp(line, i + 1)

def classYes(rest: String): String =
  classTok(rest, 0)

def classNo(rest: String): String =
  classTok(classNums(rest), 0)

def mapSeed(ds: List[Fun]): List[String] =
  mapSeedE(ds, noEn())

def mapSeedE(ds: List[Fun], ens: List[En]): List[String] =
  if (List.isEmpty(ds)) noStr() else seedOfE(List.at(ds, 0), ens) :: mapSeedE(List.tail(ds), ens)

def seedOfE(d: Fun, ens: List[En]): String =
  if (List.isEmpty(d.params)) Str.concat("drive ", d.name) else Str.concat("drive ", Str.concat(d.name, Str.concat(" ", seedArgsE(d.params, ens))))

def seedArgsE(ps: List[Param], ens: List[En]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) seedArgE(List.at(ps, 0), ens) else Str.concat(seedArgE(List.at(ps, 0), ens), Str.concat(" ", seedArgsE(List.tail(ps), ens)))

def seedArgE(p: Param, ens: List[En]): String =
  if (p.ty == "Int") Str.fromInt(zeroInt(p.name, p.w)) else if (p.ty == "Bool") "false" else if (p.ty == "String") "\"a\"" else if (isListTy(p.ty)) "[]" else seedAdt(p.ty, ens)

def seedAdt(ty: String, ens: List[En]): String =
  seedHit(findEnTy(ens, ty), ty, ens)

def seedHit(hit: List[En], ty: String, ens: List[En]): String =
  if (List.isEmpty(hit)) "0" else seedEn(List.at(hit, 0), ens)

def seedEn(e: En, ens: List[En]): String =
  e match {
    case En(isRec, name, _, cases) => if (isRec || recLike(name, cases)) seedRec(name, cases, ens) else seedEnum(cases, ens)
  }

def seedRec(name: String, cs: List[EnCase], ens: List[En]): String =
  if (List.isEmpty(cs)) name else seedCase(List.at(cs, 0), ens)

def seedEnum(cs: List[EnCase], ens: List[En]): String =
  seedEnumHit(leafCases(cs), cs, ens)

def seedEnumHit(leaf: List[EnCase], all: List[EnCase], ens: List[En]): String =
  if (List.isEmpty(leaf)) seedCase(List.at(all, 0), ens) else seedCase(List.at(leaf, 0), ens)

def seedCase(c: EnCase, ens: List[En]): String =
  c match {
    case EnCase(name, fs) => seedCtor(name, fs, ens)
  }

def seedCtor(name: String, fs: List[Param], ens: List[En]): String =
  if (List.isEmpty(fs)) Str.concat(Resolve.short(name), "()") else Str.concat(Resolve.short(name), Str.concat("(", Str.concat(seedFields(fs, ens), ")")))

def seedFields(fs: List[Param], ens: List[En]): String =
  if (List.isEmpty(fs)) "" else if (List.len(fs) == 1) seedArgE(List.at(fs, 0), ens) else Str.concat(seedArgE(List.at(fs, 0), ens), Str.concat(",", seedFields(List.tail(fs), ens)))

def mapSpec(ds: List[Fun]): List[String] =
  mapSpecE(ds, noEn())

def mapSpecE(ds: List[Fun], ens: List[En]): List[String] =
  if (List.isEmpty(ds)) noStr() else specOfE(List.at(ds, 0), ens) :: mapSpecE(List.tail(ds), ens)

def parseVerify(src: String): List[Fun] =
  parseVerifyEns(src, noEn())

def parseVerifyEns(src: String, ens: List[En]): List[Fun] =
  parseVerifyProg(Parse.parse(Lexer.lex(src)), ens)

def parseVerifyProg(p: Prog, ens: List[En]): List[Fun] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => drives(defs, ens)
  }

def parseClaims(src: String): List[Fun] =
  parseClaimsProg(Parse.parse(Lexer.lex(src)))

def parseClaimsProg(p: Prog): List[Fun] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => claims(defs)
  }

def claims(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else claims1(List.at(ds, 0), List.tail(ds))

def claims1(d: Fun, rest: List[Fun]): List[Fun] =
  if (isClaim(d)) d :: claims(rest) else claims(rest)

def wrapMod(): String =
  "__verify"

def wrapSrc(stem: String, src: String): String =
  wrapSrcEns(stem, src, noEn())

def wrapSrcEns(stem: String, src: String, ens: List[En]): String =
  wrapVerifyProg(stem, Parse.parse(Lexer.lex(src)), ens)

def wrapVerifyProg(stem: String, p: Prog, ens: List[En]): String =
  p match {
    case Prog(pkg, enums, aliases, traits, impls, imps, defs, main, body) => Str.concat(Parse.pretty(Prog(pkg, enums, aliases, traits, impls, imps, List.filter(defs, d => d.priv), main, body, p.mod)), Str.concat(wrapFuns(stem, drives(defs, ens)), wrapRelFuns(claims(defs))))
  }

def wrapFuns(stem: String, ds: List[Fun]): String =
  if (List.isEmpty(ds)) "" else Str.concat(wrapFun(stem, List.at(ds, 0)), wrapFuns(stem, List.tail(ds)))

def wrapFun(_stem: String, d: Fun): String =
  d match {
    case Fun(_, _, name, _, ps, _, body, _, _) => wrapFunBody(name, wrapPs(ps), body)
  }

def wrapFunBody(name: String, ps: String, body: Expr): String =
  body match {
    case Expr.EBin(op, l, r, _) => if (op == "==" && (scalarEqOperand(l) || scalarEqOperand(r))) wrapEq(name, ps, l, r) else wrapFun2(name, ps, Parse.pretty0(body))
    case _ => wrapFun2(name, ps, Parse.pretty0(body))
  }

def scalarEqOperand(e: Expr): Bool =
  e match {
    case Expr.EInt(_, _) => true
    case Expr.EStr(_, _) => true
    case Expr.EBool(_) => true
    case Expr.EFloat(_, _) => true
    case Expr.EBin(op, _, _, _) => op != "::"
    case Expr.EUn(_, _, _) => true
    case _ => false
  }

def wrapEq(name: String, ps: String, l: Expr, r: Expr): String =
  Str.concat("def _drv_", Str.concat(name, Str.concat("(", Str.concat(ps, Str.concat("""): IO[Unit] =
  for {
    oraL = """, Str.concat(Parse.pretty0(l), Str.concat("""
    oraR = """, Str.concat(Parse.pretty0(r), Str.concat("\n    _ <- if (oraL == oraR) IO.pure(()) else IO.println(s\"oracle ", Str.concat(name, Str.concat(" rejected left=$oraL right=$oraR\").flatMap(_ => Property.assert(\"", Str.concat(name, "\", false))\n  } yield ()\n"))))))))))))

def wrapFun2(name: String, ps: String, body: String): String =
  Str.concat("def _drv_", Str.concat(name, Str.concat("(", Str.concat(ps, Str.concat("): IO[Unit] =\n  Property.assert(\"", Str.concat(name, Str.concat("\", ", Str.concat(body, """)
"""))))))))

def wrapPs(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) wrapP(List.at(ps, 0)) else Str.concat(wrapP(List.at(ps, 0)), Str.concat(", ", wrapPs(List.tail(ps))))

def wrapP(p: Param): String =
  p match {
    case Param(n, ty, _, _) => Str.concat(n, Str.concat(": ", ty))
  }

def wrapRelFuns(ds: List[Fun]): String =
  if (List.isEmpty(ds)) "" else Str.concat(wrapRel(List.at(ds, 0)), wrapRelFuns(List.tail(ds)))

def wrapRel(d: Fun): String =
  d match {
    case Fun(_, _, name, _, ps, _, body, _, _) => wrapRel2(name, wrapPs(ps), Parse.pretty0(body))
  }

def wrapRel2(name: String, ps: String, body: String): String =
  Str.concat("def ", Str.concat(name, Str.concat("(", Str.concat(ps, Str.concat("""): Verdict =
  """, Str.concat(body, """

"""))))))

def wrapFilesEns(files: List[(String, String)], ens: List[En]): String =
  if (List.isEmpty(files)) "" else wrapFilesEns2(List.at(files, 0), List.tail(files), ens)

def wrapFilesEns2(h: (String, String), rest: List[(String, String)], ens: List[En]): String =
  h match {
    case (stem, src) => Str.concat(wrapSrcEns(stem, src, ens), wrapFilesEns(rest, ens))
  }

def applySimLive(live: Prog, sdefs: List[Fun]): String =
  live match {
    case Prog(pkg, enums, aliases, traits, impls, imps, defs, main, body) => Parse.pretty(Prog(pkg, enums, aliases, traits, impls, imps, swapDefs(defs, sdefs), main, body, live.mod))
  }

def swapDefs(ds: List[Fun], sim: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) ds else pickSim(List.at(ds, 0), sim) :: swapDefs(List.tail(ds), sim)

def pickSim(d: Fun, sim: List[Fun]): Fun =
  if (List.isEmpty(sim)) d else pickSim1(d, List.at(sim, 0), List.tail(sim))

def pickSim1(d: Fun, s: Fun, rest: List[Fun]): Fun =
  if (d.name == s.name) s else pickSim(d, rest)

def hasDot(name: String): Bool =
  findIdx(name, ".", 0) >= 0

def replMod(name: String): String =
  replSplit(name, findIdx(name, ".", 0), true)

def replLocal(name: String): String =
  replSplit(name, findIdx(name, ".", 0), false)

def replSplit(name: String, i: Int, left: Bool): String =
  if (i < 0) if (left) "" else name else if (left) Str.slice(name, 0, i) else Str.slice(name, i + 1, Str.len(name))

def applyScenarioFiles(files: List[(String, String)], src: String): List[(String, String)] =
  if (src == "") files else applyScenarioGo(files, replFuns(Parse.parse(Lexer.lex(src))))

def replFuns(p: Prog): List[Fun] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => replDefs(defs)
  }

def replDefs(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else replDefs1(List.at(ds, 0), List.tail(ds))

def replDefs1(d: Fun, rest: List[Fun]): List[Fun] =
  if (hasDot(d.name)) d :: replDefs(rest) else replDefs(rest)

def applyScenarioGo(files: List[(String, String)], repls: List[Fun]): List[(String, String)] =
  if (List.isEmpty(files)) files else applyScenarioHd(List.at(files, 0), List.tail(files), repls)

def applyScenarioHd(h: (String, String), rest: List[(String, String)], repls: List[Fun]): List[(String, String)] =
  h match {
    case (stem, src) => applyScenarioStem(stem, src, rest, repls, replsFor(stem, repls))
  }

def applyScenarioStem(stem: String, src: String, rest: List[(String, String)], repls: List[Fun], locals: List[Fun]): List[(String, String)] =
  (stem, if (List.isEmpty(locals)) src else applySimLive(Parse.parse(Lexer.lex(src)), locals)) :: applyScenarioGo(rest, repls)

def replsFor(stem: String, repls: List[Fun]): List[Fun] =
  if (List.isEmpty(repls)) noFun() else replsFor1(List.at(repls, 0), List.tail(repls), stem)

def replsFor1(d: Fun, rest: List[Fun], stem: String): List[Fun] =
  if (replMod(d.name) == stem) localRepl(d) :: replsFor(stem, rest) else replsFor(stem, rest)

def localRepl(d: Fun): Fun =
  d match {
    case Fun(priv, ora, name, ts, ps, ret, body, mod, off) => Fun(priv, ora, replLocal(name), ts, ps, ret, body, mod, off)
  }

def scenarioWrap(src: String): String =
  if (src == "") "" else scenarioWrapProg(Parse.parse(Lexer.lex(src)))

def scenarioWrapProg(p: Prog): String =
  p match {
    case Prog(_, enums, _, _, _, _, defs, _, _) => Parse.pretty(Prog("", enums, Parse.noAl(), Parse.noTr(), Parse.noIm(), Parse.noImp(), wrapScenarioDefs(defs, ctxTyOf(defs)), "", Expr.EUnit, ""))
  }

def ctxTyOf(ds: List[Fun]): String =
  ctxTyHit(setupOf(ds))

def setupOf(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else setupOf1(List.at(ds, 0), List.tail(ds))

def setupOf1(d: Fun, rest: List[Fun]): List[Fun] =
  if (!d.priv && d.name == "setup") d :: noFun() else setupOf(rest)

def ctxTyHit(hit: List[Fun]): String =
  if (List.isEmpty(hit)) "" else ctxTyFun(List.at(hit, 0))

def ctxTyFun(d: Fun): String =
  if (Check.isIo(d.ret)) Check.ioOk(d.ret) else ""

def isCtxTy(t: String): Bool =
  t != "" && t != "Unit" && t != "Int" && t != "String" && t != "Bool" && !isListTy(t)

def wrapScenarioDefs(ds: List[Fun], ctxTy: String): List[Fun] =
  if (List.isEmpty(ds)) noFun() else List.concat(wrapScenarioOne(List.at(ds, 0), ctxTy), wrapScenarioDefs(List.tail(ds), ctxTy))

def wrapScenarioOne(d: Fun, ctxTy: String): List[Fun] =
  if (hasDot(d.name)) noFun() else if (d.priv || d.name == "setup" || !isCtxDriver(d, ctxTy)) d :: noFun() else wrapCtxDriver(d)

def isCtxDriver(d: Fun, ctxTy: String): Bool =
  isCtxTy(ctxTy) && Check.isIo(d.ret) && !d.priv && !List.isEmpty(d.params) && headTy(d.params) == ctxTy

def headTy(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else List.at(ps, 0) match {
  case Param(_, ty, _, _) => ty
}

def wrapCtxDriver(d: Fun): List[Fun] =
  d match {
    case Fun(_, _, name, ts, ps, ret, body, _, off) => Fun(true, false, Str.concat("_scn_", name), ts, ps, ret, body, "", off) :: Fun(false, false, name, ts, List.tail(ps), ret, wrapCall(d), "", off) :: noFun()
  }

def wrapCall(d: Fun): Expr =
  Expr.ECall(Str.concat("_scn_", d.name), Expr.ECall("Scenario.context", noExpr(), d.off) :: paramVars(List.tail(d.params), d.off), d.off)

def paramVars(ps: List[Param], off: Int): List[Expr] =
  if (List.isEmpty(ps)) noExpr() else paramVar(List.at(ps, 0), off) :: paramVars(List.tail(ps), off)

def paramVar(p: Param, off: Int): Expr =
  p match {
    case Param(n, _, _, _) => Expr.EVar(n, off)
  }

def scenarioFaults(src: String): List[(Int, Int)] =
  if (src == "") noFaults() else scenarioFaultsGo(Parse.parse(Lexer.lex(src)))

def noFaults(): List[(Int, Int)] =
  []

def scenarioFaultsGo(p: Prog): List[(Int, Int)] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => faultPairs(faultsEntries(defs))
  }

def faultsEntries(ds: List[Fun]): List[String] =
  if (List.isEmpty(ds)) noStr() else faultsEntries1(List.at(ds, 0), List.tail(ds))

def faultsEntries1(d: Fun, rest: List[Fun]): List[String] =
  if (d.name == "faults") faultEntryLits(d.body) else faultsEntries(rest)

def faultEntryLits(e: Expr): List[String] =
  e match {
    case Expr.EList(xs) => faultStrLits(xs)
    case _ => noStr()
  }

def faultStrLits(xs: List[Expr]): List[String] =
  if (List.isEmpty(xs)) noStr() else List.concat(faultStrLit(List.at(xs, 0)), faultStrLits(List.tail(xs)))

def faultStrLit(x: Expr): List[String] =
  x match {
    case Expr.EStr(s, _) => s :: noStr()
    case _ => noStr()
  }

def faultPair(s: String): List[(Int, Int)] =
  if (s == "fs" || s == "fs:fail") (1, 0) :: noFaults() else if (s == "fs:drop") (1, 1) :: noFaults() else if (s == "fs:corrupt") (1, 2) :: noFaults() else if (s == "net" || s == "net:fail") (2, 0) :: noFaults() else if (s == "net:drop") (2, 1) :: noFaults() else if (s == "net:corrupt") (2, 2) :: noFaults() else if (s == "queue" || s == "queue:fail") (3, 0) :: noFaults() else if (s == "queue:drop") (3, 1) :: noFaults() else if (s == "queue:corrupt") (3, 2) :: noFaults() else noFaults()

def faultPairs(xs: List[String]): List[(Int, Int)] =
  if (List.isEmpty(xs)) noFaults() else List.concat(faultPair(List.at(xs, 0)), faultPairs(List.tail(xs)))

def faultEntryOk(s: String): Bool =
  !List.isEmpty(faultPair(s))

def faultSeedPhase(kind: Int, mode: Int, n: Int, phase: Int): String =
  Str.fromInt(1 + (kind - 1) + 3 * mode + 9 * (n - 1) + 144 * phase)

def faultRule(src: String, file: String, p: Prog): String =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => faultRuleDefs(src, file, defs)
  }

def faultRuleDefs(src: String, file: String, ds: List[Fun]): String =
  if (List.isEmpty(ds)) "" else faultRuleHd(src, file, List.at(ds, 0), List.tail(ds))

def faultRuleHd(src: String, file: String, d: Fun, rest: List[Fun]): String =
  if (d.name != "faults") faultRuleDefs(src, file, rest) else faultRuleDef(src, file, d)

def faultRuleDef(src: String, file: String, d: Fun): String =
  if (d.priv || !List.isEmpty(d.params) || d.ret != "List[String]") atLoc(file, src, d.off, "faults must be a public def faults(): List[String]") else faultRuleBody(src, file, d)

def faultRuleBody(src: String, file: String, d: Fun): String =
  d.body match {
    case Expr.EList(xs) => faultRuleEntries(src, file, d, xs)
    case _ => atLoc(file, src, d.off, "faults must be a list of string literals")
  }

def faultRuleEntries(src: String, file: String, d: Fun, xs: List[Expr]): String =
  if (List.isEmpty(xs)) "" else faultRuleEntry(src, file, d, List.at(xs, 0), List.tail(xs))

def faultRuleEntry(src: String, file: String, d: Fun, x: Expr, rest: List[Expr]): String =
  x match {
    case Expr.EStr(s, _) => if (faultEntryOk(s)) faultRuleEntries(src, file, d, rest) else atLoc(file, src, d.off, Str.concat("faults entry ", Str.concat(s, " must be fs, net, or queue with an optional :fail, :drop, or :corrupt mode")))
    case _ => atLoc(file, src, d.off, "faults must be a list of string literals")
  }

def scenarioDrvNames(src: String): List[String] =
  if (src == "") noStr() else scenarioDrvNamesGo(Parse.parse(Lexer.lex(src)))

def scenarioDrvNamesGo(p: Prog): List[String] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => scenarioIoNames(defs)
  }

def scenarioIoNames(ds: List[Fun]): List[String] =
  if (List.isEmpty(ds)) noStr() else scenarioIoNames1(List.at(ds, 0), List.tail(ds))

def scenarioIoNames1(d: Fun, rest: List[Fun]): List[String] =
  if (!d.priv && d.name != "setup" && !hasDot(d.name) && ioRet(d)) d.name :: scenarioIoNames(rest) else scenarioIoNames(rest)

def simLeftoverMsg(file: String): String =
  Str.concat(file, ":1:1: error: leftover *.scuzz_sim; move replacements into *.scuzz_scenario or delete the file")

def drvLeftoverMsg(file: String): String =
  Str.concat(file, ":1:1: error: leftover *.scuzz_drivers; move drivers into *.scuzz_scenario or delete the file")

def manyScenarioMsg(): String =
  "scuzz.toml:1:1: error: at most one *.scuzz_scenario file is allowed"

def checkScenario(src: String, file: String, live: List[(String, String)]): String =
  if (isBlank(src)) emptyScenario(file) else checkScenarioProg(src, file, live, Parse.parse(Lexer.lex(src)))

def emptyScenario(file: String): String =
  Str.concat(file, ":1:1: error: scenario file needs a setup entrypoint")

def checkScenarioProg(src: String, file: String, live: List[(String, String)], p: Prog): String =
  if (p.main != "") Str.concat(file, ":1:1: error: scenario file must not define @main") else if (!List.isEmpty(p.aliases)) Str.concat(file, ":1:1: error: scenario file must not define aliases") else if (!List.isEmpty(p.traits)) Str.concat(file, ":1:1: error: scenario file must not define traits") else if (!List.isEmpty(p.impls)) Str.concat(file, ":1:1: error: scenario file must not define impls") else if (!List.isEmpty(p.imps)) Str.concat(file, ":1:1: error: scenario file must not define imports") else checkScenarioBody(src, file, live, p)

def checkScenarioBody(src: String, file: String, live: List[(String, String)], p: Prog): String =
  if (defsHaveForbid(p.defs) || exprHasForbid(p.body)) Str.concat(file, ":1:1: error: scenario bodies must not call Property.* or .require") else if (faultRule(src, file, p) != "") faultRule(src, file, p) else checkScenarioSetup(src, file, live, p)

def checkScenarioSetup(src: String, file: String, live: List[(String, String)], p: Prog): String =
  checkScenarioSetup2(src, file, live, p, setupOf(p.defs))

def checkScenarioSetup2(src: String, file: String, live: List[(String, String)], p: Prog, setups: List[Fun]): String =
  if (List.isEmpty(setups)) emptyScenario(file) else if (!List.isEmpty(List.tail(setups))) Str.concat(file, ":1:1: error: scenario file must define one setup") else checkScenarioSetup3(src, file, live, p, List.at(setups, 0))

def checkScenarioSetup3(src: String, file: String, live: List[(String, String)], p: Prog, d: Fun): String =
  if (!Check.isIo(d.ret)) atLoc(file, src, d.off, "setup must return IO") else if (!List.isEmpty(d.params)) atLoc(file, src, d.off, "setup takes no generated params") else checkScenarioPublics(src, file, live, p, ctxTyFun(d), p.defs)

def checkScenarioPublics(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, ds: List[Fun]): String =
  if (List.isEmpty(ds)) checkScenarioReplDup(src, file, p) else checkScenarioPub(src, file, live, p, ctxTy, List.at(ds, 0), List.tail(ds))

def checkScenarioPub(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun]): String =
  if (d.priv) checkScenarioPublics(src, file, live, p, ctxTy, rest) else checkScenarioPub2(src, file, live, p, ctxTy, d, rest)

def checkScenarioPub2(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun]): String =
  if (d.name == "setup" || d.name == "faults") checkScenarioPublics(src, file, live, p, ctxTy, rest) else if (hasDot(d.name)) checkScenarioRepl(src, file, live, p, ctxTy, d, rest) else if (Check.isIo(d.ret)) checkScenarioDrv(src, file, live, p, ctxTy, d, rest) else atLoc(file, src, d.off, Str.concat("public def ", Str.concat(d.name, " is not setup, a replacement, or a driver")))

def checkScenarioRepl(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun]): String =
  if (!Check.isIo(d.ret)) atLoc(file, src, d.off, "replacement must be IO") else checkScenarioRepl2(src, file, live, p, ctxTy, d, rest, liveFunOf(live, replMod(d.name), replLocal(d.name)))

def checkScenarioRepl2(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun], hit: List[Fun]): String =
  if (List.isEmpty(hit)) atLoc(file, src, d.off, Str.concat("replacement ", Str.concat(d.name, " has no production target"))) else checkScenarioRepl3(src, file, live, p, ctxTy, d, rest, List.at(hit, 0))

def checkScenarioRepl3(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun], liveD: Fun): String =
  if (!Check.isIo(liveD.ret)) atLoc(file, src, d.off, Str.concat("cannot replace pure helper ", d.name)) else if (isViewOrSig(liveD.ret)) atLoc(file, src, d.off, Str.concat("cannot replace View or Signal ", d.name)) else if (!sigEq(d, liveD)) atLoc(file, src, d.off, Str.concat("replacement ", Str.concat(d.name, " signature does not match production"))) else checkScenarioPublics(src, file, live, p, ctxTy, rest)

def isViewOrSig(t: String): Bool =
  t == "View" || Str.startsWith(t, "Signal")

def sigEq(a: Fun, b: Fun): Bool =
  a.ret == b.ret && paramTysEq(a.params, b.params)

def paramTysEq(a: List[Param], b: List[Param]): Bool =
  List.len(a) == List.len(b) && paramTysEqGo(a, b)

def paramTysEqGo(a: List[Param], b: List[Param]): Bool =
  if (List.isEmpty(a)) true else headTy(a) == headTy(b) && paramTysEq(List.tail(a), List.tail(b))

def liveFunOf(files: List[(String, String)], mod: String, name: String): List[Fun] =
  liveFunGo(liveFuns(files), mod, name)

def liveFuns(files: List[(String, String)]): List[Fun] =
  if (List.isEmpty(files)) noFun() else liveFunsHd(List.at(files, 0), List.tail(files))

def liveFunsHd(h: (String, String), rest: List[(String, String)]): List[Fun] =
  h match {
    case (stem, src) => List.concat(Parse.stampFuns(stem, Parse.parse(Lexer.lex(src)).defs), liveFuns(rest))
  }

def liveFunGo(ds: List[Fun], mod: String, name: String): List[Fun] =
  if (List.isEmpty(ds)) noFun() else liveFunGo1(List.at(ds, 0), List.tail(ds), mod, name)

def liveFunGo1(d: Fun, rest: List[Fun], mod: String, name: String): List[Fun] =
  if (d.name == name && d.mod == mod) d :: noFun() else liveFunGo(rest, mod, name)

def checkScenarioDrv(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun]): String =
  if (isCtxTy(ctxTy) && (List.isEmpty(d.params) || headTy(d.params) != ctxTy)) atLoc(file, src, d.off, Str.concat("driver ", Str.concat(d.name, Str.concat(" must take ", Str.concat(ctxTy, " as the first param"))))) else checkScenarioDrv2(src, file, live, p, ctxTy, d, rest, drvGenPs(d.params, ctxTy))

def checkScenarioDrv2(src: String, file: String, live: List[(String, String)], p: Prog, ctxTy: String, d: Fun, rest: List[Fun], ps: List[Param]): String =
  if (List.len(ps) > 3 || !allFriendly(ps, ensOfResolved(Resolve.prog(p))) || !unaryAdtOk(ps) || !allSimpleWhere(ps)) atLoc(file, src, d.off, Str.concat("drive ", Str.concat(d.name, " params must be generator-friendly (at most 3; ADT or List only as the sole param)"))) else checkScenarioPublics(src, file, live, p, ctxTy, rest)

def drvGenPs(ps: List[Param], ctxTy: String): List[Param] =
  if (isCtxTy(ctxTy) && !List.isEmpty(ps) && headTy(ps) == ctxTy) List.tail(ps) else ps

def checkScenarioReplDup(src: String, file: String, p: Prog): String =
  checkScenarioReplDup2(src, file, p, dupName(sortStrs(replTargets(replFuns(p)))))

def replTargets(ds: List[Fun]): List[String] =
  if (List.isEmpty(ds)) noStr() else List.at(ds, 0).name :: replTargets(List.tail(ds))

def checkScenarioReplDup2(src: String, file: String, p: Prog, dup: String): String =
  if (dup != "") Str.concat(file, Str.concat(":1:1: error: replacement ", Str.concat(dup, " is declared more than once"))) else checkScenarioFmt(src, file, p)

def checkScenarioFmt(src: String, file: String, p: Prog): String =
  if (Parse.pretty(p) == src) "scuzz check ok" else fmtMsg(file)

def noExpr(): List[Expr] =
  []

def noParam(): List[Param] =
  []

def noBind(): List[Bind] =
  []

def noKept(): List[(String, String, Prog)] =
  []

def parseKept(files: List[(String, String)]): List[(String, String, Prog)] =
  if (List.isEmpty(files)) noKept() else parseKeptHd(List.at(files, 0), List.tail(files))

def parseKeptHd(h: (String, String), rest: List[(String, String)]): List[(String, String, Prog)] =
  h match {
    case (stem, src) => (stem, src, Parse.parseFile(stem, src)) :: parseKept(rest)
  }

def mergeKept(kept: List[(String, String, Prog)]): Prog =
  mergeKeptGo(kept, Parse.emptyProg())

def mergeKeptGo(kept: List[(String, String, Prog)], acc: Prog): Prog =
  if (List.isEmpty(kept)) acc else mergeKeptHd(List.at(kept, 0), List.tail(kept), acc)

def mergeKeptHd(h: (String, String, Prog), rest: List[(String, String, Prog)], acc: Prog): Prog =
  h match {
    case (_, _, p) => mergeKeptGo(rest, Parse.merge(acc, p))
  }

def rewriteReqFiles(files: List[(String, String)]): List[(String, String)] =
  rewriteReqFromKept(parseKept(files))

def rewriteReqFromKept(kept: List[(String, String, Prog)]): List[(String, String)] =
  rewriteReqResolved(kept, Resolve.prog(mergeKept(kept)))

def rewriteReqResolved(kept: List[(String, String, Prog)], p: Prog): List[(String, String)] =
  rewriteReqKeptGo(resolveKept(kept, p), p.copy(defs = Check.expandDefs(p.defs, p.aliases), enums = Check.expandEnums(p.enums, p.aliases)))

def resolveKept(kept: List[(String, String, Prog)], p: Prog): List[(String, String, Prog)] =
  List.map(kept, entry => (entry._1, entry._2, resolveKeptProg(Resolve.program(entry._3, Resolve.indexOf(p)), p.aliases)))

def resolveKeptProg(p: Prog, aliases: List[Alias]): Prog =
  p.copy(enums = Check.expandEnums(p.enums, aliases), defs = Check.expandDefs(p.defs, aliases), body = Check.expandExpr(p.body, aliases), impls = List.map(p.impls, im => im.copy(methods = Check.expandDefs(im.methods, aliases))))

def makeRewriteCtx(funs: List[Fun], ens: List[En], ambig: Set[String]): RewriteCtx =
  for {
    pins = Check.withLetterPins(ens)
  } yield RewriteCtx(Check.ftabOfList(funs), funs, pins, whereShortSet(funs, ens), ambig)

def whereShortSet(funs: List[Fun], ens: List[En]): Set[String] =
  enWhereShortSet(ens, funWhereShortSet(funs, Set.empty()))

def funWhereShortSet(ds: List[Fun], acc: Set[String]): Set[String] =
  if (List.isEmpty(ds)) acc else for {
  d = List.at(ds, 0)
  next = if (!d.ora && paramsHaveWhere(d.params)) Set.add(acc, Resolve.short(d.name)) else acc
} yield funWhereShortSet(List.tail(ds), next)

def enWhereShortSet(ens: List[En], acc: Set[String]): Set[String] =
  if (List.isEmpty(ens)) acc else for {
  en = List.at(ens, 0)
  next = if (en.isRec || recLike(en.name, en.cases)) if (paramsHaveWhere(firstCaseParams(en.cases))) Set.add(acc, Resolve.short(en.name)) else acc else caseWhereShortSet(en.cases, acc)
} yield enWhereShortSet(List.tail(ens), next)

def caseWhereShortSet(cs: List[EnCase], acc: Set[String]): Set[String] =
  if (List.isEmpty(cs)) acc else for {
  c = List.at(cs, 0)
  next = if (paramsHaveWhere(c.fields)) Set.add(acc, Resolve.short(c.name)) else acc
} yield caseWhereShortSet(List.tail(cs), next)

def rewriteReqKeptGo(kept: List[(String, String, Prog)], p: Prog): List[(String, String)] =
  p match {
    case Prog(_, enums, _, _, _, _, defs, _, _) => for {
  ftab = Check.ftabOfList(defs)
  ambig = ambiguousKeysKeptWith(kept, ftab, defs, enums)
  ctx = RewriteCtx(ftab, defs, Check.withLetterPins(enums), whereShortSet(defs, enums), ambig)
} yield rewriteReqKeptFiles(kept, ctx)
  }

def rewriteReqKeptFiles(kept: List[(String, String, Prog)], ctx: RewriteCtx): List[(String, String)] =
  if (List.isEmpty(kept)) Manifest.noPairs() else rewriteReqKeptHd(List.at(kept, 0), List.tail(kept), ctx)

def rewriteReqKeptHd(h: (String, String, Prog), rest: List[(String, String, Prog)], ctx: RewriteCtx): List[(String, String)] =
  h match {
    case (stem, src, fp) => (stem, rewriteReqKeepCtx(src, fp, stem, ctx)) :: rewriteReqKeptFiles(rest, ctx)
  }

def rewriteReqKeepCtx(src: String, p: Prog, stem: String, ctx: RewriteCtx): String =
  if (progNeedsRewriteCtx(p, stem, ctx)) Resolve.source(rewriteReqTreeCtx(p, stem, ctx)) else src

def progNeedsRewriteCtx(p: Prog, stem: String, ctx: RewriteCtx): Bool =
  progHasReq(p) || progNeedsWhereCtx(p, stem, ctx) || progHasTaggedProp(p, stem, ctx.ambig)

def expectedFromKept(kept: List[(String, String, Prog)]): Prog =
  expectedFromResolved(kept, Resolve.prog(mergeKept(kept)))

def expectedFromResolved(kept: List[(String, String, Prog)], p: Prog): Prog =
  expectedFromKeptP(resolveKept(kept, p), p.copy(defs = Check.expandDefs(p.defs, p.aliases), enums = Check.expandEnums(p.enums, p.aliases)))

def expectedFromKeptP(kept: List[(String, String, Prog)], p: Prog): Prog =
  p match {
    case Prog(_, enums, _, _, _, _, defs, _, _) => for {
  ftab = Check.ftabOfList(defs)
  ambig = ambiguousKeysKeptWith(kept, ftab, defs, enums)
  ctx = RewriteCtx(ftab, defs, Check.withLetterPins(enums), whereShortSet(defs, enums), ambig)
} yield expectedFromKeptCtx(kept, ctx)
  }

def expectedFromKeptCtx(kept: List[(String, String, Prog)], ctx: RewriteCtx): Prog =
  if (keptNeedsRewriteCtx(kept, ctx)) mergeKept(rewriteKeptTreesCtx(kept, ctx)) else Parse.parseFiles(List.map(kept, entry => (entry._1, entry._2)))

def keptNeedsRewriteCtx(kept: List[(String, String, Prog)], ctx: RewriteCtx): Bool =
  if (List.isEmpty(kept)) false else keptNeedsRewriteHd(List.at(kept, 0), List.tail(kept), ctx)

def keptNeedsRewriteHd(h: (String, String, Prog), rest: List[(String, String, Prog)], ctx: RewriteCtx): Bool =
  h match {
    case (stem, _, fp) => progNeedsRewriteCtx(fp, stem, ctx) || keptNeedsRewriteCtx(rest, ctx)
  }

def rewriteKeptTreesCtx(kept: List[(String, String, Prog)], ctx: RewriteCtx): List[(String, String, Prog)] =
  if (List.isEmpty(kept)) noKept() else rewriteKeptHd(List.at(kept, 0), List.tail(kept), ctx)

def rewriteKeptHd(h: (String, String, Prog), rest: List[(String, String, Prog)], ctx: RewriteCtx): List[(String, String, Prog)] =
  h match {
    case (stem, src, fp) => (stem, src, rewriteReqKeepProgCtx(src, fp, stem, ctx)) :: rewriteKeptTreesCtx(rest, ctx)
  }

def rewriteReqKeepProgCtx(src: String, p: Prog, stem: String, ctx: RewriteCtx): Prog =
  if (progNeedsRewriteCtx(p, stem, ctx)) Parse.parseFile(stem, Resolve.source(rewriteReqTreeCtx(p, stem, ctx))) else Parse.parseFile(stem, src)

def expectedTreeOk(): Bool =
  expectedTreeSrc("def n(): Int = 1") && expectedTreeSrc("def n(): Int = 1.require(true)") && parseEvLit()

def parseEvLit(): Bool =
  List.at(parseEvents("events = [\"hi\"]"), 0) == "hi" && List.at(parseEvents("events = [\"ab\"]"), 0) == "ab"

def expectedTreeSrc(src: String): Bool =
  expectedTreeFiles(("Main", src) :: Manifest.noPairs())

def expectedTreeFiles(files: List[(String, String)]): Bool =
  expectedTreeKept(parseKept(files))

def expectedTreeKept(kept: List[(String, String, Prog)]): Bool =
  Parse.pretty(expectedFromKept(kept)) == Parse.pretty(Parse.parseFiles(rewriteReqFromKept(kept)))

def progHasReq(p: Prog): Bool =
  p match {
    case Prog(_, _, _, _, impls, _, defs, _, body) => exprHasReq(body) || defsHaveReq(defs) || implsHaveReq(impls)
  }

def implsHaveReq(xs: List[Im]): Bool =
  if (List.isEmpty(xs)) false else imHasReq(List.at(xs, 0)) || implsHaveReq(List.tail(xs))

def imHasReq(im: Im): Bool =
  im match {
    case Im(_, _, _, methods) => defsHaveReq(methods)
  }

def exprMayTouchWhere(e: Expr, wn: Set[String]): Bool =
  if (List.isEmpty(Set.toList(wn))) false else exprMayTouchWhereGo(e, wn)

def exprMayTouchWhereGo(e: Expr, wn: Set[String]): Bool =
  e match {
    case Expr.EPrint(inner, _) => exprMayTouchWhereGo(inner, wn)
    case Expr.ECall(f, args, _) => Set.contains(wn, Resolve.short(f)) || listMayTouchWhere(args, wn)
    case Expr.EMethod(recv, name, args, _) => Set.contains(wn, name) || exprMayTouchWhereGo(recv, wn) || listMayTouchWhere(args, wn)
    case Expr.EField(recv, _, _) => exprMayTouchWhereGo(recv, wn)
    case Expr.EBin(_, l, r, _) => exprMayTouchWhereGo(l, wn) || exprMayTouchWhereGo(r, wn)
    case Expr.EUn(_, inner, _) => exprMayTouchWhereGo(inner, wn)
    case Expr.ELam(_, _, body) => exprMayTouchWhereGo(body, wn)
    case Expr.EIf(c, t, el, _) => exprMayTouchWhereGo(c, wn) || exprMayTouchWhereGo(t, wn) || exprMayTouchWhereGo(el, wn)
    case Expr.EMatch(s, arms, _) => exprMayTouchWhereGo(s, wn) || armsMayTouchWhere(arms, wn)
    case Expr.EInterp(_, parts, _) => listMayTouchWhere(parts, wn)
    case Expr.EList(xs) => listMayTouchWhere(xs, wn)
    case Expr.ETuple(xs) => listMayTouchWhere(xs, wn)
    case Expr.ENamed(_, inner) => exprMayTouchWhereGo(inner, wn)
    case Expr.EAscribe(inner, _, _) => exprMayTouchWhereGo(inner, wn)
    case Expr.EFor(bs, body, _) => bindsMayTouchWhere(bs, wn) || exprMayTouchWhereGo(body, wn)
    case _ => false
  }

def listMayTouchWhere(xs: List[Expr], wn: Set[String]): Bool =
  if (List.isEmpty(xs)) false else exprMayTouchWhereGo(List.at(xs, 0), wn) || listMayTouchWhere(List.tail(xs), wn)

def armsMayTouchWhere(xs: List[Arm], wn: Set[String]): Bool =
  if (List.isEmpty(xs)) false else exprMayTouchWhereGo(List.at(xs, 0).body, wn) || armsMayTouchWhere(List.tail(xs), wn)

def bindsMayTouchWhere(xs: List[Bind], wn: Set[String]): Bool =
  if (List.isEmpty(xs)) false else exprMayTouchWhereGo(List.at(xs, 0).value, wn) || bindsMayTouchWhere(List.tail(xs), wn)

def exprHasRuleExpr(e: Expr): Bool =
  e match {
    case Expr.EPrint(inner, _) => exprHasRuleExpr(inner)
    case Expr.ECall(f, args, _) => isPropRuleCall(f, args) || listHasRuleExpr(args)
    case Expr.EMethod(recv, name, args, _) => name == "require" || exprHasRuleExpr(recv) || listHasRuleExpr(args)
    case Expr.EField(recv, _, _) => exprHasRuleExpr(recv)
    case Expr.EBin(_, l, r, _) => exprHasRuleExpr(l) || exprHasRuleExpr(r)
    case Expr.EUn(_, inner, _) => exprHasRuleExpr(inner)
    case Expr.ELam(_, _, body) => exprHasRuleExpr(body)
    case Expr.EIf(c, t, el, _) => exprHasRuleExpr(c) || exprHasRuleExpr(t) || exprHasRuleExpr(el)
    case Expr.EMatch(s, arms, _) => exprHasRuleExpr(s) || armsHaveRuleExpr(arms)
    case Expr.EInterp(_, parts, _) => listHasRuleExpr(parts)
    case Expr.EList(xs) => listHasRuleExpr(xs)
    case Expr.ETuple(xs) => listHasRuleExpr(xs)
    case Expr.ENamed(_, inner) => exprHasRuleExpr(inner)
    case Expr.EAscribe(inner, _, _) => exprHasRuleExpr(inner)
    case Expr.EFor(bs, body, _) => bindsHaveRuleExpr(bs) || exprHasRuleExpr(body)
    case _ => false
  }

def listHasRuleExpr(xs: List[Expr]): Bool =
  if (List.isEmpty(xs)) false else exprHasRuleExpr(List.at(xs, 0)) || listHasRuleExpr(List.tail(xs))

def armsHaveRuleExpr(xs: List[Arm]): Bool =
  if (List.isEmpty(xs)) false else exprHasRuleExpr(List.at(xs, 0).body) || armsHaveRuleExpr(List.tail(xs))

def bindsHaveRuleExpr(xs: List[Bind]): Bool =
  if (List.isEmpty(xs)) false else exprHasRuleExpr(List.at(xs, 0).value) || bindsHaveRuleExpr(List.tail(xs))

def progNeedsWhereCtx(p: Prog, stem: String, ctx: RewriteCtx): Bool =
  if (List.isEmpty(Set.toList(ctx.wn))) false else p match {
  case Prog(_, _, _, _, impls, _, defs, _, body) => exprNeedsWhere(body, mainEnv(stem), ctx) || defsNeedWhere(defs, ctx) || implsNeedWhere(impls, ctx)
}

def defsNeedWhere(ds: List[Fun], ctx: RewriteCtx): Bool =
  if (List.isEmpty(ds)) false else funNeedsWhere(List.at(ds, 0), ctx) || defsNeedWhere(List.tail(ds), ctx)

def funNeedsWhere(d: Fun, ctx: RewriteCtx): Bool =
  d match {
    case Fun(_, _, _, _, params, _, body, mod, _) => exprMayTouchWhereGo(body, ctx.wn) && exprNeedsWhere(body, Check.bindParams(params, Check.envSelfMod(mod)), ctx)
  }

def implsNeedWhere(xs: List[Im], ctx: RewriteCtx): Bool =
  if (List.isEmpty(xs)) false else imNeedsWhere(List.at(xs, 0), ctx) || implsNeedWhere(List.tail(xs), ctx)

def imNeedsWhere(im: Im, ctx: RewriteCtx): Bool =
  im match {
    case Im(_, _, _, methods) => defsNeedWhere(methods, ctx)
  }

def exprNeedsWhere(e: Expr, env: List[(String, Ty)], ctx: RewriteCtx): Bool =
  if (!exprMayTouchWhereGo(e, ctx.wn)) false else e match {
  case Expr.EPrint(inner, _) => exprNeedsWhere(inner, env, ctx)
  case Expr.ECall(f, args, _) => Set.contains(ctx.wn, Resolve.short(f)) && paramsHaveWhere(whereCallTarget(f, env, ctx.ftab, ctx.ens)._2) || listNeedsWhere(args, env, ctx)
  case Expr.EMethod(recv, name, args, _) => Set.contains(ctx.wn, name) && paramsHaveWhere(whereMethTarget(recv, name, env, ctx.funs, ctx.ens)._2) || exprNeedsWhere(recv, env, ctx) || listNeedsWhere(args, env, ctx)
  case Expr.EField(recv, _, _) => exprNeedsWhere(recv, env, ctx)
  case Expr.EBin(_, l, r, _) => exprNeedsWhere(l, env, ctx) || exprNeedsWhere(r, env, ctx)
  case Expr.EUn(_, inner, _) => exprNeedsWhere(inner, env, ctx)
  case Expr.ELam(p, ty, body) => exprNeedsWhere(body, Check.bindLam(p, ty, env), ctx)
  case Expr.EIf(c, t, el, _) => exprNeedsWhere(c, env, ctx) || exprNeedsWhere(t, env, ctx) || exprNeedsWhere(el, env, ctx)
  case Expr.EMatch(s, arms, _) => exprNeedsWhere(s, env, ctx) || armsMayTouchWhere(arms, ctx.wn) && armsNeedWhere(arms, inferTy(s, env, ctx.ftab, ctx.ens), env, ctx)
  case Expr.EInterp(_, parts, _) => listNeedsWhere(parts, env, ctx)
  case Expr.EList(xs) => listNeedsWhere(xs, env, ctx)
  case Expr.ETuple(xs) => listNeedsWhere(xs, env, ctx)
  case Expr.ENamed(_, inner) => exprNeedsWhere(inner, env, ctx)
  case Expr.EAscribe(inner, _, _) => exprNeedsWhere(inner, env, ctx)
  case Expr.EFor(bs, body, _) => forNeedsWhere(bs, body, env, ctx)
  case _ => false
}

def listNeedsWhere(xs: List[Expr], env: List[(String, Ty)], ctx: RewriteCtx): Bool =
  if (List.isEmpty(xs)) false else exprNeedsWhere(List.at(xs, 0), env, ctx) || listNeedsWhere(List.tail(xs), env, ctx)

def armsNeedWhere(xs: List[Arm], scrutTy: String, env: List[(String, Ty)], ctx: RewriteCtx): Bool =
  if (List.isEmpty(xs)) false else armNeedsWhere(List.at(xs, 0), scrutTy, env, ctx) || armsNeedWhere(List.tail(xs), scrutTy, env, ctx)

def armNeedsWhere(a: Arm, scrutTy: String, env: List[(String, Ty)], ctx: RewriteCtx): Bool =
  a match {
    case Arm(pat, _, body) => exprMayTouchWhereGo(body, ctx.wn) && exprNeedsWhere(body, Check.bindPat(pat, scrutTy, env, ctx.ens), ctx)
  }

def forNeedsWhere(bs: List[Bind], body: Expr, env: List[(String, Ty)], ctx: RewriteCtx): Bool =
  if (List.isEmpty(bs)) exprNeedsWhere(body, env, ctx) else forNeedsWhereHd(List.at(bs, 0), List.tail(bs), body, env, ctx)

def forNeedsWhereHd(b: Bind, rest: List[Bind], body: Expr, env: List[(String, Ty)], ctx: RewriteCtx): Bool =
  b match {
    case Bind(d, name, v) => exprNeedsWhere(v, env, ctx) || (bindsMayTouchWhere(rest, ctx.wn) || exprMayTouchWhereGo(body, ctx.wn)) && forNeedsWhere(rest, body, Check.bindFor(d, name, inferTy(v, env, ctx.ftab, ctx.ens), env, ctx.ens), ctx)
  }

def paramsHaveWhere(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) false else paramHasWhere(List.at(ps, 0)) || paramsHaveWhere(List.tail(ps))

def paramHasWhere(p: Param): Bool =
  p match {
    case Param(_, _, w, _) => w != ""
  }

def whereCallTarget(f: String, env: List[(String, Ty)], ftab: Ftab, ens: List[En]): (String, List[Param]) =
  whereCallFunHit(Check.findFunPrefer(ftab, f, env), f, ens)

def whereCallFunHit(hit: List[Fun], f: String, ens: List[En]): (String, List[Param]) =
  if (List.isEmpty(hit)) ctorTarget(ens, f) else whereFunTarget(List.at(hit, 0))

def whereFunTarget(d: Fun): (String, List[Param]) =
  (Resolve.qualified(d.mod, d.name), d.params)

def ctorTarget(ens: List[En], f: String): (String, List[Param]) =
  if (List.isEmpty(ens)) ("", noParam()) else ctorTarget1(List.at(ens, 0), List.tail(ens), f)

def ctorTarget1(h: En, rest: List[En], f: String): (String, List[Param]) =
  h match {
    case En(_, name, _, cases) => if (name == f) (Resolve.display(name), firstCaseParams(cases)) else ctorTargetCase(name, cases, f, rest)
  }

def firstCaseParams(cs: List[EnCase]): List[Param] =
  if (List.isEmpty(cs)) noParam() else caseParams(List.at(cs, 0))

def caseParams(c: EnCase): List[Param] =
  c match {
    case EnCase(_, fs) => fs
  }

def ctorTargetCase(enName: String, cs: List[EnCase], f: String, rest: List[En]): (String, List[Param]) =
  if (List.isEmpty(cs)) ctorTarget(rest, f) else ctorTargetCase1(enName, List.at(cs, 0), List.tail(cs), f, rest)

def ctorTargetCase1(enName: String, c: EnCase, restCs: List[EnCase], f: String, rest: List[En]): (String, List[Param]) =
  c match {
    case EnCase(name, fs) => if (name == f) (Str.concat(Resolve.display(enName), Str.concat(".", Resolve.short(name))), fs) else ctorTargetCase(enName, restCs, f, rest)
  }

def whereMethTarget(recv: Expr, name: String, env: List[(String, Ty)], funs: List[Fun], ens: List[En]): (String, List[Param]) =
  if (name == "require") ("", noParam()) else recv match {
  case Expr.EVar(modVar, _) => if (Type.show(Check.lookupEnv(env, modVar)) != "") ("", noParam()) else whereMethVarTarget(modVar, name, funs, ens)
  case _ => ("", noParam())
}

def whereMethVarTarget(modVar: String, name: String, funs: List[Fun], ens: List[En]): (String, List[Param]) =
  whereMethFunHit(Check.findFunMod(funs, modVar, name), modVar, name, ens)

def whereMethFunHit(hit: List[Fun], modVar: String, name: String, ens: List[En]): (String, List[Param]) =
  if (!List.isEmpty(hit)) whereFunTarget(List.at(hit, 0)) else enCaseTarget(ens, modVar, name)

def enCaseTarget(ens: List[En], modVar: String, caseName: String): (String, List[Param]) =
  if (List.isEmpty(ens)) ("", noParam()) else enCaseTarget1(List.at(ens, 0), List.tail(ens), modVar, caseName)

def enCaseTarget1(h: En, rest: List[En], modVar: String, caseName: String): (String, List[Param]) =
  if (h.name == modVar || Resolve.qualified(h.mod, h.name) == modVar) enCaseFind(h.name, h.cases, caseName) else enCaseTarget(rest, modVar, caseName)

def enCaseFind(enName: String, cs: List[EnCase], caseName: String): (String, List[Param]) =
  if (List.isEmpty(cs)) ("", noParam()) else enCaseFind1(enName, List.at(cs, 0), List.tail(cs), caseName)

def enCaseFind1(enName: String, c: EnCase, rest: List[EnCase], caseName: String): (String, List[Param]) =
  c match {
    case EnCase(name, fs) => if (Resolve.short(name) == caseName) (Str.concat(Resolve.display(enName), Str.concat(".", caseName)), fs) else enCaseFind(enName, rest, caseName)
  }

def defsHaveReq(ds: List[Fun]): Bool =
  if (List.isEmpty(ds)) false else funHasReq(List.at(ds, 0)) || defsHaveReq(List.tail(ds))

def funHasReq(d: Fun): Bool =
  d match {
    case Fun(_, _, _, _, _, _, body, _, _) => exprHasReq(body)
  }

def exprHasReq(e: Expr): Bool =
  e match {
    case Expr.EPrint(inner, _) => exprHasReq(inner)
    case Expr.ECall(_, args, _) => listHasReq(args)
    case Expr.EMethod(recv, name, args, _) => name == "require" || exprHasReq(recv) || listHasReq(args)
    case Expr.EField(recv, _, _) => exprHasReq(recv)
    case Expr.EBin(_, l, r, _) => exprHasReq(l) || exprHasReq(r)
    case Expr.EUn(_, inner, _) => exprHasReq(inner)
    case Expr.ELam(_, _, body) => exprHasReq(body)
    case Expr.EIf(c, t, el, _) => exprHasReq(c) || exprHasReq(t) || exprHasReq(el)
    case Expr.EMatch(s, arms, _) => exprHasReq(s) || armsHaveReq(arms)
    case Expr.EInterp(_, parts, _) => listHasReq(parts)
    case Expr.EList(xs) => listHasReq(xs)
    case Expr.ETuple(xs) => listHasReq(xs)
    case Expr.ENamed(_, inner) => exprHasReq(inner)
    case Expr.EAscribe(inner, _, _) => exprHasReq(inner)
    case Expr.EFor(bs, body, _) => bindsHaveReq(bs) || exprHasReq(body)
    case _ => false
  }

def listHasReq(xs: List[Expr]): Bool =
  if (List.isEmpty(xs)) false else exprHasReq(List.at(xs, 0)) || listHasReq(List.tail(xs))

def armsHaveReq(xs: List[Arm]): Bool =
  if (List.isEmpty(xs)) false else armHasReq(List.at(xs, 0)) || armsHaveReq(List.tail(xs))

def armHasReq(a: Arm): Bool =
  a match {
    case Arm(_, _, body) => exprHasReq(body)
  }

def bindsHaveReq(xs: List[Bind]): Bool =
  if (List.isEmpty(xs)) false else bindHasReq(List.at(xs, 0)) || bindsHaveReq(List.tail(xs))

def bindHasReq(b: Bind): Bool =
  b match {
    case Bind(_, _, e) => exprHasReq(e)
  }

def funOwnerKey(stem: String, name: String): String =
  Str.concat(stem, Str.concat(".", name))

def imOwnerKey(stem: String, im: Im, name: String): String =
  Str.concat(stem, Str.concat(".impl.", Str.concat(im.tn, Str.concat(".", Str.concat(im.forTy, Str.concat(".", name))))))

def mainOwnerKey(stem: String): String =
  Str.concat(stem, ".$main")

def rewriteReqTreeCtx(p: Prog, stem: String, ctx: RewriteCtx): Prog =
  p match {
    case Prog(pkg, enums, aliases, traits, impls, imps, defs, main, body) => Prog(pkg, enums, aliases, traits, rewriteReqImpls(impls, stem, ctx), imps, rewriteReqDefs(defs, stem, ctx), main, rewriteReqAt(body, mainOwnerKey(stem), 0, mainEnv(stem), ctx).expr, p.mod)
  }

def mainEnv(stem: String): List[(String, Ty)] =
  Check.envMod(stem)

def rewriteReqImpls(xs: List[Im], stem: String, ctx: RewriteCtx): List[Im] =
  if (List.isEmpty(xs)) xs else rewriteReqIm(List.at(xs, 0), stem, ctx) :: rewriteReqImpls(List.tail(xs), stem, ctx)

def rewriteReqIm(im: Im, stem: String, ctx: RewriteCtx): Im =
  im match {
    case Im(tn, targs, forTy, methods) => Im(tn, targs, forTy, rewriteReqImDefs(methods, stem, im, ctx), im.mod)
  }

def rewriteReqImDefs(ds: List[Fun], stem: String, im: Im, ctx: RewriteCtx): List[Fun] =
  if (List.isEmpty(ds)) ds else rewriteReqFunOwner(List.at(ds, 0), imOwnerKey(stem, im, List.at(ds, 0).name), ctx) :: rewriteReqImDefs(List.tail(ds), stem, im, ctx)

def rewriteReqDefs(ds: List[Fun], stem: String, ctx: RewriteCtx): List[Fun] =
  if (List.isEmpty(ds)) ds else rewriteReqFunOwner(List.at(ds, 0), funOwnerKey(stem, List.at(ds, 0).name), ctx) :: rewriteReqDefs(List.tail(ds), stem, ctx)

def rewriteReqFunOwner(d: Fun, owner: String, ctx: RewriteCtx): Fun =
  d match {
    case Fun(priv, ora, name, tparams, params, ret, body, mod, off) => if (!exprHasRuleExpr(body) && !exprMayTouchWhere(body, ctx.wn)) d else Fun(priv, ora, name, tparams, params, ret, rewriteReqAt(body, owner, 0, Check.bindParams(params, Check.envSelfMod(mod)), ctx).expr, mod, off)
  }

def inferTy(e: Expr, env: List[(String, Ty)], ftab: Ftab, ens: List[En]): String =
  inferTyGot(Check.infer(e, env, ftab, ens))

def inferTyGot(o: Out): String =
  if (Check.hasErr(o)) "A" else Check.tyStr(o)

def rewriteReqAt(e: Expr, owner: String, idx: Int, env: List[(String, Ty)], ctx: RewriteCtx): ReqStep =
  if (!exprHasRuleExpr(e) && !exprMayTouchWhere(e, ctx.wn)) ReqStep(e, idx) else e match {
  case Expr.EPrint(inner, off) => rewriteReqUnary(rewriteReqAt(inner, owner, idx, env, ctx), child => Expr.EPrint(child, off))
  case Expr.ECall(f, args, off) => rewriteReqCallAt(f, args, off, owner, idx, env, ctx)
  case Expr.EMethod(recv, name, args, off) => rewriteReqMethAt(recv, name, args, off, owner, idx, env, ctx)
  case Expr.EField(recv, name, off) => rewriteReqUnary(rewriteReqAt(recv, owner, idx, env, ctx), child => Expr.EField(child, name, off))
  case Expr.EBin(op, l, r, off) => rewriteReqBinAt(op, l, r, off, owner, idx, env, ctx)
  case Expr.EUn(op, inner, off) => rewriteReqUnary(rewriteReqAt(inner, owner, idx, env, ctx), child => Expr.EUn(op, child, off))
  case Expr.ELam(p, ty, body) => rewriteReqUnary(rewriteReqAt(body, owner, idx, Check.bindLam(p, ty, env), ctx), child => Expr.ELam(p, ty, child))
  case Expr.EIf(c, t, el, off) => rewriteReqIfAt(c, t, el, off, owner, idx, env, ctx)
  case Expr.EMatch(s, arms, off) => rewriteReqMatchAt(s, arms, off, owner, idx, env, ctx)
  case Expr.EInterp(s, parts, off) => rewriteReqListWrap(rewriteReqListAt(parts, owner, idx, env, ctx), xs => Expr.EInterp(s, xs, off))
  case Expr.EList(xs) => rewriteReqListWrap(rewriteReqListAt(xs, owner, idx, env, ctx), ys => Expr.EList(ys))
  case Expr.ETuple(xs) => rewriteReqListWrap(rewriteReqListAt(xs, owner, idx, env, ctx), ys => Expr.ETuple(ys))
  case Expr.ENamed(n, inner) => rewriteReqUnary(rewriteReqAt(inner, owner, idx, env, ctx), child => Expr.ENamed(n, child))
  case Expr.EAscribe(inner, ty, off) => rewriteReqUnary(rewriteReqAt(inner, owner, idx, env, ctx), child => Expr.EAscribe(child, ty, off))
  case Expr.EFor(bs, body, off) => rewriteReqForAt(bs, body, off, owner, idx, env, ctx)
  case _ => ReqStep(e, idx)
}

def rewriteReqUnary(step: ReqStep, build: Expr => Expr): ReqStep =
  ReqStep(build(step.expr), step.next)

def rewriteReqListWrap(step: ReqListStep, build: List[Expr] => Expr): ReqStep =
  ReqStep(build(step.exprs), step.next)

def rewriteReqBinAt(op: String, l: Expr, r: Expr, off: Int, owner: String, idx: Int, env: List[(String, Ty)], ctx: RewriteCtx): ReqStep =
  for {
    s1 = rewriteReqAt(l, owner, idx, env, ctx)
    s2 = rewriteReqAt(r, owner, s1.next, env, ctx)
  } yield ReqStep(Expr.EBin(op, s1.expr, s2.expr, off), s2.next)

def rewriteReqIfAt(c: Expr, t: Expr, el: Expr, off: Int, owner: String, idx: Int, env: List[(String, Ty)], ctx: RewriteCtx): ReqStep =
  for {
    s1 = rewriteReqAt(c, owner, idx, env, ctx)
    s2 = rewriteReqAt(t, owner, s1.next, env, ctx)
    s3 = rewriteReqAt(el, owner, s2.next, env, ctx)
  } yield ReqStep(Expr.EIf(s1.expr, s2.expr, s3.expr, off), s3.next)

def rewriteReqMatchAt(s: Expr, arms: List[Arm], off: Int, owner: String, idx: Int, env: List[(String, Ty)], ctx: RewriteCtx): ReqStep =
  for {
    s1 = rewriteReqAt(s, owner, idx, env, ctx)
    s2 = rewriteReqArmsAt(arms, inferTy(s, env, ctx.ftab, ctx.ens), owner, s1.next, env, ctx)
  } yield ReqStep(Expr.EMatch(s1.expr, s2.arms, off), s2.next)

def hasExactLen(xs: List[Expr], n: Int): Bool =
  if (n <= 0) List.isEmpty(xs) else !List.isEmpty(xs) && hasExactLen(List.tail(xs), n - 1)

def isPropRuleCall(f: String, args: List[Expr]): Bool =
  f == "Property.assert" && hasExactLen(args, 2) || f == "Property.check" && hasExactLen(args, 3)

def rewriteReqCallAt(f: String, args: List[Expr], off: Int, owner: String, idx: Int, env: List[(String, Ty)], ctx: RewriteCtx): ReqStep =
  if (isPropRuleCall(f, args)) rewritePropCallAt(f, args, off, Str.concat(owner, Str.concat("#", Str.fromInt(idx))), owner, idx + 1, env, ctx) else for {
  step = rewriteReqListAt(args, owner, idx, env, ctx)
} yield ReqStep(wrapWhereCall(f, step.exprs, off, env, ctx), step.next)

def rewritePropCallAt(f: String, args: List[Expr], off: Int, siteKey: String, owner: String, idx: Int, env: List[(String, Ty)], ctx: RewriteCtx): ReqStep =
  for {
    step = rewriteReqListAt(args, owner, idx, env, ctx)
    ys = step.exprs
    tagged = if (Set.contains(ctx.ambig, siteKey)) tagNameExpr(List.at(ys, 0), siteKey) :: List.tail(ys) else ys
  } yield ReqStep(Expr.ECall(f, tagged, off), step.next)

def tagNameExpr(e: Expr, siteKey: String): Expr =
  e match {
    case Expr.EStr(s, off) => Expr.EStr(tagRuleName(siteKey, s), off)
    case _ => Expr.ECall("Str.concat", Expr.EStr(tagRuleName(siteKey, ""), 0) :: e :: noExpr(), 0)
  }

def wrapWhereCall(f: String, args: List[Expr], off: Int, env: List[(String, Ty)], ctx: RewriteCtx): Expr =
  if (!Set.contains(ctx.wn, Resolve.short(f))) Expr.ECall(f, args, off) else wrapWhereCallTarget(f, args, off, whereCallTarget(f, env, ctx.ftab, ctx.ens), ctx.ambig)

def wrapWhereCallTarget(f: String, args: List[Expr], off: Int, target: (String, List[Param]), ambig: Set[String]): Expr =
  if (!paramsHaveWhere(target._2)) Expr.ECall(f, args, off) else wrapWhereAl(f, args, off, target._1, target._2, Check.alignCall(target._2, args), ambig)

def wrapWhereAl(f: String, args: List[Expr], off: Int, ownerDisp: String, ps: List[Param], al: (List[Expr], String), ambig: Set[String]): Expr =
  al match {
    case (xs, err) => if (err != "") Expr.ECall(f, args, off) else Expr.ECall(f, wrapWhereArgs(ownerDisp, 0, xs, ps, ambig), off)
  }

def wrapWhereMeth(recv: Expr, name: String, args: List[Expr], off: Int, env: List[(String, Ty)], ctx: RewriteCtx): Expr =
  if (!Set.contains(ctx.wn, name)) Expr.EMethod(recv, name, args, off) else wrapWhereMethTarget(recv, name, args, off, whereMethTarget(recv, name, env, ctx.funs, ctx.ens), ctx.ambig)

def wrapWhereMethTarget(recv: Expr, name: String, args: List[Expr], off: Int, target: (String, List[Param]), ambig: Set[String]): Expr =
  if (!paramsHaveWhere(target._2)) Expr.EMethod(recv, name, args, off) else wrapWhereMethAl(recv, name, args, off, target._1, target._2, Check.alignCall(target._2, args), ambig)

def wrapWhereMethAl(recv: Expr, name: String, args: List[Expr], off: Int, ownerDisp: String, ps: List[Param], al: (List[Expr], String), ambig: Set[String]): Expr =
  al match {
    case (xs, err) => if (err != "") Expr.EMethod(recv, name, args, off) else Expr.EMethod(recv, name, wrapWhereArgs(ownerDisp, 0, xs, ps, ambig), off)
  }

def wrapWhereArgs(ownerDisp: String, paramIdx: Int, xs: List[Expr], ps: List[Param], ambig: Set[String]): List[Expr] =
  if (List.isEmpty(ps) || List.isEmpty(xs)) xs else wrapWhereArg(ownerDisp, paramIdx, List.at(xs, 0), List.at(ps, 0), ambig) :: wrapWhereArgs(ownerDisp, paramIdx + 1, List.tail(xs), List.tail(ps), ambig)

def wrapWhereArg(ownerDisp: String, paramIdx: Int, e: Expr, p: Param, ambig: Set[String]): Expr =
  p match {
    case Param(n, _, w, _) => if (w == "") e else for {
  siteKey = whereSiteKey(ownerDisp, paramIdx)
  label = Str.concat(ownerDisp, Str.concat(" ", w))
  tagged = if (Set.contains(ambig, siteKey)) tagRuleName(siteKey, label) else label
} yield Expr.ECall("Property.check", Expr.EStr(tagged, 0) :: Expr.ELam(n, "", Check.dfltExpr(w)) :: e :: noExpr(), 0)
  }

def whereSiteKey(ownerDisp: String, paramIdx: Int): String =
  Str.concat("where:", Str.concat(ownerDisp, Str.concat("#", Str.fromInt(paramIdx))))

def rewriteReqForAt(bs: List[Bind], body: Expr, off: Int, owner: String, idx: Int, env: List[(String, Ty)], ctx: RewriteCtx): ReqStep =
  rewriteReqForGo(bs, noBind(), owner, idx, env, body, off, ctx)

def rewriteReqForGo(bs: List[Bind], acc: List[Bind], owner: String, idx: Int, env: List[(String, Ty)], body: Expr, off: Int, ctx: RewriteCtx): ReqStep =
  if (List.isEmpty(bs)) for {
  end = rewriteReqAt(body, owner, idx, env, ctx)
} yield ReqStep(Expr.EFor(List.reverse(acc), end.expr, off), end.next) else rewriteReqForHd(List.at(bs, 0), List.tail(bs), acc, owner, idx, env, body, off, ctx)

def rewriteReqForHd(b: Bind, rest: List[Bind], acc: List[Bind], owner: String, idx: Int, env: List[(String, Ty)], body: Expr, off: Int, ctx: RewriteCtx): ReqStep =
  b match {
    case Bind(d, name, v) => for {
  step = rewriteReqAt(v, owner, idx, env, ctx)
  nv = step.expr
  needEnv = bindsHaveRuleExpr(rest) || exprHasRuleExpr(body) || bindsMayTouchWhere(rest, ctx.wn) || exprMayTouchWhere(body, ctx.wn)
  nextEnv = if (needEnv) Check.bindFor(d, name, inferTy(nv, env, ctx.ftab, ctx.ens), env, ctx.ens) else env
} yield rewriteReqForGo(rest, Bind(d, name, nv) :: acc, owner, step.next, nextEnv, body, off, ctx)
  }

def rewriteReqMethAt(recv: Expr, name: String, args: List[Expr], off: Int, owner: String, idx: Int, env: List[(String, Ty)], ctx: RewriteCtx): ReqStep =
  for {
    rStep = rewriteReqAt(recv, owner, idx, env, ctx)
    nextIdx = if (name == "require") rStep.next + 1 else rStep.next
    aStep = rewriteReqListAt(args, owner, nextIdx, env, ctx)
    siteKey = Str.concat(owner, Str.concat("#", Str.fromInt(rStep.next)))
    out = if (name == "require") rewriteRequire(rStep.expr, aStep.exprs, siteKey, off, env, ctx) else wrapWhereMeth(rStep.expr, name, aStep.exprs, off, env, ctx)
  } yield ReqStep(out, aStep.next)

def rewriteRequire(recv: Expr, args: List[Expr], siteKey: String, off: Int, env: List[(String, Ty)], ctx: RewriteCtx): Expr =
  rewriteRequireTy(recv, args, siteKey, off, env, ctx, Check.infer(recv, env, ctx.ftab, ctx.ens))

def rewriteRequireTy(recv: Expr, args: List[Expr], siteKey: String, off: Int, env: List[(String, Ty)], ctx: RewriteCtx, ro: Out): Expr =
  if (Check.hasErr(ro) || !Type.isIo(ro.ty)) Expr.ECall("Property.check", reqNameTagged(args, siteKey, ctx.ambig) :: forceIoPred(reqPredE(args), env, ctx) :: recv :: noExpr(), off) else rewriteIoRequire(recv, reqNameTagged(args, siteKey, ctx.ambig), reqPredE(args), off, env, ctx)

def forceIoPred(pred: Expr, env: List[(String, Ty)], ctx: RewriteCtx): Expr =
  forceIoPredTy(pred, Check.infer(pred, env, ctx.ftab, ctx.ens))

def forceIoPredTy(pred: Expr, po: Out): Expr =
  if (!Check.hasErr(po) && Type.isIo(po.ty)) Expr.ECall("Property.force", pred :: noExpr(), 0) else pred

def rewriteIoRequire(recv: Expr, nameE: Expr, pred: Expr, off: Int, env: List[(String, Ty)], ctx: RewriteCtx): Expr =
  rewriteIoPred(recv, nameE, pred, off, Check.infer(pred, env, ctx.ftab, ctx.ens))

def rewriteIoPred(recv: Expr, nameE: Expr, pred: Expr, off: Int, po: Out): Expr =
  pred match {
    case Expr.ELam(_, _, _) => reqFor(recv, nameE, reqApply(pred, off), off)
    case _ => if (!Check.hasErr(po) && Type.isIo(po.ty)) reqForIoPred(recv, nameE, pred, off) else reqFor(recv, nameE, pred, off)
  }

def reqApply(pred: Expr, off: Int): Expr =
  Expr.EMethod(pred, "apply", Expr.EVar("reqv", off) :: noExpr(), off)

def reqFor(recv: Expr, nameE: Expr, pred: Expr, off: Int): Expr =
  Expr.EFor(Bind(true, "reqv", recv) :: Bind(true, "_", Expr.ECall("Property.assert", nameE :: pred :: noExpr(), off)) :: noBind(), Expr.EVar("reqv", off), off)

def reqForIoPred(recv: Expr, nameE: Expr, pred: Expr, off: Int): Expr =
  Expr.EFor(Bind(true, "reqv", recv) :: Bind(true, "reqok", pred) :: Bind(true, "_", Expr.ECall("Property.assert", nameE :: Expr.EVar("reqok", off) :: noExpr(), off)) :: noBind(), Expr.EVar("reqv", off), off)

def reqLabelOf(args: List[Expr]): String =
  if (List.isEmpty(args) || List.isEmpty(List.tail(args))) "require" else reqLabelHit(List.at(args, 0))

def reqLabelHit(e: Expr): String =
  e match {
    case Expr.EStr(s, _) => s
    case _ => "require"
  }

def reqNameTagged(args: List[Expr], siteKey: String, ambig: Set[String]): Expr =
  for {
    label = reqLabelOf(args)
    out = if (Set.contains(ambig, siteKey)) tagRuleName(siteKey, label) else label
  } yield Expr.EStr(out, 0)

def reqPredE(args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EBool(true) else if (List.isEmpty(List.tail(args))) List.at(args, 0) else List.at(List.tail(args), 0)

def rewriteReqListAt(xs: List[Expr], owner: String, idx: Int, env: List[(String, Ty)], ctx: RewriteCtx): ReqListStep =
  if (List.isEmpty(xs)) ReqListStep(noExpr(), idx) else for {
  h = rewriteReqAt(List.at(xs, 0), owner, idx, env, ctx)
  t = rewriteReqListAt(List.tail(xs), owner, h.next, env, ctx)
} yield ReqListStep(h.expr :: t.exprs, t.next)

def rewriteReqArmsAt(xs: List[Arm], scrutTy: String, owner: String, idx: Int, env: List[(String, Ty)], ctx: RewriteCtx): ReqArmsStep =
  if (List.isEmpty(xs)) ReqArmsStep(noArm(), idx) else for {
  h = rewriteReqArmAt(List.at(xs, 0), scrutTy, owner, idx, env, ctx)
  t = rewriteReqArmsAt(List.tail(xs), scrutTy, owner, h.next, env, ctx)
} yield ReqArmsStep(h.arm :: t.arms, t.next)

def noArm(): List[Arm] =
  []

def rewriteReqArmAt(a: Arm, scrutTy: String, owner: String, idx: Int, env: List[(String, Ty)], ctx: RewriteCtx): ReqArmStep =
  a match {
    case Arm(pat, g, body) => if (!exprHasRuleExpr(body) && !exprMayTouchWhere(body, ctx.wn)) ReqArmStep(a, idx) else for {
  step = rewriteReqAt(body, owner, idx, Check.bindPat(pat, scrutTy, env, ctx.ens), ctx)
} yield ReqArmStep(Arm(pat, g, step.expr), step.next)
  }

def seeds(src: String): String =
  nls(sortStrs(mapSeed(parseVerify(src))))

def drivers(src: String): String =
  nls(mapSpec(parseVerify(src)))

def parseVerifyAllEns(srcs: List[String], ens: List[En]): List[Fun] =
  if (List.isEmpty(srcs)) noFun() else List.concat(parseVerifyEns(List.at(srcs, 0), ens), parseVerifyAllEns(List.tail(srcs), ens))

def ensOfFiles(files: List[(String, String)]): List[En] =
  ensOfResolved(Resolve.prog(Parse.parseFiles(files)))

def ensOfResolved(p: Prog): List[En] =
  Check.expandEnums(p.enums, p.aliases)

def emptyVerify(file: String): String =
  Str.concat(file, ":1:1: error: verify file needs a Timeline => Verdict claim or a drive oracle; write a claim or delete the file")

def ioRet(d: Fun): Bool =
  Str.len(d.ret) >= 2 && Str.slice(d.ret, 0, 2) == "IO"

def ioDefNames(ds: List[Fun]): List[String] =
  if (List.isEmpty(ds)) noStr() else ioDefNamesHd(List.at(ds, 0), List.tail(ds))

def ioDefNamesHd(d: Fun, rest: List[Fun]): List[String] =
  if (ioRet(d)) d.name :: ioDefNames(rest) else ioDefNames(rest)

def oracleNames(srcs: List[String]): List[String] =
  oracleNamesEns(srcs, noEn())

def oracleNamesEns(srcs: List[String], ens: List[En]): List[String] =
  funNames(parseVerifyAllEns(srcs, ens))

def claimNames(srcs: List[String]): List[String] =
  funNames(parseClaimsAll(srcs))

def parseClaimsAll(srcs: List[String]): List[Fun] =
  if (List.isEmpty(srcs)) noFun() else List.concat(parseClaims(List.at(srcs, 0)), parseClaimsAll(List.tail(srcs)))

def funNames(ds: List[Fun]): List[String] =
  if (List.isEmpty(ds)) noStr() else funNamesHd(List.at(ds, 0), List.tail(ds))

def funNamesHd(d: Fun, rest: List[Fun]): List[String] =
  d.name :: funNames(rest)

def dupName(xs: List[String]): String =
  if (List.isEmpty(xs) || List.isEmpty(List.tail(xs))) "" else dupName2(List.at(xs, 0), List.at(xs, 1), List.tail(xs))

def dupName2(a: String, b: String, rest: List[String]): String =
  if (a == b) a else dupName(rest)

def driveDupMsg(name: String): String =
  Str.concat("scuzz.toml:1:1: error: drive name ", Str.concat(name, " is declared more than once"))

def driveRule(names: List[String]): String =
  driveDupMsgGo(dupName(sortStrs(names)))

def driveClaimNames(scn: String, oracles: List[String]): List[String] =
  List.concat(if (scn == "") oracles else "setup" :: oracles, scenarioDrvNames(scn))

def ruleFirst(a: String, b: String): String =
  if (a == "") b else a

def driveClaimRule(vers: List[String], names: List[String]): String =
  driveClaimMsg(driveClaimUnknown(sortStrs(List.distinct(callLitsSrcs(vers, "Timeline.driveHas", 2))), names))

def callLitsSrcs(srcs: List[String], f: String, idx: Int): List[String] =
  if (List.isEmpty(srcs)) noStr() else List.concat(callLitsOf(Parse.parse(Lexer.lex(List.at(srcs, 0))), f, idx), callLitsSrcs(List.tail(srcs), f, idx))

def driveClaimUnknown(xs: List[String], names: List[String]): String =
  if (List.isEmpty(xs)) "" else if (List.contains(names, List.at(xs, 0))) driveClaimUnknown(List.tail(xs), names) else List.at(xs, 0)

def driveClaimMsg(x: String): String =
  if (x == "") "" else Str.concat("scuzz.toml:1:1: error: Timeline.driveHas name ", Str.concat(x, " is not a drive in this package"))

def driveDupMsgGo(dup: String): String =
  if (dup == "") "" else driveDupMsg(dup)

def intentMsg(file: String): String =
  Str.concat(file, ":1:1: error: leftover *.scuzz_intent; rename to *.scuzz_verify or delete the file")

def isBlank(s: String): Bool =
  isBlankAt(s, 0)

def isBlankAt(s: String, i: Int): Bool =
  if (i >= Str.len(s)) true else if (isWs(Str.charAt(s, i))) isBlankAt(s, i + 1) else false

def isWs(c: Int): Bool =
  c == 32 || c == 9 || c == 10 || c == 13

def firstTokOff(src: String): Int =
  firstTokOffAt(src, 0)

def firstTokOffAt(src: String, i: Int): Int =
  if (i >= Str.len(src)) 0 else if (isWs(Str.charAt(src, i))) firstTokOffAt(src, i + 1) else i

def atLoc(file: String, src: String, off: Int, msg: String): String =
  atLoc2(file, Check.locOf(src, off), msg)

def atLoc2(file: String, loc: (Int, Int, Int, Int), msg: String): String =
  loc match {
    case (line, col, _, _) => Str.concat(file, Str.concat(":", Str.concat(Str.fromInt(line), Str.concat(":", Str.concat(Str.fromInt(col), Str.concat(": error: ", msg))))))
  }

def fmtMsg(file: String): String =
  Str.concat(file, ":1:1: error: needs formatting (run scuzz fmt)")

def leftoverMsg(file: String, src: String): String =
  atLoc(file, src, firstTokOff(src), "leftover tokens after parse")

def checkVerify(src: String, file: String): String =
  checkVerifyEns(src, file, noEn())

def checkVerifyEns(src: String, file: String, ens: List[En]): String =
  if (isBlank(src)) emptyVerify(file) else checkVerifyProg(src, file, ens, Parse.parse(Lexer.lex(src)))

def checkVerifyProg(src: String, file: String, ens: List[En], p: Prog): String =
  if (List.isEmpty(p.defs) && p.main == "") leftoverMsg(file, src) else checkVerifyShape(src, file, ens, p)

def checkVerifyShape(src: String, file: String, ens: List[En], p: Prog): String =
  if (p.main != "") Str.concat(file, ":1:1: error: verify file must not define @main") else if (!List.isEmpty(p.enums)) Str.concat(file, ":1:1: error: verify file must not define enums") else if (!List.isEmpty(p.aliases)) Str.concat(file, ":1:1: error: verify file must not define aliases") else if (!List.isEmpty(p.traits)) Str.concat(file, ":1:1: error: verify file must not define traits") else if (!List.isEmpty(p.impls)) Str.concat(file, ":1:1: error: verify file must not define impls") else if (!List.isEmpty(p.imps)) Str.concat(file, ":1:1: error: verify file must not define imports") else checkVerifyBody(src, file, ens, p)

def checkVerifyBody(src: String, file: String, ens: List[En], p: Prog): String =
  if (defsHaveForbid(p.defs) || exprHasForbid(p.body)) Str.concat(file, ":1:1: error: verify bodies must not call .require or Property.* other than Property.force") else checkVerifyDefs(src, file, ens, p)

def checkVerifyDefs(src: String, file: String, ens: List[En], p: Prog): String =
  checkVerifyDefsGo(src, file, ens, p, p.defs)

def checkVerifyDefsGo(src: String, file: String, ens: List[En], p: Prog, ds: List[Fun]): String =
  if (List.isEmpty(ds)) checkVerifyEmpty(src, file, ens, p) else checkVerifyDefHit(src, file, ens, p, List.at(ds, 0), List.tail(ds))

def checkVerifyDefHit(src: String, file: String, ens: List[En], p: Prog, d: Fun, rest: List[Fun]): String =
  if (d.priv) checkVerifyDefsGo(src, file, ens, p, rest) else if (isDrive(d, ens)) checkVerifyDefsGo(src, file, ens, p, rest) else if (isClaim(d)) checkVerifyDefsGo(src, file, ens, p, rest) else defFail(d, file, src)

def defFail(d: Fun, file: String, src: String): String =
  if (d.ora && d.ret == "Bool") atLoc(file, src, d.off, Str.concat("oracle ", Str.concat(d.name, " params must be generator-friendly (at most 3; ADT or List only as the sole param)"))) else if (d.ora) atLoc(file, src, d.off, Str.concat("oracle ", Str.concat(d.name, " must return Bool"))) else if (d.ret == "Verdict") atLoc(file, src, d.off, Str.concat("claim ", Str.concat(d.name, " must take 1 or 2 Timeline params"))) else atLoc(file, src, d.off, Str.concat("public def ", Str.concat(d.name, " is not a drive oracle or a Timeline => Verdict claim")))

def checkVerifyEmpty(src: String, file: String, ens: List[En], p: Prog): String =
  if (List.isEmpty(drives(p.defs, ens)) && List.isEmpty(claims(p.defs))) emptyVerify(file) else checkVerifyFmt(src, file, p)

def checkVerifyFmt(src: String, file: String, p: Prog): String =
  if (Parse.pretty(p) == src) "scuzz check ok" else fmtMsg(file)

def defsHaveForbid(ds: List[Fun]): Bool =
  if (List.isEmpty(ds)) false else funHasForbid(List.at(ds, 0)) || defsHaveForbid(List.tail(ds))

def funHasForbid(d: Fun): Bool =
  d match {
    case Fun(_, _, _, _, _, _, body, _, _) => exprHasForbid(body)
  }

def exprHasForbid(e: Expr): Bool =
  e match {
    case Expr.EPrint(inner, _) => exprHasForbid(inner)
    case Expr.ECall(f, args, _) => Str.startsWith(f, "Property.") && f != "Property.force" || listHasForbid(args)
    case Expr.EMethod(recv, name, args, _) => name == "require" || exprHasForbid(recv) || listHasForbid(args)
    case Expr.EField(recv, _, _) => exprHasForbid(recv)
    case Expr.EBin(_, l, r, _) => exprHasForbid(l) || exprHasForbid(r)
    case Expr.EUn(_, inner, _) => exprHasForbid(inner)
    case Expr.ELam(_, _, body) => exprHasForbid(body)
    case Expr.EIf(c, t, el, _) => exprHasForbid(c) || exprHasForbid(t) || exprHasForbid(el)
    case Expr.EMatch(s, arms, _) => exprHasForbid(s) || armsHaveForbid(arms)
    case Expr.EList(xs) => listHasForbid(xs)
    case Expr.ETuple(xs) => listHasForbid(xs)
    case Expr.ENamed(_, inner) => exprHasForbid(inner)
    case Expr.EAscribe(inner, _, _) => exprHasForbid(inner)
    case Expr.EFor(bs, body, _) => bindsHaveForbid(bs) || exprHasForbid(body)
    case _ => false
  }

def listHasForbid(xs: List[Expr]): Bool =
  if (List.isEmpty(xs)) false else exprHasForbid(List.at(xs, 0)) || listHasForbid(List.tail(xs))

def armsHaveForbid(xs: List[Arm]): Bool =
  if (List.isEmpty(xs)) false else armHasForbid(List.at(xs, 0)) || armsHaveForbid(List.tail(xs))

def armHasForbid(a: Arm): Bool =
  a match {
    case Arm(_, _, body) => exprHasForbid(body)
  }

def bindsHaveForbid(xs: List[Bind]): Bool =
  if (List.isEmpty(xs)) false else bindHasForbid(List.at(xs, 0)) || bindsHaveForbid(List.tail(xs))

def bindHasForbid(b: Bind): Bool =
  b match {
    case Bind(_, _, e) => exprHasForbid(e)
  }

def searchN(n: Int): Int =
  if (n <= 0) 0 else n / 8 * 5 + n % 8 * 5 / 8

def mutateN(n: Int): Int =
  if (n <= 0) 0 else n - searchN(n)

def fuzzHead(iterations: Int, corpus: Int, sites: Int): String =
  Str.concat(if (iterations <= 0) Str.concat("scuzz fuzz: corpus-only (--iterations 0)", nl()) else "", Str.concat(if (iterations <= 0 && corpus > 0) Str.concat("scuzz fuzz: replay ", Str.concat(Str.fromInt(corpus), Str.concat(" corpus entries", nl()))) else "", if (sites == 0 && iterations > 0) Str.concat("scuzz fuzz: no live-code mutation sites", nl()) else ""))

def fuzzBelowFloor(scoreMilli: Int, floor: Int): Bool =
  floor > 0 && scoreMilli >= 0 && scoreMilli < floor

def fuzzCampaignOk(fail: Int, iterations: Int, somNever: List[String], trigNever: List[String], claimNever: List[String], below: Bool): Bool =
  fail == 0 && (iterations <= 0 || List.isEmpty(somNever) && List.isEmpty(trigNever) && List.isEmpty(claimNever)) && !below

def fuzzOut(iterations: Int, seed: Int, corpus: Int, sites: Int, failures: Int, corpFail: Int): String =
  fuzzOut2(fuzzHead(iterations, corpus, sites), searchN(iterations), seed, corpus, fuzzObservations([], [], [], [], [], [], [], []), failures, corpFail, "0", fuzzMut(sites), failures == 0)

def fuzzStatus(search: Int, failures: Int, seed: Int, corpus: Int, ok: Bool): String =
  Str.concat("scuzz fuzz ", Str.concat(if (ok) "ok" else "fail", Str.concat(" (", Str.concat(Str.fromInt(search), Str.concat(" search, ", Str.concat(Str.fromInt(failures), Str.concat(" search failures, seed ", Str.concat(Str.fromInt(seed), Str.concat(", ", Str.concat(Str.fromInt(corpus), " corpus)"))))))))))

def fuzzCorpus(corpus: Int, corpFail: Int, promoted: String): String =
  Str.concat("corpus: ", Str.concat(Str.fromInt(corpus), Str.concat(" stored, ", Str.concat(Str.fromInt(corpFail), Str.concat(" failed, ", Str.concat(promoted, " promoted"))))))

def fuzzMut(sites: Int): String =
  Str.concat("mutate: 0 killed, 0 survived, 0 inert (0 of ", Str.concat(Str.fromInt(sites), " sites)"))

def fuzzOut2(head: String, search: Int, seed: Int, corpus: Int, observations: String, failures: Int, corpFail: Int, promoted: String, mut: String, ok: Bool): String =
  Str.concat(head, Str.concat(fuzzStatus(search, failures, seed, corpus, ok), Str.concat(nl(), Str.concat(fuzzCorpus(corpus, corpFail, promoted), Str.concat(nl(), Str.concat(observations, Str.concat(nl(), mut)))))))

def fuzzObservations(rows: List[(String, Bool)], branches: List[(String, Bool)], somDec: List[String], somHit: List[String], trigDec: List[String], trigHit: List[String], claimDec: List[String], claimHit: List[String]): String =
  Str.concat("coverage: functions ", Str.concat(coverageRatio(rows), Str.concat(", branches ", Str.concat(coverageRatio(branches), Str.concat(nl(), Str.concat(reachText("sometimes", "reached", somDec, somHit), Str.concat(nl(), Str.concat(reachText("triggers", "fired", trigDec, trigHit), Str.concat(nl(), reachText("claim drives", "fired", claimDec, claimHit))))))))))

def coverageRatio(rows: List[(String, Bool)]): String =
  countRatio(List.count(rows, row => row._2), List.len(rows))

def countRatio(reached: Int, total: Int): String =
  Str.concat(Str.fromInt(reached), Str.concat("/", Str.fromInt(total)))

def reachText(kind: String, action: String, declared: List[String], reached: List[String]): String =
  Str.concat(kind, Str.concat(": ", Str.concat(countRatio(List.len(reachKeep(declared, reached)), List.len(List.distinct(declared))), Str.concat(" ", action))))

def remEuclid(a: Int, n: Int): Int =
  if (n <= 0) 0 else remEuclid2(a % n, n)

def remEuclid2(r: Int, n: Int): Int =
  if (r < 0) r + n else r

def parseSeed(s: String): Int =
  if (s == "") 0 else Str.toInt(s, 0)

def decodeK(s: Int): Int =
  remEuclid(if (s < 0) 0 else s, 8)

def decodeRest(s: Int): Int =
  (if (s < 0) 0 else s) / 8

def decodeD(s: Int): Int =
  2 + remEuclid(decodeRest(s), 4)

def decodeRng(s: Int): Int =
  decodeRest(s) / 4

def encodeSched(rng: Int, d: Int, k: Int): Int =
  rng * 32 + (d - 2) * 8 + k

def perturbSched(base: String, s: Int): String =
  perturbSched2(parseSeed(base), s)

def perturbSched2(seed: Int, s: Int): String =
  Str.fromInt(encodeSched(decodeRng(seed) + 1 + remEuclid(s, 16), decodeD(seed), decodeK(seed)))

def mixByte(h: Int, b: Int): Int =
  remEuclid((h ^ b) * 16777619, 2147483647)

def mixStr(h: Int, s: String): Int =
  mixStrAt(h, s, 0)

def mixStrAt(h: Int, s: String, i: Int): Int =
  if (i >= Str.len(s)) h else mixStrAt(mixByte(h, Str.charAt(s, i)), s, i + 1)

def relateSeed(label: String, sched: String, script: String, n: Int): Int =
  mixByte(mixStr(mixStr(mixStr(2166136261, label), sched), script), n)

def workloadDefs(srcs: List[String], ens: List[En]): List[Fun] =
  if (List.isEmpty(srcs)) noFun() else List.concat(workloadProg(Parse.parse(Lexer.lex(List.at(srcs, 0))), ens), workloadDefs(List.tail(srcs), ens))

def workloadProg(p: Prog, ens: List[En]): List[Fun] =
  p match {
    case Prog(_, _, _, _, _, _, defs, _, _) => workloadFuns(defs, ens, ctxTyOf(defs))
  }

def workloadFuns(ds: List[Fun], ens: List[En], ctxTy: String): List[Fun] =
  if (List.isEmpty(ds)) noFun() else workloadFun(List.at(ds, 0), List.tail(ds), ens, ctxTy)

def workloadFun(d: Fun, rest: List[Fun], ens: List[En], ctxTy: String): List[Fun] =
  if (d.name == "setup" || hasDot(d.name)) workloadFuns(rest, ens, ctxTy) else if (isDrive(d, ens) || !d.priv && Check.isIo(d.ret) && List.len(drvGenPs(d.params, ctxTy)) <= 3 && allFriendly(drvGenPs(d.params, ctxTy), ens) && unaryAdtOk(drvGenPs(d.params, ctxTy)) && allSimpleWhere(drvGenPs(d.params, ctxTy))) stripCtxFun(d, ctxTy) :: workloadFuns(rest, ens, ctxTy) else workloadFuns(rest, ens, ctxTy)

def stripCtxFun(d: Fun, ctxTy: String): Fun =
  d match {
    case Fun(priv, ora, name, ts, ps, ret, body, mod, off) => Fun(priv, ora, name, ts, drvGenPs(ps, ctxTy), ret, body, mod, off)
  }

def generatedDrive(ds: List[Fun], ens: List[En], seed: Int): String =
  generatedFrom(paramDrives(ds), ens, seed)

def paramDrives(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else paramDrive(List.at(ds, 0), List.tail(ds))

def paramDrive(d: Fun, rest: List[Fun]): List[Fun] =
  if (List.isEmpty(d.params)) paramDrives(rest) else d :: paramDrives(rest)

def generatedFrom(ds: List[Fun], ens: List[En], seed: Int): String =
  if (List.isEmpty(ds)) "" else generatedEligible(List.at(ds, seed % List.len(ds)), ens, seed)

def generatedFun(d: Fun, ens: List[En], seed: Int): String =
  Str.concat("drive ", Str.concat(d.name, Str.concat(if (List.isEmpty(d.params)) "" else Str.concat(" ", generatedParams(d.params, ens, seed, 0, " ")), nl())))

def generatedParams(ps: List[Param], ens: List[En], seed: Int, depth: Int, sep: String): String =
  if (List.isEmpty(ps)) "" else Str.concat(generatedParam(List.at(ps, 0), ens, seed, depth), if (List.len(ps) == 1) "" else Str.concat(sep, generatedParams(List.tail(ps), ens, seed + 1, depth, sep)))

def generatedParam(p: Param, ens: List[En], seed: Int, depth: Int): String =
  if (p.ty == "Int") Str.fromInt(generatedInt(p.name, p.w, seed)) else generatedType(p.ty, ens, seed, depth)

def maxI64(): Int =
  9223372036854775807

def minI64(): Int =
  0 - 9223372036854775807 - 1

def satAdd(a: Int, b: Int): Int =
  if (b > 0 && a > maxI64() - b) maxI64() else if (b < 0 && a < minI64() - b) minI64() else a + b

def satMul(a: Int, b: Int): Int =
  if (a > 0 && b > maxI64() / a) maxI64() else a * b

def midInt(lo: Int, hi: Int): Int =
  if (lo < 0 && hi < 0 || lo > 0 && hi > 0) lo + (hi - lo) / 2 else (lo + hi) / 2

def noBound(): IBound =
  IBound(0, 0, false, false, 0, false, true)

def badBound(): IBound =
  IBound(0, 0, false, false, 0, false, false)

def whereBounds(name: String, w: String): IBound =
  if (w == "") noBound() else conjunctsBound(name, whereConjuncts(Check.dfltExpr(w)))

def whereConjuncts(e: Expr): List[Expr] =
  e match {
    case Expr.EBin(op, l, r, _) => if (op == "&&") List.concat(whereConjuncts(l), whereConjuncts(r)) else e :: noExpr()
    case _ => e :: noExpr()
  }

def conjunctsBound(name: String, cs: List[Expr]): IBound =
  if (List.isEmpty(cs)) noBound() else boundMerge(conjunctBound(name, List.at(cs, 0)), conjunctsBound(name, List.tail(cs)))

def boundMerge(a: IBound, b: IBound): IBound =
  if (!a.ok || !b.ok) badBound() else validBound(IBound(if (a.onLo && b.onLo) maxInt(a.lo, b.lo) else if (a.onLo) a.lo else b.lo, if (a.onHi && b.onHi) minInt(a.hi, b.hi) else if (a.onHi) a.hi else b.hi, a.onLo || b.onLo, a.onHi || b.onHi, if (a.onEq) a.eq else b.eq, a.onEq || b.onEq, true))

def validBound(b: IBound): IBound =
  if (b.onLo && b.onHi && b.lo > b.hi || b.onEq && (b.onLo && b.eq < b.lo || b.onHi && b.eq > b.hi)) badBound() else b

def conjunctBound(name: String, e: Expr): IBound =
  e match {
    case Expr.EBin(op, l, r, _) => boundSides(name, op, l, r)
    case _ => badBound()
  }

def boundSides(name: String, op: String, l: Expr, r: Expr): IBound =
  l match {
    case Expr.EVar(s, _) => if (s != name) badBound() else boundFrom(op, intLitOf(r), false)
    case _ => r match {
  case Expr.EVar(s, _) => if (s != name) badBound() else boundFrom(op, intLitOf(l), true)
  case _ => badBound()
}
  }

def intLitOf(e: Expr): (Bool, Int) =
  e match {
    case Expr.EInt(n, _) => (true, n)
    case Expr.EUn(op, x, _) => if (op == "-") negLitOf(x) else (false, 0)
    case _ => (false, 0)
  }

def negLitOf(x: Expr): (Bool, Int) =
  x match {
    case Expr.EInt(n, _) => (true, 0 - n)
    case _ => (false, 0)
  }

def boundFrom(op: String, lit: (Bool, Int), flip: Bool): IBound =
  if (!lit._1) badBound() else boundOp(if (flip) flipOp(op) else op, lit._2)

def flipOp(op: String): String =
  if (op == "<") ">" else if (op == ">") "<" else if (op == "<=") ">=" else if (op == ">=") "<=" else op

def boundOp(op: String, k: Int): IBound =
  if (op == ">=") IBound(k, 0, true, false, 0, false, true) else if (op == ">" && k == maxI64() || op == "<" && k == minI64()) badBound() else if (op == ">") IBound(satAdd(k, 1), 0, true, false, 0, false, true) else if (op == "<=") IBound(0, k, false, true, 0, false, true) else if (op == "<") IBound(0, satAdd(k, 0 - 1), false, true, 0, false, true) else if (op == "==") IBound(k, k, true, true, k, true, true) else badBound()

def clampBound(v: Int, b: IBound): Int =
  if (b.onEq) b.eq else if (b.onLo && v < b.lo) b.lo else if (b.onHi && v > b.hi) b.hi else v

def genSize(seed: Int): Int =
  seed % 4 + seed / 16 % 8

def generatedInt(name: String, w: String, seed: Int): Int =
  generatedIntB(whereBounds(name, w), seed)

def generatedIntB(b: IBound, seed: Int): Int =
  if (b.onEq) b.eq else clampBound(intPoolAt(b, seed, seed % 10), b)

def intPoolAt(b: IBound, seed: Int, pick: Int): Int =
  if (b.onHi && !b.onLo) intPoolHi(b, seed, pick) else if (b.onLo || b.onHi) intPoolBound(b, seed, pick) else intPoolFree(seed, pick)

def intPoolFree(seed: Int, pick: Int): Int =
  if (pick == 0) 0 else if (pick == 1) 1 else if (pick == 2) 0 - 1 else if (pick == 3) seed % 17 else if (pick == 4) 0 - seed % 17 else if (pick == 5) maxI64() else if (pick == 6) minI64() else if (pick == 7) maxI64() - 1 else if (pick == 8) minI64() + 1 else satMul(seed % 1000, seed % 1000) * (if (seed % 2 == 0) 0 - 1 else 1)

def intPoolBound(b: IBound, seed: Int, pick: Int): Int =
  if (pick == 0) 0 else if (pick == 1) 1 else if (pick == 2) 0 - 1 else if (pick == 3) satAdd(b.lo, seed % 17) else if (pick == 4) satAdd(b.lo, 1) else if (pick == 5) if (b.onHi) b.hi else satAdd(b.lo, seed % (17 + seed / 32 % 85)) else if (pick == 6) satAdd(b.lo, seed % (17 + genSize(seed))) else if (pick == 7) satAdd(b.hi, 0 - 1) else if (pick == 8) b.hi else satAdd(b.lo, seed % 101)

def intPoolHi(b: IBound, seed: Int, pick: Int): Int =
  if (pick == 0) 0 else if (pick == 1) 1 else if (pick == 2) 0 - 1 else if (pick == 3) satAdd(b.hi, 0 - seed % 17) else if (pick == 4) satAdd(b.hi, 0 - 1) else if (pick == 5) b.hi else if (pick == 6) satAdd(b.hi, 0 - seed % (17 + genSize(seed))) else if (pick == 7) satAdd(b.hi, 0 - seed % 101) else if (pick == 8) b.hi else satAdd(b.hi, 0 - seed % (17 + seed / 32 % 85))

def nudgeInt(name: String, w: String, v: Int, delta: Int): Int =
  clampBound(satAdd(v, delta), whereBounds(name, w))

def zeroInt(name: String, w: String): Int =
  clampBound(0, whereBounds(name, w))

def maxInt(a: Int, b: Int): Int =
  if (a > b) a else b

def minInt(a: Int, b: Int): Int =
  if (a < b) a else b

def generatedType(ty: String, ens: List[En], seed: Int, depth: Int): String =
  if (ty == "Int") Str.fromInt(seed % 17) else if (ty == "Bool") generatedBool(seed) else if (ty == "String") generatedStr(seed) else if (isListTy(ty)) Str.concat("[", Str.concat(generatedList(listInner(ty), ens, seed, depth + 1, if (depth >= genMaxDepth(seed) || !generationType(listInner(ty), ens, depth + 1)) 0 else seed % (1 + genSize(seed))), "]")) else generatedAdt(findEnTy(ens, ty), ens, seed, depth)

def generatedStr(seed: Int): String =
  quoteTok(strValAt(seed, seed % 12))

def strValAt(seed: Int, pick: Int): String =
  if (pick == 0) "" else if (pick == 1) "a" else if (pick == 2) Str.repeat("a", 1 + genSize(seed)) else if (pick == 3) "\"" else if (pick == 4) """
""" else if (pick == 5) " " else if (pick == 6) "," else if (pick == 7) "[]" else if (pick == 8) "é" else if (pick == 9) "λü中" else if (pick == 10) "a,b](x)" else Str.concat("a\t\"é\n", Str.fromInt(seed % 100))

def genMaxDepth(seed: Int): Int =
  3 + seed / 64 % 3

def generatedList(ty: String, ens: List[En], seed: Int, depth: Int, n: Int): String =
  if (n <= 0) "" else Str.concat(generatedType(ty, ens, seed, depth), if (n == 1) "" else Str.concat(",", generatedList(ty, ens, seed + 1, depth, n - 1)))

def generatedAdt(hit: List[En], ens: List[En], seed: Int, depth: Int): String =
  if (List.isEmpty(hit)) "0" else generatedEn(List.at(hit, 0), ens, seed, depth)

def generatedEn(en: En, ens: List[En], seed: Int, depth: Int): String =
  en match {
    case En(_, _, _, cases) => generatedCases(generatedDepthCases(generationCases(cases, ens, depth), seed, depth), ens, seed, depth)
  }

def generatedDepthCases(cs: List[EnCase], seed: Int, depth: Int): List[EnCase] =
  if (depth < genMaxDepth(seed) || List.isEmpty(leafCases(cs))) cs else leafCases(cs)

def generatedCases(cases: List[EnCase], ens: List[En], seed: Int, depth: Int): String =
  if (List.isEmpty(cases)) "0" else generatedCase(List.at(cases, seed % List.len(cases)), ens, seed, depth)

def generatedCase(c: EnCase, ens: List[En], seed: Int, depth: Int): String =
  c match {
    case EnCase(name, fields) => if (List.isEmpty(fields)) Str.concat(Resolve.short(name), "()") else Str.concat(Resolve.short(name), Str.concat("(", Str.concat(generatedParams(fields, ens, seed + 1, depth + 1, ","), ")")))
  }

def varyWorkload(script: String, seed: Int): String =
  nls(orderedInputTimes(linesOf(varyLines(linesOf(script), seed)), 0))

def orderedInputTimes(lines: List[String], time: Int): List[String] =
  if (List.isEmpty(lines)) [] else orderedInputTime(List.at(lines, 0), List.tail(lines), time)

def orderedInputTime(line: String, rest: List[String], time: Int): List[String] =
  if (!Str.startsWith(Str.trim(line), "inputTime ")) line :: orderedInputTimes(rest, time) else Str.parseInt(Str.trim(jRest(Str.trim(line)))) match {
  case Result.Ok(value) => if (value < 0) line :: orderedInputTimes(rest, time) else for {
  next = if (value < time) time else value
} yield Str.concat("inputTime ", Str.fromInt(next)) :: orderedInputTimes(rest, next)
  case Result.Err(_) => line :: orderedInputTimes(rest, time)
}

def varyLines(lines: List[String], seed: Int): String =
  if (List.isEmpty(lines)) "" else if (seed % 3 == 0) nls(List.reverse(lines)) else if (seed % 3 == 1) nls(List.concat(List.tail(lines), List.at(lines, 0) :: noStr())) else nls(List.concat(lines, List.at(lines, seed % List.len(lines)) :: noStr()))

def workloadSeed(seed: Int): Int =
  (seed % 2147483647 + 2147483647) % 2147483647

def generatedBool(seed: Int): String =
  if (seed % 2 == 0) "false" else "true"

def generatedEligible(d: Fun, ens: List[En], seed: Int): String =
  if (generationParams(d.params, ens, 0)) generatedFun(d, ens, seed) else ""

def generationParams(ps: List[Param], ens: List[En], depth: Int): Bool =
  if (List.isEmpty(ps)) true else generationParam(List.at(ps, 0), ens, depth) && generationParams(List.tail(ps), ens, depth)

def generationType(ty: String, ens: List[En], depth: Int): Bool =
  if (leafTy(ty) || isListTy(ty)) true else if (depth >= 6) false else generationEnum(findEnTy(ens, ty), ens, depth)

def generationEnum(hit: List[En], ens: List[En], depth: Int): Bool =
  if (List.isEmpty(hit)) false else generationEn(List.at(hit, 0), ens, depth)

def generationEn(en: En, ens: List[En], depth: Int): Bool =
  en match {
    case En(_, _, _, cases) => !List.isEmpty(generationCases(cases, ens, depth))
  }

def generationCases(cs: List[EnCase], ens: List[En], depth: Int): List[EnCase] =
  if (List.isEmpty(cs)) noCase() else generationCase(List.at(cs, 0), List.tail(cs), ens, depth)

def generationCase(c: EnCase, rest: List[EnCase], ens: List[En], depth: Int): List[EnCase] =
  c match {
    case EnCase(_, fs) => if (generationParams(fs, ens, depth + 1)) c :: generationCases(rest, ens, depth) else generationCases(rest, ens, depth)
  }

def generationParam(p: Param, ens: List[En], depth: Int): Bool =
  generationType(p.ty, ens, depth)

def noScope(): InputScope =
  InputScope(0, [], [], [], [], [])

def scopeCount(s: InputScope, required: Bool, status: String): Int =
  List.len(List.filter(s.workloads, w => w.required == required && w.status == status))

def requiredBlocked(ws: List[Workload]): Bool =
  List.exists(ws, w => w.required && w.status != "passed")

def scopeLine(s: InputScope): String =
  Str.concat("scope: required ", Str.concat(scopeCountsLine(s, true), Str.concat("; search ", scopeCountsLine(s, false))))

def scopeCountsLine(s: InputScope, required: Bool): String =
  List.join(Str.concat(Str.fromInt(scopeCount(s, required, "passed")), " passed") :: Str.concat(Str.fromInt(scopeCount(s, required, "failed")), " failed") :: Str.concat(Str.fromInt(scopeCount(s, required, "excluded")), " excluded") :: Str.concat(Str.fromInt(scopeCount(s, required, "incomplete")), " incomplete") :: [], ", ")

def jScope(s: InputScope): String =
  Str.concat(",\"scope\":{\"required\":", Str.concat(jScopeCounts(s, true), Str.concat(",\"search\":", Str.concat(jScopeCounts(s, false), Str.concat(",\"inputs\":", Str.concat(jStrList(s.inputs), Str.concat(jReachKey("claims", s.claims, s.checkedClaims), Str.concat(",\"mutant_excluded\":[", Str.concat(List.join(List.map(s.mutantExcluded, n => Str.fromInt(n)), ","), Str.concat("],\"workloads\":[", Str.concat(List.join(List.map(s.workloads, w => jWorkload(w)), ","), "]}")))))))))))

def jScopeCounts(s: InputScope, required: Bool): String =
  Str.concat("{\"passed\":", Str.concat(Str.fromInt(scopeCount(s, required, "passed")), Str.concat(",\"failed\":", Str.concat(Str.fromInt(scopeCount(s, required, "failed")), Str.concat(",\"excluded\":", Str.concat(Str.fromInt(scopeCount(s, required, "excluded")), Str.concat(Str.concat(",\"incomplete\":", Str.fromInt(scopeCount(s, required, "incomplete"))), Str.concat(if (required) Str.concat(",\"planned\":", Str.concat(Str.fromInt(s.planned), Str.concat(",\"unrun\":", Str.fromInt(s.planned - List.len(List.filter(s.workloads, w => w.required)))))) else "", "}"))))))))

def jWorkload(w: Workload): String =
  Str.concat("{\"label\":", Str.concat(Check.jsonStr(w.label), Str.concat(",\"required\":", Str.concat(jb(w.required), Str.concat(jStrK("status", w.status), Str.concat(jStrK("engine", w.engine), Str.concat(jStrK("script", w.script), Str.concat(jStrK("schedule", w.schedule), Str.concat(jStrK("fault", w.fault), Str.concat(",\"schedule_picks\":", Str.concat(jStrList(w.picks), Str.concat(jStrK("reason", w.reason), "}"))))))))))))

def checkedClaimNames(raw: String): List[String] =
  sortStrs(List.distinct(List.map(List.filter(linesOf(raw), l => Str.startsWith(l, "checked\t")), l => Str.drop(l, 8))))

def tagRuleName(key: String, label: String): String =
  Str.concat("@sz:", Str.concat(key, Str.concat("@", label)))

def splitRuleTag(raw: String): (String, String) =
  if (!Str.startsWith(raw, "@sz:")) ("", raw) else splitRuleTagAt(raw, findIdx(raw, "@", 4))

def splitRuleTagAt(raw: String, j: Int): (String, String) =
  if (j < 4) ("", raw) else (Str.slice(raw, 4, j), Str.drop(raw, j + 1))

def stripRuleTag(raw: String): String =
  splitRuleTag(raw)._2

def stripRuleTagsInText(s: String): String =
  if (!Str.contains(s, "@sz:")) s else stripRuleTagsGo(s, 0, Builder.empty())

def stripRuleTagsGo(s: String, pos: Int, b: Builder): String =
  stripRuleTagsHit(s, pos, findIdx(s, "@sz:", pos), b)

def stripRuleTagsHit(s: String, pos: Int, i: Int, b: Builder): String =
  if (i < 0) Builder.result(Builder.append(b, Str.drop(s, pos))) else stripRuleTagsEnd(s, pos, i, findIdx(s, "@", i + 4), b)

def stripRuleTagsEnd(s: String, pos: Int, i: Int, j: Int, b: Builder): String =
  if (j <= i + 4 || Str.contains(Str.slice(s, i + 4, j), nl())) stripRuleTagsGo(s, i + 4, Builder.append(b, Str.slice(s, pos, i + 4))) else stripRuleTagsGo(s, j + 1, Builder.append(b, Str.slice(s, pos, i)))

def progHasTaggedProp(p: Prog, stem: String, ambig: Set[String]): Bool =
  if (List.isEmpty(Set.toList(ambig))) false else p match {
  case Prog(_, _, _, _, impls, _, defs, _, body) => exprHasTaggedProp(body, mainOwnerKey(stem), 0, ambig).hit || defsHaveTaggedProp(defs, stem, ambig) || implsHaveTaggedProp(impls, stem, ambig)
}

def defsHaveTaggedProp(ds: List[Fun], stem: String, ambig: Set[String]): Bool =
  if (List.isEmpty(ds)) false else exprHasTaggedProp(List.at(ds, 0).body, funOwnerKey(stem, List.at(ds, 0).name), 0, ambig).hit || defsHaveTaggedProp(List.tail(ds), stem, ambig)

def implsHaveTaggedProp(xs: List[Im], stem: String, ambig: Set[String]): Bool =
  if (List.isEmpty(xs)) false else imDefsHaveTaggedProp(List.at(xs, 0).methods, stem, List.at(xs, 0), ambig) || implsHaveTaggedProp(List.tail(xs), stem, ambig)

def imDefsHaveTaggedProp(ds: List[Fun], stem: String, im: Im, ambig: Set[String]): Bool =
  if (List.isEmpty(ds)) false else exprHasTaggedProp(List.at(ds, 0).body, imOwnerKey(stem, im, List.at(ds, 0).name), 0, ambig).hit || imDefsHaveTaggedProp(List.tail(ds), stem, im, ambig)

def exprHasTaggedProp(e: Expr, owner: String, idx: Int, ambig: Set[String]): TagHitStep =
  e match {
    case Expr.EPrint(inner, _) => exprHasTaggedProp(inner, owner, idx, ambig)
    case Expr.ECall(f, args, _) => if (isPropRuleCall(f, args)) for {
  hit = Set.contains(ambig, Str.concat(owner, Str.concat("#", Str.fromInt(idx))))
  rest = listHasTaggedProp(args, owner, idx + 1, ambig)
} yield TagHitStep(hit || rest.hit, rest.next) else listHasTaggedProp(args, owner, idx, ambig)
    case Expr.EMethod(recv, name, args, _) => for {
  r = exprHasTaggedProp(recv, owner, idx, ambig)
  next = if (name == "require") r.next + 1 else r.next
  a = listHasTaggedProp(args, owner, next, ambig)
} yield TagHitStep(r.hit || a.hit, a.next)
    case Expr.EField(recv, _, _) => exprHasTaggedProp(recv, owner, idx, ambig)
    case Expr.EBin(_, l, r, _) => for {
  s1 = exprHasTaggedProp(l, owner, idx, ambig)
  s2 = exprHasTaggedProp(r, owner, s1.next, ambig)
} yield TagHitStep(s1.hit || s2.hit, s2.next)
    case Expr.EUn(_, inner, _) => exprHasTaggedProp(inner, owner, idx, ambig)
    case Expr.ELam(_, _, body) => exprHasTaggedProp(body, owner, idx, ambig)
    case Expr.EIf(c, t, el, _) => for {
  s1 = exprHasTaggedProp(c, owner, idx, ambig)
  s2 = exprHasTaggedProp(t, owner, s1.next, ambig)
  s3 = exprHasTaggedProp(el, owner, s2.next, ambig)
} yield TagHitStep(s1.hit || s2.hit || s3.hit, s3.next)
    case Expr.EMatch(s, arms, _) => for {
  s1 = exprHasTaggedProp(s, owner, idx, ambig)
  s2 = armsHaveTaggedProp(arms, owner, s1.next, ambig)
} yield TagHitStep(s1.hit || s2.hit, s2.next)
    case Expr.EInterp(_, parts, _) => listHasTaggedProp(parts, owner, idx, ambig)
    case Expr.EList(xs) => listHasTaggedProp(xs, owner, idx, ambig)
    case Expr.ETuple(xs) => listHasTaggedProp(xs, owner, idx, ambig)
    case Expr.ENamed(_, inner) => exprHasTaggedProp(inner, owner, idx, ambig)
    case Expr.EAscribe(inner, _, _) => exprHasTaggedProp(inner, owner, idx, ambig)
    case Expr.EFor(bs, body, _) => for {
  s1 = bindsHaveTaggedProp(bs, owner, idx, ambig)
  s2 = exprHasTaggedProp(body, owner, s1.next, ambig)
} yield TagHitStep(s1.hit || s2.hit, s2.next)
    case _ => TagHitStep(false, idx)
  }

def listHasTaggedProp(xs: List[Expr], owner: String, idx: Int, ambig: Set[String]): TagHitStep =
  if (List.isEmpty(xs)) TagHitStep(false, idx) else for {
  h = exprHasTaggedProp(List.at(xs, 0), owner, idx, ambig)
  t = listHasTaggedProp(List.tail(xs), owner, h.next, ambig)
} yield TagHitStep(h.hit || t.hit, t.next)

def armsHaveTaggedProp(xs: List[Arm], owner: String, idx: Int, ambig: Set[String]): TagHitStep =
  if (List.isEmpty(xs)) TagHitStep(false, idx) else for {
  h = exprHasTaggedProp(List.at(xs, 0).body, owner, idx, ambig)
  t = armsHaveTaggedProp(List.tail(xs), owner, h.next, ambig)
} yield TagHitStep(h.hit || t.hit, t.next)

def bindsHaveTaggedProp(xs: List[Bind], owner: String, idx: Int, ambig: Set[String]): TagHitStep =
  if (List.isEmpty(xs)) TagHitStep(false, idx) else for {
  h = exprHasTaggedProp(List.at(xs, 0).value, owner, idx, ambig)
  t = bindsHaveTaggedProp(List.tail(xs), owner, h.next, ambig)
} yield TagHitStep(h.hit || t.hit, t.next)

def ambiguousKeysKeptWith(kept: List[(String, String, Prog)], ftab: Ftab, funs: List[Fun], ens: List[En]): Set[String] =
  ambiguousKeysEntries(List.concat(whereKeyEntries(funs, ens), keptRuleKeyEntries(kept, ftab, Check.withLetterPins(ens))))

def ambiguousKeysEntries(entries: List[RuleEntry]): Set[String] =
  for {
    counts = List.foldLeft(entries, Map.empty(), pair => for {
  m = pair._1
  row = pair._2
  bucket = Str.concat(row.rejKind, Str.concat(":", row.rule))
} yield Map.set(m, bucket, Map.getOrElse(m, bucket, 0) + 1))
  } yield List.foldLeft(entries, Set.empty(), pair => for {
  acc = pair._1
  row = pair._2
  bucket = Str.concat(row.rejKind, Str.concat(":", row.rule))
} yield if (row.forced || Map.getOrElse(counts, bucket, 0) > 1) Set.add(acc, row.siteKey) else acc)

def whereKeyEntries(funs: List[Fun], ens: List[En]): List[RuleEntry] =
  List.concat(funWhereKeyEntries(funs), enWhereKeyEntries(ens))

def funWhereKeyEntries(ds: List[Fun]): List[RuleEntry] =
  if (List.isEmpty(ds)) [] else List.concat(funOneWhereKeys(List.at(ds, 0)), funWhereKeyEntries(List.tail(ds)))

def funOneWhereKeys(d: Fun): List[RuleEntry] =
  if (d.ora) [] else paramWhereKeys(Resolve.qualified(d.mod, d.name), d.params, 0)

def enWhereKeyEntries(ens: List[En]): List[RuleEntry] =
  if (List.isEmpty(ens)) [] else List.concat(enOneWhereKeys(List.at(ens, 0)), enWhereKeyEntries(List.tail(ens)))

def enOneWhereKeys(en: En): List[RuleEntry] =
  if (en.isRec || recLike(en.name, en.cases)) paramWhereKeys(Resolve.display(en.name), firstCaseParams(en.cases), 0) else enCasesWhereKeys(Resolve.display(en.name), en.cases)

def enCasesWhereKeys(enDisp: String, cs: List[EnCase]): List[RuleEntry] =
  if (List.isEmpty(cs)) [] else List.concat(paramWhereKeys(Str.concat(enDisp, Str.concat(".", Resolve.short(List.at(cs, 0).name))), List.at(cs, 0).fields, 0), enCasesWhereKeys(enDisp, List.tail(cs)))

def paramWhereKeys(ownerDisp: String, ps: List[Param], j: Int): List[RuleEntry] =
  if (List.isEmpty(ps)) [] else paramWhereKeysHd(ownerDisp, List.at(ps, 0), List.tail(ps), j)

def paramWhereKeysHd(ownerDisp: String, p: Param, rest: List[Param], j: Int): List[RuleEntry] =
  p match {
    case Param(_, _, w, _) => if (w == "") paramWhereKeys(ownerDisp, rest, j + 1) else RuleEntry(whereSiteKey(ownerDisp, j), "check", Str.concat(ownerDisp, Str.concat(" ", w)), false) :: paramWhereKeys(ownerDisp, rest, j + 1)
  }

def srcMayHaveRuleExpr(src: String): Bool =
  Str.contains(src, "require") || Str.contains(src, "Property.")

def keptRuleKeyEntries(kept: List[(String, String, Prog)], ftab: Ftab, ens: List[En]): List[RuleEntry] =
  if (List.isEmpty(kept)) [] else for {
  h = List.at(kept, 0)
  own = if (!srcMayHaveRuleExpr(h._2)) [] else progRuleKeyEntries(h._3, h._1, ftab, ens, false)
} yield List.concat(own, keptRuleKeyEntries(List.tail(kept), ftab, ens))

def progRuleKeyEntries(p: Prog, stem: String, ftab: Ftab, ens: List[En], forceAll: Bool): List[RuleEntry] =
  p match {
    case Prog(_, _, _, _, impls, _, defs, _, body) => List.concat(implsRuleKeyEntries(impls, stem, ftab, ens, forceAll), List.concat(defsRuleKeyEntries(defs, stem, ftab, ens, forceAll), exprRuleKeyEntries(body, mainOwnerKey(stem), 0, mainEnv(stem), ftab, ens, forceAll).entries))
  }

def implsRuleKeyEntries(xs: List[Im], stem: String, ftab: Ftab, ens: List[En], forceAll: Bool): List[RuleEntry] =
  if (List.isEmpty(xs)) [] else List.concat(imRuleKeyEntries(List.at(xs, 0).methods, stem, List.at(xs, 0), ftab, ens, forceAll), implsRuleKeyEntries(List.tail(xs), stem, ftab, ens, forceAll))

def imRuleKeyEntries(ds: List[Fun], stem: String, im: Im, ftab: Ftab, ens: List[En], forceAll: Bool): List[RuleEntry] =
  if (List.isEmpty(ds)) [] else List.concat(funRuleKeyEntries(List.at(ds, 0), imOwnerKey(stem, im, List.at(ds, 0).name), ftab, ens, forceAll), imRuleKeyEntries(List.tail(ds), stem, im, ftab, ens, forceAll))

def defsRuleKeyEntries(ds: List[Fun], stem: String, ftab: Ftab, ens: List[En], forceAll: Bool): List[RuleEntry] =
  if (List.isEmpty(ds)) [] else List.concat(funRuleKeyEntries(List.at(ds, 0), funOwnerKey(stem, List.at(ds, 0).name), ftab, ens, forceAll), defsRuleKeyEntries(List.tail(ds), stem, ftab, ens, forceAll))

def funRuleKeyEntries(d: Fun, owner: String, ftab: Ftab, ens: List[En], forceAll: Bool): List[RuleEntry] =
  if (!exprHasRuleExpr(d.body)) [] else exprRuleKeyEntries(d.body, owner, 0, Check.bindParams(d.params, Check.envSelfMod(d.mod)), ftab, ens, forceAll).entries

def isStrExpr(e: Expr): Bool =
  e match {
    case Expr.EStr(_, _) => true
    case _ => false
  }

def propCallLabel(e: Expr, fallback: String): String =
  e match {
    case Expr.EStr(s, _) => s
    case _ => fallback
  }

def isIoRecvExpr(recv: Expr, env: List[(String, Ty)], ftab: Ftab, ens: List[En]): Bool =
  for {
    ro = Check.infer(recv, env, ftab, ens)
  } yield !Check.hasErr(ro) && Type.isIo(ro.ty)

def exprRuleKeyEntries(e: Expr, owner: String, idx: Int, env: List[(String, Ty)], ftab: Ftab, ens: List[En], forceAll: Bool): RuleKeyStep =
  if (!exprHasRuleExpr(e)) RuleKeyStep([], idx) else e match {
  case Expr.EPrint(inner, _) => exprRuleKeyEntries(inner, owner, idx, env, ftab, ens, forceAll)
  case Expr.ECall(f, args, _) => if (isPropRuleCall(f, args)) for {
  siteKey = Str.concat(owner, Str.concat("#", Str.fromInt(idx)))
  rk = if (f == "Property.assert") "assert" else "check"
  lbl = propCallLabel(List.at(args, 0), rk)
  force = forceAll || !isStrExpr(List.at(args, 0))
  rest = listRuleKeyEntries(args, owner, idx + 1, env, ftab, ens, forceAll)
} yield RuleKeyStep(RuleEntry(siteKey, rk, lbl, force) :: rest.entries, rest.next) else listRuleKeyEntries(args, owner, idx, env, ftab, ens, forceAll)
  case Expr.EMethod(recv, name, args, _) => for {
  r = exprRuleKeyEntries(recv, owner, idx, env, ftab, ens, forceAll)
  isReq = name == "require"
  next = if (isReq) r.next + 1 else r.next
  a = listRuleKeyEntries(args, owner, next, env, ftab, ens, forceAll)
  siteKey = Str.concat(owner, Str.concat("#", Str.fromInt(r.next)))
  rk = if (isReq && isIoRecvExpr(recv, env, ftab, ens)) "assert" else "check"
  own = if (isReq) RuleEntry(siteKey, rk, reqLabelOf(args), forceAll) :: [] else []
} yield RuleKeyStep(List.concat(r.entries, List.concat(own, a.entries)), a.next)
  case Expr.EField(recv, _, _) => exprRuleKeyEntries(recv, owner, idx, env, ftab, ens, forceAll)
  case Expr.EBin(_, l, r, _) => for {
  s1 = exprRuleKeyEntries(l, owner, idx, env, ftab, ens, forceAll)
  s2 = exprRuleKeyEntries(r, owner, s1.next, env, ftab, ens, forceAll)
} yield RuleKeyStep(List.concat(s1.entries, s2.entries), s2.next)
  case Expr.EUn(_, inner, _) => exprRuleKeyEntries(inner, owner, idx, env, ftab, ens, forceAll)
  case Expr.ELam(p, ty, body) => exprRuleKeyEntries(body, owner, idx, Check.bindLam(p, ty, env), ftab, ens, forceAll)
  case Expr.EIf(c, t, el, _) => for {
  s1 = exprRuleKeyEntries(c, owner, idx, env, ftab, ens, forceAll)
  s2 = exprRuleKeyEntries(t, owner, s1.next, env, ftab, ens, forceAll)
  s3 = exprRuleKeyEntries(el, owner, s2.next, env, ftab, ens, forceAll)
} yield RuleKeyStep(List.concat(s1.entries, List.concat(s2.entries, s3.entries)), s3.next)
  case Expr.EMatch(s, arms, _) => for {
  s1 = exprRuleKeyEntries(s, owner, idx, env, ftab, ens, forceAll)
  s2 = if (!armsHaveRuleExpr(arms)) RuleKeyStep([], s1.next) else armsRuleKeyEntries(arms, inferTy(s, env, ftab, ens), owner, s1.next, env, ftab, ens, forceAll)
} yield RuleKeyStep(List.concat(s1.entries, s2.entries), s2.next)
  case Expr.EInterp(_, parts, _) => listRuleKeyEntries(parts, owner, idx, env, ftab, ens, forceAll)
  case Expr.EList(xs) => listRuleKeyEntries(xs, owner, idx, env, ftab, ens, forceAll)
  case Expr.ETuple(xs) => listRuleKeyEntries(xs, owner, idx, env, ftab, ens, forceAll)
  case Expr.ENamed(_, inner) => exprRuleKeyEntries(inner, owner, idx, env, ftab, ens, forceAll)
  case Expr.EAscribe(inner, _, _) => exprRuleKeyEntries(inner, owner, idx, env, ftab, ens, forceAll)
  case Expr.EFor(bs, body, _) => forRuleKeyEntries(bs, body, owner, idx, env, ftab, ens, forceAll)
  case _ => RuleKeyStep([], idx)
}

def listRuleKeyEntries(xs: List[Expr], owner: String, idx: Int, env: List[(String, Ty)], ftab: Ftab, ens: List[En], forceAll: Bool): RuleKeyStep =
  if (List.isEmpty(xs)) RuleKeyStep([], idx) else for {
  h = exprRuleKeyEntries(List.at(xs, 0), owner, idx, env, ftab, ens, forceAll)
  t = listRuleKeyEntries(List.tail(xs), owner, h.next, env, ftab, ens, forceAll)
} yield RuleKeyStep(List.concat(h.entries, t.entries), t.next)

def armsRuleKeyEntries(xs: List[Arm], scrutTy: String, owner: String, idx: Int, env: List[(String, Ty)], ftab: Ftab, ens: List[En], forceAll: Bool): RuleKeyStep =
  if (List.isEmpty(xs)) RuleKeyStep([], idx) else for {
  a = List.at(xs, 0)
  h = if (!exprHasRuleExpr(a.body)) RuleKeyStep([], idx) else exprRuleKeyEntries(a.body, owner, idx, Check.bindPat(a.pat, scrutTy, env, ens), ftab, ens, forceAll)
  t = armsRuleKeyEntries(List.tail(xs), scrutTy, owner, h.next, env, ftab, ens, forceAll)
} yield RuleKeyStep(List.concat(h.entries, t.entries), t.next)

def forRuleKeyEntries(bs: List[Bind], body: Expr, owner: String, idx: Int, env: List[(String, Ty)], ftab: Ftab, ens: List[En], forceAll: Bool): RuleKeyStep =
  if (List.isEmpty(bs)) exprRuleKeyEntries(body, owner, idx, env, ftab, ens, forceAll) else for {
  b = List.at(bs, 0)
  h = exprRuleKeyEntries(b.value, owner, idx, env, ftab, ens, forceAll)
  needEnv = bindsHaveRuleExpr(List.tail(bs)) || exprHasRuleExpr(body)
  nextEnv = if (needEnv) Check.bindFor(b.draw, b.name, inferTy(b.value, env, ftab, ens), env, ens) else env
  t = forRuleKeyEntries(List.tail(bs), body, owner, h.next, nextEnv, ftab, ens, forceAll)
} yield RuleKeyStep(List.concat(h.entries, t.entries), t.next)

def rewriteFuzzWrap(verWrap: String, drv: String, files: List[(String, String)]): String =
  if (verWrap == "" && drv == "") "" else for {
  kept = parseKept(files)
  merged = Resolve.prog(mergeKept(kept))
  resolved = resolveKept(kept, merged)
  funs = Check.expandDefs(merged.defs, merged.aliases)
  ens = Check.expandEnums(merged.enums, merged.aliases)
  ftab = Check.ftabOfList(funs)
  pins = Check.withLetterPins(ens)
  liveEntries = keptRuleKeyEntries(resolved, ftab, pins)
  ambig = ambiguousKeysEntries(List.concat(whereKeyEntries(funs, ens), liveEntries))
  assertLabels = List.foldLeft(liveEntries, Set.empty(), pair => if (pair._2.rejKind == "assert") Set.add(pair._1, pair._2.rule) else pair._1)
  drvOut = if (drv == "") "" else rewriteScenarioDrv(drv, funs, ens, ambig)
  verOut = if (verWrap == "") "" else rewriteVerifyWrapSrc(verWrap, merged, funs, ens, ambig, assertLabels)
} yield Str.concat(drvOut, verOut)

def rewriteScenarioDrv(drv: String, liveFuns: List[Fun], liveEns: List[En], baseAmbig: Set[String]): String =
  for {
    rawP = Parse.parseFile("__scn", drv)
    scnEn = Check.expandEnums(rawP.enums, rawP.aliases)
    scnFuns = Check.expandDefs(rawP.defs, rawP.aliases)
    allFuns = List.concat(scnFuns, liveFuns)
    allEns = List.concat(scnEn, liveEns)
    ftab = Check.ftabOfList(allFuns)
    pins = Check.withLetterPins(allEns)
    idx = Resolve.indexOf(Prog("", allEns, rawP.aliases, [], [], rawP.imps, allFuns, "", Expr.EUnit, ""))
    resP = resolveKeptProg(Resolve.program(rawP, idx), rawP.aliases)
    scnEntries = List.concat(whereKeyEntries(scnFuns, scnEn), progRuleKeyEntries(resP, "__scn", ftab, pins, true))
    scnKeys = List.foldLeft(scnEntries, baseAmbig, pair => Set.add(pair._1, pair._2.siteKey))
    ctx = RewriteCtx(ftab, allFuns, pins, whereShortSet(allFuns, allEns), scnKeys)
  } yield if (progNeedsRewriteCtx(resP, "__scn", ctx)) Resolve.source(rewriteReqTreeCtx(resP, "__scn", ctx)) else drv

def rewriteVerifyWrapSrc(verWrap: String, liveMerged: Prog, liveFuns: List[Fun], liveEns: List[En], ambig: Set[String], assertLabels: Set[String]): String =
  for {
    rawWrap = Parse.parseFile(wrapMod(), verWrap)
    wrapEn = Check.expandEnums(rawWrap.enums, rawWrap.aliases)
    wrapFuns = Check.expandDefs(rawWrap.defs, rawWrap.aliases)
    allFuns = List.concat(wrapFuns, liveFuns)
    allEns = List.concat(wrapEn, liveEns)
    wn = whereShortSet(allFuns, allEns)
    needsOraTag = wrapNeedsOraTag(rawWrap.defs, assertLabels)
  } yield if (!needsOraTag && List.isEmpty(Set.toList(wn))) verWrap else for {
  allAliases = List.concat(rawWrap.aliases, liveMerged.aliases)
  idx = Resolve.indexOf(liveMerged.copy(enums = List.concat(rawWrap.enums, liveMerged.enums), aliases = allAliases, imps = List.concat(rawWrap.imps, liveMerged.imps), defs = List.concat(rawWrap.defs, liveMerged.defs)))
  wrapProg = resolveKeptProg(Resolve.program(rawWrap, idx), allAliases)
  ctx = RewriteCtx(Check.ftabOfList(allFuns), allFuns, Check.withLetterPins(allEns), wn, ambig)
  needsW = progNeedsWhereCtx(wrapProg, wrapMod(), ctx)
} yield if (!needsW && !needsOraTag) verWrap else Resolve.source(rewriteVerifyWrapTree(wrapProg, ctx, assertLabels))

def wrapNeedsOraTag(ds: List[Fun], assertLabels: Set[String]): Bool =
  if (List.isEmpty(Set.toList(assertLabels)) || List.isEmpty(ds)) false else wrapFunNeedsOraTag(List.at(ds, 0), assertLabels) || wrapNeedsOraTag(List.tail(ds), assertLabels)

def wrapFunNeedsOraTag(d: Fun, assertLabels: Set[String]): Bool =
  Str.startsWith(d.name, "_drv_") && Set.contains(assertLabels, Str.drop(d.name, 5))

def rewriteVerifyWrapTree(p: Prog, ctx: RewriteCtx, assertLabels: Set[String]): Prog =
  p.copy(defs = List.map(p.defs, d => rewriteVerifyWrapFun(d, ctx, assertLabels)))

def rewriteVerifyWrapFun(d: Fun, ctx: RewriteCtx, assertLabels: Set[String]): Fun =
  for {
    oraTag = if (wrapFunNeedsOraTag(d, assertLabels)) Str.drop(d.name, 5) else ""
  } yield if (oraTag == "" && !exprMayTouchWhere(d.body, ctx.wn)) d else d.copy(body = rewriteWrapExpr(d.body, Check.bindParams(d.params, Check.envSelfMod(d.mod)), ctx, oraTag))

def rewriteWrapExpr(e: Expr, env: List[(String, Ty)], ctx: RewriteCtx, oraTag: String): Expr =
  if (oraTag == "" && !exprMayTouchWhere(e, ctx.wn)) e else e match {
  case Expr.EPrint(inner, off) => Expr.EPrint(rewriteWrapExpr(inner, env, ctx, oraTag), off)
  case Expr.ECall(f, args, off) => if (f == "Property.assert" && oraTag != "" && hasExactLen(args, 2) && isExactStrLit(List.at(args, 0), oraTag)) Expr.ECall(f, Expr.EStr(tagRuleName(Str.concat("oracle:", oraTag), oraTag), 0) :: rewriteWrapList(List.tail(args), env, ctx, oraTag), off) else wrapWhereCall(f, rewriteWrapList(args, env, ctx, oraTag), off, env, ctx)
  case Expr.EMethod(recv, name, args, off) => wrapWhereMeth(rewriteWrapExpr(recv, env, ctx, oraTag), name, rewriteWrapList(args, env, ctx, oraTag), off, env, ctx)
  case Expr.EField(recv, name, off) => Expr.EField(rewriteWrapExpr(recv, env, ctx, oraTag), name, off)
  case Expr.EBin(op, l, r, off) => Expr.EBin(op, rewriteWrapExpr(l, env, ctx, oraTag), rewriteWrapExpr(r, env, ctx, oraTag), off)
  case Expr.EUn(op, inner, off) => Expr.EUn(op, rewriteWrapExpr(inner, env, ctx, oraTag), off)
  case Expr.ELam(p, ty, body) => Expr.ELam(p, ty, rewriteWrapExpr(body, Check.bindLam(p, ty, env), ctx, oraTag))
  case Expr.EIf(c, t, el, off) => Expr.EIf(rewriteWrapExpr(c, env, ctx, oraTag), rewriteWrapExpr(t, env, ctx, oraTag), rewriteWrapExpr(el, env, ctx, oraTag), off)
  case Expr.EMatch(s, arms, off) => Expr.EMatch(rewriteWrapExpr(s, env, ctx, oraTag), List.map(arms, a => Arm(a.pat, a.g, rewriteWrapExpr(a.body, Check.bindPat(a.pat, inferTy(s, env, ctx.ftab, ctx.ens), env, ctx.ens), ctx, oraTag))), off)
  case Expr.EInterp(s, parts, off) => Expr.EInterp(s, rewriteWrapList(parts, env, ctx, oraTag), off)
  case Expr.EList(xs) => Expr.EList(rewriteWrapList(xs, env, ctx, oraTag))
  case Expr.ETuple(xs) => Expr.ETuple(rewriteWrapList(xs, env, ctx, oraTag))
  case Expr.ENamed(n, inner) => Expr.ENamed(n, rewriteWrapExpr(inner, env, ctx, oraTag))
  case Expr.EAscribe(inner, ty, off) => Expr.EAscribe(rewriteWrapExpr(inner, env, ctx, oraTag), ty, off)
  case Expr.EFor(bs, body, off) => rewriteWrapFor(bs, [], env, body, off, ctx, oraTag)
  case _ => e
}

def isExactStrLit(e: Expr, want: String): Bool =
  e match {
    case Expr.EStr(s, _) => s == want
    case _ => false
  }

def rewriteWrapList(xs: List[Expr], env: List[(String, Ty)], ctx: RewriteCtx, oraTag: String): List[Expr] =
  List.map(xs, x => rewriteWrapExpr(x, env, ctx, oraTag))

def rewriteWrapFor(bs: List[Bind], acc: List[Bind], env: List[(String, Ty)], body: Expr, off: Int, ctx: RewriteCtx, oraTag: String): Expr =
  if (List.isEmpty(bs)) Expr.EFor(List.reverse(acc), rewriteWrapExpr(body, env, ctx, oraTag), off) else for {
  b = List.at(bs, 0)
  nv = rewriteWrapExpr(b.value, env, ctx, oraTag)
} yield rewriteWrapFor(List.tail(bs), Bind(b.draw, b.name, nv) :: acc, Check.bindFor(b.draw, b.name, inferTy(nv, env, ctx.ftab, ctx.ens), env, ctx.ens), body, off, ctx, oraTag)

def expandToks(toks: List[SpTok]): List[SpTok] =
  if (List.isEmpty(toks)) [] else expandTokHd(List.at(toks, 0), List.tail(toks))

def expandTokHd(h: SpTok, rest: List[SpTok]): List[SpTok] =
  h.tok match {
    case Tok.Interp(s) => List.concat(expandInterpToks(s, 0, h.off + 2, h.stem), expandToks(rest))
    case _ => h :: expandToks(rest)
  }

def expandInterpToks(s: String, i: Int, base: Int, stem: String): List[SpTok] =
  if (i >= Str.len(s)) [] else expandInterpCh(s, i, base, stem, Str.charAt(s, i))

def expandInterpCh(s: String, i: Int, base: Int, stem: String, c: Int): List[SpTok] =
  if (c == 92 && i + 1 < Str.len(s)) expandInterpToks(s, i + 2, base, stem) else if (c == 36 && i + 1 < Str.len(s) && Str.charAt(s, i + 1) == 123) expandInterpHole(s, i, Parse.interpCloseBrace(s, i + 2, 1), base, stem) else expandInterpToks(s, i + 1, base, stem)

def expandInterpHole(s: String, i: Int, j: Int, base: Int, stem: String): List[SpTok] =
  List.concat(expandToks(List.map(Lexer.lex(Str.slice(s, i + 2, j - 1)), t => if (t.tok == Tok.Eof) SpTok(Tok.Comma, -1, stem, 0) else SpTok(t.tok, t.off + base + i + 2, stem, t.column))), expandInterpToks(s, j, base, stem))

def reqOffsOfToks(toks: List[SpTok]): List[Int] =
  if (List.isEmpty(toks) || List.isEmpty(List.tail(toks)) || List.isEmpty(List.tail(List.tail(toks)))) [] else reqOffsStep(List.at(toks, 0), List.at(toks, 1), List.at(toks, 2), List.tail(toks))

def reqOffsStep(t0: SpTok, t1: SpTok, t2: SpTok, rest: List[SpTok]): List[Int] =
  if (t0.tok == Tok.Dot && t1.tok == Tok.Ident("require") && t2.tok == Tok.LParen && t1.off >= 0) t1.off :: reqOffsOfToks(rest) else reqOffsOfToks(rest)

def countReqInGuard(g: String): Int =
  if (g == "" || !Str.contains(g, "require")) 0 else List.len(reqOffsOfToks(expandToks(Lexer.lex(g))))

def atMainOff(toks: List[SpTok]): Int =
  if (List.isEmpty(toks)) -1 else if (List.at(toks, 0).tok == Tok.AtMain) List.at(toks, 0).off else atMainOff(List.tail(toks))

def sortInts(xs: List[Int]): List[Int] =
  List.sortBy(xs, n => n)

def progDeclOffs(p: Prog, toks: List[SpTok]): List[Int] =
  sortInts(List.filter(atMainOff(toks) :: List.concat(List.map(p.defs, d => d.off), List.flatMap(p.impls, im => List.map(im.methods, m => m.off))), n => n >= 0))

def nextDeclOff(offs: List[Int], after: Int, fallback: Int): Int =
  if (List.isEmpty(offs)) fallback else if (List.at(offs, 0) > after) List.at(offs, 0) else nextDeclOff(List.tail(offs), after, fallback)

def sliceOffs(offs: List[Int], lo: Int, hi: Int): List[Int] =
  List.filter(offs, n => n >= lo && n < hi)

def toksFromOff(toks: List[SpTok], off: Int): List[SpTok] =
  if (List.isEmpty(toks)) [] else if (List.at(toks, 0).off >= off) toks else toksFromOff(List.tail(toks), off)

def skipGroup(toks: List[SpTok], open: Tok, close: Tok, depth: Int): List[SpTok] =
  if (List.isEmpty(toks)) [] else for {
  t = List.at(toks, 0).tok
  next = if (t == open) depth + 1 else if (t == close) depth - 1 else depth
} yield if (next <= 0) List.tail(toks) else skipGroup(List.tail(toks), open, close, next)

def funBodyStartOff(toks: List[SpTok], defOff: Int): Int =
  funBodySeekParams(toksFromOff(toks, defOff), defOff)

def funBodySeekParams(toks: List[SpTok], fallback: Int): Int =
  if (List.isEmpty(toks)) fallback else List.at(toks, 0).tok match {
  case Tok.LBracket => funBodySeekParams(skipGroup(List.tail(toks), Tok.LBracket, Tok.RBracket, 1), fallback)
  case Tok.LParen => funBodySeekEq(skipGroup(List.tail(toks), Tok.LParen, Tok.RParen, 1), fallback)
  case Tok.Eq => if (List.isEmpty(List.tail(toks))) fallback else List.at(List.tail(toks), 0).off
  case _ => funBodySeekParams(List.tail(toks), fallback)
}

def funBodySeekEq(toks: List[SpTok], fallback: Int): Int =
  if (List.isEmpty(toks)) fallback else List.at(toks, 0).tok match {
  case Tok.Eq => if (List.isEmpty(List.tail(toks))) fallback else List.at(List.tail(toks), 0).off
  case Tok.LBracket => funBodySeekEq(skipGroup(List.tail(toks), Tok.LBracket, Tok.RBracket, 1), fallback)
  case Tok.LParen => funBodySeekEq(skipGroup(List.tail(toks), Tok.LParen, Tok.RParen, 1), fallback)
  case _ => funBodySeekEq(List.tail(toks), fallback)
}

def whereOffMapOfSrc(src: String, stem: String): Map[String, Int] =
  scanWhereDecls(Lexer.lex(src), stem, "", 0, Map.empty())

def tokIdentOf(t: Tok): String =
  t match {
    case Tok.Ident(s) => s
    case _ => ""
  }

def readDotIdent(toks: List[SpTok], acc: String): (String, List[SpTok]) =
  if (!List.isEmpty(toks) && !List.isEmpty(List.tail(toks)) && List.at(toks, 0).tok == Tok.Dot && tokIdentOf(List.at(toks, 1).tok) != "") readDotIdent(List.tail(List.tail(toks)), Str.concat(acc, Str.concat(".", tokIdentOf(List.at(toks, 1).tok)))) else (acc, toks)

def skipOptTParams(toks: List[SpTok]): List[SpTok] =
  if (!List.isEmpty(toks) && List.at(toks, 0).tok == Tok.LBracket) skipGroup(List.tail(toks), Tok.LBracket, Tok.RBracket, 1) else toks

def scanParamWheres(toks: List[SpTok], ownerDisp: String, paramIdx: Int, depth: Int, acc: Map[String, Int]): (List[SpTok], Map[String, Int]) =
  if (List.isEmpty(toks)) ([], acc) else for {
  sp = List.at(toks, 0)
  rest = List.tail(toks)
  t = sp.tok
} yield if (t == Tok.LParen || t == Tok.LBracket || t == Tok.LBrace) scanParamWheres(rest, ownerDisp, paramIdx, depth + 1, acc) else if (t == Tok.RParen || t == Tok.RBracket || t == Tok.RBrace) if (depth <= 1 && t == Tok.RParen) (rest, acc) else scanParamWheres(rest, ownerDisp, paramIdx, depth - 1, acc) else if (depth == 1 && t == Tok.Comma) scanParamWheres(rest, ownerDisp, paramIdx + 1, depth, acc) else if (depth == 1 && t == Tok.Where) scanParamWheres(rest, ownerDisp, paramIdx, depth, Map.set(acc, whereSiteKey(ownerDisp, paramIdx), sp.off)) else scanParamWheres(rest, ownerDisp, paramIdx, depth, acc)

def scanDeclParams(toks: List[SpTok], ownerDisp: String, acc: Map[String, Int]): (List[SpTok], Map[String, Int]) =
  for {
    afterTp = skipOptTParams(toks)
  } yield if (!List.isEmpty(afterTp) && List.at(afterTp, 0).tok == Tok.LParen) scanParamWheres(List.tail(afterTp), ownerDisp, 0, 1, acc) else (afterTp, acc)

def isTopResetTok(t: Tok): Bool =
  t == Tok.Def || t == Tok.Oracle || t == Tok.Private || t == Tok.Record || t == Tok.TypeKw || t == Tok.Trait || t == Tok.Impl || t == Tok.Import || t == Tok.AtMain

def scanWhereDecls(toks: List[SpTok], stem: String, curEnum: String, braceDepth: Int, acc: Map[String, Int]): Map[String, Int] =
  if (List.isEmpty(toks)) acc else for {
  sp = List.at(toks, 0)
  rest = List.tail(toks)
  t = sp.tok
} yield if (t == Tok.Eof) acc else if (t == Tok.LBrace) scanWhereDecls(rest, stem, curEnum, braceDepth + 1, acc) else if (t == Tok.RBrace) scanWhereDecls(rest, stem, curEnum, if (braceDepth > 0) braceDepth - 1 else 0, acc) else if (braceDepth == 0 && t == Tok.Def && !List.isEmpty(rest) && tokIdentOf(List.at(rest, 0).tok) != "") for {
  nm = readDotIdent(List.tail(rest), tokIdentOf(List.at(rest, 0).tok))
  ownerDisp = if (hasDot(nm._1)) nm._1 else Resolve.qualified(stem, nm._1)
  step = scanDeclParams(nm._2, ownerDisp, acc)
} yield scanWhereDecls(step._1, stem, "", 0, step._2) else if (braceDepth == 0 && t == Tok.Record && !List.isEmpty(rest) && tokIdentOf(List.at(rest, 0).tok) != "") for {
  rname = tokIdentOf(List.at(rest, 0).tok)
  step = scanDeclParams(List.tail(rest), Resolve.qualified(stem, rname), acc)
} yield scanWhereDecls(step._1, stem, "", 0, step._2) else if (braceDepth == 0 && t == Tok.Enum && !List.isEmpty(rest) && tokIdentOf(List.at(rest, 0).tok) != "") scanWhereDecls(List.tail(rest), stem, Resolve.qualified(stem, tokIdentOf(List.at(rest, 0).tok)), 0, acc) else if (braceDepth == 0 && curEnum != "" && t == Tok.Case && !List.isEmpty(rest) && tokIdentOf(List.at(rest, 0).tok) != "") for {
  cname = tokIdentOf(List.at(rest, 0).tok)
  step = scanDeclParams(List.tail(rest), Str.concat(curEnum, Str.concat(".", cname)), acc)
} yield scanWhereDecls(step._1, stem, curEnum, 0, step._2) else scanWhereDecls(rest, stem, if (braceDepth == 0 && isTopResetTok(t)) "" else curEnum, braceDepth, acc)

def mkRuleSite(key: String, rejKind: String, kind: String, rule: String, file: String, src: String, off: Int): RuleSite =
  for {
    loc = Check.locOf(src, off)
  } yield RuleSite(key, rejKind, kind, rule, file, loc._1, loc._2, loc._3, loc._4)

def whereSitesOfProg(src: String, file: String, stem: String, defs: List[Fun], ens: List[En]): List[RuleSite] =
  if (!Str.contains(src, "where")) [] else for {
  woffs = whereOffMapOfSrc(src, stem)
} yield List.concat(funWhereSites(src, file, stem, defs, woffs), enWhereSites(src, file, stem, ens, woffs))

def funWhereSites(src: String, file: String, stem: String, ds: List[Fun], woffs: Map[String, Int]): List[RuleSite] =
  if (List.isEmpty(ds)) [] else List.concat(funOneWhereSites(src, file, stem, List.at(ds, 0), woffs), funWhereSites(src, file, stem, List.tail(ds), woffs))

def funOneWhereSites(src: String, file: String, stem: String, d: Fun, woffs: Map[String, Int]): List[RuleSite] =
  if (d.ora || d.mod != "" && d.mod != stem) [] else paramWhereSites(src, file, if (hasDot(d.name)) d.name else Resolve.qualified(if (d.mod == "") stem else d.mod, d.name), d.params, 0, d.off, woffs)

def enWhereSites(src: String, file: String, stem: String, ens: List[En], woffs: Map[String, Int]): List[RuleSite] =
  if (List.isEmpty(ens)) [] else List.concat(enOneWhereSites(src, file, stem, List.at(ens, 0), woffs), enWhereSites(src, file, stem, List.tail(ens), woffs))

def enOneWhereSites(src: String, file: String, stem: String, en: En, woffs: Map[String, Int]): List[RuleSite] =
  if (en.mod != "" && en.mod != stem && Resolve.owner(en.name) != stem) [] else if (en.isRec || recLike(en.name, en.cases)) paramWhereSites(src, file, Resolve.qualified(stem, en.name), firstCaseParams(en.cases), 0, 0, woffs) else enCaseWhereSites(src, file, Resolve.qualified(stem, en.name), en.cases, woffs)

def enCaseWhereSites(src: String, file: String, enDisp: String, cs: List[EnCase], woffs: Map[String, Int]): List[RuleSite] =
  if (List.isEmpty(cs)) [] else List.concat(paramWhereSites(src, file, Str.concat(enDisp, Str.concat(".", Resolve.short(List.at(cs, 0).name))), List.at(cs, 0).fields, 0, 0, woffs), enCaseWhereSites(src, file, enDisp, List.tail(cs), woffs))

def paramWhereSites(src: String, file: String, ownerDisp: String, ps: List[Param], j: Int, fallbackOff: Int, woffs: Map[String, Int]): List[RuleSite] =
  if (List.isEmpty(ps)) [] else for {
  p = List.at(ps, 0)
  rest = paramWhereSites(src, file, ownerDisp, List.tail(ps), j + 1, fallbackOff, woffs)
  siteKey = whereSiteKey(ownerDisp, j)
  off = Map.getOrElse(woffs, siteKey, fallbackOff)
} yield if (p.w == "") rest else mkRuleSite(siteKey, "check", "where", Str.concat(ownerDisp, Str.concat(" ", p.w)), file, src, off) :: rest

def exprSitesAt(e: Expr, src: String, file: String, owner: String, idx: Int, reqOffs: List[Int], env: List[(String, Ty)], ftab: Ftab, ens: List[En]): SiteWalk =
  if (!exprHasRuleExpr(e) && List.isEmpty(reqOffs)) SiteWalk([], idx, reqOffs) else e match {
  case Expr.EPrint(inner, _) => exprSitesAt(inner, src, file, owner, idx, reqOffs, env, ftab, ens)
  case Expr.ECall(f, args, off) => if (isPropRuleCall(f, args)) for {
  siteKey = Str.concat(owner, Str.concat("#", Str.fromInt(idx)))
  rk = if (f == "Property.assert") "assert" else "check"
  kind = if (f == "Property.assert") "property-assert" else "property-check"
  lbl = propCallLabel(List.at(args, 0), rk)
  site = mkRuleSite(siteKey, rk, kind, lbl, file, src, off)
  rest = listSitesAt(args, src, file, owner, idx + 1, reqOffs, env, ftab, ens)
} yield SiteWalk(site :: rest.sites, rest.next, rest.reqOffs) else listSitesAt(args, src, file, owner, idx, reqOffs, env, ftab, ens)
  case Expr.EMethod(recv, name, args, off) => for {
  r = exprSitesAt(recv, src, file, owner, idx, reqOffs, env, ftab, ens)
  isReq = name == "require"
  reqOff = if (List.isEmpty(r.reqOffs)) off else List.at(r.reqOffs, 0)
  remOffs = if (isReq && !List.isEmpty(r.reqOffs)) List.tail(r.reqOffs) else r.reqOffs
  nextIdx = if (isReq) r.next + 1 else r.next
  a = listSitesAt(args, src, file, owner, nextIdx, remOffs, env, ftab, ens)
  siteKey = Str.concat(owner, Str.concat("#", Str.fromInt(r.next)))
  rk = if (isReq && isIoRecvExpr(recv, env, ftab, ens)) "assert" else "check"
  own = if (isReq) mkRuleSite(siteKey, rk, "require", reqLabelOf(args), file, src, reqOff) :: [] else []
} yield SiteWalk(List.concat(r.sites, List.concat(own, a.sites)), a.next, a.reqOffs)
  case Expr.EField(recv, _, _) => exprSitesAt(recv, src, file, owner, idx, reqOffs, env, ftab, ens)
  case Expr.EBin(_, l, r, _) => for {
  s1 = exprSitesAt(l, src, file, owner, idx, reqOffs, env, ftab, ens)
  s2 = exprSitesAt(r, src, file, owner, s1.next, s1.reqOffs, env, ftab, ens)
} yield SiteWalk(List.concat(s1.sites, s2.sites), s2.next, s2.reqOffs)
  case Expr.EUn(_, inner, _) => exprSitesAt(inner, src, file, owner, idx, reqOffs, env, ftab, ens)
  case Expr.ELam(p, ty, body) => exprSitesAt(body, src, file, owner, idx, reqOffs, Check.bindLam(p, ty, env), ftab, ens)
  case Expr.EIf(c, t, el, _) => for {
  s1 = exprSitesAt(c, src, file, owner, idx, reqOffs, env, ftab, ens)
  s2 = exprSitesAt(t, src, file, owner, s1.next, s1.reqOffs, env, ftab, ens)
  s3 = exprSitesAt(el, src, file, owner, s2.next, s2.reqOffs, env, ftab, ens)
} yield SiteWalk(List.concat(s1.sites, List.concat(s2.sites, s3.sites)), s3.next, s3.reqOffs)
  case Expr.EMatch(s, arms, _) => for {
  s1 = exprSitesAt(s, src, file, owner, idx, reqOffs, env, ftab, ens)
  s2 = if (!armsHaveRuleExpr(arms) && List.isEmpty(s1.reqOffs)) SiteWalk([], s1.next, s1.reqOffs) else armsSitesAt(arms, inferTy(s, env, ftab, ens), src, file, owner, s1.next, s1.reqOffs, env, ftab, ens)
} yield SiteWalk(List.concat(s1.sites, s2.sites), s2.next, s2.reqOffs)
  case Expr.EInterp(_, parts, _) => listSitesAt(parts, src, file, owner, idx, reqOffs, env, ftab, ens)
  case Expr.EList(xs) => listSitesAt(xs, src, file, owner, idx, reqOffs, env, ftab, ens)
  case Expr.ETuple(xs) => listSitesAt(xs, src, file, owner, idx, reqOffs, env, ftab, ens)
  case Expr.ENamed(_, inner) => exprSitesAt(inner, src, file, owner, idx, reqOffs, env, ftab, ens)
  case Expr.EAscribe(inner, _, _) => exprSitesAt(inner, src, file, owner, idx, reqOffs, env, ftab, ens)
  case Expr.EFor(bs, body, _) => forSitesAt(bs, body, src, file, owner, idx, reqOffs, env, ftab, ens)
  case _ => SiteWalk([], idx, reqOffs)
}

def listSitesAt(xs: List[Expr], src: String, file: String, owner: String, idx: Int, reqOffs: List[Int], env: List[(String, Ty)], ftab: Ftab, ens: List[En]): SiteWalk =
  if (List.isEmpty(xs)) SiteWalk([], idx, reqOffs) else for {
  h = exprSitesAt(List.at(xs, 0), src, file, owner, idx, reqOffs, env, ftab, ens)
  t = listSitesAt(List.tail(xs), src, file, owner, h.next, h.reqOffs, env, ftab, ens)
} yield SiteWalk(List.concat(h.sites, t.sites), t.next, t.reqOffs)

def armsSitesAt(xs: List[Arm], scrutTy: String, src: String, file: String, owner: String, idx: Int, reqOffs: List[Int], env: List[(String, Ty)], ftab: Ftab, ens: List[En]): SiteWalk =
  if (List.isEmpty(xs)) SiteWalk([], idx, reqOffs) else for {
  a = List.at(xs, 0)
  afterGuard = List.drop(reqOffs, countReqInGuard(a.g))
  h = if (!exprHasRuleExpr(a.body) && List.isEmpty(afterGuard)) SiteWalk([], idx, afterGuard) else exprSitesAt(a.body, src, file, owner, idx, afterGuard, Check.bindPat(a.pat, scrutTy, env, ens), ftab, ens)
  t = armsSitesAt(List.tail(xs), scrutTy, src, file, owner, h.next, h.reqOffs, env, ftab, ens)
} yield SiteWalk(List.concat(h.sites, t.sites), t.next, t.reqOffs)

def forSitesAt(bs: List[Bind], body: Expr, src: String, file: String, owner: String, idx: Int, reqOffs: List[Int], env: List[(String, Ty)], ftab: Ftab, ens: List[En]): SiteWalk =
  if (List.isEmpty(bs)) exprSitesAt(body, src, file, owner, idx, reqOffs, env, ftab, ens) else for {
  b = List.at(bs, 0)
  h = exprSitesAt(b.value, src, file, owner, idx, reqOffs, env, ftab, ens)
  needEnv = bindsHaveRuleExpr(List.tail(bs)) || exprHasRuleExpr(body)
  nextEnv = if (needEnv) Check.bindFor(b.draw, b.name, inferTy(b.value, env, ftab, ens), env, ens) else env
  t = forSitesAt(List.tail(bs), body, src, file, owner, h.next, h.reqOffs, nextEnv, ftab, ens)
} yield SiteWalk(List.concat(h.sites, t.sites), t.next, t.reqOffs)

def progSitesOfEntry(stem: String, src: String, file: String, fp: Prog, ftab: Ftab, pins: List[En]): List[RuleSite] =
  if (!srcMayHaveRuleExpr(src) && !Str.contains(src, "where")) [] else for {
  ws = whereSitesOfProg(src, file, stem, fp.defs, fp.enums)
  bodySites = if (!srcMayHaveRuleExpr(src)) [] else for {
  toks = Lexer.lex(src)
  allReqOffs = if (!Str.contains(src, "require")) [] else reqOffsOfToks(expandToks(toks))
  declOffs = progDeclOffs(fp, toks)
  ims = List.flatMap(fp.impls, im => List.flatMap(im.methods, m => funSitesAt(m, src, file, imOwnerKey(stem, im, m.name), toks, allReqOffs, declOffs, ftab, pins)))
  ds = List.flatMap(fp.defs, d => funSitesAt(d, src, file, funOwnerKey(stem, d.name), toks, allReqOffs, declOffs, ftab, pins))
  mOff = atMainOff(toks)
  mReqs = if (mOff < 0 || List.isEmpty(allReqOffs)) [] else sliceOffs(allReqOffs, funBodyStartOff(toks, mOff), nextDeclOff(declOffs, mOff, Str.len(src)))
  ms = if (mOff < 0 || !exprHasRuleExpr(fp.body)) [] else exprSitesAt(fp.body, src, file, mainOwnerKey(stem), 0, mReqs, mainEnv(stem), ftab, pins).sites
} yield List.concat(ims, List.concat(ds, ms))
} yield List.concat(ws, bodySites)

def funSitesAt(d: Fun, src: String, file: String, owner: String, toks: List[SpTok], allReqOffs: List[Int], declOffs: List[Int], ftab: Ftab, ens: List[En]): List[RuleSite] =
  if (!exprHasRuleExpr(d.body)) [] else for {
  reqs = if (List.isEmpty(allReqOffs)) [] else sliceOffs(allReqOffs, funBodyStartOff(toks, d.off), nextDeclOff(declOffs, d.off, Str.len(src)))
} yield exprSitesAt(d.body, src, file, owner, 0, reqs, Check.bindParams(d.params, Check.envSelfMod(d.mod)), ftab, ens).sites

def ruleSitesOf(liveFiles: List[(String, String)], scnPair: (String, String), verPairs: List[(String, String)]): List[RuleSite] =
  for {
    kept = parseKept(liveFiles)
    merged = Resolve.prog(mergeKept(kept))
    resolved = resolveKept(kept, merged)
    funs = Check.expandDefs(merged.defs, merged.aliases)
    ens = Check.expandEnums(merged.enums, merged.aliases)
    ftab = Check.ftabOfList(funs)
    pins = Check.withLetterPins(ens)
    liveSites = List.flatMap(resolved, row => progSitesOfEntry(row._1, row._2, Check.fileOf(row._1), row._3, ftab, pins))
    withScn = if (scnPair._2 == "") liveSites else mergeScenarioSites(liveSites, scnPair._1, scnPair._2, funs, ens)
    verSites = List.flatMap(verPairs, vp => verifyFileSites(vp._1, vp._2, ftab, pins))
  } yield List.concat(verSites, withScn)

def mergeScenarioSites(liveSites: List[RuleSite], scnFile: String, scnSrc: String, liveFuns: List[Fun], liveEns: List[En]): List[RuleSite] =
  for {
    rawP = Parse.parseFile("__scn", scnSrc)
    scnEn = Check.expandEnums(rawP.enums, rawP.aliases)
    scnFuns = Check.expandDefs(rawP.defs, rawP.aliases)
    allFuns = List.concat(scnFuns, liveFuns)
    allEns = List.concat(scnEn, liveEns)
    ftab = Check.ftabOfList(allFuns)
    idx = Resolve.indexOf(Prog("", allEns, rawP.aliases, [], [], rawP.imps, allFuns, "", Expr.EUnit, ""))
    resP = resolveKeptProg(Resolve.program(rawP, idx), rawP.aliases)
    toks = Lexer.lex(scnSrc)
    allReqOffs = if (!Str.contains(scnSrc, "require")) [] else reqOffsOfToks(expandToks(toks))
    declOffs = progDeclOffs(resP, toks)
    pins = Check.withLetterPins(allEns)
    ctxTy = ctxTyOf(resP.defs)
    ws = whereSitesOfProg(scnSrc, scnFile, "__scn", resP.defs, resP.enums)
    replOwners = List.map(List.filter(resP.defs, d => hasDot(d.name)), d => Str.concat(d.name, "#"))
    keptLive = List.filter(liveSites, s => !List.exists(replOwners, pre => Str.startsWith(s.key, pre)))
    ds = List.flatMap(resP.defs, d => scenarioDefSites(d, ctxTy, scnSrc, scnFile, toks, allReqOffs, declOffs, ftab, pins))
  } yield List.concat(ws, List.concat(ds, keptLive))

def scenarioDefSites(d: Fun, ctxTy: String, src: String, file: String, toks: List[SpTok], allReqOffs: List[Int], declOffs: List[Int], ftab: Ftab, ens: List[En]): List[RuleSite] =
  if (hasDot(d.name)) funSitesAt(d.copy(mod = replMod(d.name)), src, file, d.name, toks, allReqOffs, declOffs, ftab, ens) else for {
  owner = if (isCtxDriver(d, ctxTy)) Str.concat("__scn._scn_", d.name) else funOwnerKey("__scn", d.name)
} yield funSitesAt(d, src, file, owner, toks, allReqOffs, declOffs, ftab, ens)

def verifyFileSites(verFile: String, verSrc: String, ftab: Ftab, pins: List[En]): List[RuleSite] =
  for {
    toks = Lexer.lex(verSrc)
    p = Parse.parse(toks)
    allReqOffs = if (!Str.contains(verSrc, "require")) [] else reqOffsOfToks(expandToks(toks))
    declOffs = progDeclOffs(p, toks)
    topSites = List.flatMap(p.defs, d => verifyTopDefSite(d, verFile, verSrc))
    helperSites = if (!srcMayHaveRuleExpr(verSrc)) [] else List.flatMap(p.defs, d => funSitesAt(d, verSrc, verFile, funOwnerKey(verFile, d.name), toks, allReqOffs, declOffs, ftab, pins))
  } yield List.concat(topSites, helperSites)

def verifyTopDefSite(d: Fun, verFile: String, verSrc: String): List[RuleSite] =
  if (!d.priv && d.ora) mkRuleSite(Str.concat("oracle:", d.name), "assert", "oracle", d.name, verFile, verSrc, d.off) :: [] else if (isClaim(d)) mkRuleSite(Str.concat("claim:", d.name), "claim", "claim", d.name, verFile, verSrc, d.off) :: [] else []

def rejectionReasonLine(rejection: String): String =
  rejectionReasonGo(List.filter(linesOf(rejection), l => l != ""))

def rejectionReasonGo(lines: List[String]): String =
  if (List.isEmpty(lines)) "" else if (List.at(lines, 0) == "v1") if (List.isEmpty(List.tail(lines))) "" else List.at(List.tail(lines), 0) else List.at(lines, 0)

def parseRejectionReason(reason: String): (String, String, String) =
  if (Str.startsWith(reason, "oracle ") && Str.endsWith(reason, " rejected")) for {
  raw = Str.slice(reason, 7, Str.len(reason) - 9)
  sp = splitRuleTag(raw)
} yield ("assert", sp._1, sp._2) else if (Str.startsWith(reason, "property check failed: ")) for {
  raw = Str.drop(reason, 23)
  sp = splitRuleTag(raw)
} yield ("check", sp._1, sp._2) else if (Str.startsWith(reason, "claim ")) parseClaimRejection(Str.drop(reason, 6)) else parseFailedClaimReason(reason, findIdx(reason, " failed: ", 0))

def parseClaimRejection(rest: String): (String, String, String) =
  for {
    i = findIdx(rest, " rejected", 0)
  } yield if (i <= 0) ("", "", "") else ("claim", Str.concat("claim:", Str.slice(rest, 0, i)), Str.slice(rest, 0, i))

def parseFailedClaimReason(reason: String, i: Int): (String, String, String) =
  if (i <= 0) ("", "", "") else for {
  tail = Str.drop(reason, i + 9)
  j = findIdx(tail, " at state ", 0)
  nm = if (j > 0) Str.slice(tail, 0, j) else tail
} yield ("claim", Str.concat("claim:", nm), nm)

def resolveFailure(sites: List[RuleSite], rejection: String, workload: String, repro: String, events: List[String]): RuleFailure =
  for {
    parsed = parseRejectionReason(rejectionReasonLine(rejection))
    rk = parsed._1
    tagKey = parsed._2
    rule = parsed._3
  } yield if (rk == "") noRuleFailure() else resolveFailureHit(findRuleSite(sites, rk, tagKey, rule), rule, workload, repro, events)

def findRuleSite(sites: List[RuleSite], rk: String, tagKey: String, rule: String): List[RuleSite] =
  if (tagKey != "") for {
  byKey = List.filter(sites, s => s.key == tagKey)
} yield if (!List.isEmpty(byKey)) byKey else List.filter(sites, s => s.rejKind == rk && s.rule == rule) else List.filter(sites, s => s.rejKind == rk && s.rule == rule)

def resolveFailureHit(hits: List[RuleSite], rule: String, workload: String, repro: String, events: List[String]): RuleFailure =
  if (List.isEmpty(hits)) noRuleFailure() else for {
  s = List.at(hits, 0)
  cleanRule = if (rule != "") rule else s.rule
} yield RuleFailure(s.kind, cleanRule, s.file, s.line, s.column, s.endLine, s.endColumn, workload, repro, events)

def failureHuman(f: RuleFailure): String =
  if (f.kind == "") "" else Str.concat(f.file, Str.concat(":", Str.concat(Str.fromInt(f.line), Str.concat(":", Str.concat(Str.fromInt(f.column), Str.concat(": error: ", Str.concat(f.kind, Str.concat(" ", Str.concat(f.rule, Str.concat(" failed on ", Str.concat(f.workload, Str.concat(" (", Str.concat(if (List.isEmpty(f.events)) "no events" else List.join(f.events, "; "), ")")))))))))))))

def cleanProbeText(text: String, wrapSrc: String, sites: List[RuleSite], scnFile: String): String =
  cleanVerifyPaths(stripRuleTagsInText(text), wrapSrc, sites, scnFile)

def cleanVerifyPaths(text: String, wrapSrc: String, sites: List[RuleSite], scnFile: String): String =
  if (!Str.contains(text, "__verify.scuzz:")) text else cleanVerifyPathsGo(text, 0, Builder.empty(), wrapSrc, sites, scnFile)

def cleanVerifyPathsGo(text: String, pos: Int, b: Builder, wrapSrc: String, sites: List[RuleSite], scnFile: String): String =
  for {
    i = findIdx(text, "__verify.scuzz:", pos)
  } yield if (i < 0) Builder.result(Builder.append(b, Str.drop(text, pos))) else cleanVerifyPathsAt(text, pos, i, b, wrapSrc, sites, scnFile)

def readDigitsEnd(s: String, i: Int): Int =
  if (i >= Str.len(s)) i else if (Str.charAt(s, i) >= 48 && Str.charAt(s, i) <= 57) readDigitsEnd(s, i + 1) else i

def cleanVerifyPathsAt(text: String, pos: Int, i: Int, b: Builder, wrapSrc: String, sites: List[RuleSite], scnFile: String): String =
  for {
    lStart = i + 15
    lEnd = readDigitsEnd(text, lStart)
    hasCol = lEnd > lStart && lEnd < Str.len(text) && Str.charAt(text, lEnd) == 58
    cStart = lEnd + 1
    cEnd = if (hasCol) readDigitsEnd(text, cStart) else lEnd
    valid = hasCol && cEnd > cStart
    wrapLine = if (valid) Str.toInt(Str.slice(text, lStart, lEnd), 1) else 1
    repl = mapVerifyLineLoc(wrapLine, wrapSrc, sites, scnFile)
    nextPos = if (!valid) lStart else if (repl == "" && cEnd + 2 <= Str.len(text) && Str.slice(text, cEnd, cEnd + 2) == ": ") cEnd + 2 else cEnd
  } yield cleanVerifyPathsGo(text, nextPos, Builder.append(Builder.append(b, Str.slice(text, pos, i)), if (valid) repl else "__verify"), wrapSrc, sites, scnFile)

def mapVerifyLineLoc(line: Int, wrapSrc: String, sites: List[RuleSite], scnFile: String): String =
  if (wrapSrc == "") fallbackVerifyLoc(sites, scnFile) else for {
  p = Parse.parse(Lexer.lex(wrapSrc))
  hit = findWrapDefAtLine(p.defs, wrapSrc, line, "")
} yield mapWrapDefNameLoc(hit, sites, scnFile)

def findWrapDefAtLine(ds: List[Fun], wrapSrc: String, line: Int, best: String): String =
  if (List.isEmpty(ds)) best else for {
  d = List.at(ds, 0)
  dLine = Check.locOf(wrapSrc, d.off)._1
  nextBest = if (dLine <= line) d.name else best
} yield findWrapDefAtLine(List.tail(ds), wrapSrc, line, nextBest)

def mapWrapDefNameLoc(fnName: String, sites: List[RuleSite], scnFile: String): String =
  if (Str.startsWith(fnName, "_drv_")) siteKeyLocStr(sites, Str.concat("oracle:", Str.drop(fnName, 5)), scnFile) else if (Str.startsWith(fnName, "_claim_")) siteKeyLocStr(sites, Str.concat("claim:", Str.drop(fnName, 7)), scnFile) else fallbackVerifyLoc(sites, scnFile)

def siteKeyLocStr(sites: List[RuleSite], key: String, scnFile: String): String =
  for {
    hits = List.filter(sites, s => s.key == key)
  } yield if (!List.isEmpty(hits)) fmtSiteLoc(List.at(hits, 0)) else fallbackVerifyLoc(sites, scnFile)

def fmtSiteLoc(s: RuleSite): String =
  Str.concat(s.file, Str.concat(":", Str.concat(Str.fromInt(s.line), Str.concat(":", Str.fromInt(s.column)))))

def fallbackVerifyLoc(sites: List[RuleSite], scnFile: String): String =
  if (scnFile != "") Str.concat(scnFile, ":1:1") else if (!List.isEmpty(sites)) fmtSiteLoc(List.at(sites, 0)) else ""

