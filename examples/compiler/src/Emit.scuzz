def viewPtr2Rt(f: String): String =
  if (f == "View.appShell") "sz_lang_view_app_shell" else if (f == "View.appBar") "sz_lang_view_app_bar" else if (f == "View.tabs") "sz_lang_view_tabs" else if (f == "View.indexBook") "sz_lang_view_index_book" else if (f == "View.badge") "sz_lang_view_badge" else if (f == "View.visibility") "sz_lang_view_visibility" else if (f == "View.offstage") "sz_lang_view_offstage" else if (f == "View.overlay") "sz_lang_view_overlay" else ""

