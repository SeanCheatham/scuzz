def emitViewListTile(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (List.isEmpty(List.tail(vals))) emitViewListTile1(code, vals, owns, prefix) else emitViewPtr2("sz_lang_view_list_tile", true, false, code, vals, owns, prefix)

def emitViewListTile1(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_view_list_tile(ptr ", Str.concat(arg0(vals), ", ptr null)")))), if (headOwn(owns)) relPtr(arg0(vals)) else "")), pct(prefix, "v"), true)

def emitViewEachCall(args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(List.tail(args))) emitViewEach1(emitExpr(List.at(args, 0), Str.concat(prefix, "_src"), strs, defs, ens, ps, loc), prefix) else emitViewEachJoin(emitExpr(List.at(args, 0), Str.concat(prefix, "_src"), strs, defs, ens, ps, loc), List.at(List.tail(args), 0), eachElemTy(List.at(args, 0), defs, ens, ps, loc), prefix, strs, defs, ens, ps, loc)

def emitViewEach1(src: Slot, prefix: String): Slot =
  src match {
    case Slot(sc, sv, _) => Slot(join(sc, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_view_each(ptr ", Str.concat(sv, ")"))))), pct(prefix, "v"), true)
  }

def emitViewEachJoin(src: Slot, fn: Expr, elemTy: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  src match {
    case Slot(sc, sv, _) => emitViewEachJoin2(sc, sv, emitEachLamTy(fn, elemTy, Str.concat(prefix, "_fn"), strs, defs, ens, ps, loc), prefix)
  }

def emitEachLamTy(e: Expr, elemTy: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  e match {
    case Expr.ELam(p, _, body) => emitLam2(emitNethGoTy(prefix, p, body, dropParam(ps, p), strs, defs, ens, loc, false, eachBindTy(p, body, dropParam(ps, p), defs, elemTy)), emitPackEnv(copyPs(ps), Str.concat(prefix, "_e")), prefix)
    case _ => emitExpr(e, prefix, strs, defs, ens, ps, loc)
  }

def eachBindTy(p: String, body: Expr, rest: List[Param], defs: Ftab, elemTy: String): String =
  if (p == "__tup" || p == "__p" || p == "_ph") nethBindTy(p, body, rest, defs) else if (elemTy != "") elemTy else nethBindTy(p, body, rest, defs)

def eachElemTy(e: Expr, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  eachElemOf(exprRetTyEns(e, defs, ens, ps, loc))

def eachElemOf(ty: String): String =
  if (Str.startsWith(ty, "Signal[List[") && Str.len(ty) > 14) Str.slice(ty, 12, Str.len(ty) - 2) else "String"

def emitViewEachJoin2(sc: String, sv: String, pack: Slot, prefix: String): Slot =
  pack match {
    case Slot(pc, pv, po) => Slot(join(sc, join(pc, join(unpackFnPtr(pv, prefix), join(eachMapCall(sv, prefix), if (po) relPtr(pv) else "")))), pct(prefix, "v"), true)
  }

def eachMapCall(src: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_view_each_map(ptr ", Str.concat(src, Str.concat(", ptr ", Str.concat(pct(prefix, "fnp"), Str.concat(", ptr ", Str.concat(pct(prefix, "envp"), ")"))))))))

def emitInkWellCall(args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitInkWellJoin(emitExpr(List.at(args, 0), Str.concat(prefix, "_arg0"), strs, defs, ens, ps, loc), List.at(List.tail(args), 0), emitExpr(List.at(List.tail(List.tail(args)), 0), Str.concat(prefix, "_arg2"), strs, defs, ens, ps, loc), prefix, strs, defs, ens, ps, loc)

def emitInkWellJoin(lab: Slot, fn: Expr, child: Slot, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  lab match {
    case Slot(lc, lv, lo) => emitInkWellJoin1(lc, lv, lo, fn, child, prefix, strs, defs, ens, ps, loc)
  }

def emitInkWellJoin1(lc: String, lv: String, lo: Bool, fn: Expr, child: Slot, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  child match {
    case Slot(cc, cv, _) => emitInkWellJoin2(lc, lv, lo, cc, cv, emitTapLam(fn, Str.concat(prefix, "_fn"), strs, defs, ens, ps, loc), prefix)
  }

def emitInkWellJoin2(lc: String, lv: String, lo: Bool, cc: String, cv: String, pack: Slot, prefix: String): Slot =
  pack match {
    case Slot(pc, pv, po) => Slot(join(lc, join(cc, join(pc, join(unpackFnPtr(pv, prefix), join(inkWellCall(lv, cv, prefix), join(if (lo) relPtr(lv) else "", if (po) relPtr(pv) else "")))))), pct(prefix, "v"), true)
  }

def emitOracleSumTo(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_oracle_sum_to(i64 ", Str.concat(arg0(vals), ")"))))), pct(prefix, "v"), false)

def emitListRange(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_range(i64 ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), ")"))))))), pct(prefix, "v"), true)

def emitListFill(code: String, vals: List[String], owns: List[Bool], prefix: String, boxElem: Bool, isFloat: Bool): Slot =
  if (boxElem) emitListFill2(join(code, pairBoxTyped(arg1(vals), true, isFloat, prefix, "lb")), arg0(vals), pct(prefix, "lb"), true, prefix) else emitListFill2(code, arg0(vals), arg1(vals), headOwn(tailOwn(owns)), prefix)

def emitListFill2(code: String, n: String, v: String, ov: Bool, prefix: String): Slot =
  Slot(join(code, join(emitListFillCall(n, v, prefix), if (ov) relPtr(v) else "")), pct(prefix, "v"), true)

def emitListFillCall(n: String, v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_fill(i64 ", Str.concat(n, Str.concat(", ptr ", Str.concat(v, ")"))))))

def emitListGetOr(code: String, vals: List[String], owns: List[Bool], prefix: String, numeric: Bool, boxDefault: Bool): Slot =
  if (numeric) emitListGetOrNum(code, vals, owns, prefix, boxDefault) else emitListGetOr2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(tailOwn(owns))), prefix)

def emitListGetOrNum(code: String, vals: List[String], owns: List[Bool], prefix: String, boxDefault: Bool): Slot =
  if (boxDefault) emitUnboxSlot(emitListGetOr2(join(code, pairBox(arg2(vals), true, prefix, "lb")), arg0(vals), arg1(vals), pct(prefix, "lb"), headOwn(owns), true, prefix), prefix) else emitUnboxSlot(emitListGetOr2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(tailOwn(owns))), prefix), prefix)

def emitUnboxSlot(s: Slot, prefix: String): Slot =
  s match {
    case Slot(code, v, o) => Slot(join(code, join(unboxLine(v, prefix), if (o) relPtr(v) else "")), pct(prefix, "u"), false)
  }

def emitListGetOr2(code: String, xs: String, i: String, d: String, xsO: Bool, dO: Bool, prefix: String): Slot =
  Slot(join(code, join(emitListGetOrCall2(xs, i, d, prefix), getOrAfter(xs, d, xsO, dO, pct(prefix, "v")))), pct(prefix, "v"), xsO || dO)

def emitListGetOrCall2(xs: String, i: String, d: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_get_or(ptr ", Str.concat(xs, Str.concat(", i64 ", Str.concat(i, Str.concat(", ptr ", Str.concat(d, ")"))))))))

def getOrAfter(src: String, d: String, srcO: Bool, dO: Bool, result: String): String =
  if (srcO) join(join(retPtr(result), relPtr(src)), if (dO) relPtr(d) else "") else if (dO) join(retPtr(result), relPtr(d)) else ""

def emitListPadTo(code: String, vals: List[String], owns: List[Bool], prefix: String, boxElem: Bool, isFloat: Bool): Slot =
  if (boxElem) emitListPadTo2(join(code, pairBoxTyped(arg2(vals), true, isFloat, prefix, "lb")), arg0(vals), arg1(vals), pct(prefix, "lb"), headOwn(owns), true, prefix) else emitListPadTo2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(tailOwn(owns))), prefix)

def emitListPadTo2(code: String, xs: String, n: String, v: String, ox: Bool, ov: Bool, prefix: String): Slot =
  Slot(join(code, join(emitListPadToCall(xs, n, v, prefix), join(if (ox) relPtr(xs) else "", if (ov) relPtr(v) else ""))), pct(prefix, "v"), true)

def emitListPadToCall(xs: String, n: String, v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_pad_to(ptr ", Str.concat(xs, Str.concat(", i64 ", Str.concat(n, Str.concat(", ptr ", Str.concat(v, ")"))))))))

def emitStrReplace(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(emitStrReplaceCall(rt, vals, prefix), join(if (headOwn(owns)) relPtr(arg0(vals)) else "", join(if (headOwn(tailOwn(owns))) relPtr(arg1(vals)) else "", if (headOwn(tailOwn(tailOwn(owns)))) relPtr(arg2(vals)) else "")))), pct(prefix, "v"), true)

def emitStrReplaceCall(rt: String, vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(arg0(vals), Str.concat(", ptr ", Str.concat(arg1(vals), Str.concat(", ptr ", Str.concat(arg2(vals), ")"))))))))))

def emitStrPad(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(emitStrPadCall(rt, vals, prefix), join(if (headOwn(owns)) relPtr(arg0(vals)) else "", if (headOwn(tailOwn(tailOwn(owns)))) relPtr(arg2(vals)) else ""))), pct(prefix, "v"), true)

def emitStrPadCall(rt: String, vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), Str.concat(", ptr ", Str.concat(arg2(vals), ")"))))))))))

def emitListExtreme(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String, numeric: Bool): Slot =
  emitListExtreme2(rt, code, arg0(vals), headOwn(owns), prefix, numeric)

def emitListExtreme2(rt: String, code: String, v: String, o: Bool, prefix: String, numeric: Bool): Slot =
  if (numeric) emitListExtremeInt(rt, code, v, o, prefix) else emitListExtremePtr(rt, code, v, o, prefix)

def emitListExtremePtr(rt: String, code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(listExtremeCall(rt, v, prefix), if (o) join(retPtr(pct(prefix, "v")), relPtr(v)) else "")), pct(prefix, "v"), o)

def emitListExtremeInt(rt: String, code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(listExtremeCall(rt, v, prefix), join(if (o) join(retPtr(pct(prefix, "v")), relPtr(v)) else "", join(listExtremeUnbox(prefix), if (o) relPtr(pct(prefix, "v")) else "")))), pct(prefix, "u"), false)

def listExtremeCall(rt: String, v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(v, ")"))))))

def listExtremeUnbox(prefix: String): String =
  line(Str.concat(tmp(prefix, "u"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(prefix, "v"), ")"))))

def emitListToSet(code: String, vals: List[String], owns: List[Bool], prefix: String, args: List[Expr], ps: List[Param]): Slot =
  Slot(join(code, join(emitListToSetCall(arg0(vals), prefix, args, ps), if (headOwn(owns)) relPtr(arg0(vals)) else "")), pct(prefix, "v"), true)

def emitListToSetCall(v: String, prefix: String, args: List[Expr], ps: List[Param]): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_to_set(ptr ", Str.concat(v, Str.concat(", i32 ", Str.concat(listKeyKindArgs(args, ps), ")"))))))

def listKeyKindArgs(args: List[Expr], ps: List[Param]): String =
  if (headUnbox(args, ps)) "0" else "1"

def emitListSlice(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(emitListSliceCall(vals, prefix), if (headOwn(owns)) relPtr(arg0(vals)) else "")), pct(prefix, "v"), true)

def emitListSliceCall(vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_slice(ptr ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), Str.concat(", i64 ", Str.concat(arg2(vals), ")"))))))))

def emitKitPtrI64I64(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitKitPtrI64I642(rt, code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitKitPtrI64I642(rt: String, code: String, a: String, n: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(a, Str.concat(", i64 ", Str.concat(n, ")")))))))), if (o) relPtr(a) else "")), pct(prefix, "v"), false)

def emitMapSizePred(code: String, vals: List[String], owns: List[Bool], prefix: String, pred: String): Slot =
  emitMapSizePred2(code, arg0(vals), headOwn(owns), prefix, pred)

def emitMapSizePred2(code: String, v: String, o: Bool, prefix: String, pred: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "n"), Str.concat("call i64 @sz_map_size(ptr ", Str.concat(v, ")")))), join(line(Str.concat(tmp(prefix, "b"), Str.concat("icmp ", Str.concat(pred, Str.concat(" i64 ", Str.concat(pct(prefix, "n"), ", 0")))))), join(line(Str.concat(tmp(prefix, "v"), Str.concat("zext i1 ", Str.concat(pct(prefix, "b"), " to i64")))), if (o) relPtr(v) else "")))), pct(prefix, "v"), false)

def emitFloatToInt(code: String, vals: List[String], owns: List[Bool], prefix: String, ps: List[Param]): Slot =
  emitFloatToInt2(code, arg0(vals), headOwn(owns), prefix, ps)

def emitFloatToInt2(code: String, v: String, o: Bool, prefix: String, ps: List[Param]): Slot =
  if (fromIntUnbox(v, ps)) Slot(join(code, join(line(Str.concat(tmp(prefix, "fu"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(v, ")")))), join(floatToIntBits(pct(prefix, "fu"), prefix), if (o) relPtr(v) else ""))), pct(prefix, "v"), false) else Slot(join(code, floatToIntBits(v, prefix)), pct(prefix, "v"), false)

def floatToIntBits(v: String, prefix: String): String =
  join(line(Str.concat(tmp(prefix, "fd"), Str.concat("bitcast i64 ", Str.concat(v, " to double")))), line(Str.concat(tmp(prefix, "v"), Str.concat("fptosi double ", Str.concat(pct(prefix, "fd"), " to i64")))))

def emitFloatFromInt(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "ff"), Str.concat("sitofp i64 ", Str.concat(arg0(vals), " to double")))), line(Str.concat(tmp(prefix, "v"), Str.concat("bitcast double ", Str.concat(pct(prefix, "ff"), " to i64")))))), pct(prefix, "v"), false)

def emitCall(f: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  if (isLam2Kit(f)) emitKitLam2(f, args, prefix, strs, defs, ens, ps, loc) else if (!List.isEmpty(args) && isApplyName(f, ps, defs)) emitApply(f, args, prefix, strs, defs, ens, ps, loc) else emitCallKit(f, args, prefix, strs, defs, ens, ps, loc, fid)

def isApplyName(f: String, ps: List[Param], defs: Ftab): Bool =
  isApplyTy(paramTy(ps, f), f, defs)

def isApplyTy(ty: String, f: String, defs: Ftab): Bool =
  if (isFunTy(ty)) true else if (ty == "" || isI64Ty(ty)) false else List.isEmpty(findDef(defs, f))

def emitCallKit(f: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  if (Str.startsWith(f, "Signal.")) emitGenericSignal(f, args, prefix, strs, defs, ens, ps, loc) else if (f == "IO.pure") emitIoPureCall(args, prefix, strs, defs, ens, ps, loc) else if (f == "Net.serveOnce" || f == "Net.serve" || f == "Net.serveOnceTls" || f == "Net.serveTls" || f == "Net.serveOnceTlsFiles" || f == "Net.serveTlsFiles") emitNetServe(f, args, prefix, strs, defs, ens, ps, loc) else if (f == "Ui.run") emitUiRunCall(args, prefix, strs, defs, ens, ps, loc) else if (isLam2Kit(f)) emitKitLam2(f, args, prefix, strs, defs, ens, ps, loc) else if (tapViewRt(f) != "") emitTapViewCall(tapViewRt(f), args, prefix, strs, defs, ens, ps, loc) else if (f == "View.each") emitViewEachCall(args, prefix, strs, defs, ens, ps, loc) else if (f == "View.inkWell") emitInkWellCall(args, prefix, strs, defs, ens, ps, loc) else if (isMapKit(f)) emitMapKit(f, args, prefix, strs, defs, ens, ps, loc) else if (isFoldKit(f)) emitFoldKit(f, args, prefix, strs, defs, ens, ps, loc) else if (f == "Stream.iterate") emitIterKit(args, prefix, strs, defs, ens, ps, loc) else if (f == "List.tabulate") emitTabulate(args, prefix, strs, defs, ens, ps, loc) else if (f == "List.segmentLength") emitSegLen(args, prefix, strs, defs, ens, ps, loc) else emitCallKit2(f, args, prefix, strs, defs, ens, ps, loc, fid)

def emitCallKit2(f: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  if (f == "Property.force") emitPropForce(List.at(args, 0), prefix, strs, defs, ens, ps, loc) else if (f == "Property.check") emitPropCheckCall(args, prefix, strs, defs, ens, ps, loc) else emitCall2(f, emitArgList(alignArgs(f, args, defs, modOfLoc(loc)), prefix, strs, defs, ens, ps, loc, 0, "", noStr(), noBool(), fid), prefix, defs, alignArgs(f, args, defs, modOfLoc(loc)), ens, ps, modOfLoc(loc))

def alignArgs(f: String, args: List[Expr], defs: Ftab, mod: String): List[Expr] =
  alignFill(funParamsOf(defs, f, mod), args)

def alignFill(ps: List[Param], args: List[Expr]): List[Expr] =
  alignFillGot(alignCall(ps, args))

def alignFillGot(p: (List[Expr], String)): List[Expr] =
  p match {
    case (xs, _) => xs
  }

def funParamsOf(defs: Ftab, f: String, mod: String): List[Param] =
  funParamsOfHit(findDefPrefer(defs, f, mod))

def funParamsOfHit(hit: List[Fun]): List[Param] =
  if (List.isEmpty(hit)) noParam() else funParamsOfD(List.at(hit, 0))

def funParamsOfD(d: Fun): List[Param] =
  d match {
    case Fun(_, _, _, _, ps, _, _, _, _) => ps
  }

def emitPropCheckCall(args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitPropCheckCall2(nthE(args, 0), nthE(args, 1), nthE(args, 2), prefix, strs, defs, ens, ps, loc)

def nthE(xs: List[Expr], i: Int): Expr =
  if (List.isEmpty(xs)) Expr.EUnit else if (i <= 0) List.at(xs, 0) else nthE(List.tail(xs), i - 1)

def emitPropCheckCall2(name: Expr, pred: Expr, recv: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitPropCheckJoin(emitExpr(name, Str.concat(prefix, "_n"), strs, defs, ens, ps, loc), emitExpr(recv, Str.concat(prefix, "_r"), strs, defs, ens, ps, loc), pred, recv, prefix, strs, defs, ens, ps, loc)

def emitPropCheckJoin(ns: Slot, rs: Slot, pred: Expr, recv: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  ns match {
    case Slot(nc, nv, no) => emitPropCheckJoin2(nc, nv, no, rs, pred, recv, prefix, strs, defs, ens, ps, loc)
  }

def emitPropCheckJoin2(nc: String, nv: String, no: Bool, rs: Slot, pred: Expr, recv: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  rs match {
    case Slot(rc, rv, ro) => emitPropCheckPred(join(nc, join(rc, if (ro && exprMentions(pred, recv)) retPtr(rv) else "")), nv, no, rv, ro, emitPropPred(pred, rc, rv, ro, recv, prefix, strs, defs, ens, ps, loc))
  }

def emitPropPred(pred: Expr, rc: String, rv: String, ro: Bool, recv: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  pred match {
    case Expr.ENamed(_, inner) => emitPropPred(inner, rc, rv, ro, recv, prefix, strs, defs, ens, ps, loc)
    case Expr.ELam(p, _, body) => emitPropPredLam(p, body, rc, rv, ro, recv, prefix, strs, defs, ens, ps, loc)
    case _ => emitExpr(pred, Str.concat(prefix, "_p"), strs, defs, ens, ps, loc)
  }

def emitPropPredLam(p: String, body: Expr, rc: String, rv: String, ro: Bool, recv: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitPropPredLam2(p, body, Slot("", rv, ro), slotBindI64(Slot(rc, rv, ro), recv, ps, defs), recv, prefix, strs, defs, ens, ps, loc)

def emitPropPredLam2(p: String, body: Expr, arg: Slot, boxInt: Bool, recv: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitApplyLam2(propLamBind(p, boxInt, prefix), propLamBody(p, body, boxInt, prefix), arg, boxInt, applyBindTy(p, recv, defs, ens, ps, loc), Str.concat(prefix, "_p"), strs, defs, ens, ps, loc, 0)

def propLamBind(p: String, boxInt: Bool, prefix: String): String =
  if (boxInt) Str.concat(p, Str.concat("_w", hashDec(prefix))) else p

def propLamBody(p: String, body: Expr, boxInt: Bool, prefix: String): Expr =
  if (propLamBind(p, boxInt, prefix) == p) body else rewriteBind(body, p, propLamBind(p, boxInt, prefix))

def hashDec(s: String): String =
  Str.fromInt(hashGo(s, 0, 5381))

def hashGo(s: String, i: Int, h: Int): Int =
  if (i >= Str.len(s)) hashPos(h) else hashGo(s, i + 1, h * 33 + Str.charAt(s, i))

def hashPos(h: Int): Int =
  if (h < 0) 0 - h % 100000 else h % 100000

def emitPropCheckPred(code: String, nv: String, no: Bool, rv: String, ro: Bool, pred: Slot): Slot =
  pred match {
    case Slot(pc, pv, _) => Slot(join(code, join(pc, join(line(Str.concat("call void @sz_property_check(ptr ", Str.concat(nv, Str.concat(", i64 ", Str.concat(pv, ")"))))), if (no) relPtr(nv) else ""))), rv, ro)
  }

def exprMentions(e: Expr, recv: Expr): Bool =
  recv match {
    case Expr.EVar(s, _) => exprHasVar(e, s)
    case _ => false
  }

def exprHasVar(e: Expr, s: String): Bool =
  e match {
    case Expr.EVar(n, _) => n == s
    case Expr.EPrint(inner, _) => exprHasVar(inner, s)
    case Expr.ECall(_, args, _) => listHasVar(args, s)
    case Expr.EMethod(recv, _, args, _) => exprHasVar(recv, s) || listHasVar(args, s)
    case Expr.EField(recv, _, _) => exprHasVar(recv, s)
    case Expr.EBin(_, l, r, _) => exprHasVar(l, s) || exprHasVar(r, s)
    case Expr.EUn(_, inner, _) => exprHasVar(inner, s)
    case Expr.ELam(_, _, body) => exprHasVar(body, s)
    case Expr.EIf(c, t, el, _) => exprHasVar(c, s) || exprHasVar(t, s) || exprHasVar(el, s)
    case Expr.EMatch(sc, arms, _) => exprHasVar(sc, s) || armsHasVar(arms, s)
    case Expr.EList(xs) => listHasVar(xs, s)
    case Expr.ETuple(xs) => listHasVar(xs, s)
    case Expr.ENamed(_, inner) => exprHasVar(inner, s)
    case Expr.EAscribe(inner, _, _) => exprHasVar(inner, s)
    case Expr.EFor(bs, body, _) => bindsHasVar(bs, s) || exprHasVar(body, s)
    case _ => false
  }

def patternBindsName(pat: String, name: String): Bool =
  List.exists(Check.bindPat(pat, "", [], []), binding => binding._1 == name)

def exprFreeVar(e: Expr, s: String): Bool =
  e match {
    case Expr.EVar(n, _) => n == s
    case Expr.EPrint(inner, _) => exprFreeVar(inner, s)
    case Expr.ECall(_, args, _) => listFreeVar(args, s)
    case Expr.EMethod(recv, _, args, _) => exprFreeVar(recv, s) || listFreeVar(args, s)
    case Expr.EField(recv, _, _) => exprFreeVar(recv, s)
    case Expr.EBin(_, l, r, _) => exprFreeVar(l, s) || exprFreeVar(r, s)
    case Expr.EUn(_, inner, _) => exprFreeVar(inner, s)
    case Expr.ELam(p, _, body) => !patternBindsName(p, s) && exprFreeVar(body, s)
    case Expr.EIf(c, t, el, _) => exprFreeVar(c, s) || exprFreeVar(t, s) || exprFreeVar(el, s)
    case Expr.EMatch(sc, arms, _) => exprFreeVar(sc, s) || List.exists(arms, arm => armFreeVar(arm, s))
    case Expr.EList(xs) => listFreeVar(xs, s)
    case Expr.ETuple(xs) => listFreeVar(xs, s)
    case Expr.ENamed(_, inner) => exprFreeVar(inner, s)
    case Expr.EAscribe(inner, _, _) => exprFreeVar(inner, s)
    case Expr.EFor(bs, body, _) => forFreeVar(bs, body, s)
    case _ => false
  }

def listFreeVar(xs: List[Expr], s: String): Bool =
  List.exists(xs, e => exprFreeVar(e, s))

def armFreeVar(arm: Arm, s: String): Bool =
  arm match {
    case Arm(pat, guard, body) => !patternBindsName(pat, s) && (exprFreeVar(body, s) || guard != "" && exprFreeVar(parseGuard(guard), s))
  }

def forFreeVar(bs: List[Bind], body: Expr, s: String): Bool =
  if (List.isEmpty(bs)) exprFreeVar(body, s) else forFreeBind(List.at(bs, 0), List.tail(bs), body, s)

def forFreeBind(b: Bind, rest: List[Bind], body: Expr, s: String): Bool =
  b match {
    case Bind(_, pat, value) => exprFreeVar(value, s) || !patternBindsName(pat, s) && forFreeVar(rest, body, s)
  }

def listHasVar(xs: List[Expr], s: String): Bool =
  !List.isEmpty(xs) && (exprHasVar(List.at(xs, 0), s) || listHasVar(List.tail(xs), s))

def armsHasVar(xs: List[Arm], s: String): Bool =
  !List.isEmpty(xs) && armsHasVar1(List.at(xs, 0), List.tail(xs), s)

def armsHasVar1(a: Arm, rest: List[Arm], s: String): Bool =
  a match {
    case Arm(_, _, body) => exprHasVar(body, s) || armsHasVar(rest, s)
  }

def bindsHasVar(xs: List[Bind], s: String): Bool =
  !List.isEmpty(xs) && bindsHasVar1(List.at(xs, 0), List.tail(xs), s)

def bindsHasVar1(b: Bind, rest: List[Bind], s: String): Bool =
  b match {
    case Bind(_, _, value) => exprHasVar(value, s) || bindsHasVar(rest, s)
  }

def emitUiRunCall(args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitUiRunPack(emitUiRunLam(List.at(args, 0), Str.concat(prefix, "_fn"), strs, defs, ens, ps, loc), prefix, uiCapturePtr(List.at(args, 0), Str.concat(prefix, "_fn")))

def uiCapturePtr(e: Expr, prefix: String): String =
  e match {
    case Expr.ELam(_, _, _) => Str.concat("@sz_neth_", Str.concat(prefix, "_capture"))
    case _ => "null"
  }

def emitUiRunLam(e: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  e match {
    case Expr.ELam(p, _, body) => emitLam2(emitRebuildNeth(prefix, p, body, strs, defs, ens, ps, loc), emitPackEnv(copyPs(ps), Str.concat(prefix, "_e")), prefix)
    case _ => emitExpr(e, prefix, strs, defs, ens, ps, loc)
  }

def emitUiRunPack(pack: Slot, prefix: String, schema: String): Slot =
  pack match {
    case Slot(pc, pv, po) => Slot(join(pc, join(unpackFnPtr(pv, prefix), join(uiRunCall(prefix, schema), if (po) relPtr(pv) else ""))), pct(prefix, "v"), true)
  }

def emitTapViewCall(rt: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitTapViewJoin(rt, emitExpr(List.at(args, 0), Str.concat(prefix, "_arg0"), strs, defs, ens, ps, loc), List.at(List.tail(args), 0), prefix, strs, defs, ens, ps, loc)

def emitTapViewJoin(rt: String, lab: Slot, fn: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  lab match {
    case Slot(lc, lv, lo) => emitTapViewJoin2(rt, lc, lv, lo, emitTapLam(fn, Str.concat(prefix, "_fn"), strs, defs, ens, ps, loc), prefix)
  }

def emitTapLam(e: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  e match {
    case Expr.ELam(p, _, body) => emitLam2(emitTapNeth(prefix, p, body, strs, defs, ens, ps, loc), emitPackEnv(copyPs(ps), Str.concat(prefix, "_e")), prefix)
    case _ => emitExpr(e, prefix, strs, defs, ens, ps, loc)
  }

def emitTapViewJoin2(rt: String, lc: String, lv: String, lo: Bool, pack: Slot, prefix: String): Slot =
  pack match {
    case Slot(pc, pv, po) => Slot(join(lc, join(pc, join(unpackFnPtr(pv, prefix), join(viewTapPtr(rt, lv, prefix), join(if (lo) relPtr(lv) else "", if (po) relPtr(pv) else ""))))), pct(prefix, "v"), true)
  }

def isFunTy(t: String): Bool =
  hasSub(t, "=>")

def isViewMoveTy(t: String): Bool =
  t == "View"

def isViewArgTy(t: String): Bool =
  isViewMoveTy(t) || Str.startsWith(t, "View =>")

def emitApply(f: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.len(args) == 1) emitApply1(paramTy(ps, f), emitExpr(List.at(args, 0), Str.concat(prefix, "_a0"), strs, defs, ens, ps, loc), f, prefix) else emitApply1(paramTy(ps, f), emitTuple(args, prefix, strs, defs, ens, ps, loc), f, prefix)

def emitApply1(ty: String, arg: Slot, f: String, prefix: String): Slot =
  arg match {
    case Slot(ac, av, ao) => emitApplyK(funBoxUnbox(ty), ac, av, ao && !isViewArgTy(ty), f, prefix, isFloatFunArg(ty))
  }

def funBoxUnbox(t: String): Int =
  if (t == "Any" || t == "") 3 else if (Str.startsWith(t, "Int =>") || Str.startsWith(t, "Bool =>") || isFloatFunArg(t)) funBoxUnboxInt(t) else funBoxUnboxPtr(t)

def isFloatFunArg(t: String): Bool =
  Str.startsWith(t, "Float =>")

def funBoxUnboxInt(t: String): Int =
  if (endsRetI64(t)) 3 else 1

def funBoxUnboxPtr(t: String): Int =
  if (endsRetI64(t)) 2 else 0

def endsRetI64(t: String): Bool =
  hasSub(t, "=> Int") || hasSub(t, "=> Bool") || hasSub(t, "=> Float")

def emitApplyK(k: Int, ac: String, av: String, ao: Bool, f: String, prefix: String, isFloat: Bool): Slot =
  emitApply3(k == 1 || k == 3, k == 2 || k == 3, ac, av, ao, f, prefix, isFloat)

def emitApply3(boxArg: Bool, unbox: Bool, ac: String, av: String, ao: Bool, f: String, prefix: String, isFloat: Bool): Slot =
  emitApply4(boxArg || needBoxApply(av, ao), unbox, join(ac, join(unpackFn(f, prefix), applyBox(boxArg || needBoxApply(av, ao), av, prefix, isFloat))), av, ao, prefix)

def unpackFn(f: String, prefix: String): String =
  unpackFnPtr(Str.concat("%", f), prefix)

def unpackFnPtr(pack: String, prefix: String): String =
  if (isFnPack(pack)) unpackFnPtr2(pack, prefix) else ""

def unpackFnPtr2(pack: String, prefix: String): String =
  join(line(Str.concat(tmp(prefix, "fnp"), Str.concat("call ptr @sz_list_head(ptr ", Str.concat(pack, ")")))), join(line(Str.concat(tmp(prefix, "fnt"), Str.concat("call ptr @sz_list_tail(ptr ", Str.concat(pack, ")")))), line(Str.concat(tmp(prefix, "envp"), Str.concat("call ptr @sz_list_head(ptr ", Str.concat(pct(prefix, "fnt"), ")"))))))

def applyBox(boxArg: Bool, av: String, prefix: String, isFloat: Bool): String =
  if (boxArg) boxScalarStem(av, if (isFloat) "Float" else "Int", prefix, "ab") else ""

def emitApply4(boxArg: Bool, unbox: Bool, code: String, av: String, ao: Bool, prefix: String): Slot =
  emitApply5(unbox, join(code, join(applyCall(boxArg, av, prefix), applyDrop(boxArg, av, ao, prefix))), prefix)

def applyCall(boxArg: Bool, av: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr ", Str.concat(pct(prefix, "fnp"), Str.concat("(ptr ", Str.concat(if (boxArg) pct(prefix, "ab") else av, Str.concat(", ptr ", Str.concat(pct(prefix, "envp"), ")"))))))))

def applyDrop(boxArg: Bool, av: String, ao: Bool, prefix: String): String =
  if (boxArg) relPtr(pct(prefix, "ab")) else if (ao) relPtr(av) else ""

def emitApply5(unbox: Bool, code: String, prefix: String): Slot =
  if (unbox) Slot(join(code, join(line(Str.concat(tmp(prefix, "u"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(prefix, "v"), ")")))), relPtr(pct(prefix, "v")))), pct(prefix, "u"), false) else Slot(code, pct(prefix, "v"), true)

def emitApplyRecv(recv: Expr, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  recv match {
    case Expr.ELam(p, _, body) => emitApplyLam(p, body, args, prefix, strs, defs, ens, ps, loc, fid)
    case Expr.EMatch(_, arms, moff) => emitMatch(applyScrut(args), arms, moff, prefix, strs, defs, ens, ps, loc, fid)
    case _ => emitApplyRecvTy(exprRetTyEns(recv, defs, ens, ps, loc), recv, args, prefix, strs, defs, ens, ps, loc)
  }

def applyScrut(args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EUnit else if (List.isEmpty(List.tail(args))) List.at(args, 0) else Expr.ETuple(args)

def emitApplyLam(p: String, body: Expr, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitApplyLamGo(p, body, applyScrut(args), prefix, strs, defs, ens, ps, loc, fid)

def emitApplyLamGo(p: String, body: Expr, argE: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitApplyLamSlot(p, body, emitExprFid(argE, Str.concat(prefix, "_aa"), strs, defs, ens, ps, loc, fid), argE, prefix, strs, defs, ens, ps, loc, fid)

def emitApplyLamSlot(p: String, body: Expr, arg: Slot, argE: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitApplyLamTyped(p, body, arg, slotBindI64(arg, argE, ps, defs), applyBindTyPin(p, body, argE, defs, ens, ps, loc), prefix, strs, defs, ens, ps, loc, fid)

def emitApplyLamTyped(p: String, body: Expr, arg: Slot, guess: Bool, bty: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitApplyLam2(p, body, arg, guess || isI64Ty(bty), if (bty != "") bty else if (guess) "Int" else "", prefix, strs, defs, ens, ps, loc, fid)

def slotBindI64(s: Slot, e: Expr, ps: List[Param], defs: Ftab): Bool =
  s match {
    case Slot(c, v, _) => exprIsI64(e, ps, defs) || isI64Lit(v) || hasSub(v, "_u") || hasSub(v, "_tv") || hasSub(v, "_ic_v") || hasDigitStem(v, "_b") || isUnboxVal(c, v)
  }

def isUnboxVal(code: String, v: String): Bool =
  hasSub(code, Str.concat(v, " = call i64 @sz_unbox_i64"))

def applyBindTyPin(p: String, body: Expr, argE: Expr, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  applyBindTyPinHit(Check.lamPinTyOf(p, argE, body, defs, ens, ps, locMod(loc)), p, argE, defs, ens, ps, loc)

def applyBindTyPinHit(pin: String, p: String, argE: Expr, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  if (pin == "") applyBindTy(p, argE, defs, ens, ps, loc) else applyBindTyHit(pin, argE)

def applyBindTy(p: String, argE: Expr, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  applyBindTyHit(exprRetTyEns(argE, defs, ens, ps, loc), argE)

def applyBindTyHit(ty: String, argE: Expr): String =
  if (ty != "" && ty != "Any") ty else ctorTyOf(argE)

def ctorTyOf(e: Expr): String =
  e match {
    case Expr.ECall(f, _, _) => if (isCtorName(f)) f else ""
    case Expr.EVar(s, _) => if (isCtorName(s)) s else ""
    case _ => ""
  }

def exprRetTy(e: Expr, defs: Ftab, ps: List[Param]): String =
  exprRetTyEns(e, defs, noEn(), ps, "Main")

def exprRetTyEns(e: Expr, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  nonemptyTy(Check.typeOfEns(e, defs, ens, ps, locMod(loc)), e, defs, ps)

def locMod(loc: String): String =
  if (modOfLoc(loc) == "") "Main" else modOfLoc(loc)

def nonemptyTy(ty: String, e: Expr, defs: Ftab, ps: List[Param]): String =
  if (ty != "") ty else if (exprIsI64(e, ps, defs)) "Int" else ""

def emitApplyLam2(p: String, body: Expr, arg: Slot, boxInt: Bool, bty: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  arg match {
    case Slot(ac, av, _) => emitApplyLam3(p, body, ac, av, boxInt, bty, prefix, strs, defs, ens, ps, loc, fid)
  }

def emitApplyLam3(p: String, body: Expr, ac: String, av: String, boxInt: Bool, bty: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  if (keepBind(p)) emitApplyLamShadow(shadowBind(p, prefix, ps), p, body, ac, av, boxInt, bty, prefix, strs, defs, ens, ps, loc, fid) else emitApplyLamSkip(ac, emitExprFid(body, Str.concat(prefix, "_l"), strs, defs, ens, ps, loc, fid))

def shadowBind(p: String, prefix: String, ps: List[Param]): String =
  if (paramKnown(ps, p)) Str.concat("_", Str.concat(prefix, Str.concat("_", p))) else p

def emitApplyLamShadow(fresh: String, p: String, body: Expr, ac: String, av: String, boxInt: Bool, bty: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitApplyLam4(ac, emitExprFid(if (fresh == p) body else rewriteBind(body, p, fresh), Str.concat(prefix, "_l"), strs, defs, ens, Param(fresh, bty, "", "") :: dropParam(ps, p), loc, fid), av, fresh, boxInt)

def emitApplyLamSkip(ac: String, s: Slot): Slot =
  s match {
    case Slot(bc, bv, bo) => Slot(join(ac, bc), bv, bo)
  }

def emitApplyLam4(ac: String, s: Slot, av: String, p: String, boxInt: Bool): Slot =
  s match {
    case Slot(bc, bv, bo) => Slot(join(ac, join(bindAliasTy(p, av, boxInt), bc)), bv, bo)
  }

def bindAliasTy(p: String, av: String, boxInt: Bool): String =
  if (boxInt) line(Str.concat("%", Str.concat(p, Str.concat(" = add i64 ", Str.concat(av, ", 0"))))) else bindAlias(p, av)

def bindAlias(p: String, av: String): String =
  line(Str.concat("%", Str.concat(p, Str.concat(" = bitcast ptr ", Str.concat(av, " to ptr")))))

def emitApplyRecvTy(ty: String, recv: Expr, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitApplyRecvFn(emitExpr(recv, Str.concat(prefix, "_fn"), strs, defs, ens, ps, loc), args, ty, prefix, strs, defs, ens, ps, loc)

def emitApplyRecvFn(fn: Slot, args: List[Expr], ty: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.len(args) == 1) emitApplyRecvArg(fn, emitExpr(List.at(args, 0), Str.concat(prefix, "_a0"), strs, defs, ens, ps, loc), ty, prefix) else emitApplyRecvArg(fn, emitTuple(args, prefix, strs, defs, ens, ps, loc), ty, prefix)

def emitApplyRecvArg(fn: Slot, arg: Slot, ty: String, prefix: String): Slot =
  fn match {
    case Slot(fc, fv, fo) => arg match {
  case Slot(ac, av, ao) => emitApplyRecvK(funBoxUnbox(ty), join(fc, ac), fv, fo, av, ao && !isViewArgTy(ty), prefix, isFloatFunArg(ty))
}
  }

def emitApplyRecvK(k: Int, code: String, fv: String, fo: Bool, av: String, ao: Bool, prefix: String, isFloat: Bool): Slot =
  if (isFnPack(fv)) emitApplyRecv3(k == 1 || k == 3, k == 2 || k == 3, code, fv, fo, av, ao, prefix, isFloat) else Slot(code, fv, fo)

def isFnPack(v: String): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37

def emitApplyRecv3(boxArg: Bool, unbox: Bool, code: String, fv: String, fo: Bool, av: String, ao: Bool, prefix: String, isFloat: Bool): Slot =
  emitApplyRecv4(unbox, join(code, join(unpackFnPtr(fv, prefix), applyBox(boxArg || needBoxApply(av, ao), av, prefix, isFloat))), boxArg || needBoxApply(av, ao), av, ao, fv, fo, prefix)

def needBoxApply(av: String, ao: Bool): Bool =
  !ao && (isI64Lit(av) || isIntSsa(av))

def emitApplyRecv4(unbox: Bool, code: String, boxArg: Bool, av: String, ao: Bool, fv: String, fo: Bool, prefix: String): Slot =
  emitApplyRecv5(unbox, join(code, join(applyCall(boxArg, av, prefix), join(applyDrop(boxArg, av, ao, prefix), if (fo) relPtr(fv) else ""))), prefix)

def emitApplyRecv5(unbox: Bool, code: String, prefix: String): Slot =
  emitApply5(unbox, code, prefix)

def emitIoPureCall(args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(args)) emitIoPure2("", "null", false, prefix, ps, false) else emitIoPureTyped(emitExpr(List.at(args, 0), Str.concat(prefix, "_p"), strs, defs, ens, ps, loc), exprRetTyEns(List.at(args, 0), defs, ens, ps, loc), prefix)

def emitIoPureTyped(s: Slot, ty: String, prefix: String): Slot =
  if (isI64Ty(ty)) emitIoPureI64(s.code, s.val, prefix, ty == "Float") else emitIoPurePtr(s.code, s.val, s.owned, prefix)

def emitConcat(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitConcat2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitConcat2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(emitConcatCall(prefix, a, b, oa), if (ob) relPtr(b) else "")), pct(prefix, "v"), true)

def emitConcatCall(prefix: String, a: String, b: String, oa: Bool): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(concatRt(oa), Str.concat("(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))))

def relPtr(p: String): String =
  line(Str.concat("call void @sz_release(ptr ", Str.concat(p, ")")))

def arg0(vals: List[String]): String =
  nthStrD(vals, 0, "null")

def arg1(vals: List[String]): String =
  nthStrD(vals, 1, "null")

def arg2(vals: List[String]): String =
  nthStrD(vals, 2, "0")

def nthStrD(xs: List[String], i: Int, d: String): String =
  if (List.isEmpty(xs)) d else nthStr1(List.at(xs, 0), List.tail(xs), i)

def nthStr1(h: String, rest: List[String], i: Int): String =
  if (i <= 0) h else nthStrD(rest, i - 1, "null")

def emitListLen(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListLen2(code, arg0(vals), headOwn(owns), prefix)

def emitListLen2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_list_len(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def emitListCat(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListCat2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitListCat2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(emitListCatCall(prefix, a, b, oa), if (ob) relPtr(b) else "")), pct(prefix, "v"), true)

def emitListCatCall(prefix: String, a: String, b: String, oa: Bool): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(if (oa) "sz_list_concat_take" else "sz_list_concat", Str.concat("(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))))

def emitListRev(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListRev2(code, arg0(vals), headOwn(owns), prefix)

def emitListRev2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_reverse(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def kitUnaryPtr(f: String): String =
  kitUnaryPtrHit(kitUnaryPtrA(f), f)

def kitUnaryPtrHit(a: String, f: String): String =
  if (a != "") a else kitUnaryPtrB(f)

def kitUnaryPtrA(f: String): String =
  if (f == "List.init") "sz_list_init" else if (f == "List.last") "sz_list_last" else if (f == "List.sort") "sz_list_sort" else if (f == "List.flatten") "sz_list_flatten" else if (f == "List.distinct") "sz_list_distinct" else if (f == "List.indices") "sz_list_indices" else if (f == "List.inits") "sz_list_inits" else if (f == "List.tails") "sz_list_tails" else if (f == "List.transpose") "sz_list_transpose" else if (f == "List.zipWithIndex") "sz_list_zip_with_index" else if (f == "List.toMap") "sz_list_to_map" else if (f == "List.unzip") "sz_list_unzip" else if (f == "Map.keys" || f == "Set.toList") "sz_map_keys" else if (f == "Map.values") "sz_map_values" else if (f == "Map.toList") "sz_map_to_list" else if (f == "Json.keys") "sz_json_keys" else if (f == "Json.parse") "sz_json_parse" else if (f == "Json.stringify") "sz_json_stringify" else if (f == "Json.arr") "sz_json_arr" else if (f == "Json.pairs") "sz_json_pairs" else if (f == "Json.asInt") "sz_json_as_int" else if (f == "Json.asBool") "sz_json_as_bool" else if (f == "Json.asStr") "sz_json_as_str" else if (f == "Json.asFloat") "sz_json_as_float" else if (f == "Str.lines") "sz_string_lines" else if (f == "Str.trim") "sz_string_trim" else if (f == "Str.toLower") "sz_string_to_lower" else if (f == "Str.toUpper") "sz_string_to_upper" else if (f == "Str.capitalize") "sz_string_capitalize" else if (f == "Str.reverse") "sz_string_ureverse" else ""

