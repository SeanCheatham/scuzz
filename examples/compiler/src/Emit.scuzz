def emitViewKit(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "View.column" || f == "View.row" || f == "View.stack" || f == "View.wrap") emitViewBox(viewBoxRt(f), code, vals, prefix) else if (f == "View.grid") emitViewGrid(code, vals, prefix) else if (f == "View.divider") emitViewNil("sz_lang_view_divider", code, prefix) else if (f == "View.verticalDivider") emitViewNil("sz_lang_view_vertical_divider", code, prefix) else if (viewWrap1Rt(f) != "") emitViewPtr1(viewWrap1Rt(f), code, vals, prefix) else if (viewDrop1Rt(f) != "") emitViewDrop1(viewDrop1Rt(f), code, vals, owns, prefix) else if (viewI64PtrRt(f) != "") emitViewI64Ptr(viewI64PtrRt(f), code, vals, prefix) else if (viewI64I64PtrRt(f) != "") emitViewI64I64Ptr(viewI64I64PtrRt(f), code, vals, prefix) else if (tapViewRt(f) != "") emitViewTap(tapViewRt(f), code, vals, owns, prefix) else emitViewKit2(f, code, vals, owns, prefix)

def emitViewKit2(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (viewPtr2Drop1Rt(f) != "") emitViewPtr2(viewPtr2Drop1Rt(f), false, true, code, vals, owns, prefix) else if (viewPtr2Drop0Rt(f) != "") emitViewPtr2(viewPtr2Drop0Rt(f), true, false, code, vals, owns, prefix) else if (viewPtr2Rt(f) != "") emitViewPtr2(viewPtr2Rt(f), false, false, code, vals, owns, prefix) else if (viewRadioRt(f) != "") emitViewRadio(viewRadioRt(f), code, vals, owns, prefix) else if (f == "View.showWhen") emitViewShowWhen(code, vals, prefix) else if (f == "View.split") emitViewPtr3("sz_lang_view_split", code, vals, prefix) else if (f == "View.segmented") emitViewSeg(code, vals, owns, prefix) else if (f == "View.expansionTile") emitViewExp(code, vals, owns, prefix) else if (f == "View.inkWell") emitViewInk(code, vals, owns, prefix) else if (f == "View.listTile") emitViewListTile(code, vals, owns, prefix) else if (f == "View.image") emitViewImage(code, vals, owns, prefix) else if (f == "View.icon") emitViewIcon(code, vals, prefix) else emitViewPtr1("sz_lang_view_center", code, vals, prefix)

def viewBoxRt(f: String): String =
  if (f == "View.column") "sz_lang_view_column" else if (f == "View.row") "sz_lang_view_row" else if (f == "View.wrap") "sz_lang_view_wrap" else "sz_lang_view_stack"

def emitViewBox(rt: String, code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, join(viewBoxNew(rt, prefix), emitViewAdds(pct(prefix, "v"), vals, prefix, 0))), pct(prefix, "v"), true)

def viewBoxNew(rt: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, "()"))))

def emitViewAdds(parent: String, xs: List[String], prefix: String, i: Int): String =
  if (List.isEmpty(xs)) "" else join(viewAddLine(parent, List.at(xs, 0), prefix, i), emitViewAdds(parent, List.tail(xs), prefix, i + 1))

def viewAddLine(parent: String, child: String, prefix: String, i: Int): String =
  line(Str.concat(tmp(prefix, Str.concat("ac", Str.fromInt(i))), Str.concat("call ptr @sz_lang_view_add_child(ptr ", Str.concat(parent, Str.concat(", ptr ", Str.concat(child, ")"))))))

def uiRunCall(prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_ui_run_rebuild(ptr ", Str.concat(pct(prefix, "fnp"), Str.concat(", ptr ", Str.concat(pct(prefix, "envp"), ")"))))))

def viewTapPtr(rt: String, label: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(label, Str.concat(", ptr ", Str.concat(pct(prefix, "fnp"), Str.concat(", ptr ", Str.concat(pct(prefix, "envp"), ")"))))))))))

