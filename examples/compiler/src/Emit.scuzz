def emitFull(src: String): String =
  Str.concat(preamble(), emit(src))

def emitGenericSignal(f: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (f == "Signal.makeN" || f == "Signal.mapN") emitSignalNamed(f, List.tail(args), emitExpr(List.at(args, 0), Str.concat(prefix, "_name"), strs, defs, ens, ps, loc), prefix, strs, defs, ens, ps, loc) else emitSignalNamed(f, args, Slot("", "null", false), prefix, strs, defs, ens, ps, loc)

def emitSignalNamed(f: String, args: List[Expr], name: Slot, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitSignalTyped(f, args, name, emitExpr(List.at(args, 0), Str.concat(prefix, "_src"), strs, defs, ens, ps, loc), exprRetTyEns(List.at(args, 0), defs, ens, ps, loc), prefix, strs, defs, ens, ps, loc)

def emitSignalTyped(f: String, args: List[Expr], name: Slot, src: Slot, ty: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (f == "Signal.make" || f == "Signal.makeN") emitSignalMake(boxSignalValue(src, ty, prefix), signalKind(ty), name, prefix) else if (f == "Signal.get") emitSignalGet(src, Check.elemOf(ty), prefix) else if (f == "Signal.set") emitSignalSet(src, boxSignalValue(emitExpr(List.at(args, 1), Str.concat(prefix, "_value"), strs, defs, ens, ps, loc), Check.elemOf(ty), prefix), prefix) else emitSignalMap(src, name, wrapPh(List.at(args, 1), ps, defs, modOfLoc(loc)), Check.elemOf(ty), prefix, strs, defs, ens, ps, loc)

def signalKind(ty: String): Int =
  if (ty == "Int") 1 else if (ty == "String") 2 else if (ty == "List[String]") 3 else if (Str.startsWith(ty, "List[")) 5 else 4

def boxSignalValue(s: Slot, ty: String, prefix: String): Slot =
  if (isI64Ty(ty)) Slot(join(s.code, boxScalarStem(s.val, ty, prefix, "boxed")), pct(prefix, "boxed"), true) else Slot(s.code, s.val, s.owned)

def dropSlot(s: Slot): String =
  if (s.owned) relPtr(s.val) else ""

def emitSignalMake(payload: Slot, kind: Int, name: Slot, prefix: String): Slot =
  Slot(join(name.code, join(payload.code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_signal_new(ptr ", Str.concat(payload.val, Str.concat(", i64 ", Str.concat(Str.fromInt(kind), Str.concat(", ptr ", Str.concat(name.val, ")")))))))), join(dropSlot(payload), dropSlot(name))))), pct(prefix, "v"), false)

def emitSignalGet(src: Slot, ty: String, prefix: String): Slot =
  signalGetResult(Slot(join(src.code, line(Str.concat(tmp(prefix, "read"), Str.concat("call ptr @sz_signal_read(ptr ", Str.concat(src.val, ")"))))), pct(prefix, "read"), true), ty, prefix)

def signalGetResult(s: Slot, ty: String, prefix: String): Slot =
  if (isI64Ty(ty)) Slot(join(s.code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(s.val, ")")))), relPtr(s.val))), pct(prefix, "v"), false) else Slot(s.code, s.val, s.owned)

def emitSignalSet(src: Slot, payload: Slot, prefix: String): Slot =
  Slot(join(src.code, join(payload.code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_signal_write(ptr ", Str.concat(src.val, Str.concat(", ptr ", Str.concat(payload.val, ")")))))), dropSlot(payload)))), pct(prefix, "v"), false)

def emitSignalMap(src: Slot, name: Slot, fn: Expr, ty: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitSignalMapBody(src, name, mapLamBind(fn), mapLamBody(fn), ty, prefix, strs, defs, ens, ps, loc)

def emitSignalMapBody(src: Slot, name: Slot, bind: String, body: Expr, ty: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitSignalMapRenamed(src, name, freshSignalBind(Str.concat(prefix, "_item"), body, ps), body, bind, ty, prefix, strs, defs, ens, ps, loc)

def freshSignalBind(name: String, body: Expr, ps: List[Param]): String =
  if (paramKnown(ps, name) || exprHasVar(body, name)) freshSignalBind(Str.concat(name, "_"), body, ps) else name

def emitSignalMapRenamed(src: Slot, name: Slot, fresh: String, body: Expr, bind: String, ty: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitSignalMapReady(src, name, emitSignalNeth(prefix, fresh, rewriteBind(body, bind, fresh), ty, strs, defs, ens, dropParam(ps, bind), loc), emitPackEnv(dropParam(ps, bind), Str.concat(prefix, "_env")), signalKind(exprRetTyEns(body, defs, ens, nethPsTy(bind, ty, dropParam(ps, bind)), loc)), prefix)

def emitSignalNeth(prefix: String, bind: String, body: Expr, ty: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  emitSignalNethCapturedBody(prefix, bind, body, ty, strs, defs, ens, ps, loc)

def emitSignalNethCapturedBody(prefix: String, bind: String, body: Expr, ty: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  emitSignalNethBody(prefix, join(emitUnpack(ps), emitNethBind2(bind, isI64Ty(ty))), boxSignalValue(emitExpr(body, Str.concat(prefix, "_body"), strs, defs, ens, nethPsTy(bind, ty, ps), loc), exprRetTyEns(body, defs, ens, nethPsTy(bind, ty, ps), loc), Str.concat(prefix, "_ret")), loc, strs)

def emitSignalNethBody(prefix: String, pre: String, payload: Slot, loc: String, strs: Strs): String =
  emitNeth4(prefix, join(pre, join(payload.code, if (payload.owned) "" else retPtr(payload.val))), "", payload.val, loc, strs, false)

def emitSignalMapReady(src: Slot, name: Slot, neth: String, env: Slot, kind: Int, prefix: String): Slot =
  Slot(join(neth, join(name.code, join(src.code, join(env.code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_signal_derive(ptr ", Str.concat(src.val, Str.concat(", ptr @sz_neth_", Str.concat(prefix, Str.concat(", ptr ", Str.concat(env.val, Str.concat(", i64 ", Str.concat(Str.fromInt(kind), Str.concat(", ptr ", Str.concat(name.val, ")")))))))))))), join(dropSlot(env), dropSlot(name))))))), pct(prefix, "v"), false)

def signalDecls(): String =
  join(decl("ptr @sz_signal_new(ptr, i64, ptr)"), join(decl("ptr @sz_signal_read(ptr)"), join(decl("ptr @sz_signal_write(ptr, ptr)"), join(decl("ptr @sz_signal_derive(ptr, ptr, ptr, i64, ptr)"), decl("ptr @sz_io_attempt_as_result(ptr)")))))

def emitViewSection(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(viewPtr3Call("sz_lang_view_section", vals, prefix), join(if (headOwn(owns)) relPtr(arg0(vals)) else "", if (headOwn(tailOwn(owns))) relPtr(arg1(vals)) else ""))), pct(prefix, "v"), true)

def emitHttpBody(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(viewPtr3Call(rt, vals, prefix), join(if (headOwn(owns)) relPtr(arg0(vals)) else "", join(if (headOwn(tailOwn(owns))) relPtr(arg1(vals)) else "", if (headOwn(tailOwn(tailOwn(owns)))) relPtr(arg2(vals)) else "")))), pct(prefix, "v"), true)

def fuzzDecls(): String =
  join(decl("ptr @sz_fuzz_setup(ptr)"), join(decl("ptr @sz_fuzz_driver(ptr, i64, ptr, ptr)"), join(decl("ptr @sz_fuzz_verify(ptr, ptr, ptr)"), join(decl("ptr @sz_fuzz_verify_rel(ptr, ptr, ptr)"), join(decl("void @sz_fuzz_hit(ptr)"), decl("ptr @sz_fuzz_probe(ptr)"))))))

