  Slot(join(code, join(viewPtr2Call(rt, vals, prefix), join(if (d0 && headOwn(owns)) relPtr(arg0(vals)) else "", if (d1 && headOwn(tailOwn(owns))) relPtr(arg1(vals)) else ""))), pct(prefix, "v"), true)

def viewPtr2Call(rt: String, vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(arg0(vals), Str.concat(", ptr ", Str.concat(arg1(vals), ")"))))))))

