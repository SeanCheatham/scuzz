record Slot(code: String, val: String, owned: Bool)

record Dec(code: String, val: String, num: Bool, owned: Bool, n: Int)

record Decs(code: String, ds: List[Dec], n: Int)

record Strs(xs: List[String], ix: Map[String, Int])

import Parse.Expr
import Parse.Fun
import Parse.Prog
import Parse.En
import Parse.EnCase
import Parse.Arm
import Parse.Param
import Parse.Bind
import Parse.Alias
import Parse.Im
import Parse.Imp
import Lexer.Tok
import Lexer.SpTok
import Check.Ftab
import Check.LineIndex
import Type.Ty
import Check.getTy
import Check.noEnv
import Check.envBind
import Check.withImportFuns
import Check.fileOf
import Check.locOfIdx
import Check.fileIndex
import Check.startsOf
import Check.srcOfStem
import Check.alignCall
import Check.isTupField
import Check.tupIdx

def noStr(): List[String] =
  []

def emptyStrs(): Strs =
  Strs([], Map.empty())

def noExpr(): List[Expr] =
  []

def noBool(): List[Bool] =
  []

def noParam(): List[Param] =
  []

def noArm(): List[Arm] =
  []

def noFun(): List[Fun] =
  []

def noEn(): List[En] =
  []

def copyEns(ens: List[En]): List[En] =
  copyEnsAt(ens)

def copyEnsAt(ens: List[En]): List[En] =
  if (List.isEmpty(ens)) noEn() else List.at(ens, 0) :: copyEnsAt(List.tail(ens))

def copyPs(ps: List[Param]): List[Param] =
  copyPsAt(ps)

def copyPsAt(ps: List[Param]): List[Param] =
  if (List.isEmpty(ps)) noParam() else copyPsHit(List.at(ps, 0), List.tail(ps))

def copyPsHit(h: Param, rest: List[Param]): List[Param] =
  h :: copyPsAt(rest)

def nl(): String =
  """
"""

def line(s: String): String =
  Str.concat("  ", Str.concat(s, nl()))

def pct(prefix: String, stem: String): String =
  Str.concat("%", Str.concat(prefix, Str.concat("_", stem)))

def tmp(prefix: String, stem: String): String =
  Str.concat(pct(prefix, stem), " = ")

def llvmC(s: String): String =
  Str.concat("c\"", Str.concat(_escLl(s, 0, Builder.empty()), "\\00\""))

def _escLl(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else _escLl2(s, i, b, Str.charAt(s, i))

def _escLl2(s: String, i: Int, b: Builder, c: Int): String =
  _escLl(s, i + 1, Builder.append(b, escLlCp(s, i, c)))

def escLlCp(s: String, i: Int, c: Int): String =
  if (c == 34) "\\22" else if (c == 92) "\\\\" else if (c >= 32 && c <= 126) Str.slice(s, i, i + 1) else escUtf8(c)

def escUtf8(c: Int): String =
  if (c < 128) escByte(c) else if (c < 2048) Str.concat(escByte(192 + c / 64), escByte(128 + c % 64)) else if (c < 65536) Str.concat(escByte(224 + c / 4096), Str.concat(escByte(128 + c / 64 % 64), escByte(128 + c % 64))) else Str.concat(escByte(240 + c / 262144), Str.concat(escByte(128 + c / 4096 % 64), Str.concat(escByte(128 + c / 64 % 64), escByte(128 + c % 64))))

def escByte(n: Int): String =
  Str.concat("\\", hexU2(n))

def hexU2(n: Int): String =
  Str.concat(hexU(n / 16), hexU(n % 16))

def hexU(n: Int): String =
  Str.slice("0123456789ABCDEF", n, n + 1)

def strArr(s: String): Int =
  Str.byteLen(s) + 1

def strConst(i: Int, s: String): String =
  Str.concat("@.str", Str.concat(Str.fromInt(i), Str.concat(" = private unnamed_addr constant [", Str.concat(Str.fromInt(strArr(s)), Str.concat(" x i8] ", Str.concat(llvmC(s), ", align 1"))))))

def strIndex(acc: Strs, s: String, i: Int): Int =
  Map.getOrElse(acc.ix, s, i)

def intern(acc: Strs, s: String): Strs =
  if (Map.contains(acc.ix, s)) acc else Strs(s :: acc.xs, Map.set(acc.ix, s, 0))

def internReady(acc: Strs): Strs =
  indexOf(List.reverse(acc.xs))

def indexOf(xs: List[String]): Strs =
  Strs(xs, indexGo(xs, Map.empty(), 0))

def indexGo(xs: List[String], ix: Map[String, Int], i: Int): Map[String, Int] =
  if (List.isEmpty(xs)) ix else indexGo(List.tail(xs), Map.set(ix, List.at(xs, 0), i), i + 1)

def internHas(acc: Strs, s: String): Bool =
  Map.contains(acc.ix, s)

def panicLoc(files: List[(String, String)], mod: String, off: Int): String =
  panicLocAt(files, fileIndex(files), mod, off)

def panicLocAt(files: List[(String, String)], lidx: Map[String, LineIndex], mod: String, off: Int): String =
  panicLoc2(fileOf(mod), locOfIdx(startsOf(lidx, mod), srcOfStem(files, mod), off))

def panicLoc2(file: String, loc: (Int, Int, Int, Int)): String =
  loc match {
    case (line, col, _, _) => Str.concat(file, Str.concat(":", Str.concat(Str.fromInt(line), Str.concat(":", Str.fromInt(col)))))
  }

def panicLocExpr(files: List[(String, String)], e: Expr): String =
  panicLocExprAt(files, fileIndex(files), e)

def panicLocExprAt(files: List[(String, String)], lidx: Map[String, LineIndex], e: Expr): String =
  panicLocExpr2At(files, lidx, Parse.spanOf(e))

def panicLocExpr2(files: List[(String, String)], sp: (String, Int)): String =
  panicLocExpr2At(files, fileIndex(files), sp)

def panicLocExpr2At(files: List[(String, String)], lidx: Map[String, LineIndex], sp: (String, Int)): String =
  sp match {
    case (stem, off) => panicLocAt(files, lidx, stem, off)
  }

def panicPush(loc: String, strs: Strs): String =
  join(internGep(loc, strs, "szloc", 0), line("call void @sz_panic_push_src(ptr %szlocg0)"))

def panicPop(): String =
  line("call void @sz_panic_pop_src()")

def covHitIf(e: Expr, parentOff: Int, tag: String, loc: String, strs: Strs, prefix: String): String =
  covHitLine(Check.covKeyOf(loc, Parse.spanOff(e, parentOff), tag), strs, prefix)

def covHitLine(key: String, strs: Strs, prefix: String): String =
  if (internHas(strs, key)) join(internGep(key, strs, prefix, 0), line(Str.concat("call void @sz_coverage_hit(ptr ", Str.concat(decPct(prefix, "g", 0), ")")))) else ""

def covSlot(e: Expr, parentOff: Int, tag: String, s: Slot, loc: String, strs: Strs, prefix: String): Slot =
  s match {
    case Slot(code, v, o) => Slot(join(covHitIf(e, parentOff, tag, loc, strs, prefix), code), v, o)
  }

def collectToks(toks: List[SpTok], acc: Strs): Strs =
  if (List.isEmpty(toks)) acc else collectToksHd(List.at(toks, 0), List.tail(toks), acc)

def collectToksHd(h: SpTok, rest: List[SpTok], acc: Strs): Strs =
  h match {
    case SpTok(t, _, _) => collectTok(t, rest, acc)
  }

def collectTok(t: Tok, rest: List[SpTok], acc: Strs): Strs =
  t match {
    case Tok.Str(s) => collectToks(rest, intern(acc, s))
    case Tok.Interp(s) => collectToks(rest, internInterp(acc, s, 0, Builder.empty()))
    case _ => collectToks(rest, acc)
  }

def internInterp(acc: Strs, s: String, i: Int, b: Builder): Strs =
  if (i >= Str.len(s)) internInterpEnd(acc, b) else internInterpCh(acc, s, i, b, Str.charAt(s, i))

def internInterpEnd(acc: Strs, b: Builder): Strs =
  internInterpLit(acc, Builder.result(b))

def internInterpLit(acc: Strs, lit: String): Strs =
  if (lit == "") acc else intern(acc, lit)

def internInterpCh(acc: Strs, s: String, i: Int, b: Builder, c: Int): Strs =
  if (c == 92 && i + 1 < Str.len(s)) internInterp(acc, s, i + 2, Builder.append(b, Lexer._escStr(s, i + 1))) else if (c == 36) internInterpDollar(acc, s, i, b) else internInterp(acc, s, i + 1, Builder.append(b, Str.slice(s, i, i + 1)))

def internInterpDollar(acc: Strs, s: String, i: Int, b: Builder): Strs =
  if (i + 1 >= Str.len(s)) internInterp(acc, s, i + 1, Builder.append(b, "$")) else internInterpDollar2(acc, s, i, b, Str.charAt(s, i + 1))

def internInterpDollar2(acc: Strs, s: String, i: Int, b: Builder, n: Int): Strs =
  if (n == 123) internInterpBrace(internInterpEnd(acc, b), s, i) else if (isIdentStart(n)) internInterpSkip(internInterpEnd(acc, b), s, i + 1) else internInterp(acc, s, i + 1, Builder.append(b, "$"))

def internInterpSkip(acc: Strs, s: String, i: Int): Strs =
  if (i >= Str.len(s)) acc else if (isIdentCont(Str.charAt(s, i))) internInterpSkip(acc, s, i + 1) else internInterp(acc, s, i, Builder.empty())

def internInterpBrace(acc: Strs, s: String, i: Int): Strs =
  internInterpBrace2(Parse.interpCloseBrace(s, i + 2, 1), acc, s, i)

def internInterpBrace2(j: Int, acc: Strs, s: String, i: Int): Strs =
  internInterp(internHole(acc, Str.slice(s, i + 2, j - 1)), s, j, Builder.empty())

def internHole(acc: Strs, inner: String): Strs =
  collectToks(Lexer.lex(inner), acc)

def emitConsts(xs: List[String], i: Int): String =
  Builder.result(emitConstsB(xs, i, Builder.empty()))

def emitConstsB(xs: List[String], i: Int, b: Builder): Builder =
  if (List.isEmpty(xs)) b else emitConstsB(List.tail(xs), i + 1, Builder.append(b, Str.concat(strConst(i, List.at(xs, 0)), nl())))

def join(a: String, b: String): String =
  Str.concat(a, b)

def cat3(a: String, b: String, c: String): String =
  Builder.result(Builder.append(Builder.append(Builder.append(Builder.empty(), a), b), c))

def cat4(a: String, b: String, c: String, d: String): String =
  Builder.result(Builder.append(Builder.append(Builder.append(Builder.append(Builder.empty(), a), b), c), d))

def cat6(a: String, b: String, c: String, d: String, e: String, f: String): String =
  Builder.result(Builder.append(Builder.append(Builder.append(Builder.append(Builder.append(Builder.append(Builder.empty(), a), b), c), d), e), f))

def llvmBin(op: String): String =
  if (op == "+") "add" else if (op == "-") "sub" else if (op == "*") "mul" else if (op == "/") "sdiv" else if (op == "%") "srem" else if (op == "&") "and" else if (op == "|") "or" else if (op == "^") "xor" else if (op == "<<") "shl" else if (op == ">>") "ashr" else stuckStr()

def stuckStr(): String =
  stuckStr()

def emitExpr(e: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitExprFid(e, prefix, strs, defs, ens, ps, loc, 0)

def emitExprFid(e: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  if (needsPh(e)) emitLam("_ph", rewriteHole(e, "_ph"), prefix, strs, defs, ens, ps, loc) else emitExprGo(etaKit(e, ps, defs, modOfLoc(loc)), prefix, strs, defs, ens, ps, loc, fid)

def needsPh(e: Expr): Bool =
  e match {
    case Expr.ELam(_, _, _) => false
    case Expr.EHole => true
    case Expr.EBin(_, l, r, _) => hasHole(l) || hasHole(r)
    case Expr.EUn(_, inner, _) => hasHole(inner)
    case Expr.ECall(f, args, _) => needsPhCall(f, args)
    case Expr.EMethod(recv, _, args, _) => needsPhMethod(recv, args)
    case Expr.EField(recv, _, _) => isBareHole(recv)
    case _ => false
  }

def needsPhCall(f: String, args: List[Expr]): Bool =
  if (isHoKit(f)) false else hasBareHoleArg(args) && !hasCompoundPhArg(args)

def isHoKit(f: String): Bool =
  isMapKit(f) || isFoldKit(f) || f == "List.tabulate" || f == "List.segmentLength"

def needsPhMethod(recv: Expr, args: List[Expr]): Bool =
  (isBareHole(recv) || hasBareHoleArg(args)) && !isCompoundPh(recv) && !hasCompoundPhArg(args)

def isBareHole(e: Expr): Bool =
  e match {
    case Expr.EHole => true
    case _ => false
  }

def isCompoundPh(e: Expr): Bool =
  hasHole(e) && !isBareHole(e)

def hasBareHoleArg(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (isBareHole(List.at(xs, 0)) || hasBareHoleArg(List.tail(xs)))

def hasCompoundPhArg(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (isCompoundPh(List.at(xs, 0)) || hasCompoundPhArg(List.tail(xs)))

def hasHole(e: Expr): Bool =
  e match {
    case Expr.EHole => true
    case Expr.EPrint(inner, _) => hasHole(inner)
    case Expr.ECall(_, args, _) => hasHoleList(args)
    case Expr.EMethod(recv, _, args, _) => hasHole(recv) || hasHoleList(args)
    case Expr.EField(recv, _, _) => hasHole(recv)
    case Expr.EBin(_, l, r, _) => hasHole(l) || hasHole(r)
    case Expr.EUn(_, inner, _) => hasHole(inner)
    case Expr.ELam(_, _, body) => hasHole(body)
    case Expr.EIf(c, t, el, _) => hasHole(c) || hasHole(t) || hasHole(el)
    case Expr.EMatch(s, arms, _) => hasHole(s) || hasHoleArms(arms)
    case Expr.EList(xs) => hasHoleList(xs)
    case Expr.ETuple(xs) => hasHoleList(xs)
    case Expr.ENamed(_, inner) => hasHole(inner)
    case Expr.EAscribe(inner, _, _) => hasHole(inner)
    case _ => false
  }

def hasHoleList(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (hasHole(List.at(xs, 0)) || hasHoleList(List.tail(xs)))

def hasHoleArms(xs: List[Arm]): Bool =
  if (List.isEmpty(xs)) false else hasHoleArm(List.at(xs, 0)) || hasHoleArms(List.tail(xs))

def hasHoleArm(a: Arm): Bool =
  a match {
    case Arm(_, _, body) => hasHole(body)
  }

def rewriteHole(e: Expr, n: String): Expr =
  e match {
    case Expr.EHole => Expr.EVar(n, 0)
    case Expr.EPrint(inner, off) => Expr.EPrint(rewriteHole(inner, n), off)
    case Expr.ECall(f, args, off) => Expr.ECall(f, rewriteHoleList(args, n), off)
    case Expr.EMethod(recv, name, args, off) => Expr.EMethod(rewriteHole(recv, n), name, rewriteHoleList(args, n), off)
    case Expr.EField(recv, name, off) => Expr.EField(rewriteHole(recv, n), name, off)
    case Expr.EBin(op, l, r, off) => Expr.EBin(op, rewriteHole(l, n), rewriteHole(r, n), off)
    case Expr.EUn(op, inner, off) => Expr.EUn(op, rewriteHole(inner, n), off)
    case Expr.ELam(p, ty, body) => Expr.ELam(p, ty, rewriteHole(body, n))
    case Expr.EIf(c, t, el, off) => Expr.EIf(rewriteHole(c, n), rewriteHole(t, n), rewriteHole(el, n), off)
    case Expr.ENamed(nm, inner) => Expr.ENamed(nm, rewriteHole(inner, n))
    case Expr.EAscribe(inner, ty, off) => Expr.EAscribe(rewriteHole(inner, n), ty, off)
    case Expr.EList(xs) => Expr.EList(rewriteHoleList(xs, n))
    case Expr.ETuple(xs) => Expr.ETuple(rewriteHoleList(xs, n))
    case _ => e
  }

def rewriteHoleList(xs: List[Expr], n: String): List[Expr] =
  if (List.isEmpty(xs)) xs else rewriteHole(List.at(xs, 0), n) :: rewriteHoleList(List.tail(xs), n)

def emitExprGo(e: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  e match {
    case Expr.EInt(n, _) => Slot("", Str.fromInt(n), false)
    case Expr.EBool(b) => Slot("", if (b) "1" else "0", false)
    case Expr.EVar(s, _) => emitVar(s, prefix, ens, ps, strs, defs, loc)
    case Expr.EStr(s, _) => emitStrAs(s, prefix, strs, "s")
    case Expr.EPrint(inner, _) => emitPrint(inner, prefix, strs, defs, ens, ps, loc)
    case Expr.ECall(f, args, _) => emitCall(f, args, prefix, strs, defs, ens, ps, loc, fid)
    case Expr.EBin(op, l, r, _) => emitBin(op, l, r, prefix, strs, defs, ens, ps, loc)
    case Expr.EUn(op, inner, _) => emitUn(op, inner, prefix, strs, defs, ens, ps, loc)
    case Expr.ENamed(_, inner) => emitExprFid(inner, prefix, strs, defs, ens, ps, loc, fid)
    case Expr.EMethod(recv, name, args, _) => if (isFmName(name)) emitFmRt(fmRt(name), recv, args, prefix, strs, defs, ens, ps, loc, fid) else if (name == "apply") emitApplyRecv(recv, args, prefix, strs, defs, ens, ps, loc, fid) else if (name == "map") emitIoMap(recv, args, prefix, strs, defs, ens, ps, loc, fid) else emitCtorCall(recv, name, args, prefix, strs, defs, ens, ps, loc, fid)
    case Expr.ELam(p, ty, body) => if (ty == "") emitLam(p, body, prefix, strs, defs, ens, ps, loc) else emitLamTyped(p, ty, body, prefix, strs, defs, ens, ps, loc)
    case Expr.EIf(c, t, el, off) => emitIfFid(c, t, el, off, prefix, strs, defs, ens, ps, loc, fid)
    case Expr.EField(recv, name, _) => emitField(recv, name, prefix, strs, defs, ens, ps, loc)
    case Expr.EMatch(s, arms, off) => emitMatch(s, arms, off, prefix, strs, defs, ens, ps, loc, fid)
    case Expr.EList(xs) => emitList(xs, prefix, strs, defs, ens, ps, loc)
    case Expr.ETuple(xs) => emitTuple(xs, prefix, strs, defs, ens, ps, loc)
    case Expr.EInterp(_, parts, _) => emitInterp(parts, prefix, strs, defs, ens, ps, loc)
    case Expr.EFloat(s, _) => emitFloatBits(s, prefix)
    case Expr.EFor(bs, body, _) => emitExprFid(desugarFor(bs, body), prefix, strs, defs, ens, ps, loc, fid)
    case Expr.EAscribe(inner, _, _) => emitExprFid(inner, prefix, strs, defs, ens, ps, loc, fid)
    case Expr.EUnit => Slot("", "null", true)
    case _ => emitStuck()
  }

def emitStuck(): Slot =
  emitStuck()

def emitFloatBits(s: String, prefix: String): Slot =
  Slot(line(Str.concat(tmp(prefix, "fb"), Str.concat("bitcast double ", Str.concat(s, " to i64")))), pct(prefix, "fb"), false)

def emitVar(s: String, prefix: String, ens: List[En], ps: List[Param], strs: Strs, defs: Ftab, loc: String): Slot =
  if (s == ".closure.value" || paramTy(ps, s) != "") Slot("", Str.concat("%", s), s == ".closure.value" && paramTy(ps, s) == "") else emitFunOrCtor(s, prefix, ens, ps, strs, defs, loc, findDefPrefer(defs, s, modOfLoc(loc)))

def emitFunOrCtor(s: String, prefix: String, ens: List[En], ps: List[Param], strs: Strs, defs: Ftab, loc: String, hit: List[Fun]): Slot =
  if (List.isEmpty(hit)) emitBareCtor(s, prefix, ens) else emitFunRef(List.at(hit, 0), prefix, strs, defs, ens, ps, loc)

def emitFunRef(d: Fun, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  d match {
    case Fun(_, _, name, _, params, _, _, _, _) => emitFunRef2(name, params, prefix, strs, defs, ens, ps, loc)
  }

def emitFunRef2(name: String, params: List[Param], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.len(params) == 2) emitExpr(etaFold(name), prefix, strs, defs, ens, ps, loc) else if (List.isEmpty(params)) emitLam("_", Expr.ECall(name, noExpr(), 0), prefix, strs, defs, ens, ps, loc) else emitFunRef1(name, List.at(params, 0), prefix, strs, defs, ens, ps, loc)

def emitFunRef1(name: String, p: Param, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  p match {
    case Param(n, _, _, _) => emitLam(n, Expr.ECall(name, Expr.EVar(n, 0) :: noExpr(), 0), prefix, strs, defs, ens, ps, loc)
  }

def emitBareCtor(s: String, prefix: String, ens: List[En]): Slot =
  if (enOfCase(ens, s) == "") Slot("", Str.concat("%", s), false) else emitCtor(enOfCase(ens, s), s, prefix, ens)

def enOfCase(ens: List[En], name: String): String =
  if (List.isEmpty(ens)) "" else enOfCaseH(List.at(ens, 0), List.tail(ens), name)

def enOfCaseH(h: En, rest: List[En], name: String): String =
  h match {
    case En(_, n, _, cases) => if (hasCase(cases, name)) n else enOfCase(rest, name)
  }

def hasCase(cs: List[EnCase], name: String): Bool =
  if (List.isEmpty(cs)) false else hasCaseH(List.at(cs, 0), List.tail(cs), name)

def hasCaseH(h: EnCase, rest: List[EnCase], name: String): Bool =
  h match {
    case EnCase(n, _) => n == name || hasCase(rest, name)
  }

def desugarFor(bs: List[Bind], body: Expr): Expr =
  desugarForRev(List.reverse(bs), forYield(bs, body))

def forYield(bs: List[Bind], body: Expr): Expr =
  if (Check.forHasDraw(bs)) Expr.ECall("IO.pure", body :: noExpr(), 0) else body

def isIoPred(e: Expr): Bool =
  e match {
    case Expr.EFor(bs, body, _) => Check.forHasDraw(bs) || isIoPred(body)
    case Expr.ECall(f, _, _) => ioCall(f)
    case Expr.EMethod(_, name, _, _) => name == "flatMap" || name == "map" || name == "handleErrorWith"
    case Expr.EIf(_, t, el, _) => isIoPred(t) || isIoPred(el)
    case _ => false
  }

def clockPure(f: String): Bool =
  f == "Clock.iso8601" || f == "Clock.parse" || f == "Clock.zone"

def ioCall(f: String): Bool =
  Str.startsWith(f, "IO.") || Str.startsWith(f, "Fs.") || Str.startsWith(f, "Net.") && f != "Net.retryAfterMillis" && f != "Net.nextLink" || Str.startsWith(f, "Sys.") || Str.startsWith(f, "Clock.") && !clockPure(f) || Str.startsWith(f, "Random.") || Str.startsWith(f, "Uuid.")

def desugarForRev(bs: List[Bind], body: Expr): Expr =
  if (List.isEmpty(bs)) body else desugarForRevHit(bs, body)

def desugarForRevHit(bs: List[Bind], body: Expr): Expr =
  desugarForRevGo(bs, List.at(bs, 0), List.tail(bs), body)

def desugarForRevGo(held: List[Bind], b: Bind, rest: List[Bind], body: Expr): Expr =
  desugarForRev(rest, wrapBindHeld(held, b, body))

def wrapBindHeld(_held: List[Bind], b: Bind, body: Expr): Expr =
  wrapBind(b, body)

def wrapBind(b: Bind, body: Expr): Expr =
  b match {
    case Bind(draw, name, v) => wrapBindGo(draw, name, v, body)
  }

def wrapBindGo(draw: Bool, name: String, v: Expr, body: Expr): Expr =
  if (draw) wrapDraw(name, v, body) else if (name == "__guard") wrapGuard(v, body) else wrapEq(name, v, body)

def wrapGuard(c: Expr, body: Expr): Expr =
  Expr.EIf(c, body, Expr.ECall("IO.fail", Expr.EStr("guard", 0) :: noExpr(), 0), 0)

def wrapDraw(name: String, v: Expr, body: Expr): Expr =
  if (isSimpleBind(name)) Expr.EMethod(v, "flatMap", Expr.ELam(name, "", body) :: noExpr(), 0) else wrapPatDraw(name, v, body)

def wrapPatDraw(pat: String, v: Expr, body: Expr): Expr =
  Expr.EMethod(Expr.EMethod(v, "flatMap", Expr.ELam("__p", "", Expr.ECall("IO.pure", Expr.EMatch(Expr.EVar("__p", 0), Arm(pat, "", patResult(pat)) :: noArm(), 0) :: noExpr(), 0)) :: noExpr(), 0), "flatMap", Expr.ELam(patBindName(pat), "", body) :: noExpr(), 0)

def patResult(pat: String): Expr =
  if (isConsPat(pat)) Expr.EVar(consHead(pat), 0) else if (hasComma(patBind(pat))) Expr.ETuple(patEVars(splitPat(patBind(pat)))) else Expr.EVar(fieldBind(patBind(pat)), 0)

def patEVars(ns: List[String]): List[Expr] =
  if (List.isEmpty(ns)) noExpr() else Expr.EVar(fieldBind(List.at(ns, 0)), 0) :: patEVars(List.tail(ns))

def patBindName(pat: String): String =
  if (isConsPat(pat)) consHead(pat) else if (hasComma(patBind(pat))) Str.concat("(", Str.concat(joinComma(splitPat(patBind(pat))), ")")) else fieldBind(patBind(pat))

def joinComma(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else if (List.isEmpty(List.tail(xs))) List.at(xs, 0) else Str.concat(List.at(xs, 0), Str.concat(", ", joinComma(List.tail(xs))))

def wrapEq(name: String, v: Expr, body: Expr): Expr =
  if (eqIsLet(name)) Expr.EMethod(Expr.ELam(name, "", body), "apply", nameSig(name, v) :: noExpr(), 0) else Expr.EMatch(v, Arm(name, "", body) :: noArm(), 0 - 1)

def nameSig(name: String, v: Expr): Expr =
  if (name == "_" || !isSimpleBind(name)) v else nameSigGo(name, v)

def nameSigGo(name: String, v: Expr): Expr =
  v match {
    case Expr.ECall(f, args, _) => if (sigCtorKit(f)) Expr.ECall(Str.concat(f, "N"), Expr.EStr(name, 0) :: args, 0) else v
    case _ => v
  }

def sigCtorKit(f: String): Bool =
  f == "Signal.make" || f == "Signal.map"

def eqIsLet(name: String): Bool =
  name == "_" || keepBind(name) && !isTuplePat(name) && isSimpleBind(name)

def isSimpleBind(n: String): Bool =
  n != "" && parenAt(n, 0) < 0 && !isConsPat(n)

def emitInterp(parts: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitInterpFold(parts, prefix, strs, defs, ens, ps, loc, 0)

def emitInterpFold(parts: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  if (List.isEmpty(parts)) emitStrAs("", prefix, strs, "s") else emitInterpAcc(emitInterpPart(List.at(parts, 0), prefix, i, strs, defs, ens, ps, loc), List.tail(parts), prefix, strs, defs, ens, ps, loc, i + 1)

def emitInterpPart(e: Expr, prefix: String, i: Int, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  e match {
    case Expr.EStr(s, _) => emitStrAs(s, Str.concat(prefix, Str.concat("_l", Str.fromInt(i))), strs, "s")
    case _ => emitInterpExpr(e, Str.concat(prefix, Str.concat("_e", Str.fromInt(i))), strs, defs, ens, ps, loc)
  }

def emitInterpExpr(e: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitInterpExpr2(emitExpr(e, prefix, strs, defs, ens, ps, loc), prefix, exprIsI64(e, ps, defs), ps, isFloatExpr(e, ps, defs), exprRetTyEns(e, defs, ens, ps, loc))

def emitInterpExpr2(s: Slot, prefix: String, i64: Bool, ps: List[Param], fl: Bool, ty: String): Slot =
  s match {
    case Slot(c, v, o) => if (fl) emitInterpFloat(s, prefix) else if (i64 || hasSub(v, "_u")) emitInterpI64(if (thenIsPtr(c, v, o, ps)) unboxBin(s, ps, prefix) else s, prefix) else emitInterpPtr(s, prefix, ty)
  }

def emitInterpPtr(s: Slot, prefix: String, ty: String): Slot =
  if (ty == "View") emitInterpView(s, prefix) else if (tyHead(ty) == "Signal") emitInterpSig(s, prefix) else s

def emitInterpView(s: Slot, prefix: String): Slot =
  s match {
    case Slot(c, v, o) => Slot(join(c, join(line(Str.concat(tmp(prefix, "istr"), Str.concat("call ptr @sz_view_show(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "istr"), true)
  }

def emitInterpSig(s: Slot, prefix: String): Slot =
  s match {
    case Slot(c, v, o) => Slot(join(c, join(line(Str.concat(tmp(prefix, "istr"), Str.concat("call ptr @sz_signal_show(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "istr"), true)
  }

def emitInterpFloat(s: Slot, prefix: String): Slot =
  s match {
    case Slot(c, v, _) => emitInterpFloat2(c, v, prefix)
  }

def emitInterpFloat2(c: String, v: String, prefix: String): Slot =
  Slot(join(c, join(bitcastF(v, prefix, "fd"), fromFloatCall(prefix))), pct(prefix, "istr"), true)

def fromFloatCall(prefix: String): String =
  line(Str.concat(tmp(prefix, "istr"), Str.concat("call ptr @sz_string_from_float(double ", Str.concat(pct(prefix, "fd"), ")"))))

def emitInterpI64(s: Slot, prefix: String): Slot =
  s match {
    case Slot(c, v, _) => Slot(join(c, line(Str.concat(tmp(prefix, "istr"), Str.concat("call ptr @sz_string_from_int(i64 ", Str.concat(v, ")"))))), pct(prefix, "istr"), true)
  }

def emitInterpAcc(acc: Slot, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  if (List.isEmpty(rest)) acc else emitInterpCat(acc, emitInterpPart(List.at(rest, 0), prefix, i, strs, defs, ens, ps, loc), rest, prefix, strs, defs, ens, ps, loc, i)

def emitInterpCat(acc: Slot, nxt: Slot, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  acc match {
    case Slot(ac, av, ao) => emitInterpCat2(ac, av, ao, nxt, rest, prefix, strs, defs, ens, ps, loc, i)
  }

def emitInterpCat2(ac: String, av: String, ao: Bool, nxt: Slot, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  nxt match {
    case Slot(nc, nv, no) => emitInterpCat3(join(ac, nc), av, ao, nv, no, rest, prefix, strs, defs, ens, ps, loc, i)
  }

def emitInterpCat3(code: String, av: String, ao: Bool, nv: String, no: Bool, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  emitInterpAcc(emitInterpJoin(code, av, ao, nv, no, prefix, i), List.tail(rest), prefix, strs, defs, ens, ps, loc, i + 1)

def interpCStem(prefix: String, i: Int): String =
  Str.concat(prefix, Str.concat("_c", Str.fromInt(i)))

def emitInterpJoin(code: String, a: String, oa: Bool, b: String, ob: Bool, prefix: String, i: Int): Slot =
  emitInterpJoin2(code, a, oa, b, ob, interpCStem(prefix, i))

def emitInterpJoin2(code: String, a: String, oa: Bool, b: String, ob: Bool, stem: String): Slot =
  Slot(join(code, join(interpConcat(stem, a, b, oa), if (ob) relPtr(b) else "")), pct(stem, "v"), true)

def interpConcat(stem: String, a: String, b: String, oa: Bool): String =
  line(Str.concat(tmp(stem, "v"), Str.concat("call ptr @", Str.concat(concatRt(oa), Str.concat("(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))))

def concatRt(take: Bool): String =
  if (take) "sz_string_concat_take" else "sz_string_concat"

def emitStr(s: String, prefix: String, strs: Strs): Slot =
  emitStrAs(s, prefix, strs, "ss")

def emitStrAs(s: String, prefix: String, strs: Strs, stem: String): Slot =
  emitStr2(prefix, strIndex(strs, s, 0), strArr(s), stem)

def emitStr2(prefix: String, idx: Int, len: Int, stem: String): Slot =
  Slot(join(line(Str.concat(tmp(prefix, "gep"), Str.concat("getelementptr inbounds [", Str.concat(Str.fromInt(len), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(idx), ", i64 0, i64 0")))))), line(Str.concat(tmp(prefix, stem), Str.concat("call ptr @sz_string_lit(ptr ", Str.concat(pct(prefix, "gep"), ")"))))), pct(prefix, stem), true)

def emitPrint(inner: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitPrint2(emitSzString(inner, prefix, strs, defs, ens, ps, loc), prefix)

def emitSzString(inner: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  inner match {
    case Expr.EStr(s, _) => emitStr(s, prefix, strs)
    case _ => emitExpr(inner, Str.concat(prefix, "_e"), strs, defs, ens, ps, loc)
  }

def emitPrint2(s: Slot, prefix: String): Slot =
  Slot(join(s.code, join(line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @sz_io_println(ptr ", Str.concat(s.val, ")")))), if (s.owned) line(Str.concat("call void @sz_release(ptr ", Str.concat(s.val, ")"))) else "")), pct(prefix, "io"), true)

def emitBin(op: String, l: Expr, r: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (op == "::") emitCall("List.cons", l :: r :: noExpr(), prefix, strs, defs, ens, ps, loc, 0) else if (op == "&&") emitSc(true, l, r, prefix, strs, defs, ens, ps, loc) else if (op == "||") emitSc(false, l, r, prefix, strs, defs, ens, ps, loc) else emitBinFl(emitExpr(l, Str.concat(prefix, "_l"), strs, defs, ens, ps, loc), emitExpr(r, Str.concat(prefix, "_r"), strs, defs, ens, ps, loc), op, prefix, ps, isFloatExpr(l, ps, defs) || isFloatExpr(r, ps, defs) || exprRetTyEns(l, defs, ens, ps, loc) == "Float" || exprRetTyEns(r, defs, ens, ps, loc) == "Float" || methodValueTy(l, defs, ens, ps, loc) == "Float" || methodValueTy(r, defs, ens, ps, loc) == "Float", exprIsPtr(l, defs, ens, ps, loc) || exprIsPtr(r, defs, ens, ps, loc))

def methodValueTy(e: Expr, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  e match {
    case Expr.EMethod(recv, name, args, _) => methodValueTyHit(methodHit(defs, recvEnTy(tyHead(exprRetTyEns(recv, defs, ens, ps, loc)), ens, defs, name), name), userArgTys(recv :: args, defs, ens, ps, loc))
    case _ => ""
  }

def methodValueTyHit(hit: List[Fun], argTys: List[String]): String =
  if (List.isEmpty(hit)) "" else methodValueTyFun(List.at(hit, 0), argTys)

def methodValueTyFun(f: Fun, argTys: List[String]): String =
  f match {
    case Fun(_, _, _, _, params, ret, _, _, _) => callRetArgTy(params, argTys, ret)
  }

def isFloatExpr(e: Expr, ps: List[Param], defs: Ftab): Bool =
  e match {
    case Expr.EFloat(_, _) => true
    case Expr.EVar(s, _) => paramTy(ps, s) == "Float"
    case Expr.ECall(f, _, _) => funRetStr(defs, f) == "Float" || Type.funRetStr(paramTy(ps, f)) == "Float" || f == "Float.fromInt"
    case Expr.EMethod(r, n, _, _) => isFloatMeth(r, n) || isFloatCall(r, n, defs) || isFloatExpr(r, ps, defs)
    case Expr.EBin(_, a, b, _) => isFloatExpr(a, ps, defs) || isFloatExpr(b, ps, defs)
    case Expr.EUn(_, inner, _) => isFloatExpr(inner, ps, defs)
    case Expr.ENamed(_, inner) => isFloatExpr(inner, ps, defs)
    case Expr.EAscribe(inner, _, _) => isFloatExpr(inner, ps, defs)
    case _ => false
  }

def isFloatCall(r: Expr, n: String, defs: Ftab): Bool =
  r match {
    case Expr.EVar(m, _) => funRetStr(defs, qualFun(m, n)) == "Float"
    case _ => false
  }

def emitBinFl(le: Slot, re: Slot, op: String, prefix: String, ps: List[Param], fl: Bool, ptr: Bool): Slot =
  if (isCmp(op)) emitBinCmpFl(le, re, op, prefix, ps, fl, ptr) else if (fl) emitFBin2L(le, re, op, prefix) else emitBin2L(unboxBin(le, ps, Str.concat(prefix, "_bl")), unboxBin(re, ps, Str.concat(prefix, "_br")), op, prefix)

def emitBinCmpFl(le: Slot, re: Slot, op: String, prefix: String, ps: List[Param], fl: Bool, ptr: Bool): Slot =
  if (fl) emitFCmp(le, re, op, prefix) else emitBinCmpPick(le, re, op, prefix, ps, ptr)

def emitFBin2L(le: Slot, re: Slot, op: String, prefix: String): Slot =
  le match {
    case Slot(lc, lv, _) => emitFBin2R(lc, lv, re, op, prefix)
  }

def emitFBin2R(lc: String, lv: String, re: Slot, op: String, prefix: String): Slot =
  re match {
    case Slot(rc, rv, _) => emitFBin2S(join(lc, rc), lv, rv, op, prefix)
  }

def emitFBin2S(code: String, lv: String, rv: String, op: String, prefix: String): Slot =
  Slot(join(code, join(bitcastF(lv, prefix, "fl"), join(bitcastF(rv, prefix, "fr"), join(fBinLine(op, prefix), bitcastI(pct(prefix, "fv"), prefix))))), pct(prefix, "v"), false)

def fBinLine(op: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "fv"), Str.concat(llvmFBin(op), Str.concat(" double ", Str.concat(pct(prefix, "fl"), Str.concat(", ", pct(prefix, "fr")))))))

def bitcastF(v: String, prefix: String, stem: String): String =
  line(Str.concat(tmp(prefix, stem), Str.concat("bitcast i64 ", Str.concat(v, " to double"))))

def bitcastI(v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("bitcast double ", Str.concat(v, " to i64"))))

def llvmFBin(op: String): String =
  if (op == "+") "fadd" else if (op == "-") "fsub" else if (op == "*") "fmul" else if (op == "/") "fdiv" else "fadd"

def emitFCmp(le: Slot, re: Slot, op: String, prefix: String): Slot =
  le match {
    case Slot(lc, lv, _) => emitFCmpR(lc, lv, re, op, prefix)
  }

def emitFCmpR(lc: String, lv: String, re: Slot, op: String, prefix: String): Slot =
  re match {
    case Slot(rc, rv, _) => emitFCmpS(join(lc, rc), lv, rv, op, prefix)
  }

def emitFCmpS(code: String, lv: String, rv: String, op: String, prefix: String): Slot =
  Slot(join(code, join(bitcastF(lv, prefix, "fl"), join(bitcastF(rv, prefix, "fr"), join(fCmpLine(op, prefix), fCmpZext(prefix))))), pct(prefix, "v"), false)

def fCmpLine(op: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "fc"), Str.concat(llvmFCmp(op), Str.concat(" double ", Str.concat(pct(prefix, "fl"), Str.concat(", ", pct(prefix, "fr")))))))

def fCmpZext(prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("zext i1 ", Str.concat(pct(prefix, "fc"), " to i64"))))

def llvmFCmp(op: String): String =
  if (op == "<") "fcmp olt" else if (op == ">") "fcmp ogt" else if (op == "<=") "fcmp ole" else if (op == ">=") "fcmp oge" else if (op == "==") "fcmp oeq" else "fcmp une"

def isFloatMeth(r: Expr, n: String): Bool =
  r match {
    case Expr.EVar(m, _) => m == "Float" && n == "fromInt"
    case _ => false
  }

def emitBinCmpPick(le: Slot, re: Slot, op: String, prefix: String, ps: List[Param], ptr: Bool): Slot =
  if (ptr || cmpPtrSides(le, re, ps)) emitPtrEq(le, re, op, prefix) else emitBinCmp(unboxBin(le, ps, Str.concat(prefix, "_bl")), unboxBin(re, ps, Str.concat(prefix, "_br")), op, prefix, ps)

def cmpPtrSides(le: Slot, re: Slot, ps: List[Param]): Bool =
  le match {
    case Slot(lc, lv, lo) => re match {
  case Slot(rc, rv, ro) => lo || ro || cmpPtrSlot(lv, rv, ps) || cmpPtrSlot(rv, lv, ps) || cmpPtrCall(lc, lv, rc, rv, ro, ps) || cmpPtrCall(rc, rv, lc, lv, lo, ps)
}
  }

def cmpPtrCall(ac: String, a: String, bc: String, b: String, bo: Bool, ps: List[Param]): Bool =
  thenCallPtr(ac, a) && (bo || isPtrSlot(b, ps) || thenCallPtr(bc, b) || b == "null")

def cmpPtrSlot(a: String, b: String, ps: List[Param]): Bool =
  isPtrSlot(a, ps) && !isI64Lit(b)

def isI64Lit(v: String): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) != 37 && v != "null"

def exprIsPtr(e: Expr, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Bool =
  e match {
    case Expr.EInt(_, _) => false
    case Expr.EBool(_) => false
    case Expr.EFloat(_, _) => false
    case Expr.EVar(s, _) => ptrFromKnown(paramTy(ps, s))
    case Expr.EStr(_, _) => true
    case _ => ptrFromKnown(exprRetTyEns(e, defs, ens, ps, loc))
  }

def ptrFromKnown(ty: String): Bool =
  ty != "" && ty != "Any" && !isTyParam(ty) && Type.isPtrStr(ty)

def unboxBin(s: Slot, ps: List[Param], prefix: String): Slot =
  s match {
    case Slot(c, v, o) => if (fromIntUnbox(v, ps) || thenIsPtr(c, v, o, ps)) Slot(join(c, line(Str.concat(tmp(prefix, "u"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(v, ")"))))), pct(prefix, "u"), false) else Slot(c, v, o)
  }

def emitBin2L(le: Slot, re: Slot, op: String, prefix: String): Slot =
  le match {
    case Slot(lc, lv, _) => emitBin2R(lc, lv, re, op, prefix)
  }

def emitBin2R(lc: String, lv: String, re: Slot, op: String, prefix: String): Slot =
  re match {
    case Slot(rc, rv, _) => Slot(join(lc, join(rc, line(Str.concat(tmp(prefix, "v"), Str.concat(llvmBin(op), Str.concat(" i64 ", Str.concat(lv, Str.concat(", ", rv)))))))), pct(prefix, "v"), false)
  }

def emitBinCmp(le: Slot, re: Slot, op: String, prefix: String, ps: List[Param]): Slot =
  le match {
    case Slot(lc, lv, lo) => emitBinCmpR(lc, lv, lo, re, op, prefix, ps)
  }

def emitBinCmpR(lc: String, lv: String, lo: Bool, re: Slot, op: String, prefix: String, ps: List[Param]): Slot =
  re match {
    case Slot(rc, rv, ro) => emitBinCmpHit(lc, lv, lo, rc, rv, ro, op, prefix, ps)
  }

def emitBinCmpHit(lc: String, lv: String, lo: Bool, rc: String, rv: String, ro: Bool, op: String, prefix: String, ps: List[Param]): Slot =
  if (lo || ro || isPtrSlot(lv, ps) || isPtrSlot(rv, ps)) emitPtrEq3(join(lc, rc), lv, lo, rv, ro, op, prefix) else emitCmpFrom(lc, lv, rc, rv, op, prefix)

def emitPtrEq(le: Slot, re: Slot, op: String, prefix: String): Slot =
  le match {
    case Slot(lc, lv, lo) => emitPtrEqR(lc, lv, lo, re, op, prefix)
  }

def emitPtrEqR(lc: String, lv: String, lo: Bool, re: Slot, op: String, prefix: String): Slot =
  re match {
    case Slot(rc, rv, ro) => emitPtrEq3(join(lc, rc), lv, lo, rv, ro, op, prefix)
  }

def emitPtrEq3(code: String, lv: String, lo: Bool, rv: String, ro: Bool, op: String, prefix: String): Slot =
  Slot(join(code, join(ptrEqCall(prefix, lv, rv), join(ptrEqZext(prefix), join(if (lo) relPtr(lv) else "", join(if (ro) relPtr(rv) else "", if (op == "!=") emitPtrNe(prefix) else ""))))), if (op == "!=") pct(prefix, "nev") else pct(prefix, "eq"), false)

def ptrEqCall(prefix: String, a: String, b: String): String =
  line(Str.concat(tmp(prefix, "eqi"), Str.concat("call i32 @sz_ptr_eq(ptr ", Str.concat(ptrEqSide(a), Str.concat(", ptr ", Str.concat(ptrEqSide(b), ")"))))))

def ptrEqSide(v: String): String =
  if (v == "0") "null" else v

def ptrEqZext(prefix: String): String =
  line(Str.concat(tmp(prefix, "eq"), Str.concat("zext i32 ", Str.concat(pct(prefix, "eqi"), " to i64"))))

def emitPtrNe(prefix: String): String =
  join(line(Str.concat(tmp(prefix, "ne"), Str.concat("icmp eq i64 ", Str.concat(pct(prefix, "eq"), ", 0")))), line(Str.concat(tmp(prefix, "nev"), Str.concat("zext i1 ", Str.concat(pct(prefix, "ne"), " to i64")))))

def isCmp(op: String): Bool =
  op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">="

def llvmIcmp(op: String): String =
  if (op == "==") "eq" else if (op == "!=") "ne" else if (op == "<") "slt" else if (op == "<=") "sle" else if (op == ">") "sgt" else "sge"

def emitCmpFrom(lc: String, lv: String, rc: String, rv: String, op: String, prefix: String): Slot =
  Slot(join(lc, join(rc, join(line(Str.concat(tmp(prefix, "cmp"), Str.concat("icmp ", Str.concat(llvmIcmp(op), Str.concat(" i64 ", Str.concat(lv, Str.concat(", ", rv))))))), line(Str.concat(tmp(prefix, "v"), Str.concat("zext i1 ", Str.concat(pct(prefix, "cmp"), " to i64"))))))), pct(prefix, "v"), false)

def emitUn(op: String, inner: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitUnFl(emitExpr(inner, Str.concat(prefix, "_u"), strs, defs, ens, ps, loc), op, prefix, isFloatExpr(inner, ps, defs))

def emitUnFl(inner: Slot, op: String, prefix: String, fl: Bool): Slot =
  if (op == "-" && fl) emitFNeg(inner, prefix) else emitUn2(inner, op, prefix)

def emitFNeg(inner: Slot, prefix: String): Slot =
  Slot(join(inner.code, join(bitcastF(inner.val, prefix, "fu"), join(fNegLine(prefix), bitcastI(pct(prefix, "fn"), prefix)))), pct(prefix, "v"), false)

def fNegLine(prefix: String): String =
  line(Str.concat(tmp(prefix, "fn"), Str.concat("fneg double ", pct(prefix, "fu"))))

def emitUn2(inner: Slot, op: String, prefix: String): Slot =
  if (op == "-") Slot(join(inner.code, line(Str.concat(tmp(prefix, "v"), Str.concat("sub i64 0, ", inner.val)))), pct(prefix, "v"), false) else if (op == "!") emitNot(inner, prefix) else if (op == "~") emitBitNot(inner, prefix) else inner

def emitBitNot(inner: Slot, prefix: String): Slot =
  Slot(join(inner.code, line(Str.concat(tmp(prefix, "v"), Str.concat("xor i64 ", Str.concat(inner.val, ", -1"))))), pct(prefix, "v"), false)

def emitNot(inner: Slot, prefix: String): Slot =
  Slot(join(inner.code, join(line(Str.concat(tmp(prefix, "z"), Str.concat("icmp eq i64 ", Str.concat(inner.val, ", 0")))), line(Str.concat(tmp(prefix, "v"), Str.concat("zext i1 ", Str.concat(pct(prefix, "z"), " to i64")))))), pct(prefix, "v"), false)

def emitList(xs: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitListAt(xs, prefix, strs, defs, ens, ps, loc, 0)

def emitTuple(xs: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(xs)) Slot("", "null", true) else emitTupleFold1(List.at(xs, 0), List.tail(xs), prefix, 0, strs, defs, ens, ps, loc)

def emitTupleFold1(h: Expr, rest: List[Expr], prefix: String, i: Int, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(rest)) Slot("", "null", true) else emitTupleFold2(h, List.at(rest, 0), List.tail(rest), prefix, i, strs, defs, ens, ps, loc)

def emitTupleFold2(h: Expr, x: Expr, more: List[Expr], prefix: String, i: Int, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(more)) emitPair(h, x, Str.concat(prefix, Str.concat("_", Str.fromInt(i))), strs, defs, ens, ps, loc) else emitTupleNest(h, emitTupleFold1(x, more, prefix, i + 1, strs, defs, ens, ps, loc), prefix, i, strs, defs, ens, ps, loc)

def emitTupleNest(h: Expr, rest: Slot, prefix: String, i: Int, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitPair2(emitExpr(h, Str.concat(prefix, Str.concat("_h", Str.fromInt(i))), strs, defs, ens, ps, loc), rest, exprIsI64(h, ps, defs), false, exprRetTyEns(h, defs, ens, ps, loc) == "Float", false, Str.concat(prefix, Str.concat("_p", Str.fromInt(i))))

def emitPair(l: Expr, r: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitPair2(emitExpr(l, Str.concat(prefix, "_l"), strs, defs, ens, ps, loc), emitExpr(r, Str.concat(prefix, "_r"), strs, defs, ens, ps, loc), exprIsI64(l, ps, defs), exprIsI64(r, ps, defs), exprRetTyEns(l, defs, ens, ps, loc) == "Float", exprRetTyEns(r, defs, ens, ps, loc) == "Float", prefix)

def emitPair2(le: Slot, re: Slot, ln: Bool, rn: Bool, lf: Bool, rf: Bool, prefix: String): Slot =
  le match {
    case Slot(lc, lv, lo) => emitPair3(lc, lv, lo, ln, lf, re, rn, rf, prefix)
  }

def emitPair3(lc: String, lv: String, lo: Bool, ln: Bool, lf: Bool, re: Slot, rn: Bool, rf: Bool, prefix: String): Slot =
  re match {
    case Slot(rc, rv, ro) => emitPair4(join(lc, rc), lv, lo, ln, lf, rv, ro, rn, rf, prefix)
  }

def emitPair4(code: String, lv: String, lo: Bool, ln: Bool, lf: Bool, rv: String, ro: Bool, rn: Bool, rf: Bool, prefix: String): Slot =
  Slot(join(code, join(pairBoxTyped(lv, ln, lf, prefix, "lb"), join(pairBoxTyped(rv, rn, rf, prefix, "rb"), join(pairNew(prefix, pairPtr(lv, ln, prefix, "lb"), pairPtr(rv, rn, prefix, "rb")), join(pairDrop(lv, lo, ln, prefix, "lb"), pairDrop(rv, ro, rn, prefix, "rb")))))), pct(prefix, "v"), true)

def pairBox(v: String, num: Bool, prefix: String, stem: String): String =
  if (num) line(Str.concat(tmp(prefix, stem), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(v, ")")))) else ""

def pairBoxTyped(v: String, num: Bool, isFloat: Bool, prefix: String, stem: String): String =
  if (num) boxScalarStem(v, if (isFloat) "Float" else "Int", prefix, stem) else ""

def pairPtr(v: String, num: Bool, prefix: String, stem: String): String =
  if (num) pct(prefix, stem) else v

def pairNew(prefix: String, lp: String, rp: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_pair_new(ptr ", Str.concat(lp, Str.concat(", ptr ", Str.concat(rp, ")"))))))

def pairDrop(v: String, owned: Bool, num: Bool, prefix: String, stem: String): String =
  if (num) relPtr(pct(prefix, stem)) else if (owned) relPtr(v) else ""

def exprIsI64(e: Expr, ps: List[Param], defs: Ftab): Bool =
  if (needsPh(e)) false else exprIsI64Go(e, ps, defs)

def exprIsI64Go(e: Expr, ps: List[Param], defs: Ftab): Bool =
  e match {
    case Expr.EInt(_, _) => true
    case Expr.EFloat(_, _) => true
    case Expr.EBool(_) => true
    case Expr.EVar(s, _) => paramIsI64(ps, s) || isIntSsa(s)
    case Expr.EBin(op, _, _, _) => op != "::"
    case Expr.EUn(_, _, _) => true
    case Expr.ECall(f, args, _) => exprCallI64(f, args, ps, defs)
    case Expr.EMethod(recv, name, args, _) => exprMethI64(recv, name, args, ps, defs)
    case Expr.EMatch(_, arms, _) => exprIsI64Match(arms, ps, defs)
    case Expr.EIf(_, t, _, _) => exprIsI64(t, ps, defs)
    case Expr.ENamed(_, inner) => exprIsI64(inner, ps, defs)
    case Expr.EAscribe(inner, _, _) => exprIsI64(inner, ps, defs)
    case Expr.EField(recv, name, _) => exprFieldI64(recv, name, ps)
    case _ => false
  }

def exprFieldI64(recv: Expr, name: String, ps: List[Param]): Bool =
  recv match {
    case Expr.EVar(s, _) => isTupField(name) && slotInt(tupSlots(paramTy(ps, s)), tupIdx(name))
    case Expr.ENamed(_, inner) => exprFieldI64(inner, name, ps)
    case Expr.EAscribe(inner, _, _) => exprFieldI64(inner, name, ps)
    case _ => false
  }

def exprIsI64Match(arms: List[Arm], ps: List[Param], defs: Ftab): Bool =
  if (List.isEmpty(arms)) false else exprIsI64Arm(List.at(arms, 0), ps, defs)

def exprCallI64(f: String, args: List[Expr], ps: List[Param], defs: Ftab): Bool =
  if (f == "Signal.get") signalGetI64(args, ps, defs) else if (f == "Property.check") exprIsI64Recv(args, ps, defs) else if (f == "List.at") headUnbox(args, ps) else if (callIsI64(f, defs)) true else if (f == "Map.getOrElse") mapGetOrI64(args, ps, defs) else if (isTyParam(funRetStr(defs, f))) argsHaveI64(args, ps, defs) else false

def signalGetI64(args: List[Expr], ps: List[Param], defs: Ftab): Bool =
  !List.isEmpty(args) && isI64Ty(Check.elemOf(exprRetTy(List.at(args, 0), defs, ps)))

def argsHaveI64(xs: List[Expr], ps: List[Param], defs: Ftab): Bool =
  !List.isEmpty(xs) && (exprIsI64(List.at(xs, 0), ps, defs) || argsHaveI64(List.tail(xs), ps, defs))

def mapGetOrI64(args: List[Expr], ps: List[Param], defs: Ftab): Bool =
  List.len(args) >= 3 && exprIsI64(List.at(args, 2), ps, defs)

def exprMethI64(recv: Expr, name: String, args: List[Expr], ps: List[Param], defs: Ftab): Bool =
  if (name == "at") headUnbox1(recv, ps) else if (name == "getOrElse" && !List.isEmpty(args)) exprIsI64(List.at(args, 0), ps, defs) else if (name == "apply") exprApplyI64(recv, ps, defs) else exprMethodI64(recv, name, defs)

def exprApplyI64(recv: Expr, ps: List[Param], defs: Ftab): Bool =
  recv match {
    case Expr.ELam(_, _, body) => exprIsI64(body, ps, defs)
    case Expr.EAscribe(inner, _, _) => exprApplyI64(inner, ps, defs)
    case _ => exprMethodI64(recv, "apply", defs)
  }

def exprIsI64Recv(args: List[Expr], ps: List[Param], defs: Ftab): Bool =
  if (List.len(args) < 3) false else exprIsI64(List.at(List.tail(List.tail(args)), 0), ps, defs)

def exprIsI64Arm(a: Arm, ps: List[Param], defs: Ftab): Bool =
  a match {
    case Arm(_, _, body) => exprIsI64(body, ps, defs)
  }

def paramIsI64(ps: List[Param], s: String): Bool =
  if (List.isEmpty(ps)) false else paramIsI64h(List.at(ps, 0), List.tail(ps), s)

def paramIsI64h(p: Param, rest: List[Param], s: String): Bool =
  p match {
    case Param(n, ty, _, _) => if (n == s) isI64Ty(ty) else paramIsI64(rest, s)
  }

def isIntSsa(s: String): Bool =
  hasSub(s, "_tv") || hasSub(s, "_ic_v") || hasSub(s, "_cu") || hasSub(s, "_phi") || hasSub(s, "_dflt") || hasDigitStem(s, "_b")

def hasDigitStem(s: String, stem: String): Bool =
  hasDigitStemAt(s, stem, 0)

def hasDigitStemAt(s: String, stem: String, n: Int): Bool =
  if (n > 12) false else hasSub(s, Str.concat(stem, Str.fromInt(n))) || hasDigitStemAt(s, stem, n + 1)

def hasSub(s: String, sub: String): Bool =
  Str.contains(s, sub)

def callIsI64(f: String, defs: Ftab): Bool =
  f == "Net.retryAfterMillis" || f == "Str.byteLen" || f == "Property.a11yHas" || f == "Property.signalListLen" || f == "Property.signalInt" || f == "Color.rgb" || f == "Color.rgba" || f == "Theme.accent" || f == "Theme.primary" || f == "Theme.muted" || f == "Theme.foreground" || Str.startsWith(f, "Icon.") || f == "Str.len" || f == "Str.charAt" || f == "Str.toInt" || f == "Str.startsWith" || f == "Str.eq" || f == "Str.contains" || f == "List.len" || f == "List.isEmpty" || f == "Map.size" || f == "Set.size" || f == "Map.contains" || f == "Set.contains" || f == "Json.has" || f == "Json.getBool" || f == "Json.getInt" || f == "Json.intOr" || f == "Json.boolOr" || f == "Json.isNull" || f == "Json.isObj" || f == "Json.isArr" || kitUnaryI64(f) != "" || kitBinaryI64(f) != "" || isTlI64Call(f) || funRetI64(defs, f)

def isTlI64Call(f: String): Bool =
  f == "Timeline.len" || f == "Timeline.signalInt" || f == "Timeline.signalListLen" || (f == "Timeline.signalStrHas" || f == "Timeline.fileTextIs" || f == "Timeline.fileSame") || tlHasRt(f) != "" || tlI64Rt(f) != ""

def exprMethodI64(recv: Expr, name: String, defs: Ftab): Bool =
  if (name == "require") exprIsI64(recv, noParam(), defs) else exprMethodI64Go(recv, name, defs)

def exprMethodI64Go(recv: Expr, name: String, defs: Ftab): Bool =
  recv match {
    case Expr.EVar(en, _) => callIsI64(Str.concat(en, Str.concat(".", name)), defs) || callIsI64(name, defs)
    case _ => false
  }

def funRetI64(defs: Ftab, f: String): Bool =
  isI64Ty(funRetStr(defs, f))

def funRetStr(defs: Ftab, f: String): String =
  funRetNamed(funsNamed(defs, funBare(f)), f)

def funBare(f: String): String =
  funBareAt(f, Str.len(f) - 1)

def funBareAt(f: String, i: Int): String =
  if (i < 0) f else if (Str.charAt(f, i) == 46) Str.slice(f, i + 1, Str.len(f)) else funBareAt(f, i - 1)

def funsNamed(defs: Ftab, name: String): List[Fun] =
  Map.get(defs.tab, name) match {
    case Some(xs) => xs
    case None => noFun()
  }

def funRetNamed(ds: List[Fun], f: String): String =
  if (List.isEmpty(ds)) "" else funRetNamedH(List.at(ds, 0), List.tail(ds), f)

def funRetNamedH(d: Fun, rest: List[Fun], f: String): String =
  d match {
    case Fun(_, _, name, _, _, ret, _, mod, _) => if (qualFun(mod, name) == f || name == f) ret else funRetNamed(rest, f)
  }

def qualFun(mod: String, name: String): String =
  if (mod == "") name else Str.concat(mod, Str.concat(".", name))

def emitListAt(xs: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  if (List.isEmpty(xs)) Slot(line(Str.concat(tmp(prefix, "0"), "call ptr @sz_list_nil()")), pct(prefix, "0"), true) else emitListCons(List.at(xs, 0), List.tail(xs), prefix, strs, defs, ens, ps, loc, i)

def emitListCons(e: Expr, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  emitListConsMethod(e, rest, prefix, strs, defs, ens, ps, loc, i, methodValueTy(e, defs, ens, ps, loc))

def emitListConsMethod(e: Expr, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, methodTy: String): Slot =
  emitListCons2(emitListAt(rest, prefix, strs, defs, ens, ps, loc, i + 1), emitExpr(e, Str.concat(prefix, Str.concat("_e", Str.fromInt(i))), strs, defs, ens, ps, loc), prefix, i, isI64Ty(methodTy) || exprIsI64(e, ps, defs), methodTy == "Float" || isFloatExpr(e, ps, defs), ps)

def emitListCons2(tail: Slot, elem: Slot, prefix: String, i: Int, isInt: Bool, isFloat: Bool, ps: List[Param]): Slot =
  tail match {
    case Slot(tc, tv, _) => emitListCons3(tc, tv, elem, prefix, i, isInt, isFloat, ps)
  }

def emitListCons3(tc: String, tv: String, elem: Slot, prefix: String, i: Int, isInt: Bool, isFloat: Bool, ps: List[Param]): Slot =
  elem match {
    case Slot(ec, ev, eo) => emitListCons4(join(tc, ec), tv, ev, eo || isViewParamVal(ev, ps), prefix, i, isInt, isFloat)
  }

def emitListCons4(code: String, tv: String, ev: String, eo: Bool, prefix: String, i: Int, isInt: Bool, isFloat: Bool): Slot =
  if (eo) emitListConsPtr(code, tv, ev, prefix, i) else if (isInt) emitListConsInt(code, tv, ev, prefix, i, isFloat) else emitListConsBorrow(code, tv, ev, prefix, i)

def emitListConsInt(code: String, tv: String, ev: String, prefix: String, i: Int, isFloat: Bool): Slot =
  Slot(join(code, join(emitBox(prefix, i, ev, isFloat), join(emitCons(prefix, i, pct(prefix, Str.concat("b", Str.fromInt(i))), tv), join(relPtr(tv), relPtr(pct(prefix, Str.concat("b", Str.fromInt(i)))))))), pct(prefix, Str.fromInt(i + 1)), true)

def emitListConsPtr(code: String, tv: String, ev: String, prefix: String, i: Int): Slot =
  Slot(join(code, join(emitCons(prefix, i, ev, tv), join(relPtr(tv), relPtr(ev)))), pct(prefix, Str.fromInt(i + 1)), true)

def emitListConsBorrow(code: String, tv: String, ev: String, prefix: String, i: Int): Slot =
  Slot(join(code, join(emitCons(prefix, i, ev, tv), relPtr(tv))), pct(prefix, Str.fromInt(i + 1)), true)

def emitBox(prefix: String, i: Int, ev: String, isFloat: Bool): String =
  line(Str.concat(tmp(prefix, Str.concat("b", Str.fromInt(i))), Str.concat("call ptr @", Str.concat(if (isFloat) "sz_box_float_bits" else "sz_box_i64", Str.concat("(i64 ", Str.concat(ev, ")"))))))

def emitCons(prefix: String, i: Int, hd: String, tl: String): String =
  line(Str.concat(tmp(prefix, Str.fromInt(i + 1)), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(hd, Str.concat(", ptr ", Str.concat(tl, ")"))))))

def emitArgList(args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, code: String, vals: List[String], owns: List[Bool], fid: Int): (String, List[String], List[Bool]) =
  if (List.isEmpty(args)) (code, List.reverse(vals), List.reverse(owns)) else emitArgList2(emitExprFid(List.at(args, 0), Str.concat(prefix, Str.concat("_arg", Str.fromInt(i))), strs, defs, ens, ps, loc, fid), List.tail(args), prefix, strs, defs, ens, ps, loc, i, code, vals, owns, fid + fmCountSkipLam1(List.at(args, 0)))

def emitArgList2(s: Slot, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, code: String, vals: List[String], owns: List[Bool], fid: Int): (String, List[String], List[Bool]) =
  s match {
    case Slot(sc, sv, so) => emitArgList(rest, prefix, strs, defs, ens, ps, loc, i + 1, join(code, sc), sv :: vals, so :: owns, fid)
  }

def emitCall2(f: String, p: (String, List[String], List[Bool]), prefix: String, defs: Ftab, args: List[Expr], ens: List[En], ps: List[Param], mod: String): Slot =
  p match {
    case (code, vals, owns) => if (floatOrderKit(f) && floatListArg(args, defs, ens, ps, mod)) emitFloatOrder(f, code, vals, owns, prefix) else if (f == "List.cons" && !List.isEmpty(args) && exprRetTyEns(List.at(args, 0), defs, ens, ps, mod) == "Float") emitConsCall2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix, true, true) else emitCall3(f, code, vals, owns, prefix, defs, args, ens, ps, mod)
  }

def floatOrderKit(f: String): Bool =
  f == "List.sort" || f == "List.max" || f == "List.min"

def floatListArg(args: List[Expr], defs: Ftab, ens: List[En], ps: List[Param], mod: String): Bool =
  !List.isEmpty(args) && Check.elemOf(exprRetTyEns(List.at(args, 0), defs, ens, ps, mod)) == "Float"

def emitFloatOrder(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "List.sort") emitKitUnaryPtr("sz_list_sort_float", code, vals, owns, prefix) else emitListExtreme(if (f == "List.max") "sz_list_max_float" else "sz_list_min_float", code, vals, owns, prefix, true)

def emitCall3(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, defs: Ftab, args: List[Expr], ens: List[En], ps: List[Param], mod: String): Slot =
  if (f == "IO.fail" && !List.isEmpty(args) && isI64Ty(exprRetTyEns(List.at(args, 0), defs, ens, ps, mod))) emitFailBox(code, arg0(vals), prefix, exprRetTyEns(List.at(args, 0), defs, ens, ps, mod) == "Float") else if (f == "Ref.of" && firstNeedsBox(List.at(args, 0), owns, defs, ens, ps, mod)) emitKitUnaryBox("sz_ref_of", code, arg0(vals), prefix, exprRetTyEns(List.at(args, 0), defs, ens, ps, mod) == "Float") else if ((f == "Ref.set" || f == "Queue.offer" || f == "Deferred.complete") && secondNeedsBox(List.at(args, 1), owns, defs, ens, ps, mod)) emitKitBinaryBoxB(kitBinaryPtr(f), code, arg0(vals), arg1(vals), headOwn(owns), prefix, exprRetTyEns(List.at(args, 1), defs, ens, ps, mod) == "Float") else if (f == "Stream.emit" && firstNeedsBox(List.at(args, 0), owns, defs, ens, ps, mod)) emitKitUnaryBox("sz_stream_emit", code, arg0(vals), prefix, exprRetTyEns(List.at(args, 0), defs, ens, ps, mod) == "Float") else if (f == "Stream.intersperse" && secondNeedsBox(List.at(args, 1), owns, defs, ens, ps, mod)) emitKitBinaryBoxB("sz_stream_intersperse", code, arg0(vals), arg1(vals), headOwn(owns), prefix, exprRetTyEns(List.at(args, 1), defs, ens, ps, mod) == "Float") else if (f == "Net.retryAfterMillis") emitKitPtrI64I64("sz_net_retry_after_millis", code, vals, owns, prefix) else if (isJsonExtra(f)) emitJsonExtra(f, code, vals, owns, prefix) else if (isRtExtra(f)) emitRtExtra(f, code, vals, owns, prefix) else if (isTlKit(f)) emitTlKit(f, code, vals, owns, prefix) else emitCall3b(f, code, vals, owns, prefix, defs, args, ens, ps, mod)

def isRtExtra(f: String): Bool =
  f == "IO.sleep" || f == "IO.fail" || f == "IO.timeout" || f == "IO.when" || f == "IO.unless" || f == "IO.repeatN" || f == "IO.retryN" || f == "Property.sometimes" || f == "Fuzz.hit" || f == "Stream.range" || f == "Deferred.fail"

def emitRtExtra(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "IO.sleep") emitSleep(code, vals, prefix) else if (f == "IO.fail") emitFail(code, vals, owns, prefix) else if (f == "Deferred.fail") emitDeferredFail(code, vals, owns, prefix) else if (f == "IO.timeout") emitTimeout("sz_io_timeout", code, vals, owns, prefix) else if (f == "IO.when") emitWhen("sz_io_when", code, vals, owns, prefix) else if (f == "IO.unless") emitWhen("sz_io_unless", code, vals, owns, prefix) else if (f == "IO.repeatN") emitTimeout("sz_io_repeat_n", code, vals, owns, prefix) else if (f == "IO.retryN") emitTimeout("sz_io_retry_n", code, vals, owns, prefix) else if (f == "Stream.range") emitRange(code, vals, prefix) else emitVoidStr(if (f == "Fuzz.hit") "sz_fuzz_hit" else "sz_property_sometimes", code, vals, owns)

def emitSleep(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @sz_io_sleep_ms(i64 ", Str.concat(arg0(vals), ")"))))), pct(prefix, "io"), true)

def emitFail(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitFail2(code, arg0(vals), headOwn(owns), prefix)

def emitFail2(code: String, s: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "err"), Str.concat("call ptr @sz_error_value(ptr ", Str.concat(s, ")")))), join(line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @sz_io_fail(ptr ", Str.concat(pct(prefix, "err"), ")")))), join(relPtr(pct(prefix, "err")), if (o) relPtr(s) else "")))), pct(prefix, "io"), true)

def emitFailBox(code: String, value: String, prefix: String, isFloat: Bool): Slot =
  emitFail2(join(code, boxScalarStem(value, if (isFloat) "Float" else "Int", prefix, "box")), pct(prefix, "box"), true, prefix)

def emitDeferredFail(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
