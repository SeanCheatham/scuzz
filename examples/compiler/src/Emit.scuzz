  }

def emitNetFilesKey(rt: String, code: String, pv: String, po: Bool, cv: String, co: Bool, key: Slot, lam: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  key match {
    case Slot(kc, kv, ko) => emitNetFilesLam(rt, join(code, kc), pv, po, cv, co, kv, ko, mapLamBind(lam), mapLamBody(lam), prefix, strs, defs, ens, ps, loc)
  }

def emitNetFilesLam(rt: String, code: String, pv: String, po: Bool, cv: String, co: Bool, kv: String, ko: Bool, bind: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitNetFilesCall(rt, code, pv, po, cv, co, kv, ko, emitNethGoTy(prefix, bind, body, dropParam(ps, bind), strs, defs, ens, loc, false, "(String, String, Map[String, String], String)"), emitPackEnv(ps, Str.concat(prefix, "_e")), prefix)

