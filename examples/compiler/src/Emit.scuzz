  if (f == "View.maxSize") "sz_lang_view_max_size" else if (f == "View.minSize") "sz_lang_view_min_size" else if (f == "View.sized") "sz_lang_view_sized" else if (f == "View.positioned") "sz_lang_view_positioned" else if (f == "View.aspectRatio") "sz_lang_view_aspect_ratio" else if (f == "View.fraction") "sz_lang_view_fraction" else ""

