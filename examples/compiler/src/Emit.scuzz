def emitViewPtr3(rt: String, code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, viewPtr3Call(rt, vals, prefix)), pct(prefix, "v"), true)

def viewPtr3Call(rt: String, vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(arg0(vals), Str.concat(", ptr ", Str.concat(arg1(vals), Str.concat(", ptr ", Str.concat(arg2(vals), ")"))))))))))

def emitViewSeg(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(viewSegCall(vals, prefix), join(if (headOwn(tailOwn(owns))) relPtr(arg1(vals)) else "", if (headOwn(tailOwn(tailOwn(owns)))) relPtr(arg2(vals)) else ""))), pct(prefix, "v"), true)

def viewSegCall(vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_view_segmented(ptr ", Str.concat(arg0(vals), Str.concat(", ptr ", Str.concat(arg1(vals), Str.concat(", ptr ", Str.concat(arg2(vals), ")"))))))))

def emitViewExp(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(viewExpCall(vals, prefix), if (headOwn(tailOwn(owns))) relPtr(arg1(vals)) else "")), pct(prefix, "v"), true)

def viewExpCall(vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_view_expansion_tile(ptr ", Str.concat(arg0(vals), Str.concat(", ptr ", Str.concat(arg1(vals), Str.concat(", ptr ", Str.concat(arg2(vals), ")"))))))))

def emitViewInk(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(unpackFnPtr(arg1(vals), prefix), join(inkWellCall(arg0(vals), arg2(vals), prefix), join(if (headOwn(owns)) relPtr(arg0(vals)) else "", if (headOwn(tailOwn(owns))) relPtr(arg1(vals)) else "")))), pct(prefix, "v"), true)

def inkWellCall(label: String, child: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_view_ink_well(ptr ", Str.concat(label, Str.concat(", ptr ", Str.concat(pct(prefix, "fnp"), Str.concat(", ptr ", Str.concat(pct(prefix, "envp"), Str.concat(", ptr ", Str.concat(child, ")"))))))))))

def emitViewListTile(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (List.isEmpty(List.tail(vals))) emitViewListTile1(code, vals, owns, prefix) else emitViewPtr2("sz_lang_view_list_tile", true, false, code, vals, owns, prefix)

def emitViewListTile1(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_view_list_tile(ptr ", Str.concat(arg0(vals), ", ptr null)")))), if (headOwn(owns)) relPtr(arg0(vals)) else "")), pct(prefix, "v"), true)

def emitSigListCall(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitSigListSlot(emitExpr(List.at(args, 0), Str.concat(prefix, "_l"), strs, defs, ens, ps, loc), "null", false, sigElemIsStr(List.at(args, 0), defs, ps), prefix)

def emitSigListCallN(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitSigListN2(emitExpr(List.at(args, 0), Str.concat(prefix, "_nm"), strs, defs, ens, ps, loc), List.at(List.tail(args), 0), prefix, strs, defs, ens, ps, loc)

def emitSigListN2(nm: Slot, xsE: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  nm match {
    case Slot(nc, nv, no) => emitSigListN3(nc, nv, no, emitExpr(xsE, Str.concat(prefix, "_l"), strs, defs, ens, ps, loc), sigElemIsStr(xsE, defs, ps), prefix)
  }

def emitSigListN3(nc: String, nv: String, no: Bool, xs: Slot, isStr: Bool, prefix: String): Slot =
  xs match {
    case Slot(xc, xv, xo) => emitSigListSlot2(nc, nv, no, xc, xv, xo, isStr, prefix)
  }

def emitSigListSlot(xs: Slot, nameV: String, nameO: Bool, isStr: Bool, prefix: String): Slot =
  xs match {
    case Slot(xc, xv, xo) => emitSigListSlot2(xc, nameV, nameO, "", xv, xo, isStr, prefix)
  }

def emitSigListSlot2(nc: String, nv: String, no: Bool, xc: String, xv: String, xo: Bool, isStr: Bool, prefix: String): Slot =
  Slot(join(nc, join(xc, join(sigListCallLine(xv, nv, isStr, prefix), join(if (no) relPtr(nv) else "", if (xo) relPtr(xv) else "")))), pct(prefix, "v"), false)

def sigListCallLine(xv: String, nv: String, isStr: Bool, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_signal_list(ptr ", Str.concat(xv, Str.concat(", ptr ", Str.concat(nv, Str.concat(", i64 ", Str.concat(sigElemFlag(isStr), ")"))))))))

def sigElemFlag(isStr: Bool): String =
  if (isStr) "1" else "0"

def sigElemIsStr(e: Expr, defs: List[Fun], ps: List[Param]): Bool =
  sigElemIsStrTy(listElemTy(exprRetTy(e, defs, ps)))

def sigElemIsStrTy(t: String): Bool =
  t == "String" || t == "Any" || t == ""

def emitViewEachCall(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(List.tail(args))) emitViewEach1(emitExpr(List.at(args, 0), Str.concat(prefix, "_src"), strs, defs, ens, ps, loc), prefix) else emitViewEachJoin(emitExpr(List.at(args, 0), Str.concat(prefix, "_src"), strs, defs, ens, ps, loc), List.at(List.tail(args), 0), eachElemTy(List.at(args, 0), defs, ps), prefix, strs, defs, ens, ps, loc)

def emitViewEach1(src: Slot, prefix: String): Slot =
  src match {
    case Slot(sc, sv, _) => Slot(join(sc, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_view_each(ptr ", Str.concat(sv, ")"))))), pct(prefix, "v"), true)
  }

def emitViewEachJoin(src: Slot, fn: Expr, elemTy: String, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  src match {
    case Slot(sc, sv, _) => emitViewEachJoin2(sc, sv, emitEachLamTy(fn, elemTy, Str.concat(prefix, "_fn"), strs, defs, ens, ps, loc), prefix)
  }

def emitEachLamTy(e: Expr, elemTy: String, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  e match {
    case Expr.ELam(p, _, body) => emitLam2(emitNethGoTy(prefix, p, body, dropParam(ps, p), strs, defs, ens, loc, false, eachBindTy(p, body, dropParam(ps, p), defs, elemTy)), emitPackEnv(copyPs(ps), Str.concat(prefix, "_e")), prefix)
    case _ => emitExpr(e, prefix, strs, defs, ens, ps, loc)
  }

def eachBindTy(p: String, body: Expr, rest: List[Param], defs: List[Fun], elemTy: String): String =
  if (p == "__tup" || p == "__p" || p == "_ph") nethBindTy(p, body, rest, defs) else if (elemTy != "" && elemTy != "Any") elemTy else nethBindTy(p, body, rest, defs)

def eachElemTy(e: Expr, defs: List[Fun], ps: List[Param]): String =
  eachElemOf(exprRetTy(e, defs, ps))

def eachElemOf(ty: String): String =
  if (Str.startsWith(ty, "Signal[List[") && Str.len(ty) > 14) Str.slice(ty, 12, Str.len(ty) - 2) else "String"

def emitViewEachJoin2(sc: String, sv: String, pack: Slot, prefix: String): Slot =
  pack match {
    case Slot(pc, pv, po) => Slot(join(sc, join(pc, join(unpackFnPtr(pv, prefix), join(eachMapCall(sv, prefix), if (po) relPtr(pv) else "")))), pct(prefix, "v"), true)
  }

def eachMapCall(src: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_view_each_map(ptr ", Str.concat(src, Str.concat(", ptr ", Str.concat(pct(prefix, "fnp"), Str.concat(", ptr ", Str.concat(pct(prefix, "envp"), ")"))))))))

def emitInkWellCall(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitInkWellJoin(emitExpr(List.at(args, 0), Str.concat(prefix, "_arg0"), strs, defs, ens, ps, loc), List.at(List.tail(args), 0), emitExpr(List.at(List.tail(List.tail(args)), 0), Str.concat(prefix, "_arg2"), strs, defs, ens, ps, loc), prefix, strs, defs, ens, ps, loc)

def emitInkWellJoin(lab: Slot, fn: Expr, child: Slot, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  lab match {
    case Slot(lc, lv, lo) => emitInkWellJoin1(lc, lv, lo, fn, child, prefix, strs, defs, ens, ps, loc)
  }

def emitInkWellJoin1(lc: String, lv: String, lo: Bool, fn: Expr, child: Slot, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  child match {
    case Slot(cc, cv, _) => emitInkWellJoin2(lc, lv, lo, cc, cv, emitTapLam(fn, Str.concat(prefix, "_fn"), strs, defs, ens, ps, loc), prefix)
  }

def emitInkWellJoin2(lc: String, lv: String, lo: Bool, cc: String, cv: String, pack: Slot, prefix: String): Slot =
  pack match {
    case Slot(pc, pv, po) => Slot(join(lc, join(cc, join(pc, join(unpackFnPtr(pv, prefix), join(inkWellCall(lv, cv, prefix), join(if (lo) relPtr(lv) else "", if (po) relPtr(pv) else "")))))), pct(prefix, "v"), true)
  }

def emitOracleSumTo(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_oracle_sum_to(i64 ", Str.concat(arg0(vals), ")"))))), pct(prefix, "v"), false)

def emitListRange(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_range(i64 ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), ")"))))))), pct(prefix, "v"), true)

def emitListFill(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(emitListFillCall(vals, prefix), if (headOwn(tailOwn(owns))) relPtr(arg1(vals)) else "")), pct(prefix, "v"), true)

def emitListFillCall(vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_fill(i64 ", Str.concat(arg0(vals), Str.concat(", ptr ", Str.concat(arg1(vals), ")"))))))

def emitListGetOr(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListGetOr2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(tailOwn(owns))), prefix)

def emitListGetOr2(code: String, xs: String, i: String, d: String, xsO: Bool, dO: Bool, prefix: String): Slot =
  Slot(join(code, join(emitListGetOrCall2(xs, i, d, prefix), getOrAfter(xs, d, xsO, dO, pct(prefix, "v")))), pct(prefix, "v"), xsO || dO)

def emitListGetOrCall2(xs: String, i: String, d: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_get_or(ptr ", Str.concat(xs, Str.concat(", i64 ", Str.concat(i, Str.concat(", ptr ", Str.concat(d, ")"))))))))

def getOrAfter(src: String, d: String, srcO: Bool, dO: Bool, result: String): String =
  if (srcO) join(join(retPtr(result), relPtr(src)), if (dO) relPtr(d) else "") else if (dO) join(retPtr(result), relPtr(d)) else ""

def emitListPadTo(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(emitListPadToCall(vals, prefix), join(if (headOwn(owns)) relPtr(arg0(vals)) else "", if (headOwn(tailOwn(tailOwn(owns)))) relPtr(arg2(vals)) else ""))), pct(prefix, "v"), true)

def emitListPadToCall(vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_pad_to(ptr ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), Str.concat(", ptr ", Str.concat(arg2(vals), ")"))))))))

def emitStrReplace(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(emitStrReplaceCall(vals, prefix), join(if (headOwn(owns)) relPtr(arg0(vals)) else "", join(if (headOwn(tailOwn(owns))) relPtr(arg1(vals)) else "", if (headOwn(tailOwn(tailOwn(owns)))) relPtr(arg2(vals)) else "")))), pct(prefix, "v"), true)

def emitStrReplaceCall(vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_replace(ptr ", Str.concat(arg0(vals), Str.concat(", ptr ", Str.concat(arg1(vals), Str.concat(", ptr ", Str.concat(arg2(vals), ")"))))))))

def emitStrPad(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(emitStrPadCall(rt, vals, prefix), join(if (headOwn(owns)) relPtr(arg0(vals)) else "", if (headOwn(tailOwn(tailOwn(owns)))) relPtr(arg2(vals)) else ""))), pct(prefix, "v"), true)

def emitStrPadCall(rt: String, vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), Str.concat(", ptr ", Str.concat(arg2(vals), ")"))))))))))

def emitListAsInt(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String, args: List[Expr], ps: List[Param], defs: List[Fun]): Slot =
  emitListAsInt2(rt, code, arg0(vals), headOwn(owns), prefix, listAsIntOf(args, ps, defs))

def emitListAsInt2(rt: String, code: String, v: String, o: Bool, prefix: String, asInt: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(asInt, ")")))))))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def emitListExtreme(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String, args: List[Expr], ps: List[Param], defs: List[Fun]): Slot =
  emitListExtreme2(rt, code, arg0(vals), headOwn(owns), prefix, listAsIntOf(args, ps, defs))

def emitListExtreme2(rt: String, code: String, v: String, o: Bool, prefix: String, asInt: String): Slot =
  if (asInt == "1") emitListExtremeInt(rt, code, v, o, prefix, asInt) else emitListExtremePtr(rt, code, v, o, prefix, asInt)

def emitListExtremePtr(rt: String, code: String, v: String, o: Bool, prefix: String, asInt: String): Slot =
  Slot(join(code, join(listExtremeCall(rt, v, prefix, asInt), if (o) join(retPtr(pct(prefix, "v")), relPtr(v)) else "")), pct(prefix, "v"), o)

def emitListExtremeInt(rt: String, code: String, v: String, o: Bool, prefix: String, asInt: String): Slot =
  Slot(join(code, join(listExtremeCall(rt, v, prefix, asInt), join(if (o) join(retPtr(pct(prefix, "v")), relPtr(v)) else "", join(listExtremeUnbox(prefix), if (o) relPtr(pct(prefix, "v")) else "")))), pct(prefix, "u"), false)

def listExtremeCall(rt: String, v: String, prefix: String, asInt: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(asInt, ")"))))))))

def listExtremeUnbox(prefix: String): String =
  line(Str.concat(tmp(prefix, "u"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(prefix, "v"), ")"))))

def listAsIntOf(args: List[Expr], ps: List[Param], defs: List[Fun]): String =
  if (List.isEmpty(args)) "1" else listAsIntExpr(List.at(args, 0), ps, defs)

def listAsIntExpr(e: Expr, ps: List[Param], defs: List[Fun]): String =
  e match {
    case Expr.EList(xs) => if (List.isEmpty(xs) || exprIsI64(List.at(xs, 0), ps, defs)) "1" else "0"
    case Expr.EVar(s, _) => if (paramIsI64List(ps, s)) "1" else "0"
    case _ => "0"
  }

def paramIsI64List(ps: List[Param], s: String): Bool =
  if (List.isEmpty(ps)) false else paramIsI64ListH(List.at(ps, 0), List.tail(ps), s)

def paramIsI64ListH(p: Param, rest: List[Param], s: String): Bool =
  p match {
    case Param(n, ty, _, _) => if (n == s) isI64ListTy(ty) else paramIsI64List(rest, s)
  }

def emitListToSet(code: String, vals: List[String], owns: List[Bool], prefix: String, args: List[Expr], ps: List[Param]): Slot =
  Slot(join(code, join(emitListToSetCall(arg0(vals), prefix, args, ps), if (headOwn(owns)) relPtr(arg0(vals)) else "")), pct(prefix, "v"), true)

def emitListToSetCall(v: String, prefix: String, args: List[Expr], ps: List[Param]): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_to_set(ptr ", Str.concat(v, Str.concat(", i32 ", Str.concat(listKeyKindArgs(args, ps), ")"))))))

def listKeyKindArgs(args: List[Expr], ps: List[Param]): String =
  if (headUnbox(args, ps)) "0" else "1"

def emitListSlice(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(emitListSliceCall(vals, prefix), if (headOwn(owns)) relPtr(arg0(vals)) else "")), pct(prefix, "v"), true)

def emitListSliceCall(vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_slice(ptr ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), Str.concat(", i64 ", Str.concat(arg2(vals), ")"))))))))

def emitKitPtrI64I64(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitKitPtrI64I642(rt, code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitKitPtrI64I642(rt: String, code: String, a: String, n: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(a, Str.concat(", i64 ", Str.concat(n, ")")))))))), if (o) relPtr(a) else "")), pct(prefix, "v"), false)

def emitMapSizePred(code: String, vals: List[String], owns: List[Bool], prefix: String, pred: String): Slot =
  emitMapSizePred2(code, arg0(vals), headOwn(owns), prefix, pred)

def emitMapSizePred2(code: String, v: String, o: Bool, prefix: String, pred: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "n"), Str.concat("call i64 @sz_map_size(ptr ", Str.concat(v, ")")))), join(line(Str.concat(tmp(prefix, "b"), Str.concat("icmp ", Str.concat(pred, Str.concat(" i64 ", Str.concat(pct(prefix, "n"), ", 0")))))), join(line(Str.concat(tmp(prefix, "v"), Str.concat("zext i1 ", Str.concat(pct(prefix, "b"), " to i64")))), if (o) relPtr(v) else "")))), pct(prefix, "v"), false)

def emitFloatToInt(code: String, vals: List[String], owns: List[Bool], prefix: String, ps: List[Param]): Slot =
  emitFloatToInt2(code, arg0(vals), headOwn(owns), prefix, ps)

def emitFloatToInt2(code: String, v: String, o: Bool, prefix: String, ps: List[Param]): Slot =
  if (fromIntUnbox(v, ps)) Slot(join(code, join(line(Str.concat(tmp(prefix, "fu"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(v, ")")))), join(floatToIntBits(pct(prefix, "fu"), prefix), if (o) relPtr(v) else ""))), pct(prefix, "v"), false) else Slot(join(code, floatToIntBits(v, prefix)), pct(prefix, "v"), false)

def floatToIntBits(v: String, prefix: String): String =
  join(line(Str.concat(tmp(prefix, "fd"), Str.concat("bitcast i64 ", Str.concat(v, " to double")))), line(Str.concat(tmp(prefix, "v"), Str.concat("fptosi double ", Str.concat(pct(prefix, "fd"), " to i64")))))

def emitFloatFromInt(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "ff"), Str.concat("sitofp i64 ", Str.concat(arg0(vals), " to double")))), line(Str.concat(tmp(prefix, "v"), Str.concat("bitcast double ", Str.concat(pct(prefix, "ff"), " to i64")))))), pct(prefix, "v"), false)

def emitCall(f: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (!List.isEmpty(args) && isApplyName(f, ps, defs)) emitApply(f, args, prefix, strs, defs, ens, ps, loc) else emitCallKit(f, args, prefix, strs, defs, ens, ps, loc)

def isApplyName(f: String, ps: List[Param], defs: List[Fun]): Bool =
  isApplyTy(paramTy(ps, f), f, defs)

def isApplyTy(ty: String, f: String, defs: List[Fun]): Bool =
  if (isFunTy(ty)) true else if (ty == "" || isI64Ty(ty)) false else List.isEmpty(findDef(defs, f))

def emitCallKit(f: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (f == "IO.pure") emitIoPureCall(args, prefix, strs, defs, ens, ps, loc) else if (f == "Net.serveOnce" || f == "Net.serve") emitNetServe(f, args, prefix, strs, defs, ens, ps, loc) else if (f == "Ui.run") emitUiRunCall(args, prefix, strs, defs, ens, ps, loc) else if (f == "Signal.map") emitSigMapCall(args, prefix, strs, defs, ens, ps, loc) else if (f == "Signal.mapN") emitSigMapCallN(args, prefix, strs, defs, ens, ps, loc) else if (f == "Signal.list") emitSigListCall(args, prefix, strs, defs, ens, ps, loc) else if (f == "Signal.listN") emitSigListCallN(args, prefix, strs, defs, ens, ps, loc) else if (tapViewRt(f) != "") emitTapViewCall(tapViewRt(f), args, prefix, strs, defs, ens, ps, loc) else if (f == "View.each") emitViewEachCall(args, prefix, strs, defs, ens, ps, loc) else if (f == "View.inkWell") emitInkWellCall(args, prefix, strs, defs, ens, ps, loc) else if (isMapKit(f)) emitMapKit(f, args, prefix, strs, defs, ens, ps, loc) else if (isFoldKit(f)) emitFoldKit(f, args, prefix, strs, defs, ens, ps, loc) else if (f == "Stream.iterate") emitIterKit(args, prefix, strs, defs, ens, ps, loc) else if (f == "List.tabulate") emitTabulate(args, prefix, strs, defs, ens, ps, loc) else if (f == "List.segmentLength") emitSegLen(args, prefix, strs, defs, ens, ps, loc) else emitCallKit2(f, args, prefix, strs, defs, ens, ps, loc)

def emitCallKit2(f: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (f == "Property.check") emitPropCheckCall(args, prefix, strs, defs, ens, ps, loc) else emitCall2(f, emitArgList(alignArgs(f, args, defs, modOfLoc(loc)), prefix, strs, defs, ens, ps, loc, 0, "", noStr(), noBool()), prefix, defs, alignArgs(f, args, defs, modOfLoc(loc)), ens, ps, modOfLoc(loc))

def alignArgs(f: String, args: List[Expr], defs: List[Fun], mod: String): List[Expr] =
  alignFill(funParamsOf(defs, f, mod), args)

def alignFill(ps: List[Param], args: List[Expr]): List[Expr] =
  alignFillGot(alignCall(ps, args))

def alignFillGot(p: (List[Expr], String)): List[Expr] =
  p match {
    case (xs, _) => xs
  }

def funParamsOf(defs: List[Fun], f: String, mod: String): List[Param] =
  funParamsOfHit(findDefPrefer(defs, f, mod))

def funParamsOfHit(hit: List[Fun]): List[Param] =
  if (List.isEmpty(hit)) noParam() else funParamsOfD(List.at(hit, 0))

def funParamsOfD(d: Fun): List[Param] =
  d match {
    case Fun(_, _, _, ps, _, _, _, _) => ps
  }

def emitPropCheckCall(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitPropCheckCall2(nthE(args, 0), nthE(args, 1), nthE(args, 2), prefix, strs, defs, ens, ps, loc)

def nthE(xs: List[Expr], i: Int): Expr =
  if (List.isEmpty(xs)) Expr.EUnit else if (i <= 0) List.at(xs, 0) else nthE(List.tail(xs), i - 1)

def emitPropCheckCall2(name: Expr, pred: Expr, recv: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitPropCheckJoin(emitExpr(name, Str.concat(prefix, "_n"), strs, defs, ens, ps, loc), emitExpr(recv, Str.concat(prefix, "_r"), strs, defs, ens, ps, loc), pred, recv, prefix, strs, defs, ens, ps, loc)

def emitPropCheckJoin(ns: Slot, rs: Slot, pred: Expr, recv: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  ns match {
    case Slot(nc, nv, no) => emitPropCheckJoin2(nc, nv, no, rs, pred, recv, prefix, strs, defs, ens, ps, loc)
  }

def emitPropCheckJoin2(nc: String, nv: String, no: Bool, rs: Slot, pred: Expr, recv: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  rs match {
    case Slot(rc, rv, ro) => emitPropCheckPred(join(nc, join(rc, if (ro && exprMentions(pred, recv)) retPtr(rv) else "")), nv, no, rv, ro, emitExpr(pred, Str.concat(prefix, "_p"), strs, defs, ens, ps, loc))
  }

def emitPropCheckPred(code: String, nv: String, no: Bool, rv: String, ro: Bool, pred: Slot): Slot =
  pred match {
    case Slot(pc, pv, _) => Slot(join(code, join(pc, join(line(Str.concat("call void @sz_property_check(ptr ", Str.concat(nv, Str.concat(", i64 ", Str.concat(pv, ")"))))), if (no) relPtr(nv) else ""))), rv, ro)
  }

def exprMentions(e: Expr, recv: Expr): Bool =
  recv match {
    case Expr.EVar(s, _) => exprHasVar(e, s)
    case _ => false
  }

def exprHasVar(e: Expr, s: String): Bool =
  e match {
    case Expr.EVar(n, _) => n == s
    case Expr.EPrint(inner, _) => exprHasVar(inner, s)
    case Expr.ECall(_, args, _) => listHasVar(args, s)
    case Expr.EMethod(recv, _, args, _) => exprHasVar(recv, s) || listHasVar(args, s)
    case Expr.EField(recv, _, _) => exprHasVar(recv, s)
    case Expr.EBin(_, l, r, _) => exprHasVar(l, s) || exprHasVar(r, s)
    case Expr.EUn(_, inner, _) => exprHasVar(inner, s)
    case Expr.ELam(_, _, body) => exprHasVar(body, s)
    case Expr.EIf(c, t, el, _) => exprHasVar(c, s) || exprHasVar(t, s) || exprHasVar(el, s)
    case Expr.EMatch(sc, arms, _) => exprHasVar(sc, s) || armsHasVar(arms, s)
    case Expr.EList(xs) => listHasVar(xs, s)
    case Expr.ETuple(xs) => listHasVar(xs, s)
    case Expr.ENamed(_, inner) => exprHasVar(inner, s)
    case Expr.EAscribe(inner, _, _) => exprHasVar(inner, s)
    case Expr.EFor(bs, body, _) => bindsHasVar(bs, s) || exprHasVar(body, s)
    case _ => false
  }

def listHasVar(xs: List[Expr], s: String): Bool =
  !List.isEmpty(xs) && (exprHasVar(List.at(xs, 0), s) || listHasVar(List.tail(xs), s))

def armsHasVar(xs: List[Arm], s: String): Bool =
  !List.isEmpty(xs) && armsHasVar1(List.at(xs, 0), List.tail(xs), s)

def armsHasVar1(a: Arm, rest: List[Arm], s: String): Bool =
  a match {
    case Arm(_, _, body) => exprHasVar(body, s) || armsHasVar(rest, s)
  }

def bindsHasVar(xs: List[Bind], s: String): Bool =
  !List.isEmpty(xs) && bindsHasVar1(List.at(xs, 0), List.tail(xs), s)

def bindsHasVar1(b: Bind, rest: List[Bind], s: String): Bool =
  b match {
    case Bind(_, _, value) => exprHasVar(value, s) || bindsHasVar(rest, s)
  }

def emitUiRunCall(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitUiRunPack(emitUiRunLam(List.at(args, 0), Str.concat(prefix, "_fn"), strs, defs, ens, ps, loc), prefix)

def emitUiRunLam(e: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  e match {
    case Expr.ELam(p, _, body) => emitLam2(emitRebuildNeth(prefix, p, body, strs, defs, ens, ps, loc), emitPackEnv(copyPs(ps), Str.concat(prefix, "_e")), prefix)
    case _ => emitExpr(e, prefix, strs, defs, ens, ps, loc)
  }

def emitUiRunPack(pack: Slot, prefix: String): Slot =
  pack match {
    case Slot(pc, pv, po) => Slot(join(pc, join(unpackFnPtr(pv, prefix), join(uiRunCall(prefix), if (po) relPtr(pv) else ""))), pct(prefix, "v"), false)
  }

def emitSigMapCall(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitSigMapJoin(emitExpr(List.at(args, 0), Str.concat(prefix, "_src"), strs, defs, ens, ps, loc), List.at(List.tail(args), 0), prefix, strs, defs, ens, ps, loc)

def emitSigMapCallN(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitSigMapJoinN(emitExpr(List.at(args, 0), Str.concat(prefix, "_nm"), strs, defs, ens, ps, loc), emitExpr(List.at(List.tail(args), 0), Str.concat(prefix, "_src"), strs, defs, ens, ps, loc), List.at(List.tail(List.tail(args)), 0), prefix, strs, defs, ens, ps, loc)

def emitSigMapJoinN(nm: Slot, src: Slot, fn: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  nm match {
    case Slot(nc, nv, no) => src match {
  case Slot(sc, sv, _) => emitSigMapJoinN2(nc, nv, no, sc, sv, emitSigMapLam(fn, Str.concat(prefix, "_fn"), strs, defs, ens, ps, loc), prefix)
}
  }

def emitSigMapJoinN2(nc: String, nv: String, no: Bool, sc: String, sv: String, pack: Slot, prefix: String): Slot =
  pack match {
    case Slot(pc, pv, po) => Slot(join(nc, join(sc, join(pc, join(unpackFnPtr(pv, prefix), join(sigMapCallN(sv, nv, prefix), join(if (po) relPtr(pv) else "", if (no) relPtr(nv) else "")))))), pct(prefix, "v"), false)
  }

def emitSigMapJoin(src: Slot, fn: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  src match {
    case Slot(sc, sv, _) => emitSigMapJoin2(sc, sv, emitSigMapLam(fn, Str.concat(prefix, "_fn"), strs, defs, ens, ps, loc), prefix)
  }

def emitSigMapLam(e: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  e match {
    case Expr.ELam(p, _, body) => emitLam2(emitMapNeth(prefix, p, body, strs, defs, ens, ps, loc), emitPackEnv(copyPs(ps), Str.concat(prefix, "_e")), prefix)
    case _ => emitExpr(e, prefix, strs, defs, ens, ps, loc)
  }

def emitSigMapJoin2(sc: String, sv: String, pack: Slot, prefix: String): Slot =
  pack match {
    case Slot(pc, pv, po) => Slot(join(sc, join(pc, join(unpackFnPtr(pv, prefix), join(sigMapCall(sv, prefix), if (po) relPtr(pv) else "")))), pct(prefix, "v"), false)
  }

def emitTapViewCall(rt: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitTapViewJoin(rt, emitExpr(List.at(args, 0), Str.concat(prefix, "_arg0"), strs, defs, ens, ps, loc), List.at(List.tail(args), 0), prefix, strs, defs, ens, ps, loc)

def emitTapViewJoin(rt: String, lab: Slot, fn: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  lab match {
    case Slot(lc, lv, lo) => emitTapViewJoin2(rt, lc, lv, lo, emitTapLam(fn, Str.concat(prefix, "_fn"), strs, defs, ens, ps, loc), prefix)
  }

def emitTapLam(e: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  e match {
    case Expr.ELam(p, _, body) => emitLam2(emitTapNeth(prefix, p, body, strs, defs, ens, ps, loc), emitPackEnv(copyPs(ps), Str.concat(prefix, "_e")), prefix)
    case _ => emitExpr(e, prefix, strs, defs, ens, ps, loc)
  }

def emitTapViewJoin2(rt: String, lc: String, lv: String, lo: Bool, pack: Slot, prefix: String): Slot =
  pack match {
    case Slot(pc, pv, po) => Slot(join(lc, join(pc, join(unpackFnPtr(pv, prefix), join(viewTapPtr(rt, lv, prefix), join(if (lo) relPtr(lv) else "", if (po) relPtr(pv) else ""))))), pct(prefix, "v"), true)
  }

def isFunTy(t: String): Bool =
  hasSub(t, "=>")

def emitApply(f: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.len(args) == 1) emitApply1(paramTy(ps, f), emitExpr(List.at(args, 0), Str.concat(prefix, "_a0"), strs, defs, ens, ps, loc), f, prefix) else emitApply1(paramTy(ps, f), emitTuple(args, prefix, strs, defs, ens, ps, loc), f, prefix)

def emitApply1(ty: String, arg: Slot, f: String, prefix: String): Slot =
  arg match {
    case Slot(ac, av, ao) => emitApplyK(funBoxUnbox(ty), ac, av, ao, f, prefix)
  }

def funBoxUnbox(t: String): Int =
  if (t == "Any" || t == "") 3 else if (Str.startsWith(t, "Int =>")) funBoxUnboxInt(t) else if (Str.startsWith(t, "Bool =>")) funBoxUnboxInt(t) else funBoxUnboxPtr(t)

def funBoxUnboxInt(t: String): Int =
  if (endsRetI64(t)) 3 else 1

def funBoxUnboxPtr(t: String): Int =
  if (endsRetI64(t)) 2 else 0

def endsRetI64(t: String): Bool =
  if (hasSub(t, "=> Int")) true else hasSub(t, "=> Bool")

def emitApplyK(k: Int, ac: String, av: String, ao: Bool, f: String, prefix: String): Slot =
  emitApply3(k == 1 || k == 3, k == 2 || k == 3, ac, av, ao, f, prefix)

def emitApply3(boxArg: Bool, unbox: Bool, ac: String, av: String, ao: Bool, f: String, prefix: String): Slot =
  emitApply4(boxArg || needBoxApply(av, ao), unbox, join(ac, join(unpackFn(f, prefix), applyBox(boxArg || needBoxApply(av, ao), av, prefix))), av, ao, prefix)

def unpackFn(f: String, prefix: String): String =
  unpackFnPtr(Str.concat("%", f), prefix)

def unpackFnPtr(pack: String, prefix: String): String =
  if (isFnPack(pack)) unpackFnPtr2(pack, prefix) else ""

def unpackFnPtr2(pack: String, prefix: String): String =
  join(line(Str.concat(tmp(prefix, "fnp"), Str.concat("call ptr @sz_list_head(ptr ", Str.concat(pack, ")")))), join(line(Str.concat(tmp(prefix, "fnt"), Str.concat("call ptr @sz_list_tail(ptr ", Str.concat(pack, ")")))), line(Str.concat(tmp(prefix, "envp"), Str.concat("call ptr @sz_list_head(ptr ", Str.concat(pct(prefix, "fnt"), ")"))))))

def applyBox(boxArg: Bool, av: String, prefix: String): String =
  if (boxArg) line(Str.concat(tmp(prefix, "ab"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(av, ")")))) else ""

def emitApply4(boxArg: Bool, unbox: Bool, code: String, av: String, ao: Bool, prefix: String): Slot =
  emitApply5(unbox, join(code, join(applyCall(boxArg, av, prefix), applyDrop(boxArg, av, ao, prefix))), prefix)

def applyCall(boxArg: Bool, av: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr ", Str.concat(pct(prefix, "fnp"), Str.concat("(ptr ", Str.concat(if (boxArg) pct(prefix, "ab") else av, Str.concat(", ptr ", Str.concat(pct(prefix, "envp"), ")"))))))))

def applyDrop(boxArg: Bool, av: String, ao: Bool, prefix: String): String =
  if (boxArg) relPtr(pct(prefix, "ab")) else if (ao) relPtr(av) else ""

def emitApply5(unbox: Bool, code: String, prefix: String): Slot =
  if (unbox) Slot(join(code, join(line(Str.concat(tmp(prefix, "u"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(prefix, "v"), ")")))), relPtr(pct(prefix, "v")))), pct(prefix, "u"), false) else Slot(code, pct(prefix, "v"), true)

def emitApplyRecv(recv: Expr, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  recv match {
    case Expr.ELam(p, _, body) => emitApplyLam(p, body, args, prefix, strs, defs, ens, ps, loc, fid)
    case Expr.EMatch(_, arms, _) => emitMatch(applyScrut(args), arms, prefix, strs, defs, ens, ps, loc)
    case _ => emitApplyRecvTy(funTyRecv(recv, defs, ps), recv, args, prefix, strs, defs, ens, ps, loc)
  }

def applyScrut(args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EUnit else if (List.isEmpty(List.tail(args))) List.at(args, 0) else Expr.ETuple(args)

def emitApplyLam(p: String, body: Expr, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitApplyLamGo(p, body, applyScrut(args), prefix, strs, defs, ens, ps, loc, fid)

def emitApplyLamGo(p: String, body: Expr, argE: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitApplyLamSlot(p, body, emitExprFid(argE, Str.concat(prefix, "_aa"), strs, defs, ens, ps, loc, fid), argE, prefix, strs, defs, ens, ps, loc, fid)

def emitApplyLamSlot(p: String, body: Expr, arg: Slot, argE: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitApplyLam2(p, body, arg, slotBindI64(arg, argE, ps, defs), if (slotBindI64(arg, argE, ps, defs)) "Int" else applyBindTy(p, argE, defs, ps), prefix, strs, defs, ens, ps, loc, fid)

def slotBindI64(s: Slot, e: Expr, ps: List[Param], defs: List[Fun]): Bool =
  s match {
    case Slot(_, v, _) => exprIsI64(e, ps, defs) || isI64Lit(v) || hasSub(v, "_u") || hasSub(v, "_tv") || hasSub(v, "_ic_v") || hasDigitStem(v, "_b")
  }

def applyBindTy(p: String, argE: Expr, defs: List[Fun], ps: List[Param]): String =
  if (p == "__tup") "(Any, Any)" else applyBindTyHit(exprRetTy(argE, defs, ps), argE)

def applyBindTyHit(ty: String, argE: Expr): String =
  if (ty != "" && ty != "Any") ty else ctorTyOf(argE)

def ctorTyOf(e: Expr): String =
  e match {
    case Expr.ECall(f, _, _) => if (isCtorName(f)) f else "Any"
    case Expr.EVar(s, _) => if (isCtorName(s)) s else "Any"
    case _ => "Any"
  }

def exprRetTy(e: Expr, defs: List[Fun], ps: List[Param]): String =
  e match {
    case Expr.ECall(f, args, _) => exprCallTy(callRetTy(f, funRetStr(defs, f), args, defs, ps), f, e, defs, ps)
    case Expr.EMethod(r, name, _, _) => nonemptyTy(funRetStr(defs, qualRecv(r, name)), e, defs, ps)
    case Expr.EVar(s, _) => nonemptyTy(paramTy(ps, s), e, defs, ps)
    case Expr.ETuple(xs) => tupExprTy(xs, defs, ps)
    case Expr.EList(xs) => listLitTy(xs, defs, ps)
    case Expr.EIf(_, t, _, _) => exprRetTy(t, defs, ps)
    case Expr.EMatch(_, arms, _) => exprRetTyMatch(arms, defs, ps)
    case Expr.EInt(_, _) => "Int"
    case Expr.EBool(_) => "Bool"
    case Expr.EStr(_, _) => "String"
    case Expr.EInterp(_) => "String"
    case _ => if (exprIsI64(e, ps, defs)) "Int" else "Any"
  }

def exprRetTyMatch(arms: List[Arm], defs: List[Fun], ps: List[Param]): String =
  if (List.isEmpty(arms)) "Any" else exprRetTyMatch1(List.at(arms, 0), defs, ps)

def exprRetTyMatch1(a: Arm, defs: List[Fun], ps: List[Param]): String =
  a match {
    case Arm(_, _, body) => exprRetTy(body, defs, ps)
  }

def tupExprTy(xs: List[Expr], defs: List[Fun], ps: List[Param]): String =
  if (List.isEmpty(xs)) "()" else Str.concat("(", Str.concat(tupExprSlots(xs, defs, ps), ")"))

def tupExprSlots(xs: List[Expr], defs: List[Fun], ps: List[Param]): String =
  if (List.isEmpty(xs)) "" else tupExprSlots1(List.at(xs, 0), List.tail(xs), defs, ps)

def tupExprSlots1(h: Expr, rest: List[Expr], defs: List[Fun], ps: List[Param]): String =
  if (List.isEmpty(rest)) exprRetTy(h, defs, ps) else Str.concat(exprRetTy(h, defs, ps), Str.concat(", ", tupExprSlots(rest, defs, ps)))

def nonemptyTy(ty: String, e: Expr, defs: List[Fun], ps: List[Param]): String =
  if (ty != "" && !isTyParam(ty)) ty else if (exprIsI64(e, ps, defs)) "Int" else "Any"

def callRetTy(f: String, ret: String, args: List[Expr], defs: List[Fun], ps: List[Param]): String =
  if (f == "swap" && !List.isEmpty(args)) softenTup(flipTupTy(exprRetTy(List.at(args, 0), defs, ps))) else if (f == "Signal.list" && !List.isEmpty(args)) sigListWrap(exprRetTy(List.at(args, 0), defs, ps)) else if (f == "Signal.listN" && !List.isEmpty(List.tail(args))) sigListWrap(exprRetTy(List.at(List.tail(args), 0), defs, ps)) else if (f == "Signal.getList" && !List.isEmpty(args)) sigListUnwrap(exprRetTy(List.at(args, 0), defs, ps)) else ret

def exprCallTy(ty: String, f: String, e: Expr, defs: List[Fun], ps: List[Param]): String =
  if (ty == "" && isCtorName(f)) f else nonemptyTy(ty, e, defs, ps)

def listLitTy(xs: List[Expr], defs: List[Fun], ps: List[Param]): String =
  if (List.isEmpty(xs)) "" else listLitWrap(exprRetTy(List.at(xs, 0), defs, ps))

def listLitWrap(t: String): String =
  if (t == "" || t == "Any") "" else Str.concat("List[", Str.concat(t, "]"))

def sigListWrap(ty: String): String =
  if (Str.startsWith(ty, "List[")) Str.concat("Signal[", Str.concat(ty, "]")) else ""

def sigListUnwrap(ty: String): String =
  if (Str.startsWith(ty, "Signal[List[") && Str.len(ty) > 14) Str.slice(ty, 7, Str.len(ty) - 1) else ""

def softenTup(ty: String): String =
  if (!isTupTy(ty)) ty else if (tupIsConcrete(tupSlots(ty))) ty else "Any"

def tupIsConcrete(xs: List[String]): Bool =
  if (List.isEmpty(xs)) true else isConcreteSlot(List.at(xs, 0)) && tupIsConcrete(List.tail(xs))

def isConcreteSlot(t: String): Bool =
  t == "Int" || t == "String" || t == "Bool" || t == "Float" || Str.len(t) > 1 && t != "Any" && !isTyParam(t)

def flipTupTy(ty: String): String =
  if (!isTupTy(ty)) ty else flipTupSlots(tupSlots(ty))

def flipTupSlots(xs: List[String]): String =
  if (List.len(xs) != 2) "" else Str.concat("(", Str.concat(List.at(List.tail(xs), 0), Str.concat(", ", Str.concat(List.at(xs, 0), ")"))))

def emitApplyLam2(p: String, body: Expr, arg: Slot, boxInt: Bool, bty: String, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  arg match {
    case Slot(ac, av, _) => emitApplyLam3(p, body, ac, av, boxInt, bty, prefix, strs, defs, ens, ps, loc, fid)
  }

def emitApplyLam3(p: String, body: Expr, ac: String, av: String, boxInt: Bool, bty: String, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  if (keepBind(p)) emitApplyLamShadow(shadowBind(p, prefix, ps), p, body, ac, av, boxInt, bty, prefix, strs, defs, ens, ps, loc, fid) else emitApplyLamSkip(ac, emitExprFid(body, Str.concat(prefix, "_l"), strs, defs, ens, ps, loc, fid))

def shadowBind(p: String, prefix: String, ps: List[Param]): String =
  if (paramKnown(ps, p)) Str.concat("_", Str.concat(prefix, Str.concat("_", p))) else p

def emitApplyLamShadow(fresh: String, p: String, body: Expr, ac: String, av: String, boxInt: Bool, bty: String, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitApplyLam4(ac, emitExprFid(if (fresh == p) body else rewriteBind(body, p, fresh), Str.concat(prefix, "_l"), strs, defs, ens, Param(fresh, if (boxInt) "Int" else bty, "", "") :: dropParam(ps, p), loc, fid), av, fresh, boxInt)

def emitApplyLamSkip(ac: String, s: Slot): Slot =
  s match {
    case Slot(bc, bv, bo) => Slot(join(ac, bc), bv, bo)
  }

def emitApplyLam4(ac: String, s: Slot, av: String, p: String, boxInt: Bool): Slot =
  s match {
    case Slot(bc, bv, bo) => Slot(join(ac, join(bindAliasTy(p, av, boxInt), bc)), bv, bo)
  }

def bindAliasTy(p: String, av: String, boxInt: Bool): String =
  if (boxInt) line(Str.concat("%", Str.concat(p, Str.concat(" = add i64 ", Str.concat(av, ", 0"))))) else bindAlias(p, av)

def bindAlias(p: String, av: String): String =
  line(Str.concat("%", Str.concat(p, Str.concat(" = bitcast ptr ", Str.concat(av, " to ptr")))))

def funTyRecv(recv: Expr, defs: List[Fun], ps: List[Param]): String =
  recv match {
    case Expr.EVar(s, _) => funTyVar(s, defs, ps)
    case Expr.ECall(f, _, _) => funRetStr(defs, f)
    case Expr.ELam(p, _, _) => if (p == "__tup") "(Any, Any) => Int" else "Int => Int"
    case _ => "Any"
  }

def funTyVar(s: String, defs: List[Fun], ps: List[Param]): String =
  funTyVar2(paramTy(ps, s), s, defs)

def funTyVar2(ty: String, s: String, defs: List[Fun]): String =
  if (isFunTy(ty)) ty else if (ty != "") "Any" else funRetStr(defs, s)

def emitApplyRecvTy(ty: String, recv: Expr, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitApplyRecvFn(emitExpr(recv, Str.concat(prefix, "_fn"), strs, defs, ens, ps, loc), args, ty, prefix, strs, defs, ens, ps, loc)

def emitApplyRecvFn(fn: Slot, args: List[Expr], ty: String, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.len(args) == 1) emitApplyRecvArg(fn, emitExpr(List.at(args, 0), Str.concat(prefix, "_a0"), strs, defs, ens, ps, loc), ty, prefix) else emitApplyRecvArg(fn, emitTuple(args, prefix, strs, defs, ens, ps, loc), ty, prefix)

def emitApplyRecvArg(fn: Slot, arg: Slot, ty: String, prefix: String): Slot =
  fn match {
    case Slot(fc, fv, fo) => arg match {
  case Slot(ac, av, ao) => emitApplyRecvK(funBoxUnbox(ty), join(fc, ac), fv, fo, av, ao, prefix)
}
  }

def emitApplyRecvK(k: Int, code: String, fv: String, fo: Bool, av: String, ao: Bool, prefix: String): Slot =
  if (isFnPack(fv)) emitApplyRecv3(k == 1 || k == 3, k == 2 || k == 3, code, fv, fo, av, ao, prefix) else Slot(code, fv, fo)

def isFnPack(v: String): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37

def emitApplyRecv3(boxArg: Bool, unbox: Bool, code: String, fv: String, fo: Bool, av: String, ao: Bool, prefix: String): Slot =
  emitApplyRecv4(unbox, join(code, join(unpackFnPtr(fv, prefix), applyBox(boxArg || needBoxApply(av, ao), av, prefix))), boxArg || needBoxApply(av, ao), av, ao, fv, fo, prefix)

def needBoxApply(av: String, ao: Bool): Bool =
  !ao && (isI64Lit(av) || isIntSsa(av))

def emitApplyRecv4(unbox: Bool, code: String, boxArg: Bool, av: String, ao: Bool, fv: String, fo: Bool, prefix: String): Slot =
  emitApplyRecv5(unbox, join(code, join(applyCall(boxArg, av, prefix), join(applyDrop(boxArg, av, ao, prefix), if (fo) relPtr(fv) else ""))), prefix)

def emitApplyRecv5(unbox: Bool, code: String, prefix: String): Slot =
  emitApply5(unbox, code, prefix)

def emitIoPureCall(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(args)) emitIoPure2("", "null", false, prefix, ps) else emitIoPureFrom(emitExpr(List.at(args, 0), Str.concat(prefix, "_p"), strs, defs, ens, ps, loc), List.at(args, 0), prefix, ps, defs)

def emitIoPureFrom(s: Slot, e: Expr, prefix: String, ps: List[Param], defs: List[Fun]): Slot =
  s match {
    case Slot(code, v, o) => emitIoPurePick(code, v, o, prefix, ps, exprIsI64(e, ps, defs))
  }

def emitIoPurePick(code: String, v: String, o: Bool, prefix: String, ps: List[Param], i64: Bool): Slot =
  if (o || v == "null" || !i64 && (isPtrSlot(v, ps) || ioPureSsa(v))) emitIoPurePtr(code, v, o, prefix) else emitIoPureI64(code, v, prefix)

def ioPureSsa(v: String): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37 && !hasSub(v, "_u")

def emitConcat(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitConcat2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitConcat2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(emitConcatCall(prefix, a, b), emitConcatRel(a, b, oa, ob))), pct(prefix, "v"), true)

def emitConcatCall(prefix: String, a: String, b: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_concat(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))

def emitConcatRel(a: String, b: String, oa: Bool, ob: Bool): String =
  join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else "")

def relPtr(p: String): String =
  line(Str.concat("call void @sz_release(ptr ", Str.concat(p, ")")))

def arg0(vals: List[String]): String =
  nthStrD(vals, 0, "null")

def arg1(vals: List[String]): String =
  nthStrD(vals, 1, "null")

def arg2(vals: List[String]): String =
  nthStrD(vals, 2, "0")

def nthStrD(xs: List[String], i: Int, d: String): String =
  if (List.isEmpty(xs)) d else nthStr1(List.at(xs, 0), List.tail(xs), i)

def nthStr1(h: String, rest: List[String], i: Int): String =
  if (i <= 0) h else nthStrD(rest, i - 1, "null")

def emitListLen(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListLen2(code, arg0(vals), headOwn(owns), prefix)

def emitListLen2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_list_len(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def emitListCat(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListCat2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitListCat2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(emitListCatCall(prefix, a, b), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), true)

def emitListCatCall(prefix: String, a: String, b: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_concat(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))

def emitListRev(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListRev2(code, arg0(vals), headOwn(owns), prefix)

def emitListRev2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_reverse(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def kitUnaryPtr(f: String): String =
  kitUnaryPtrHit(kitUnaryPtrA(f), f)

def kitUnaryPtrHit(a: String, f: String): String =
  if (a != "") a else kitUnaryPtrB(f)

def kitUnaryPtrA(f: String): String =
  if (f == "List.init") "sz_list_init" else if (f == "List.last") "sz_list_last" else if (f == "List.flatten") "sz_list_flatten" else if (f == "List.distinct") "sz_list_distinct" else if (f == "List.indices") "sz_list_indices" else if (f == "List.inits") "sz_list_inits" else if (f == "List.tails") "sz_list_tails" else if (f == "List.transpose") "sz_list_transpose" else if (f == "List.zipWithIndex") "sz_list_zip_with_index" else if (f == "List.toMap") "sz_list_to_map" else if (f == "List.unzip") "sz_list_unzip" else if (f == "Map.keys" || f == "Set.toList") "sz_map_keys" else if (f == "Map.values") "sz_map_values" else if (f == "Map.toList") "sz_map_to_list" else if (f == "Json.keys") "sz_json_keys" else if (f == "Json.parse") "sz_json_parse" else if (f == "Json.stringify") "sz_json_stringify" else if (f == "Json.arr") "sz_json_arr" else if (f == "Json.pairs") "sz_json_pairs" else if (f == "Json.asInt") "sz_json_as_int" else if (f == "Json.asBool") "sz_json_as_bool" else if (f == "Json.asStr") "sz_json_as_str" else if (f == "Json.asFloat") "sz_json_as_float" else if (f == "Str.lines") "sz_string_lines" else if (f == "Str.trim") "sz_string_trim" else if (f == "Str.toLower") "sz_string_to_lower" else if (f == "Str.toUpper") "sz_string_to_upper" else if (f == "Str.capitalize") "sz_string_capitalize" else if (f == "Str.reverse") "sz_string_ureverse" else ""

def kitUnaryPtrB(f: String): String =
  if (f == "Fs.basename") "sz_fs_basename" else if (f == "Fs.dirname") "sz_fs_dirname" else if (f == "Ref.of") "sz_ref_of" else if (f == "Ref.get") "sz_ref_get" else if (f == "Queue.take") "sz_queue_take" else if (f == "Deferred.get") "sz_deferred_get" else if (f == "Fiber.fork") "sz_fiber_fork" else if (f == "Fiber.join") "sz_fiber_join" else if (f == "Fiber.interrupt") "sz_fiber_interrupt" else if (f == "Net.httpGet" || f == "Net.httpDelete" || f == "Net.httpHead") netHttpUnaryRt(f) else if (f == "Stream.emit") "sz_stream_emit" else if (f == "Stream.emits") "sz_stream_emits" else if (f == "Stream.eval") "sz_stream_eval" else if (f == "Stream.compileToList") "sz_stream_compile_to_list" else if (f == "Stream.drain") "sz_stream_drain" else if (f == "Stream.head") "sz_stream_head" else if (f == "Stream.last") "sz_stream_last" else if (f == "Stream.count") "sz_stream_count" else if (f == "Stream.zipWithIndex") "sz_stream_zip_with_index" else if (f == "Stream.flatten") "sz_stream_flatten" else if (f == "Stream.changes") "sz_stream_changes" else if (f == "IO.forever") "sz_io_forever" else ""

def netHttpUnaryRt(f: String): String =
  if (f == "Net.httpDelete") "sz_net_http_delete" else if (f == "Net.httpHead") "sz_net_http_head" else "sz_net_http_get"

def kitUnaryI64(f: String): String =
  if (f == "Map.size" || f == "Set.size") "sz_map_size" else if (f == "Json.isNull") "sz_json_is_null" else if (f == "Json.isObj") "sz_json_is_obj" else if (f == "Json.isArr") "sz_json_is_arr" else if (f == "Json.isBool") "sz_json_is_bool" else if (f == "Json.isInt") "sz_json_is_int" else if (f == "Json.isStr") "sz_json_is_str" else if (f == "Json.isFloat") "sz_json_is_float" else if (f == "List.sum") "sz_list_sum" else if (f == "List.product") "sz_list_product" else if (f == "List.nonEmpty") "sz_list_non_empty" else if (f == "Str.isEmpty") "sz_string_is_empty" else if (f == "Str.nonEmpty") "sz_string_non_empty" else if (f == "Str.isBlank") "sz_string_is_blank" else ""

def kitPtrI64(f: String): String =
  if (f == "List.take") "sz_list_take" else if (f == "List.drop") "sz_list_drop" else if (f == "List.takeRight") "sz_list_take_right" else if (f == "List.dropRight") "sz_list_drop_right" else if (f == "List.splitAt") "sz_list_split_at" else if (f == "List.grouped") "sz_list_grouped" else if (f == "List.sliding") "sz_list_sliding" else if (f == "Str.take") "sz_string_utake" else if (f == "Str.drop") "sz_string_udrop" else if (f == "Str.takeRight") "sz_string_utake_right" else if (f == "Str.dropRight") "sz_string_udrop_right" else if (f == "Json.at") "sz_json_at" else if (f == "Json.dropAt") "sz_json_drop_at" else if (f == "Stream.take") "sz_stream_take" else if (f == "Stream.drop") "sz_stream_drop" else if (f == "Stream.repeatN") "sz_stream_repeat_n" else if (f == "Stream.grouped") "sz_stream_grouped" else if (f == "Stream.takeRight") "sz_stream_take_right" else if (f == "Stream.dropRight") "sz_stream_drop_right" else if (f == "Stream.sliding") "sz_stream_sliding" else ""

def kitBinaryPtr(f: String): String =
  if (f == "Json.get") "sz_json_get" else if (f == "Json.merge") "sz_json_merge" else if (f == "Json.remove") "sz_json_remove" else if (f == "Json.append") "sz_json_append" else if (f == "Json.prepend") "sz_json_prepend" else if (f == "Set.union") "sz_set_union" else if (f == "Set.intersect") "sz_set_intersect" else if (f == "Set.diff") "sz_set_diff" else if (f == "Map.union") "sz_map_union" else if (f == "Map.intersect") "sz_map_intersect" else if (f == "Map.diff") "sz_map_diff" else if (f == "Map.remove" || f == "Set.remove") "sz_map_remove" else if (f == "Map.get") "sz_map_get" else kitBinaryPtrB(f)

def kitBinaryPtrB(f: String): String =
  if (f == "IO.both") "sz_io_both" else if (f == "IO.race") "sz_io_race" else if (f == "IO.ensure") "sz_io_ensure" else if (f == "Ref.set") "sz_ref_set" else if (f == "Queue.offer") "sz_queue_offer" else if (f == "Deferred.complete") "sz_deferred_complete" else if (f == "Stream.concat") "sz_stream_concat" else if (f == "Stream.zip") "sz_stream_zip" else if (f == "Stream.interleave") "sz_stream_interleave" else if (f == "Stream.orElse") "sz_stream_or_else" else if (f == "Stream.intersperse") "sz_stream_intersperse" else if (f == "List.interleave") "sz_list_interleave" else if (f == "List.append") "sz_list_append" else if (f == "List.zip") "sz_list_zip" else if (f == "List.intersperse") "sz_list_intersperse" else if (f == "List.diff") "sz_list_diff" else if (f == "List.intersect") "sz_list_intersect" else if (f == "Str.split") "sz_string_split" else if (f == "Str.stripPrefix") "sz_string_strip_prefix" else if (f == "Str.stripSuffix") "sz_string_strip_suffix" else if (f == "Fs.join") "sz_fs_join" else ""

def kitBinaryI64(f: String): String =
  if (f == "Map.contains" || f == "Set.contains") "sz_map_contains" else if (f == "Json.has") "sz_json_has" else if (f == "Str.contains") "sz_string_contains" else if (f == "Str.endsWith") "sz_string_ends_with" else if (f == "Str.indexOf") "sz_string_uindex_of" else if (f == "Str.lastIndexOf") "sz_string_ulast_index_of" else if (f == "Set.isSubset") "sz_set_is_subset" else if (f == "Set.isDisjoint") "sz_set_is_disjoint" else if (f == "List.contains") "sz_list_contains" else if (f == "List.indexOf") "sz_list_index_of" else if (f == "List.lastIndexOf") "sz_list_last_index_of" else if (f == "List.indexOfSlice") "sz_list_index_of_slice" else if (f == "List.lastIndexOfSlice") "sz_list_last_index_of_slice" else ""

def emitKitUnaryPtr(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitKitUnaryPtr2(rt, code, arg0(vals), headOwn(owns), prefix)

def emitKitUnaryPtr2(rt: String, code: String, v: String, o: Bool, prefix: String): Slot =
  if (kitBoxVal(v, o)) emitKitUnaryBox(rt, code, v, prefix) else emitKitUnaryPtr3(rt, code, v, o, prefix)

def emitKitUnaryPtr3(rt: String, code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(kitCallPtr1(rt, v, prefix), kitUnaryRel(rt, v, o))), pct(prefix, "v"), true)

def kitKeepUnaryArg(rt: String): Bool =
  rt == "sz_ref_of"

def kitUnaryRel(rt: String, v: String, o: Bool): String =
  if (o && !kitKeepUnaryArg(rt)) relPtr(v) else ""

def kitBoxVal(v: String, o: Bool): Bool =
  !o && v != "null" && !ioPurePtr(v) && !isPtrSlot(v, noParam()) && !hasSub(v, "_v")

def emitKitUnaryBox(rt: String, code: String, v: String, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "kb"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(v, ")")))), join(kitCallPtr1(rt, pct(prefix, "kb"), prefix), kitUnaryRel(rt, pct(prefix, "kb"), true)))), pct(prefix, "v"), true)

def kitCallPtr1(rt: String, v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(v, ")"))))))

def emitKitUnaryI64(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitKitUnaryI642(rt, code, arg0(vals), headOwn(owns), prefix)

def emitKitUnaryI642(rt: String, code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(kitCallI641(rt, v, prefix), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def kitCallI641(rt: String, v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(v, ")"))))))

def emitKitPtrI64(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitKitPtrI642(rt, code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitKitPtrI642(rt: String, code: String, a: String, n: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(kitCallPtrI64(rt, a, n, prefix), if (o) relPtr(a) else "")), pct(prefix, "v"), true)

def kitCallPtrI64(rt: String, a: String, n: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(a, Str.concat(", i64 ", Str.concat(n, ")"))))))))

def emitKitBinaryPtr(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitKitBinaryPtr2(rt, code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitKitBinaryPtr2(rt: String, code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  if (kitBoxVal(b, ob)) emitKitBinaryBoxB(rt, code, a, b, oa, prefix) else Slot(join(code, join(kitCallPtr2(rt, a, b, prefix), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), true)

def emitKitBinaryBoxB(rt: String, code: String, a: String, b: String, oa: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "kb"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(b, ")")))), join(kitCallPtr2(rt, a, pct(prefix, "kb"), prefix), join(if (oa) relPtr(a) else "", relPtr(pct(prefix, "kb")))))), pct(prefix, "v"), true)

def kitCallPtr2(rt: String, a: String, b: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))))

def emitKitBinaryI64(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitKitBinaryI642(rt, code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitKitBinaryI642(rt: String, code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  if (kitBoxVal(b, ob)) emitKitBinaryI64Box(rt, code, a, b, oa, prefix) else Slot(join(code, join(kitCallI642(rt, a, b, prefix), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), false)

def emitKitBinaryI64Box(rt: String, code: String, a: String, b: String, oa: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "kb"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(b, ")")))), join(kitCallI642(rt, a, pct(prefix, "kb"), prefix), join(if (oa) relPtr(a) else "", relPtr(pct(prefix, "kb")))))), pct(prefix, "v"), false)

def kitCallI642(rt: String, a: String, b: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))))

def emitListJoin(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListJoin2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitListJoin2(code: String, xs: String, sep: String, ox: Bool, os: Bool, prefix: String): Slot =
  Slot(join(code, join(kitJoinCall(xs, sep, prefix), join(if (ox) relPtr(xs) else "", if (os) relPtr(sep) else ""))), pct(prefix, "v"), true)

def kitJoinCall(xs: String, sep: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_join(ptr ", Str.concat(xs, Str.concat(", ptr ", Str.concat(sep, ")"))))))

def emitMapEmpty(code: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), "call ptr @sz_map_empty()"))), pct(prefix, "v"), true)

def emitListNil(code: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), "call ptr @sz_list_nil()"))), pct(prefix, "v"), true)

def emitMapSet(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitMapSet2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(owns)), headOwn(tailOwn(tailOwn(owns))), prefix)

def emitMapSet2(code: String, m: String, k: String, v: String, om: Bool, ok: Bool, ov: Bool, prefix: String): Slot =
  if (isNumSlot(v, ov)) emitMapSetNum(code, m, k, v, om, ok, prefix) else emitMapSetPtr(code, m, k, v, om, ok, ov, prefix)

def emitMapSetPtr(code: String, m: String, k: String, v: String, om: Bool, ok: Bool, ov: Bool, prefix: String): Slot =
  Slot(join(code, join(kitMapSetCall(m, k, v, prefix), join(if (om) relPtr(m) else "", join(if (ok) relPtr(k) else "", if (ov) relPtr(v) else "")))), pct(prefix, "v"), true)

def emitMapSetNum(code: String, m: String, k: String, v: String, om: Bool, ok: Bool, prefix: String): Slot =
  Slot(join(code, join(pairBox(v, true, prefix, "mb"), join(kitMapSetCall(m, k, pct(prefix, "mb"), prefix), join(if (om) relPtr(m) else "", join(if (ok) relPtr(k) else "", relPtr(pct(prefix, "mb"))))))), pct(prefix, "v"), true)

def kitMapSetCall(m: String, k: String, v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_map_set(ptr ", Str.concat(m, Str.concat(", ptr ", Str.concat(k, Str.concat(", ptr ", Str.concat(v, ", i32 1)"))))))))

def emitSetAdd(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitSetAdd2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitSetAdd2(code: String, m: String, k: String, om: Bool, ok: Bool, prefix: String): Slot =
  Slot(join(code, join(kitSetAddCall(m, k, prefix), join(if (om) relPtr(m) else "", if (ok) relPtr(k) else ""))), pct(prefix, "v"), true)

def kitSetAddCall(m: String, k: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_map_set(ptr ", Str.concat(m, Str.concat(", ptr ", Str.concat(k, ", ptr null, i32 1)"))))))

def emitMapGetOr(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitMapGetOr2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(owns)), headOwn(tailOwn(tailOwn(owns))), prefix)

def emitMapGetOr2(code: String, m: String, k: String, d: String, om: Bool, ok: Bool, od: Bool, prefix: String): Slot =
  if (isNumSlot(d, od)) emitMapGetOrNum(code, m, k, d, om, ok, prefix) else emitMapGetOrPtr(code, m, k, d, om, ok, od, prefix)

def emitMapGetOrPtr(code: String, m: String, k: String, d: String, om: Bool, ok: Bool, od: Bool, prefix: String): Slot =
  Slot(join(code, join(kitGetOrCall(m, k, d, prefix), join(if (ok) relPtr(k) else "", getOrAfter(m, d, om, od, pct(prefix, "p"))))), pct(prefix, "p"), om || od)

def emitMapGetOrNum(code: String, m: String, k: String, d: String, om: Bool, ok: Bool, prefix: String): Slot =
  Slot(join(code, join(pairBox(d, true, prefix, "md"), join(kitGetOrCall(m, k, pct(prefix, "md"), prefix), join(if (ok) relPtr(k) else "", join(getOrAfter(m, pct(prefix, "md"), om, true, pct(prefix, "p")), join(unboxLine(pct(prefix, "p"), prefix), relPtr(pct(prefix, "p")))))))), pct(prefix, "u"), false)

def kitGetOrCall(m: String, k: String, d: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "p"), Str.concat("call ptr @sz_map_get_or(ptr ", Str.concat(m, Str.concat(", ptr ", Str.concat(k, Str.concat(", ptr ", Str.concat(d, ")"))))))))

def isNumSlot(v: String, o: Bool): Bool =
  !o && (isI64Lit(v) || isIntSsa(v) || numSsa(v, o))

def numSsa(v: String, o: Bool): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37 && !o && !isPtrSlot(v, noParam()) && !strish(v)

def emitClock(rt: String, code: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, "()"))))), pct(prefix, "v"), false)

def emitFsMkdirs(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitFsReadRt("sz_fs_mkdirs", code, vals, owns, prefix)

def emitFsReadRt(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitFsReadRt2(rt, code, arg0(vals), headOwn(owns), prefix)

def emitFsReadRt2(rt: String, code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(kitCallPtr1(rt, v, prefix), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def retPtr(p: String): String =
  line(Str.concat("call void @sz_retain(ptr ", Str.concat(p, ")")))

def takePtr(v: String, o: Bool, prefix: String): String =
  if (o) join(retPtr(pct(prefix, "v")), relPtr(v)) else ""

def hasEn(ens: List[En], name: String): Bool =
  if (List.isEmpty(ens)) false else hasEnHead(List.at(ens, 0), List.tail(ens), name)

def hasEnHead(h: En, rest: List[En], name: String): Bool =
  h match {
    case En(_, n, _, _) => if (n == name) true else hasEn(rest, name)
  }

def isCtorName(f: String): Bool =
  Str.len(f) > 0 && Str.charAt(f, 0) >= 65 && Str.charAt(f, 0) <= 90 && !hasSub(f, ".")

def isQualCtor(f: String, ens: List[En]): Bool =
  qualName(f) != "" && (hasEn(ens, qualEn(f)) || qualEn(f) == "Json" || qualEn(f) == "Result" || qualEn(f) == "Option")

def qualEn(f: String): String =
  if (dotAt(f, 0) < 0) "" else Str.slice(f, 0, dotAt(f, 0))

def qualName(f: String): String =
  if (dotAt(f, 0) < 0) "" else Str.slice(f, dotAt(f, 0) + 1, Str.len(f))

def emitQualCtor(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, ens: List[En], ps: List[Param]): Slot =
  if (List.isEmpty(vals)) emitCtor(qualEn(f), qualName(f), prefix, ens) else emitPayloadCtor1(Slot(code, arg0(vals), headOwn(owns)), qualEn(f), qualName(f), prefix, ens, ps)

def emitAt(code: String, vals: List[String], owns: List[Bool], prefix: String, args: List[Expr], ps: List[Param]): Slot =
  emitAt2(code, arg0(vals), arg1(vals), headOwn(owns), prefix, headUnbox(args, ps))

def emitAt2(code: String, v: String, i: String, o: Bool, prefix: String, unbox: Bool): Slot =
  if (unbox) emitAtInt(code, v, i, o, prefix) else emitAtPtr(code, v, i, o, prefix)

def emitAtInt(code: String, v: String, i: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_at(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(i, ")")))))), join(takePtr(v, o, prefix), join(line(Str.concat(tmp(prefix, "u"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(prefix, "v"), ")")))), if (o) relPtr(pct(prefix, "v")) else "")))), pct(prefix, "u"), false)

def emitAtPtr(code: String, v: String, i: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_at(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(i, ")")))))), takePtr(v, o, prefix))), pct(prefix, "v"), o)

def emitRec(en: String, code: String, vals: List[String], owns: List[Bool], prefix: String, ens: List[En], args: List[Expr], ps: List[Param], defs: List[Fun]): Slot =
  if (List.isEmpty(vals)) emitCtor(recEn(en, ens), en, prefix, ens) else if (List.len(vals) == 1) emitRecOne(en, code, vals, owns, prefix, ens, ps) else emitRecJoin(code, emitPack(vals, owns, args, prefix, 0, List.len(vals), ps, defs), en, prefix, ens)

def emitRecJoin(code: String, pack: Slot, en: String, prefix: String, ens: List[En]): Slot =
  pack match {
    case Slot(pc, pv, _) => emitRec2(join(code, pc), pv, en, prefix, ens)
  }

def emitRecOne(en: String, code: String, vals: List[String], owns: List[Bool], prefix: String, ens: List[En], ps: List[Param]): Slot =
  emitPayloadCtor1(Slot(code, arg0(vals), headOwn(owns)), recEn(en, ens), en, prefix, ens, ps)

def emitRec2(pc: String, pv: String, en: String, prefix: String, ens: List[En]): Slot =
  Slot(join(pc, join(emitAdtNew(prefix, ctorTag(ens, recEn(en, ens), en), pv), relPtr(pv))), pct(prefix, "adt"), true)

def recEn(en: String, ens: List[En]): String =
  if (hasEn(ens, en)) en else enOfCase(ens, en)

def emitPack(vals: List[String], owns: List[Bool], args: List[Expr], prefix: String, i: Int, n: Int, ps: List[Param], defs: List[Fun]): Slot =
  if (List.isEmpty(vals)) Slot(line(Str.concat(tmp(prefix, "pl0"), "call ptr @sz_list_nil()")), pct(prefix, "pl0"), true) else emitPack1(List.at(vals, 0), headOwn(owns), exprIsI64(List.at(args, 0), ps, defs), emitPack(List.tail(vals), List.tail(owns), List.tail(args), prefix, i + 1, n, ps, defs), prefix, i, n)

def emitPack1(v: String, o: Bool, num: Bool, rest: Slot, prefix: String, i: Int, n: Int): Slot =
  rest match {
    case Slot(rc, rp, _) => emitPack2(rc, rp, v, o, !o && (num || isI64Lit(v) || isIntSsa(v)), prefix, i, n)
  }

def emitPack2(rc: String, rp: String, v: String, o: Bool, num: Bool, prefix: String, i: Int, n: Int): Slot =
  Slot(join(rc, join(packBox(v, num, prefix, i), join(packCons(prefix, i, n, packPtr(v, num, prefix, i), rp), join(relPtr(rp), packDrop(v, o, num, prefix, i))))), pct(prefix, Str.concat("pl", Str.fromInt(n - i))), true)

def packBox(v: String, num: Bool, prefix: String, i: Int): String =
  if (num) line(Str.concat(tmp(prefix, Str.concat("bx", Str.fromInt(i))), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(v, ")")))) else ""

def packPtr(v: String, num: Bool, prefix: String, i: Int): String =
  if (num) pct(prefix, Str.concat("bx", Str.fromInt(i))) else v

def packCons(prefix: String, i: Int, n: Int, hd: String, tl: String): String =
  line(Str.concat(tmp(prefix, Str.concat("pl", Str.fromInt(n - i))), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(hd, Str.concat(", ptr ", Str.concat(tl, ")"))))))

def packDrop(v: String, o: Bool, num: Bool, prefix: String, i: Int): String =
  if (num) relPtr(pct(prefix, Str.concat("bx", Str.fromInt(i)))) else if (o) relPtr(v) else ""

def emitListHead(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListHeadPtr(code, arg0(vals), headOwn(owns), prefix)

def headUnbox(args: List[Expr], ps: List[Param]): Bool =
  if (List.isEmpty(args)) false else headUnbox1(List.at(args, 0), ps)

def headUnbox1(e: Expr, ps: List[Param]): Bool =
  e match {
    case Expr.EList(xs) => headUnboxList(xs)
    case Expr.EVar(s, _) => isI64ListTy(paramTy(ps, s))
    case _ => false
  }

def isI64ListTy(ty: String): Bool =
  ty == "List[Bool]" || ty == "List[Int]" || ty == "List"

def headUnboxList(xs: List[Expr]): Bool =
  if (List.isEmpty(xs)) true else headIsInt(xs)

def headIsInt(xs: List[Expr]): Bool =
  List.at(xs, 0) match {
    case Expr.EInt(_, _) => true
    case _ => false
  }

def emitListHeadPtr(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_head_opt(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def emitListTail(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListTail2(code, arg0(vals), headOwn(owns), prefix)

def emitListTail2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_tail(ptr ", Str.concat(v, ")")))), takePtr(v, o, prefix))), pct(prefix, "v"), o)

def emitListEmpty(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListEmpty2(code, arg0(vals), headOwn(owns), prefix)

def emitListEmpty2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "i"), Str.concat("call i32 @sz_list_is_empty(ptr ", Str.concat(v, ")")))), join(line(Str.concat(tmp(prefix, "v"), Str.concat("zext i32 ", Str.concat(pct(prefix, "i"), " to i64")))), if (o) relPtr(v) else ""))), pct(prefix, "v"), false)

def emitStrLen(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitStrLen2("sz_string_ulen", code, arg0(vals), headOwn(owns), prefix)

def emitByteLen(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitStrLen2("sz_string_len", code, arg0(vals), headOwn(owns), prefix)

def emitStrLen2(rt: String, code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(v, ")")))))), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def emitStrEq(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitStrEq2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitStrEq2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(emitStrEqCall(prefix, a, b), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), false)

def emitStrEqCall(prefix: String, a: String, b: String): String =
  join(line(Str.concat(tmp(prefix, "eqi"), Str.concat("call i32 @sz_string_eq(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")")))))), line(Str.concat(tmp(prefix, "v"), Str.concat("zext i32 ", Str.concat(pct(prefix, "eqi"), " to i64")))))

def emitZipAllKit(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitZipAllKit2(rt, code, arg0(vals), arg1(vals), arg2(vals), arg3(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def arg3(vals: List[String]): String =
  nthStrD(vals, 3, "null")

def emitZipAllKit2(rt: String, code: String, a: String, b: String, c: String, d: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(zipAllCall(rt, prefix, a, b, c, d), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), true)

def zipAllCall(rt: String, prefix: String, a: String, b: String, c: String, d: String): String =
  line(Str.concat(tmp(prefix, "v"), zipAllCall2(rt, a, b, c, d)))

def zipAllCall2(rt: String, a: String, b: String, c: String, d: String): String =
  Str.concat("call ptr @", Str.concat(rt, zipAllCall3(a, b, c, d)))

def zipAllCall3(a: String, b: String, c: String, d: String): String =
  Str.concat("(ptr ", Str.concat(a, zipAllCall4(b, c, d)))

def zipAllCall4(b: String, c: String, d: String): String =
  Str.concat(", ptr ", Str.concat(b, zipAllCall5(c, d)))

def zipAllCall5(c: String, d: String): String =
  Str.concat(", ptr ", Str.concat(c, zipAllCall6(d)))

def zipAllCall6(d: String): String =
  Str.concat(", ptr ", Str.concat(d, ")"))

def emitStarts(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitStarts2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitStarts2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(emitStartsCall(prefix, a, b), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), false)

def emitStartsCall(prefix: String, a: String, b: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_string_starts_with(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))

def emitCharAt(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitCharAt2(code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitCharAt2(code: String, v: String, i: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_string_uchar_at(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(i, ")")))))), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def emitSlice(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitSlice2("sz_string_uslice", code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), prefix)

def emitByteSlice(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitSlice2("sz_string_slice", code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), prefix)

def emitSlice2(rt: String, code: String, v: String, a: String, b: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(a, Str.concat(", i64 ", Str.concat(b, ")")))))))))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def emitToInt(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitToInt2(code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitToInt2(code: String, v: String, d: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_string_to_int(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(d, ")")))))), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def emitRepeat(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitRepeat2(code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitRepeat2(code: String, v: String, n: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_repeat(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(n, ")")))))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def emitConsCall(code: String, vals: List[String], owns: List[Bool], prefix: String, args: List[Expr], ps: List[Param], defs: List[Fun]): Slot =
  emitConsCall2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix, consHeadInt(args, ps, defs) || isI64Head(arg0(vals), headOwn(owns), ps))

def consHeadInt(args: List[Expr], ps: List[Param], defs: List[Fun]): Bool =
  if (List.isEmpty(args)) true else exprIsI64(List.at(args, 0), ps, defs)

def isI64Head(v: String, o: Bool, ps: List[Param]): Bool =
  !o && v != "null" && !isPtrSlot(v, ps) && (isIntSsa(v) || isI64ParamVal(v, ps))

def isI64ParamVal(v: String, ps: List[Param]): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37 && paramIsI64(ps, Str.slice(v, 1, Str.len(v)))

def emitConsCall2(code: String, h: String, t: String, oh: Bool, ot: Bool, prefix: String, isInt: Bool): Slot =
  if (isInt) emitConsInt(code, h, t, ot, prefix) else emitConsPtr(code, h, t, oh, ot, prefix)

def emitConsInt(code: String, h: String, t: String, ot: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "hd"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(h, ")")))), join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(pct(prefix, "hd"), Str.concat(", ptr ", Str.concat(t, ")")))))), join(relPtr(pct(prefix, "hd")), if (ot) relPtr(t) else "")))), pct(prefix, "v"), true)

def emitConsPtr(code: String, h: String, t: String, oh: Bool, ot: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(h, Str.concat(", ptr ", Str.concat(t, ")")))))), join(if (oh) relPtr(h) else "", if (ot) relPtr(t) else ""))), pct(prefix, "v"), true)

def emitBldNew(code: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), "call ptr @sz_builder_new()"))), pct(prefix, "v"), true)

def emitBldApp(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitBldApp2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitBldApp2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_builder_append(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")")))))), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), true)

def emitBldRes(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitBldRes2(code, arg0(vals), headOwn(owns), prefix)

def emitBldRes2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_builder_result(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def emitFsRead(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitFsRead2(code, arg0(vals), headOwn(owns), prefix)

def emitFsRead2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_fs_read(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def emitFsWrite(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitFsWriteRt("sz_fs_write", code, vals, owns, prefix)

def emitFsWriteRt(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitFsWrite2(rt, code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitFsWrite2(rt: String, code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")")))))))), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), false)

def emitNetPtrI64(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitNetPtrI642(rt, code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitNetPtrI642(rt: String, code: String, a: String, n: String, oa: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(a, Str.concat(", i64 ", Str.concat(n, ")")))))))), if (oa) relPtr(a) else "")), pct(prefix, "v"), false)

def emitNetUdpSend(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitNetUdpSend2(code, arg0(vals), arg1(vals), arg2(vals), arg3(vals), headOwn(owns), headOwn(tailOwn(owns)), headOwn(tailOwn(tailOwn(tailOwn(owns)))), prefix)

def emitNetUdpSend2(code: String, sock: String, host: String, port: String, data: String, os: Bool, oh: Bool, od: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_net_udp_send(ptr ", Str.concat(sock, Str.concat(", ptr ", Str.concat(host, Str.concat(", i64 ", Str.concat(port, Str.concat(", ptr ", Str.concat(data, ")")))))))))), join(if (os) relPtr(sock) else "", join(if (oh) relPtr(host) else "", if (od) relPtr(data) else "")))), pct(prefix, "v"), false)

def emitSysArgs(code: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), "call ptr @sz_sys_args()"))), pct(prefix, "v"), false)

def emitSysI64(rt: String, code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(i64 ", Str.concat(arg0(vals), ")"))))))), pct(prefix, "v"), false)

def emitSysI64I64(rt: String, code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(i64 ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), ")"))))))))), pct(prefix, "v"), false)

def emitSysI64Ptr(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitSysI64Ptr2(rt, code, arg0(vals), arg1(vals), headOwn(tailOwn(owns)), prefix)

def emitSysI64Ptr2(rt: String, code: String, a: String, b: String, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(i64 ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")")))))))), if (ob) relPtr(b) else "")), pct(prefix, "v"), false)

def emitFsList(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitFsList2(code, arg0(vals), headOwn(owns), prefix)

def emitFsList2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_fs_list(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def emitIoPure(code: String, vals: List[String], owns: List[Bool], prefix: String, ps: List[Param]): Slot =
  emitIoPure2(code, arg0(vals), headOwn(owns), prefix, ps)

def emitIoPure2(code: String, v: String, o: Bool, prefix: String, ps: List[Param]): Slot =
  if (o || v == "null" || isPtrSlot(v, ps)) emitIoPurePtr(code, v, o, prefix) else if (pureI64(v, ps)) emitIoPureI64(code, v, prefix) else if (Str.len(v) > 0 && Str.charAt(v, 0) == 37) emitIoPurePtr(code, v, o, prefix) else emitIoPureI64(code, v, prefix)

def pureI64(v: String, ps: List[Param]): Bool =
  isI64Lit(v) || isIntSsa(v) || hasSub(v, "_v") || Str.len(v) > 1 && Str.charAt(v, 0) == 37 && paramIsI64(ps, Str.slice(v, 1, Str.len(v)))

def ioPurePtr(v: String): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37 && !hasSub(v, "_")

def emitIoPurePtr(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @sz_io_pure(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "io"), false)

def emitIoPureI64(code: String, v: String, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "b"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(v, ")")))), join(line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @sz_io_pure(ptr ", Str.concat(pct(prefix, "b"), ")")))), relPtr(pct(prefix, "b"))))), pct(prefix, "io"), false)

def emitSc(isAnd: Bool, l: Expr, r: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitScA(isAnd, emitExpr(l, Str.concat(prefix, "_l"), strs, defs, ens, ps, loc), r, prefix, strs, defs, ens, ps, loc)

def emitScA(isAnd: Bool, le: Slot, r: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  Slot(cat3(le.code, scHead(isAnd, le.val, prefix), emitScB(emitExpr(r, Str.concat(prefix, "_r"), strs, defs, ens, ps, loc), prefix, isAnd)), pct(prefix, "v"), false)

def scHead(isAnd: Bool, lv: String, prefix: String): String =
  join(line(Str.concat("br label %", Str.concat(prefix, "_al_0"))), join(lab(Str.concat(prefix, "_al_0")), join(line(Str.concat(tmp(prefix, "nz0"), Str.concat("icmp ne i64 ", Str.concat(lv, ", 0")))), scBr(isAnd, prefix))))

def scBr(isAnd: Bool, prefix: String): String =
  if (isAnd) line(Str.concat("br i1 ", Str.concat(pct(prefix, "nz0"), Str.concat(", label %", Str.concat(prefix, Str.concat("_rhs_0, label %", Str.concat(prefix, "_sc_0"))))))) else line(Str.concat("br i1 ", Str.concat(pct(prefix, "nz0"), Str.concat(", label %", Str.concat(prefix, Str.concat("_sc_0, label %", Str.concat(prefix, "_rhs_0")))))))

def emitScB(re: Slot, prefix: String, isAnd: Bool): String =
  cat3(lab(Str.concat(prefix, "_rhs_0")), re.code, scTail(isAnd, re.val, prefix))

def scTail(isAnd: Bool, rv: String, prefix: String): String =
  join(line(Str.concat("br label %", Str.concat(prefix, "_ar_0"))), join(lab(Str.concat(prefix, "_ar_0")), join(line(Str.concat(tmp(prefix, "rnz0"), Str.concat("icmp ne i64 ", Str.concat(rv, ", 0")))), join(line(Str.concat(tmp(prefix, "rb0"), Str.concat("zext i1 ", Str.concat(pct(prefix, "rnz0"), " to i64")))), join(line(Str.concat("br label %", Str.concat(prefix, "_sc_0"))), join(lab(Str.concat(prefix, "_sc_0")), line(Str.concat(tmp(prefix, "v"), scPhi(isAnd, prefix)))))))))

def scPhi(isAnd: Bool, prefix: String): String =
  Str.concat("phi i64 [ ", Str.concat(if (isAnd) "0" else "1", Str.concat(", %", Str.concat(prefix, Str.concat("_al_0 ], [ ", Str.concat(pct(prefix, "rb0"), Str.concat(", %", Str.concat(prefix, "_ar_0 ]"))))))))

def findDef(funs: List[Fun], name: String): List[Fun] =
  findDefKeep(funs, name, noFun())

def findDefKeep(funs: List[Fun], name: String, acc: List[Fun]): List[Fun] =
  if (List.isEmpty(funs)) acc else findDefKeep1(List.at(funs, 0), List.tail(funs), name, acc)

def findDefKeep1(h: Fun, rest: List[Fun], name: String, acc: List[Fun]): List[Fun] =
  h match {
    case Fun(priv, n, ts, ps, ret, body, mod, off) => if (n == name) Fun(priv, n, ts, ps, ret, body, mod, off) :: noFun() else findDefKeep(rest, name, acc)
  }

def modOfLoc(loc: String): String =
  modOfLoc2(loc, Str.indexOf(loc, ".scuzz:"))

def modOfLoc2(loc: String, i: Int): String =
  if (i < 0) "" else Str.slice(loc, 0, i)

def findDefPrefer(defs: List[Fun], name: String, mod: String): List[Fun] =
  if (mod == "") findDef(defs, name) else findDefPrefer2(findDefMod(defs, mod, name), defs, name)

def findDefPrefer2(hit: List[Fun], defs: List[Fun], name: String): List[Fun] =
  if (List.isEmpty(hit)) findDef(defs, name) else hit

def emitUser(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, defs: List[Fun], mod: String): Slot =
  emitUser2(f, code, vals, owns, prefix, findDefPrefer(defs, f, mod))

def emitUser2(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, hit: List[Fun]): Slot =
  if (List.isEmpty(hit)) Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_user_Main_", Str.concat(f, Str.concat("(", Str.concat(i64Args(vals), ")"))))))), pct(prefix, "v"), false) else emitUserD(code, vals, owns, prefix, List.at(hit, 0))

def emitUserHit(sym: String, code: String, vals: List[String], owns: List[Bool], prefix: String, hit: List[Fun]): Slot =
  if (List.isEmpty(hit)) Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_user_", Str.concat(sym, Str.concat("(", Str.concat(i64Args(vals), ")"))))))), pct(prefix, "v"), false) else emitUserD(code, vals, owns, prefix, List.at(hit, 0))

def emitUserD(code: String, vals: List[String], owns: List[Bool], prefix: String, d: Fun): Slot =
  d match {
    case Fun(_, name, _, params, ret, _, mod, _) => emitUser6(symOf(mod, name), code, vals, owns, prefix, params, ret)
  }

def symOf(mod: String, name: String): String =
  Str.concat(if (mod == "") "Main" else mod, Str.concat("_", name))

def emitUser6(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, params: List[Param], ret: String): Slot =
  emitUser7(f, code, prefix, llvmRet(ret), !isI64Ty(ret), packCall(params, vals, owns, prefix, 0))

def emitUser7(f: String, code: String, prefix: String, ty: String, owned: Bool, p: ((String, String), String)): Slot =
  p match {
    case ((pre, args), rel) => Slot(join(code, join(pre, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ", Str.concat(ty, Str.concat(" @sz_user_", Str.concat(f, Str.concat("(", Str.concat(args, ")")))))))), rel))), pct(prefix, "v"), owned)
  }

def packCall(ps: List[Param], vals: List[String], owns: List[Bool], prefix: String, i: Int): ((String, String), String) =
  if (List.isEmpty(ps) || List.isEmpty(vals)) (("", ""), "") else packCall2(List.at(ps, 0), List.at(vals, 0), headOwn(owns), List.tail(ps), List.tail(vals), tailOwn(owns), prefix, i)

def packCall2(p: Param, v: String, o: Bool, ps: List[Param], vals: List[String], owns: List[Bool], prefix: String, i: Int): ((String, String), String) =
  if (isI64Ty(p.ty) && v == "%value") packCallUnbox(p, v, o, ps, vals, owns, prefix, i) else if (!isI64Ty(p.ty) && !o && (isI64Lit(v) || isIntSsa(v))) packCallBox(p, v, o, ps, vals, owns, prefix, i) else packCall3(oneArg(p, v), if (o) relPtr(v) else "", packCall(ps, vals, owns, prefix, i + 1))

def packCallUnbox(_p: Param, v: String, o: Bool, ps: List[Param], vals: List[String], owns: List[Bool], prefix: String, i: Int): ((String, String), String) =
  packCallUnbox2(pct(prefix, Str.concat("pu", Str.fromInt(i))), v, o, packCall(ps, vals, owns, prefix, i + 1), prefix, i)

def packCallUnbox2(uv: String, v: String, o: Bool, rest: ((String, String), String), prefix: String, i: Int): ((String, String), String) =
  rest match {
    case ((pre, args), rels) => ((join(line(Str.concat(tmp(prefix, Str.concat("pu", Str.fromInt(i))), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(v, ")")))), pre), packArg(Str.concat("i64 ", uv), args)), join(if (o) relPtr(v) else "", rels))
  }

def packCallBox(_p: Param, v: String, o: Bool, ps: List[Param], vals: List[String], owns: List[Bool], prefix: String, i: Int): ((String, String), String) =
  packCallBox2(pct(prefix, Str.concat("pb", Str.fromInt(i))), v, o, packCall(ps, vals, owns, prefix, i + 1), prefix, i)

def packCallBox2(bx: String, v: String, o: Bool, rest: ((String, String), String), prefix: String, i: Int): ((String, String), String) =
  rest match {
    case ((pre, args), rels) => ((join(line(Str.concat(tmp(prefix, Str.concat("pb", Str.fromInt(i))), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(v, ")")))), pre), packArg(Str.concat("ptr ", bx), args)), join(relPtr(bx), join(if (o) relPtr(v) else "", rels)))
  }

def packCall3(arg: String, rel: String, rest: ((String, String), String)): ((String, String), String) =
  rest match {
    case ((pre, args), rels) => ((pre, packArg(arg, args)), join(rel, rels))
  }

def packArg(arg: String, args: String): String =
  if (args == "") arg else Str.concat(arg, Str.concat(", ", args))

def headOwn(owns: List[Bool]): Bool =
  if (List.isEmpty(owns)) false else List.at(owns, 0)

def tailOwn(owns: List[Bool]): List[Bool] =
  if (List.isEmpty(owns)) owns else List.tail(owns)

def oneArg(p: Param, v: String): String =
  if (isI64Ty(p.ty)) Str.concat("i64 ", v) else Str.concat("ptr ", v)

def lab(s: String): String =
  Str.concat(s, Str.concat(":", nl()))

def emitIfFid(c: Expr, t: Expr, el: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitIfThen(unboxBin(emitExprFid(c, Str.concat(prefix, "_ic"), strs, defs, ens, ps, loc, fid), ps, Str.concat(prefix, "_iu")), t, el, prefix, strs, defs, ens, ps, loc, fid + fmCount(c))

def emitIfThen(c: Slot, t: Expr, el: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitIfElse(c, emitLiftUnitIo(t, el, Str.concat(prefix, "_t0"), strs, defs, ens, ps, loc, fid), el, prefix, strs, defs, ens, ps, loc, fid + fmCount(t))

def emitLiftUnitIo(t: Expr, el: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  t match {
    case Expr.EUnit => if (isIoPred(el)) emitIoUnit(prefix) else emitExprFid(t, prefix, strs, defs, ens, ps, loc, fid)
    case _ => emitExprFid(t, prefix, strs, defs, ens, ps, loc, fid)
  }

def emitIfElse(c: Slot, th: Slot, el: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  th match {
    case Slot(tc, tv, to) => emitIf2(c, Slot(tc, tv, to), emitUnitElse(el, thenIsPtr(tc, tv, to, ps), isIoSlot(tv), prefix, strs, defs, ens, ps, loc, fid), prefix, ps)
  }

def thenIsPtr(code: String, v: String, o: Bool, ps: List[Param]): Bool =
  o || isPtrSlot(v, ps) || v == "null" || thenCallPtr(code, v)

def thenCallPtr(code: String, v: String): Bool =
  if (skipCallScan(v)) false else hasSubTail(code, Str.concat(v, " = call ptr @")) && !hasSubTail(code, Str.concat(v, " = call i64 @"))

def skipCallScan(v: String): Bool =
  Str.len(v) == 0 || Str.charAt(v, 0) != 37 || isIntSsa(v) || isI64Lit(v)

def hasSubTail(s: String, sub: String): Bool =
  hasSub(s, sub)

def isIoSlot(v: String): Bool =
  hasSub(v, "_io") || hasSub(v, "_fm")

def emitUnitElse(el: Expr, thenOwned: Bool, thenIo: Bool, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  el match {
    case Expr.EUnit => if (thenIo) emitIoUnit(prefix) else if (thenOwned) Slot("", "null", true) else Slot("", "0", false)
    case _ => emitExprFid(el, Str.concat(prefix, "_e0"), strs, defs, ens, ps, loc, fid)
  }

def emitIoUnit(prefix: String): Slot =
  Slot(line(Str.concat(tmp(prefix, "iu"), "call ptr @sz_io_pure(ptr null)")), pct(prefix, "iu"), false)

def emitIf2(c: Slot, t: Slot, el: Slot, prefix: String, ps: List[Param]): Slot =
  t match {
    case Slot(tc, tv, to) => el match {
  case Slot(ec, ev, eo) => emitIf3(c, tc, tv, to, ec, ev, eo, prefix, ps)
}
  }

def emitIf3(c: Slot, tc: String, tv: String, to: Bool, ec: String, ev: String, eo: Bool, prefix: String, ps: List[Param]): Slot =
  emitIf4(c, tc, tv, to, ec, ev, eo, prefix, thenIsPtr(tc, tv, to, ps) || thenIsPtr(ec, ev, eo, ps))

def emitIf4(c: Slot, tc: String, tv: String, to: Bool, ec: String, ev: String, eo: Bool, prefix: String, isPtr: Bool): Slot =
  Slot(cat4(emitIfHead(c, prefix), emitIfArm(tc, tv, to, prefix, "_then_0", "_tj_0", isPtr && !to), emitIfArm(ec, ev, eo, prefix, "_else_0", "_ej_0", isPtr && !eo), emitIfPhi(tv, ev, prefix, isPtr)), pct(prefix, "phi"), isPtr)

def isPtrSlot(v: String, ps: List[Param]): Bool =
  isPtrParam(v, ps) || hasDigitStem(v, "_c") || hasSub(v, "_tl") || hasSub(v, "_tr") || hasSub(v, "_pl") || hasSub(v, "_io") || hasSub(v, "_fm") || hasSub(v, "_ch") || hasSub(v, "_ct")

def isPtrParam(v: String, ps: List[Param]): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37 && paramKnown(ps, Str.slice(v, 1, Str.len(v))) && !paramIsI64(ps, Str.slice(v, 1, Str.len(v)))

def paramKnown(ps: List[Param], n: String): Bool =
  if (List.isEmpty(ps)) false else paramKnownHd(List.at(ps, 0), List.tail(ps), n)

def paramKnownHd(p: Param, rest: List[Param], n: String): Bool =
  p match {
    case Param(name, _, _, _) => if (name == n) true else paramKnown(rest, n)
  }

def emitIfHead(c: Slot, prefix: String): String =
  c match {
    case Slot(code, val, _) => cat3(code, emitIfCmp(val, prefix), emitIfBr(prefix))
  }

def emitIfCmp(v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "cmp"), Str.concat("icmp ne i64 ", Str.concat(v, ", 0"))))

def emitIfBr(prefix: String): String =
  line(Str.concat("br i1 ", Str.concat(pct(prefix, "cmp"), Str.concat(", label %", Str.concat(prefix, Str.concat("_then_0, label %", Str.concat(prefix, "_else_0")))))))

def emitIfArm(code: String, val: String, owned: Bool, prefix: String, enter: String, joinLab: String, keep: Bool): String =
  cat6(lab(Str.concat(prefix, enter)), code, if (!owned && keep) retPtr(val) else "", emitIfJmp(prefix, joinLab), lab(Str.concat(prefix, joinLab)), emitIfJmp(prefix, "_merge_0"))

def emitIfJmp(prefix: String, dest: String): String =
  line(Str.concat("br label %", Str.concat(prefix, dest)))

def emitIfPhi(tv: String, ev: String, prefix: String, isPtr: Bool): String =
  join(lab(Str.concat(prefix, "_merge_0")), line(Str.concat(tmp(prefix, "phi"), emitIfPhi2(tv, ev, prefix, if (isPtr) "ptr" else "i64"))))

def emitIfPhi2(tv: String, ev: String, prefix: String, ty: String): String =
  Str.concat("phi ", Str.concat(ty, Str.concat(" [ ", Str.concat(tv, Str.concat(", %", Str.concat(prefix, Str.concat("_tj_0 ], [ ", Str.concat(ev, emitIfPhi3(prefix)))))))))

def emitIfPhi3(prefix: String): String =
  Str.concat(", %", Str.concat(prefix, "_ej_0 ]"))

def emitField(recv: Expr, name: String, prefix: String, ens: List[En], ps: List[Param]): Slot =
  if (isTupField(name)) emitTupField(recv, name, prefix, ps) else emitFieldEn(recv, name, prefix, ens, ps)

def emitFieldEn(recv: Expr, name: String, prefix: String, ens: List[En], ps: List[Param]): Slot =
  recv match {
    case Expr.EVar(en, _) => if (paramTy(ps, en) != "") emitRecFieldVar(en, name, prefix, ens, ps) else emitCtor(en, name, prefix, ens)
    case _ => Slot("", "0", false)
  }

def emitRecFieldVar(en: String, name: String, prefix: String, ens: List[En], ps: List[Param]): Slot =
  emitRecFieldVar2(en, prefix, recNames(ens, tyHead(paramTy(ps, en))), recTys(ens, tyHead(paramTy(ps, en))), name)

def emitRecFieldVar2(en: String, prefix: String, ns: List[String], tys: List[String], name: String): Slot =
  emitRecFieldIdx(en, prefix, recFieldIdx(ns, name), slotInt(tys, recFieldIdx(ns, name)), List.len(ns))

def recFieldIdx(ns: List[String], name: String): Int =
  if (List.isEmpty(ns)) 0 else idxOf(ns, name)

def emitRecFieldIdx(en: String, prefix: String, k: Int, unbox: Bool, n: Int): Slot =
  emitRecFieldIdx2(line(Str.concat(tmp(prefix, "rpl"), Str.concat("call ptr @sz_adt_payload(ptr %", Str.concat(en, ")")))), prefix, k, unbox, n)

def emitRecFieldIdx2(pl: String, prefix: String, k: Int, unbox: Bool, n: Int): Slot =
  if (n <= 1) emitRecFieldMaybeUnbox(pl, pct(prefix, "rpl"), prefix, unbox) else emitRecFieldMaybeUnbox(join(pl, line(Str.concat(tmp(prefix, "rat"), Str.concat("call ptr @sz_list_at(ptr ", Str.concat(pct(prefix, "rpl"), Str.concat(", i64 ", Str.concat(Str.fromInt(k), ")"))))))), pct(prefix, "rat"), prefix, unbox)

def emitRecFieldMaybeUnbox(code: String, v: String, prefix: String, unbox: Bool): Slot =
  if (unbox) Slot(join(code, line(Str.concat(tmp(prefix, "ru"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(v, ")"))))), pct(prefix, "ru"), false) else Slot(code, v, false)

def emitTupField(recv: Expr, name: String, prefix: String, ps: List[Param]): Slot =
  recv match {
    case Expr.EVar(s, _) => emitTupSel(Str.concat("%", s), tupSlots(paramTy(ps, s)), tupIdx(name), prefix, 0)
    case _ => emitStuck()
  }

def emitTupSel(scrut: String, tys: List[String], k: Int, prefix: String, i: Int): Slot =
  if (k <= 0) emitPairTake(scrut, true, prefix, headOrAny(tys)) else if (List.isEmpty(tys) || List.len(tys) == 2) emitPairTake(scrut, false, prefix, secondOrAny(tys)) else emitTupSelGo(scrut, tys, k, prefix, i)

def emitTupSelGo(scrut: String, tys: List[String], k: Int, prefix: String, i: Int): Slot =
  emitTupSelJoin(line(Str.concat(tmp(prefix, Str.concat("tr", Str.fromInt(i))), Str.concat("call ptr @sz_pair_right(ptr ", Str.concat(scrut, ")")))), tys, k, prefix, i)

def emitTupSelJoin(pre: String, tys: List[String], k: Int, prefix: String, i: Int): Slot =
  emitTupSelJoin2(pre, emitTupSel(pct(prefix, Str.concat("tr", Str.fromInt(i))), tailOrEmpty(tys), k - 1, prefix, i + 1))

def emitTupSelJoin2(pre: String, s: Slot): Slot =
  s match {
    case Slot(code, v, o) => Slot(join(pre, code), v, o)
  }

def emitPairTake(scrut: String, left: Bool, prefix: String, ty: String): Slot =
  if (isI64Ty(ty)) emitPairUnbox(scrut, left, prefix) else Slot(kitCallPtr1(pairRt(left), scrut, prefix), pct(prefix, "v"), false)

def pairRt(left: Bool): String =
  if (left) "sz_pair_left" else "sz_pair_right"

def emitPairUnbox(scrut: String, left: Bool, prefix: String): Slot =
  Slot(join(line(Str.concat(tmp(prefix, "p"), Str.concat("call ptr @", Str.concat(pairRt(left), Str.concat("(ptr ", Str.concat(scrut, ")")))))), line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(prefix, "p"), ")"))))), pct(prefix, "v"), false)

def emitCtorCall(recv: Expr, name: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (name == "copy") emitCopy(recv, args, prefix, strs, defs, ens, ps, loc) else if (name == "require") emitRequire(recv, args, prefix, strs, defs, ens, ps, loc) else emitCtorCall2(recv, name, args, prefix, strs, defs, ens, ps, loc)

def emitRequire(recv: Expr, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (requirePredIo(requirePred(args))) emitExpr(recv, Str.concat(prefix, "_r"), strs, defs, ens, ps, loc) else emitRequireJoin(emitExpr(requirePred(args), Str.concat(prefix, "_p"), strs, defs, ens, ps, loc), emitExpr(recv, Str.concat(prefix, "_r"), strs, defs, ens, ps, loc))

def requirePred(args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EBool(true) else if (List.len(args) == 1) List.at(args, 0) else List.at(List.tail(args), 0)

def requirePredIo(e: Expr): Bool =
  e match {
    case Expr.EFor(_, _, _) => true
    case Expr.ECall(f, _, _) => Str.startsWith(f, "IO.")
    case Expr.EMethod(_, name, _, _) => name == "flatMap" || name == "map" || name == "handleErrorWith"
    case Expr.EIf(_, t, el, _) => requirePredIo(t) || requirePredIo(el)
    case _ => false
  }

def emitRequireJoin(pred: Slot, body: Slot): Slot =
  pred match {
    case Slot(pc, pv, po) => body match {
  case Slot(code, v, o) => Slot(join(pc, join(if (po) relPtr(pv) else "", code)), v, o)
}
  }

def emitCtorCall2(recv: Expr, name: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  recv match {
    case Expr.EVar(en, _) => if (paramTy(ps, en) != "") emitMethodVal(recv, name, args, prefix, recvEn(en, ps, ens, defs, name), strs, defs, ens, ps, loc) else emitCtorOrQual(en, name, args, prefix, strs, defs, ens, ps, loc)
    case _ => emitMethodVal(recv, name, args, prefix, copyEn(recv, ens, defs), strs, defs, ens, ps, loc)
  }

def recvEn(n: String, ps: List[Param], ens: List[En], defs: List[Fun], meth: String): String =
  recvEnTy(tyHead(paramTy(ps, n)), ens, defs, meth)

def recvEnTy(t: String, ens: List[En], defs: List[Fun], meth: String): String =
  if (hasEn(ens, t)) t else methEnOf(defs, meth)

def methEnOf(defs: List[Fun], meth: String): String =
  if (List.isEmpty(defs)) "Point" else methEnOfH(List.at(defs, 0), List.tail(defs), meth)

def methEnOfH(d: Fun, rest: List[Fun], meth: String): String =
  d match {
    case Fun(_, name, _, _, _, _, mod, _) => if (name == meth && mod != "") mod else methEnOf(rest, meth)
  }

def emitMethodVal(recv: Expr, name: String, args: List[Expr], prefix: String, en: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitMethodVal2(emitExpr(recv, Str.concat(prefix, "_mr"), strs, defs, ens, ps, loc), emitArgList(args, prefix, strs, defs, ens, ps, loc, 0, "", noStr(), noBool()), name, prefix, en, defs)

def emitMethodVal2(r: Slot, ap: (String, List[String], List[Bool]), name: String, prefix: String, en: String, defs: List[Fun]): Slot =
  r match {
    case Slot(rc, rv, ro) => emitMethodVal3(rc, rv, ro, ap, name, prefix, en, defs)
  }

def emitMethodVal3(rc: String, rv: String, ro: Bool, ap: (String, List[String], List[Bool]), name: String, prefix: String, en: String, defs: List[Fun]): Slot =
  ap match {
    case (ac, vals, owns) => emitUserHit(Str.concat(en, Str.concat("_", name)), join(rc, ac), rv :: vals, ro :: owns, prefix, methodHit(defs, en, name))
  }

def methodHit(defs: List[Fun], en: String, name: String): List[Fun] =
  methodHit2(findDefMod(defs, en, name), defs, name)

def methodHit2(hit: List[Fun], defs: List[Fun], name: String): List[Fun] =
  if (List.isEmpty(hit)) findDef(defs, name) else hit

def emitCopy(recv: Expr, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitCopyGo(emitExpr(recv, Str.concat(prefix, "_cr"), strs, defs, ens, ps, loc), args, prefix, copyEn(recv, ens, defs), strs, defs, ens, ps, loc)

def copyEn(recv: Expr, ens: List[En], defs: List[Fun]): String =
  recv match {
    case Expr.ECall(f, _, _) => copyEnOr(copyEnCall(f, ens, defs), ens)
    case Expr.EMethod(r, name, _, _) => copyEnMeth(r, name, ens, defs)
    case Expr.EVar(s, _) => copyEnOr(ctorHead(s, ens), ens)
    case Expr.EIf(_, t, _, _) => copyEn(t, ens, defs)
    case Expr.EMatch(_, arms, _) => copyEnMatch(arms, ens, defs)
    case Expr.ETuple(xs) => tupExprTy(xs, defs, noParam())
    case _ => copyEnFirst(ens)
  }

def copyEnMatch(arms: List[Arm], ens: List[En], defs: List[Fun]): String =
  if (List.isEmpty(arms)) copyEnFirst(ens) else copyEnMatch1(List.at(arms, 0), ens, defs)

def copyEnMatch1(a: Arm, ens: List[En], defs: List[Fun]): String =
  a match {
    case Arm(_, _, body) => copyEn(body, ens, defs)
  }

def copyEnCall(f: String, ens: List[En], defs: List[Fun]): String =
  if (ctorHead(f, ens) != "") ctorHead(f, ens) else tyHead(funRetStr(defs, f))

def copyEnMeth(r: Expr, name: String, ens: List[En], defs: List[Fun]): String =
  r match {
    case Expr.EVar(mod, _) => copyEnOr(if (hasEn(ens, mod)) mod else ctorHead(name, ens), ens)
    case _ => copyEn(r, ens, defs)
  }

def copyEnOr(h: String, ens: List[En]): String =
  if (h == "") copyEnFirst(ens) else h

def ctorHead(f: String, ens: List[En]): String =
  if (f == "" || f == "Any") "" else if (hasEn(ens, f)) f else ctorHeadDot(f, ens, dotAt(f, 0))

def ctorHeadDot(f: String, ens: List[En], dot: Int): String =
  if (dot >= 0) ctorHeadOrCase(Str.slice(f, 0, dot), Str.slice(f, dot + 1, Str.len(f)), ens) else enOfCase(ens, f)

def ctorHeadOrCase(mod: String, name: String, ens: List[En]): String =
  if (hasEn(ens, mod)) mod else enOfCase(ens, name)

def copyEnFirst(ens: List[En]): String =
  if (List.isEmpty(ens)) "Point" else copyEnFirstH(List.at(ens, 0), List.tail(ens))

def copyEnFirstH(h: En, rest: List[En]): String =
  h match {
    case En(isRec, n, _, _) => copyEnFirstGo(isRec, n, rest)
  }

def copyEnFirstGo(isRec: Bool, n: String, rest: List[En]): String =
  if (isRec) n else copyEnFirst(rest)

def emitCopyGo(r: Slot, args: List[Expr], prefix: String, en: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(args)) r else emitCopyUpd(r, args, prefix, en, recNames(ens, en), strs, defs, ens, ps, loc)

def emitCopyUpd(r: Slot, args: List[Expr], prefix: String, en: String, names: List[String], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  r match {
    case Slot(c, v, o) => emitCopyUpd2(c, v, o, args, prefix, en, names, strs, defs, ens, ps, loc)
  }

def emitCopyUpd2(c: String, v: String, o: Bool, args: List[Expr], prefix: String, en: String, names: List[String], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.len(names) == 1) emitCopyOne(c, v, o, args, prefix, en, List.at(names, 0), strs, defs, ens, ps, loc) else emitCopyPackRel(emitCopyPack(join(c, line(Str.concat(tmp(prefix, "pl"), Str.concat("call ptr @sz_adt_payload(ptr ", Str.concat(v, ")"))))), args, prefix, en, names, 0, strs, defs, ens, ps, loc, noStr(), noBool()), v, o)

def emitCopyOne(c: String, v: String, o: Bool, args: List[Expr], prefix: String, en: String, name: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitCopyOneHit(c, v, o, copyOverride(args, 0, name), prefix, en, strs, defs, ens, ps, loc)

def emitCopyOneHit(c: String, v: String, o: Bool, hit: List[Expr], prefix: String, en: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(hit)) emitCopyOneKeep(c, v, o, prefix, en, ens) else emitCopyOneArg(emitExpr(List.at(hit, 0), Str.concat(prefix, "_u0"), strs, defs, ens, ps, loc), c, v, o, prefix, en, ens)

def emitCopyOneKeep(c: String, v: String, o: Bool, prefix: String, en: String, ens: List[En]): Slot =
  Slot(join(c, join(line(Str.concat(tmp(prefix, "pl"), Str.concat("call ptr @sz_adt_payload(ptr ", Str.concat(v, ")")))), join(emitAdtNew(prefix, ctorTag(ens, en, en), pct(prefix, "pl")), if (o) relPtr(v) else ""))), pct(prefix, "adt"), true)

def emitCopyOneArg(s: Slot, c: String, v: String, o: Bool, prefix: String, en: String, ens: List[En]): Slot =
  s match {
    case Slot(ec, ev, eo) => if (!eo && (isI64Lit(ev) || isIntSsa(ev))) emitCopyOneBox(ec, ev, c, v, o, prefix, en, ens) else Slot(join(c, join(ec, join(emitAdtNew(prefix, ctorTag(ens, en, en), ev), join(if (eo) relPtr(ev) else "", if (o) relPtr(v) else "")))), pct(prefix, "adt"), true)
  }

def emitCopyOneBox(ec: String, ev: String, c: String, v: String, o: Bool, prefix: String, en: String, ens: List[En]): Slot =
  Slot(join(c, join(ec, join(emitBoxI64(prefix, ev), join(emitAdtNew(prefix, ctorTag(ens, en, en), pct(prefix, "box")), join(relPtr(pct(prefix, "box")), if (o) relPtr(v) else ""))))), pct(prefix, "adt"), true)

def emitCopyPackRel(s: Slot, v: String, o: Bool): Slot =
  s match {
    case Slot(code, val, owned) => Slot(join(code, if (o) relPtr(v) else ""), val, owned)
  }

def emitCopyPack(code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool]): Slot =
  if (k >= List.len(names)) emitCopyDone(code, List.reverse(vals), List.reverse(owns), prefix, en, ens, ps, defs) else emitCopyPackK(code, args, prefix, en, names, k, strs, defs, ens, ps, loc, vals, owns)

def emitCopyDone(code: String, vals: List[String], owns: List[Bool], prefix: String, en: String, ens: List[En], ps: List[Param], defs: List[Fun]): Slot =
  emitCopyDone2(code, emitPack(vals, owns, copyKeepArgs(List.len(vals)), prefix, 0, List.len(vals), ps, defs), en, prefix, ens)

def emitCopyDone2(code: String, pack: Slot, en: String, prefix: String, ens: List[En]): Slot =
  pack match {
    case Slot(pc, pv, _) => emitRec2(join(code, pc), pv, en, prefix, ens)
  }

def copyKeepArgs(n: Int): List[Expr] =
  if (n <= 0) noExpr() else Expr.EVar("_", 0) :: copyKeepArgs(n - 1)

def emitCopyPackK(code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool]): Slot =
  emitCopyPackHit(copyOverride(args, k, List.at(names, k)), code, args, prefix, en, names, k, strs, defs, ens, ps, loc, vals, owns)

def copyOverride(args: List[Expr], k: Int, name: String): List[Expr] =
  copyOverrideNamed(args, name, copyOverridePos(args, k, 0))

def copyOverrideNamed(args: List[Expr], name: String, pos: List[Expr]): List[Expr] =
  if (List.isEmpty(args)) pos else copyOverrideNamed1(List.at(args, 0), List.tail(args), name, pos)

def copyOverrideNamed1(h: Expr, rest: List[Expr], name: String, pos: List[Expr]): List[Expr] =
  h match {
    case Expr.ENamed(n, inner) => if (n == name) inner :: noExpr() else copyOverrideNamed(rest, name, pos)
    case _ => copyOverrideNamed(rest, name, pos)
  }

def copyOverridePos(args: List[Expr], k: Int, i: Int): List[Expr] =
  if (List.isEmpty(args)) noExpr() else copyOverridePos1(List.at(args, 0), List.tail(args), k, i)

def copyOverridePos1(h: Expr, rest: List[Expr], k: Int, i: Int): List[Expr] =
  h match {
    case Expr.ENamed(_, _) => copyOverridePos(rest, k, i)
    case _ => if (i == k) h :: noExpr() else copyOverridePos(rest, k, i + 1)
  }

def emitCopyPackHit(hit: List[Expr], code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool]): Slot =
  if (List.isEmpty(hit)) emitCopyKeep(code, args, prefix, en, names, k, strs, defs, ens, ps, loc, vals, owns) else emitCopyArg(List.at(hit, 0), code, args, prefix, en, names, k, strs, defs, ens, ps, loc, vals, owns)

def emitCopyKeep(code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool]): Slot =
  emitCopyPack(join(code, copyKeepLoad(prefix, k)), args, prefix, en, names, k + 1, strs, defs, ens, ps, loc, pct(prefix, Str.concat("k", Str.fromInt(k))) :: vals, false :: owns)

def copyKeepLoad(prefix: String, k: Int): String =
  copyKeepLoad2(tmp(prefix, Str.concat("k", Str.fromInt(k))), pct(prefix, "pl"), Str.fromInt(k))

def copyKeepLoad2(lhs: String, pl: String, k: String): String =
  line(Str.concat(lhs, Str.concat("call ptr @sz_list_at(ptr ", Str.concat(pl, Str.concat(", i64 ", Str.concat(k, ")"))))))

def emitCopyArg(e: Expr, code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool]): Slot =
  emitCopyArg2(emitExpr(e, Str.concat(prefix, Str.concat("_u", Str.fromInt(k))), strs, defs, ens, ps, loc), code, args, prefix, en, names, k, strs, defs, ens, ps, loc, vals, owns)

def emitCopyArg2(s: Slot, code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool]): Slot =
  s match {
    case Slot(ec, ev, eo) => if (!eo && (isI64Lit(ev) || isIntSsa(ev))) emitCopyArgBox(ec, ev, code, args, prefix, en, names, k, strs, defs, ens, ps, loc, vals, owns) else emitCopyPack(join(code, ec), args, prefix, en, names, k + 1, strs, defs, ens, ps, loc, ev :: vals, eo :: owns)
  }

def emitCopyArgBox(ec: String, ev: String, code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool]): Slot =
  emitCopyPack(join(code, join(ec, copyArgBox(prefix, k, ev))), args, prefix, en, names, k + 1, strs, defs, ens, ps, loc, pct(prefix, Str.concat("ub", Str.fromInt(k))) :: vals, true :: owns)

def copyArgBox(prefix: String, k: Int, ev: String): String =
  line(Str.concat(tmp(prefix, Str.concat("ub", Str.fromInt(k))), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(ev, ")"))))

def emitCtorOrQual(en: String, name: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (isEmitKit(Str.concat(en, Str.concat(".", name)))) emitCall(Str.concat(en, Str.concat(".", name)), args, prefix, strs, defs, ens, ps, loc) else if (hasEn(ens, en)) emitPayloadCtor(en, name, args, prefix, strs, defs, ens, ps, loc) else emitQual(en, name, args, prefix, strs, defs, ens, ps, loc)

def isEmitKit(f: String): Bool =
  isUiKit(f) || f == "List.setAt" || f == "List.join" || kitUnaryPtr(f) != "" || kitUnaryI64(f) != "" || kitPtrI64(f) != "" || kitBinaryPtr(f) != "" || kitBinaryI64(f) != "" || isJsonExtra(f) || isRtExtra(f) || isMapKit(f) || f == "Map.empty" || f == "Set.empty" || f == "List.empty" || f == "Str.replace" || f == "Str.padLeft" || f == "Str.padRight" || f == "Map.set" || f == "Set.add" || f == "Map.getOrElse" || f == "Clock.monotonic" || f == "Clock.realTime" || f == "Fs.mkdirs" || f == "Fs.canonicalize" || f == "Fs.exists" || f == "Fs.walk" || f == "Fs.delete" || f == "List.len" || f == "List.concat" || f == "List.reverse" || f == "List.head" || f == "List.tail" || f == "List.isEmpty" || f == "List.cons" || f == "List.at" || f == "Str.fromInt" || f == "Str.fromBool" || f == "Str.concat" || f == "Str.len" || f == "Str.byteLen" || f == "Str.byteSlice" || f == "Fs.read" || f == "Fs.write" || f == "Fs.list" || f == "IO.pure" || f == "Sys.getenv" || f == "Impurity.runKit" || f == "Net.serveOnce" || f == "Net.serve" || isNetEmit(f) || f == "Queue.unbounded" || f == "Deferred.empty" || f == "Float.toInt" || f == "Float.fromInt" || f == "Map.isEmpty" || f == "Set.isEmpty" || f == "Map.nonEmpty" || f == "Set.nonEmpty" || f == "List.range" || f == "List.fill" || f == "List.getOrElse" || f == "List.padTo" || f == "List.max" || f == "List.min" || f == "List.sort" || f == "List.toSet" || f == "List.slice" || f == "List.isDefinedAt" || f == "List.lengthCompare" || f == "List.tabulate" || f == "List.segmentLength" || isTlKit(f) || f == "Oracle.sumTo" || f == "Fs.rename" || f == "Random.nextInt"

def isNetEmit(f: String): Bool =
  f == "Net.httpPost" || f == "Net.httpPut" || f == "Net.httpPatch" || f == "Net.tcpConnect" || f == "Net.tcpListen" || f == "Net.tcpAccept" || f == "Net.tcpRead" || f == "Net.tcpWrite" || f == "Net.tcpClose" || f == "Net.udpBind" || f == "Net.udpSend" || f == "Net.udpRecv" || f == "Net.udpClose"

def isUiKit(f: String): Bool =
  Str.startsWith(f, "View.") || Str.startsWith(f, "Signal.") || Str.startsWith(f, "Color.") || Str.startsWith(f, "Theme.") || Str.startsWith(f, "Property.") || Str.startsWith(f, "Ui.")

def emitQual(en: String, name: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitQual2(en, name, emitArgList(alignFill(funParamsOfHit(findDefMod(defs, en, name)), args), prefix, strs, defs, ens, ps, loc, 0, "", noStr(), noBool()), prefix, defs)

def emitQual2(en: String, name: String, p: (String, List[String], List[Bool]), prefix: String, defs: List[Fun]): Slot =
  p match {
    case (code, vals, owns) => emitUserMod(en, name, code, vals, owns, prefix, defs)
  }

def findDefMod(funs: List[Fun], mod: String, name: String): List[Fun] =
  if (List.isEmpty(funs)) noFun() else findDefMod1(List.at(funs, 0), List.tail(funs), mod, name)

def findDefMod1(h: Fun, rest: List[Fun], mod: String, name: String): List[Fun] =
  h match {
    case Fun(priv, n, ts, ps, ret, body, m, off) => if (n == name && m == mod) Fun(priv, n, ts, ps, ret, body, m, off) :: findDefMod(rest, mod, name) else findDefMod(rest, mod, name)
  }

def emitUserMod(en: String, name: String, code: String, vals: List[String], owns: List[Bool], prefix: String, defs: List[Fun]): Slot =
  emitUserHit(Str.concat(en, Str.concat("_", name)), code, vals, owns, prefix, findDefMod(defs, en, name))

def emitPayloadCtor(en: String, name: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(args)) emitCtor(en, name, prefix, ens) else emitPayloadCtorRest(en, name, List.at(args, 0), List.tail(args), prefix, strs, defs, ens, ps, loc)

def emitPayloadCtorRest(en: String, name: String, h: Expr, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(rest)) emitPayloadCtor1(emitExpr(h, Str.concat(prefix, "_ap"), strs, defs, ens, ps, loc), en, name, prefix, ens, ps) else emitPayloadCtorN(en, name, emitArgList(h :: rest, prefix, strs, defs, ens, ps, loc, 0, "", noStr(), noBool()), h :: rest, prefix, ens, ps, defs)

def emitPayloadCtorN(en: String, name: String, p: (String, List[String], List[Bool]), args: List[Expr], prefix: String, ens: List[En], ps: List[Param], defs: List[Fun]): Slot =
  p match {
    case (code, vals, owns) => if (List.len(vals) == 1) emitPayloadCtor1(Slot(code, arg0(vals), headOwn(owns)), en, name, prefix, ens, ps) else emitPayJoin(code, emitPack(vals, owns, args, prefix, 0, List.len(vals), ps, defs), en, name, prefix, ens)
  }

def emitPayJoin(code: String, pack: Slot, en: String, name: String, prefix: String, ens: List[En]): Slot =
  pack match {
    case Slot(pc, pv, _) => emitPay2(join(code, pc), pv, en, name, prefix, ens)
  }

def emitPay2(pc: String, pv: String, en: String, name: String, prefix: String, ens: List[En]): Slot =
  Slot(join(pc, join(emitAdtNew(prefix, ctorTag(ens, en, name), pv), relPtr(pv))), pct(prefix, "adt"), true)

def emitPayloadCtor1(arg: Slot, en: String, name: String, prefix: String, ens: List[En], ps: List[Param]): Slot =
  if (payloadIsInt(arg, fieldTy(ens, Str.concat(en, Str.concat(".", name))), ps)) emitPayloadInt(arg, en, name, prefix, ens) else emitPayloadPtr(arg, en, name, prefix, ens)

def payloadIsInt(arg: Slot, ft: String, ps: List[Param]): Bool =
  arg match {
    case Slot(_, v, o) => isI64Ty(ft) || !o && (isIntSsa(v) || isI64ParamVal(v, ps) || Str.len(v) > 0 && Str.charAt(v, 0) != 37 && v != "null")
  }

def emitPayloadInt(arg: Slot, en: String, name: String, prefix: String, ens: List[En]): Slot =
  Slot(join(arg.code, join(emitBoxI64(prefix, arg.val), join(emitAdtNew(prefix, ctorTag(ens, en, name), pct(prefix, "box")), relPtr(pct(prefix, "box"))))), pct(prefix, "adt"), true)

def emitPayloadPtr(arg: Slot, en: String, name: String, prefix: String, ens: List[En]): Slot =
  Slot(join(arg.code, join(emitAdtNew(prefix, ctorTag(ens, en, name), arg.val), if (arg.owned) relPtr(arg.val) else "")), pct(prefix, "adt"), true)

def emitBoxI64(prefix: String, v: String): String =
  line(Str.concat(tmp(prefix, "box"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(v, ")"))))

def emitAdtNew(prefix: String, tag: Int, payload: String): String =
  line(Str.concat(tmp(prefix, "adt"), Str.concat("call ptr @sz_adt_new(i32 ", Str.concat(Str.fromInt(tag), Str.concat(", ptr ", Str.concat(payload, ")"))))))

def emitCtor(en: String, name: String, prefix: String, ens: List[En]): Slot =
  Slot(emitAdtNew(prefix, ctorTag(ens, en, name), "null"), pct(prefix, "adt"), true)

def ctorTag(ens: List[En], en: String, name: String): Int =
  if (en == "Option") optionTag(name) else if (en == "Result") resultTag(name) else if (en == "Json") jsonTag(name) else ctorTagAt(ens, en, name, 0)

def optionTag(name: String): Int =
  if (name == "Some") 1 else 0

def resultTag(name: String): Int =
  if (name == "Ok") 1 else 0

def jsonTag(name: String): Int =
  if (name == "Bool") 1 else if (name == "Int") 2 else if (name == "Float") 3 else if (name == "Str") 4 else if (name == "Arr") 5 else if (name == "Obj") 6 else 0

def ctorTagAt(ens: List[En], en: String, name: String, i: Int): Int =
  if (i >= List.len(ens)) 0 else ctorTagHit(List.at(ens, i), ens, en, name, i)

def ctorTagHit(h: En, ens: List[En], en: String, name: String, i: Int): Int =
  h match {
    case En(_, n, _, cases) => if (n == en) caseTag(cases, name, 0) else ctorTagAt(ens, en, name, i + 1)
  }

def caseTag(cs: List[EnCase], name: String, i: Int): Int =
  if (i >= List.len(cs)) 0 else caseTagHit(List.at(cs, i), cs, name, i)

def caseTagHit(c: EnCase, cs: List[EnCase], name: String, i: Int): Int =
  if (c.name == name) i else caseTag(cs, name, i + 1)

def dotAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 46) i else dotAt(s, i + 1)

def patTag(pat: String, ens: List[En]): Int =
  patTag2(dotAt(patCore(pat), 0), patCore(pat), ens)

def patCore(pat: String): String =
  patCore2(parenAt(pat, 0), pat)

def patCore2(p: Int, pat: String): String =
  if (p < 0) pat else Str.slice(pat, 0, p)

def parenAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 40) i else parenAt(s, i + 1)

def patBind(pat: String): String =
  patBind2(parenAt(pat, 0), pat)

def patBind2(p: Int, pat: String): String =
  if (p < 0) "" else Str.slice(pat, p + 1, Str.len(pat) - 1)

def fieldTy(ens: List[En], core: String): String =
  fieldTy2(dotAt(core, 0), core, ens)

def fieldTy2(dot: Int, core: String, ens: List[En]): String =
  if (dot < 0) fieldTyBare(core, ens) else caseFieldTy(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def fieldTyBare(core: String, ens: List[En]): String =
  if (enOfCase(ens, core) == "") recFirstTy(ens, core) else caseFieldTy(ens, enOfCase(ens, core), core)

def recFirstTy(ens: List[En], name: String): String =
  if (List.isEmpty(ens)) "" else recFirstTy1(List.at(ens, 0), List.tail(ens), name)

def recFirstTy1(h: En, rest: List[En], name: String): String =
  h match {
    case En(_, n, _, cases) => if (n == name) recFirstTy2(cases) else recFirstTy(rest, name)
  }

def recFirstTy2(cs: List[EnCase]): String =
  if (List.isEmpty(cs)) "" else recFirstTy3(List.at(cs, 0))

def recFirstTy3(c: EnCase): String =
  c match {
    case EnCase(_, fs) => firstFieldTy(fs)
  }

def caseFieldTy(ens: List[En], en: String, ctor: String): String =
  if (en == "Json") jsonFieldTy(ctor) else if (List.isEmpty(ens)) "" else caseFieldTy1(List.at(ens, 0), List.tail(ens), en, ctor)

def jsonFieldTy(ctor: String): String =
  if (ctor == "Int" || ctor == "Bool") "Int" else if (ctor == "Float") "Float" else if (ctor == "Str") "String" else "List"

def caseFieldTy1(h: En, rest: List[En], en: String, ctor: String): String =
  h match {
    case En(_, name, _, cases) => if (name == en) caseFieldTy2(cases, ctor) else caseFieldTy(rest, en, ctor)
  }

def caseFieldTy2(cs: List[EnCase], ctor: String): String =
  if (List.isEmpty(cs)) "" else caseFieldTy3(List.at(cs, 0), List.tail(cs), ctor)

def caseFieldTy3(h: EnCase, rest: List[EnCase], ctor: String): String =
  h match {
    case EnCase(name, fields) => if (name == ctor) firstFieldTy(fields) else caseFieldTy2(rest, ctor)
  }

def payloadTys(ens: List[En], core: String): List[String] =
  payloadTys2(dotAt(core, 0), core, ens)

def payloadTys2(dot: Int, core: String, ens: List[En]): List[String] =
  if (dot < 0) recTys(ens, core) else caseTys(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def caseTys(ens: List[En], en: String, ctor: String): List[String] =
  if (List.isEmpty(ens)) noStr() else caseTys1(List.at(ens, 0), List.tail(ens), en, ctor)

def caseTys1(h: En, rest: List[En], en: String, ctor: String): List[String] =
  h match {
    case En(_, name, _, cases) => if (name == en) caseTys2(cases, ctor) else caseTys(rest, en, ctor)
  }

def caseTys2(cs: List[EnCase], ctor: String): List[String] =
  if (List.isEmpty(cs)) noStr() else caseTys3(List.at(cs, 0), List.tail(cs), ctor)

def caseTys3(h: EnCase, rest: List[EnCase], ctor: String): List[String] =
  h match {
    case EnCase(name, fields) => if (name == ctor) paramTys(fields) else caseTys2(rest, ctor)
  }

def firstFieldTy(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else paramTyOf(List.at(ps, 0))

def paramTyOf(p: Param): String =
  p match {
    case Param(_, ty, _, _) => ty
  }

def bindIsInt(pat: String, ens: List[En]): Bool =
  payloadIntTy(fieldTy(ens, patCore(pat)), ens)

def payloadIntTy(ft: String, ens: List[En]): Bool =
  isI64Ty(ft) || ft != "" && !isPtrName(ft, ens) && !isTyParam(ft)

def isTyParam(ft: String): Bool =
  Str.len(ft) == 1 && Str.charAt(ft, 0) >= 65 && Str.charAt(ft, 0) <= 90

def isPtrName(ft: String, ens: List[En]): Bool =
  ft == "String" || ft == "Float" || Str.startsWith(ft, "List") || Str.startsWith(ft, "IO") || hasEn(ens, tyHead(ft))

def tyHead(ft: String): String =
  tyHeadAt(ft, 0)

def tyHeadAt(ft: String, i: Int): String =
  if (i >= Str.len(ft)) ft else if (Str.charAt(ft, i) == 91) Str.slice(ft, 0, i) else tyHeadAt(ft, i + 1)

def fpre(prefix: String, i: Int): String =
  Str.concat(ppre(prefix, i), Str.concat("_f", sid(i)))

def bindStem(prefix: String, i: Int, isInt: Bool): String =
  Str.concat(fpre(prefix, i), if (isInt) "_b0" else "_pl")

def patTag2(dot: Int, pat: String, ens: List[En]): Int =
  if (dot < 0) ctorTag(ens, enOfCase(ens, pat), pat) else ctorTag(ens, Str.slice(pat, 0, dot), Str.slice(pat, dot + 1, Str.len(pat)))

def emitMatch(s: Expr, arms: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  s match {
    case Expr.EVar(n, _) => emitMatchV(n, arms, prefix, strs, defs, ens, ps, loc)
    case _ => emitMatch1(emitExpr(s, Str.concat(prefix, "_sc"), strs, defs, ens, ps, loc), arms, prefix, strs, defs, ens, ps, loc, matchSlots(exprRetTy(s, defs, ps)), exprIsI64(s, ps, defs))
  }

def emitMatchV(n: String, arms: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitMatch1(emitExpr(Expr.EVar(n, 0), Str.concat(prefix, "_sc"), strs, defs, ens, ps, loc), arms, prefix, strs, defs, ens, ps, loc, matchSlots(paramTy(ps, n)), paramIsI64(ps, n))

def matchSlots(ty: String): List[String] =
  if (isTupTy(ty)) tupSlots(ty) else listElemSlots(ty)

def listElemSlots(ty: String): List[String] =
  if (Str.startsWith(ty, "List[") && Str.len(ty) > 6) Str.slice(ty, 5, Str.len(ty) - 1) :: noStr() else noStr()

def paramTy(ps: List[Param], n: String): String =
  if (List.isEmpty(ps)) "" else paramTy1(List.at(ps, 0), List.tail(ps), n)

def paramTy1(p: Param, rest: List[Param], n: String): String =
  p match {
    case Param(name, ty, _, _) => if (name == n) ty else paramTy(rest, n)
  }

def tupSlots(ty: String): List[String] =
  if (!isTupTy(ty)) noStr() else splitPat(Str.slice(ty, 1, Str.len(ty) - 1))

def slotInt(tys: List[String], k: Int): Bool =
  if (List.isEmpty(tys)) false else if (k <= 0) isI64Ty(List.at(tys, 0)) else slotInt(List.tail(tys), k - 1)

def emitMatch1(se: Slot, arms: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, tys: List[String], asI64: Bool): Slot =
  se match {
    case Slot(sc, sv, _) => emitMatchOksFirst(sc, emitOks(arms, prefix, strs, defs, ens, ps, loc, 0, tys, sv, asI64), arms, prefix, sv, ens, strs, tys)
  }

def emitMatchOksFirst(sc: String, oks: (String, List[String], Bool), arms: List[Arm], prefix: String, sv: String, ens: List[En], strs: List[String], tys: List[String]): Slot =
  emitMatch2(sc, emitTries(arms, prefix, sv, ens, strs, 0, tys), oks, prefix, isExh(arms))

def isExh(arms: List[Arm]): Bool =
  if (List.isEmpty(arms)) false else isExh2(List.at(arms, 0), List.tail(arms))

def isExh2(h: Arm, t: List[Arm]): Bool =
  if (List.isEmpty(t)) isWild(h) else isExh(t)

def isWild(arm: Arm): Bool =
  arm match {
    case Arm(pat, _, _) => pat == "_"
  }

def emitMatch2(sc: String, tries: String, oks: (String, List[String], Bool), prefix: String, exh: Bool): Slot =
  oks match {
    case (okCode, vals, owned) => emitMatch3(sc, tries, okCode, vals, owned, prefix, exh)
  }

def emitMatch3(sc: String, tries: String, okCode: String, vals: List[String], owned: Bool, prefix: String, exh: Bool): Slot =
  Slot(join(sc, join(brTry(prefix), join(tries, join(emitDefault(prefix, owned, exh), join(okCode, emitMatchPhi(vals, owned, prefix, exh)))))), pct(prefix, "phi"), owned)

def brTry(prefix: String): String =
  line(Str.concat("br label %", Str.concat(prefix, "_try_0_0")))

def emitDefault(prefix: String, owned: Bool, exh: Bool): String =
  if (exh) join(lab(Str.concat(prefix, "_default_0")), line("unreachable")) else if (owned) join(lab(Str.concat(prefix, "_default_0")), line(Str.concat("br label %", Str.concat(prefix, "_merge_0")))) else join(lab(Str.concat(prefix, "_default_0")), join(line(Str.concat(tmp(prefix, "dflt"), "add i64 0, 0")), line(Str.concat("br label %", Str.concat(prefix, "_merge_0")))))

def emitTries(arms: List[Arm], prefix: String, scrut: String, ens: List[En], strs: List[String], i: Int, tys: List[String]): String =
  if (List.isEmpty(arms)) "" else emitTries2(List.at(arms, 0), List.tail(arms), prefix, scrut, ens, strs, i, tys)

def emitTries2(arm: Arm, rest: List[Arm], prefix: String, scrut: String, ens: List[En], strs: List[String], i: Int, tys: List[String]): String =
  if (List.isEmpty(rest)) emitTry1(arm, prefix, scrut, ens, strs, i, true, tys) else join(emitTry1(arm, prefix, scrut, ens, strs, i, false, tys), emitTries(rest, prefix, scrut, ens, strs, i + 1, tys))

def emitTry1(arm: Arm, prefix: String, scrut: String, ens: List[En], strs: List[String], i: Int, last: Bool, tys: List[String]): String =
  arm match {
    case Arm(pat, _, _) => join(lab(tryLab(prefix, i)), emitTryPat(pat, prefix, i, scrut, ens, strs, last, tys))
  }

def emitTryPat(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], strs: List[String], last: Bool, tys: List[String]): String =
  if (isAsPat(pat)) emitTryPat(stripAs(pat), prefix, i, scrut, ens, strs, last, tys) else emitTryPat2(pat, prefix, i, scrut, ens, strs, last, tys)

def emitTryPat2(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], strs: List[String], last: Bool, tys: List[String]): String =
  if (pat == "_") line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i))))) else if (pat == "[]") emitNilTry(prefix, i, scrut, last) else if (isConsPat(pat)) emitConsTry(prefix, i, scrut, last, slotInt(tys, 0), consTail(pat)) else if (isOrPat(pat)) emitOrTry(pat, prefix, i, scrut, ens, strs, last) else if (isStrPat(pat)) emitStrTry(pat, prefix, i, scrut, strs, last) else if (isIntPat(pat)) emitIntTry(pat, prefix, i, scrut, last) else if (isBoolPat(pat)) emitIntTry(boolPatLit(pat), prefix, i, scrut, last) else if (isTuplePat(pat)) emitTupleTry(prefix, i, scrut, tys) else if (isVarPat(pat, ens)) line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i))))) else if (isConsPat(patBind(pat))) emitCtorConsTry(pat, prefix, i, scrut, ens, last, tys) else join(emitTag(prefix, i, scrut, patTag(pat, ens)), join(emitTagBr(prefix, i, last), emitMatchedPat(pat, prefix, i, scrut, ens)))

def emitCtorConsTry(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], last: Bool, tys: List[String]): String =
  join(emitTag(prefix, i, scrut, patTag(pat, ens)), join(emitTagBr(prefix, i, last), emitCtorConsM(pat, prefix, i, scrut, last, tys)))

def emitCtorConsM(pat: String, prefix: String, i: Int, scrut: String, last: Bool, tys: List[String]): String =
  join(lab(Str.concat(ppre(prefix, i), Str.concat("_m", sid(i)))), join(emitPayload2(prefix, i, scrut, false), emitConsTry(prefix, i, pct(fpre(prefix, i), "pl"), last, slotInt(tys, 0), consTail(patBind(pat)))))

def isConsPat(pat: String): Bool =
  consAt(pat, 0) >= 0

def consAt(s: String, i: Int): Int =
  consAtD(s, i, 0)

def consAtD(s: String, i: Int, d: Int): Int =
  if (i + 4 > Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 40) consAtD(s, i + 1, d + 1) else if (Str.charAt(s, i) == 41) consAtD(s, i + 1, if (d > 0) d - 1 else 0) else if (d == 0 && Str.slice(s, i, i + 4) == " :: ") i else consAtD(s, i + 1, d)

def consHead(pat: String): String =
  Str.slice(pat, 0, consAt(pat, 0))

def consTail(pat: String): String =
  Str.slice(pat, consAt(pat, 0) + 4, Str.len(pat))

def emitNilTry(prefix: String, i: Int, scrut: String, last: Bool): String =
  join(line(Str.concat(tmp(ppre(prefix, i), "ne"), Str.concat("call i32 @sz_list_is_empty(ptr ", Str.concat(scrut, ")")))), join(line(Str.concat(tmp(ppre(prefix, i), "nc"), Str.concat("icmp ne i32 ", Str.concat(pct(ppre(prefix, i), "ne"), ", 0")))), line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), "nc"), Str.concat(", label %", Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), Str.concat(", label %", nextLab(prefix, i, last)))))))))))

def emitConsTry(prefix: String, i: Int, scrut: String, last: Bool, unbox: Bool, tail: String): String =
  join(emitConsEmpty(prefix, i, scrut), join(emitConsBr(prefix, i, last), join(lab(Str.concat(ppre(prefix, i), "_cm")), join(emitConsLoad(prefix, i, scrut, unbox), emitConsAfterLoad(tail, prefix, i, last)))))

def emitConsAfterLoad(tail: String, prefix: String, i: Int, last: Bool): String =
  if (tail == "[]") emitConsTailNil(prefix, i, last) else emitConsOk(prefix, i)

def emitConsTailNil(prefix: String, i: Int, last: Bool): String =
  join(line(Str.concat(tmp(ppre(prefix, i), "te"), Str.concat("call i32 @sz_list_is_empty(ptr ", Str.concat(pct(ppre(prefix, i), "ct"), ")")))), join(line(Str.concat(tmp(ppre(prefix, i), "tn"), Str.concat("icmp ne i32 ", Str.concat(pct(ppre(prefix, i), "te"), ", 0")))), line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), "tn"), Str.concat(", label %", Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), Str.concat(", label %", nextLab(prefix, i, last)))))))))))

def emitConsEmpty(prefix: String, i: Int, scrut: String): String =
  join(line(Str.concat(tmp(ppre(prefix, i), "ce"), Str.concat("call i32 @sz_list_is_empty(ptr ", Str.concat(scrut, ")")))), line(Str.concat(tmp(ppre(prefix, i), "cc"), Str.concat("icmp eq i32 ", Str.concat(pct(ppre(prefix, i), "ce"), ", 0")))))

def emitConsBr(prefix: String, i: Int, last: Bool): String =
  line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), "cc"), Str.concat(", label %", Str.concat(ppre(prefix, i), Str.concat("_cm, label %", nextLab(prefix, i, last)))))))

def emitConsLoad(prefix: String, i: Int, scrut: String, unbox: Bool): String =
  join(line(Str.concat(tmp(ppre(prefix, i), "ch"), Str.concat("call ptr @sz_list_head(ptr ", Str.concat(scrut, ")")))), join(line(Str.concat(tmp(ppre(prefix, i), "ct"), Str.concat("call ptr @sz_list_tail(ptr ", Str.concat(scrut, ")")))), if (unbox) line(Str.concat(tmp(ppre(prefix, i), "cu"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(ppre(prefix, i), "ch"), ")")))) else ""))

def emitConsOk(prefix: String, i: Int): String =
  line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))))

def isTuplePat(pat: String): Bool =
  Str.len(pat) > 0 && Str.charAt(pat, 0) == 40

def emitTupleTry(prefix: String, i: Int, scrut: String, tys: List[String]): String =
  emitTuplePeel(ppre(prefix, i), i + 1, scrut, tys, prefix, i, true)

def emitTuplePeel(pre: String, sid: Int, scrut: String, tys: List[String], armPrefix: String, armI: Int, fin: Bool): String =
  join(peelLeft(pre, sid, scrut), join(peelRight(pre, sid, scrut), join(peelBrTn(pre, sid), join(peelTnLab(pre, sid), emitTupleCont(pre, sid, tys, armPrefix, armI, fin)))))

def emitTupleCont(pre: String, sid: Int, tys: List[String], armPrefix: String, armI: Int, fin: Bool): String =
  join(if (slotInt(tys, 0)) peelUnboxL(pre, sid) else "", emitTupleRest(pre, sid, tys, armPrefix, armI, fin))

def emitTupleRest(pre: String, sid: Int, tys: List[String], armPrefix: String, armI: Int, fin: Bool): String =
  join(emitNest(pre, sid, "tl", headTy(tys), armPrefix, armI), emitTupleRest2(pre, sid, tys, armPrefix, armI, fin))

def emitTupleRest2(pre: String, sid: Int, tys: List[String], armPrefix: String, armI: Int, fin: Bool): String =
  if (List.len(tys) > 2) emitTuplePeel(Str.concat(pre, Str.concat("_n", Str.fromInt(sid))), sid + 1, pct(pre, Str.concat("tr", Str.fromInt(sid))), List.tail(tys), armPrefix, armI, fin) else join(emitNest(pre, sid, "tr", secondTy(tys), armPrefix, armI), join(if (slotInt(tys, 1)) peelUnboxR(pre, sid) else "", if (fin) tupleBrOk(armPrefix, armI) else ""))

def emitNest(pre: String, sid: Int, side: String, ty: String, armPrefix: String, armI: Int): String =
  if (!isTupTy(ty)) "" else emitTuplePeel(Str.concat(pre, Str.concat(Str.concat("_", side), Str.fromInt(sid))), 1, pct(pre, Str.concat(side, Str.fromInt(sid))), tupSlots(ty), armPrefix, armI, false)

def headTy(tys: List[String]): String =
  if (List.isEmpty(tys)) "" else List.at(tys, 0)

def secondTy(tys: List[String]): String =
  if (List.isEmpty(tys) || List.isEmpty(List.tail(tys))) "" else List.at(List.tail(tys), 0)

def peelLeft(pre: String, sid: Int, scrut: String): String =
  line(Str.concat(tmp(pre, Str.concat("tl", Str.fromInt(sid))), Str.concat("call ptr @sz_pair_left(ptr ", Str.concat(scrut, ")"))))

def peelRight(pre: String, sid: Int, scrut: String): String =
  line(Str.concat(tmp(pre, Str.concat("tr", Str.fromInt(sid))), Str.concat("call ptr @sz_pair_right(ptr ", Str.concat(scrut, ")"))))

def peelBrTn(pre: String, sid: Int): String =
  line(Str.concat("br label %", Str.concat(pre, Str.concat("_tn", Str.fromInt(sid)))))

def peelTnLab(pre: String, sid: Int): String =
  lab(Str.concat(pre, Str.concat("_tn", Str.fromInt(sid))))

def peelUnboxL(pre: String, sid: Int): String =
  line(Str.concat(tmp(pre, Str.concat("tvl", Str.fromInt(sid))), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(pre, Str.concat("tl", Str.fromInt(sid))), ")"))))

def peelUnboxR(pre: String, sid: Int): String =
  line(Str.concat(tmp(pre, Str.concat("tv", Str.fromInt(sid))), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(pre, Str.concat("tr", Str.fromInt(sid))), ")"))))

def tupleBrOk(prefix: String, i: Int): String =
  line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))))

def isStrPat(pat: String): Bool =
  Str.len(pat) >= 2 && Str.charAt(pat, 0) == 34

def isIntPat(pat: String): Bool =
  if (Str.len(pat) == 0) false else isIntPat2(pat, if (Str.charAt(pat, 0) == 45) 1 else 0)

def isIntPat2(pat: String, i: Int): Bool =
  if (i >= Str.len(pat)) i > 0 && (Str.charAt(pat, 0) != 45 || Str.len(pat) > 1) else if (Str.charAt(pat, i) >= 48 && Str.charAt(pat, i) <= 57) isIntPat2(pat, i + 1) else false

def isBoolPat(pat: String): Bool =
  pat == "true" || pat == "false"

def boolPatLit(pat: String): String =
  if (pat == "true") "1" else "0"

def isAsPat(pat: String): Bool =
  asAt(pat, 0) >= 0

def asAt(s: String, i: Int): Int =
  asAtD(s, i, 0)

def asAtD(s: String, i: Int, d: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 40) asAtD(s, i + 1, d + 1) else if (Str.charAt(s, i) == 41) asAtD(s, i + 1, if (d > 0) d - 1 else 0) else if (d == 0 && i + 3 <= Str.len(s) && Str.slice(s, i, i + 3) == " @ ") i else asAtD(s, i + 1, d)

def asName(pat: String): String =
  Str.slice(pat, 0, asAt(pat, 0))

def stripAs(pat: String): String =
  Str.slice(pat, asAt(pat, 0) + 3, Str.len(pat))

def ssaName(v: String): String =
  if (Str.len(v) > 0 && Str.charAt(v, 0) == 37) Str.slice(v, 1, Str.len(v)) else v

def isOrPat(pat: String): Bool =
  orAt(pat, 0) >= 0

def orAt(s: String, i: Int): Int =
  orAtD(s, i, 0)

def orAtD(s: String, i: Int, d: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 40) orAtD(s, i + 1, d + 1) else if (Str.charAt(s, i) == 41) orAtD(s, i + 1, if (d > 0) d - 1 else 0) else if (d == 0 && i + 3 <= Str.len(s) && Str.slice(s, i, i + 3) == " | ") i else orAtD(s, i + 1, d)

def orLeft(pat: String): String =
  Str.slice(pat, 0, orAt(pat, 0))

def orRight(pat: String): String =
  Str.slice(pat, orAt(pat, 0) + 3, Str.len(pat))

def emitOrTry(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], strs: List[String], last: Bool): String =
  if (isIntPat(orLeft(pat)) && isIntPat(orRight(pat))) emitOrInt(orLeft(pat), orRight(pat), prefix, i, scrut, last) else if (isStrPat(orLeft(pat))) emitOrStr(pat, prefix, i, scrut, ens, strs, last) else emitOrTag(orLeft(pat), orRight(pat), prefix, i, scrut, ens, last)

def emitOrStr(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], strs: List[String], last: Bool): String =
  join(emitStrTry3(unquote(orLeft(pat)), prefix, i, Str.concat("o", Str.fromInt(orAt(pat, 0))), scrut, strIndex(strs, unquote(orLeft(pat)), 0), orFailLab(prefix, i, orAt(pat, 0))), join(lab(orFailLab(prefix, i, orAt(pat, 0))), emitTryPat2(orRight(pat), prefix, i, scrut, ens, strs, last, noStr())))

def orFailLab(prefix: String, i: Int, k: Int): String =
  Str.concat(ppre(prefix, i), Str.concat("_orf", Str.fromInt(k)))

def emitOrInt(a: String, b: String, prefix: String, i: Int, scrut: String, last: Bool): String =
  join(line(Str.concat(tmp(ppre(prefix, i), "oa"), Str.concat("icmp eq i64 ", Str.concat(scrut, Str.concat(", ", a))))), join(line(Str.concat(tmp(ppre(prefix, i), "ob"), Str.concat("icmp eq i64 ", Str.concat(scrut, Str.concat(", ", b))))), join(line(Str.concat(tmp(ppre(prefix, i), "or"), Str.concat("or i1 ", Str.concat(pct(ppre(prefix, i), "oa"), Str.concat(", ", pct(ppre(prefix, i), "ob")))))), line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), "or"), Str.concat(", label %", Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), Str.concat(", label %", nextLab(prefix, i, last))))))))))))

def emitOrTag(a: String, b: String, prefix: String, i: Int, scrut: String, ens: List[En], last: Bool): String =
  join(orTagLoad(prefix, i, scrut), join(orTagCmp(a, b, prefix, i, ens), join(orTagBr(prefix, i, last), emitMatchedPat(a, prefix, i, scrut, ens))))

def orTagLoad(prefix: String, i: Int, scrut: String): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("tg", sid(i))), Str.concat("call i32 @sz_adt_tag(ptr ", Str.concat(scrut, ")"))))

def orTagCmp(a: String, b: String, prefix: String, i: Int, ens: List[En]): String =
  join(line(Str.concat(tmp(ppre(prefix, i), "oa"), Str.concat("icmp eq i32 ", Str.concat(pct(ppre(prefix, i), Str.concat("tg", sid(i))), Str.concat(", ", Str.fromInt(patTag(a, ens))))))), join(line(Str.concat(tmp(ppre(prefix, i), "ob"), Str.concat("icmp eq i32 ", Str.concat(pct(ppre(prefix, i), Str.concat("tg", sid(i))), Str.concat(", ", Str.fromInt(patTag(b, ens))))))), line(Str.concat(tmp(ppre(prefix, i), "or"), Str.concat("or i1 ", Str.concat(pct(ppre(prefix, i), "oa"), Str.concat(", ", pct(ppre(prefix, i), "ob"))))))))

def orTagBr(prefix: String, i: Int, last: Bool): String =
  line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), "or"), Str.concat(", label %", Str.concat(ppre(prefix, i), Str.concat("_m", Str.concat(sid(i), Str.concat(", label %", nextLab(prefix, i, last)))))))))

def unquote(pat: String): String =
  Str.slice(pat, 1, Str.len(pat) - 1)

def emitStrTry(pat: String, prefix: String, i: Int, scrut: String, strs: List[String], last: Bool): String =
  emitStrTry2(unquote(pat), prefix, i, scrut, strs, last)

def emitStrTry2(s: String, prefix: String, i: Int, scrut: String, strs: List[String], last: Bool): String =
  emitStrTry3(s, prefix, i, "", scrut, strIndex(strs, s, 0), nextLab(prefix, i, last))

def emitStrTry3(s: String, prefix: String, i: Int, tag: String, scrut: String, idx: Int, fail: String): String =
  join(strGep(s, prefix, i, tag, idx), join(strLit(prefix, i, tag), join(strEqi(prefix, i, tag, scrut), join(relPtr(pct(ppre(prefix, i), Str.concat("slit", Str.concat(sid(i), tag)))), join(strSeq(prefix, i, tag), strBrTo(prefix, i, tag, fail))))))

def strGep(s: String, prefix: String, i: Int, tag: String, idx: Int): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("sgep", Str.concat(sid(i), tag))), Str.concat("getelementptr inbounds [", Str.concat(Str.fromInt(strArr(s)), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(idx), ", i64 0, i64 0"))))))

def strLit(prefix: String, i: Int, tag: String): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("slit", Str.concat(sid(i), tag))), Str.concat("call ptr @sz_string_from_cstr(ptr ", Str.concat(pct(ppre(prefix, i), Str.concat("sgep", Str.concat(sid(i), tag))), ")"))))

def strEqi(prefix: String, i: Int, tag: String, scrut: String): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("seqi", Str.concat(sid(i), tag))), Str.concat("call i32 @sz_string_eq(ptr ", Str.concat(scrut, Str.concat(", ptr ", Str.concat(pct(ppre(prefix, i), Str.concat("slit", Str.concat(sid(i), tag))), ")"))))))

def strSeq(prefix: String, i: Int, tag: String): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("seq", Str.concat(sid(i), tag))), Str.concat("icmp ne i32 ", Str.concat(pct(ppre(prefix, i), Str.concat("seqi", Str.concat(sid(i), tag))), ", 0"))))

def strBrTo(prefix: String, i: Int, tag: String, fail: String): String =
  line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), Str.concat("seq", Str.concat(sid(i), tag))), Str.concat(", label %", Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), Str.concat(", label %", fail))))))))

def emitIntTry(pat: String, prefix: String, i: Int, scrut: String, last: Bool): String =
  join(line(Str.concat(tmp(ppre(prefix, i), Str.concat("ieq", sid(i))), Str.concat("icmp eq i64 ", Str.concat(scrut, Str.concat(", ", pat))))), line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), Str.concat("ieq", sid(i))), Str.concat(", label %", Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), Str.concat(", label %", nextLab(prefix, i, last))))))))))

def tryLab(prefix: String, i: Int): String =
  Str.concat(prefix, Str.concat("_try_0_", Str.fromInt(i)))

def nextLab(prefix: String, i: Int, last: Bool): String =
  if (last) Str.concat(prefix, "_default_0") else Str.concat(prefix, Str.concat("_try_0_", Str.fromInt(i + 1)))

def ppre(prefix: String, i: Int): String =
  Str.concat(prefix, Str.concat("_p0_", Str.fromInt(i)))

def sid(i: Int): String =
  Str.fromInt(i + 1)

def emitTag(prefix: String, i: Int, scrut: String, tag: Int): String =
  join(line(Str.concat(tmp(ppre(prefix, i), Str.concat("tg", sid(i))), Str.concat("call i32 @sz_adt_tag(ptr ", Str.concat(scrut, ")")))), line(Str.concat(tmp(ppre(prefix, i), Str.concat("eq", sid(i))), Str.concat("icmp eq i32 ", Str.concat(pct(ppre(prefix, i), Str.concat("tg", sid(i))), Str.concat(", ", Str.fromInt(tag)))))))

def emitTagBr(prefix: String, i: Int, last: Bool): String =
  line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), Str.concat("eq", sid(i))), Str.concat(", label %", Str.concat(ppre(prefix, i), Str.concat("_m", Str.concat(sid(i), Str.concat(", label %", nextLab(prefix, i, last)))))))))

def emitMatchedPat(pat: String, prefix: String, i: Int, scrut: String, ens: List[En]): String =
  join(lab(Str.concat(ppre(prefix, i), Str.concat("_m", sid(i)))), join(emitPayload(pat, prefix, i, scrut, ens), emitMatchedEnd(pat, prefix, i)))

def emitMatchedEnd(pat: String, prefix: String, i: Int): String =
  if (hasComma(patBind(pat)) || isNamedPat(patBind(pat))) join(line(Str.concat("br label %", Str.concat(ppre(prefix, i), Str.concat("_n", Str.concat(sid(i), "_0"))))), join(lab(Str.concat(ppre(prefix, i), Str.concat("_n", Str.concat(sid(i), "_0")))), line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i))))))) else line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))))

def emitPayload(pat: String, prefix: String, i: Int, scrut: String, ens: List[En]): String =
  if (patBind(pat) == "") "" else if (hasComma(patBind(pat)) || namedMulti(pat, ens)) emitPayloadN(prefix, i, scrut, splitPat(patBind(pat)), 0, payloadTys(ens, patCore(pat)), payloadNames(ens, patCore(pat))) else emitPayload2(prefix, i, scrut, bindIsInt(pat, ens))

def emitPayloadN(prefix: String, i: Int, scrut: String, ns: List[String], k: Int, fts: List[String], names: List[String]): String =
  if (k == 0) join(line(Str.concat(tmp(fpre(prefix, i), "pl"), Str.concat("call ptr @sz_adt_payload(ptr ", Str.concat(scrut, ")")))), emitPayloadN(prefix, i, scrut, ns, 1, fts, names)) else if (List.isEmpty(ns)) "" else join(emitFieldAt(prefix, i, fieldIdx(List.at(ns, 0), k - 1, names), slotInt(fts, fieldIdx(List.at(ns, 0), k - 1, names))), emitPayloadN(prefix, i, scrut, List.tail(ns), k + 1, fts, names))

def emitFieldAt(prefix: String, i: Int, k: Int, isInt: Bool): String =
  join(fieldCell(prefix, i, k), if (isInt) fieldUnbox(prefix, i, k) else "")

def fieldCell(prefix: String, i: Int, k: Int): String =
  fieldCell2(tmp(fpre(prefix, i), Str.concat("c", Str.fromInt(k))), pct(fpre(prefix, i), "pl"), Str.fromInt(k))

def fieldCell2(lhs: String, pl: String, k: String): String =
  line(Str.concat(lhs, Str.concat("call ptr @sz_list_at(ptr ", Str.concat(pl, Str.concat(", i64 ", Str.concat(k, ")"))))))

def fieldUnbox(prefix: String, i: Int, k: Int): String =
  fieldUnbox2(tmp(fpre(prefix, i), Str.concat("b", Str.fromInt(k))), pct(fpre(prefix, i), Str.concat("c", Str.fromInt(k))))

def fieldUnbox2(lhs: String, cell: String): String =
  line(Str.concat(lhs, Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(cell, ")"))))

def hasComma(s: String): Bool =
  commaAt(s, 0) >= 0

def emitPayload2(prefix: String, i: Int, scrut: String, isInt: Bool): String =
  join(line(Str.concat(tmp(fpre(prefix, i), "pl"), Str.concat("call ptr @sz_adt_payload(ptr ", Str.concat(scrut, ")")))), if (isInt) line(Str.concat(tmp(fpre(prefix, i), "b0"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(fpre(prefix, i), "pl"), ")")))) else "")

def emitOks(arms: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String, asI64: Bool): (String, List[String], Bool) =
  if (List.isEmpty(arms)) ("", noStr(), false) else emitOks0(List.at(arms, 0), List.tail(arms), prefix, strs, defs, ens, ps, loc, i, tys, sv, asI64)

def emitOks0(arm: Arm, rest: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String, asI64: Bool): (String, List[String], Bool) =
  arm match {
    case Arm(pat, g, body) => emitOks1g(g, pat, emitOkSlotPat(pat, body, prefix, strs, defs, ens, ps, loc, i, tys, sv, asI64), rest, prefix, strs, defs, ens, ps, loc, i, tys, sv, List.isEmpty(rest), asI64)
  }

def emitOkSlotPat(pat: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String, asI64: Bool): Slot =
  if (isAsPat(pat)) emitOkSlotPat(stripAs(pat), rewriteBind(body, asName(pat), ssaName(sv)), prefix, strs, defs, ens, ps, loc, i, tys, sv, asI64) else if (isVarPat(pat, ens)) emitOkVar(pat, body, prefix, strs, defs, ens, ps, loc, i, sv, asI64) else emitOkSlotPat2(pat, body, prefix, strs, defs, ens, ps, loc, i, tys)

def isVarPat(pat: String, ens: List[En]): Bool =
  isSimpleBind(pat) && !isOrPat(pat) && !isTuplePat(pat) && dotAt(pat, 0) < 0 && pat != "_" && pat != "[]" && enOfCase(ens, patCore(pat)) == "" && !isIntPat(pat) && !isBoolPat(pat) && !isStrPat(pat)

def emitOkVar(pat: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, sv: String, asI64: Bool): Slot =
  emitOkVarBps(pat, body, prefix, strs, defs, ens, Param(pat, if (asI64) "Int" else "Any", "", "") :: dropParam(ps, pat), loc, i, sv, asI64)

def emitOkVarBps(pat: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], bps: List[Param], loc: String, i: Int, sv: String, asI64: Bool): Slot =
  emitOkVar2(bindAliasTy(pat, sv, asI64), emitOkOwned(emitExpr(body, Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, bps, loc), bps), asI64)

def emitOkVar2(alias: String, s: Slot, asI64: Bool): Slot =
  s match {
    case Slot(code, val, owned) => Slot(join(alias, code), val, owned || !asI64)
  }

def emitOkSlotPat2(pat: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String]): Slot =
  if (isOrPat(pat)) emitOkSlotPat2(orLeft(pat), body, prefix, strs, defs, ens, ps, loc, i, tys) else if (isConsPat(pat)) emitOkCons(pat, body, prefix, strs, defs, ens, ps, loc, i, tys) else if (isConsPat(patBind(pat))) emitOkCons(patBind(pat), body, prefix, strs, defs, ens, ps, loc, i, tys) else if (isTuplePat(pat)) emitOkTuple(pat, body, prefix, strs, defs, ens, ps, loc, i, tys) else if (hasComma(patBind(pat)) || namedMulti(pat, ens)) emitOkFields(pat, body, prefix, strs, defs, ens, ps, loc, i) else emitOkSlotBind(fieldBind(patBind(pat)), bindIsInt(pat, ens), body, prefix, strs, defs, ens, ps, loc, i)

def namedMulti(pat: String, ens: List[En]): Bool =
  isNamedPat(patBind(pat)) && List.len(payloadTys(ens, patCore(pat))) > 1

def isNamedPat(s: String): Bool =
  namedEqAt(s, 0) >= 0

def namedEqAt(s: String, i: Int): Int =
  if (i + 3 > Str.len(s)) 0 - 1 else if (Str.slice(s, i, i + 3) == " = ") i else namedEqAt(s, i + 1)

def fieldBind(s: String): String =
  if (namedEqAt(s, 0) < 0) s else Str.slice(s, namedEqAt(s, 0) + 3, Str.len(s))

def fieldNameOf(s: String): String =
  if (namedEqAt(s, 0) < 0) s else Str.slice(s, 0, namedEqAt(s, 0))

def emitOkCons(pat: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String]): Slot =
  emitOkOwned(emitOkConsNest(consTail(pat), prefix, i, emitExpr(rewriteCons(pat, body, prefix, i, slotInt(tys, 0)), Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, ps, loc)), ps)

def emitOkConsNest(t: String, prefix: String, i: Int, s: Slot): Slot =
  if (isConsPat(t)) emitOkConsNest2(prefix, i, s) else s

def emitOkConsNest2(prefix: String, i: Int, s: Slot): Slot =
  s match {
    case Slot(code, val, owned) => Slot(join(emitConsNestLoad(prefix, i), code), val, owned)
  }

def emitConsNestLoad(prefix: String, i: Int): String =
  join(emitConsNestHead(prefix, i), emitConsNestTail(prefix, i))

def emitConsNestHead(prefix: String, i: Int): String =
  line(Str.concat(tmp(ppre(prefix, i), "nch"), Str.concat("call ptr @sz_list_head(ptr ", Str.concat(pct(ppre(prefix, i), "ct"), ")"))))

def emitConsNestTail(prefix: String, i: Int): String =
  line(Str.concat(tmp(ppre(prefix, i), "nct"), Str.concat("call ptr @sz_list_tail(ptr ", Str.concat(pct(ppre(prefix, i), "ct"), ")"))))

def rewriteCons(pat: String, body: Expr, prefix: String, i: Int, unbox: Bool): Expr =
  rewriteCons2(consAt(pat, 0), pat, body, prefix, i, unbox)

def rewriteCons2(at: Int, pat: String, body: Expr, prefix: String, i: Int, unbox: Bool): Expr =
  rewriteCons3(Str.slice(pat, 0, at), pat, at, body, prefix, i, unbox)

def rewriteCons3(h: String, pat: String, at: Int, body: Expr, prefix: String, i: Int, unbox: Bool): Expr =
  rewriteCons4(h, Str.slice(pat, at + 4, Str.len(pat)), body, prefix, i, unbox)

def rewriteCons4(h: String, t: String, body: Expr, prefix: String, i: Int, unbox: Bool): Expr =
  rewriteConsTail(t, rewriteBind(body, h, consHeadStem(prefix, i, unbox)), prefix, i)

def rewriteConsTail(t: String, body: Expr, prefix: String, i: Int): Expr =
  if (t == "_" || t == "[]") body else if (isConsPat(t)) rewriteBind(body, consHead(t), Str.concat(ppre(prefix, i), "_nch")) else rewriteBind(body, t, Str.concat(ppre(prefix, i), "_ct"))

def consHeadStem(prefix: String, i: Int, unbox: Bool): String =
  Str.concat(ppre(prefix, i), if (unbox) "_cu" else "_ch")

def emitOkFields(pat: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  emitOkOwned(emitOkRetainNs(splitPat(patBind(pat)), payloadTys(ens, patCore(pat)), prefix, i, 0, emitExpr(rewriteFields(splitPat(patBind(pat)), body, prefix, i, 0, payloadTys(ens, patCore(pat)), payloadNames(ens, patCore(pat))), Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, ps, loc)), ps)

def emitOkRetainNs(ns: List[String], fts: List[String], prefix: String, i: Int, k: Int, s: Slot): Slot =
  if (List.isEmpty(ns)) s else emitOkRetainNs(List.tail(ns), fts, prefix, i, k + 1, emitOkRetainK(fts, prefix, i, k, s))

def emitOkRetainK(fts: List[String], prefix: String, i: Int, k: Int, s: Slot): Slot =
  if (slotInt(fts, k)) s else emitOkSlot3(s, Str.concat("%", fieldStem(prefix, i, k, false)))

def emitOkOwned(s: Slot, ps: List[Param]): Slot =
  s match {
    case Slot(code, val, owned) => if (owned || isIntSsa(val) || !isPtrSlot(val, ps)) s else Slot(join(code, retPtr(val)), val, true)
  }

def rewriteFields(ns: List[String], body: Expr, prefix: String, i: Int, k: Int, fts: List[String], names: List[String]): Expr =
  if (List.isEmpty(ns)) body else rewriteFields(List.tail(ns), rewriteBind(body, fieldBind(List.at(ns, 0)), fieldStem(prefix, i, fieldIdx(List.at(ns, 0), k, names), slotInt(fts, fieldIdx(List.at(ns, 0), k, names)))), prefix, i, k + 1, fts, names)

def fieldIdx(h: String, k: Int, names: List[String]): Int =
  if (isNamedPat(h)) idxOf(names, fieldNameOf(h)) else k

def idxOf(xs: List[String], s: String): Int =
  idxOfAt(xs, s, 0)

def idxOfAt(xs: List[String], s: String, i: Int): Int =
  if (List.isEmpty(xs)) 0 else if (Str.eq(List.at(xs, 0), s)) i else idxOfAt(List.tail(xs), s, i + 1)

def payloadNames(ens: List[En], core: String): List[String] =
  payloadNames2(dotAt(core, 0), core, ens)

def payloadNames2(dot: Int, core: String, ens: List[En]): List[String] =
  if (dot < 0) recNames(ens, core) else caseNames(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def caseNames(ens: List[En], en: String, ctor: String): List[String] =
  if (List.isEmpty(ens)) noStr() else caseNames1(List.at(ens, 0), List.tail(ens), en, ctor)

def caseNames1(h: En, rest: List[En], en: String, ctor: String): List[String] =
  h match {
    case En(_, name, _, cases) => if (name == en) caseNames2(cases, ctor) else caseNames(rest, en, ctor)
  }

def caseNames2(cs: List[EnCase], ctor: String): List[String] =
  if (List.isEmpty(cs)) noStr() else caseNames3(List.at(cs, 0), List.tail(cs), ctor)

def caseNames3(h: EnCase, rest: List[EnCase], ctor: String): List[String] =
  h match {
    case EnCase(name, fields) => if (name == ctor) paramNames(fields) else caseNames2(rest, ctor)
  }

def fieldStem(prefix: String, i: Int, k: Int, isInt: Bool): String =
  Str.concat(fpre(prefix, i), Str.concat(if (isInt) "_b" else "_c", Str.fromInt(k)))

def emitOkTuple(pat: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String]): Slot =
  emitOkTuple2(pat, rewriteTuple(pat, body, prefix, i, tys), prefix, strs, defs, ens, loc, i, stemBps(pat, prefix, i, tys, ps))

def emitOkTuple2(pat: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], loc: String, i: Int, bps: List[Param]): Slot =
  emitOkTupleJoin(emitOkOwned(emitExpr(body, Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, bps, loc), bps), exprIsI64(body, bps, defs))

def emitOkTupleJoin(s: Slot, asI64: Bool): Slot =
  s match {
    case Slot(code, val, owned) => Slot(code, val, owned || !asI64)
  }

def stemBps(pat: String, prefix: String, i: Int, tys: List[String], ps: List[Param]): List[Param] =
  stemBpsAt(splitPat(Str.slice(pat, 1, Str.len(pat) - 1)), ppre(prefix, i), i + 1, tys, ps)

def stemBpsAt(ns: List[String], pre: String, sid: Int, tys: List[String], ps: List[Param]): List[Param] =
  if (List.len(ns) < 2) ps else if (List.len(ns) == 2) addStem(List.at(ns, 0), leftStem(pre, sid, tys), stemTy(tys, 0), addStem(List.at(List.tail(ns), 0), rightStem(pre, sid, tys), stemTy(tys, 1), ps)) else addStem(List.at(ns, 0), leftStem(pre, sid, tys), stemTy(tys, 0), stemBpsAt(List.tail(ns), Str.concat(pre, Str.concat("_n", Str.fromInt(sid))), sid + 1, if (List.isEmpty(tys)) tys else List.tail(tys), ps))

def stemTy(tys: List[String], k: Int): String =
  if (slotInt(tys, k)) "Int" else if (k <= 0) headOrAny(tys) else secondOrAny(tys)

def addStem(n: String, stem: String, ty: String, ps: List[Param]): List[Param] =
  if (!keepBind(n) || isTuplePat(n)) ps else Param(stem, ty, "", "") :: dropParam(ps, stem)

def rewriteTuple(pat: String, body: Expr, prefix: String, i: Int, tys: List[String]): Expr =
  rewriteTupleAt(splitPat(Str.slice(pat, 1, Str.len(pat) - 1)), body, ppre(prefix, i), i + 1, tys)

def rewriteTupleAt(ns: List[String], body: Expr, pre: String, sid: Int, tys: List[String]): Expr =
  if (List.isEmpty(ns)) body else rewriteTupleAt1(List.at(ns, 0), List.tail(ns), body, pre, sid, tys)

def rewriteTupleAt1(n: String, rest: List[String], body: Expr, pre: String, sid: Int, tys: List[String]): Expr =
  if (List.isEmpty(rest)) rewriteSlot(n, rightStem(pre, sid, tys), if (List.len(tys) > 1) secondTy(tys) else headTy(tys), body) else rewriteTupleAt2(n, List.at(rest, 0), List.tail(rest), body, pre, sid, tys)

def rewriteTupleAt2(n: String, n2: String, more: List[String], body: Expr, pre: String, sid: Int, tys: List[String]): Expr =
  if (List.isEmpty(more)) rewriteSlot(n, leftStem(pre, sid, tys), headTy(tys), rewriteSlot(n2, rightStem(pre, sid, tys), secondTy(tys), body)) else rewriteTupleAt1(n2, more, rewriteSlot(n, leftStem(pre, sid, tys), headTy(tys), body), Str.concat(pre, Str.concat("_n", Str.fromInt(sid))), sid + 1, if (List.isEmpty(tys)) tys else List.tail(tys))

def rewriteSlot(n: String, stem: String, ty: String, body: Expr): Expr =
  if (isTuplePat(n)) rewriteTupleAt(splitPat(Str.slice(n, 1, Str.len(n) - 1)), body, stem, 1, tupSlots(ty)) else rewriteBind(body, n, stem)

def leftStem(pre: String, sid: Int, tys: List[String]): String =
  Str.concat(pre, Str.concat(if (slotInt(tys, 0)) "_tvl" else "_tl", Str.fromInt(sid)))

def rightStem(pre: String, sid: Int, tys: List[String]): String =
  Str.concat(pre, Str.concat(if (slotInt(tys, 1)) "_tv" else "_tr", Str.fromInt(sid)))

def splitPat(s: String): List[String] =
  splitPatAt(s, commaAt(s, 0))

def commaAt(s: String, i: Int): Int =
  commaAtD(s, i, 0)

def commaAtD(s: String, i: Int, d: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else commaAtC(s, i, d, Str.charAt(s, i))

def commaAtC(s: String, i: Int, d: Int, c: Int): Int =
  if (c == 40) commaAtD(s, i + 1, d + 1) else if (c == 41) commaAtD(s, i + 1, if (d > 0) d - 1 else 0) else if (c == 44 && d == 0) i else commaAtD(s, i + 1, d)

def splitPatAt(s: String, c: Int): List[String] =
  if (c < 0) trimPat(s) :: noStr() else trimPat(Str.slice(s, 0, c)) :: splitPat(Str.slice(s, c + 1, Str.len(s)))

def trimPat(s: String): String =
  trimPat2(s, 0, Str.len(s))

def trimPat2(s: String, a: Int, b: Int): String =
  if (a >= b) "" else if (Str.charAt(s, a) == 32) trimPat2(s, a + 1, b) else if (Str.charAt(s, b - 1) == 32) trimPat2(s, a, b - 1) else Str.slice(s, a, b)

def emitOkSlotBind(bind: String, isInt: Bool, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  if (isAsPat(bind)) emitOkSlotBind(asName(bind), isInt, body, prefix, strs, defs, ens, ps, loc, i) else if (bind == "") emitOkSlot2(emitExpr(body, Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, ps, loc), true, isInt, prefix, i, ps) else emitOkSlot2(emitExpr(rewriteBind(body, bind, bindStem(prefix, i, isInt)), Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, ps, loc), false, isInt, prefix, i, ps)

def emitOkSlot2(s: Slot, empty: Bool, isInt: Bool, prefix: String, i: Int, ps: List[Param]): Slot =
  if (isInt) s else if (empty) emitOkOwned(s, ps) else emitOkOwned(emitOkSlot3(s, Str.concat("%", bindStem(prefix, i, false))), ps)

def emitOkSlot3(s: Slot, bind: String): Slot =
  s match {
    case Slot(code, val, owned) => Slot(join(retPtr(bind), code), val, owned || val == bind)
  }

def rewriteBind(e: Expr, from: String, to: String): Expr =
  if (from == "") e else rewriteBind1(e, from, to)

def rewriteBind1(e: Expr, from: String, to: String): Expr =
  e match {
    case Expr.EVar(s, _) => if (s == from) Expr.EVar(to, 0) else Expr.EVar(s, 0)
    case Expr.EPrint(inner, _) => Expr.EPrint(rewriteBind(inner, from, to), 0)
    case Expr.ECall(f, args, _) => Expr.ECall(f, rewriteBindList(args, from, to), 0)
    case Expr.EMethod(recv, name, args, _) => Expr.EMethod(rewriteBind(recv, from, to), name, rewriteBindList(args, from, to), 0)
    case Expr.EField(recv, name, _) => Expr.EField(rewriteBind(recv, from, to), name, 0)
    case Expr.EBin(op, l, r, _) => Expr.EBin(op, rewriteBind(l, from, to), rewriteBind(r, from, to), 0)
    case Expr.EUn(op, inner, _) => Expr.EUn(op, rewriteBind(inner, from, to), 0)
    case Expr.ELam(p, ty, body) => Expr.ELam(p, ty, rewriteBind(body, from, to))
    case Expr.EIf(c, t, el, _) => Expr.EIf(rewriteBind(c, from, to), rewriteBind(t, from, to), rewriteBind(el, from, to), 0)
    case Expr.EMatch(s, arms, _) => Expr.EMatch(rewriteBind(s, from, to), rewriteBindArms(arms, from, to), 0)
    case Expr.EList(xs) => Expr.EList(rewriteBindList(xs, from, to))
    case Expr.ETuple(xs) => Expr.ETuple(rewriteBindList(xs, from, to))
    case Expr.ENamed(n, inner) => Expr.ENamed(n, rewriteBind(inner, from, to))
    case Expr.EAscribe(inner, ty, off) => Expr.EAscribe(rewriteBind(inner, from, to), ty, off)
    case Expr.EFor(bs, body, _) => Expr.EFor(rewriteBindBinds(bs, from, to), rewriteBind(body, from, to), 0)
    case Expr.EInt(n, _) => Expr.EInt(n, 0)
    case Expr.EBool(b) => Expr.EBool(b)
    case Expr.EStr(s, _) => Expr.EStr(s, 0)
    case Expr.EFloat(s) => Expr.EFloat(s)
    case Expr.EInterp(s) => Expr.EInterp(rewriteInterpStr(s, from, to))
    case Expr.EHole => Expr.EHole
    case Expr.EUnit => Expr.EUnit
  }

def rewriteBindBinds(bs: List[Bind], from: String, to: String): List[Bind] =
  if (List.isEmpty(bs)) bs else rewriteBindBindsHit(bs, from, to)

def rewriteBindBindsHit(bs: List[Bind], from: String, to: String): List[Bind] =
  bs match {
    case b :: rest => rewriteBindBinds1(b, rest, from, to)
    case [] => bs
  }

def rewriteBindBinds1(b: Bind, rest: List[Bind], from: String, to: String): List[Bind] =
  b match {
    case Bind(d, n, v) => Bind(d, n, rewriteBind(v, from, to)) :: rewriteBindBinds(rest, from, to)
  }

def rewriteInterpStr(s: String, from: String, to: String): String =
  rewriteInterpAt(s, 0, "", from, to)

def rewriteInterpAt(s: String, i: Int, acc: String, from: String, to: String): String =
  if (i >= Str.len(s)) acc else rewriteInterpCh(s, i, acc, from, to, Str.charAt(s, i))

def rewriteInterpCh(s: String, i: Int, acc: String, from: String, to: String, c: Int): String =
  if (c == 36) rewriteInterpDollar(s, i, acc, from, to) else rewriteInterpAt(s, i + 1, Str.concat(acc, Str.slice(s, i, i + 1)), from, to)

def rewriteInterpDollar(s: String, i: Int, acc: String, from: String, to: String): String =
  if (i + 1 >= Str.len(s)) rewriteInterpAt(s, i + 1, Str.concat(acc, "$"), from, to) else rewriteInterpDollar2(s, i, acc, from, to, Str.charAt(s, i + 1))

def rewriteInterpDollar2(s: String, i: Int, acc: String, from: String, to: String, n: Int): String =
  if (n == 123) rewriteInterpBrace(s, i, acc, from, to) else if (isIdentStart(n)) rewriteInterpIdent(s, i + 1, acc, from, to) else rewriteInterpAt(s, i + 1, Str.concat(acc, "$"), from, to)

def rewriteInterpIdent(s: String, i: Int, acc: String, from: String, to: String): String =
  rewriteInterpIdent2(s, i, i, acc, from, to)

def rewriteInterpIdent2(s: String, i: Int, start: Int, acc: String, from: String, to: String): String =
  if (i >= Str.len(s)) rewriteInterpIdent3(s, i, start, acc, from, to) else if (isIdentCont(Str.charAt(s, i))) rewriteInterpIdent2(s, i + 1, start, acc, from, to) else rewriteInterpIdent3(s, i, start, acc, from, to)

def rewriteInterpIdent3(s: String, i: Int, start: Int, acc: String, from: String, to: String): String =
  rewriteInterpAt(s, i, Str.concat(acc, Str.concat("$", rewriteIdent(Str.slice(s, start, i), from, to))), from, to)

def rewriteIdent(n: String, from: String, to: String): String =
  if (n == from) to else n

def rewriteInterpBrace(s: String, i: Int, acc: String, from: String, to: String): String =
  rewriteInterpBrace2(closeBrace(s, i + 2, 1), s, i, acc, from, to)

def rewriteInterpBrace2(j: Int, s: String, i: Int, acc: String, from: String, to: String): String =
  rewriteInterpAt(s, j, Str.concat(acc, rewriteInterpInner(Str.slice(s, i + 2, j - 1), from, to)), from, to)

def rewriteInterpInner(inner: String, from: String, to: String): String =
  rewriteInterpInner2(Parse.parseExprList(Lexer.lex(inner), 0), from, to)

def rewriteInterpInner2(p: (Expr, Int), from: String, to: String): String =
  p match {
    case (e, _) => Str.concat("${", Str.concat(Parse.pretty0(rewriteBind(e, from, to)), "}"))
  }

def rewriteBindList(xs: List[Expr], from: String, to: String): List[Expr] =
  if (List.isEmpty(xs)) xs else rewriteBindList2(List.at(xs, 0), List.tail(xs), from, to)

def rewriteBindList2(h: Expr, t: List[Expr], from: String, to: String): List[Expr] =
  rewriteBind(h, from, to) :: rewriteBindList(t, from, to)

def rewriteBindArms(arms: List[Arm], from: String, to: String): List[Arm] =
  if (List.isEmpty(arms)) arms else rewriteBindArms2(List.at(arms, 0), List.tail(arms), from, to)

def rewriteBindArms2(h: Arm, t: List[Arm], from: String, to: String): List[Arm] =
  rewriteBindArm(h, from, to) :: rewriteBindArms(t, from, to)

def rewriteBindArm(arm: Arm, from: String, to: String): Arm =
  arm match {
    case Arm(pat, g, body) => Arm(pat, g, rewriteBind(body, from, to))
  }

def emitOks1g(g: String, pat: String, s: Slot, rest: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String, last: Bool, asI64: Bool): (String, List[String], Bool) =
  s match {
    case Slot(code, val, owned) => emitOks2g(g, pat, val, owned, code, emitOks(rest, prefix, strs, defs, ens, ps, loc, i + 1, tys, sv, asI64), prefix, i, last, strs, defs, ens, ps, loc)
  }

def emitOks2g(g: String, pat: String, val: String, owned: Bool, code: String, p: (String, List[String], Bool), prefix: String, i: Int, last: Bool, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): (String, List[String], Bool) =
  p match {
    case (restCode, vals, restOwned) => (join(emitOkBodyG(g, pat, code, prefix, i, last, strs, defs, ens, ps, loc), restCode), val :: vals, owned || restOwned || isPtrSlot(val, ps))
  }

def emitOkBodyG(g: String, pat: String, code: String, prefix: String, i: Int, last: Bool, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): String =
  if (g == "") emitOkBody(code, prefix, i) else emitOkBodyGuard(emitExpr(rewriteBind(parseGuard(g), fieldBind(patBind(pat)), bindStem(prefix, i, bindIsInt(pat, ens))), Str.concat(prefix, Str.concat("_g0_", Str.fromInt(i))), strs, defs, ens, ps, loc), code, prefix, i, last)

def parseGuard(g: String): Expr =
  parseGuard1(Parse.parseExprList(Lexer.lex(g), 0))

def parseGuard1(p: (Expr, Int)): Expr =
  p match {
    case (e, _) => guardExpr(e)
  }

def guardExpr(e: Expr): Expr =
  e

def emitOkBodyGuard(gs: Slot, code: String, prefix: String, i: Int, last: Bool): String =
  gs match {
    case Slot(gc, gv, _) => join(lab(Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))), join(gc, join(emitGuardBr(gv, prefix, i, last), join(lab(okBodyLab(prefix, i)), join(code, join(line(Str.concat("br label %", Str.concat(prefix, Str.concat("_aj_0_", Str.fromInt(i))))), join(lab(Str.concat(prefix, Str.concat("_aj_0_", Str.fromInt(i)))), line(Str.concat("br label %", Str.concat(prefix, "_merge_0"))))))))))
  }

def emitGuardBr(gv: String, prefix: String, i: Int, last: Bool): String =
  join(line(Str.concat(tmp(Str.concat(prefix, Str.concat("_gc_", Str.fromInt(i))), "cmp"), Str.concat("icmp ne i64 ", Str.concat(gv, ", 0")))), line(Str.concat("br i1 ", Str.concat(pct(Str.concat(prefix, Str.concat("_gc_", Str.fromInt(i))), "cmp"), Str.concat(", label %", Str.concat(okBodyLab(prefix, i), Str.concat(", label %", nextLab(prefix, i, last))))))))

def okBodyLab(prefix: String, i: Int): String =
  Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), "_body")))

def emitOkBody(code: String, prefix: String, i: Int): String =
  join(lab(Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))), join(code, join(line(Str.concat("br label %", Str.concat(prefix, Str.concat("_aj_0_", Str.fromInt(i))))), join(lab(Str.concat(prefix, Str.concat("_aj_0_", Str.fromInt(i)))), line(Str.concat("br label %", Str.concat(prefix, "_merge_0")))))))

def emitMatchPhi(vals: List[String], owned: Bool, prefix: String, exh: Bool): String =
  join(lab(Str.concat(prefix, "_merge_0")), line(Str.concat(tmp(prefix, "phi"), emitMatchPhi2(vals, owned, prefix, exh))))

def emitMatchPhi2(vals: List[String], owned: Bool, prefix: String, exh: Bool): String =
  Str.concat("phi ", Str.concat(if (owned) "ptr" else "i64", Str.concat(" ", Str.concat(phiParts(vals, owned, prefix, 0), if (exh) "" else phiTail(owned, prefix)))))

def phiParts(vals: List[String], owned: Bool, prefix: String, i: Int): String =
  if (List.isEmpty(vals)) "" else if (List.len(vals) == 1) phiOne(phiArmVal(List.at(vals, 0), owned), prefix, i) else Str.concat(phiOne(phiArmVal(List.at(vals, 0), owned), prefix, i), Str.concat(", ", phiParts(List.tail(vals), owned, prefix, i + 1)))

def phiArmVal(v: String, owned: Bool): String =
  if (owned && (v == "0" || isI64Lit(v))) "null" else v

def phiOne(v: String, prefix: String, i: Int): String =
  Str.concat("[ ", Str.concat(v, Str.concat(", %", Str.concat(prefix, Str.concat("_aj_0_", Str.concat(Str.fromInt(i), " ]"))))))

def phiTail(owned: Bool, prefix: String): String =
  if (owned) Str.concat(", [ null, %", Str.concat(prefix, "_default_0 ]")) else Str.concat(", [ ", Str.concat(pct(prefix, "dflt"), Str.concat(", %", Str.concat(prefix, "_default_0 ]"))))

def llvmRet(ret: String): String =
  if (ret == "Int" || ret == "Bool" || ret == "Float") "i64" else "ptr"

def isI64Ty(t: String): Bool =
  t == "Int" || t == "Bool" || t == "Float"

def defParams2(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) oneParam(List.at(ps, 0)) else Str.concat(oneParam(List.at(ps, 0)), Str.concat(", ", defParams2(List.tail(ps))))

def oneParam(p: Param): String =
  if (isI64Ty(p.ty)) Str.concat("i64 %", p.name) else Str.concat("ptr %", p.name)

def emitDefs(ds: List[Fun], strs: List[String], all: List[Fun], ens: List[En], files: List[(String, String)]): String =
  Builder.result(emitDefsB(ds, strs, all, ens, files, Builder.empty()))

def emitDefsB(ds: List[Fun], strs: List[String], all: List[Fun], ens: List[En], files: List[(String, String)], b: Builder): Builder =
  if (List.isEmpty(ds)) b else emitDefsB(List.tail(ds), strs, all, ens, files, Builder.append(b, emitDef(List.at(ds, 0), strs, all, ens, files)))

def emitDef3(ty: String, name: String, params: String, body: Slot, loc: String, strs: List[String]): String =
  Str.concat("define internal ", Str.concat(ty, Str.concat(" @sz_user_", Str.concat(name, emitDefSig(params, ty, body, loc, strs)))))

def emitDefSig(params: String, ty: String, body: Slot, loc: String, strs: List[String]): String =
  Str.concat("(", Str.concat(params, Str.concat(") {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), Str.concat(panicPush(loc, strs), emitDef4(ty, body))))))))

def emitDef4(ty: String, body: Slot): String =
  body match {
    case Slot(code, val, owned) => if (ty == "i64" && owned) emitDefUnbox(code, val) else emitDef5(ty, code, val, ty == "ptr" && !owned)
  }

def emitDefUnbox(code: String, val: String): String =
  Str.concat(code, Str.concat(line(Str.concat("%ret_u = call i64 @sz_unbox_i64(ptr ", Str.concat(val, ")"))), Str.concat(if (isFnPack(val)) relPtr(val) else "", Str.concat(panicPop(), Str.concat("  ret i64 %ret_u", Str.concat(nl(), Str.concat("}", Str.concat(nl(), nl()))))))))

def emitDef5(ty: String, code: String, val: String, keep: Bool): String =
  Str.concat(code, Str.concat(if (keep) retPtr(val) else "", Str.concat(panicPop(), Str.concat("  ret ", Str.concat(ty, Str.concat(" ", Str.concat(val, Str.concat(nl(), Str.concat("}", Str.concat(nl(), nl()))))))))))

def emitFromInt(code: String, vals: List[String], prefix: String, ps: List[Param], owns: List[Bool], args: List[Expr]): Slot =
  emitFromInt2(code, if (List.isEmpty(vals)) "0" else List.at(vals, 0), prefix, ps, headOwn(owns), args)

def emitFromInt2(code: String, v: String, prefix: String, ps: List[Param], o: Bool, args: List[Expr]): Slot =
  if (o || fromIntUnbox(v, ps) || fromIntHead(args) || thenIsPtr(code, v, o, ps)) emitFromIntUnbox(code, v, prefix) else emitFromIntI64(code, v, prefix)

def fromIntHead(args: List[Expr]): Bool =
  if (List.isEmpty(args)) false else fromIntHead1(List.at(args, 0))

def fromIntHead1(e: Expr): Bool =
  e match {
    case Expr.ECall(f, xs, _) => f == "List.at" && !headUnbox(xs, noParam())
    case Expr.EMethod(_, name, xs, _) => name == "at" && !headUnbox(xs, noParam())
    case _ => false
  }

def fromIntUnbox(v: String, ps: List[Param]): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37 && !isI64ParamVal(v, ps) && (!hasSub(v, "_") || hasSub(v, "_tl") || hasSub(v, "_tr") || hasSub(v, "_pl"))

def emitFromIntI64(code: String, v: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_from_int(i64 ", Str.concat(v, ")"))))), pct(prefix, "v"), true)

def emitFromBool(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_from_bool(i64 ", Str.concat(if (List.isEmpty(vals)) "0" else List.at(vals, 0), ")"))))), pct(prefix, "v"), true)

def emitFromIntUnbox(code: String, v: String, prefix: String): Slot =
  emitFromIntUnbox2(join(code, join(unboxLine(v, prefix), fromIntLine(prefix))), prefix)

def unboxLine(v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "u"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(v, ")"))))

def fromIntLine(prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_from_int(i64 ", Str.concat(pct(prefix, "u"), ")"))))

def emitFromIntUnbox2(code: String, prefix: String): Slot =
  Slot(code, pct(prefix, "v"), true)

def i64Args(vals: List[String]): String =
  if (List.isEmpty(vals)) "" else if (List.len(vals) == 1) oneVal(List.at(vals, 0)) else Str.concat(oneVal(List.at(vals, 0)), Str.concat(", ", i64Args(List.tail(vals))))

def oneVal(v: String): String =
  if (isI64Lit(v) || isIntSsa(v)) Str.concat("i64 ", v) else Str.concat("ptr ", v)

def emitDef(d: Fun, strs: List[String], defs: List[Fun], ens: List[En], files: List[(String, String)]): String =
  emitDefRw(rwDef(d, defs, ens), strs, defs, ens, files)

def emitDefRw(d: Fun, strs: List[String], defs: List[Fun], ens: List[En], files: List[(String, String)]): String =
  d match {
    case Fun(_, name, _, ps, ret, body, mod, off) => emitDefByRet(name, mod, ret, ps, body, strs, defs, ens, panicLoc(files, mod, off))
  }

def isIoTy(ret: String): Bool =
  Str.len(ret) >= 2 && Str.slice(ret, 0, 2) == "IO"

def emitDefByRet(name: String, mod: String, ret: String, ps: List[Param], body: Expr, strs: List[String], defs: List[Fun], ens: List[En], loc: String): String =
  stampNeth(if (isIoTy(ret)) stampCont(Str.concat(emitConts(body, strs, defs, ens, ps, loc), emitDef3(llvmRet(ret), symOf(mod, name), defParams2(ps), emitExpr(body, "body", strs, defs, ens, ps, loc), loc, strs)), contKey(mod, name)) else if (hasTailIf(body, name)) emitDefTco(name, mod, ret, ps, body, strs, defs, ens, loc) else emitDef3(llvmRet(ret), symOf(mod, name), defParams2(ps), emitExpr(body, "body", strs, defs, ens, ps, loc), loc, strs), contKey(mod, name))

def hasTailIf(e: Expr, name: String): Bool =
  e match {
    case Expr.EIf(_, t, el, _) => isSelfTail(t, name) || isSelfTail(el, name) || hasTailIf(t, name) || hasTailIf(el, name)
    case Expr.EMatch(_, arms, _) => hasTailArm(arms, name)
    case _ => false
  }

def hasTailArm(arms: List[Arm], name: String): Bool =
  !List.isEmpty(arms) && hasTailArm1(List.at(arms, 0), List.tail(arms), name)

def hasTailArm1(a: Arm, rest: List[Arm], name: String): Bool =
  a match {
    case Arm(_, _, body) => isSelfTail(body, name) || hasTailArm(rest, name)
  }

def isSelfTail(e: Expr, name: String): Bool =
  e match {
    case Expr.ECall(f, _, _) => f == name
    case Expr.EMethod(_, f, _, _) => f == name
    case _ => false
  }

def defParamsTco(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) oneParamTco(List.at(ps, 0)) else Str.concat(oneParamTco(List.at(ps, 0)), Str.concat(", ", defParamsTco(List.tail(ps))))

def oneParamTco(p: Param): String =
  if (isI64Ty(p.ty)) Str.concat("i64 %", Str.concat(p.name, "_in")) else Str.concat("ptr %", Str.concat(p.name, "_in"))

def emitDefTco(name: String, mod: String, ret: String, ps: List[Param], body: Expr, strs: List[String], defs: List[Fun], ens: List[En], loc: String): String =
  body match {
    case Expr.EIf(c, t, el, _) => emitDefTcoIf(name, mod, ret, ps, c, t, el, strs, defs, ens, loc)
    case Expr.EMatch(s, arms, _) => emitDefTcoMatch(name, mod, ret, ps, s, arms, strs, defs, ens, loc)
    case _ => emitDef3(llvmRet(ret), symOf(mod, name), defParams2(ps), emitExpr(body, "body", strs, defs, ens, ps, loc), loc, strs)
  }

def emitDefTcoMatch(name: String, mod: String, ret: String, ps: List[Param], s: Expr, arms: List[Arm], strs: List[String], defs: List[Fun], ens: List[En], loc: String): String =
  emitDefTcoIf3(llvmRet(ret), symOf(mod, name), defParamsTco(ps), join(emitTcoPrep(ps), emitMatchTail(s, arms, name, llvmRet(ret), strs, defs, ens, ps, loc)), loc, strs)

def emitMatchTail(s: Expr, arms: List[Arm], fname: String, tret: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): String =
  s match {
    case Expr.EVar(n, _) => emitMatchTail1(emitExpr(Expr.EVar(n, 0), "body_sc", strs, defs, ens, ps, loc), arms, fname, tret, strs, defs, ens, ps, loc, matchSlots(paramTy(ps, n)))
    case _ => emitMatchTail1(emitExpr(s, "body_sc", strs, defs, ens, ps, loc), arms, fname, tret, strs, defs, ens, ps, loc, noStr())
  }

def emitMatchTail1(se: Slot, arms: List[Arm], fname: String, tret: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, tys: List[String]): String =
  se match {
    case Slot(sc, sv, _) => join(sc, join(brTry("body"), join(emitTries(arms, "body", sv, ens, strs, 0, tys), join(emitDefault("body", false, true), emitOksTail(arms, fname, tret, strs, defs, ens, ps, loc, 0, tys, sv)))))
  }

def emitOksTail(arms: List[Arm], fname: String, tret: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String): String =
  if (List.isEmpty(arms)) "" else emitOksTail0(List.at(arms, 0), List.tail(arms), fname, tret, strs, defs, ens, ps, loc, i, tys, sv)

def emitOksTail0(arm: Arm, rest: List[Arm], fname: String, tret: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String): String =
  arm match {
    case Arm(pat, _, body) => join(emitOkTailArm(pat, body, fname, tret, strs, defs, ens, ps, loc, i, tys, sv), emitOksTail(rest, fname, tret, strs, defs, ens, ps, loc, i + 1, tys, sv))
  }

def emitOkTailArm(pat: String, body: Expr, fname: String, tret: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String): String =
  join(lab(Str.concat("body_ok_0_", Str.fromInt(i))), emitOkTailBody(pat, body, fname, tret, strs, defs, ens, ps, loc, i, tys, sv))

def emitOkTailBody(pat: String, body: Expr, fname: String, tret: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String): String =
  if (isSelfTail(body, fname)) emitOkTailSlot(pat, body, strs, defs, ens, ps, loc, i, tys, sv).code else emitOkTailBase(emitOkSlotPat(pat, body, "body", strs, defs, ens, ps, loc, i, tys, sv, false), tret, ps, i)

def emitOkTailBase(s: Slot, tret: String, ps: List[Param], i: Int): String =
  s match {
    case Slot(c, v, o) => join(c, emitTcoRetSlots(tret, v, o, ps, Str.concat("ok_", Str.fromInt(i))))
  }

def emitOkTailSlot(pat: String, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String): Slot =
  if (isAsPat(pat)) emitOkTailSlot(stripAs(pat), rewriteBind(body, asName(pat), ssaName(sv)), strs, defs, ens, ps, loc, i, tys, sv) else emitOkTailSlot2(pat, body, strs, defs, ens, ps, loc, i, tys)

def emitOkTailSlot2(pat: String, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String]): Slot =
  if (isOrPat(pat)) emitOkTailSlot2(orLeft(pat), body, strs, defs, ens, ps, loc, i, tys) else if (isConsPat(pat)) emitOkOwned(emitOkConsNest(consTail(pat), "body", i, emitTailLeaf(rewriteCons(pat, body, "body", i, slotInt(tys, 0)), strs, defs, ens, ps, loc, i)), ps) else emitOkTailSlot3(pat, body, strs, defs, ens, ps, loc, i, tys)

def emitOkTailSlot3(pat: String, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String]): Slot =
  if (isTuplePat(pat)) emitTailLeaf(rewriteTuple(pat, body, "body", i, tys), strs, defs, ens, ps, loc, i) else if (hasComma(patBind(pat)) || namedMulti(pat, ens)) emitTailLeaf(rewriteFields(splitPat(patBind(pat)), body, "body", i, 0, payloadTys(ens, patCore(pat)), payloadNames(ens, patCore(pat))), strs, defs, ens, ps, loc, i) else emitTailLeafBind(fieldBind(patBind(pat)), bindIsInt(pat, ens), body, strs, defs, ens, ps, loc, i)

def emitTailLeaf(body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  Slot(emitSelfTail(body, Str.concat("body_a0_", Str.fromInt(i)), strs, defs, ens, ps, loc), "tco", false)

def emitTailLeafBind(bind: String, isInt: Bool, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  if (bind == "" || bind == "_") emitTailLeaf(body, strs, defs, ens, ps, loc, i) else emitTailLeaf(rewriteBind(body, bind, bindStem("body", i, isInt)), strs, defs, ens, ps, loc, i)

def emitDefTcoIf(name: String, mod: String, ret: String, ps: List[Param], c: Expr, t: Expr, el: Expr, strs: List[String], defs: List[Fun], ens: List[En], loc: String): String =
  emitDefTcoIf2(llvmRet(ret), symOf(mod, name), name, defParamsTco(ps), ps, c, t, el, strs, defs, ens, loc)

def emitDefTcoIf2(ty: String, sym: String, fname: String, params: String, ps: List[Param], c: Expr, t: Expr, el: Expr, strs: List[String], defs: List[Fun], ens: List[En], loc: String): String =
  emitDefTcoIf3(ty, sym, params, join(emitTcoPrep(ps), emitIfTail(c, t, el, "body", strs, defs, ens, ps, loc, ty, fname)), loc, strs)

def emitDefTcoIf3(ty: String, name: String, params: String, body: String, loc: String, strs: List[String]): String =
  Str.concat("define internal ", Str.concat(ty, Str.concat(" @sz_user_", Str.concat(name, emitDefTcoSig(params, body, loc, strs)))))

def emitDefTcoSig(params: String, body: String, loc: String, strs: List[String]): String =
  Str.concat("(", Str.concat(params, Str.concat(") {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), Str.concat(panicPush(loc, strs), Str.concat(body, Str.concat("}", Str.concat(nl(), nl()))))))))))

def emitTcoPrep(ps: List[Param]): String =
  join(emitTcoAlloc(ps, 0), join(line("br label %tco_loop"), join(lab("tco_loop"), emitTcoLoads(ps, 0))))

def emitTcoAlloc(ps: List[Param], i: Int): String =
  if (i >= List.len(ps)) "" else emitTcoAllocOne(List.at(ps, i), ps, i)

def emitTcoAllocOne(p: Param, ps: List[Param], i: Int): String =
  p match {
    case Param(n, ty, _, _) => join(emitTcoAllocN(n, isI64Ty(ty)), emitTcoAlloc(ps, i + 1))
  }

def emitTcoAllocN(n: String, i64: Bool): String =
  if (i64) join(line(Str.concat("%", Str.concat(n, "_slot = alloca i64"))), line(Str.concat("store i64 %", Str.concat(n, Str.concat("_in, ptr %", Str.concat(n, "_slot")))))) else join(line(Str.concat("%", Str.concat(n, "_slot = alloca ptr"))), join(line(Str.concat("store ptr %", Str.concat(n, Str.concat("_in, ptr %", Str.concat(n, "_slot"))))), join(line(Str.concat("%", Str.concat(n, "_held = alloca i1"))), line(Str.concat("store i1 false, ptr %", Str.concat(n, "_held"))))))

def emitTcoLoads(ps: List[Param], i: Int): String =
  if (i >= List.len(ps)) "" else emitTcoLoadOne(List.at(ps, i), ps, i)

def emitTcoLoadOne(p: Param, ps: List[Param], i: Int): String =
  p match {
    case Param(n, ty, _, _) => join(line(Str.concat("%", Str.concat(n, Str.concat(" = load ", Str.concat(if (isI64Ty(ty)) "i64" else "ptr", Str.concat(", ptr %", Str.concat(n, "_slot"))))))), emitTcoLoads(ps, i + 1))
  }

def emitIfTail(c: Expr, t: Expr, el: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, ret: String, fname: String): String =
  emitIfTail2(emitExpr(c, Str.concat(prefix, "_ic"), strs, defs, ens, ps, loc), t, el, prefix, strs, defs, ens, ps, loc, ret, fname)

def emitIfTail2(c: Slot, t: Expr, el: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, ret: String, fname: String): String =
  c match {
    case Slot(cc, cv, _) => join(cc, join(emitIfCmp(cv, prefix), join(emitIfBr(prefix), join(join(lab(Str.concat(prefix, "_then_0")), emitTailArm(t, Str.concat(prefix, "_t"), strs, defs, ens, ps, loc, ret, fname)), join(lab(Str.concat(prefix, "_else_0")), emitTailArm(el, Str.concat(prefix, "_e"), strs, defs, ens, ps, loc, ret, fname))))))
  }

def emitTailArm(e: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, ret: String, fname: String): String =
  if (isSelfTail(e, fname)) emitSelfTail(e, prefix, strs, defs, ens, ps, loc) else emitTailArmIf(e, prefix, strs, defs, ens, ps, loc, ret, fname)

def emitTailArmIf(e: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, ret: String, fname: String): String =
  e match {
    case Expr.EIf(c, t, el, _) => emitIfTail(c, t, el, prefix, strs, defs, ens, ps, loc, ret, fname)
    case _ => emitTailBase(e, prefix, strs, defs, ens, ps, loc, ret)
  }

def emitTailBase(e: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, ret: String): String =
  emitTailBase1(emitExpr(e, Str.concat(prefix, "_b"), strs, defs, ens, ps, loc), ret, ps, prefix)

def emitTailBase1(s: Slot, ret: String, ps: List[Param], tag: String): String =
  s match {
    case Slot(tc, tv, to) => join(tc, emitTcoRetSlots(ret, tv, to, ps, tag))
  }

def emitTcoRetSlots(ret: String, tv: String, to: Bool, ps: List[Param], tag: String): String =
  join(if (ret == "ptr" && !to) retPtr(tv) else "", join(emitTcoReleases(ps, 0, Str.concat(tag, "_rb")), join(panicPop(), line(Str.concat(if (ret == "ptr") "ret ptr " else "ret i64 ", tv)))))

def emitSelfTail(e: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): String =
  e match {
    case Expr.ECall(_, args, _) => emitSelfTailAcc(args, prefix, strs, defs, ens, ps, loc, 0, "", noStr())
    case Expr.EMethod(_, _, args, _) => emitSelfTailAcc(args, prefix, strs, defs, ens, ps, loc, 0, "", noStr())
    case _ => line("br label %tco_loop")
  }

def emitSelfTailAcc(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, code: String, vals: List[String]): String =
  if (List.isEmpty(args)) emitTcoCommit(code, ps, vals, prefix) else emitSelfTailOne(List.at(args, 0), List.tail(args), prefix, strs, defs, ens, ps, loc, i, code, vals)

def emitSelfTailOne(a: Expr, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, code: String, vals: List[String]): String =
  emitSelfTailGot(emitExpr(a, Str.concat(prefix, Str.concat("_targ", Str.fromInt(i))), strs, defs, ens, ps, loc), rest, prefix, strs, defs, ens, ps, loc, i, code, vals)

def emitSelfTailGot(s: Slot, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, code: String, vals: List[String]): String =
  s match {
    case Slot(c, v, o) => emitSelfTailAcc(rest, prefix, strs, defs, ens, ps, loc, i + 1, join(code, c), List.concat(vals, tcoMark(v, o) :: noStr()))
  }

def tcoMark(v: String, o: Bool): String =
  if (o) Str.concat("~", v) else v

def tcoVal(v: String): String =
  if (Str.startsWith(v, "~")) Str.slice(v, 1, Str.len(v)) else v

def emitTcoCommit(code: String, ps: List[Param], vals: List[String], tag: String): String =
  join(code, join(emitTcoRetains(ps, vals, 0), join(emitTcoReleases(ps, 0, tag), join(emitTcoStores(ps, vals, 0), join(emitTcoHeld(ps, 0), join(emitTcoTempRels(ps, vals, 0), line("br label %tco_loop")))))))

def emitTcoRetains(ps: List[Param], vals: List[String], i: Int): String =
  if (i >= List.len(ps) || i >= List.len(vals)) "" else emitTcoRetainOne(List.at(ps, i), List.at(vals, i), ps, vals, i)

def emitTcoRetainOne(p: Param, v: String, ps: List[Param], vals: List[String], i: Int): String =
  p match {
    case Param(_, ty, _, _) => join(emitTcoRetainTy(ty, tcoVal(v)), emitTcoRetains(ps, vals, i + 1))
  }

def emitTcoRetainTy(ty: String, v: String): String =
  if (isI64Ty(ty)) "" else line(Str.concat("call void @sz_retain(ptr ", Str.concat(v, ")")))

def emitTcoReleases(ps: List[Param], i: Int, tag: String): String =
  if (i >= List.len(ps)) "" else emitTcoReleaseOne(List.at(ps, i), ps, i, tag)

def emitTcoReleaseOne(p: Param, ps: List[Param], i: Int, tag: String): String =
  p match {
    case Param(n, ty, _, _) => join(if (isI64Ty(ty)) "" else emitTcoReleaseN(n, i, tag), emitTcoReleases(ps, i + 1, tag))
  }

def emitTcoReleaseN(n: String, i: Int, tag: String): String =
  join(emitTcoHv(n, i, tag), join(emitTcoRelBr(i, tag), join(lab(tcoLab("rel", i, tag)), join(emitTcoOld(n, i, tag), join(emitTcoRelCall(i, tag), join(line(Str.concat("br label %", tcoLab("skip", i, tag))), lab(tcoLab("skip", i, tag))))))))

def tcoLab(kind: String, i: Int, tag: String): String =
  Str.concat("tco_", Str.concat(kind, Str.concat("_", Str.concat(Str.fromInt(i), Str.concat("_", tag)))))

def tcoSsa(kind: String, i: Int, tag: String): String =
  Str.concat("%tco_", Str.concat(kind, Str.concat(Str.fromInt(i), Str.concat("_", tag))))

def emitTcoHv(n: String, i: Int, tag: String): String =
  line(Str.concat(tcoSsa("hv", i, tag), Str.concat(" = load i1, ptr %", Str.concat(n, "_held"))))

def emitTcoRelBr(i: Int, tag: String): String =
  line(Str.concat("br i1 ", Str.concat(tcoSsa("hv", i, tag), Str.concat(", label %", Str.concat(tcoLab("rel", i, tag), Str.concat(", label %", tcoLab("skip", i, tag)))))))

def emitTcoOld(n: String, i: Int, tag: String): String =
  line(Str.concat(tcoSsa("old", i, tag), Str.concat(" = load ptr, ptr %", Str.concat(n, "_slot"))))

def emitTcoRelCall(i: Int, tag: String): String =
  line(Str.concat("call void @sz_release(ptr ", Str.concat(tcoSsa("old", i, tag), ")")))

def emitTcoStores(ps: List[Param], vals: List[String], i: Int): String =
  if (i >= List.len(ps) || i >= List.len(vals)) "" else emitTcoStoreOne(List.at(ps, i), List.at(vals, i), ps, vals, i)

def emitTcoStoreOne(p: Param, v: String, ps: List[Param], vals: List[String], i: Int): String =
  p match {
    case Param(n, ty, _, _) => join(line(Str.concat("store ", Str.concat(if (isI64Ty(ty)) "i64 " else "ptr ", Str.concat(tcoVal(v), Str.concat(", ptr %", Str.concat(n, "_slot")))))), emitTcoStores(ps, vals, i + 1))
  }

def emitTcoTempRels(ps: List[Param], vals: List[String], i: Int): String =
  if (i >= List.len(ps) || i >= List.len(vals)) "" else emitTcoTempRelOne(List.at(ps, i), List.at(vals, i), ps, vals, i)

def emitTcoTempRelOne(p: Param, v: String, ps: List[Param], vals: List[String], i: Int): String =
  p match {
    case Param(_, ty, _, _) => join(if (isI64Ty(ty)) "" else emitTcoTempRel(v), emitTcoTempRels(ps, vals, i + 1))
  }

def emitTcoTempRel(v: String): String =
  if (Str.startsWith(v, "~")) line(Str.concat("call void @sz_release(ptr ", Str.concat(tcoVal(v), ")"))) else ""

def emitTcoHeld(ps: List[Param], i: Int): String =
  if (i >= List.len(ps)) "" else emitTcoHeldOne(List.at(ps, i), ps, i)

def emitTcoHeldOne(p: Param, ps: List[Param], i: Int): String =
  p match {
    case Param(n, ty, _, _) => join(if (isI64Ty(ty)) "" else line(Str.concat("store i1 true, ptr %", Str.concat(n, "_held"))), emitTcoHeld(ps, i + 1))
  }

def contKey(mod: String, name: String): String =
  if (mod == "") name else Str.concat(mod, Str.concat("_", name))

def stampCont(ir: String, key: String): String =
  stampFrom(ir, "@sz_cont_", Str.concat("@sz_cont_", Str.concat(key, "_")))

def stampNeth(ir: String, key: String): String =
  stampFrom(ir, "@sz_neth_", Str.concat("@sz_neth_", Str.concat(key, "_")))

def stampFrom(s: String, old: String, neu: String): String =
  Builder.result(stampFromB(s, old, neu, 0, Builder.empty()))

def stampFromB(s: String, old: String, neu: String, i: Int, b: Builder): Builder =
  if (i >= Str.len(s)) b else stampFromAt(s, old, neu, i, findSub(s, old, i), b)

def stampFromAt(s: String, old: String, neu: String, i: Int, j: Int, b: Builder): Builder =
  if (j >= Str.len(s)) stampFromEnd(s, i, b) else stampFromB(s, old, neu, j + Str.len(old), Builder.append(Builder.append(b, stampGap(s, i, j)), neu))

def stampFromEnd(s: String, i: Int, b: Builder): Builder =
  if (i >= Str.len(s)) b else Builder.append(b, if (i == 0) s else Str.slice(s, i, Str.len(s)))

def stampGap(s: String, i: Int, j: Int): String =
  if (j <= i) "" else Str.slice(s, i, j)

def findSub(s: String, sub: String, i: Int): Int =
  if (i + Str.len(sub) > Str.len(s)) Str.len(s) else if (startsAt(s, i, sub)) i else findSub(s, sub, i + 1)

def startsAt(s: String, i: Int, old: String): Bool =
  i + Str.len(old) <= Str.len(s) && startsAtGo(s, i, old, 0)

def startsAtGo(s: String, i: Int, old: String, k: Int): Bool =
  if (k >= Str.len(old)) true else if (Str.charAt(s, i + k) != Str.charAt(old, k)) false else startsAtGo(s, i, old, k + 1)

def rwDef(d: Fun, defs: List[Fun], ens: List[En]): Fun =
  d match {
    case Fun(priv, name, ts, ps, ret, body, mod, off) => Fun(priv, name, ts, ps, ret, rwFields(body, paramEnv(ps), defs, ens, mod), mod, off)
  }

def paramEnv(ps: List[Param]): List[(String, String)] =
  if (List.isEmpty(ps)) noEnv() else paramEnv1(List.at(ps, 0), List.tail(ps))

def paramEnv1(p: Param, rest: List[Param]): List[(String, String)] =
  p match {
    case Param(n, ty, _, _) => (n, ty) :: paramEnv(rest)
  }

def rwFields(e: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String): Expr =
  e match {
    case Expr.EPrint(inner, _) => Expr.EPrint(rwFields(inner, env, funs, ens, mod), 0)
    case Expr.ECall(f, args, _) => rwCall(f, rwFieldList(args, env, funs, ens, mod), funs, mod)
    case Expr.EMethod(recv, name, args, _) => Expr.EMethod(rwFields(recv, env, funs, ens, mod), name, rwFieldList(args, env, funs, ens, mod), 0)
    case Expr.EField(recv, name, _) => rwField(rwFields(recv, env, funs, ens, mod), name, env, funs, ens)
    case Expr.EBin(op, l, r, _) => Expr.EBin(op, rwFields(l, env, funs, ens, mod), rwFields(r, env, funs, ens, mod), 0)
    case Expr.EUn(op, inner, _) => Expr.EUn(op, rwFields(inner, env, funs, ens, mod), 0)
    case Expr.ELam(p, ty, body) => Expr.ELam(p, ty, rwFields(body, env, funs, ens, mod))
    case Expr.EIf(c, t, el, _) => Expr.EIf(rwFields(c, env, funs, ens, mod), rwFields(t, env, funs, ens, mod), rwFields(el, env, funs, ens, mod), 0)
    case Expr.EMatch(s, arms, _) => Expr.EMatch(rwFields(s, env, funs, ens, mod), rwFieldArms(arms, env, funs, ens, mod), 0)
    case Expr.EList(xs) => Expr.EList(rwFieldList(xs, env, funs, ens, mod))
    case Expr.ETuple(xs) => Expr.ETuple(rwFieldList(xs, env, funs, ens, mod))
    case Expr.ENamed(n, inner) => Expr.ENamed(n, rwFields(inner, env, funs, ens, mod))
    case Expr.EAscribe(inner, ty, off) => Expr.EAscribe(rwFields(inner, env, funs, ens, mod), ty, off)
    case Expr.EFor(bs, body, _) => Expr.EFor(rwForBinds(bs, env, funs, ens, mod), rwFields(body, env, funs, ens, mod), 0)
    case _ => e
  }

def rwCall(f: String, args: List[Expr], funs: List[Fun], mod: String): Expr =
  if (List.isEmpty(findDefMod(funs, mod, f))) Expr.ECall(f, args, 0) else Expr.EMethod(Expr.EVar(mod, 0), f, args, 0)

def rwFieldList(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String): List[Expr] =
  if (List.isEmpty(xs)) noExpr() else rwFieldListGo(xs, env, funs, ens, mod)

def rwFieldListGo(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String): List[Expr] =
  rwFieldListH(List.at(xs, 0), env, funs, ens, mod, xs)

def rwFieldListH(h: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String, xs: List[Expr]): List[Expr] =
  rwFieldListT(h, env, funs, ens, mod, List.tail(xs))

def rwFieldListT(h: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String, rest: List[Expr]): List[Expr] =
  rwFieldListCons(rwFields(h, env, funs, copyEns(ens), mod), rest, env, funs, ens, mod)

def rwFieldListCons(e: Expr, rest: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String): List[Expr] =
  e :: rwFieldList(rest, env, funs, ens, mod)

def rwFieldArms(arms: List[Arm], env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String): List[Arm] =
  if (List.isEmpty(arms)) noArm() else rwFieldArm(List.at(arms, 0), env, funs, ens, mod) :: rwFieldArms(List.tail(arms), env, funs, ens, mod)

def rwForBinds(bs: List[Bind], env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String): List[Bind] =
  if (List.isEmpty(bs)) bs else rwForBindsHit(bs, env, funs, ens, mod)

def rwForBindsHit(bs: List[Bind], env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String): List[Bind] =
  bs match {
    case b :: rest => rwForBinds1(b, rest, env, funs, ens, mod)
    case [] => bs
  }

def rwForBinds1(b: Bind, rest: List[Bind], env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String): List[Bind] =
  b match {
    case Bind(d, n, v) => Bind(d, n, rwFields(v, env, funs, ens, mod)) :: rwForBinds(rest, env, funs, ens, mod)
  }

def rwFieldArm(a: Arm, env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String): Arm =
  a match {
    case Arm(pat, g, body) => Arm(pat, g, rwFields(body, env, funs, ens, mod))
  }

def rwField(recv: Expr, name: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Expr =
  recv match {
    case Expr.EVar(en, _) => rwFieldVar(en, name, env, ens)
    case Expr.EMethod(r, m, args, _) => rwFieldMethod(r, m, args, name, env, funs, ens)
    case Expr.ECall(f, args, _) => rwFieldTy(Expr.ECall(f, args, 0), name, copyEnCall(f, ens, funs), ens)
    case _ => rwFieldTy(recv, name, copyEn(recv, ens, funs), ens)
  }

def rwFieldVar(en: String, name: String, env: List[(String, String)], ens: List[En]): Expr =
  if (hasEn(ens, en)) Expr.EField(Expr.EVar(en, 0), name, 0) else rwFieldTy(Expr.EVar(en, 0), name, getTy(env, en), ens)

def rwFieldMethod(r: Expr, m: String, args: List[Expr], name: String, _env: List[(String, String)], funs: List[Fun], ens: List[En]): Expr =
  r match {
    case Expr.EVar(mod, _) => rwFieldQualHit(m, args, name, ens, findDefMod(funs, mod, m))
    case _ => rwFieldTy(Expr.EMethod(r, m, args, 0), name, copyEn(Expr.EMethod(r, m, args, 0), ens, funs), ens)
  }

def rwFieldQualHit(m: String, args: List[Expr], name: String, ens: List[En], hit: List[Fun]): Expr =
  if (List.isEmpty(hit)) Expr.EField(Expr.EMethod(Expr.EVar("", 0), m, args, 0), name, 0) else rwFieldQualFun(m, args, name, ens, List.at(hit, 0))

def rwFieldQualFun(m: String, args: List[Expr], name: String, ens: List[En], d: Fun): Expr =
  d match {
    case Fun(_, _, _, _, ret, _, mod, _) => rwFieldTy(Expr.EMethod(Expr.EVar(mod, 0), m, args, 0), name, ret, ens)
  }

def rwFieldTy(recv: Expr, name: String, ty: String, ens: List[En]): Expr =
  if (isTupTy(ty)) tupField(recv, name, ty) else recField(recv, name, recNames(copyEns(ens), ty), ty, ens)

def isTupTy(ty: String): Bool =
  Str.len(ty) > 0 && Str.charAt(ty, 0) == 40

def tupField(recv: Expr, name: String, ty: String): Expr =
  tupField2(recv, tupIdx(name), splitPat(Str.slice(ty, 1, Str.len(ty) - 1)))

def tupField2(recv: Expr, idx: Int, ns: List[String]): Expr =
  if (List.isEmpty(ns)) Expr.EMatch(recv, Arm(if (idx == 0) "(__f0, _)" else "(_, __f1)", "", Expr.EVar(if (idx == 0) "__f0" else "__f1", 0)) :: noArm(), 0) else Expr.EMatch(recv, Arm(Str.concat("(", Str.concat(bindsSelect(0, List.len(ns), idx), ")")), "", Expr.EVar(fakeBind(idx), 0)) :: noArm(), 0)

def recField(recv: Expr, name: String, ns: List[String], ty: String, ens: List[En]): Expr =
  if (List.isEmpty(ns)) Expr.EField(recv, name, 0) else recFieldGo(recv, name, ns, ty, ens)

def recFieldGo(recv: Expr, name: String, ns: List[String], ty: String, ens: List[En]): Expr =
  recFieldPair(recv, name, ty, ens, idxLen(ns, name, 0))

def idxLen(ns: List[String], name: String, i: Int): (Int, Int) =
  idxLenN(ns, name, i, List.len(ns))

def idxLenN(ns: List[String], name: String, i: Int, n: Int): (Int, Int) =
  if (i >= n) (0 - 1, n) else idxLenHit(List.at(ns, i), ns, name, i, n)

def idxLenHit(h: String, ns: List[String], name: String, i: Int, n: Int): (Int, Int) =
  if (h == name) (i, n) else idxLenN(ns, name, i + 1, n)

def recFieldPair(recv: Expr, name: String, ty: String, ens: List[En], p: (Int, Int)): Expr =
  p match {
    case (idx, n) => recField2(recv, name, idx, n, ty, recTys(ens, ty))
  }

def recField2(recv: Expr, name: String, idx: Int, n: Int, ty: String, tys: List[String]): Expr =
  if (idx < 0) Expr.EField(recv, name, 0) else Expr.EMatch(recv, Arm(Str.concat(ty, Str.concat("(", Str.concat(bindsTyped(0, n, tys), ")"))), "", Expr.EVar(pickBind(idx, tys), 0)) :: noArm(), 0)

def bindsTyped(i: Int, n: Int, tys: List[String]): String =
  if (i >= n) "" else if (i + 1 == n) pickBind(i, tys) else Str.concat(pickBind(i, tys), Str.concat(", ", bindsTyped(i + 1, n, tys)))

def pickBind(idx: Int, tys: List[String]): String =
  if (slotInt(tys, idx)) intBind(idx) else fakeBind(idx)

def intBind(i: Int): String =
  Str.concat(fakeBind(i), "_b0")

def recNames(ens: List[En], ty: String): List[String] =
  recNamesAt(ens, ty, 0)

def recNamesAt(ens: List[En], ty: String, i: Int): List[String] =
  if (i >= List.len(ens)) noStr() else recNamesHit(List.at(ens, i), ens, ty, i)

def recNamesHit(h: En, ens: List[En], ty: String, i: Int): List[String] =
  h match {
    case En(_, n, _, cases) => if (n == ty || n == tyHead(ty)) recNames2(cases) else recNamesAt(ens, ty, i + 1)
  }

def recNames2(cs: List[EnCase]): List[String] =
  if (List.isEmpty(cs)) noStr() else recNames3(List.at(cs, 0))

def recNames3(c: EnCase): List[String] =
  c match {
    case EnCase(_, fs) => paramNames(fs)
  }

def recTys(ens: List[En], ty: String): List[String] =
  recTysAt(ens, ty, 0)

def recTysAt(ens: List[En], ty: String, i: Int): List[String] =
  if (i >= List.len(ens)) noStr() else recTysHit(List.at(ens, i), ens, ty, i)

def recTysHit(h: En, ens: List[En], ty: String, i: Int): List[String] =
  h match {
    case En(_, n, _, cases) => if (n == ty || n == tyHead(ty)) recTys2(cases) else recTysAt(ens, ty, i + 1)
  }

def recTys2(cs: List[EnCase]): List[String] =
  if (List.isEmpty(cs)) noStr() else recTys3(List.at(cs, 0))

def recTys3(c: EnCase): List[String] =
  c match {
    case EnCase(_, fs) => paramTys(fs)
  }

def paramTys(fs: List[Param]): List[String] =
  if (List.isEmpty(fs)) noStr() else paramTys1(List.at(fs, 0), List.tail(fs))

def paramTys1(p: Param, rest: List[Param]): List[String] =
  p match {
    case Param(_, ty, _, _) => ty :: paramTys(rest)
  }

def paramNames(fs: List[Param]): List[String] =
  if (List.isEmpty(fs)) noStr() else paramNames1(List.at(fs, 0), List.tail(fs))

def paramNames1(p: Param, rest: List[Param]): List[String] =
  p match {
    case Param(n, _, _, _) => n :: paramNames(rest)
  }

def nameIdx(ns: List[String], name: String, i: Int): Int =
  if (i >= List.len(ns)) 0 - 1 else if (List.at(ns, i) == name) i else nameIdx(ns, name, i + 1)

def fakeBind(i: Int): String =
  Str.concat("__f", Str.fromInt(i))

def bindsComma(i: Int, n: Int): String =
  if (i >= n) "" else if (i + 1 == n) fakeBind(i) else Str.concat(fakeBind(i), Str.concat(", ", bindsComma(i + 1, n)))

def bindsSelect(i: Int, n: Int, idx: Int): String =
  if (i >= n) "" else if (i + 1 == n) bindOrWild(i, idx) else Str.concat(bindOrWild(i, idx), Str.concat(", ", bindsSelect(i + 1, n, idx)))

def bindOrWild(i: Int, idx: Int): String =
  if (i == idx) fakeBind(i) else "_"

def emitMain(body: Expr, strs: List[String], defs: List[Fun], ens: List[En], files: List[(String, String)]): String =
  stampNeth(emitMain2(emitExpr(rwFields(body, noEnv(), defs, ens, "Main"), "build", strs, defs, ens, noParam(), panicLocExpr(files, body)), defs, strs, ens, panicLocExpr(files, body)), "Main")

def emitMain2(s: Slot, defs: List[Fun], strs: List[String], ens: List[En], loc: String): String =
  emitMain3(s.code, s.val, drvFuns(defs), relFuns(defs), sessFuns(defs), strs, ens, loc)

def emitMain3(code: String, val: String, ds: List[Fun], rs: List[Fun], ss: List[Fun], strs: List[String], ens: List[En], loc: String): String =
  Str.concat(emitDrvTramps(ds, 0, ens, strs), emitMain4(code, val, Str.concat(emitDrvRegs(ds, strs, 0), Str.concat(emitRelRegs(rs, strs, 0), emitSessRegs(ss, strs, 0))), loc, strs))

def emitMain4(code: String, val: String, regs: String, loc: String, strs: List[String]): String =
  Str.concat("define i32 @main(i32 %argc, ptr %argv) {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), Str.concat(panicPush(loc, strs), Str.concat(regs, Str.concat(code, Str.concat("  %rc = call i32 @sz_runtime_main_args(ptr ", Str.concat(val, Str.concat(", i32 %argc, ptr %argv)", Str.concat(nl(), Str.concat(panicPop(), Str.concat("  ret i32 %rc", Str.concat(nl(), "}"))))))))))))))

def drvFuns(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else drvFuns1(List.at(ds, 0), List.tail(ds))

def drvFuns1(d: Fun, rest: List[Fun]): List[Fun] =
  if (isDrv(d)) d :: drvFuns(rest) else drvFuns(rest)

def isDrv(d: Fun): Bool =
  d.mod == "__verify" && isIoTy(d.ret)

def isRelFun(d: Fun): Bool =
  d.ret == "Verdict" && List.len(d.params) == 2 && isTlPs(d.params)

def isSessFun(d: Fun): Bool =
  d.ret == "Verdict" && List.len(d.params) == 1 && isTlPs(d.params)

def isTlPs(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) true else isTlPsGo(List.at(ps, 0), List.tail(ps))

def isTlPsGo(h: Param, rest: List[Param]): Bool =
  h match {
    case Param(_, ty, _, _) => ty == "Timeline" && isTlPs(rest)
  }

def relFuns(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else relFuns1(List.at(ds, 0), List.tail(ds))

def relFuns1(d: Fun, rest: List[Fun]): List[Fun] =
  if (isRelFun(d)) d :: relFuns(rest) else relFuns(rest)

def sessFuns(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else sessFuns1(List.at(ds, 0), List.tail(ds))

def sessFuns1(d: Fun, rest: List[Fun]): List[Fun] =
  if (isSessFun(d)) d :: sessFuns(rest) else sessFuns(rest)

def internRel(p: Prog, acc: List[String]): List[String] =
  p match {
    case Prog(_, enums, _, _, _, _, defs, _, _) => internRelDefs(defs, internEns(enums, internRelStr(defs, acc)))
  }

def internRelStr(defs: List[Fun], acc: List[String]): List[String] =
  if (needsDecodeStr(defs)) intern(acc, "drive decode failed") else acc

def needsDecodeStr(defs: List[Fun]): Bool =
  !List.isEmpty(relFuns(defs)) || !List.isEmpty(sessFuns(defs)) || !List.isEmpty(drvFuns(defs))

def internEns(ens: List[En], acc: List[String]): List[String] =
  if (List.isEmpty(ens)) acc else internEn(List.at(ens, 0), internEns(List.tail(ens), acc))

def internEn(e: En, acc: List[String]): List[String] =
  e match {
    case En(_, name, _, cases) => internCases(cases, intern(acc, name))
  }

def internCases(cs: List[EnCase], acc: List[String]): List[String] =
  if (List.isEmpty(cs)) acc else internCases(List.tail(cs), internCase(List.at(cs, 0), acc))

def internCase(c: EnCase, acc: List[String]): List[String] =
  intern(acc, c.name)

def internRelDefs(ds: List[Fun], acc: List[String]): List[String] =
  if (List.isEmpty(ds)) acc else internRelDefs(List.tail(ds), internRelDef(List.at(ds, 0), acc))

def internRelDef(d: Fun, acc: List[String]): List[String] =
  if (isRelFun(d) || isSessFun(d)) intern(acc, d.name) else if (isDrv(d)) intern(acc, drvRegName(d.name)) else acc

def internSigProg(p: Prog, files: List[(String, String)], acc: List[String]): List[String] =
  p match {
    case Prog(_, _, _, _, impls, _, defs, _, body) => internSigDefs(defs, files, internSigImpls(impls, files, intern(internSigExpr(body, acc), panicLocExpr(files, body))))
  }

def internSigImpls(xs: List[Im], files: List[(String, String)], acc: List[String]): List[String] =
  if (List.isEmpty(xs)) acc else internSigImpls(List.tail(xs), files, internSigImpl(List.at(xs, 0), files, acc))

def internSigImpl(x: Im, files: List[(String, String)], acc: List[String]): List[String] =
  x match {
    case Im(_, _, forTy, methods) => internSigDefs(stampMod(methods, forTy, noFun()), files, acc)
  }

def internSigDefs(ds: List[Fun], files: List[(String, String)], acc: List[String]): List[String] =
  if (List.isEmpty(ds)) acc else internSigDefs(List.tail(ds), files, internSigDef(List.at(ds, 0), files, acc))

def internSigDef(d: Fun, files: List[(String, String)], acc: List[String]): List[String] =
  d match {
    case Fun(_, _, _, _, _, body, mod, off) => internSigExpr(body, intern(acc, panicLoc(files, mod, off)))
  }

def internSigBinds(bs: List[Bind], acc: List[String]): List[String] =
  if (List.isEmpty(bs)) acc else internSigBinds(List.tail(bs), internSigBind(List.at(bs, 0), acc))

def internSigBind(b: Bind, acc: List[String]): List[String] =
  b match {
    case Bind(draw, name, v) => internSigExpr(v, internSigName(draw, name, v, acc))
  }

def internSigName(draw: Bool, name: String, v: Expr, acc: List[String]): List[String] =
  if (draw || name == "_" || !isSimpleBind(name)) acc else internSigNameGo(name, v, acc)

def internSigNameGo(name: String, v: Expr, acc: List[String]): List[String] =
  v match {
    case Expr.ECall(f, _, _) => if (sigCtorKit(f)) intern(acc, name) else acc
    case _ => acc
  }

def internSigExpr(e: Expr, acc: List[String]): List[String] =
  e match {
    case Expr.EFor(bs, body, _) => internSigExpr(body, internSigBinds(bs, acc))
    case Expr.ECall(_, args, _) => internSigList(args, acc)
    case Expr.EMethod(recv, _, args, _) => internSigList(args, internSigExpr(recv, acc))
    case Expr.EField(recv, _, _) => internSigExpr(recv, acc)
    case Expr.EPrint(inner, _) => internSigExpr(inner, acc)
    case Expr.EBin(_, l, r, _) => internSigExpr(r, internSigExpr(l, acc))
    case Expr.EUn(_, inner, _) => internSigExpr(inner, acc)
    case Expr.ELam(_, _, body) => internSigExpr(body, acc)
    case Expr.EIf(c, t, el, _) => internSigExpr(el, internSigExpr(t, internSigExpr(c, acc)))
    case Expr.EMatch(s, arms, _) => internSigArms(arms, internSigExpr(s, acc))
    case Expr.EList(xs) => internSigList(xs, acc)
    case Expr.ETuple(xs) => internSigList(xs, acc)
    case Expr.ENamed(_, inner) => internSigExpr(inner, acc)
    case Expr.EAscribe(inner, _, _) => internSigExpr(inner, acc)
    case _ => acc
  }

def internSigList(xs: List[Expr], acc: List[String]): List[String] =
  if (List.isEmpty(xs)) acc else internSigList(List.tail(xs), internSigExpr(List.at(xs, 0), acc))

def internSigArms(xs: List[Arm], acc: List[String]): List[String] =
  if (List.isEmpty(xs)) acc else internSigArms(List.tail(xs), internSigArm(List.at(xs, 0), acc))

def internSigArm(a: Arm, acc: List[String]): List[String] =
  a match {
    case Arm(_, _, body) => internSigExpr(body, acc)
  }

def emitRelRegs(ds: List[Fun], strs: List[String], i: Int): String =
  if (List.isEmpty(ds)) "" else Str.concat(emitRelReg(List.at(ds, 0), strs, i), emitRelRegs(List.tail(ds), strs, i + 1))

def emitRelReg(d: Fun, strs: List[String], i: Int): String =
  d match {
    case Fun(_, name, _, _, _, _, mod, _) => emitRelReg2(name, mod, strs, i)
  }

def emitRelReg2(name: String, mod: String, strs: List[String], i: Int): String =
  join(relGep(name, strs, i), relCall(name, mod, i))

def relGep(name: String, strs: List[String], i: Int): String =
  line(Str.concat("%vrl", Str.concat(Str.fromInt(i), Str.concat("_gep = getelementptr inbounds [", Str.concat(Str.fromInt(strArr(name)), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(strIndex(strs, name, 0)), ", i64 0, i64 0")))))))

def relCall(name: String, mod: String, i: Int): String =
  line(Str.concat("call void @sz_verify_register_rel(ptr %vrl", Str.concat(Str.fromInt(i), Str.concat("_gep, ptr @sz_user_", Str.concat(symOf(mod, name), ")")))))

def emitSessRegs(ds: List[Fun], strs: List[String], i: Int): String =
  if (List.isEmpty(ds)) "" else Str.concat(emitSessReg(List.at(ds, 0), strs, i), emitSessRegs(List.tail(ds), strs, i + 1))

def emitSessReg(d: Fun, strs: List[String], i: Int): String =
  d match {
    case Fun(_, name, _, _, _, _, mod, _) => emitSessReg2(name, mod, strs, i)
  }

def emitSessReg2(name: String, mod: String, strs: List[String], i: Int): String =
  join(sessGep(name, strs, i), sessCall(name, mod, i))

def sessGep(name: String, strs: List[String], i: Int): String =
  line(Str.concat("%ver", Str.concat(Str.fromInt(i), Str.concat("_gep = getelementptr inbounds [", Str.concat(Str.fromInt(strArr(name)), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(strIndex(strs, name, 0)), ", i64 0, i64 0")))))))

def sessCall(name: String, mod: String, i: Int): String =
  line(Str.concat("call void @sz_verify_register(ptr %ver", Str.concat(Str.fromInt(i), Str.concat("_gep, ptr @sz_user_", Str.concat(symOf(mod, name), ")")))))

def emitDrvRegs(ds: List[Fun], strs: List[String], i: Int): String =
  if (List.isEmpty(ds)) "" else Str.concat(emitDrvReg(List.at(ds, 0), strs, i), emitDrvRegs(List.tail(ds), strs, i + 1))

def emitDrvReg(d: Fun, strs: List[String], i: Int): String =
  d match {
    case Fun(_, name, _, ps, _, _, mod, _) => emitDrvReg2(drvRegName(name), name, ps, mod, strs, i)
  }

def drvRegName(name: String): String =
  if (Str.startsWith(name, "_drv_")) Str.slice(name, 5, Str.len(name)) else name

def emitDrvReg2(reg: String, name: String, ps: List[Param], mod: String, strs: List[String], i: Int): String =
  join(drvGep(reg, strs, i), join(drvSs(i), drvCall(name, ps, mod, i)))

def emitDrvTramps(ds: List[Fun], i: Int, ens: List[En], strs: List[String]): String =
  if (List.isEmpty(ds)) "" else Str.concat(emitDrvTramp(List.at(ds, 0), i, ens, strs), emitDrvTramps(List.tail(ds), i + 1, ens, strs))

def emitDrvTramp(d: Fun, i: Int, ens: List[En], strs: List[String]): String =
  d match {
    case Fun(_, name, _, ps, _, _, mod, _) => emitDrvTramp2(name, ps, mod, i, ens, strs)
  }

def emitDrvTramp2(name: String, ps: List[Param], mod: String, i: Int, ens: List[En], strs: List[String]): String =
  if (needsDecode(ps)) decodeTramp(name, ps, mod, i, ens, strs) else if (List.len(ps) <= 1) "" else trampFn(name, ps, mod, i)

def needsDecode(ps: List[Param]): Bool =
  !List.isEmpty(ps) && (needsDecodeP(List.at(ps, 0)) || needsDecode(List.tail(ps)))

def needsDecodeP(p: Param): Bool =
  p.ty != "Int" && p.ty != "String" && p.ty != "Bool"

def drvSym(name: String, ps: List[Param], mod: String, i: Int): String =
  if (needsDecode(ps) || List.len(ps) > 1) Str.concat("@sz_drv_tramp_", Str.fromInt(i)) else Str.concat("@sz_user_", symOf(mod, name))

def decodeTramp(name: String, ps: List[Param], mod: String, i: Int, ens: List[En], strs: List[String]): String =
  if (List.len(ps) != 1) trampFn(name, ps, mod, i) else decodeTramp1(name, List.at(ps, 0), mod, i, ens, strs)

def trampPre(i: Int): String =
  Str.concat("t", Str.concat(Str.fromInt(i), "_"))

def decodeTramp1(name: String, p: Param, mod: String, i: Int, ens: List[En], strs: List[String]): String =
  decodeTrampGot(name, mod, i, decodeTok(pct(trampPre(i), "cs"), p.ty, ens, strs, trampPre(i), 0, 0))

def decodeTrampGot(name: String, mod: String, i: Int, d: Dec): String =
  d match {
    case Dec(code, val, num, owned, _) => decodeTrampEnd(name, mod, i, code, val, num, owned)
  }

def decodeTrampEnd(name: String, mod: String, i: Int, code: String, val: String, num: Bool, owned: Bool): String =
  Str.concat(decodeHeader(i), Str.concat(line(Str.concat(tmp(trampPre(i), "cs"), "call ptr @sz_string_cstr(ptr %a)")), Str.concat(code, Str.concat(decodeCall(name, mod, val, num), Str.concat(if (owned) relPtr(val) else "", Str.concat(line("ret ptr %dio"), Str.concat(Str.concat("}", nl()), nl())))))))

def decodeHeader(i: Int): String =
  Str.concat("define internal ptr @sz_drv_tramp_", Str.concat(Str.fromInt(i), Str.concat("(ptr %a) {", Str.concat(nl(), Str.concat("entry:", nl())))))

def decodeCall(name: String, mod: String, val: String, num: Bool): String =
  line(Str.concat("%dio = call ptr @sz_user_", Str.concat(symOf(mod, name), Str.concat("(", Str.concat(if (num) "i64 " else "ptr ", Str.concat(val, ")"))))))

def decId(prefix: String, stem: String, n: Int): String =
  Str.concat(prefix, Str.concat(stem, Str.fromInt(n)))

def decPct(prefix: String, stem: String, n: Int): String =
  Str.concat("%", decId(prefix, stem, n))

def decLab(prefix: String, n: Int): String =
  Str.concat(prefix, Str.fromInt(n))

def decodeTok(tok: String, ty: String, ens: List[En], strs: List[String], prefix: String, n: Int, depth: Int): Dec =
  if (ty == "Int") decParse("sz_drive_parse_int", tok, prefix, n) else if (ty == "Bool") decParse("sz_drive_parse_bool", tok, prefix, n) else if (ty == "String") decFromCstr(tok, prefix, n) else decodeAdt(tok, ty, ens, strs, prefix, n, depth)

def decParse(rt: String, tok: String, prefix: String, n: Int): Dec =
  Dec(decParseCode(rt, tok, prefix, n), decPct(prefix, "p", n), true, false, n + 1)

def decParseCode(rt: String, tok: String, prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "p", n), Str.concat(" = call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(tok, ")"))))))

def decFromCstr(tok: String, prefix: String, n: Int): Dec =
  Dec(decFromCstrCode(tok, prefix, n), decPct(prefix, "s", n), false, true, n + 1)

def decFromCstrCode(tok: String, prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "s", n), Str.concat(" = call ptr @sz_string_from_cstr(ptr ", Str.concat(tok, ")"))))

def decodeAdt(tok: String, ty: String, ens: List[En], strs: List[String], prefix: String, n: Int, depth: Int): Dec =
  decodeAdtHit(tok, findEnNm(ens, tyHead(ty)), ens, strs, prefix, n, depth)

def findEnNm(ens: List[En], name: String): List[En] =
  if (List.isEmpty(ens)) noEn() else findEnNm1(List.at(ens, 0), List.tail(ens), name)

def findEnNm1(h: En, rest: List[En], name: String): List[En] =
  h match {
    case En(_, n, _, _) => if (n == name) h :: noEn() else findEnNm(rest, name)
  }

def decodeAdtHit(tok: String, hit: List[En], ens: List[En], strs: List[String], prefix: String, n: Int, depth: Int): Dec =
  if (List.isEmpty(hit)) decParse("sz_drive_parse_int", tok, prefix, n) else decodeAdtEn(tok, List.at(hit, 0), ens, strs, prefix, n, depth)

def decodeAdtEn(tok: String, e: En, ens: List[En], strs: List[String], prefix: String, n: Int, depth: Int): Dec =
  e match {
    case En(isRec, name, _, cases) => decodeAdtBody(tok, pickCases(isRec, name, cases, depth), ens, strs, prefix, n, depth)
  }

def pickCases(isRec: Bool, name: String, cases: List[EnCase], depth: Int): List[EnCase] =
  if (depth >= 3) leafDrvCases(cases) else cases

def leafDrvCases(cs: List[EnCase]): List[EnCase] =
  if (List.isEmpty(cs)) cs else leafDrv1(List.at(cs, 0), List.tail(cs))

def leafDrv1(c: EnCase, rest: List[EnCase]): List[EnCase] =
  if (drvLeaf(c)) c :: leafDrvCases(rest) else leafDrvCases(rest)

def drvLeaf(c: EnCase): Bool =
  c match {
    case EnCase(_, fs) => drvAllLeaf(fs)
  }

def drvAllLeaf(fs: List[Param]): Bool =
  if (List.isEmpty(fs)) true else drvAllLeafGo(List.at(fs, 0), List.tail(fs))

def drvAllLeafGo(h: Param, rest: List[Param]): Bool =
  h match {
    case Param(_, ty, _, _) => drvLeafTy(ty) && drvAllLeaf(rest)
  }

def drvLeafTy(t: String): Bool =
  t == "Int" || t == "String" || t == "Bool"

def decodeAdtBody(tok: String, cases: List[EnCase], ens: List[En], strs: List[String], prefix: String, n: Int, depth: Int): Dec =
  decodeAdtBody2(tok, cases, ens, strs, prefix, n, n + 1, n + 2, List.len(cases), depth)

def decodeAdtBody2(tok: String, cases: List[EnCase], ens: List[En], strs: List[String], prefix: String, inner: Int, fail: Int, joinL: Int, k: Int, depth: Int): Dec =
  decodeTries(tok, cases, 0, k, inner + 3, fail, joinL, prefix, inner + 3 + k + k, "", ens, strs, depth, inner, decAlloca(prefix, inner), if (k == 0) fail else inner + 3)

def decAlloca(prefix: String, inner: Int): String =
  line(Str.concat(decPct(prefix, "b", inner), " = alloca [192 x i8], align 1"))

def decodeTries(tok: String, cases: List[EnCase], i: Int, k: Int, base: Int, fail: Int, joinL: Int, prefix: String, n: Int, phi: String, ens: List[En], strs: List[String], depth: Int, inner: Int, code: String, first: Int): Dec =
  if (i >= k) decodeFailJoin(prefix, fail, joinL, phi, code, first, k, strs, n) else decodeTry(tok, cases, List.at(cases, i), i, k, base, fail, joinL, prefix, n, phi, ens, strs, depth, inner, code, first)

def decodeTry(tok: String, cases: List[EnCase], c: EnCase, i: Int, k: Int, base: Int, fail: Int, joinL: Int, prefix: String, n: Int, phi: String, ens: List[En], strs: List[String], depth: Int, inner: Int, code: String, first: Int): Dec =
  c match {
    case EnCase(cname, fs) => decodeTry2(tok, cases, cname, fs, i, k, base, fail, joinL, prefix, n, phi, ens, strs, depth, inner, code, first)
  }

def decodeTry2(tok: String, cases: List[EnCase], cname: String, fs: List[Param], i: Int, k: Int, base: Int, fail: Int, joinL: Int, prefix: String, n: Int, phi: String, ens: List[En], strs: List[String], depth: Int, inner: Int, code: String, first: Int): Dec =
  decodeTry3(internGep(cname, strs, prefix, n), tok, cases, fs, i, k, base, fail, joinL, prefix, n + 1, phi, ens, strs, depth, inner, code, first)

def internGep(s: String, strs: List[String], prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "g", n), internGepRhs(s, strs)))

def internGepRhs(s: String, strs: List[String]): String =
  Str.concat(" = getelementptr inbounds [", Str.concat(Str.fromInt(strArr(s)), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(strIndex(strs, s, 0)), ", i64 0, i64 0"))))

def decodeTry3(gep: String, tok: String, cases: List[EnCase], fs: List[Param], i: Int, k: Int, base: Int, fail: Int, joinL: Int, prefix: String, n: Int, phi: String, ens: List[En], strs: List[String], depth: Int, inner: Int, code: String, first: Int): Dec =
  decodeConstruct(decodeFields(fs, 0, decPct(prefix, "b", inner), ens, strs, prefix, n + 2, depth + 1), tok, cases, i, k, base, fail, joinL, prefix, phi, ens, strs, depth, inner, tryHead(code, gep, tok, i, k, base, fail, prefix, n, inner, first))

def tryHead(code: String, gep: String, tok: String, i: Int, k: Int, base: Int, fail: Int, prefix: String, n: Int, inner: Int, first: Int): String =
  join(code, join(if (i == 0) decBr(prefix, first) else "", join(lab(decLab(prefix, base + i)), join(gep, join(unconsLine(tok, prefix, n, inner), join(unconsIcmp(prefix, n), unconsBr(prefix, n, base, k, i, fail)))))))

def unconsLine(tok: String, prefix: String, n: Int, inner: Int): String =
  line(Str.concat(decPct(prefix, "is", n), Str.concat(" = call i32 @sz_drive_uncons(ptr ", Str.concat(tok, Str.concat(", ptr ", Str.concat(decPct(prefix, "g", n - 1), Str.concat(", ptr ", Str.concat(decPct(prefix, "b", inner), ", i32 192)"))))))))

def unconsIcmp(prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "h", n), Str.concat(" = icmp ne i32 ", Str.concat(decPct(prefix, "is", n), ", 0"))))

def unconsBr(prefix: String, n: Int, base: Int, k: Int, i: Int, fail: Int): String =
  line(Str.concat("br i1 ", Str.concat(decPct(prefix, "h", n), Str.concat(", label %", Str.concat(decLab(prefix, base + k + i), Str.concat(", label %", Str.concat(decLab(prefix, if (i + 1 < k) base + i + 1 else fail), "")))))))

def decBr(prefix: String, dest: Int): String =
  line(Str.concat("br label %", decLab(prefix, dest)))

def decodeConstruct(fields: Decs, tok: String, cases: List[EnCase], i: Int, k: Int, base: Int, fail: Int, joinL: Int, prefix: String, phi: String, ens: List[En], strs: List[String], depth: Int, inner: Int, head: String): Dec =
  fields match {
    case Decs(fc, ds, n2) => decodeConstruct2(buildAdt(i, ds, prefix, n2), tok, cases, i, k, base, fail, joinL, prefix, phi, ens, strs, depth, inner, join(head, join(lab(decLab(prefix, base + k + i)), fc)))
  }

def decodeConstruct2(built: Dec, tok: String, cases: List[EnCase], i: Int, k: Int, base: Int, fail: Int, joinL: Int, prefix: String, phi: String, ens: List[En], strs: List[String], depth: Int, inner: Int, head: String): Dec =
  built match {
    case Dec(bc, bv, _, _, n3) => decodeTries(tok, cases, i + 1, k, base, fail, joinL, prefix, n3 + 1, phiAdd(phi, bv, prefix, n3), ens, strs, depth, inner, join(head, join(bc, join(decBr(prefix, n3), join(lab(decLab(prefix, n3)), decBr(prefix, joinL))))), base)
  }

def noDec(): List[Dec] =
  []

def decodeFields(fs: List[Param], i: Int, inner: String, ens: List[En], strs: List[String], prefix: String, n: Int, depth: Int): Decs =
  if (List.isEmpty(fs)) Decs("", noDec(), n) else decodeFields1(List.at(fs, 0), List.tail(fs), i, inner, ens, strs, prefix, n, depth)

def decodeFields1(p: Param, rest: List[Param], i: Int, inner: String, ens: List[En], strs: List[String], prefix: String, n: Int, depth: Int): Decs =
  decodeFields2(decodeTok(decPct(prefix, "f", n), p.ty, ens, strs, prefix, n + 1, depth), fieldPrep(inner, prefix, n, i), rest, i, inner, ens, strs, prefix, depth)

def fieldPrep(inner: String, prefix: String, n: Int, i: Int): String =
  join(line(Str.concat(decPct(prefix, "f", n), " = alloca [192 x i8], align 1")), fieldCall(inner, prefix, n, i))

def fieldCall(inner: String, prefix: String, n: Int, i: Int): String =
  line(Str.concat(decPct(prefix, "ok", n), Str.concat(" = call i32 @sz_drive_field(ptr ", Str.concat(inner, Str.concat(", i64 ", Str.concat(Str.fromInt(i), Str.concat(", ptr ", Str.concat(decPct(prefix, "f", n), ", i32 192)"))))))))

def decodeFields2(d: Dec, pre: String, rest: List[Param], i: Int, inner: String, ens: List[En], strs: List[String], prefix: String, depth: Int): Decs =
  d match {
    case Dec(dc, _, _, _, n2) => decodeFields3(pre, dc, d, decodeFields(rest, i + 1, inner, ens, strs, prefix, n2, depth))
  }

def decodeFields3(pre: String, dc: String, d: Dec, rest: Decs): Decs =
  rest match {
    case Decs(rc, ds, n3) => Decs(join(pre, join(dc, rc)), d :: ds, n3)
  }

def buildAdt(tag: Int, ds: List[Dec], prefix: String, n: Int): Dec =
  if (List.isEmpty(ds)) Dec(buildAdtNil(tag, prefix, n), decPct(prefix, "a", n), false, true, n + 1) else if (List.len(ds) == 1) buildAdt1(tag, List.at(ds, 0), prefix, n) else buildAdtN(tag, ds, prefix, n)

def buildAdtNil(tag: Int, prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "a", n), Str.concat(" = call ptr @sz_adt_new(i32 ", Str.concat(Str.fromInt(tag), ", ptr null)"))))

def buildAdt1(tag: Int, d: Dec, prefix: String, n: Int): Dec =
  d match {
    case Dec(_, v, num, owned, _) => if (num) buildAdtBox(tag, v, prefix, n) else buildAdtPtr(tag, v, owned, prefix, n)
  }

def buildAdtBox(tag: Int, v: String, prefix: String, n: Int): Dec =
  Dec(buildAdtBoxCode(tag, v, prefix, n), decPct(prefix, "a", n), false, true, n + 1)

def buildAdtBoxCode(tag: Int, v: String, prefix: String, n: Int): String =
  join(boxI64Line(v, prefix, n), join(adtNewPtr(tag, decPct(prefix, "x", n), prefix, n), relPtr(decPct(prefix, "x", n))))

def boxI64Line(v: String, prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "x", n), Str.concat(" = call ptr @sz_box_i64(i64 ", Str.concat(v, ")"))))

def adtNewPtr(tag: Int, payload: String, prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "a", n), Str.concat(" = call ptr @sz_adt_new(i32 ", Str.concat(Str.fromInt(tag), Str.concat(", ptr ", Str.concat(payload, ")"))))))

def buildAdtPtr(tag: Int, v: String, owned: Bool, prefix: String, n: Int): Dec =
  Dec(buildAdtPtrCode(tag, v, owned, prefix, n), decPct(prefix, "a", n), false, true, n + 1)

def buildAdtPtrCode(tag: Int, v: String, owned: Bool, prefix: String, n: Int): String =
  join(adtNewPtr(tag, v, prefix, n), if (owned) relPtr(v) else "")

def buildAdtN(tag: Int, ds: List[Dec], prefix: String, n: Int): Dec =
  buildAdtN2(tag, consFold(List.reverse(ds), decPct(prefix, "nl", n), prefix, n + 1, line(Str.concat(decPct(prefix, "nl", n), " = call ptr @sz_list_nil()"))), prefix)

def consFold(ds: List[Dec], cur: String, prefix: String, n: Int, code: String): Dec =
  if (List.isEmpty(ds)) Dec(code, cur, false, true, n) else consFold1(List.at(ds, 0), List.tail(ds), cur, prefix, n, code)

def consFold1(h: Dec, rest: List[Dec], cur: String, prefix: String, n: Int, code: String): Dec =
  h match {
    case Dec(_, v, num, owned, _) => if (num) consFoldBox(v, rest, cur, prefix, n, code) else consFoldPtr(v, owned, rest, cur, prefix, n, code)
  }

def consFoldBox(v: String, rest: List[Dec], cur: String, prefix: String, n: Int, code: String): Dec =
  consFold(rest, decPct(prefix, "c", n), prefix, n + 1, join(code, consBoxCode(v, cur, prefix, n)))

def consBoxCode(v: String, cur: String, prefix: String, n: Int): String =
  join(boxI64Line(v, prefix, n), join(consLine(decPct(prefix, "x", n), cur, prefix, n), join(relPtr(decPct(prefix, "x", n)), relPtr(cur))))

def consLine(hd: String, tl: String, prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "c", n), Str.concat(" = call ptr @sz_list_cons(ptr ", Str.concat(hd, Str.concat(", ptr ", Str.concat(tl, ")"))))))

def consFoldPtr(v: String, owned: Bool, rest: List[Dec], cur: String, prefix: String, n: Int, code: String): Dec =
  consFold(rest, decPct(prefix, "c", n), prefix, n + 1, join(code, join(consLine(v, cur, prefix, n), join(if (owned) relPtr(v) else "", relPtr(cur)))))

def buildAdtN2(tag: Int, lst: Dec, prefix: String): Dec =
  lst match {
    case Dec(lc, lv, _, _, n) => Dec(buildAdtN2Code(tag, lc, lv, prefix, n), decPct(prefix, "a", n), false, true, n + 1)
  }

def buildAdtN2Code(tag: Int, lc: String, lv: String, prefix: String, n: Int): String =
  join(lc, join(adtNewPtr(tag, lv, prefix, n), relPtr(lv)))

def phiAdd(phi: String, v: String, prefix: String, lab: Int): String =
  if (phi == "") Str.concat("[ ", Str.concat(v, Str.concat(", %", Str.concat(decLab(prefix, lab), " ]")))) else Str.concat(phi, Str.concat(", [ ", Str.concat(v, Str.concat(", %", Str.concat(decLab(prefix, lab), " ]")))))

def decodeFailJoin(prefix: String, fail: Int, joinL: Int, phi: String, code: String, first: Int, k: Int, strs: List[String], n: Int): Dec =
  Dec(decodeFailCode(prefix, fail, joinL, phi, code, k, strs, n), decPct(prefix, "ap", joinL), false, true, n + 1)

def decodeFailCode(prefix: String, fail: Int, joinL: Int, phi: String, code: String, k: Int, strs: List[String], n: Int): String =
  join(code, join(if (k == 0) decBr(prefix, fail) else "", join(lab(decLab(prefix, fail)), join(internGep("drive decode failed", strs, prefix, n), join(decodePanic(prefix, n), join(lab(decLab(prefix, joinL)), decodePhi(prefix, joinL, phi)))))))

def decodePanic(prefix: String, fail: Int): String =
  join(fromCstrLine(prefix, fail), join(panicLine(prefix, fail), line("unreachable")))

def fromCstrLine(prefix: String, fail: Int): String =
  line(Str.concat(decPct(prefix, "ps", fail), Str.concat(" = call ptr @sz_string_from_cstr(ptr ", Str.concat(decPct(prefix, "g", fail), ")"))))

def panicLine(prefix: String, fail: Int): String =
  line(Str.concat("call void @sz_panic(ptr ", Str.concat(decPct(prefix, "ps", fail), ")")))

def decodePhi(prefix: String, joinL: Int, phi: String): String =
  line(Str.concat(decPct(prefix, "ap", joinL), Str.concat(" = phi ptr ", if (phi == "") "[ null, %entry ]" else phi)))

def trampFn(name: String, ps: List[Param], mod: String, i: Int): String =
  Str.concat("define internal ptr @sz_drv_tramp_", Str.concat(Str.fromInt(i), Str.concat("(ptr %args) {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), Str.concat(trampLoads(ps, 0), Str.concat(trampRet(name, ps, mod), Str.concat("}", Str.concat(nl(), nl()))))))))))

def trampLoads(ps: List[Param], k: Int): String =
  if (List.isEmpty(ps)) "" else Str.concat(trampLoad(List.at(ps, 0), k), trampLoads(List.tail(ps), k + 1))

def trampLoad(p: Param, k: Int): String =
  join(line(Str.concat("%da", Str.concat(Str.fromInt(k), Str.concat(" = call ptr @sz_list_at(ptr %args, i64 ", Str.concat(Str.fromInt(k), ")"))))), trampUnbox(p, k))

def trampUnbox(p: Param, k: Int): String =
  if (isI64Ty(p.ty)) line(Str.concat("%dv", Str.concat(Str.fromInt(k), Str.concat(" = call i64 @sz_unbox_i64(ptr %da", Str.concat(Str.fromInt(k), ")"))))) else ""

def trampRet(name: String, ps: List[Param], mod: String): String =
  join(line(Str.concat("%dio = call ptr @sz_user_", Str.concat(symOf(mod, name), Str.concat("(", Str.concat(trampArgs(ps, 0), ")"))))), line("ret ptr %dio"))

def trampArgs(ps: List[Param], k: Int): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) trampArg(List.at(ps, 0), k) else Str.concat(trampArg(List.at(ps, 0), k), Str.concat(", ", trampArgs(List.tail(ps), k + 1)))

def trampArg(p: Param, k: Int): String =
  if (isI64Ty(p.ty)) Str.concat("i64 %dv", Str.fromInt(k)) else Str.concat("ptr %da", Str.fromInt(k))

def drvGep(name: String, strs: List[String], i: Int): String =
  line(Str.concat("%drv", Str.concat(Str.fromInt(i), Str.concat("_gep = getelementptr inbounds [", Str.concat(Str.fromInt(strArr(name)), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(strIndex(strs, name, 0)), ", i64 0, i64 0")))))))

def drvSs(i: Int): String =
  line(Str.concat("%drv", Str.concat(Str.fromInt(i), Str.concat("_ss = call ptr @sz_string_from_cstr(ptr %drv", Str.concat(Str.fromInt(i), "_gep)")))))

def drvCall(name: String, ps: List[Param], mod: String, i: Int): String =
  line(Str.concat("call void @sz_driver_register(ptr %drv", Str.concat(Str.fromInt(i), Str.concat("_ss, i64 ", Str.concat(Str.fromInt(List.len(ps)), Str.concat(", i64 ", Str.concat(Str.fromInt(packKind(ps)), Str.concat(", ptr ", Str.concat(drvSym(name, ps, mod, i), ")")))))))))

def packKind(ps: List[Param]): Int =
  packKindAt(ps, 1, 0)

def packKindAt(ps: List[Param], place: Int, acc: Int): Int =
  if (List.isEmpty(ps)) acc else packKindAt(List.tail(ps), place * 4, acc + kindOf(List.at(ps, 0)) * place)

def kindOf(p: Param): Int =
  if (p.ty == "Bool") 2 else if (p.ty == "Int") 0 else 1

def emitProg(p: Prog, strs: List[String], files: List[(String, String)]): String =
  emitBits(p.body, prepDefs(p), strs, Parse.builtins(p.enums), files)

def prepDefs(p: Prog): List[Fun] =
  withSelfFuns(rwAliasFuns(implFuns(p.impls, withImportFuns(p.imps, p.defs)), p.aliases))

def withSelfFuns(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) ds else withSelfFun(List.at(ds, 0)) :: withSelfFuns(List.tail(ds))

def withSelfFun(d: Fun): Fun =
  d match {
    case Fun(priv, name, ts, ps, ret, body, mod, off) => if (paramKnown(ps, "self") || !exprHasVar(body, "self")) d else Fun(priv, name, ts, Param("self", if (mod == "") "Any" else mod, "", "") :: ps, ret, body, mod, off)
  }

def implFuns(impls: List[Im], defs: List[Fun]): List[Fun] =
  if (List.isEmpty(impls)) defs else implFuns(List.tail(impls), implMeths(List.at(impls, 0), defs))

def implMeths(im: Im, defs: List[Fun]): List[Fun] =
  im match {
    case Im(_, _, forTy, methods) => stampMod(methods, forTy, defs)
  }

def stampMod(ms: List[Fun], mod: String, defs: List[Fun]): List[Fun] =
  if (List.isEmpty(ms)) defs else stampFun(List.at(ms, 0), mod) :: stampMod(List.tail(ms), mod, defs)

def stampFun(d: Fun, mod: String): Fun =
  d match {
    case Fun(priv, name, ts, ps, ret, body, _, off) => Fun(priv, name, ts, Param("self", mod, "", "") :: ps, ret, body, mod, off)
  }

def rwAliasFuns(ds: List[Fun], als: List[Alias]): List[Fun] =
  if (List.isEmpty(ds)) ds else rwAliasFun(List.at(ds, 0), als) :: rwAliasFuns(List.tail(ds), als)

def rwAliasFun(d: Fun, als: List[Alias]): Fun =
  d match {
    case Fun(priv, name, ts, ps, ret, body, mod, off) => Fun(priv, name, ts, rwAliasParams(ps, als), rwAliasTy(ret, als), body, mod, off)
  }

def rwAliasParams(ps: List[Param], als: List[Alias]): List[Param] =
  if (List.isEmpty(ps)) ps else rwAliasParam(List.at(ps, 0), als) :: rwAliasParams(List.tail(ps), als)

def rwAliasParam(p: Param, als: List[Alias]): Param =
  p match {
    case Param(n, ty, w, d) => Param(n, rwAliasTy(ty, als), w, d)
  }

def rwAliasTy(t: String, als: List[Alias]): String =
  if (List.isEmpty(als)) t else rwAliasApply(List.at(als, 0), t, List.tail(als))

def rwAliasApply(a: Alias, t: String, rest: List[Alias]): String =
  a match {
    case Alias(n, tps, target) => if (t == n) rwAliasTy(target, rest) else if (List.len(tps) > 0 && Str.startsWith(t, Str.concat(n, "["))) rwAliasTy(rwAliasPrefix(target, n, t), rest) else rwAliasTy(t, rest)
  }

def rwAliasPrefix(target: String, n: String, t: String): String =
  Str.concat(tyHead(target), Str.slice(t, Str.len(n), Str.len(t)))

def emitBits(body: Expr, defs: List[Fun], strs: List[String], ens: List[En], files: List[(String, String)]): String =
  emitBitsHeld(body :: noExpr(), defs, strs, ens, files)

def emitBitsHeld(held: List[Expr], defs: List[Fun], strs: List[String], ens: List[En], files: List[(String, String)]): String =
  emitBitsFromConts(emitConts(List.at(held, 0), strs, defs, ens, noParam(), panicLocExpr(files, List.at(held, 0))), held, defs, strs, ens, files)

def emitBitsFromConts(conts: String, held: List[Expr], defs: List[Fun], strs: List[String], ens: List[En], files: List[(String, String)]): String =
  emitBitsJoin(emitMainIf(List.at(held, 0), strs, defs, ens, files), conts, defs, strs, ens, files)

def emitBitsJoin(main: String, conts: String, defs: List[Fun], strs: List[String], ens: List[En], files: List[(String, String)]): String =
  Str.concat(emitConsts(strs, 0), Str.concat(if (List.isEmpty(strs)) "" else nl(), hoistNeth(Str.concat(conts, Str.concat(emitDefs(defs, strs, defs, ens, files), main)))))

def emitMainIf(body: Expr, strs: List[String], defs: List[Fun], ens: List[En], files: List[(String, String)]): String =
  if (isEmptyMain(body)) "" else emitMain(body, strs, defs, ens, files)

def isEmptyMain(e: Expr): Bool =
  e match {
    case Expr.EUnit => true
    case Expr.EVar(s, _) => s == ""
    case _ => false
  }

def fmCount(e: Expr): Int =
  e match {
    case Expr.EMethod(recv, name, args, _) => fmCountMeth(recv, name, args)
    case Expr.EPrint(inner, _) => fmCount(inner)
    case Expr.ELam(_, _, body) => fmCount(body)
    case Expr.ECall(_, args, _) => fmCountSkipLam(args)
    case Expr.EBin(_, l, r, _) => fmCount(l) + fmCount(r)
    case Expr.EUn(_, inner, _) => fmCount(inner)
    case Expr.EIf(c, t, el, _) => fmCount(c) + fmCount(t) + fmCount(el)
    case Expr.ENamed(_, inner) => fmCount(inner)
    case Expr.EAscribe(inner, _, _) => fmCount(inner)
    case Expr.EMatch(s, arms, _) => fmCount(s) + fmCountArms(arms)
    case Expr.EList(xs) => fmCountArgs(xs)
    case Expr.ETuple(xs) => fmCountArgs(xs)
    case Expr.EFor(bs, body, _) => fmCount(desugarFor(bs, body))
    case _ => 0
  }

def fmCountMeth(recv: Expr, name: String, args: List[Expr]): Int =
  if (isFmName(name)) fmCountFm(recv, args) else if (name == "map") fmCountMap(recv, args) else fmCount(recv) + fmCountSkipLam(args)

def fmCountMap(recv: Expr, args: List[Expr]): Int =
  recv match {
    case Expr.EVar(_, _) => fmCount(recv) + fmCountSkipLam(args)
    case _ => fmCountFm(recv, args)
  }

def fmCountSkipLam(xs: List[Expr]): Int =
  if (List.isEmpty(xs)) 0 else fmCountSkipLam1(List.at(xs, 0)) + fmCountSkipLam(List.tail(xs))

def fmCountSkipLam1(e: Expr): Int =
  e match {
    case Expr.ELam(_, _, _) => 0
    case _ => fmCount(e)
  }

def isFmName(name: String): Bool =
  name match {
    case "flatMap" => true
    case "handleErrorWith" => true
    case _ => false
  }

def fmRt(name: String): String =
  name match {
    case "handleErrorWith" => "sz_io_handle_error_with"
    case _ => "sz_io_flatmap"
  }

def fmCountFm(recv: Expr, args: List[Expr]): Int =
  1 + fmCount(recv) + fmCountArgs(args)

def fmCountArms(arms: List[Arm]): Int =
  if (List.isEmpty(arms)) 0 else fmCountArm(List.at(arms, 0), List.tail(arms))

def fmCountArm(a: Arm, rest: List[Arm]): Int =
  a match {
    case Arm(_, _, body) => fmCount(body) + fmCountArms(rest)
  }

def fmCountArgs(xs: List[Expr]): Int =
  if (List.isEmpty(xs)) 0 else fmCountArgsHit(xs)

def fmCountArgsHit(xs: List[Expr]): Int =
  xs match {
    case h :: rest => fmCount(h) + fmCountArgs(rest)
    case [] => 0
  }

def emitIoMap(recv: Expr, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  recv match {
    case Expr.EVar(_, _) => emitCtorCall(recv, "map", args, prefix, strs, defs, ens, ps, loc)
    case _ => emitFmRt("sz_io_flatmap", recv, wrapIoMapArgs(args, ps, defs, modOfLoc(loc)), prefix, strs, defs, ens, ps, loc, fid)
  }

def wrapIoMapArgs(args: List[Expr], ps: List[Param], defs: List[Fun], mod: String): List[Expr] =
  if (List.isEmpty(args)) args else wrapIoMapLam(List.at(args, 0), ps, defs, mod) :: List.tail(args)

def wrapIoMapLam(e: Expr, ps: List[Param], defs: List[Fun], mod: String): Expr =
  wrapIoMapLam1(wrapPh(e, ps, defs, mod))

def wrapIoMapLam1(e: Expr): Expr =
  e match {
    case Expr.ELam(p, ty, body) => Expr.ELam(p, ty, Expr.ECall("IO.pure", body :: noExpr(), 0))
    case Expr.EMatch(s, arms, _) => Expr.ELam("__p", "", Expr.ECall("IO.pure", Expr.EMatch(s, arms, 0) :: noExpr(), 0))
    case _ => Expr.ELam("_ph", "", Expr.ECall("IO.pure", e :: noExpr(), 0))
  }

def wrapIoMapCont(args: List[Expr]): List[Expr] =
  if (List.isEmpty(args)) args else wrapIoMapLam1(List.at(args, 0)) :: List.tail(args)

def emitFmRt(rt: String, recv: Expr, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitFmCounted(rt, recv, args, prefix, strs, defs, ens, ps, loc, fid, fmCount(recv) + fmCountArgs(args))

def emitFmCounted(rt: String, recv: Expr, _args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int, n: Int): Slot =
  emitFmA(rt, fid + n, recv, prefix, strs, defs, ens, ps, loc, fid)

def emitFmA(rt: String, na: Int, recv: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitFm2(rt, emitExprFid(recv, Str.concat(prefix, "_in"), strs, defs, ens, ps, loc, fid), prefix, na, ps)

def emitFm2(rt: String, inner: Slot, prefix: String, id: Int, ps: List[Param]): Slot =
  emitFm3(rt, inner, emitPackEnv(ps, prefix), prefix, id)

def emitFm3(rt: String, inner: Slot, env: Slot, prefix: String, id: Int): Slot =
  inner match {
    case Slot(ic, iv, _) => emitFm4(rt, ic, iv, env, prefix, id)
  }

def emitFm4(rt: String, ic: String, iv: String, env: Slot, prefix: String, id: Int): Slot =
  env match {
    case Slot(ec, ev, eo) => emitFm5(rt, join(ic, ec), iv, ev, eo, prefix, id)
  }

def emitFm5(rt: String, code: String, iv: String, ev: String, eo: Bool, prefix: String, id: Int): Slot =
  Slot(join(code, join(emitFmCall(rt, prefix, iv, id, ev), join(relPtr(iv), emitFmRel(ev, eo)))), pct(prefix, "fm"), false)

def emitFmCall(rt: String, prefix: String, iv: String, id: Int, ev: String): String =
  line(Str.concat(tmp(prefix, "fm"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(iv, Str.concat(", ptr @sz_cont_", Str.concat(Str.fromInt(id), Str.concat(", ptr ", Str.concat(ev, ")"))))))))))

def emitFmRel(ev: String, eo: Bool): String =
  if (eo) relPtr(ev) else line("call void @sz_release(ptr null)")

def emitPackEnv(ps: List[Param], prefix: String): Slot =
  if (List.isEmpty(ps)) Slot("", "null", false) else emitPackEnv2(List.reverse(ps), prefix, 0, Slot(line(Str.concat(tmp(prefix, "cap0"), "call ptr @sz_list_nil()")), pct(prefix, "cap0"), true))

def emitPackEnv2(ps: List[Param], prefix: String, i: Int, acc: Slot): Slot =
  if (List.isEmpty(ps)) acc else emitPackEnv3(List.at(ps, 0), List.tail(ps), prefix, i, acc)

def emitPackEnv3(p: Param, rest: List[Param], prefix: String, i: Int, acc: Slot): Slot =
  emitPackEnv2(rest, prefix, i + 1, emitPackCons(p, acc, prefix, i))

def emitPackCons(p: Param, acc: Slot, prefix: String, i: Int): Slot =
  acc match {
    case Slot(code, val, _) => emitPackConsP(p, code, val, prefix, i)
  }

def emitPackConsP(p: Param, code: String, cur: String, prefix: String, i: Int): Slot =
  p match {
    case Param(n, ty, _, _) => emitPackCons2(n, isI64Ty(ty), code, cur, prefix, i)
  }

def emitPackCons2(n: String, box: Bool, code: String, cur: String, prefix: String, i: Int): Slot =
  if (box) emitPackBox(n, code, cur, prefix, i) else emitPackPtr(n, code, cur, prefix, i)

def emitPackPtr(n: String, code: String, cur: String, prefix: String, i: Int): Slot =
  Slot(join(code, join(emitPackConsCall(prefix, i, Str.concat("%", n), cur), relPtr(cur))), pct(prefix, Str.concat("cap", Str.fromInt(i + 1))), true)

def emitPackConsCall(prefix: String, i: Int, hd: String, cur: String): String =
  line(Str.concat(tmp(prefix, Str.concat("cap", Str.fromInt(i + 1))), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(hd, Str.concat(", ptr ", Str.concat(cur, ")"))))))

def emitPackBox(n: String, code: String, cur: String, prefix: String, i: Int): Slot =
  emitPackBox2(n, code, cur, prefix, i, Str.concat("bx", Str.fromInt(i)))

def emitPackBox2(n: String, code: String, cur: String, prefix: String, i: Int, bx: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, bx), Str.concat("call ptr @sz_box_i64(i64 %", Str.concat(n, ")")))), join(emitPackConsCall(prefix, i, pct(prefix, bx), cur), join(relPtr(cur), relPtr(pct(prefix, bx)))))), pct(prefix, Str.concat("cap", Str.fromInt(i + 1))), true)

def emitUnpack(ps: List[Param]): String =
  emitUnpackAt(ps, 0)

def emitUnpackAt(ps: List[Param], i: Int): String =
  if (List.isEmpty(ps)) "" else emitUnpackOne(List.at(ps, 0), List.tail(ps), i)

def emitUnpackOne(p: Param, rest: List[Param], i: Int): String =
  p match {
    case Param(n, ty, _, _) => join(if (isI64Ty(ty)) emitUnpackI64(n, i) else emitUnpackPtr(n, i), emitUnpackAt(rest, i + 1))
  }

def emitUnpackPtr(n: String, i: Int): String =
  line(Str.concat("%", Str.concat(n, Str.concat(" = call ptr @sz_list_at(ptr %env, i64 ", Str.concat(Str.fromInt(i), ")")))))

def emitUnpackI64(n: String, i: Int): String =
  join(line(Str.concat("%", Str.concat(n, Str.concat("_c = call ptr @sz_list_at(ptr %env, i64 ", Str.concat(Str.fromInt(i), ")"))))), line(Str.concat("%", Str.concat(n, Str.concat(" = call i64 @sz_unbox_i64(ptr %", Str.concat(n, "_c)"))))))

def emitOneCont(id: Int, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, bind: String, nested: Bool, start: Int, bty: String): String =
  emitOneContHeld(id, body :: noExpr(), strs, defs, ens, ps, loc, bind, nested, start, bty)

def emitOneContHeld(id: Int, held: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, bind: String, nested: Bool, start: Int, bty: String): String =
  emitOneContTy(id, List.at(held, 0), strs, defs, ens, ps, loc, bind, nested, start, contBindTy(bind, List.at(held, 0), bty))

def contBindTy(bind: String, body: Expr, bty: String): String =
  if (isI64Ty(peelIo(bty)) || isTupTy(bty)) peelIo(bty) else if (nameUnBool(body, bind)) "Int" else peelIo(bty)

def peelIo(ty: String): String =
  if (isIoRet(ty)) ioElem(ty) else ty

def nameUnBool(e: Expr, n: String): Bool =
  e match {
    case Expr.EUn(_, inner, _) => nameIsVar(inner, n) || nameUnBool(inner, n)
    case Expr.EIf(c, t, el, _) => nameUnBool(c, n) || nameUnBool(t, n) || nameUnBool(el, n)
    case Expr.ECall(_, args, _) => nameUnBoolList(args, n)
    case Expr.EMethod(r, _, args, _) => nameUnBool(r, n) || nameUnBoolList(args, n)
    case Expr.ELam(p, _, body) => if (p == n) false else nameUnBool(body, n)
    case _ => false
  }

def nameUnBoolList(xs: List[Expr], n: String): Bool =
  if (List.isEmpty(xs)) false else nameUnBool(List.at(xs, 0), n) || nameUnBoolList(List.tail(xs), n)

def emitOneContTy(id: Int, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, bind: String, nested: Bool, start: Int, bty: String): String =
  if (keepBind(bind) && nested || isI64Ty(bty) || isTuplePat(bind) || isTupTy(bty)) emitOneContAlias(id, body, strs, defs, ens, ps, loc, bind, start, bty) else emitOneCont2(id, emitOneCont3(emitUnpack(ps), emitExprFid(rewriteBind(body, bind, "value"), Str.concat("c", Str.fromInt(id)), strs, defs, ens, ps, loc, start)), loc, strs)

def keepBind(bind: String): Bool =
  bind != "" && bind != "_"

def bindPsTy(bind: String, ps: List[Param], ty: String): List[Param] =
  if (isTuplePat(bind)) bindTupPsTy(tupBindNs(bind), tupSlots(ty), ps) else if (keepBind(bind)) Param(bind, ty, "", "") :: dropParam(ps, bind) else ps

def bindTupPsTy(ns: List[String], tys: List[String], ps: List[Param]): List[Param] =
  if (List.isEmpty(ns)) ps else bindTupPsTy1(List.at(ns, 0), List.tail(ns), tys, ps)

def bindTupPsTy1(n: String, rest: List[String], tys: List[String], ps: List[Param]): List[Param] =
  if (keepBind(n)) Param(n, headOrAny(tys), "", "") :: dropParam(bindTupPsTy(rest, tailOrEmpty(tys), ps), n) else bindTupPsTy(rest, tailOrEmpty(tys), ps)

def headOrAny(tys: List[String]): String =
  if (List.isEmpty(tys)) "Any" else List.at(tys, 0)

def tailOrEmpty(tys: List[String]): List[String] =
  if (List.isEmpty(tys)) tys else List.tail(tys)

def secondOrAny(tys: List[String]): String =
  if (List.isEmpty(tys) || List.isEmpty(List.tail(tys))) "Any" else List.at(List.tail(tys), 0)

def tupBindNs(n: String): List[String] =
  splitPat(Str.slice(n, 1, Str.len(n) - 1))

def dropParam(ps: List[Param], n: String): List[Param] =
  if (List.isEmpty(ps)) ps else dropParam1(List.at(ps, 0), List.tail(ps), n)

def dropParam1(p: Param, rest: List[Param], n: String): List[Param] =
  p match {
    case Param(pn, _, _, _) => if (pn == n) dropParam(rest, n) else p :: dropParam(rest, n)
  }

def emitBindAlias(n: String, ty: String): String =
  if (isTuplePat(n)) emitTupAlias(n, ty) else if (isI64Ty(ty)) emitBindAliasI64(n) else emitBindAliasPtr(n)

def emitTupAlias(n: String, ty: String): String =
  emitTupAliasAt(tupBindNs(n), tupSlots(ty), "%value", 0)

def emitTupAliasAt(ns: List[String], tys: List[String], scrut: String, k: Int): String =
  if (List.len(ns) < 2) "" else if (List.len(ns) == 2) join(tupAliasSlot(List.at(ns, 0), scrut, true, headOrAny(tys)), tupAliasSlot(List.at(List.tail(ns), 0), scrut, false, secondOrAny(tys))) else join(tupAliasSlot(List.at(ns, 0), scrut, true, headOrAny(tys)), join(tupAliasRight(tupRestName(k), scrut), emitTupAliasAt(List.tail(ns), tailOrEmpty(tys), Str.concat("%", tupRestName(k)), k + 1)))

def tupRestName(k: Int): String =
  Str.concat("_tr", Str.fromInt(k))

def tupAliasSlot(n: String, scrut: String, left: Bool, ty: String): String =
  if (!keepBind(n) || isTuplePat(n)) "" else if (isI64Ty(ty)) tupAliasUnbox(n, scrut, left) else if (left) tupAliasLeft(n, scrut) else tupAliasRight(n, scrut)

def tupAliasUnbox(n: String, scrut: String, left: Bool): String =
  join(line(Str.concat("%", Str.concat(n, Str.concat("_p = call ptr @", Str.concat(if (left) "sz_pair_left" else "sz_pair_right", Str.concat("(ptr ", Str.concat(scrut, ")"))))))), line(Str.concat("%", Str.concat(n, Str.concat(" = call i64 @sz_unbox_i64(ptr %", Str.concat(n, "_p)"))))))

def tupAliasLeft(n: String, scrut: String): String =
  line(Str.concat("%", Str.concat(n, Str.concat(" = call ptr @sz_pair_left(ptr ", Str.concat(scrut, ")")))))

def tupAliasRight(n: String, scrut: String): String =
  line(Str.concat("%", Str.concat(n, Str.concat(" = call ptr @sz_pair_right(ptr ", Str.concat(scrut, ")")))))

def emitBindAliasPtr(n: String): String =
  line(Str.concat("%", Str.concat(n, " = bitcast ptr %value to ptr")))

def emitBindAliasI64(n: String): String =
  join(line(Str.concat("%", Str.concat(n, " = call i64 @sz_unbox_i64(ptr %value)"))), relPtr("%value"))

def emitOneContAlias(id: Int, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, bind: String, start: Int, bty: String): String =
  emitOneContAlias2(id, body, strs, defs, ens, dropParam(ps, bind), loc, bind, start, bty)

def emitOneContAlias2(id: Int, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], rest: List[Param], loc: String, bind: String, start: Int, bty: String): String =
  emitOneCont2(id, emitOneCont3(join(emitUnpack(rest), emitBindAlias(bind, bty)), emitExprFid(body, Str.concat("c", Str.fromInt(id)), strs, defs, ens, bindPsTy(bind, rest, bty), loc, start)), loc, strs)

def emitOneCont3(pre: String, s: Slot): Slot =
  s match {
    case Slot(code, val, o) => Slot(join(pre, code), val, o)
  }

def emitOneCont2(id: Int, s: Slot, loc: String, strs: List[String]): String =
  Str.concat("define internal ptr @sz_cont_", Str.concat(Str.fromInt(id), Str.concat("(ptr %value, ptr %env) {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), Str.concat(panicPush(loc, strs), Str.concat(s.code, Str.concat(panicPop(), Str.concat("  ret ptr ", Str.concat(s.val, Str.concat(nl(), Str.concat("}", Str.concat(nl(), nl()))))))))))))))

def emitConts(e: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): String =
  emitContsHead(emitContsAt(e, strs, defs, ens, ps, loc, 0))

def emitContsHead(p: (String, Int)): String =
  p match {
    case (code, _) => Str.concat(code, "")
  }

def emitContsAt(e: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  e match {
    case Expr.EMethod(recv, name, args, _) => if (isFmName(name)) emitContsFm(recv, args, strs, defs, ens, ps, loc, id) else if (name == "map") emitContsMap(recv, args, strs, defs, ens, ps, loc, id) else if (name == "apply") emitContsApply(recv, args, strs, defs, ens, ps, loc, id) else emitContsCtor(recv, args, strs, defs, ens, ps, loc, id)
    case Expr.EPrint(inner, _) => emitContsAtGo(inner, strs, defs, ens, ps, loc, id)
    case Expr.ELam(_, _, _) => ("", id)
    case Expr.ECall(_, args, _) => emitContsArgs(args, strs, defs, ens, ps, loc, id)
    case Expr.EIf(c, t, el, _) => emitContsIf(c, t, el, strs, defs, ens, ps, loc, id)
    case Expr.ENamed(_, inner) => emitContsAtGo(inner, strs, defs, ens, ps, loc, id)
    case Expr.EAscribe(inner, _, _) => emitContsAtGo(inner, strs, defs, ens, ps, loc, id)
    case Expr.EBin(_, l, r, _) => emitContsIf(l, r, Expr.EUnit, strs, defs, ens, ps, loc, id)
    case Expr.EUn(_, inner, _) => emitContsAtGo(inner, strs, defs, ens, ps, loc, id)
    case Expr.EField(recv, _, _) => emitContsAtGo(recv, strs, defs, ens, ps, loc, id)
    case Expr.EMatch(s, arms, _) => emitContsMatch(s, arms, strs, defs, ens, ps, loc, id)
    case Expr.EList(xs) => emitContsArgs(xs, strs, defs, ens, ps, loc, id)
    case Expr.ETuple(xs) => emitContsArgs(xs, strs, defs, ens, ps, loc, id)
    case Expr.EFor(bs, body, _) => emitContsAtGo(desugarFor(bs, body), strs, defs, ens, ps, loc, id)
    case _ => ("", id)
  }

def emitContsAtGo(e: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsAt(e, strs, defs, ens, ps, loc, id)

def emitContsApply(recv: Expr, args: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  recv match {
    case Expr.ELam(p, _, body) => emitContsApplyLam(p, body, args, strs, defs, ens, ps, loc, id)
    case _ => emitContsCtor(recv, args, strs, defs, ens, ps, loc, id)
  }

def emitContsApplyLam(p: String, body: Expr, args: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsCtor2(emitContsAt(body, strs, defs, ens, bindPsTy(p, ps, applyBindTy(p, applyScrut(args), defs, ps)), loc, id), args, strs, defs, ens, ps, loc)

def emitContsCtor(recv: Expr, args: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsCtor2(emitContsAt(recv, strs, defs, ens, ps, loc, id), args, strs, defs, ens, ps, loc)

def emitContsCtor2(p: (String, Int), args: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArgs(args, strs, defs, ens, ps, loc, id))
  }

def emitContsMatch(s: Expr, arms: List[Arm], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsMatch2(emitContsAt(s, strs, defs, ens, ps, loc, id), arms, strs, defs, ens, ps, loc)

def emitContsMatch2(p: (String, Int), arms: List[Arm], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArmList(arms, strs, defs, ens, ps, loc, id))
  }

def emitContsArmList(arms: List[Arm], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  if (List.isEmpty(arms)) ("", id) else emitContsArmHd(List.at(arms, 0), List.tail(arms), strs, defs, ens, ps, loc, id)

def emitContsArmHd(a: Arm, rest: List[Arm], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  a match {
    case Arm(pat, _, body) => emitContsArmList2(emitContsAt(body, strs, defs, ens, bindPatPs(pat, ps), loc, id), rest, strs, defs, ens, ps, loc)
  }

def bindPatPs(pat: String, ps: List[Param]): List[Param] =
  if (isTuplePat(pat)) bindTupPsTy(tupBindNs(pat), noStr(), ps) else ps

def emitContsArmList2(p: (String, Int), rest: List[Arm], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArmList(rest, strs, defs, ens, ps, loc, id))
  }

def emitContsMap(recv: Expr, args: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  recv match {
    case Expr.EVar(_, _) => emitContsCtor(recv, args, strs, defs, ens, ps, loc, id)
    case _ => emitContsFm(recv, wrapIoMapCont(args), strs, defs, ens, ps, loc, id)
  }

def emitContsFm(recv: Expr, args: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsFmTy(recvBindTy(recv, ens, defs, ps), recv, args, strs, defs, ens, ps, loc, id)

def recvBindTy(recv: Expr, ens: List[En], defs: List[Fun], ps: List[Param]): String =
  recv match {
    case Expr.ECall(f, args, _) => recvBindTyCall(f, args, ens, defs, ps)
    case Expr.EMethod(r, name, args, _) => recvBindTyMeth(r, name, args, ens, defs, ps)
    case _ => "Any"
  }

def recvBindTyCall(f: String, args: List[Expr], ens: List[En], defs: List[Fun], ps: List[Param]): String =
  if (f == "IO.pure") recvBindTyPure(args, ens, defs, ps) else if (f == "Sys.exec") "(Int, String, String)" else if (f == "Fs.read" || f == "Sys.read" || f == "Sys.readLine" || f == "Sys.getenv") "String" else recvBindTyIo(funRetStr(defs, f), clockInt(f))

def recvBindTyIo(ret: String, fallback: String): String =
  if (isIoRet(ret)) ioElem(ret) else if (ret != "") ret else fallback

def isIoRet(ret: String): Bool =
  Str.startsWith(ret, "IO[") && Str.len(ret) > 4

def ioElem(ret: String): String =
  Str.slice(ret, 3, Str.len(ret) - 1)

def recvBindTyPure(args: List[Expr], ens: List[En], defs: List[Fun], ps: List[Param]): String =
  if (List.isEmpty(args)) "Any" else recvBindTyPure1(List.at(args, 0), ens, defs, ps)

def recvBindTyPure1(e: Expr, ens: List[En], defs: List[Fun], ps: List[Param]): String =
  e match {
    case Expr.ENamed(_, inner) => recvBindTyPure1(inner, ens, defs, ps)
    case Expr.EAscribe(inner, _, _) => recvBindTyPure1(inner, ens, defs, ps)
    case Expr.ELam(_, _, _) => "Any"
    case Expr.ECall(f, _, _) => recvBindTyNamed(recvCallTy(f, ens, defs), e, ps, defs)
    case Expr.EMethod(r, name, _, _) => recvBindTyPureMeth(r, name, e, ens, defs, ps)
    case Expr.EVar(s, _) => if (paramIsI64(ps, s)) "Int" else recvBindTyNamed(ctorHead(s, ens), e, ps, defs)
    case Expr.ETuple(xs) => tupExprTy(xs, defs, ps)
    case _ => if (needsPh(e)) "Any" else exprRetTy(e, defs, ps)
  }

def recvBindTyNamed(h: String, e: Expr, ps: List[Param], defs: List[Fun]): String =
  if (h != "") h else if (exprIsI64(e, ps, defs)) "Int" else "Any"

def recvCallTy(f: String, ens: List[En], defs: List[Fun]): String =
  recvCallTy2(funRetStr(defs, f), f, ens, defs)

def recvCallTy2(ret: String, f: String, ens: List[En], defs: List[Fun]): String =
  if (isTupTy(ret) || isI64Ty(ret)) ret else copyEnCall(f, ens, defs)

def recvBindTyPureMeth(r: Expr, name: String, e: Expr, ens: List[En], defs: List[Fun], ps: List[Param]): String =
  r match {
    case Expr.EVar(mod, _) => recvBindTyNamed(recvCallTy(Str.concat(mod, Str.concat(".", name)), ens, defs), e, ps, defs)
    case _ => recvBindTyNamed(copyEn(Expr.EMethod(r, name, noExpr(), 0), ens, defs), e, ps, defs)
  }

def recvBindTyMeth(r: Expr, name: String, args: List[Expr], ens: List[En], defs: List[Fun], ps: List[Param]): String =
  if (name == "map") exprRetTy(mapLamBody(lamArg(args)), defs, ps) else if (isFmName(name)) recvBindTy(r, ens, defs, ps) else clockInt(qualRecv(r, name))

def qualRecv(r: Expr, name: String): String =
  r match {
    case Expr.EVar(en, _) => Str.concat(en, Str.concat(".", name))
    case _ => name
  }

def clockInt(f: String): String =
  if (f == "Clock.realTime" || f == "Clock.monotonic" || f == "Sys.spawn" || f == "Sys.alive" || f == "Ui.editorCaret" || f == "Fs.exists" || f == "Random.nextInt") "Int" else "Any"

def emitContsFmTy(bty: String, recv: Expr, args: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsFm2(emitContsAt(recv, strs, defs, ens, ps, loc, id), lamArg(args), strs, defs, ens, ps, loc, bty)

def lamArg(args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EUnit else List.at(args, 0)

def emitContsFm2(p: (String, Int), lam: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, bty: String): (String, Int) =
  p match {
    case (code, id) => emitContsFm3(code, id, lam, strs, defs, ens, ps, loc, bty)
  }

def emitContsFm3(code: String, id: Int, lam: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, bty: String): (String, Int) =
  lam match {
    case Expr.ELam(p, _, body) => emitContsFm3Body(code, id, p, body, strs, defs, ens, ps, loc, bty)
    case _ => (code, id)
  }

def emitContsFm3Body(code: String, id: Int, p: String, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, bty: String): (String, Int) =
  emitContsFm3Held(code, id, p, body :: noExpr(), strs, defs, ens, ps, loc, bty)

def emitContsFm3Held(code: String, id: Int, p: String, held: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, bty: String): (String, Int) =
  emitContsFm3After(code, id, p, held, strs, defs, ens, ps, loc, bty, emitContsAt(List.at(held, 0), strs, defs, ens, bindPsTy(p, ps, bty), loc, id))

def emitContsFm3After(code: String, id: Int, p: String, held: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, bty: String, nested: (String, Int)): (String, Int) =
  nested match {
    case (ncode, id2) => (join(code, join(ncode, emitOneCont(id2, List.at(held, 0), strs, defs, ens, ps, loc, p, id2 > id, id, bty))), id2 + 1)
  }

def emitContsArgs(xs: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  if (List.isEmpty(xs)) ("", id) else emitContsArgs2(emitContsAt(List.at(xs, 0), strs, defs, ens, ps, loc, id), List.tail(xs), strs, defs, ens, ps, loc)

def emitContsArgs2(p: (String, Int), rest: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArgs(rest, strs, defs, ens, ps, loc, id))
  }

def emitContsArgs3(code: String, p: (String, Int)): (String, Int) =
  p match {
    case (rest, id) => (join(code, rest), id)
  }

def emitContsIf(c: Expr, t: Expr, el: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsIf2(emitContsAt(c, strs, defs, ens, ps, loc, id), t, el, strs, defs, ens, ps, loc)

def emitContsIf2(p: (String, Int), t: Expr, el: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): (String, Int) =
  p match {
    case (code, id) => emitContsIf3(code, emitContsAt(t, strs, defs, ens, ps, loc, id), el, strs, defs, ens, ps, loc)
  }

def emitContsIf3(code: String, p: (String, Int), el: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): (String, Int) =
  p match {
    case (rest, id) => emitContsArgs3(join(code, rest), emitContsAt(el, strs, defs, ens, ps, loc, id))
  }

def hoistNeth(ir: String): String =
  hoistNethPairs(ir, findNeths(ir, 0, [], []))

def findNeths(s: String, i: Int, stack: List[Int], acc: List[(Int, Int)]): List[(Int, Int)] =
  if (i >= Str.len(s)) List.reverse(acc) else if (nethBegAt(s, i)) findNeths(s, i + 6, i :: stack, acc) else if (nethEndAt(s, i) && !List.isEmpty(stack)) findNeths(s, i + 6, List.tail(stack), (List.at(stack, 0), i) :: acc) else findNeths(s, i + 1, stack, acc)

def hoistNethPairs(s: String, pairs: List[(Int, Int)]): String =
  Builder.result(hoistNethRest(s, pairs, hoistNethBodies(s, pairs, pairs, Builder.empty())))

def hoistNethBodies(s: String, pairs: List[(Int, Int)], all: List[(Int, Int)], b: Builder): Builder =
  if (List.isEmpty(pairs)) b else hoistNethBodiesHd(s, List.at(pairs, 0), List.tail(pairs), all, b)

def hoistNethBodiesHd(s: String, p: (Int, Int), rest: List[(Int, Int)], all: List[(Int, Int)], b: Builder): Builder =
  p match {
    case (beg, e) => hoistNethBodies(s, rest, all, copySkip(s, beg + 6, e, childSkips(all, beg, e), b))
  }

def childSkips(all: List[(Int, Int)], b: Int, e: Int): List[(Int, Int)] =
  childSkipsGo(all, b, e, [])

def childSkipsGo(all: List[(Int, Int)], b: Int, e: Int, acc: List[(Int, Int)]): List[(Int, Int)] =
  if (List.isEmpty(all)) acc else childSkipsHd(List.at(all, 0), List.tail(all), b, e, acc)

def childSkipsHd(p: (Int, Int), rest: List[(Int, Int)], b: Int, e: Int, acc: List[(Int, Int)]): List[(Int, Int)] =
  p match {
    case (cb, ce) => if (cb > b && ce < e) childSkipsGo(rest, b, e, insSkip(acc, (cb, ce + 6))) else childSkipsGo(rest, b, e, acc)
  }

def insSkip(xs: List[(Int, Int)], p: (Int, Int)): List[(Int, Int)] =
  if (List.isEmpty(xs)) p :: [] else insSkipHd(List.at(xs, 0), List.tail(xs), p)

def insSkipHd(h: (Int, Int), rest: List[(Int, Int)], p: (Int, Int)): List[(Int, Int)] =
  h match {
    case (hu, _) => insSkipP(hu, h, rest, p)
  }

def insSkipP(hu: Int, h: (Int, Int), rest: List[(Int, Int)], p: (Int, Int)): List[(Int, Int)] =
  p match {
    case (pu, _) => if (pu < hu) p :: h :: rest else h :: insSkip(rest, p)
  }

def copySkip(s: String, from: Int, to: Int, skips: List[(Int, Int)], b: Builder): Builder =
  if (from >= to) b else if (List.isEmpty(skips)) Builder.append(b, Str.slice(s, from, to)) else copySkipHd(s, from, to, List.at(skips, 0), List.tail(skips), b)

def copySkipHd(s: String, from: Int, to: Int, p: (Int, Int), rest: List[(Int, Int)], b: Builder): Builder =
  p match {
    case (u, v) => copySkipPick(s, from, to, u, v, rest, b)
  }

def copySkipPick(s: String, from: Int, to: Int, u: Int, v: Int, rest: List[(Int, Int)], b: Builder): Builder =
  if (v <= from) copySkip(s, from, to, rest, b) else if (u >= to) Builder.append(b, Str.slice(s, from, to)) else if (u <= from) copySkip(s, v, to, rest, b) else copySkip(s, v, to, rest, Builder.append(b, Str.slice(s, from, u)))

def hoistNethRest(s: String, pairs: List[(Int, Int)], b: Builder): Builder =
  copySkip(s, 0, Str.len(s), allSkips(pairs, []), b)

def allSkips(pairs: List[(Int, Int)], acc: List[(Int, Int)]): List[(Int, Int)] =
  if (List.isEmpty(pairs)) acc else allSkipsHd(List.at(pairs, 0), List.tail(pairs), acc)

def allSkipsHd(p: (Int, Int), rest: List[(Int, Int)], acc: List[(Int, Int)]): List[(Int, Int)] =
  p match {
    case (b, e) => allSkips(rest, insSkip(acc, (b, e + 6)))
  }

def nethBegAt(s: String, i: Int): Bool =
  i + 6 <= Str.len(s) && Str.charAt(s, i) == 78 && Str.charAt(s, i + 1) == 69 && Str.charAt(s, i + 2) == 84 && Str.charAt(s, i + 3) == 72 && Str.charAt(s, i + 4) == 66 && Str.charAt(s, i + 5) == 10

def nethEndAt(s: String, i: Int): Bool =
  i + 6 <= Str.len(s) && Str.charAt(s, i) == 78 && Str.charAt(s, i + 1) == 69 && Str.charAt(s, i + 2) == 84 && Str.charAt(s, i + 3) == 72 && Str.charAt(s, i + 4) == 69 && Str.charAt(s, i + 5) == 10

def emit(src: String): String =
  emitOne(Parse.parseFiles(("Main", src) :: []), collectToks(Lexer.lex(src), noStr()), ("Main", src) :: [])

def emitOne(p: Prog, strs: List[String], files: List[(String, String)]): String =
  emitProg(p, internSigProg(p, files, strs), files)

def internFiles(files: List[(String, String)], acc: List[String]): List[String] =
  if (List.isEmpty(files)) intern(acc, "guard") else internFiles2(List.at(files, 0), List.tail(files), acc)

def internFiles2(f: (String, String), rest: List[(String, String)], acc: List[String]): List[String] =
  f match {
    case (_, src) => internFiles(rest, collectToks(Lexer.lex(src), acc))
  }

def emitFiles(files: List[(String, String)]): String =
  emitFilesGot(Parse.parseFiles(files), internFiles(files, noStr()), files)

def emitFilesGot(p: Prog, strs: List[String], files: List[(String, String)]): String =
  emitProg(p, internSigProg(p, files, internRel(p, strs)), files)

def emitFullFiles(files: List[(String, String)]): String =
  Str.concat(preamble(), emitFiles(files))

def decl(s: String): String =
  Str.concat("declare ", Str.concat(s, nl()))

def preamble(): String =
  Str.concat("; Scuzz Lang generated LLVM IR", Str.concat(nl(), Str.concat(nl(), decls())))

def decls(): String =
  join(declsA(), join(declsB(), join(declsC(), join(declsD(), join(declsE(), join(declsF(), join(declsG(), join(declsH(), join(declsI(), join(declsJ(), join(declsK(), join(declsL(), join(declsM(), join(declsN(), join(declsO(), join(declsP(), join(declsQ(), join(declsR(), join(declsS(), join(declsT(), join(declsU(), join(declsV(), join(declsW(), join(declsX(), nl()))))))))))))))))))))))))

def declsR(): String =
