  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(arg0(vals), ")")))))), if (headOwn(owns)) relPtr(arg0(vals)) else "")), pct(prefix, "v"), false)

def emitPropStr(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_property_signal_str(ptr ", Str.concat(arg0(vals), ")")))), if (headOwn(owns)) relPtr(arg0(vals)) else "")), pct(prefix, "v"), true)

def emitPropListAt(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_property_signal_list_at(ptr ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), ")")))))), if (headOwn(owns)) relPtr(arg0(vals)) else "")), pct(prefix, "v"), true)

def emitPropA11y(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
