  env match {
    case Slot(ec, ev, eo) => Slot(join(neth, join(code, join(ec, join(line(netFilesCall(rt, pv, cv, kv, prefix, ev)), join(if (po) relPtr(pv) else "", join(if (co) relPtr(cv) else "", join(if (ko) relPtr(kv) else "", emitFmRel(ev, eo)))))))), pct(prefix, "io"), true)
  }

