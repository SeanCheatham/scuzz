def emitPropKit(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "Property.check") emitPropCheck(code, vals, owns, prefix) else if (f == "Property.assert") emitPropAssert(code, vals, owns, prefix) else if (f == "Property.classify") emitPropClass(code, vals, owns, prefix) else if (f == "Property.a11yHas") emitPropA11y(code, vals, owns, prefix) else if (f == "Property.signalInt") emitPropI64("sz_property_signal_int", code, vals, owns, prefix) else if (f == "Property.signalListLen") emitPropI64("sz_property_signal_list_len", code, vals, owns, prefix) else if (f == "Property.signalStr") emitPropStr(code, vals, owns, prefix) else if (f == "Property.signalListAt") emitPropListAt(code, vals, owns, prefix) else emitPropCheck(code, vals, owns, prefix)

def emitPropClass(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitPropClass2(code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitPropClass2(code: String, name: String, hit: String, drop: Bool, _prefix: String): Slot =
  Slot(join(code, join(line(Str.concat("call void @sz_property_classify(ptr ", Str.concat(name, Str.concat(", i64 ", Str.concat(hit, ")"))))), if (drop) relPtr(name) else "")), "1", false)

def emitPropForce(arg: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitPropForce2(emitExpr(arg, Str.concat(prefix, "_arg0"), strs, defs, ens, ps, loc), prefix, isI64Ty(Check.ioPayload(exprRetTyEns(arg, defs, ens, ps, loc))))

def emitPropForce2(s: Slot, prefix: String, scalar: Bool): Slot =
  s match {
    case Slot(code, iv, owned) => forceResult(join(code, join(line(Str.concat(tmp(prefix, "fr"), Str.concat("call ptr @sz_io_unsafe_run_or_die(ptr ", Str.concat(iv, ")")))), if (owned) relPtr(iv) else "")), prefix, scalar)
  }

def forceResult(code: String, prefix: String, scalar: Bool): Slot =
  if (scalar) Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(prefix, "fr"), ")")))), relPtr(pct(prefix, "fr")))), pct(prefix, "v"), false) else Slot(code, pct(prefix, "fr"), true)

def emitPropAssert(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitPropAssert2(code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitPropAssert2(code: String, name: String, ok: String, drop: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_property_assert(ptr ", Str.concat(name, Str.concat(", i64 ", Str.concat(ok, ")")))))), if (drop) relPtr(name) else "")), pct(prefix, "v"), true)

