record Slot(code: String, val: String, owned: Bool)

record Dec(code: String, val: String, num: Bool, owned: Bool, n: Int)

record Decs(code: String, ds: List[Dec], n: Int)

import Parse.Expr
import Parse.Fun
import Parse.Prog
import Parse.En
import Parse.EnCase
import Parse.Arm
import Parse.Param
import Parse.Bind
import Parse.Alias
import Parse.Im
import Parse.Imp
import Lexer.Tok
import Lexer.SpTok
import Check.getTy
import Check.withImportFuns
import Check.fileOf
import Check.locOf
import Check.srcOfStem
import Check.alignCall
import Check.isTupField
import Check.tupIdx

def noStr(): List[String] =
  []

def noExpr(): List[Expr] =
  []

def noBool(): List[Bool] =
  []

def noEnv(): List[(String, String)] =
  []

def noParam(): List[Param] =
  []

def noArm(): List[Arm] =
  []

def noFun(): List[Fun] =
  []

def noEn(): List[En] =
  []

def copyEns(ens: List[En]): List[En] =
  copyEnsAt(ens, 0)

def copyEnsAt(ens: List[En], i: Int): List[En] =
  if (i >= List.len(ens)) noEn() else List.at(ens, i) :: copyEnsAt(ens, i + 1)

def copyPs(ps: List[Param]): List[Param] =
  copyPsAt(ps, 0)

def copyPsAt(ps: List[Param], i: Int): List[Param] =
  if (i >= List.len(ps)) noParam() else copyPsHit(List.at(ps, i), ps, i)

def copyPsHit(h: Param, ps: List[Param], i: Int): List[Param] =
  h :: copyPsAt(ps, i + 1)

def nl(): String =
  """
"""

def line(s: String): String =
  Str.concat("  ", Str.concat(s, nl()))

def pct(prefix: String, stem: String): String =
  Str.concat("%", Str.concat(prefix, Str.concat("_", stem)))

def tmp(prefix: String, stem: String): String =
  Str.concat(pct(prefix, stem), " = ")

def llvmC(s: String): String =
  Str.concat("c\"", Str.concat(_escLl(s, 0, Builder.empty()), "\\00\""))

def _escLl(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else _escLl2(s, i, b, Str.charAt(s, i))

def _escLl2(s: String, i: Int, b: Builder, c: Int): String =
  _escLl(s, i + 1, Builder.append(b, escLlCp(s, i, c)))

def escLlCp(s: String, i: Int, c: Int): String =
  if (c == 34) "\\22" else if (c == 92) "\\\\" else if (c >= 32 && c <= 126) Str.slice(s, i, i + 1) else escUtf8(c)

def escUtf8(c: Int): String =
  if (c < 128) escByte(c) else if (c < 2048) Str.concat(escByte(192 + c / 64), escByte(128 + c % 64)) else if (c < 65536) Str.concat(escByte(224 + c / 4096), Str.concat(escByte(128 + c / 64 % 64), escByte(128 + c % 64))) else Str.concat(escByte(240 + c / 262144), Str.concat(escByte(128 + c / 4096 % 64), Str.concat(escByte(128 + c / 64 % 64), escByte(128 + c % 64))))

def escByte(n: Int): String =
  Str.concat("\\", hexU2(n))

def hexU2(n: Int): String =
  Str.concat(hexU(n / 16), hexU(n % 16))

def hexU(n: Int): String =
  Str.slice("0123456789ABCDEF", n, n + 1)

def strArr(s: String): Int =
  Str.byteLen(s) + 1

def strConst(i: Int, s: String): String =
  Str.concat("@.str", Str.concat(Str.fromInt(i), Str.concat(" = private unnamed_addr constant [", Str.concat(Str.fromInt(strArr(s)), Str.concat(" x i8] ", Str.concat(llvmC(s), ", align 1"))))))

def strIndex(xs: List[String], s: String, i: Int): Int =
  if (List.isEmpty(xs)) i else if (Str.eq(List.at(xs, 0), s)) i else strIndex(List.tail(xs), s, i + 1)

def intern(acc: List[String], s: String): List[String] =
  if (internHas(acc, s)) acc else List.concat(acc, s :: noStr())

def internHas(xs: List[String], s: String): Bool =
  if (List.isEmpty(xs)) false else if (Str.eq(List.at(xs, 0), s)) true else internHas(List.tail(xs), s)

def panicLoc(files: List[(String, String)], mod: String, off: Int): String =
  panicLoc2(fileOf(mod), locOf(srcOfStem(files, mod), off))

def panicLoc2(file: String, loc: (Int, Int, Int, Int)): String =
  loc match {
    case (line, col, _, _) => Str.concat(file, Str.concat(":", Str.concat(Str.fromInt(line), Str.concat(":", Str.fromInt(col)))))
  }

def panicLocExpr(files: List[(String, String)], e: Expr): String =
  panicLocExpr2(files, Parse.spanOf(e))

def panicLocExpr2(files: List[(String, String)], sp: (String, Int)): String =
  sp match {
    case (stem, off) => panicLoc(files, stem, off)
  }

def panicPush(loc: String, strs: List[String]): String =
  join(internGep(loc, strs, "szloc", 0), line("call void @sz_panic_push_src(ptr %szlocg0)"))

def panicPop(): String =
  line("call void @sz_panic_pop_src()")

def collectToks(toks: List[SpTok], acc: List[String]): List[String] =
  if (List.isEmpty(toks)) acc else collectToksHd(List.at(toks, 0), List.tail(toks), acc)

def collectToksHd(h: SpTok, rest: List[SpTok], acc: List[String]): List[String] =
  h match {
    case SpTok(t, _, _) => collectTok(t, rest, acc)
  }

def collectTok(t: Tok, rest: List[SpTok], acc: List[String]): List[String] =
  t match {
    case Tok.Str(s) => collectToks(rest, intern(acc, s))
    case Tok.Interp(s) => collectToks(rest, internInterp(acc, s, 0, ""))
    case _ => collectToks(rest, acc)
  }

def internInterp(acc: List[String], s: String, i: Int, lit: String): List[String] =
  if (i >= Str.len(s)) internInterpEnd(acc, lit) else internInterpCh(acc, s, i, lit, Str.charAt(s, i))

def internInterpEnd(acc: List[String], lit: String): List[String] =
  if (lit == "") acc else intern(acc, lit)

def internInterpCh(acc: List[String], s: String, i: Int, lit: String, c: Int): List[String] =
  if (c == 36) internInterpDollar(acc, s, i, lit) else internInterp(acc, s, i + 1, Str.concat(lit, Str.slice(s, i, i + 1)))

def internInterpDollar(acc: List[String], s: String, i: Int, lit: String): List[String] =
  if (i + 1 >= Str.len(s)) internInterp(acc, s, i + 1, Str.concat(lit, "$")) else internInterpDollar2(acc, s, i, lit, Str.charAt(s, i + 1))

def internInterpDollar2(acc: List[String], s: String, i: Int, lit: String, n: Int): List[String] =
  if (n == 123) internInterpBrace(internInterpEnd(acc, lit), s, i) else if (isIdentStart(n)) internInterpSkip(internInterpEnd(acc, lit), s, i + 1) else internInterp(acc, s, i + 1, Str.concat(lit, "$"))

def internInterpSkip(acc: List[String], s: String, i: Int): List[String] =
  if (i >= Str.len(s)) acc else if (isIdentCont(Str.charAt(s, i))) internInterpSkip(acc, s, i + 1) else internInterp(acc, s, i, "")

def internInterpBrace(acc: List[String], s: String, i: Int): List[String] =
  internInterpBrace2(closeBrace(s, i + 2, 1), acc, s, i)

def internInterpBrace2(j: Int, acc: List[String], s: String, i: Int): List[String] =
  internInterp(internHole(acc, Str.slice(s, i + 2, j - 1)), s, j, "")

def internHole(acc: List[String], inner: String): List[String] =
  collectToks(Lexer.lex(inner), acc)

def emitConsts(xs: List[String], i: Int): String =
  Builder.result(emitConstsB(xs, i, Builder.empty()))

def emitConstsB(xs: List[String], i: Int, b: Builder): Builder =
  if (List.isEmpty(xs)) b else emitConstsB(List.tail(xs), i + 1, Builder.append(b, Str.concat(strConst(i, List.at(xs, 0)), nl())))

def join(a: String, b: String): String =
  Str.concat(a, b)

def cat3(a: String, b: String, c: String): String =
  Builder.result(Builder.append(Builder.append(Builder.append(Builder.empty(), a), b), c))

def cat4(a: String, b: String, c: String, d: String): String =
  Builder.result(Builder.append(Builder.append(Builder.append(Builder.append(Builder.empty(), a), b), c), d))

def cat6(a: String, b: String, c: String, d: String, e: String, f: String): String =
  Builder.result(Builder.append(Builder.append(Builder.append(Builder.append(Builder.append(Builder.append(Builder.empty(), a), b), c), d), e), f))

def llvmBin(op: String): String =
  if (op == "+") "add" else if (op == "-") "sub" else if (op == "*") "mul" else if (op == "/") "sdiv" else if (op == "%") "srem" else if (op == "&") "and" else if (op == "|") "or" else if (op == "^") "xor" else if (op == "<<") "shl" else if (op == ">>") "ashr" else stuckStr()

def stuckStr(): String =
  stuckStr()

def emitExpr(e: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitExprFid(e, prefix, strs, defs, ens, ps, loc, 0)

def emitExprFid(e: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  if (needsPh(e)) emitLam("_ph", rewriteHole(e, "_ph"), prefix, strs, defs, ens, ps, loc) else emitExprGo(etaKit(e, ps, defs, modOfLoc(loc)), prefix, strs, defs, ens, ps, loc, fid)

def needsPh(e: Expr): Bool =
  e match {
    case Expr.ELam(_, _, _) => false
    case Expr.EHole => true
    case Expr.EBin(_, l, r, _) => hasHole(l) || hasHole(r)
    case Expr.EUn(_, inner, _) => hasHole(inner)
    case Expr.ECall(f, args, _) => needsPhCall(f, args)
    case Expr.EMethod(recv, _, args, _) => needsPhMethod(recv, args)
    case Expr.EField(recv, _, _) => isBareHole(recv)
    case _ => false
  }

def needsPhCall(f: String, args: List[Expr]): Bool =
  if (isHoKit(f)) false else hasBareHoleArg(args) && !hasCompoundPhArg(args)

def isHoKit(f: String): Bool =
  isMapKit(f) || isFoldKit(f) || f == "List.tabulate" || f == "List.segmentLength"

def needsPhMethod(recv: Expr, args: List[Expr]): Bool =
  (isBareHole(recv) || hasBareHoleArg(args)) && !isCompoundPh(recv) && !hasCompoundPhArg(args)

def isBareHole(e: Expr): Bool =
  e match {
    case Expr.EHole => true
    case _ => false
  }

def isCompoundPh(e: Expr): Bool =
  hasHole(e) && !isBareHole(e)

def hasBareHoleArg(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (isBareHole(List.at(xs, 0)) || hasBareHoleArg(List.tail(xs)))

def hasCompoundPhArg(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (isCompoundPh(List.at(xs, 0)) || hasCompoundPhArg(List.tail(xs)))

def hasHole(e: Expr): Bool =
  e match {
    case Expr.EHole => true
    case Expr.EPrint(inner, _) => hasHole(inner)
    case Expr.ECall(_, args, _) => hasHoleList(args)
    case Expr.EMethod(recv, _, args, _) => hasHole(recv) || hasHoleList(args)
    case Expr.EField(recv, _, _) => hasHole(recv)
    case Expr.EBin(_, l, r, _) => hasHole(l) || hasHole(r)
    case Expr.EUn(_, inner, _) => hasHole(inner)
    case Expr.ELam(_, _, body) => hasHole(body)
    case Expr.EIf(c, t, el, _) => hasHole(c) || hasHole(t) || hasHole(el)
    case Expr.EMatch(s, arms, _) => hasHole(s) || hasHoleArms(arms)
    case Expr.EList(xs) => hasHoleList(xs)
    case Expr.ETuple(xs) => hasHoleList(xs)
    case Expr.ENamed(_, inner) => hasHole(inner)
    case Expr.EAscribe(inner, _, _) => hasHole(inner)
    case _ => false
  }

def hasHoleList(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (hasHole(List.at(xs, 0)) || hasHoleList(List.tail(xs)))

def hasHoleArms(xs: List[Arm]): Bool =
  if (List.isEmpty(xs)) false else hasHoleArm(List.at(xs, 0)) || hasHoleArms(List.tail(xs))

def hasHoleArm(a: Arm): Bool =
  a match {
    case Arm(_, _, body) => hasHole(body)
  }

def rewriteHole(e: Expr, n: String): Expr =
  e match {
    case Expr.EHole => Expr.EVar(n, 0)
    case Expr.EPrint(inner, _) => Expr.EPrint(rewriteHole(inner, n), 0)
    case Expr.ECall(f, args, _) => Expr.ECall(f, rewriteHoleList(args, n), 0)
    case Expr.EMethod(recv, name, args, _) => Expr.EMethod(rewriteHole(recv, n), name, rewriteHoleList(args, n), 0)
    case Expr.EField(recv, name, _) => Expr.EField(rewriteHole(recv, n), name, 0)
    case Expr.EBin(op, l, r, _) => Expr.EBin(op, rewriteHole(l, n), rewriteHole(r, n), 0)
    case Expr.EUn(op, inner, _) => Expr.EUn(op, rewriteHole(inner, n), 0)
    case Expr.ELam(p, ty, body) => Expr.ELam(p, ty, rewriteHole(body, n))
    case Expr.EIf(c, t, el, _) => Expr.EIf(rewriteHole(c, n), rewriteHole(t, n), rewriteHole(el, n), 0)
    case Expr.ENamed(nm, inner) => Expr.ENamed(nm, rewriteHole(inner, n))
    case Expr.EAscribe(inner, ty, off) => Expr.EAscribe(rewriteHole(inner, n), ty, off)
    case Expr.EList(xs) => Expr.EList(rewriteHoleList(xs, n))
    case Expr.ETuple(xs) => Expr.ETuple(rewriteHoleList(xs, n))
    case _ => e
  }

def rewriteHoleList(xs: List[Expr], n: String): List[Expr] =
  if (List.isEmpty(xs)) xs else rewriteHole(List.at(xs, 0), n) :: rewriteHoleList(List.tail(xs), n)

def emitExprGo(e: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  e match {
    case Expr.EInt(n, _) => Slot("", Str.fromInt(n), false)
    case Expr.EBool(b) => Slot("", if (b) "1" else "0", false)
    case Expr.EVar(s, _) => emitVar(s, prefix, ens, ps, strs, defs, loc)
    case Expr.EStr(s, _) => emitStrAs(s, prefix, strs, "s")
    case Expr.EPrint(inner, _) => emitPrint(inner, prefix, strs, defs, ens, ps, loc)
    case Expr.ECall(f, args, _) => emitCall(f, args, prefix, strs, defs, ens, ps, loc)
    case Expr.EBin(op, l, r, _) => emitBin(op, l, r, prefix, strs, defs, ens, ps, loc)
    case Expr.EUn(op, inner, _) => emitUn(op, inner, prefix, strs, defs, ens, ps, loc)
    case Expr.ENamed(_, inner) => emitExprFid(inner, prefix, strs, defs, ens, ps, loc, fid)
    case Expr.EMethod(recv, name, args, _) => if (isFmName(name)) emitFmRt(fmRt(name), recv, args, prefix, strs, defs, ens, ps, loc, fid) else if (name == "apply") emitApplyRecv(recv, args, prefix, strs, defs, ens, ps, loc, fid) else if (name == "map") emitIoMap(recv, args, prefix, strs, defs, ens, ps, loc, fid) else emitCtorCall(recv, name, args, prefix, strs, defs, ens, ps, loc)
    case Expr.ELam(p, _, body) => emitLam(p, body, prefix, strs, defs, ens, ps, loc)
    case Expr.EIf(c, t, el, _) => emitIfFid(c, t, el, prefix, strs, defs, ens, ps, loc, fid)
    case Expr.EField(recv, name, _) => emitField(recv, name, prefix, ens, ps)
    case Expr.EMatch(s, arms, _) => emitMatch(s, arms, prefix, strs, defs, ens, ps, loc)
    case Expr.EList(xs) => emitList(xs, prefix, strs, defs, ens, ps, loc)
    case Expr.ETuple(xs) => emitTuple(xs, prefix, strs, defs, ens, ps, loc)
    case Expr.EInterp(s) => emitInterp(s, prefix, strs, defs, ens, ps, loc)
    case Expr.EFloat(s) => emitFloatBits(s, prefix)
    case Expr.EFor(bs, body, _) => emitExprFid(desugarFor(bs, body), prefix, strs, defs, ens, ps, loc, fid)
    case Expr.EAscribe(inner, _, _) => emitExprFid(inner, prefix, strs, defs, ens, ps, loc, fid)
    case Expr.EUnit => Slot("", "null", true)
    case _ => emitStuck()
  }

def emitStuck(): Slot =
  emitStuck()

def emitFloatBits(s: String, prefix: String): Slot =
  Slot(line(Str.concat(tmp(prefix, "fb"), Str.concat("bitcast double ", Str.concat(s, " to i64")))), pct(prefix, "fb"), false)

def emitVar(s: String, prefix: String, ens: List[En], ps: List[Param], strs: List[String], defs: List[Fun], loc: String): Slot =
  if (s == "value" || paramTy(ps, s) != "") Slot("", Str.concat("%", s), s == "value") else emitFunOrCtor(s, prefix, ens, ps, strs, defs, loc, findDefPrefer(defs, s, modOfLoc(loc)))

def emitFunOrCtor(s: String, prefix: String, ens: List[En], ps: List[Param], strs: List[String], defs: List[Fun], loc: String, hit: List[Fun]): Slot =
  if (List.isEmpty(hit)) emitBareCtor(s, prefix, ens) else emitFunRef(List.at(hit, 0), prefix, strs, defs, ens, ps, loc)

def emitFunRef(d: Fun, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  d match {
    case Fun(_, name, _, params, _, _, _, _) => emitFunRef2(name, params, prefix, strs, defs, ens, ps, loc)
  }

def emitFunRef2(name: String, params: List[Param], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.len(params) == 2) emitExpr(etaFold(name), prefix, strs, defs, ens, ps, loc) else if (List.isEmpty(params)) emitLam("_", Expr.ECall(name, noExpr(), 0), prefix, strs, defs, ens, ps, loc) else emitFunRef1(name, List.at(params, 0), prefix, strs, defs, ens, ps, loc)

def emitFunRef1(name: String, p: Param, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  p match {
    case Param(n, _, _, _) => emitLam(n, Expr.ECall(name, Expr.EVar(n, 0) :: noExpr(), 0), prefix, strs, defs, ens, ps, loc)
  }

def emitBareCtor(s: String, prefix: String, ens: List[En]): Slot =
  if (enOfCase(ens, s) == "") Slot("", Str.concat("%", s), false) else emitCtor(enOfCase(ens, s), s, prefix, ens)

def enOfCase(ens: List[En], name: String): String =
  if (List.isEmpty(ens)) "" else enOfCaseH(List.at(ens, 0), List.tail(ens), name)

def enOfCaseH(h: En, rest: List[En], name: String): String =
  h match {
    case En(_, n, _, cases) => if (hasCase(cases, name)) n else enOfCase(rest, name)
  }

def hasCase(cs: List[EnCase], name: String): Bool =
  if (List.isEmpty(cs)) false else hasCaseH(List.at(cs, 0), List.tail(cs), name)

def hasCaseH(h: EnCase, rest: List[EnCase], name: String): Bool =
  h match {
    case EnCase(n, _) => n == name || hasCase(rest, name)
  }

def desugarFor(bs: List[Bind], body: Expr): Expr =
  desugarForRev(List.reverse(bs), forYield(bs, body))

def forYield(bs: List[Bind], body: Expr): Expr =
  if (hasDraw(bs)) Expr.ECall("IO.pure", body :: noExpr(), 0) else body

def desugarForRev(bs: List[Bind], body: Expr): Expr =
  if (List.isEmpty(bs)) body else desugarForRevHit(bs, body)

def desugarForRevHit(bs: List[Bind], body: Expr): Expr =
  desugarForRevGo(bs, List.at(bs, 0), List.tail(bs), body)

def desugarForRevGo(held: List[Bind], b: Bind, rest: List[Bind], body: Expr): Expr =
  desugarForRev(rest, wrapBindHeld(held, b, body))

def wrapBindHeld(_held: List[Bind], b: Bind, body: Expr): Expr =
  wrapBind(b, body)

def wrapBind(b: Bind, body: Expr): Expr =
  b match {
    case Bind(draw, name, v) => wrapBindGo(draw, name, v, body)
  }

def wrapBindGo(draw: Bool, name: String, v: Expr, body: Expr): Expr =
  if (draw) wrapDraw(name, v, body) else if (name == "__guard") wrapGuard(v, body) else wrapEq(name, v, body)

def wrapGuard(c: Expr, body: Expr): Expr =
  Expr.EIf(c, body, Expr.ECall("IO.fail", Expr.EStr("guard", 0) :: noExpr(), 0), 0)

def wrapDraw(name: String, v: Expr, body: Expr): Expr =
  if (isSimpleBind(name)) Expr.EMethod(v, "flatMap", Expr.ELam(name, "", body) :: noExpr(), 0) else wrapPatDraw(name, v, body)

def wrapPatDraw(pat: String, v: Expr, body: Expr): Expr =
  Expr.EMethod(Expr.EMethod(v, "flatMap", Expr.ELam("__p", "", Expr.ECall("IO.pure", Expr.EMatch(Expr.EVar("__p", 0), Arm(pat, "", patResult(pat)) :: noArm(), 0) :: noExpr(), 0)) :: noExpr(), 0), "flatMap", Expr.ELam(patBindName(pat), "", body) :: noExpr(), 0)

def patResult(pat: String): Expr =
  if (isConsPat(pat)) Expr.EVar(consHead(pat), 0) else if (hasComma(patBind(pat))) Expr.ETuple(patEVars(splitPat(patBind(pat)))) else Expr.EVar(fieldBind(patBind(pat)), 0)

def patEVars(ns: List[String]): List[Expr] =
  if (List.isEmpty(ns)) noExpr() else Expr.EVar(fieldBind(List.at(ns, 0)), 0) :: patEVars(List.tail(ns))

def patBindName(pat: String): String =
  if (isConsPat(pat)) consHead(pat) else if (hasComma(patBind(pat))) Str.concat("(", Str.concat(joinComma(splitPat(patBind(pat))), ")")) else fieldBind(patBind(pat))

def joinComma(xs: List[String]): String =
  if (List.isEmpty(xs)) "" else if (List.isEmpty(List.tail(xs))) List.at(xs, 0) else Str.concat(List.at(xs, 0), Str.concat(", ", joinComma(List.tail(xs))))

def wrapEq(name: String, v: Expr, body: Expr): Expr =
  if (eqIsLet(name)) Expr.EMethod(Expr.ELam(name, "", body), "apply", nameSig(name, v) :: noExpr(), 0) else wrapDraw(name, Expr.ECall("IO.pure", v :: noExpr(), 0), body)

def nameSig(name: String, v: Expr): Expr =
  if (name == "_" || !isSimpleBind(name)) v else nameSigGo(name, v)

def nameSigGo(name: String, v: Expr): Expr =
  v match {
    case Expr.ECall(f, args, _) => if (sigCtorKit(f)) Expr.ECall(Str.concat(f, "N"), Expr.EStr(name, 0) :: args, 0) else v
    case _ => v
  }

def sigCtorKit(f: String): Bool =
  f == "Signal.int" || f == "Signal.str" || f == "Signal.list" || f == "Signal.map"

def eqIsLet(name: String): Bool =
  name == "_" || keepBind(name) && !isTuplePat(name) && isSimpleBind(name)

def isSimpleBind(n: String): Bool =
  n != "" && parenAt(n, 0) < 0 && !isConsPat(n)

def emitInterp(s: String, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitInterpFold(interpParts(s, 0, "", noExpr()), prefix, strs, defs, ens, ps, loc, 0)

def interpParts(s: String, i: Int, lit: String, acc: List[Expr]): List[Expr] =
  if (i >= Str.len(s)) interpPartsEnd(lit, acc) else interpPartsCh(s, i, lit, acc, Str.charAt(s, i))

def interpPartsEnd(lit: String, acc: List[Expr]): List[Expr] =
  if (lit == "") List.reverse(acc) else List.reverse(Expr.EStr(lit, 0) :: acc)

def interpPartsCh(s: String, i: Int, lit: String, acc: List[Expr], c: Int): List[Expr] =
  if (c == 36) interpPartsDollar(s, i, lit, acc) else interpParts(s, i + 1, Str.concat(lit, Str.slice(s, i, i + 1)), acc)

def interpPartsDollar(s: String, i: Int, lit: String, acc: List[Expr]): List[Expr] =
  if (i + 1 >= Str.len(s)) interpParts(s, i + 1, Str.concat(lit, "$"), acc) else interpPartsDollar2(s, i, lit, acc, Str.charAt(s, i + 1))

def interpPartsDollar2(s: String, i: Int, lit: String, acc: List[Expr], n: Int): List[Expr] =
  if (n == 123) interpPartsBrace(s, i, lit, acc) else if (isIdentStart(n)) interpPartsIdent(s, i + 1, lit, acc) else interpParts(s, i + 1, Str.concat(lit, "$"), acc)

def isIdentStart(c: Int): Bool =
  c == 95 || c >= 65 && c <= 90 || c >= 97 && c <= 122

def isIdentCont(c: Int): Bool =
  isIdentStart(c) || c >= 48 && c <= 57

def interpPartsIdent(s: String, i: Int, lit: String, acc: List[Expr]): List[Expr] =
  interpPartsIdent2(s, i, i, lit, acc)

def interpPartsIdent2(s: String, i: Int, start: Int, lit: String, acc: List[Expr]): List[Expr] =
  if (i >= Str.len(s)) interpPartsFlush(lit, Expr.EVar(Str.slice(s, start, i), 0), acc, s, i) else if (isIdentCont(Str.charAt(s, i))) interpPartsIdent2(s, i + 1, start, lit, acc) else interpPartsFlush(lit, Expr.EVar(Str.slice(s, start, i), 0), acc, s, i)

def interpPartsFlush(lit: String, e: Expr, acc: List[Expr], s: String, i: Int): List[Expr] =
  if (lit == "") interpParts(s, i, "", e :: acc) else interpParts(s, i, "", e :: Expr.EStr(lit, 0) :: acc)

def interpPartsBrace(s: String, i: Int, lit: String, acc: List[Expr]): List[Expr] =
  interpPartsBrace2(s, closeBrace(s, i + 2, 1), i, lit, acc)

def closeBrace(s: String, i: Int, depth: Int): Int =
  if (i >= Str.len(s) || depth <= 0) i else closeBraceCh(s, i, depth, Str.charAt(s, i))

def closeBraceCh(s: String, i: Int, depth: Int, c: Int): Int =
  if (c == 34) closeBrace(s, skipQuoted(s, i + 1), depth) else if (c == 123) closeBrace(s, i + 1, depth + 1) else if (c == 125) closeBrace(s, i + 1, depth - 1) else closeBrace(s, i + 1, depth)

def skipQuoted(s: String, i: Int): Int =
  if (i >= Str.len(s)) i else skipQuotedCh(s, i, Str.charAt(s, i))

def skipQuotedCh(s: String, i: Int, c: Int): Int =
  if (c == 34) i + 1 else if (c == 92 && i + 1 < Str.len(s)) skipQuoted(s, i + 2) else skipQuoted(s, i + 1)

def interpPartsBrace2(s: String, j: Int, i: Int, lit: String, acc: List[Expr]): List[Expr] =
  interpPartsBrace3(Parse.parseExprList(Lexer.lex(Str.slice(s, i + 2, j - 1)), 0), lit, acc, s, j)

def interpPartsBrace3(p: (Expr, Int), lit: String, acc: List[Expr], s: String, j: Int): List[Expr] =
  p match {
    case (e, _) => interpPartsFlush(lit, e, acc, s, j)
  }

def emitInterpFold(parts: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  if (List.isEmpty(parts)) emitStrAs("", prefix, strs, "s") else emitInterpAcc(emitInterpPart(List.at(parts, 0), prefix, i, strs, defs, ens, ps, loc), List.tail(parts), prefix, strs, defs, ens, ps, loc, i + 1)

def emitInterpPart(e: Expr, prefix: String, i: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  e match {
    case Expr.EStr(s, _) => emitStrAs(s, Str.concat(prefix, Str.concat("_l", Str.fromInt(i))), strs, "s")
    case _ => emitInterpExpr(e, Str.concat(prefix, Str.concat("_e", Str.fromInt(i))), strs, defs, ens, ps, loc)
  }

def emitInterpExpr(e: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitInterpExpr2(emitExpr(e, prefix, strs, defs, ens, ps, loc), prefix, exprIsI64(e, ps, defs), ps, isFloatExpr(e, ps, defs))

def emitInterpExpr2(s: Slot, prefix: String, i64: Bool, ps: List[Param], fl: Bool): Slot =
  s match {
    case Slot(c, v, o) => if (fl) emitInterpFloat(s, prefix) else if (i64 || hasSub(v, "_u")) emitInterpI64(if (thenIsPtr(c, v, o, ps)) unboxBin(s, ps, prefix) else s, prefix) else s
  }

def emitInterpFloat(s: Slot, prefix: String): Slot =
  s match {
    case Slot(c, v, _) => emitInterpFloat2(c, v, prefix)
  }

def emitInterpFloat2(c: String, v: String, prefix: String): Slot =
  Slot(join(c, join(bitcastF(v, prefix, "fd"), fromFloatCall(prefix))), pct(prefix, "istr"), true)

def fromFloatCall(prefix: String): String =
  line(Str.concat(tmp(prefix, "istr"), Str.concat("call ptr @sz_string_from_float(double ", Str.concat(pct(prefix, "fd"), ")"))))

def emitInterpI64(s: Slot, prefix: String): Slot =
  s match {
    case Slot(c, v, _) => Slot(join(c, line(Str.concat(tmp(prefix, "istr"), Str.concat("call ptr @sz_string_from_int(i64 ", Str.concat(v, ")"))))), pct(prefix, "istr"), true)
  }

def emitInterpAcc(acc: Slot, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  if (List.isEmpty(rest)) acc else emitInterpCat(acc, emitInterpPart(List.at(rest, 0), prefix, i, strs, defs, ens, ps, loc), rest, prefix, strs, defs, ens, ps, loc, i)

def emitInterpCat(acc: Slot, nxt: Slot, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  acc match {
    case Slot(ac, av, ao) => emitInterpCat2(ac, av, ao, nxt, rest, prefix, strs, defs, ens, ps, loc, i)
  }

def emitInterpCat2(ac: String, av: String, ao: Bool, nxt: Slot, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  nxt match {
    case Slot(nc, nv, no) => emitInterpCat3(join(ac, nc), av, ao, nv, no, rest, prefix, strs, defs, ens, ps, loc, i)
  }

def emitInterpCat3(code: String, av: String, ao: Bool, nv: String, no: Bool, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  emitInterpAcc(emitInterpJoin(code, av, ao, nv, no, prefix, i), List.tail(rest), prefix, strs, defs, ens, ps, loc, i + 1)

def interpCStem(prefix: String, i: Int): String =
  Str.concat(prefix, Str.concat("_c", Str.fromInt(i)))

def emitInterpJoin(code: String, a: String, oa: Bool, b: String, ob: Bool, prefix: String, i: Int): Slot =
  emitInterpJoin2(code, a, oa, b, ob, interpCStem(prefix, i))

def emitInterpJoin2(code: String, a: String, oa: Bool, b: String, ob: Bool, stem: String): Slot =
  Slot(join(code, join(interpConcat(stem, a, b), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(stem, "v"), true)

def interpConcat(stem: String, a: String, b: String): String =
  line(Str.concat(tmp(stem, "v"), Str.concat("call ptr @sz_string_concat(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))

def emitStr(s: String, prefix: String, strs: List[String]): Slot =
  emitStrAs(s, prefix, strs, "ss")

def emitStrAs(s: String, prefix: String, strs: List[String], stem: String): Slot =
  emitStr2(prefix, strIndex(strs, s, 0), strArr(s), stem)

def emitStr2(prefix: String, idx: Int, len: Int, stem: String): Slot =
  Slot(join(line(Str.concat(tmp(prefix, "gep"), Str.concat("getelementptr inbounds [", Str.concat(Str.fromInt(len), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(idx), ", i64 0, i64 0")))))), line(Str.concat(tmp(prefix, stem), Str.concat("call ptr @sz_string_from_cstr(ptr ", Str.concat(pct(prefix, "gep"), ")"))))), pct(prefix, stem), true)

def emitPrint(inner: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitPrint2(emitSzString(inner, prefix, strs, defs, ens, ps, loc), prefix)

def emitSzString(inner: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  inner match {
    case Expr.EStr(s, _) => emitStr(s, prefix, strs)
    case _ => emitExpr(inner, Str.concat(prefix, "_e"), strs, defs, ens, ps, loc)
  }

def emitPrint2(s: Slot, prefix: String): Slot =
  Slot(join(s.code, join(line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @sz_io_println(ptr ", Str.concat(s.val, ")")))), if (s.owned) line(Str.concat("call void @sz_release(ptr ", Str.concat(s.val, ")"))) else "")), pct(prefix, "io"), false)

def emitBin(op: String, l: Expr, r: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (op == "::") emitCall("List.cons", l :: r :: noExpr(), prefix, strs, defs, ens, ps, loc) else if (op == "&&") emitSc(true, l, r, prefix, strs, defs, ens, ps, loc) else if (op == "||") emitSc(false, l, r, prefix, strs, defs, ens, ps, loc) else emitBinFl(emitExpr(l, Str.concat(prefix, "_l"), strs, defs, ens, ps, loc), emitExpr(r, Str.concat(prefix, "_r"), strs, defs, ens, ps, loc), op, prefix, ps, isFloatExpr(l, ps, defs) || isFloatExpr(r, ps, defs))

def isFloatExpr(e: Expr, ps: List[Param], defs: List[Fun]): Bool =
  e match {
    case Expr.EFloat(_) => true
    case Expr.EVar(s, _) => paramTy(ps, s) == "Float"
    case Expr.ECall(f, _, _) => funRetStr(defs, f) == "Float" || f == "Float.fromInt"
    case Expr.EMethod(r, n, _, _) => isFloatMeth(r, n) || isFloatExpr(r, ps, defs)
    case Expr.EBin(_, a, b, _) => isFloatExpr(a, ps, defs) || isFloatExpr(b, ps, defs)
    case Expr.EUn(_, inner, _) => isFloatExpr(inner, ps, defs)
    case Expr.ENamed(_, inner) => isFloatExpr(inner, ps, defs)
    case Expr.EAscribe(inner, _, _) => isFloatExpr(inner, ps, defs)
    case _ => false
  }

def emitBinFl(le: Slot, re: Slot, op: String, prefix: String, ps: List[Param], fl: Bool): Slot =
  if (isCmp(op)) emitBinCmpFl(le, re, op, prefix, ps, fl) else if (fl) emitFBin2L(le, re, op, prefix) else emitBin2L(unboxBin(le, ps, Str.concat(prefix, "_bl")), unboxBin(re, ps, Str.concat(prefix, "_br")), op, prefix)

def emitBinCmpFl(le: Slot, re: Slot, op: String, prefix: String, ps: List[Param], fl: Bool): Slot =
  if (fl) emitFCmp(le, re, op, prefix) else emitBinCmpPick(le, re, op, prefix, ps)

def emitFBin2L(le: Slot, re: Slot, op: String, prefix: String): Slot =
  le match {
    case Slot(lc, lv, _) => emitFBin2R(lc, lv, re, op, prefix)
  }

def emitFBin2R(lc: String, lv: String, re: Slot, op: String, prefix: String): Slot =
  re match {
    case Slot(rc, rv, _) => emitFBin2S(join(lc, rc), lv, rv, op, prefix)
  }

def emitFBin2S(code: String, lv: String, rv: String, op: String, prefix: String): Slot =
  Slot(join(code, join(bitcastF(lv, prefix, "fl"), join(bitcastF(rv, prefix, "fr"), join(fBinLine(op, prefix), bitcastI(pct(prefix, "fv"), prefix))))), pct(prefix, "v"), false)

def fBinLine(op: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "fv"), Str.concat(llvmFBin(op), Str.concat(" double ", Str.concat(pct(prefix, "fl"), Str.concat(", ", pct(prefix, "fr")))))))

def bitcastF(v: String, prefix: String, stem: String): String =
  line(Str.concat(tmp(prefix, stem), Str.concat("bitcast i64 ", Str.concat(v, " to double"))))

def bitcastI(v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("bitcast double ", Str.concat(v, " to i64"))))

def llvmFBin(op: String): String =
  if (op == "+") "fadd" else if (op == "-") "fsub" else if (op == "*") "fmul" else if (op == "/") "fdiv" else "fadd"

def emitFCmp(le: Slot, re: Slot, op: String, prefix: String): Slot =
  le match {
    case Slot(lc, lv, _) => emitFCmpR(lc, lv, re, op, prefix)
  }

def emitFCmpR(lc: String, lv: String, re: Slot, op: String, prefix: String): Slot =
  re match {
    case Slot(rc, rv, _) => emitFCmpS(join(lc, rc), lv, rv, op, prefix)
  }

def emitFCmpS(code: String, lv: String, rv: String, op: String, prefix: String): Slot =
  Slot(join(code, join(bitcastF(lv, prefix, "fl"), join(bitcastF(rv, prefix, "fr"), join(fCmpLine(op, prefix), fCmpZext(prefix))))), pct(prefix, "v"), false)

def fCmpLine(op: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "fc"), Str.concat(llvmFCmp(op), Str.concat(" double ", Str.concat(pct(prefix, "fl"), Str.concat(", ", pct(prefix, "fr")))))))

def fCmpZext(prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("zext i1 ", Str.concat(pct(prefix, "fc"), " to i64"))))

def llvmFCmp(op: String): String =
  if (op == "<") "fcmp olt" else if (op == ">") "fcmp ogt" else if (op == "<=") "fcmp ole" else if (op == ">=") "fcmp oge" else if (op == "==") "fcmp oeq" else "fcmp one"

def isFloatMeth(r: Expr, n: String): Bool =
  r match {
    case Expr.EVar(m, _) => m == "Float" && n == "fromInt"
    case _ => false
  }

def emitBinCmpPick(le: Slot, re: Slot, op: String, prefix: String, ps: List[Param]): Slot =
  if (cmpPtrSides(le, re, ps)) emitPtrEq(le, re, op, prefix) else emitBinCmp(unboxBin(le, ps, Str.concat(prefix, "_bl")), unboxBin(re, ps, Str.concat(prefix, "_br")), op, prefix, ps)

def cmpPtrSides(le: Slot, re: Slot, ps: List[Param]): Bool =
  le match {
    case Slot(lc, lv, lo) => re match {
  case Slot(rc, rv, ro) => lo || ro || strish(lv) || strish(rv) || cmpPtrSlot(lv, rv, ps) || cmpPtrSlot(rv, lv, ps) || cmpPtrCall(lc, lv, rc, rv, ro, ps) || cmpPtrCall(rc, rv, lc, lv, lo, ps)
}
  }

def cmpPtrCall(ac: String, a: String, bc: String, b: String, bo: Bool, ps: List[Param]): Bool =
  thenCallPtr(ac, a) && (bo || strish(b) || isPtrSlot(b, ps) || thenCallPtr(bc, b) || b == "null")

def cmpPtrSlot(a: String, b: String, ps: List[Param]): Bool =
  isPtrSlot(a, ps) && !isI64Lit(b)

def isI64Lit(v: String): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) != 37 && v != "null"

def strish(v: String): Bool =
  hasSub(v, "_s") || hasSub(v, "_ss") || hasSub(v, "_gep")

def unboxBin(s: Slot, ps: List[Param], prefix: String): Slot =
  s match {
    case Slot(c, v, o) => if (fromIntUnbox(v, ps) || thenIsPtr(c, v, o, ps)) Slot(join(c, line(Str.concat(tmp(prefix, "u"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(v, ")"))))), pct(prefix, "u"), false) else Slot(c, v, o)
  }

def emitBin2L(le: Slot, re: Slot, op: String, prefix: String): Slot =
  le match {
    case Slot(lc, lv, _) => emitBin2R(lc, lv, re, op, prefix)
  }

def emitBin2R(lc: String, lv: String, re: Slot, op: String, prefix: String): Slot =
  re match {
    case Slot(rc, rv, _) => Slot(join(lc, join(rc, line(Str.concat(tmp(prefix, "v"), Str.concat(llvmBin(op), Str.concat(" i64 ", Str.concat(lv, Str.concat(", ", rv)))))))), pct(prefix, "v"), false)
  }

def emitBinCmp(le: Slot, re: Slot, op: String, prefix: String, ps: List[Param]): Slot =
  le match {
    case Slot(lc, lv, lo) => emitBinCmpR(lc, lv, lo, re, op, prefix, ps)
  }

def emitBinCmpR(lc: String, lv: String, lo: Bool, re: Slot, op: String, prefix: String, ps: List[Param]): Slot =
  re match {
    case Slot(rc, rv, ro) => emitBinCmpHit(lc, lv, lo, rc, rv, ro, op, prefix, ps)
  }

def emitBinCmpHit(lc: String, lv: String, lo: Bool, rc: String, rv: String, ro: Bool, op: String, prefix: String, ps: List[Param]): Slot =
  if (lo || ro || isPtrSlot(lv, ps) || isPtrSlot(rv, ps)) emitPtrEq3(join(lc, rc), lv, lo, rv, ro, op, prefix) else emitCmpFrom(lc, lv, rc, rv, op, prefix)

def emitPtrEq(le: Slot, re: Slot, op: String, prefix: String): Slot =
  le match {
    case Slot(lc, lv, lo) => emitPtrEqR(lc, lv, lo, re, op, prefix)
  }

def emitPtrEqR(lc: String, lv: String, lo: Bool, re: Slot, op: String, prefix: String): Slot =
  re match {
    case Slot(rc, rv, ro) => emitPtrEq3(join(lc, rc), lv, lo, rv, ro, op, prefix)
  }

def emitPtrEq3(code: String, lv: String, lo: Bool, rv: String, ro: Bool, op: String, prefix: String): Slot =
  Slot(join(code, join(ptrEqCall(prefix, lv, rv), join(ptrEqZext(prefix), join(if (lo) relPtr(lv) else "", join(if (ro) relPtr(rv) else "", if (op == "!=") emitPtrNe(prefix) else ""))))), if (op == "!=") pct(prefix, "nev") else pct(prefix, "eq"), false)

def ptrEqCall(prefix: String, a: String, b: String): String =
  line(Str.concat(tmp(prefix, "eqi"), Str.concat("call i32 @sz_ptr_eq(ptr ", Str.concat(ptrEqSide(a), Str.concat(", ptr ", Str.concat(ptrEqSide(b), ")"))))))

def ptrEqSide(v: String): String =
  if (v == "0") "null" else v

def ptrEqZext(prefix: String): String =
  line(Str.concat(tmp(prefix, "eq"), Str.concat("zext i32 ", Str.concat(pct(prefix, "eqi"), " to i64"))))

def emitPtrNe(prefix: String): String =
  join(line(Str.concat(tmp(prefix, "ne"), Str.concat("icmp eq i64 ", Str.concat(pct(prefix, "eq"), ", 0")))), line(Str.concat(tmp(prefix, "nev"), Str.concat("zext i1 ", Str.concat(pct(prefix, "ne"), " to i64")))))

def isCmp(op: String): Bool =
  op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">="

def llvmIcmp(op: String): String =
  if (op == "==") "eq" else if (op == "!=") "ne" else if (op == "<") "slt" else if (op == "<=") "sle" else if (op == ">") "sgt" else "sge"

def emitCmpFrom(lc: String, lv: String, rc: String, rv: String, op: String, prefix: String): Slot =
  Slot(join(lc, join(rc, join(line(Str.concat(tmp(prefix, "cmp"), Str.concat("icmp ", Str.concat(llvmIcmp(op), Str.concat(" i64 ", Str.concat(lv, Str.concat(", ", rv))))))), line(Str.concat(tmp(prefix, "v"), Str.concat("zext i1 ", Str.concat(pct(prefix, "cmp"), " to i64"))))))), pct(prefix, "v"), false)

def emitUn(op: String, inner: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitUnFl(emitExpr(inner, Str.concat(prefix, "_u"), strs, defs, ens, ps, loc), op, prefix, isFloatExpr(inner, ps, defs))

def emitUnFl(inner: Slot, op: String, prefix: String, fl: Bool): Slot =
  if (op == "-" && fl) emitFNeg(inner, prefix) else emitUn2(inner, op, prefix)

def emitFNeg(inner: Slot, prefix: String): Slot =
  Slot(join(inner.code, join(bitcastF(inner.val, prefix, "fu"), join(fNegLine(prefix), bitcastI(pct(prefix, "fn"), prefix)))), pct(prefix, "v"), false)

def fNegLine(prefix: String): String =
  line(Str.concat(tmp(prefix, "fn"), Str.concat("fneg double ", pct(prefix, "fu"))))

def emitUn2(inner: Slot, op: String, prefix: String): Slot =
  if (op == "-") Slot(join(inner.code, line(Str.concat(tmp(prefix, "v"), Str.concat("sub i64 0, ", inner.val)))), pct(prefix, "v"), false) else if (op == "!") emitNot(inner, prefix) else if (op == "~") emitBitNot(inner, prefix) else inner

def emitBitNot(inner: Slot, prefix: String): Slot =
  Slot(join(inner.code, line(Str.concat(tmp(prefix, "v"), Str.concat("xor i64 ", Str.concat(inner.val, ", -1"))))), pct(prefix, "v"), false)

def emitNot(inner: Slot, prefix: String): Slot =
  Slot(join(inner.code, join(line(Str.concat(tmp(prefix, "z"), Str.concat("icmp eq i64 ", Str.concat(inner.val, ", 0")))), line(Str.concat(tmp(prefix, "v"), Str.concat("zext i1 ", Str.concat(pct(prefix, "z"), " to i64")))))), pct(prefix, "v"), false)

def emitList(xs: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitListAt(xs, prefix, strs, defs, ens, ps, loc, 0)

def emitTuple(xs: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(xs)) Slot("", "null", true) else emitTupleFold1(List.at(xs, 0), List.tail(xs), prefix, 0, strs, defs, ens, ps, loc)

def emitTupleFold1(h: Expr, rest: List[Expr], prefix: String, i: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(rest)) Slot("", "null", true) else emitTupleFold2(h, List.at(rest, 0), List.tail(rest), prefix, i, strs, defs, ens, ps, loc)

def emitTupleFold2(h: Expr, x: Expr, more: List[Expr], prefix: String, i: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(more)) emitPair(h, x, Str.concat(prefix, Str.concat("_", Str.fromInt(i))), strs, defs, ens, ps, loc) else emitTupleNest(h, emitTupleFold1(x, more, prefix, i + 1, strs, defs, ens, ps, loc), prefix, i, strs, defs, ens, ps, loc)

def emitTupleNest(h: Expr, rest: Slot, prefix: String, i: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitPair2(emitExpr(h, Str.concat(prefix, Str.concat("_h", Str.fromInt(i))), strs, defs, ens, ps, loc), rest, exprIsI64(h, ps, defs), false, Str.concat(prefix, Str.concat("_p", Str.fromInt(i))))

def emitPair(l: Expr, r: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitPair2(emitExpr(l, Str.concat(prefix, "_l"), strs, defs, ens, ps, loc), emitExpr(r, Str.concat(prefix, "_r"), strs, defs, ens, ps, loc), exprIsI64(l, ps, defs), exprIsI64(r, ps, defs), prefix)

def emitPair2(le: Slot, re: Slot, ln: Bool, rn: Bool, prefix: String): Slot =
  le match {
    case Slot(lc, lv, lo) => emitPair3(lc, lv, lo, ln, re, rn, prefix)
  }

def emitPair3(lc: String, lv: String, lo: Bool, ln: Bool, re: Slot, rn: Bool, prefix: String): Slot =
  re match {
    case Slot(rc, rv, ro) => emitPair4(join(lc, rc), lv, lo, ln, rv, ro, rn, prefix)
  }

def emitPair4(code: String, lv: String, lo: Bool, ln: Bool, rv: String, ro: Bool, rn: Bool, prefix: String): Slot =
  Slot(join(code, join(pairBox(lv, ln, prefix, "lb"), join(pairBox(rv, rn, prefix, "rb"), join(pairNew(prefix, pairPtr(lv, ln, prefix, "lb"), pairPtr(rv, rn, prefix, "rb")), join(pairDrop(lv, lo, ln, prefix, "lb"), pairDrop(rv, ro, rn, prefix, "rb")))))), pct(prefix, "v"), true)

def pairBox(v: String, num: Bool, prefix: String, stem: String): String =
  if (num) line(Str.concat(tmp(prefix, stem), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(v, ")")))) else ""

def pairPtr(v: String, num: Bool, prefix: String, stem: String): String =
  if (num) pct(prefix, stem) else v

def pairNew(prefix: String, lp: String, rp: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_pair_new(ptr ", Str.concat(lp, Str.concat(", ptr ", Str.concat(rp, ")"))))))

def pairDrop(v: String, owned: Bool, num: Bool, prefix: String, stem: String): String =
  if (num) relPtr(pct(prefix, stem)) else if (owned) relPtr(v) else ""

def exprIsI64(e: Expr, ps: List[Param], defs: List[Fun]): Bool =
  if (needsPh(e)) false else exprIsI64Go(e, ps, defs)

def exprIsI64Go(e: Expr, ps: List[Param], defs: List[Fun]): Bool =
  e match {
    case Expr.EInt(_, _) => true
    case Expr.EBool(_) => true
    case Expr.EVar(s, _) => paramIsI64(ps, s) || isIntSsa(s)
    case Expr.EBin(op, _, _, _) => op != "::"
    case Expr.EUn(_, _, _) => true
    case Expr.ECall(f, args, _) => exprCallI64(f, args, ps, defs)
    case Expr.EMethod(recv, name, args, _) => exprMethI64(recv, name, args, ps, defs)
    case Expr.EMatch(_, arms, _) => exprIsI64Match(arms, ps, defs)
    case Expr.EIf(_, t, _, _) => exprIsI64(t, ps, defs)
    case Expr.ENamed(_, inner) => exprIsI64(inner, ps, defs)
    case Expr.EAscribe(inner, _, _) => exprIsI64(inner, ps, defs)
    case _ => false
  }

def exprIsI64Match(arms: List[Arm], ps: List[Param], defs: List[Fun]): Bool =
  if (List.isEmpty(arms)) false else exprIsI64Arm(List.at(arms, 0), ps, defs)

def exprCallI64(f: String, args: List[Expr], ps: List[Param], defs: List[Fun]): Bool =
  if (f == "Property.check") exprIsI64Recv(args, ps, defs) else if (f == "List.at") headUnbox(args, ps) else if (callIsI64(f, defs)) true else if (f == "Map.getOrElse" || isTyParam(funRetStr(defs, f))) argsHaveI64(args, ps, defs) else false

def argsHaveI64(xs: List[Expr], ps: List[Param], defs: List[Fun]): Bool =
  !List.isEmpty(xs) && (exprIsI64(List.at(xs, 0), ps, defs) || argsHaveI64(List.tail(xs), ps, defs))

def exprMethI64(recv: Expr, name: String, args: List[Expr], ps: List[Param], defs: List[Fun]): Bool =
  if (name == "at") headUnbox1(recv, ps) else if (name == "getOrElse" && !List.isEmpty(args)) exprIsI64(List.at(args, 0), ps, defs) else exprMethodI64(recv, name, defs)

def exprIsI64Recv(args: List[Expr], ps: List[Param], defs: List[Fun]): Bool =
  if (List.len(args) < 3) false else exprIsI64(List.at(List.tail(List.tail(args)), 0), ps, defs)

def exprIsI64Arm(a: Arm, ps: List[Param], defs: List[Fun]): Bool =
  a match {
    case Arm(_, _, body) => exprIsI64(body, ps, defs)
  }

def paramIsI64(ps: List[Param], s: String): Bool =
  if (List.isEmpty(ps)) false else paramIsI64h(List.at(ps, 0), List.tail(ps), s)

def paramIsI64h(p: Param, rest: List[Param], s: String): Bool =
  p match {
    case Param(n, ty, _, _) => if (n == s) isI64Ty(ty) else paramIsI64(rest, s)
  }

def isIntSsa(s: String): Bool =
  hasSub(s, "_tv") || hasSub(s, "_ic_v") || hasSub(s, "_cu") || hasSub(s, "_phi") || hasSub(s, "_dflt") || hasDigitStem(s, "_b")

def hasDigitStem(s: String, stem: String): Bool =
  hasDigitStemAt(s, stem, 0)

def hasDigitStemAt(s: String, stem: String, n: Int): Bool =
  if (n > 12) false else hasSub(s, Str.concat(stem, Str.fromInt(n))) || hasDigitStemAt(s, stem, n + 1)

def hasSub(s: String, sub: String): Bool =
  hasSubAt(s, sub, 0)

def hasSubAt(s: String, sub: String, i: Int): Bool =
  if (i + Str.len(sub) > Str.len(s)) false else if (startsAt(s, i, sub)) true else hasSubAt(s, sub, i + 1)

def callIsI64(f: String, defs: List[Fun]): Bool =
  f == "Signal.get" || f == "Str.byteLen" || f == "Property.a11yHas" || f == "Property.signalListLen" || f == "Property.signalInt" || f == "Color.rgb" || f == "Color.rgba" || f == "Theme.accent" || f == "Theme.primary" || f == "Theme.muted" || f == "Theme.foreground" || f == "Str.len" || f == "Str.charAt" || f == "Str.toInt" || f == "Str.startsWith" || f == "Str.eq" || f == "Str.contains" || f == "List.len" || f == "List.isEmpty" || f == "Map.size" || f == "Set.size" || f == "Map.contains" || f == "Set.contains" || f == "Json.has" || f == "Json.getBool" || f == "Json.getInt" || f == "Json.intOr" || f == "Json.boolOr" || f == "Json.isNull" || f == "Json.isObj" || f == "Json.isArr" || kitUnaryI64(f) != "" || kitBinaryI64(f) != "" || isTlI64Call(f) || funRetI64(defs, f)

def isTlI64Call(f: String): Bool =
  f == "Timeline.len" || f == "Timeline.signalInt" || f == "Timeline.signalListLen" || f == "Timeline.signalStrHas" || tlHasRt(f) != "" || tlI64Rt(f) != ""

def exprMethodI64(recv: Expr, name: String, defs: List[Fun]): Bool =
  if (name == "require") exprIsI64(recv, noParam(), defs) else exprMethodI64Go(recv, name, defs)

def exprMethodI64Go(recv: Expr, name: String, defs: List[Fun]): Bool =
  recv match {
    case Expr.EVar(en, _) => callIsI64(Str.concat(en, Str.concat(".", name)), defs) || callIsI64(name, defs)
    case _ => false
  }

def funRetI64(defs: List[Fun], f: String): Bool =
  isI64Ty(funRetStr(defs, f))

def funRetStr(defs: List[Fun], f: String): String =
  if (List.isEmpty(defs)) "" else funRetStrH(List.at(defs, 0), List.tail(defs), f)

def funRetStrH(d: Fun, rest: List[Fun], f: String): String =
  d match {
    case Fun(_, name, _, _, ret, _, mod, _) => if (qualFun(mod, name) == f || name == f) ret else funRetStr(rest, f)
  }

def qualFun(mod: String, name: String): String =
  if (mod == "") name else Str.concat(mod, Str.concat(".", name))

def emitListAt(xs: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  if (List.isEmpty(xs)) Slot(line(Str.concat(tmp(prefix, "0"), "call ptr @sz_list_nil()")), pct(prefix, "0"), true) else emitListCons(List.at(xs, 0), List.tail(xs), prefix, strs, defs, ens, ps, loc, i)

def emitListCons(e: Expr, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  emitListCons2(emitListAt(rest, prefix, strs, defs, ens, ps, loc, i + 1), emitExpr(e, Str.concat(prefix, Str.concat("_e", Str.fromInt(i))), strs, defs, ens, ps, loc), prefix, i, exprIsI64(e, ps, defs))

def emitListCons2(tail: Slot, elem: Slot, prefix: String, i: Int, isInt: Bool): Slot =
  tail match {
    case Slot(tc, tv, _) => emitListCons3(tc, tv, elem, prefix, i, isInt)
  }

def emitListCons3(tc: String, tv: String, elem: Slot, prefix: String, i: Int, isInt: Bool): Slot =
  elem match {
    case Slot(ec, ev, eo) => emitListCons4(join(tc, ec), tv, ev, eo, prefix, i, isInt)
  }

def emitListCons4(code: String, tv: String, ev: String, eo: Bool, prefix: String, i: Int, isInt: Bool): Slot =
  if (eo) emitListConsPtr(code, tv, ev, prefix, i) else if (isInt) emitListConsInt(code, tv, ev, prefix, i) else emitListConsBorrow(code, tv, ev, prefix, i)

def emitListConsInt(code: String, tv: String, ev: String, prefix: String, i: Int): Slot =
  Slot(join(code, join(emitBox(prefix, i, ev), join(emitCons(prefix, i, pct(prefix, Str.concat("b", Str.fromInt(i))), tv), join(relPtr(tv), relPtr(pct(prefix, Str.concat("b", Str.fromInt(i)))))))), pct(prefix, Str.fromInt(i + 1)), true)

def emitListConsPtr(code: String, tv: String, ev: String, prefix: String, i: Int): Slot =
  Slot(join(code, join(emitCons(prefix, i, ev, tv), join(relPtr(tv), relPtr(ev)))), pct(prefix, Str.fromInt(i + 1)), true)

def emitListConsBorrow(code: String, tv: String, ev: String, prefix: String, i: Int): Slot =
  Slot(join(code, join(emitCons(prefix, i, ev, tv), relPtr(tv))), pct(prefix, Str.fromInt(i + 1)), true)

def emitBox(prefix: String, i: Int, ev: String): String =
  line(Str.concat(tmp(prefix, Str.concat("b", Str.fromInt(i))), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(ev, ")"))))

def emitCons(prefix: String, i: Int, hd: String, tl: String): String =
  line(Str.concat(tmp(prefix, Str.fromInt(i + 1)), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(hd, Str.concat(", ptr ", Str.concat(tl, ")"))))))

def emitArgList(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, code: String, vals: List[String], owns: List[Bool]): (String, List[String], List[Bool]) =
  if (List.isEmpty(args)) (code, List.reverse(vals), List.reverse(owns)) else emitArgList2(emitExpr(List.at(args, 0), Str.concat(prefix, Str.concat("_arg", Str.fromInt(i))), strs, defs, ens, ps, loc), List.tail(args), prefix, strs, defs, ens, ps, loc, i, code, vals, owns)

def emitArgList2(s: Slot, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, i: Int, code: String, vals: List[String], owns: List[Bool]): (String, List[String], List[Bool]) =
  s match {
    case Slot(sc, sv, so) => emitArgList(rest, prefix, strs, defs, ens, ps, loc, i + 1, join(code, sc), sv :: vals, so :: owns)
  }

def emitCall2(f: String, p: (String, List[String], List[Bool]), prefix: String, defs: List[Fun], args: List[Expr], ens: List[En], ps: List[Param], mod: String): Slot =
  p match {
    case (code, vals, owns) => emitCall3(f, code, vals, owns, prefix, defs, args, ens, ps, mod)
  }

def emitCall3(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, defs: List[Fun], args: List[Expr], ens: List[En], ps: List[Param], mod: String): Slot =
  if (isJsonExtra(f)) emitJsonExtra(f, code, vals, owns, prefix) else if (isRtExtra(f)) emitRtExtra(f, code, vals, owns, prefix) else if (isTlKit(f)) emitTlKit(f, code, vals, owns, prefix) else emitCall3b(f, code, vals, owns, prefix, defs, args, ens, ps, mod)

def isRtExtra(f: String): Bool =
  f == "IO.sleep" || f == "IO.fail" || f == "IO.timeout" || f == "IO.when" || f == "IO.unless" || f == "IO.repeatN" || f == "IO.retryN" || f == "Property.sometimes" || f == "Stream.range"

def emitRtExtra(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "IO.sleep") emitSleep(code, vals, prefix) else if (f == "IO.fail") emitFail(code, vals, owns, prefix) else if (f == "IO.timeout") emitTimeout("sz_io_timeout", code, vals, owns, prefix) else if (f == "IO.when") emitWhen("sz_io_when", code, vals, owns, prefix) else if (f == "IO.unless") emitWhen("sz_io_unless", code, vals, owns, prefix) else if (f == "IO.repeatN") emitTimeout("sz_io_repeat_n", code, vals, owns, prefix) else if (f == "IO.retryN") emitTimeout("sz_io_retry_n", code, vals, owns, prefix) else if (f == "Stream.range") emitRange(code, vals, prefix) else emitSometimes(code, vals, owns, prefix)

def emitSleep(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @sz_io_sleep_ms(i64 ", Str.concat(arg0(vals), ")"))))), pct(prefix, "io"), false)

def emitFail(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitFail2(code, arg0(vals), headOwn(owns), prefix)

def emitFail2(code: String, s: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "cstr"), Str.concat("call ptr @sz_string_cstr(ptr ", Str.concat(s, ")")))), join(line(Str.concat(tmp(prefix, "err"), Str.concat("call ptr @sz_error_new(i32 1, ptr ", Str.concat(pct(prefix, "cstr"), ")")))), join(line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @sz_io_fail(ptr ", Str.concat(pct(prefix, "err"), ")")))), join(relPtr(pct(prefix, "err")), if (o) relPtr(s) else ""))))), pct(prefix, "io"), false)

def emitTimeout(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitTimeout2(rt, code, arg0(vals), arg1(vals), headOwn(tailOwn(owns)), prefix)

def emitTimeout2(rt: String, code: String, ms: String, iv: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(i64 ", Str.concat(ms, Str.concat(", ptr ", Str.concat(iv, ")")))))))), if (o) relPtr(iv) else "")), pct(prefix, "io"), false)

def isTlKit(f: String): Bool =
  f == "Timeline.len" || f == "Timeline.signalInt" || f == "Timeline.signalListLen" || f == "Timeline.signalStrHas" || tlHasRt(f) != "" || tlI64Rt(f) != "" || f == "Verdict.ok" || f == "Verdict.fail" || f == "Verdict.and" || f == "Verdict.or" || f == "Verdict.alwaysHas" || f == "Verdict.afterHit"

def tlHasRt(f: String): String =
  if (f == "Timeline.a11yHas") "sz_timeline_a11y_has" else if (f == "Timeline.lastHitHas") "sz_timeline_last_hit_has" else if (f == "Timeline.driveHas") "sz_timeline_drive_has" else if (f == "Timeline.effectHas") "sz_timeline_effect_has" else if (f == "Timeline.faultKindHas") "sz_timeline_fault_kind_has" else ""

def tlI64Rt(f: String): String =
  if (f == "Timeline.effectCount") "sz_timeline_effect_count" else if (f == "Timeline.fiberLive") "sz_timeline_fiber_live" else if (f == "Timeline.fiberReady") "sz_timeline_fiber_ready" else if (f == "Timeline.fiberParked") "sz_timeline_fiber_parked" else if (f == "Timeline.fiberDone") "sz_timeline_fiber_done" else if (f == "Timeline.faultN") "sz_timeline_fault_n" else if (f == "Timeline.checkpoint") "sz_timeline_checkpoint" else if (f == "Timeline.nearestCheckpoint") "sz_timeline_nearest_checkpoint" else ""

def emitTlKit(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "Timeline.len") emitTlLen(code, vals, prefix) else if (f == "Timeline.signalInt" || f == "Timeline.signalListLen") emitTlSigRt(tlSigRt(f), code, vals, owns, prefix) else if (f == "Timeline.signalStrHas") emitTlStrHas(code, vals, owns, prefix) else if (tlHasRt(f) != "") emitTlHas(tlHasRt(f), code, vals, owns, prefix) else if (tlI64Rt(f) != "") emitTlI64(tlI64Rt(f), code, vals, prefix) else if (f == "Verdict.ok") emitVOk(code, prefix) else if (f == "Verdict.fail") emitVFail(code, vals, prefix) else if (f == "Verdict.and") emitVBin("sz_verdict_and", code, vals, prefix) else if (f == "Verdict.alwaysHas") emitVStr1("sz_verdict_always_has", code, vals, owns, prefix) else if (f == "Verdict.afterHit") emitVStr2("sz_verdict_after_hit", code, vals, owns, prefix) else emitVBin("sz_verdict_or", code, vals, prefix)

def tlSigRt(f: String): String =
  if (f == "Timeline.signalListLen") "sz_timeline_signal_list_len" else "sz_timeline_signal_int"

def emitTlLen(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_timeline_len(ptr ", Str.concat(arg0(vals), ")"))))), pct(prefix, "v"), false)

def emitTlSigRt(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), Str.concat(", ptr ", Str.concat(arg2(vals), ")")))))))))), if (headOwn(tailOwn(tailOwn(owns)))) relPtr(arg2(vals)) else "")), pct(prefix, "v"), false)

def emitTlI64(rt: String, code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), ")"))))))))), pct(prefix, "v"), false)

def emitTlStrHas(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitTlStrHas2(code, arg0(vals), arg1(vals), arg2(vals), arg3(vals), headOwn(tailOwn(tailOwn(owns))), headOwn(tailOwn(tailOwn(tailOwn(owns)))), prefix)

def emitTlStrHas2(code: String, tl: String, i: String, name: String, needle: String, on: Bool, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_timeline_signal_str_has(ptr ", Str.concat(tl, Str.concat(", i64 ", Str.concat(i, Str.concat(", ptr ", Str.concat(name, Str.concat(", ptr ", Str.concat(needle, ")")))))))))), join(if (on) relPtr(name) else "", if (o) relPtr(needle) else ""))), pct(prefix, "v"), false)

def emitVOk(code: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "tl"), "call ptr @sz_verdict_ok()"))), pct(prefix, "tl"), true)

def emitVFail(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "cstr"), Str.concat("call ptr @sz_string_cstr(ptr ", Str.concat(arg1(vals), ")")))), line(Str.concat(tmp(prefix, "tl"), Str.concat("call ptr @sz_verdict_fail(i64 ", Str.concat(arg0(vals), Str.concat(", ptr ", Str.concat(pct(prefix, "cstr"), ")")))))))), pct(prefix, "tl"), true)

def emitTlHas(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitTlHas2(rt, code, arg0(vals), arg1(vals), arg2(vals), headOwn(tailOwn(tailOwn(owns))), prefix)

def emitTlHas2(rt: String, code: String, tl: String, i: String, needle: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(tl, Str.concat(", i64 ", Str.concat(i, Str.concat(", ptr ", Str.concat(needle, ")")))))))))), if (o) relPtr(needle) else "")), pct(prefix, "v"), false)

def emitVBin(rt: String, code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "tl"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(arg0(vals), Str.concat(", ptr ", Str.concat(arg1(vals), ")"))))))))), pct(prefix, "tl"), true)

def emitVStr1(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "tl"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(arg0(vals), Str.concat(", ptr ", Str.concat(arg1(vals), ")")))))))), if (headOwn(tailOwn(owns))) relPtr(arg1(vals)) else "")), pct(prefix, "tl"), true)

def emitVStr2(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "tl"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(arg0(vals), Str.concat(", ptr ", Str.concat(arg1(vals), Str.concat(", ptr ", Str.concat(arg2(vals), ")")))))))))), join(if (headOwn(tailOwn(owns))) relPtr(arg1(vals)) else "", if (headOwn(tailOwn(tailOwn(owns)))) relPtr(arg2(vals)) else ""))), pct(prefix, "tl"), true)

def emitWhen(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitTimeout2(rt, code, arg0(vals), arg1(vals), headOwn(tailOwn(owns)), prefix)

def emitRange(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_stream_range(i64 ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), ")"))))))), pct(prefix, "v"), true)

def emitSometimes(code: String, vals: List[String], owns: List[Bool], _prefix: String): Slot =
  Slot(join(code, join(line(Str.concat("call void @sz_property_sometimes(ptr ", Str.concat(arg0(vals), ")"))), if (headOwn(owns)) relPtr(arg0(vals)) else "")), "null", false)

def emitNetServe(f: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitNetServe2(if (f == "Net.serve") "sz_net_serve" else "sz_net_serve_once", emitExpr(List.at(args, 0), Str.concat(prefix, "_p"), strs, defs, ens, ps, loc), if (List.isEmpty(List.tail(args))) Expr.EUnit else List.at(List.tail(args), 0), prefix, defs, modOfLoc(loc))

def emitNetServe2(rt: String, port: Slot, fn: Expr, prefix: String, defs: List[Fun], mod: String): Slot =
  port match {
    case Slot(pc, pv, po) => Slot(join(pc, join(if (po) relPtr(pv) else "", line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(i64 ", Str.concat(pv, Str.concat(", ptr ", Str.concat(netServePtr(fn, defs, mod), ", ptr null)")))))))))), pct(prefix, "io"), false)
  }

def netServePtr(e: Expr, defs: List[Fun], mod: String): String =
  e match {
    case Expr.ELam(p, _, body) => netServePtrLam(p, body, defs, mod)
    case Expr.EVar(f, _) => funPtr(defs, f, mod)
    case Expr.EMethod(recv, name, _, _) => methodPtr(recv, name)
    case Expr.ECall(f, _, _) => funPtr(defs, f, mod)
    case _ => "null"
  }

def netServePtrLam(p: String, body: Expr, defs: List[Fun], mod: String): String =
  body match {
    case Expr.ECall(f, args, _) => if (etaOne(p, args)) funPtr(defs, f, mod) else "null"
    case Expr.EMethod(recv, name, args, _) => if (etaOne(p, args)) methodPtr(recv, name) else "null"
    case _ => "null"
  }

def etaOne(p: String, args: List[Expr]): Bool =
  !List.isEmpty(args) && List.isEmpty(List.tail(args)) && isVarName(List.at(args, 0), p)

def isVarName(e: Expr, n: String): Bool =
  e match {
    case Expr.EVar(s, _) => s == n
    case _ => false
  }

def funPtr(defs: List[Fun], f: String, mod: String): String =
  funPtr2(findDefPrefer(defs, f, mod), f)

def funPtr2(hit: List[Fun], f: String): String =
  Str.concat("@sz_user_", if (List.isEmpty(hit)) Str.concat("Main_", f) else symOfHit(List.at(hit, 0)))

def symOfHit(d: Fun): String =
  d match {
    case Fun(_, name, _, _, _, _, mod, _) => symOf(mod, name)
  }

def methodPtr(recv: Expr, name: String): String =
  recv match {
    case Expr.EVar(mod, _) => Str.concat("@sz_user_", Str.concat(if (mod == "") "Main" else mod, Str.concat("_", name)))
    case _ => "null"
  }

def isPredKit(f: String): Bool =
  f == "Stream.filter" || f == "Stream.takeWhile" || f == "Stream.dropWhile" || f == "Stream.find" || f == "Stream.exists" || f == "Stream.filterNot" || f == "Stream.forall" || f == "Stream.none" || f == "Stream.findLast" || f == "List.filter" || f == "List.filterNot" || f == "List.takeWhile" || f == "List.dropWhile" || f == "List.partition" || f == "Map.filter" || f == "Set.filter" || f == "List.find" || f == "List.findLast" || f == "List.span" || f == "Verdict.every" || f == "Verdict.any"

def isPredI64(f: String): Bool =
  f == "List.exists" || f == "List.forall" || f == "List.indexWhere" || f == "List.lastIndexWhere" || f == "List.count" || f == "List.prefixLength" || f == "Map.exists" || f == "Map.forall" || f == "Set.exists" || f == "Set.forall" || f == "Timeline.exists"

def isMapKit(f: String): Bool =
  isPredKit(f) || isPredI64(f) || f == "Ref.update" || f == "Ref.updateAndGet" || f == "IO.foreach" || f == "IO.foreachDiscard" || f == "Stream.map" || f == "Stream.evalMap" || f == "Stream.flatMap" || f == "Stream.evalTap" || f == "Stream.mapConcat" || f == "Stream.unfold" || f == "Resource.use" || f == "Resource.make" || f == "List.map" || f == "List.flatMap" || f == "Map.mapValues" || f == "Set.map" || f == "List.groupBy" || f == "List.distinctBy" || f == "List.sortBy" || f == "List.maxBy" || f == "List.minBy" || f == "List.reduceLeft" || f == "List.reduceRight"

def isFoldKit(f: String): Bool =
  f == "Stream.fold" || f == "Stream.scan" || f == "Stream.zipWith" || f == "List.foldLeft" || f == "List.foldRight" || f == "List.scanLeft" || f == "List.scanRight"

def mapKitRt(f: String): String =
  if (f == "Verdict.every") "sz_verdict_every" else if (f == "Verdict.any") "sz_verdict_any" else if (f == "Timeline.exists") "sz_timeline_exists" else if (f == "Ref.update") "sz_ref_update" else if (f == "Ref.updateAndGet") "sz_ref_update_and_get" else if (f == "IO.foreach") "sz_io_foreach" else if (f == "IO.foreachDiscard") "sz_io_foreach_discard" else if (f == "Stream.map") "sz_stream_map" else if (f == "Stream.filter") "sz_stream_filter" else if (f == "Stream.evalMap") "sz_stream_evalmap" else if (f == "Stream.takeWhile") "sz_stream_takewhile" else if (f == "Stream.dropWhile") "sz_stream_dropwhile" else if (f == "Stream.find") "sz_stream_find" else if (f == "Stream.exists") "sz_stream_exists" else if (f == "Stream.flatMap") "sz_stream_flatmap" else if (f == "Stream.evalTap") "sz_stream_evaltap" else if (f == "Stream.filterNot") "sz_stream_filter_not" else if (f == "Stream.forall") "sz_stream_forall" else if (f == "Stream.none") "sz_stream_none" else if (f == "Stream.findLast") "sz_stream_find_last" else if (f == "Stream.mapConcat") "sz_stream_map_concat" else if (f == "Stream.unfold") "sz_stream_unfold" else if (f == "Resource.make") "sz_lang_resource_make" else if (f == "List.map") "sz_list_map" else if (f == "List.flatMap") "sz_list_flat_map" else if (f == "Map.mapValues") "sz_map_map_values" else if (f == "Set.map") "sz_set_map" else if (f == "List.exists") "sz_list_exists" else if (f == "List.forall") "sz_list_forall" else if (f == "List.indexWhere") "sz_list_index_where" else if (f == "List.lastIndexWhere") "sz_list_last_index_where" else if (f == "List.count") "sz_list_count" else if (f == "List.prefixLength") "sz_list_prefix_length" else if (f == "Map.exists") "sz_map_exists" else if (f == "Map.forall") "sz_map_forall" else if (f == "Set.exists") "sz_set_exists" else if (f == "Set.forall") "sz_set_forall" else if (f == "List.filter") "sz_list_filter" else if (f == "List.filterNot") "sz_list_filter_not" else if (f == "List.takeWhile") "sz_list_takewhile" else if (f == "List.dropWhile") "sz_list_dropwhile" else if (f == "List.partition") "sz_list_partition" else if (f == "Map.filter") "sz_map_filter" else if (f == "Set.filter") "sz_set_filter" else if (f == "List.find") "sz_list_find" else if (f == "List.findLast") "sz_list_find_last" else if (f == "List.span") "sz_list_span" else if (f == "List.groupBy") "sz_list_group_by" else if (f == "List.distinctBy") "sz_list_distinct_by" else if (f == "List.sortBy") "sz_list_sort_by" else if (f == "List.maxBy") "sz_list_max_by" else if (f == "List.minBy") "sz_list_max_by_min" else if (f == "List.reduceLeft") "sz_list_reduce_left" else if (f == "List.reduceRight") "sz_list_reduce_right" else "sz_lang_resource_use"

def foldKitRt(f: String): String =
  if (f == "Stream.fold") "sz_stream_fold" else if (f == "Stream.scan") "sz_stream_scan" else if (f == "List.foldLeft") "sz_list_fold_left" else if (f == "List.foldRight") "sz_list_fold_right" else if (f == "List.scanLeft") "sz_list_scan_left" else if (f == "List.scanRight") "sz_list_scan_right" else "sz_stream_zip_with"

def emitMapKit(f: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitMapKitPred(isPredKit(f) || isPredI64(f), mapKitRt(f), args, prefix, strs, defs, ens, ps, loc)

def emitMapKitPred(pred: Bool, rt: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitMapKit2(pred, rt, emitExpr(List.at(args, 0), Str.concat(prefix, "_a0"), strs, defs, ens, ps, loc), if (List.isEmpty(List.tail(args))) Expr.EUnit else List.at(List.tail(args), 0), prefix, strs, defs, ens, ps, loc, mapElemTy(List.at(args, 0), defs, ps))

def isIntElem(e: Expr): Bool =
  e match {
    case Expr.ECall(f, _, _) => f == "List.indices" || f == "List.range"
    case Expr.EMethod(_, name, _, _) => name == "indices" || name == "range"
    case _ => false
  }

def mapElemTy(e: Expr, defs: List[Fun], ps: List[Param]): String =
  if (isIntElem(e)) "Int" else listElemTy(exprRetTy(e, defs, ps))

def listElemTy(ty: String): String =
  if (Str.startsWith(ty, "List[") && Str.len(ty) > 6) Str.slice(ty, 5, Str.len(ty) - 1) else "Any"

def emitMapKit2(pred: Bool, rt: String, inner: Slot, lam: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, elemTy: String): Slot =
  inner match {
    case Slot(ic, iv, io) => emitMapKitPick(pred, rt, ic, iv, io, wrapPh(lam, ps, defs, modOfLoc(loc)), prefix, strs, defs, ens, ps, loc, elemTy)
  }

def emitMapKitPick(pred: Bool, rt: String, ic: String, iv: String, io: Bool, lam: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, elemTy: String): Slot =
  lam match {
    case Expr.EVar(f, _) => if (!pred && isLocalPack(f, ps)) emitMapKitPack(rt, ic, iv, io, f, prefix) else emitMapKit3(pred, rt, ic, iv, io, mapLamBind(lam), mapLamBody(lam), prefix, strs, defs, ens, ps, loc, elemTy)
    case _ => emitMapKit3(pred, rt, ic, iv, io, mapLamBind(lam), mapLamBody(lam), prefix, strs, defs, ens, ps, loc, elemTy)
  }

def isLocalPack(f: String, ps: List[Param]): Bool =
  paramTy(ps, f) != "" && !isI64Ty(paramTy(ps, f))

def emitMapKitPack(rt: String, ic: String, iv: String, io: Bool, f: String, prefix: String): Slot =
  Slot(join(ic, join(unpackFn(f, prefix), join(line(mapPackCall(rt, iv, prefix)), if (io) relPtr(iv) else ""))), pct(prefix, "v"), mapKitOwned(rt))

def mapPackCall(rt: String, iv: String, prefix: String): String =
  Str.concat(tmp(prefix, "v"), Str.concat(mapKitCallMid(rt), Str.concat(iv, Str.concat(", ptr ", Str.concat(pct(prefix, "fnp"), Str.concat(", ptr ", Str.concat(pct(prefix, "envp"), mapKitCallEnd(rt))))))))

def wrapPh(e: Expr, ps: List[Param], defs: List[Fun], mod: String): Expr =
  if (needsPh(e)) Expr.ELam("_ph", "", rewriteHole(e, "_ph")) else etaKit(e, ps, defs, mod)

def etaKit(e: Expr, ps: List[Param], defs: List[Fun], mod: String): Expr =
  e match {
    case Expr.ECall(f, args, _) => if (List.isEmpty(args) && kitEta1(f)) phCall(f) else e
    case Expr.EVar(f, _) => if (etaVar(f, ps, defs, mod)) phCall(f) else e
    case Expr.ENamed(_, inner) => etaKit(inner, ps, defs, mod)
    case Expr.EAscribe(inner, _, _) => etaKit(inner, ps, defs, mod)
    case _ => e
  }

def phCall(f: String): Expr =
  Expr.ELam("_ph", "", Expr.ECall(f, Expr.EVar("_ph", 0) :: noExpr(), 0))

def etaVar(f: String, ps: List[Param], defs: List[Fun], mod: String): Bool =
  if (kitEta1(f)) true else paramTy(ps, f) == "" && etaFun1(findDefPrefer(defs, f, mod))

def etaFun1(hit: List[Fun]): Bool =
  !List.isEmpty(hit) && funArity1(List.at(hit, 0))

def funArity1(d: Fun): Bool =
  d match {
    case Fun(_, _, _, params, _, _, _, _) => List.len(params) == 1
  }

def kitEta1(f: String): Bool =
  f == "Str.fromInt" || f == "Str.toInt" || f == "Float.fromInt" || f == "Float.toInt"

def mapLamBind(e: Expr): String =
  e match {
    case Expr.ELam(p, _, _) => p
    case _ => "_"
  }

def mapLamBody(e: Expr): Expr =
  e match {
    case Expr.ELam(_, _, body) => body
    case _ => e
  }

def emitMapKit3(pred: Bool, rt: String, ic: String, iv: String, io: Bool, bind: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, elemTy: String): Slot =
  emitMapKit4(rt, ic, iv, io, emitNethTy(rt, prefix, bind, body, strs, defs, ens, ps, loc, pred, elemTy), emitPackEnv(ps, Str.concat(prefix, "_e")), prefix)

def emitNethTy(rt: String, prefix: String, bind: String, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, pred: Bool, elemTy: String): String =
  emitNethGoTy(prefix, bind, body, dropParam(ps, bind), strs, defs, ens, loc, pred, mapNethBindTy(rt, bind, body, dropParam(ps, bind), defs, elemTy))

def mapNethBindTy(rt: String, bind: String, body: Expr, rest: List[Param], defs: List[Fun], elemTy: String): String =
  if (nethIdxPred(rt)) "Int" else if (bind == "__tup" || bind == "__p" || bind == "_ph") nethBindTy(bind, body, rest, defs) else if (elemTy != "" && elemTy != "Any") elemTy else nethBindTy(bind, body, rest, defs)

def nethIdxPred(rt: String): Bool =
  rt == "sz_verdict_every" || rt == "sz_verdict_any" || rt == "sz_timeline_exists"

def emitMapKit4(rt: String, ic: String, iv: String, io: Bool, neth: String, env: Slot, prefix: String): Slot =
  env match {
    case Slot(ec, ev, eo) => if (kitBoxLit(iv, io)) emitMapKitBox(rt, ic, iv, neth, ec, ev, eo, prefix) else emitMapKitCall(rt, ic, iv, io, neth, ec, ev, eo, prefix)
  }

def kitBoxLit(v: String, o: Bool): Bool =
  !o && Str.len(v) > 0 && Str.charAt(v, 0) != 37 && v != "null"

def emitMapKitBox(rt: String, ic: String, iv: String, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  Slot(join(neth, join(ic, join(ec, join(line(Str.concat(tmp(prefix, "zb"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(iv, ")")))), join(line(mapKitCall(rt, pct(prefix, "zb"), prefix, ev)), join(relPtr(pct(prefix, "zb")), emitFmRel(ev, eo))))))), pct(prefix, "v"), mapKitOwned(rt))

def emitMapKitCall(rt: String, ic: String, iv: String, io: Bool, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  if (isExtremeRt(rt)) emitMapKitExtreme(rt, ic, iv, io, neth, ec, ev, eo, prefix) else Slot(join(neth, join(ic, join(ec, join(line(mapKitCall(rt, iv, prefix, ev)), join(if (io) relPtr(iv) else "", emitFmRel(ev, eo)))))), pct(prefix, "v"), mapKitOwned(rt))

def isExtremeRt(rt: String): Bool =
  rt == "sz_list_max_by" || rt == "sz_list_max_by_min"

def emitMapKitExtreme(rt: String, ic: String, iv: String, io: Bool, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  Slot(join(neth, join(ic, join(ec, join(line(mapKitCall(rt, iv, prefix, ev)), join(if (io) join(retPtr(pct(prefix, "v")), relPtr(iv)) else "", emitFmRel(ev, eo)))))), pct(prefix, "v"), io)

def mapKitOwned(rt: String): Bool =
  mapKitRet(rt) == "ptr"

def mapKitRet(rt: String): String =
  if (isPredI64Rt(rt)) "i64" else "ptr"

def isPredI64Rt(rt: String): Bool =
  rt == "sz_list_exists" || rt == "sz_list_forall" || rt == "sz_list_index_where" || rt == "sz_list_last_index_where" || rt == "sz_list_count" || rt == "sz_list_prefix_length" || rt == "sz_map_exists" || rt == "sz_map_forall" || rt == "sz_set_exists" || rt == "sz_set_forall" || rt == "sz_timeline_exists"

def mapKitCall(rt: String, iv: String, prefix: String, ev: String): String =
  Str.concat(tmp(prefix, "v"), Str.concat(mapKitCallMid(rt), Str.concat(iv, Str.concat(", ptr @sz_neth_", Str.concat(prefix, Str.concat(", ptr ", Str.concat(ev, mapKitCallEnd(rt))))))))

def mapKitCallMid(rt: String): String =
  Str.concat("call ", Str.concat(mapKitRet(rt), Str.concat(" @", Str.concat(mapKitRtName(rt), "(ptr "))))

def mapKitRtName(rt: String): String =
  if (rt == "sz_list_max_by_min") "sz_list_max_by" else rt

def mapKitCallEnd(rt: String): String =
  if (rt == "sz_set_map" || rt == "sz_list_group_by" || rt == "sz_list_distinct_by") ", i32 0)" else if (rt == "sz_list_max_by") ", i64 1)" else if (rt == "sz_list_max_by_min") ", i64 0)" else ")"

def emitFoldKit(f: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitFoldKit2(foldKitRt(f), List.at(args, 0), List.tail(args), prefix, strs, defs, ens, ps, loc)

def emitFoldKit2(rt: String, a0: Expr, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitFoldKit3(rt, emitExpr(a0, Str.concat(prefix, "_a0"), strs, defs, ens, ps, loc), List.at(rest, 0), List.tail(rest), prefix, strs, defs, ens, ps, loc)

def emitFoldKit3(rt: String, inner: Slot, a1: Expr, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitFoldKit4(rt, inner, emitExpr(a1, Str.concat(prefix, "_z"), strs, defs, ens, ps, loc), List.at(rest, 0), prefix, strs, defs, ens, ps, loc)

def emitFoldKit4(rt: String, inner: Slot, z: Slot, lam: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitFoldKit4b(rt, inner, z, foldLam(lam), prefix, strs, defs, ens, ps, loc)

def foldLam(e: Expr): Expr =
  e match {
    case Expr.ELam(_, _, _) => e
    case Expr.EVar(f, _) => etaFold(f)
    case _ => e
  }

def etaFold(f: String): Expr =
  Expr.ELam("__tup", "", Expr.EMatch(Expr.EVar("__tup", 0), Arm("(a, b)", "", Expr.ECall(f, Expr.EVar("a", 0) :: Expr.EVar("b", 0) :: noExpr(), 0)) :: noArm(), 0))

def emitFoldKit4b(rt: String, inner: Slot, z: Slot, lam: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  inner match {
    case Slot(ic, iv, io) => emitFoldKit5(rt, ic, iv, io, z, mapLamBind(lam), mapLamBody(lam), prefix, strs, defs, ens, ps, loc)
  }

def emitFoldKit5(rt: String, ic: String, iv: String, io: Bool, z: Slot, bind: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitFoldKit6(rt, ic, iv, io, z, emitNeth(prefix, bind, body, strs, defs, ens, ps, loc, false), emitPackEnv(ps, Str.concat(prefix, "_e")), prefix)

def emitFoldKit6(rt: String, ic: String, iv: String, io: Bool, z: Slot, neth: String, env: Slot, prefix: String): Slot =
  z match {
    case Slot(zc, zv, zo) => env match {
  case Slot(ec, ev, eo) => emitFoldKit7(rt, ic, iv, io, zc, zv, zo, neth, ec, ev, eo, prefix)
}
  }

def emitFoldKit7(rt: String, ic: String, iv: String, io: Bool, zc: String, zv: String, zo: Bool, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  emitFoldKit7b(foldBoxZ(zv, zo), rt, ic, iv, io, zc, zv, zo, neth, ec, ev, eo, prefix)

def emitFoldKit7b(boxz: Bool, rt: String, ic: String, iv: String, io: Bool, zc: String, zv: String, zo: Bool, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  emitFoldKit8(boxz && isListFoldRt(rt), if (boxz) emitFoldKitBox(rt, ic, iv, io, zc, zv, neth, ec, ev, eo, prefix) else emitFoldKitCall(rt, ic, iv, io, zc, zv, zo, neth, ec, ev, eo, prefix), prefix)

def foldBoxZ(zv: String, zo: Bool): Bool =
  !zo && zv != "null" && !isPtrSlot(zv, noParam())

def isListFoldRt(rt: String): Bool =
  rt == "sz_list_fold_left" || rt == "sz_list_fold_right"

def emitFoldKit8(unbox: Bool, s: Slot, prefix: String): Slot =
  if (unbox) unboxFold(s, prefix) else s

def unboxFold(s: Slot, prefix: String): Slot =
  s match {
    case Slot(c, v, _) => Slot(join(c, join(line(Str.concat(tmp(prefix, "fu"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(v, ")")))), relPtr(v))), pct(prefix, "fu"), false)
  }

def emitFoldKitBox(rt: String, ic: String, iv: String, io: Bool, zc: String, zv: String, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  Slot(join(neth, join(ic, join(zc, join(ec, join(line(Str.concat(tmp(prefix, "zb"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(zv, ")")))), join(foldCall(rt, iv, pct(prefix, "zb"), prefix, ev), join(if (io) relPtr(iv) else "", join(relPtr(pct(prefix, "zb")), emitFmRel(ev, eo))))))))), pct(prefix, "v"), true)

def emitFoldKitCall(rt: String, ic: String, iv: String, io: Bool, zc: String, zv: String, zo: Bool, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  Slot(join(neth, join(ic, join(zc, join(ec, join(foldCall(rt, iv, zv, prefix, ev), join(if (io) relPtr(iv) else "", join(if (zo) relPtr(zv) else "", emitFmRel(ev, eo)))))))), pct(prefix, "v"), true)

def foldCall(rt: String, a: String, b: String, prefix: String, env: String): String =
  line(Str.concat(tmp(prefix, "v"), foldCall2(rt, a, b, prefix, env)))

def foldCall2(rt: String, a: String, b: String, prefix: String, env: String): String =
  Str.concat("call ptr @", Str.concat(rt, foldCall3(a, b, prefix, env)))

def foldCall3(a: String, b: String, prefix: String, env: String): String =
  Str.concat("(ptr ", Str.concat(a, foldCall4(b, prefix, env)))

def foldCall4(b: String, prefix: String, env: String): String =
  Str.concat(", ptr ", Str.concat(b, foldCall5(prefix, env)))

def foldCall5(prefix: String, env: String): String =
  Str.concat(", ptr @sz_neth_", Str.concat(prefix, foldCall6(env)))

def foldCall6(env: String): String =
  Str.concat(", ptr ", Str.concat(env, ")"))

def emitIterKit(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitIterKit2(List.at(args, 0), List.tail(args), prefix, strs, defs, ens, ps, loc)

def emitIterKit2(z: Expr, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitIterKit3(emitExpr(z, Str.concat(prefix, "_z"), strs, defs, ens, ps, loc), List.at(rest, 0), List.tail(rest), prefix, strs, defs, ens, ps, loc)

def emitIterKit3(zs: Slot, n: Expr, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitIterKit4(zs, emitExpr(n, Str.concat(prefix, "_n"), strs, defs, ens, ps, loc), List.at(rest, 0), prefix, strs, defs, ens, ps, loc)

def emitIterKit4(zs: Slot, ns: Slot, lam: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  zs match {
    case Slot(zc, zv, zo) => emitIterKit5(zc, zv, zo, ns, mapLamBind(lam), mapLamBody(lam), prefix, strs, defs, ens, ps, loc)
  }

def emitIterKit5(zc: String, zv: String, zo: Bool, ns: Slot, bind: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitIterKit6(zc, zv, zo, ns, emitNeth(prefix, bind, body, strs, defs, ens, ps, loc, false), emitPackEnv(ps, Str.concat(prefix, "_e")), prefix)

def emitIterKit6(zc: String, zv: String, zo: Bool, ns: Slot, neth: String, env: Slot, prefix: String): Slot =
  ns match {
    case Slot(nc, nv, _) => env match {
  case Slot(ec, ev, eo) => emitIterKit7(zc, zv, zo, nc, nv, neth, ec, ev, eo, prefix)
}
  }

def emitIterKit7(zc: String, zv: String, zo: Bool, nc: String, nv: String, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  if (kitBoxLit(zv, zo)) emitIterKitBox(zc, zv, nc, nv, neth, ec, ev, eo, prefix) else emitIterKitCall(zc, zv, zo, nc, nv, neth, ec, ev, eo, prefix)

def emitIterKitBox(zc: String, zv: String, nc: String, nv: String, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  Slot(join(neth, join(zc, join(nc, join(ec, join(line(Str.concat(tmp(prefix, "zb"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(zv, ")")))), join(iterCall(pct(prefix, "zb"), nv, prefix, ev), join(relPtr(pct(prefix, "zb")), emitFmRel(ev, eo)))))))), pct(prefix, "v"), true)

def emitIterKitCall(zc: String, zv: String, zo: Bool, nc: String, nv: String, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  Slot(join(neth, join(zc, join(nc, join(ec, join(iterCall(zv, nv, prefix, ev), join(if (zo) relPtr(zv) else "", emitFmRel(ev, eo))))))), pct(prefix, "v"), true)

def iterCall(z: String, n: String, prefix: String, env: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_stream_iterate(ptr ", Str.concat(z, Str.concat(", i64 ", Str.concat(n, Str.concat(", ptr @sz_neth_", Str.concat(prefix, Str.concat(", ptr ", Str.concat(env, ")"))))))))))

def emitTabulate(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitTabulate2(emitExpr(List.at(args, 0), Str.concat(prefix, "_n"), strs, defs, ens, ps, loc), List.at(List.tail(args), 0), prefix, strs, defs, ens, ps, loc)

def emitTabulate2(ns: Slot, lam: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  ns match {
    case Slot(nc, nv, _) => emitTabulate3(nc, nv, mapLamBind(lam), mapLamBody(lam), prefix, strs, defs, ens, ps, loc)
  }

def emitTabulate3(nc: String, nv: String, bind: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitTabulate4(nc, nv, emitNeth(prefix, bind, body, strs, defs, ens, ps, loc, false), emitPackEnv(ps, Str.concat(prefix, "_e")), prefix)

def emitTabulate4(nc: String, nv: String, neth: String, env: Slot, prefix: String): Slot =
  env match {
    case Slot(ec, ev, eo) => Slot(join(neth, join(nc, join(ec, join(line(tabCall(nv, prefix, ev)), emitFmRel(ev, eo))))), pct(prefix, "v"), true)
  }

def tabCall(n: String, prefix: String, env: String): String =
  Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_tabulate(i64 ", Str.concat(n, Str.concat(", ptr @sz_neth_", Str.concat(prefix, Str.concat(", ptr ", Str.concat(env, ")")))))))

def emitSegLen(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitSegLen2(emitExpr(List.at(args, 0), Str.concat(prefix, "_a0"), strs, defs, ens, ps, loc), List.at(List.tail(args), 0), List.at(List.tail(List.tail(args)), 0), prefix, strs, defs, ens, ps, loc)

def emitSegLen2(inner: Slot, lam: Expr, fromE: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  inner match {
    case Slot(ic, iv, io) => emitSegLen3(ic, iv, io, mapLamBind(lam), mapLamBody(lam), emitExpr(fromE, Str.concat(prefix, "_from"), strs, defs, ens, ps, loc), prefix, strs, defs, ens, ps, loc)
  }

def emitSegLen3(ic: String, iv: String, io: Bool, bind: String, body: Expr, fromS: Slot, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitSegLen4(ic, iv, io, emitNeth(prefix, bind, body, strs, defs, ens, ps, loc, true), emitPackEnv(ps, Str.concat(prefix, "_e")), fromS, prefix)

def emitSegLen4(ic: String, iv: String, io: Bool, neth: String, env: Slot, fromS: Slot, prefix: String): Slot =
  env match {
    case Slot(ec, ev, eo) => fromS match {
  case Slot(fc, fv, _) => emitSegLen5(ic, iv, io, neth, ec, ev, eo, fc, fv, prefix)
}
  }

def emitSegLen5(ic: String, iv: String, io: Bool, neth: String, ec: String, ev: String, eo: Bool, fc: String, fv: String, prefix: String): Slot =
  Slot(join(neth, join(ic, join(ec, join(fc, join(line(segCall(iv, prefix, ev, fv)), join(if (io) relPtr(iv) else "", emitFmRel(ev, eo))))))), pct(prefix, "v"), false)

def segCall(iv: String, prefix: String, env: String, from: String): String =
  Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_list_segment_length(ptr ", Str.concat(iv, Str.concat(", ptr @sz_neth_", Str.concat(prefix, Str.concat(", ptr ", Str.concat(env, Str.concat(", i64 ", Str.concat(from, ")")))))))))

def emitNeth(prefix: String, bind: String, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, pred: Bool): String =
  emitNethGo(prefix, bind, body, dropParam(ps, bind), strs, defs, ens, loc, pred)

def emitNethGo(prefix: String, bind: String, body: Expr, rest: List[Param], strs: List[String], defs: List[Fun], ens: List[En], loc: String, pred: Bool): String =
  emitNethGoTy(prefix, bind, body, rest, strs, defs, ens, loc, pred, nethBindTy(bind, body, rest, defs))

def emitNethGoTy(prefix: String, bind: String, body: Expr, rest: List[Param], strs: List[String], defs: List[Fun], ens: List[En], loc: String, pred: Bool, bty: String): String =
  nethWithConts(prefix, body, strs, defs, ens, nethPsTy(bind, bty, rest), loc, emitNeth2(prefix, join(emitUnpack(rest), emitNethBind2(bind, isI64Ty(bty))), emitExpr(body, Str.concat("n", prefix), strs, defs, ens, nethPsTy(bind, bty, rest), loc), loc, strs, pred))

def nethPsTy(bind: String, bty: String, rest: List[Param]): List[Param] =
  if (keepBind(bind)) Param(bind, bty, "", "") :: rest else rest

def nethBindTy(bind: String, body: Expr, rest: List[Param], defs: List[Fun]): String =
  if (bind == "__tup") nethTupTy(body, rest, defs) else if (bind == "_ph") phBindTy(body) else if (bind == "__p") matchLamBindTy(body) else if (nameIntUse(body, bind)) "Int" else "Any"

def nameIntUse(e: Expr, n: String): Bool =
  e match {
    case Expr.ECall(f, args, _) => nameIntCall(f, args, n) || nameIntUseList(args, n)
    case Expr.EMethod(r, name, args, _) => nameIntCall(name, args, n) || nameIntUse(r, n) || nameIntUseList(args, n)
    case Expr.EBin(op, l, r, _) => nameIntUse(l, n) || nameIntUse(r, n)
    case Expr.EUn(_, inner, _) => nameIntUse(inner, n)
    case Expr.EIf(c, t, el, _) => nameIntUse(c, n) || nameIntUse(t, n) || nameIntUse(el, n)
    case Expr.ELam(p, _, body) => if (p == n) false else nameIntUse(body, n)
    case Expr.EMatch(s, arms, _) => nameIntUse(s, n) || nameIntUseArms(arms, n)
    case Expr.EFor(bs, body, _) => nameIntUseBinds(bs, n) || nameIntUse(body, n)
    case Expr.EList(xs) => nameIntUseList(xs, n)
    case Expr.ETuple(xs) => nameIntUseList(xs, n)
    case Expr.ENamed(_, inner) => nameIntUse(inner, n)
    case Expr.EAscribe(inner, _, _) => nameIntUse(inner, n)
    case Expr.EPrint(inner, _) => nameIntUse(inner, n)
    case _ => false
  }

def nameIntCall(f: String, args: List[Expr], n: String): Bool =
  if (f == "List.at" || f == "at" || f == "List.setAt" || f == "setAt" || f == "List.take" || f == "List.drop" || f == "Str.take" || f == "Str.drop") nameIsVarAt(args, 1, n) else false

def nameIsVarAt(args: List[Expr], k: Int, n: String): Bool =
  if (List.len(args) <= k) false else nameIsVar(List.at(args, k), n)

def nameIsVar(e: Expr, n: String): Bool =
  e match {
    case Expr.EVar(s, _) => s == n
    case _ => false
  }

def nameIntUseList(xs: List[Expr], n: String): Bool =
  !List.isEmpty(xs) && (nameIntUse(List.at(xs, 0), n) || nameIntUseList(List.tail(xs), n))

def nameIntUseArms(arms: List[Arm], n: String): Bool =
  if (List.isEmpty(arms)) false else nameIntUseArm(List.at(arms, 0), n) || nameIntUseArms(List.tail(arms), n)

def nameIntUseArm(a: Arm, n: String): Bool =
  a match {
    case Arm(_, _, body) => nameIntUse(body, n)
  }

def nameIntUseBinds(bs: List[Bind], n: String): Bool =
  if (List.isEmpty(bs)) false else nameIntUseBind(List.at(bs, 0), n) || nameIntUseBinds(List.tail(bs), n)

def nameIntUseBind(b: Bind, n: String): Bool =
  b match {
    case Bind(_, _, v) => nameIntUse(v, n)
  }

def matchLamBindTy(e: Expr): String =
  e match {
    case Expr.EMatch(_, arms, _) => if (armsIntScrut(arms)) "Int" else "Any"
    case Expr.ECall(f, args, _) => if (f == "IO.pure" && !List.isEmpty(args)) matchLamBindTy(List.at(args, 0)) else "Any"
    case _ => "Any"
  }

def armsIntScrut(arms: List[Arm]): Bool =
  !List.isEmpty(arms) && armIntScrut(List.at(arms, 0))

def armIntScrut(a: Arm): Bool =
  a match {
    case Arm(pat, _, _) => isIntPat(pat) || isBoolPat(pat) || isOrIntPat(pat)
  }

def isOrIntPat(pat: String): Bool =
  isOrPat(pat) && (isIntPat(orLeft(pat)) || isBoolPat(orLeft(pat)))

def phBindTy(e: Expr): String =
  if (phUsedAsInt(e)) "Int" else "Any"

def phUsedAsInt(e: Expr): Bool =
  e match {
    case Expr.EBin(op, l, r, _) => phBinInt(op, l, r)
    case Expr.EUn(_, _, _) => true
    case Expr.ECall(f, args, _) => phCallInt(f, args)
    case Expr.EMethod(_, name, args, _) => phCallInt(name, args)
    case Expr.ENamed(_, inner) => phUsedAsInt(inner)
    case Expr.EAscribe(inner, _, _) => phUsedAsInt(inner)
    case _ => false
  }

def phBinInt(op: String, l: Expr, r: Expr): Bool =
  if (isCmp(op)) phCmpInt(l, r) else op != "::" && (isPhExpr(l) || isPhExpr(r) || phUsedAsInt(l) || phUsedAsInt(r))

def phCmpInt(l: Expr, r: Expr): Bool =
  !phPtrSide(l) && !phPtrSide(r) && (isPhExpr(l) || isPhExpr(r) || phUsedAsInt(l) || phUsedAsInt(r))

def phPtrSide(e: Expr): Bool =
  e match {
    case Expr.EStr(_, _) => true
    case Expr.EList(_) => true
    case Expr.EUnit => true
    case _ => false
  }

def phCallInt(f: String, args: List[Expr]): Bool =
  if (hasPhArg(args)) phFunArgInt(f) else phUsedAsIntArgs(args)

def phFunArgInt(f: String): Bool =
  f == "fromInt" || f == "Str.fromInt" || f == "Float.fromInt"

def hasPhArg(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (isPhExpr(List.at(xs, 0)) || hasPhArg(List.tail(xs)))

def phUsedAsIntArgs(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (phUsedAsInt(List.at(xs, 0)) || phUsedAsIntArgs(List.tail(xs)))

def isPhExpr(e: Expr): Bool =
  e match {
    case Expr.EHole => true
    case Expr.EVar(s, _) => s == "_ph"
    case _ => false
  }

def nethTupTy(body: Expr, rest: List[Param], defs: List[Fun]): String =
  if (exprIsI64(body, rest, defs)) "(Int, Int)" else "(Any, Any)"

def emitNethBind2(bind: String, i64: Bool): String =
  if (!keepBind(bind)) "" else if (i64) emitNethBindI64(bind) else emitBindAliasPtr(bind)

def emitNethBindI64(bind: String): String =
  line(Str.concat("%", Str.concat(bind, " = call i64 @sz_unbox_i64(ptr %value)")))

def emitNeth2(prefix: String, pre: String, s: Slot, loc: String, strs: List[String], pred: Bool): String =
  s match {
    case Slot(code, val, o) => emitNeth3(prefix, join(pre, code), nethRet(val, o || thenIsPtr(code, val, o, noParam()), prefix, pred), loc, strs, pred)
  }

def nethRet(val: String, o: Bool, prefix: String, pred: Bool): (String, String) =
  if (pred) nethPredRet(val, o, prefix) else nethPtrRet(val, o, prefix)

def nethPredRet(val: String, o: Bool, prefix: String): (String, String) =
  if (o || ioPurePtr(val) || isPtrSlot(val, noParam())) (line(Str.concat(tmp(prefix, "nr"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(val, ")")))), pct(prefix, "nr")) else ("", val)

def nethPtrRet(val: String, o: Bool, prefix: String): (String, String) =
  if (o || val == "null") ("", val) else if (nethIsPtr(val)) (retPtr(val), val) else nethBoxI64(val, prefix)

def nethIsPtr(val: String): Bool =
  ioPurePtr(val) || isPtrSlot(val, noParam()) || val == "%_ph"

def nethBoxI64(val: String, prefix: String): (String, String) =
  (line(Str.concat(tmp(prefix, "nr"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(val, ")")))), pct(prefix, "nr"))

def emitNeth3(prefix: String, code: String, p: (String, String), loc: String, strs: List[String], pred: Bool): String =
  p match {
    case (extra, ret) => emitNeth4(prefix, code, extra, ret, loc, strs, pred)
  }

def emitNeth4(prefix: String, code: String, extra: String, ret: String, loc: String, strs: List[String], pred: Bool): String =
  Str.concat(nethBeg(), Str.concat(nethSig(prefix, pred, loc, strs), Str.concat(code, Str.concat(extra, Str.concat(nethRetLine(ret, pred), nethEnd())))))

def nethBeg(): String =
  Str.concat("NETHB", nl())

def nethEnd(): String =
  Str.concat(nl(), Str.concat("}", Str.concat(nl(), Str.concat("NETHE", nl()))))

def nethEnvSig(prefix: String, loc: String, strs: List[String]): String =
  Str.concat("ptr @sz_neth_", Str.concat(prefix, Str.concat("(ptr %env) {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), panicPush(loc, strs)))))))

def nethMapSig(prefix: String, loc: String, strs: List[String]): String =
  Str.concat("ptr @sz_neth_", Str.concat(prefix, Str.concat("(i64 %n, ptr %env) {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), panicPush(loc, strs)))))))

def emitNethWithSig(prefix: String, pre: String, s: Slot, sig: String): String =
  s match {
    case Slot(code, val, o) => emitNethWithSig2(prefix, join(pre, code), nethPtrRet(val, o, prefix), sig)
  }

def emitNethWithSig2(_prefix: String, code: String, p: (String, String), sig: String): String =
  p match {
    case (extra, ret) => Str.concat(nethBeg(), Str.concat("define internal ", Str.concat(sig, Str.concat(code, Str.concat(extra, Str.concat(nethRetLine(ret, false), nethEnd()))))))
  }

def emitRebuildNeth(prefix: String, bind: String, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): String =
  emitRebuildNeth2(prefix, dropParam(ps, bind), body, strs, defs, ens, loc)

def emitRebuildNeth2(prefix: String, rest: List[Param], body: Expr, strs: List[String], defs: List[Fun], ens: List[En], loc: String): String =
  nethWithConts(prefix, body, strs, defs, ens, rest, loc, emitNethWithSig(prefix, emitUnpack(rest), emitExpr(body, Str.concat("n", prefix), strs, defs, ens, rest, loc), nethEnvSig(prefix, loc, strs)))

def emitMapNeth(prefix: String, bind: String, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): String =
  emitMapNeth2(prefix, bind, dropParam(ps, bind), body, strs, defs, ens, loc)

def emitMapNeth2(prefix: String, bind: String, rest: List[Param], body: Expr, strs: List[String], defs: List[Fun], ens: List[En], loc: String): String =
  nethWithConts(prefix, body, strs, defs, ens, mapNethPs(bind, rest), loc, emitNethWithSig(prefix, join(emitUnpack(rest), mapBindLine(bind)), emitExpr(body, Str.concat("n", prefix), strs, defs, ens, mapNethPs(bind, rest), loc), nethMapSig(prefix, loc, strs)))

def mapBindLine(bind: String): String =
  if (!keepBind(bind) || bind == "n") "" else line(Str.concat("%", Str.concat(bind, " = add i64 %n, 0")))

def mapNethPs(bind: String, rest: List[Param]): List[Param] =
  if (keepBind(bind)) Param(bind, "Int", "", "") :: rest else rest

def emitTapNeth(prefix: String, bind: String, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): String =
  emitTapNeth2(prefix, bind, dropParam(ps, bind), body, strs, defs, ens, loc)

def emitTapNeth2(prefix: String, bind: String, rest: List[Param], body: Expr, strs: List[String], defs: List[Fun], ens: List[En], loc: String): String =
  nethWithConts(prefix, body, strs, defs, ens, tapNethPs(bind, rest), loc, emitTapNeth3(prefix, join(emitUnpack(rest), tapBindLine(bind)), emitExpr(body, Str.concat("n", prefix), strs, defs, ens, tapNethPs(bind, rest), loc), isIoPred(body), loc, strs))

def tapBindLine(bind: String): String =
  if (!keepBind(bind) || bind == "self") "" else line(Str.concat("%", Str.concat(bind, " = bitcast ptr %self to ptr")))

def tapNethPs(bind: String, rest: List[Param]): List[Param] =
  if (keepBind(bind)) Param(bind, "Any", "", "") :: rest else rest

def emitTapNeth3(prefix: String, pre: String, s: Slot, io: Bool, loc: String, strs: List[String]): String =
  s match {
    case Slot(code, val, o) => Str.concat(nethBeg(), Str.concat("define internal void @sz_neth_", Str.concat(prefix, Str.concat("(ptr %self, ptr %env) {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), Str.concat(panicPush(loc, strs), Str.concat(join(pre, join(code, tapFinish(val, o, prefix, io))), Str.concat(panicPop(), Str.concat("  ret void", nethEnd())))))))))))
  }

def tapFinish(val: String, o: Bool, prefix: String, io: Bool): String =
  if (io) join(line(Str.concat(tmp(prefix, "ur"), Str.concat("call ptr @sz_io_unsafe_run_or_die(ptr ", Str.concat(val, ")")))), relPtr(pct(prefix, "ur"))) else if (o) relPtr(val) else ""

def nethWithConts(prefix: String, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, ir: String): String =
  join(nethBeg(), join(stampNethC(stampCont(emitConts(body, strs, defs, ens, ps, loc), prefix), prefix), stampCont(dropNethB(ir), prefix)))

def dropNethB(ir: String): String =
  if (nethBegAt(ir, 0)) Str.slice(ir, 6, Str.len(ir)) else ir

def stampNethC(ir: String, key: String): String =
  stampFrom(ir, "@sz_neth_c", Str.concat("@sz_neth_", Str.concat(key, "_c")))

def emitLam(bind: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String): Slot =
  emitLamWithCopy(bind, body, prefix, strs, defs, ens, ps, loc, copyPs(ps))

def emitLamWithCopy(bind: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], loc: String, ps2: List[Param]): Slot =
  emitLam2(emitNeth(prefix, bind, body, strs, defs, ens, ps, loc, false), emitPackEnv(ps2, Str.concat(prefix, "_e")), prefix)

def emitLam2(neth: String, env: Slot, prefix: String): Slot =
  env match {
    case Slot(ec, ev, eo) => emitLam3(neth, ec, ev, eo, prefix)
  }

def emitLam3(neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  Slot(join(neth, join(ec, emitLamPack(prefix, ev, eo))), pct(prefix, "cl2"), true)

def emitLamPack(prefix: String, ev: String, eo: Bool): String =
  join(lamNil(prefix), join(lamConsEnv(prefix, ev), join(relPtr(pct(prefix, "cl0")), join(lamConsFn(prefix), join(relPtr(pct(prefix, "cl1")), if (eo) relPtr(ev) else "")))))

def lamNil(prefix: String): String =
  line(Str.concat(tmp(prefix, "cl0"), "call ptr @sz_list_nil()"))

def lamConsEnv(prefix: String, ev: String): String =
  line(Str.concat(tmp(prefix, "cl1"), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(ev, Str.concat(", ptr ", Str.concat(pct(prefix, "cl0"), ")"))))))

def lamConsFn(prefix: String): String =
  line(Str.concat(tmp(prefix, "cl2"), Str.concat("call ptr @sz_list_cons(ptr @sz_neth_", Str.concat(prefix, Str.concat(", ptr ", Str.concat(pct(prefix, "cl1"), ")"))))))

def nethSig(prefix: String, pred: Bool, loc: String, strs: List[String]): String =
  Str.concat("define internal ", Str.concat(if (pred) "i64" else "ptr", Str.concat(" @sz_neth_", Str.concat(prefix, nethSig2(loc, strs)))))

def nethSig2(loc: String, strs: List[String]): String =
  Str.concat("(ptr %value, ptr %env) {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), panicPush(loc, strs)))))

def nethRetLine(ret: String, pred: Bool): String =
  Str.concat(panicPop(), Str.concat(if (pred) "  ret i64 " else "  ret ptr ", ret))

def isJsonExtra(f: String): Bool =
  f == "Json.getInt" || f == "Json.getBool" || f == "Json.getStr" || f == "Json.intOr" || f == "Json.set" || f == "Json.setAt" || f == "Json.Int" || f == "Json.Null" || f == "Json.Float" || f == "Json.floatOr" || f == "Json.getFloat" || f == "Json.boolOr" || f == "Json.strOr"

def emitJsonExtra(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "Json.getInt") emitJsonGetI64("sz_json_get_int", code, vals, owns, prefix) else if (f == "Json.getBool") emitJsonGetI64("sz_json_get_bool", code, vals, owns, prefix) else if (f == "Json.getStr") emitJsonGetStr(code, vals, owns, prefix) else if (f == "Json.intOr") emitJsonIntOr(code, vals, owns, prefix) else if (f == "Json.set") emitJsonSet(code, vals, owns, prefix) else if (f == "Json.setAt") emitJsonSetAt(code, vals, owns, prefix) else if (f == "Json.Int") emitJsonInt(code, vals, prefix) else if (f == "Json.Float") emitJsonFloat(code, vals, prefix) else if (f == "Json.floatOr") emitJsonFloatOr(code, vals, owns, prefix) else if (f == "Json.getFloat") emitJsonGetFloat(code, vals, owns, prefix) else if (f == "Json.boolOr") emitJsonBoolOr(code, vals, owns, prefix) else if (f == "Json.strOr") emitJsonStrOr(code, vals, owns, prefix) else emitJsonNull(code, prefix)

def emitJsonFloat(code: String, vals: List[String], prefix: String): Slot =
  emitJsonFloat2(code, arg0(vals), prefix)

def emitJsonFloat2(code: String, n: String, prefix: String): Slot =
  Slot(join(code, join(jsonBoxI64(n, prefix), join(emitAdtNew(prefix, 3, pct(prefix, "ab")), relPtr(pct(prefix, "ab"))))), pct(prefix, "adt"), true)

def emitJsonFloatOr(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitJsonFloatOr2(code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitJsonFloatOr2(code: String, a: String, n: String, oa: Bool, prefix: String): Slot =
  Slot(join(code, join(jsonFloatOrCall(a, n, prefix), if (oa) relPtr(a) else "")), pct(prefix, "v"), false)

def jsonFloatOrCall(a: String, n: String, prefix: String): String =
  join(jsonFloatOrFd(n, prefix), join(jsonFloatOrFr(a, prefix), jsonFloatOrV(prefix)))

def jsonFloatOrFd(n: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "fd"), Str.concat("bitcast i64 ", Str.concat(n, " to double"))))

def jsonFloatOrFr(a: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "fr"), Str.concat("call double @sz_json_float_or(ptr ", Str.concat(a, Str.concat(", double ", Str.concat(pct(prefix, "fd"), ")"))))))

def jsonFloatOrV(prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("bitcast double ", Str.concat(pct(prefix, "fr"), " to i64"))))

def emitJsonGetFloat(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitJsonGetFloat2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitJsonGetFloat2(code: String, a: String, b: String, n: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(jsonGetFloatCall(a, b, n, prefix), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), false)

def jsonGetFloatCall(a: String, b: String, n: String, prefix: String): String =
  join(jsonFloatOrFd(n, prefix), join(jsonGetFloatFr(a, b, prefix), jsonFloatOrV(prefix)))

def jsonGetFloatFr(a: String, b: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "fr"), Str.concat("call double @sz_json_get_float(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, Str.concat(", double ", Str.concat(pct(prefix, "fd"), ")"))))))))

def emitJsonBoolOr(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitJsonBoolOr2(code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitJsonBoolOr2(code: String, a: String, n: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(jsonBoolOrCall(a, n, prefix), if (o) relPtr(a) else "")), pct(prefix, "v"), false)

def jsonBoolOrCall(a: String, n: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_json_bool_or(ptr ", Str.concat(a, Str.concat(", i64 ", Str.concat(n, ")"))))))

def emitJsonStrOr(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitJsonStrOr2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitJsonStrOr2(code: String, a: String, d: String, oa: Bool, od: Bool, prefix: String): Slot =
  Slot(join(code, join(jsonStrOrCall(a, d, prefix), join(if (oa) relPtr(a) else "", if (od) relPtr(d) else ""))), pct(prefix, "v"), true)

def jsonStrOrCall(a: String, d: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_json_str_or(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(d, ")"))))))

def emitJsonGetI64(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitJsonGetI642(rt, code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitJsonGetI642(rt: String, code: String, a: String, b: String, n: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(jsonGetI64Call(rt, a, b, n, prefix), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), false)

def jsonGetI64Call(rt: String, a: String, b: String, n: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, Str.concat(", i64 ", Str.concat(n, ")"))))))))))

def emitJsonGetStr(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitJsonGetStr2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(owns)), headOwn(tailOwn(tailOwn(owns))), prefix)

def emitJsonGetStr2(code: String, a: String, b: String, d: String, oa: Bool, ob: Bool, od: Bool, prefix: String): Slot =
  Slot(join(code, join(jsonGetStrCall(a, b, d, prefix), join(if (oa) relPtr(a) else "", join(if (ob) relPtr(b) else "", if (od) relPtr(d) else "")))), pct(prefix, "v"), true)

def jsonGetStrCall(a: String, b: String, d: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_json_get_str(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, Str.concat(", ptr ", Str.concat(d, ")"))))))))

def emitJsonIntOr(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitJsonIntOr2(code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitJsonIntOr2(code: String, a: String, n: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(jsonIntOrCall(a, n, prefix), if (o) relPtr(a) else "")), pct(prefix, "v"), false)

def jsonIntOrCall(a: String, n: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_json_int_or(ptr ", Str.concat(a, Str.concat(", i64 ", Str.concat(n, ")"))))))

def emitJsonSet(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitJsonSet2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(owns)), headOwn(tailOwn(tailOwn(owns))), prefix)

def emitJsonSet2(code: String, a: String, b: String, v: String, oa: Bool, ob: Bool, ov: Bool, prefix: String): Slot =
  Slot(join(code, join(jsonSetCall(a, b, v, prefix), join(if (oa) relPtr(a) else "", join(if (ob) relPtr(b) else "", if (ov) relPtr(v) else "")))), pct(prefix, "v"), true)

def jsonSetCall(a: String, b: String, v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_json_set(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, Str.concat(", ptr ", Str.concat(v, ")"))))))))

def emitJsonSetAt(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitJsonSetAt2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(tailOwn(owns))), prefix)

def emitJsonSetAt2(code: String, a: String, n: String, v: String, oa: Bool, ov: Bool, prefix: String): Slot =
  Slot(join(code, join(jsonSetAtCall(a, n, v, prefix), join(if (oa) relPtr(a) else "", if (ov) relPtr(v) else ""))), pct(prefix, "v"), true)

def jsonSetAtCall(a: String, n: String, v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_json_set_at(ptr ", Str.concat(a, Str.concat(", i64 ", Str.concat(n, Str.concat(", ptr ", Str.concat(v, ")"))))))))

def emitJsonInt(code: String, vals: List[String], prefix: String): Slot =
  emitJsonInt2(code, arg0(vals), prefix)

def emitJsonInt2(code: String, n: String, prefix: String): Slot =
  Slot(join(code, join(jsonBoxI64(n, prefix), join(emitAdtNew(prefix, 2, pct(prefix, "ab")), relPtr(pct(prefix, "ab"))))), pct(prefix, "adt"), true)

def jsonBoxI64(n: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "ab"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(n, ")"))))

def emitJsonNull(code: String, prefix: String): Slot =
  Slot(join(code, emitAdtNew(prefix, 0, "null")), pct(prefix, "adt"), true)

def emitCall3b(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, defs: List[Fun], args: List[Expr], ens: List[En], ps: List[Param], mod: String): Slot =
  if (isUiKit(f)) emitUiKit(f, code, vals, owns, prefix) else if (f == "List.setAt") emitListSetAt(code, vals, owns, prefix) else if (f == "Str.fromInt") emitFromInt(code, vals, prefix, ps, owns, args) else if (f == "Str.fromBool") emitFromBool(code, vals, prefix) else if (f == "Str.concat") emitConcat(code, vals, owns, prefix) else if (f == "Str.len") emitStrLen(code, vals, owns, prefix) else if (f == "Str.byteLen") emitByteLen(code, vals, owns, prefix) else if (f == "Str.charAt") emitCharAt(code, vals, owns, prefix) else if (f == "Str.slice") emitSlice(code, vals, owns, prefix) else if (f == "Str.byteSlice") emitByteSlice(code, vals, owns, prefix) else if (f == "Str.toInt") emitToInt(code, vals, owns, prefix) else if (f == "Str.repeat") emitRepeat(code, vals, owns, prefix) else if (f == "Str.startsWith") emitStarts(code, vals, owns, prefix) else if (f == "Str.eq") emitStrEq(code, vals, owns, prefix) else if (f == "List.len") emitListLen(code, vals, owns, prefix) else if (f == "List.concat") emitListCat(code, vals, owns, prefix) else if (f == "List.reverse") emitListRev(code, vals, owns, prefix) else if (f == "List.head") emitListHead(code, vals, owns, prefix) else if (f == "List.tail") emitListTail(code, vals, owns, prefix) else if (f == "List.isEmpty") emitListEmpty(code, vals, owns, prefix) else if (f == "List.cons") emitConsCall(code, vals, owns, prefix, args, ps, defs) else if (f == "List.at") emitAt(code, vals, owns, prefix, args, ps) else if (f == "List.join") emitListJoin(code, vals, owns, prefix) else if (kitUnaryPtr(f) != "") emitKitUnaryPtr(kitUnaryPtr(f), code, vals, owns, prefix) else if (kitUnaryI64(f) != "") emitKitUnaryI64(kitUnaryI64(f), code, vals, owns, prefix) else if (kitPtrI64(f) != "") emitKitPtrI64(kitPtrI64(f), code, vals, owns, prefix) else if (kitBinaryPtr(f) != "") emitKitBinaryPtr(kitBinaryPtr(f), code, vals, owns, prefix) else if (kitBinaryI64(f) != "") emitKitBinaryI64(kitBinaryI64(f), code, vals, owns, prefix) else if (f == "Stream.zipAll") emitZipAllKit("sz_stream_zip_all", code, vals, owns, prefix) else if (f == "List.zipAll") emitZipAllKit("sz_list_zip_all", code, vals, owns, prefix) else if (f == "Str.replace") emitStrReplace(code, vals, owns, prefix) else if (f == "Str.padLeft") emitStrPad("sz_string_pad_left", code, vals, owns, prefix) else if (f == "Str.padRight") emitStrPad("sz_string_pad_right", code, vals, owns, prefix) else if (f == "List.empty") emitListNil(code, prefix) else if (f == "Map.empty" || f == "Set.empty") emitMapEmpty(code, prefix) else if (f == "Map.set") emitMapSet(code, vals, owns, prefix) else if (f == "Set.add") emitSetAdd(code, vals, owns, prefix) else if (f == "Map.getOrElse") emitMapGetOr(code, vals, owns, prefix) else if (f == "Clock.monotonic") emitClock("sz_clock_monotonic", code, prefix) else if (f == "Clock.realTime") emitClock("sz_clock_real_time", code, prefix) else if (f == "Queue.unbounded") emitClock("sz_queue_unbounded", code, prefix) else if (f == "Deferred.empty") emitClock("sz_deferred_empty", code, prefix) else if (f == "Fs.mkdirs") emitFsMkdirs(code, vals, owns, prefix) else if (f == "Builder.empty") emitBldNew(code, prefix) else if (f == "Builder.append") emitBldApp(code, vals, owns, prefix) else if (f == "Builder.result") emitBldRes(code, vals, owns, prefix) else if (f == "Fs.read") emitFsRead(code, vals, owns, prefix) else if (f == "Fs.write") emitFsWrite(code, vals, owns, prefix) else if (f == "Fs.list") emitFsList(code, vals, owns, prefix) else if (f == "Fs.canonicalize") emitFsReadRt("sz_fs_canonicalize", code, vals, owns, prefix) else if (f == "Fs.exists") emitFsReadRt("sz_fs_exists", code, vals, owns, prefix) else if (f == "Fs.walk") emitFsReadRt("sz_fs_walk", code, vals, owns, prefix) else if (f == "Fs.delete") emitFsReadRt("sz_fs_delete", code, vals, owns, prefix) else if (f == "Fs.rename") emitFsWriteRt("sz_fs_rename", code, vals, owns, prefix) else if (f == "Net.httpPost") emitFsWriteRt("sz_net_http_post", code, vals, owns, prefix) else if (f == "Net.httpPut") emitFsWriteRt("sz_net_http_put", code, vals, owns, prefix) else if (f == "Net.httpPatch") emitFsWriteRt("sz_net_http_patch", code, vals, owns, prefix) else if (f == "Net.tcpListen") emitSysI64("sz_net_tcp_listen", code, vals, prefix) else if (f == "Net.udpBind") emitSysI64("sz_net_udp_bind", code, vals, prefix) else if (f == "Net.tcpConnect") emitNetPtrI64("sz_net_tcp_connect", code, vals, owns, prefix) else if (f == "Net.tcpRead") emitNetPtrI64("sz_net_tcp_read", code, vals, owns, prefix) else if (f == "Net.udpRecv") emitNetPtrI64("sz_net_udp_recv", code, vals, owns, prefix) else if (f == "Net.tcpWrite") emitFsWriteRt("sz_net_tcp_write", code, vals, owns, prefix) else if (f == "Net.udpSend") emitNetUdpSend(code, vals, owns, prefix) else if (f == "Net.tcpAccept") emitFsReadRt("sz_net_tcp_accept", code, vals, owns, prefix) else if (f == "Net.tcpClose") emitFsReadRt("sz_net_tcp_close", code, vals, owns, prefix) else if (f == "Net.udpClose") emitFsReadRt("sz_net_udp_close", code, vals, owns, prefix) else if (f == "Random.nextInt") emitSysI64("sz_random_next_int", code, vals, prefix) else if (f == "Sys.getenv") emitFsReadRt("sz_sys_getenv", code, vals, owns, prefix) else if (f == "Sys.write") emitFsReadRt("sz_sys_write", code, vals, owns, prefix) else if (f == "Sys.exec") emitFsReadRt("sz_sys_exec", code, vals, owns, prefix) else if (f == "Sys.spawn") emitFsReadRt("sz_sys_spawn", code, vals, owns, prefix) else if (f == "Sys.kill") emitSysI64("sz_sys_kill", code, vals, prefix) else if (f == "Sys.alive") emitSysI64("sz_sys_alive", code, vals, prefix) else if (f == "Sys.childClose") emitSysI64("sz_sys_child_close", code, vals, prefix) else if (f == "Sys.childRead") emitSysI64I64("sz_sys_child_read", code, vals, prefix) else if (f == "Sys.childWrite") emitSysI64Ptr("sz_sys_child_write", code, vals, owns, prefix) else if (f == "Impurity.runKit") emitClock("sz_impurity_run_kit", code, prefix) else if (f == "Sys.args") emitSysArgs(code, prefix) else if (f == "Sys.read") emitSysI64("sz_sys_read", code, vals, prefix) else if (f == "Sys.readLine") emitClock("sz_sys_read_line", code, prefix) else if (f == "IO.pure") emitIoPure(code, vals, owns, prefix, ps) else if (f == "List.range") emitListRange(code, vals, prefix) else if (f == "List.fill") emitListFill(code, vals, owns, prefix) else if (f == "List.getOrElse") emitListGetOr(code, vals, owns, prefix) else if (f == "List.padTo") emitListPadTo(code, vals, owns, prefix) else if (f == "List.max") emitListExtreme("sz_list_max", code, vals, owns, prefix, args, ps, defs) else if (f == "List.min") emitListExtreme("sz_list_min", code, vals, owns, prefix, args, ps, defs) else if (f == "List.sort") emitListAsInt("sz_list_sort", code, vals, owns, prefix, args, ps, defs) else if (f == "List.toSet") emitListToSet(code, vals, owns, prefix, args, ps) else if (f == "List.slice") emitListSlice(code, vals, owns, prefix) else if (f == "List.isDefinedAt") emitKitPtrI64I64("sz_list_is_defined_at", code, vals, owns, prefix) else if (f == "List.lengthCompare") emitKitPtrI64I64("sz_list_length_compare", code, vals, owns, prefix) else if (f == "Map.isEmpty" || f == "Set.isEmpty") emitMapSizePred(code, vals, owns, prefix, "eq") else if (f == "Map.nonEmpty" || f == "Set.nonEmpty") emitMapSizePred(code, vals, owns, prefix, "ne") else if (f == "Float.toInt") emitFloatToInt(code, vals, owns, prefix, ps) else if (f == "Float.fromInt") emitFloatFromInt(code, vals, prefix) else if (f == "Oracle.sumTo") emitOracleSumTo(code, vals, prefix) else if (hasEn(ens, f) || isCtorName(f)) emitRec(f, code, vals, owns, prefix, ens, args, ps, defs) else if (isQualCtor(f, ens)) emitQualCtor(f, code, vals, owns, prefix, ens, ps) else emitUser(f, code, vals, owns, prefix, defs, mod)

def emitUiKit(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "Color.rgb") emitColorRgb(code, vals, prefix) else if (f == "Color.rgba") emitColorRgba(code, vals, prefix) else if (Str.startsWith(f, "Theme.")) emitTheme(f, code, prefix) else if (f == "Ui.run") emitUiRun(code, vals, owns, prefix) else if (Str.startsWith(f, "Ui.")) emitUiSess(f, code, vals, owns, prefix) else if (Str.startsWith(f, "Property.")) emitPropKit(f, code, vals, owns, prefix) else if (Str.startsWith(f, "Signal.")) emitSignalKit(f, code, vals, owns, prefix) else emitViewKit(f, code, vals, owns, prefix)

def emitUiSess(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "Ui.setEditorCaret") emitUiCaret(code, vals, prefix) else if (f == "Ui.editorCaret") emitClock("sz_lang_ui_editor_caret", code, prefix) else if (uiDrop1Rt(f) != "") emitFsReadRt(uiDrop1Rt(f), code, vals, owns, prefix) else emitUiRun(code, vals, owns, prefix)

def uiDrop1Rt(f: String): String =
  if (f == "Ui.setTitle") "sz_lang_ui_set_title" else if (f == "Ui.setEditorDiagnostics") "sz_lang_ui_set_editor_diagnostics" else if (f == "Ui.setEditorTokens") "sz_lang_ui_set_editor_tokens" else if (f == "Ui.setEditorInlays") "sz_lang_ui_set_editor_inlays" else if (f == "Ui.setEditorFolds") "sz_lang_ui_set_editor_folds" else ""

def emitUiCaret(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_ui_set_editor_caret(i64 ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), ")"))))))), pct(prefix, "v"), false)

def emitColorRgb(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_color_rgb(i64 ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), Str.concat(", i64 ", Str.concat(arg2(vals), ")"))))))))), pct(prefix, "v"), false)

def emitColorRgba(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_color_rgba(i64 ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), Str.concat(", i64 ", Str.concat(arg2(vals), Str.concat(", i64 ", Str.concat(arg3(vals), ")"))))))))))), pct(prefix, "v"), false)

def emitTheme(f: String, code: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(themeRt(f), "()"))))), pct(prefix, "v"), false)

def themeRt(f: String): String =
  if (f == "Theme.accent") "sz_theme_accent" else if (f == "Theme.primary") "sz_theme_primary" else if (f == "Theme.muted") "sz_theme_muted" else "sz_theme_foreground"

def emitUiRun(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(unpackFnPtr(arg0(vals), prefix), join(uiRunCall(prefix), if (headOwn(owns)) relPtr(arg0(vals)) else ""))), pct(prefix, "v"), false)

def emitPropCheck(code: String, vals: List[String], owns: List[Bool], _prefix: String): Slot =
  Slot(join(code, join(line(Str.concat("call void @sz_property_check(ptr ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), ")"))))), if (headOwn(owns)) relPtr(arg0(vals)) else "")), arg2(vals), headOwn(tailOwn(tailOwn(owns))))

def emitSignalKit(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "Signal.int") emitSigInt(code, vals, prefix) else if (f == "Signal.intN") emitSigIntN(code, vals, owns, prefix) else if (f == "Signal.get") emitSigGet(code, vals, prefix) else if (f == "Signal.set") emitSigSet(code, vals, prefix) else if (f == "Signal.map") emitSigMap(code, vals, owns, prefix) else if (f == "Signal.str") emitSigPtr1("sz_lang_signal_str", code, vals, owns, prefix) else if (f == "Signal.strN") emitSigPtrN("sz_lang_signal_str", code, vals, owns, prefix) else if (f == "Signal.getStr") emitSigGetStr(code, vals, prefix) else if (f == "Signal.setStr") emitSigSetPtr("sz_lang_signal_str_set", code, vals, owns, prefix) else if (f == "Signal.getList") emitSigGetList(code, vals, prefix) else if (f == "Signal.setList") emitSigSetPtr("sz_lang_signal_list_set", code, vals, owns, prefix) else emitSigInt(code, vals, prefix)

def emitSigInt(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_signal_int(i64 ", Str.concat(arg0(vals), ", ptr null)"))))), pct(prefix, "v"), false)

