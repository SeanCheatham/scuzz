record Slot(code: String, val: String, owned: Bool)

import Parse.Expr
import Parse.Fun
import Parse.Prog
import Parse.En
import Parse.EnCase
import Parse.Arm
import Parse.Param
import Lexer.Tok

def nl(): String =
  """
"""

def line(s: String): String =
  Str.concat("  ", Str.concat(s, nl()))

def pct(prefix: String, stem: String): String =
  Str.concat("%", Str.concat(prefix, Str.concat("_", stem)))

def tmp(prefix: String, stem: String): String =
  Str.concat(pct(prefix, stem), " = ")

def llvmC(s: String): String =
  Str.concat("c\"", Str.concat(_escLl(s, 0, Builder.empty()), "\\00\""))

def _escLl(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else _escLl2(s, i, b, Str.charAt(s, i))

def _escLl2(s: String, i: Int, b: Builder, c: Int): String =
  _escLl(s, i + 1, Builder.append(b, if (c == 34) "\\22" else if (c == 92) "\\\\" else if (c == 10) "\\0A" else Str.slice(s, i, i + 1)))

def strConst(i: Int, s: String): String =
  Str.concat("@.str", Str.concat(Str.fromInt(i), Str.concat(" = private unnamed_addr constant [", Str.concat(Str.fromInt(Str.len(s) + 1), Str.concat(" x i8] ", Str.concat(llvmC(s), ", align 1"))))))

def strIndex(xs: List[String], s: String, i: Int): Int =
  if (List.isEmpty(xs)) i else if (List.head(xs) == s) i else strIndex(List.tail(xs), s, i + 1)

def intern(acc: List[String], s: String): List[String] =
  if (strIndex(acc, s, 0) < List.len(acc)) acc else List.concat(acc, s :: ([]: List[String]))

def collectToks(toks: List[Tok], acc: List[String]): List[String] =
  if (List.isEmpty(toks)) acc else collectTok(List.head(toks), List.tail(toks), acc)

def collectTok(t: Tok, rest: List[Tok], acc: List[String]): List[String] =
  t match {
    case Tok.Str(s) => collectToks(rest, intern(acc, s))
    case _ => collectToks(rest, acc)
  }

def emitConsts(xs: List[String], i: Int): String =
  if (List.isEmpty(xs)) "" else Str.concat(strConst(i, List.head(xs)), Str.concat(nl(), emitConsts(List.tail(xs), i + 1)))

def join(a: String, b: String): String =
  Str.concat(a, b)

def llvmBin(op: String): String =
  if (op == "+") "add" else if (op == "-") "sub" else if (op == "*") "mul" else if (op == "/") "sdiv" else if (op == "%") "srem" else if (op == "&") "and" else if (op == "|") "or" else if (op == "^") "xor" else if (op == "<<") "shl" else if (op == ">>") "ashr" else "add"

def emitExpr(e: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En]): Slot =
  e match {
    case Expr.EInt(n) => Slot("", Str.fromInt(n), false)
    case Expr.EBool(b) => Slot("", if (b) "1" else "0", false)
    case Expr.EVar(s) => Slot("", Str.concat("%", s), false)
    case Expr.EStr(s) => emitStrAs(s, prefix, strs, "s")
    case Expr.EPrint(inner) => emitPrint(inner, prefix, strs, defs, ens)
    case Expr.ECall(f, args) => emitCall(f, args, prefix, strs, defs, ens)
    case Expr.EBin(op, l, r) => emitBin(op, l, r, prefix, strs, defs, ens)
    case Expr.EUn(op, inner) => emitUn(op, inner, prefix, strs, defs, ens)
    case Expr.ENamed(_, inner) => emitExpr(inner, prefix, strs, defs, ens)
    case Expr.EMethod(recv, name, args) => if (name == "flatMap") emitFm(recv, args, prefix, strs, defs, ens) else Slot("", "0", false)
    case Expr.ELam(_, body) => emitExpr(body, prefix, strs, defs, ens)
    case Expr.EIf(c, t, el) => emitIf(c, t, el, prefix, strs, defs, ens)
    case Expr.EField(recv, name) => emitField(recv, name, prefix, ens)
    case Expr.EMatch(s, arms) => emitMatch(s, arms, prefix, strs, defs, ens)
    case Expr.EList(xs) => emitList(xs, prefix, strs, defs, ens)
    case _ => Slot("", "0", false)
  }

def emitStr(s: String, prefix: String, strs: List[String]): Slot =
  emitStrAs(s, prefix, strs, "ss")

def emitStrAs(s: String, prefix: String, strs: List[String], stem: String): Slot =
  emitStr2(prefix, strIndex(strs, s, 0), Str.len(s) + 1, stem)

def emitStr2(prefix: String, idx: Int, len: Int, stem: String): Slot =
  Slot(join(line(Str.concat(tmp(prefix, "gep"), Str.concat("getelementptr inbounds [", Str.concat(Str.fromInt(len), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(idx), ", i64 0, i64 0")))))), line(Str.concat(tmp(prefix, stem), Str.concat("call ptr @sz_string_from_cstr(ptr ", Str.concat(pct(prefix, "gep"), ")"))))), pct(prefix, stem), true)

def emitPrint(inner: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En]): Slot =
  emitPrint2(emitSzString(inner, prefix, strs, defs, ens), prefix)

def emitSzString(inner: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En]): Slot =
  inner match {
    case Expr.EStr(s) => emitStr(s, prefix, strs)
    case _ => emitExpr(inner, Str.concat(prefix, "_e"), strs, defs, ens)
  }

def emitPrint2(s: Slot, prefix: String): Slot =
  Slot(join(s.code, join(line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @sz_io_println(ptr ", Str.concat(s.val, ")")))), if (s.owned) line(Str.concat("call void @sz_release(ptr ", Str.concat(s.val, ")"))) else "")), pct(prefix, "io"), false)

def emitBin(op: String, l: Expr, r: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En]): Slot =
  emitBin2(emitExpr(l, Str.concat(prefix, "_l"), strs, defs, ens), emitExpr(r, Str.concat(prefix, "_r"), strs, defs, ens), op, prefix)

def emitBin2(le: Slot, re: Slot, op: String, prefix: String): Slot =
  if (isCmp(op)) emitCmp(le, re, op, prefix) else Slot(join(le.code, join(re.code, line(Str.concat(tmp(prefix, "v"), Str.concat(llvmBin(op), Str.concat(" i64 ", Str.concat(le.val, Str.concat(", ", re.val)))))))), pct(prefix, "v"), false)

def isCmp(op: String): Bool =
  op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">="

def llvmIcmp(op: String): String =
  if (op == "==") "eq" else if (op == "!=") "ne" else if (op == "<") "slt" else if (op == "<=") "sle" else if (op == ">") "sgt" else "sge"

def emitCmp(le: Slot, re: Slot, op: String, prefix: String): Slot =
  Slot(join(le.code, join(re.code, join(line(Str.concat(tmp(prefix, "cmp"), Str.concat("icmp ", Str.concat(llvmIcmp(op), Str.concat(" i64 ", Str.concat(le.val, Str.concat(", ", re.val))))))), line(Str.concat(tmp(prefix, "v"), Str.concat("zext i1 ", Str.concat(pct(prefix, "cmp"), " to i64"))))))), pct(prefix, "v"), false)

def emitUn(op: String, inner: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En]): Slot =
  emitUn2(emitExpr(inner, Str.concat(prefix, "_u"), strs, defs, ens), op, prefix)

def emitUn2(inner: Slot, op: String, prefix: String): Slot =
  if (op == "-") Slot(join(inner.code, line(Str.concat(tmp(prefix, "v"), Str.concat("sub i64 0, ", inner.val)))), pct(prefix, "v"), false) else inner

def emitList(xs: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En]): Slot =
  emitListAt(xs, prefix, strs, defs, ens, 0)

def emitListAt(xs: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], i: Int): Slot =
  if (List.isEmpty(xs)) Slot(line(Str.concat(tmp(prefix, "0"), "call ptr @sz_list_nil()")), pct(prefix, "0"), true) else emitListCons(List.head(xs), List.tail(xs), prefix, strs, defs, ens, i)

def emitListCons(e: Expr, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], i: Int): Slot =
  emitListCons2(emitListAt(rest, prefix, strs, defs, ens, i + 1), emitExpr(e, Str.concat(prefix, Str.concat("_e", Str.fromInt(i))), strs, defs, ens), prefix, i)

def emitListCons2(tail: Slot, elem: Slot, prefix: String, i: Int): Slot =
  tail match {
    case Slot(tc, tv, _) => emitListCons3(tc, tv, elem, prefix, i)
  }

def emitListCons3(tc: String, tv: String, elem: Slot, prefix: String, i: Int): Slot =
  elem match {
    case Slot(ec, ev, eo) => emitListCons4(join(tc, ec), tv, ev, eo, prefix, i)
  }

def emitListCons4(code: String, tv: String, ev: String, eo: Bool, prefix: String, i: Int): Slot =
  if (eo) emitListConsPtr(code, tv, ev, prefix, i) else emitListConsInt(code, tv, ev, prefix, i)

def emitListConsInt(code: String, tv: String, ev: String, prefix: String, i: Int): Slot =
  Slot(join(code, join(emitBox(prefix, i, ev), join(emitCons(prefix, i, pct(prefix, Str.concat("b", Str.fromInt(i))), tv), join(relPtr(tv), relPtr(pct(prefix, Str.concat("b", Str.fromInt(i)))))))), pct(prefix, Str.fromInt(i + 1)), true)

def emitListConsPtr(code: String, tv: String, ev: String, prefix: String, i: Int): Slot =
  Slot(join(code, join(emitCons(prefix, i, ev, tv), join(relPtr(tv), relPtr(ev)))), pct(prefix, Str.fromInt(i + 1)), true)

def emitBox(prefix: String, i: Int, ev: String): String =
  line(Str.concat(tmp(prefix, Str.concat("b", Str.fromInt(i))), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(ev, ")"))))

def emitCons(prefix: String, i: Int, hd: String, tl: String): String =
  line(Str.concat(tmp(prefix, Str.fromInt(i + 1)), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(hd, Str.concat(", ptr ", Str.concat(tl, ")"))))))

def emitArgList(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], i: Int, code: String, vals: List[String], owns: List[Bool]): (String, List[String], List[Bool]) =
  if (List.isEmpty(args)) (code, List.reverse(vals), List.reverse(owns)) else emitArgList2(emitExpr(List.head(args), Str.concat(prefix, Str.concat("_arg", Str.fromInt(i))), strs, defs, ens), List.tail(args), prefix, strs, defs, ens, i, code, vals, owns)

def emitArgList2(s: Slot, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], i: Int, code: String, vals: List[String], owns: List[Bool]): (String, List[String], List[Bool]) =
  emitArgList(rest, prefix, strs, defs, ens, i + 1, join(code, s.code), s.val :: vals, s.owned :: owns)

def emitCall2(f: String, p: (String, List[String], List[Bool]), prefix: String, defs: List[Fun]): Slot =
  p match {
    case (code, vals, owns) => emitCall3(f, code, vals, owns, prefix, defs)
  }

def emitCall3(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, defs: List[Fun]): Slot =
  if (f == "Str.fromInt") emitFromInt(code, vals, prefix) else if (f == "Str.concat") emitConcat(code, vals, prefix) else if (f == "List.len") emitListLen(code, vals, owns, prefix) else if (f == "List.concat") emitListCat(code, vals, owns, prefix) else if (f == "List.reverse") emitListRev(code, vals, owns, prefix) else emitUser(f, code, vals, owns, prefix, defs)

def emitCall(f: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En]): Slot =
  emitCall2(f, emitArgList(args, prefix, strs, defs, ens, 0, "", []: List[String], []: List[Bool]), prefix, defs)

def emitConcat(code: String, vals: List[String], prefix: String): Slot =
  emitConcat2(code, if (List.isEmpty(vals)) "null" else List.head(vals), if (List.len(vals) < 2) "null" else List.at(vals, 1), prefix)

def emitConcat2(code: String, a: String, b: String, prefix: String): Slot =
  Slot(join(code, join(emitConcatCall(prefix, a, b), emitConcatRel(a, b))), pct(prefix, "v"), true)

def emitConcatCall(prefix: String, a: String, b: String): String =
  line(Str.concat(tmp(prefix, "v"), emitConcatCall2(a, b)))

def emitConcatCall2(a: String, b: String): String =
  Str.concat("call ptr @sz_string_concat(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))

def emitConcatRel(a: String, b: String): String =
  join(relPtr(a), relPtr(b))

def relPtr(p: String): String =
  line(Str.concat("call void @sz_release(ptr ", Str.concat(p, ")")))

def arg0(vals: List[String]): String =
  if (List.isEmpty(vals)) "null" else List.head(vals)

def arg1(vals: List[String]): String =
  if (List.len(vals) < 2) "null" else List.at(vals, 1)

def emitListLen(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListLen2(code, arg0(vals), headOwn(owns), prefix)

def emitListLen2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_list_len(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def emitListCat(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListCat2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitListCat2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(emitListCatCall(prefix, a, b), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), true)

def emitListCatCall(prefix: String, a: String, b: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_concat(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))

def emitListRev(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListRev2(code, arg0(vals), headOwn(owns), prefix)

def emitListRev2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_reverse(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def findDef(funs: List[Fun], name: String): List[Fun] =
  List.filter(funs, f => f.name == name)

def emitUser(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, defs: List[Fun]): Slot =
  emitUser2(f, code, vals, owns, prefix, findDef(defs, f))

def emitUser2(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, hit: List[Fun]): Slot =
  if (List.isEmpty(hit)) Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_user_Main_", Str.concat(f, Str.concat("(", Str.concat(i64Args(vals), ")"))))))), pct(prefix, "v"), false) else emitUser3(f, code, vals, owns, prefix, List.head(hit))

def emitUser3(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, d: Fun): Slot =
  d match {
    case Fun(_, _, _, params, ret, _) => emitUser6(f, code, vals, owns, prefix, params, ret)
  }

def emitUser6(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, params: List[Param], ret: String): Slot =
  emitUser7(f, code, prefix, llvmRet(ret), !isI64Ty(ret), packCall(params, vals, owns))

def emitUser7(f: String, code: String, prefix: String, ty: String, owned: Bool, p: (String, String)): Slot =
  p match {
    case (args, rel) => Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ", Str.concat(ty, Str.concat(" @sz_user_Main_", Str.concat(f, Str.concat("(", Str.concat(args, ")")))))))), rel)), pct(prefix, "v"), owned)
  }

def packCall(ps: List[Param], vals: List[String], owns: List[Bool]): (String, String) =
  if (List.isEmpty(ps) || List.isEmpty(vals)) ("", "") else packCall2(List.head(ps), List.head(vals), headOwn(owns), List.tail(ps), List.tail(vals), tailOwn(owns))

def headOwn(owns: List[Bool]): Bool =
  if (List.isEmpty(owns)) false else List.head(owns)

def tailOwn(owns: List[Bool]): List[Bool] =
  if (List.isEmpty(owns)) owns else List.tail(owns)

def packCall2(p: Param, v: String, o: Bool, ps: List[Param], vals: List[String], owns: List[Bool]): (String, String) =
  packCall3(oneArg(p, v), if (o) relPtr(v) else "", packCall(ps, vals, owns))

def packCall3(arg: String, rel: String, rest: (String, String)): (String, String) =
  rest match {
    case (args, rels) => (if (args == "") arg else Str.concat(arg, Str.concat(", ", args)), join(rel, rels))
  }

def oneArg(p: Param, v: String): String =
  if (isI64Ty(p.ty)) Str.concat("i64 ", v) else Str.concat("ptr ", v)

def lab(s: String): String =
  Str.concat(s, Str.concat(":", nl()))

def emitIf(c: Expr, t: Expr, el: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En]): Slot =
  emitIf2(emitExpr(c, Str.concat(prefix, "_ic"), strs, defs, ens), emitExpr(t, Str.concat(prefix, "_t0"), strs, defs, ens), emitExpr(el, Str.concat(prefix, "_e0"), strs, defs, ens), prefix)

def emitIf2(c: Slot, t: Slot, el: Slot, prefix: String): Slot =
  Slot(join(emitIfHead(c, prefix), join(emitIfArm(t, prefix, "_then_0", "_tj_0"), join(emitIfArm(el, prefix, "_else_0", "_ej_0"), emitIfPhi(t, el, prefix)))), pct(prefix, "phi"), t.owned)

def emitIfHead(c: Slot, prefix: String): String =
  join(c.code, join(emitIfCmp(c, prefix), emitIfBr(prefix)))

def emitIfCmp(c: Slot, prefix: String): String =
  line(Str.concat(tmp(prefix, "cmp"), Str.concat("icmp ne i64 ", Str.concat(c.val, ", 0"))))

def emitIfBr(prefix: String): String =
  line(Str.concat("br i1 ", Str.concat(pct(prefix, "cmp"), Str.concat(", label %", Str.concat(prefix, Str.concat("_then_0, label %", Str.concat(prefix, "_else_0")))))))

def emitIfArm(s: Slot, prefix: String, enter: String, joinLab: String): String =
  join(lab(Str.concat(prefix, enter)), join(s.code, join(emitIfJmp(prefix, joinLab), join(lab(Str.concat(prefix, joinLab)), emitIfJmp(prefix, "_merge_0")))))

def emitIfJmp(prefix: String, dest: String): String =
  line(Str.concat("br label %", Str.concat(prefix, dest)))

def emitIfPhi(t: Slot, el: Slot, prefix: String): String =
  join(lab(Str.concat(prefix, "_merge_0")), line(Str.concat(tmp(prefix, "phi"), emitIfPhi2(t, el, prefix, if (t.owned) "ptr" else "i64"))))

def emitIfPhi2(t: Slot, el: Slot, prefix: String, ty: String): String =
  Str.concat("phi ", Str.concat(ty, Str.concat(" [ ", Str.concat(t.val, Str.concat(", %", Str.concat(prefix, Str.concat("_tj_0 ], [ ", Str.concat(el.val, emitIfPhi3(prefix)))))))))

def emitIfPhi3(prefix: String): String =
  Str.concat(", %", Str.concat(prefix, "_ej_0 ]"))

def emitField(recv: Expr, name: String, prefix: String, ens: List[En]): Slot =
  recv match {
    case Expr.EVar(en) => emitCtor(en, name, prefix, ens)
    case _ => Slot("", "0", false)
  }

def emitCtor(en: String, name: String, prefix: String, ens: List[En]): Slot =
  Slot(line(Str.concat(tmp(prefix, "adt"), Str.concat("call ptr @sz_adt_new(i32 ", Str.concat(Str.fromInt(ctorTag(ens, en, name)), ", ptr null)")))), pct(prefix, "adt"), true)

def ctorTag(ens: List[En], en: String, name: String): Int =
  if (List.isEmpty(ens)) 0 else if (List.head(ens).name == en) caseTag(List.head(ens).cases, name, 0) else ctorTag(List.tail(ens), en, name)

def caseTag(cs: List[EnCase], name: String, i: Int): Int =
  if (List.isEmpty(cs)) 0 else if (List.head(cs).name == name) i else caseTag(List.tail(cs), name, i + 1)

def dotAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 46) i else dotAt(s, i + 1)

def patTag(pat: String, ens: List[En]): Int =
  patTag2(dotAt(pat, 0), pat, ens)

def patTag2(dot: Int, pat: String, ens: List[En]): Int =
  if (dot < 0) 0 else ctorTag(ens, Str.slice(pat, 0, dot), Str.slice(pat, dot + 1, Str.len(pat)))

def emitMatch(s: Expr, arms: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En]): Slot =
  emitMatch1(emitExpr(s, Str.concat(prefix, "_sc"), strs, defs, ens), arms, prefix, strs, defs, ens)

def emitMatch1(se: Slot, arms: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En]): Slot =
  se match {
    case Slot(sc, sv, _) => emitMatch2(sc, emitTries(arms, prefix, sv, ens, 0), emitOks(arms, prefix, strs, defs, ens, 0), prefix)
  }

def emitMatch2(sc: String, tries: String, oks: (String, List[String], Bool), prefix: String): Slot =
  oks match {
    case (okCode, vals, owned) => emitMatch3(sc, tries, okCode, vals, owned, prefix)
  }

def emitMatch3(sc: String, tries: String, okCode: String, vals: List[String], owned: Bool, prefix: String): Slot =
  Slot(join(sc, join(brTry(prefix), join(tries, join(emitDefault(prefix, owned), join(okCode, emitMatchPhi(vals, owned, prefix)))))), pct(prefix, "phi"), owned)

def brTry(prefix: String): String =
  line(Str.concat("br label %", Str.concat(prefix, "_try_0_0")))

def emitDefault(prefix: String, owned: Bool): String =
  if (owned) join(lab(Str.concat(prefix, "_default_0")), line(Str.concat("br label %", Str.concat(prefix, "_merge_0")))) else join(lab(Str.concat(prefix, "_default_0")), join(line(Str.concat(tmp(prefix, "dflt"), "add i64 0, 0")), line(Str.concat("br label %", Str.concat(prefix, "_merge_0")))))

def emitTries(arms: List[Arm], prefix: String, scrut: String, ens: List[En], i: Int): String =
  if (List.isEmpty(arms)) "" else emitTries2(List.head(arms), List.tail(arms), prefix, scrut, ens, i)

def emitTries2(arm: Arm, rest: List[Arm], prefix: String, scrut: String, ens: List[En], i: Int): String =
  if (List.isEmpty(rest)) emitTry1(arm, prefix, scrut, ens, i, true) else join(emitTry1(arm, prefix, scrut, ens, i, false), emitTries(rest, prefix, scrut, ens, i + 1))

def emitTry1(arm: Arm, prefix: String, scrut: String, ens: List[En], i: Int, last: Bool): String =
  join(lab(tryLab(prefix, i)), join(emitTag(prefix, i, scrut, patTag(arm.pat, ens)), join(emitTagBr(prefix, i, last), emitMatched(prefix, i))))

def tryLab(prefix: String, i: Int): String =
  Str.concat(prefix, Str.concat("_try_0_", Str.fromInt(i)))

def nextLab(prefix: String, i: Int, last: Bool): String =
  if (last) Str.concat(prefix, "_default_0") else Str.concat(prefix, Str.concat("_try_0_", Str.fromInt(i + 1)))

def ppre(prefix: String, i: Int): String =
  Str.concat(prefix, Str.concat("_p0_", Str.fromInt(i)))

def sid(i: Int): String =
  Str.fromInt(i + 1)

def emitTag(prefix: String, i: Int, scrut: String, tag: Int): String =
  join(line(Str.concat(tmp(ppre(prefix, i), Str.concat("tg", sid(i))), Str.concat("call i32 @sz_adt_tag(ptr ", Str.concat(scrut, ")")))), line(Str.concat(tmp(ppre(prefix, i), Str.concat("eq", sid(i))), Str.concat("icmp eq i32 ", Str.concat(pct(ppre(prefix, i), Str.concat("tg", sid(i))), Str.concat(", ", Str.fromInt(tag)))))))

def emitTagBr(prefix: String, i: Int, last: Bool): String =
  line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), Str.concat("eq", sid(i))), Str.concat(", label %", Str.concat(ppre(prefix, i), Str.concat("_m", Str.concat(sid(i), Str.concat(", label %", nextLab(prefix, i, last)))))))))

def emitMatched(prefix: String, i: Int): String =
  join(lab(Str.concat(ppre(prefix, i), Str.concat("_m", sid(i)))), line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i))))))

def emitOks(arms: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], i: Int): (String, List[String], Bool) =
  if (List.isEmpty(arms)) ("", []: List[String], true) else emitOks1(emitExpr(List.head(arms).body, Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens), List.tail(arms), prefix, strs, defs, ens, i)

def emitOks1(s: Slot, rest: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], i: Int): (String, List[String], Bool) =
  s match {
    case Slot(code, val, owned) => emitOks2(val, owned, code, emitOks(rest, prefix, strs, defs, ens, i + 1), prefix, i)
  }

def emitOks2(val: String, owned: Bool, code: String, p: (String, List[String], Bool), prefix: String, i: Int): (String, List[String], Bool) =
  p match {
    case (restCode, vals, _) => (join(emitOkBody(code, prefix, i), restCode), val :: vals, owned)
  }

def emitOkBody(code: String, prefix: String, i: Int): String =
  join(lab(Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))), join(code, join(line(Str.concat("br label %", Str.concat(prefix, Str.concat("_aj_0_", Str.fromInt(i))))), join(lab(Str.concat(prefix, Str.concat("_aj_0_", Str.fromInt(i)))), line(Str.concat("br label %", Str.concat(prefix, "_merge_0")))))))

def emitMatchPhi(vals: List[String], owned: Bool, prefix: String): String =
  join(lab(Str.concat(prefix, "_merge_0")), line(Str.concat(tmp(prefix, "phi"), emitMatchPhi2(vals, owned, prefix))))

def emitMatchPhi2(vals: List[String], owned: Bool, prefix: String): String =
  Str.concat("phi ", Str.concat(if (owned) "ptr" else "i64", Str.concat(" ", Str.concat(phiParts(vals, prefix, 0), phiTail(owned, prefix)))))

def phiParts(vals: List[String], prefix: String, i: Int): String =
  if (List.isEmpty(vals)) "" else if (List.len(vals) == 1) phiOne(List.head(vals), prefix, i) else Str.concat(phiOne(List.head(vals), prefix, i), Str.concat(", ", phiParts(List.tail(vals), prefix, i + 1)))

def phiOne(v: String, prefix: String, i: Int): String =
  Str.concat("[ ", Str.concat(v, Str.concat(", %", Str.concat(prefix, Str.concat("_aj_0_", Str.concat(Str.fromInt(i), " ]"))))))

def phiTail(owned: Bool, prefix: String): String =
  if (owned) Str.concat(", [ null, %", Str.concat(prefix, "_default_0 ]")) else Str.concat(", [ ", Str.concat(pct(prefix, "dflt"), Str.concat(", %", Str.concat(prefix, "_default_0 ]"))))

def llvmRet(ret: String): String =
  if (ret == "Int" || ret == "Bool") "i64" else "ptr"

def isI64Ty(t: String): Bool =
  t == "Int" || t == "Bool"

def defParams(d: Fun): String =
  defParams2(d.params)

def defParams2(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) oneParam(List.head(ps)) else Str.concat(oneParam(List.head(ps)), Str.concat(", ", defParams2(List.tail(ps))))

def oneParam(p: Param): String =
  if (isI64Ty(p.ty)) Str.concat("i64 %", p.name) else Str.concat("ptr %", p.name)

def emitDefs(ds: List[Fun], strs: List[String], all: List[Fun], ens: List[En]): String =
  if (List.isEmpty(ds)) "" else Str.concat(emitDef(List.head(ds), strs, all, ens), emitDefs(List.tail(ds), strs, all, ens))

def emitDef2(d: Fun, body: Slot): String =
  emitDef3(llvmRet(d.ret), d.name, defParams(d), body)

def emitDef3(ty: String, name: String, params: String, body: Slot): String =
  Str.concat("define internal ", Str.concat(ty, Str.concat(" @sz_user_Main_", Str.concat(name, emitDefSig(params, ty, body)))))

def emitDefSig(params: String, ty: String, body: Slot): String =
  Str.concat("(", Str.concat(params, Str.concat(") {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), emitDef4(ty, body)))))))

def emitDef4(ty: String, body: Slot): String =
  Str.concat(body.code, Str.concat("  ret ", Str.concat(ty, Str.concat(" ", Str.concat(body.val, Str.concat(nl(), Str.concat("}", Str.concat(nl(), nl()))))))))

def emitFromInt(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_from_int(i64 ", Str.concat(if (List.isEmpty(vals)) "0" else List.head(vals), ")"))))), pct(prefix, "v"), true)

def i64Args(vals: List[String]): String =
  if (List.isEmpty(vals)) "" else if (List.len(vals) == 1) Str.concat("i64 ", List.head(vals)) else Str.concat("i64 ", Str.concat(List.head(vals), Str.concat(", ", i64Args(List.tail(vals)))))

def emitDef(d: Fun, strs: List[String], defs: List[Fun], ens: List[En]): String =
  emitDef2(d, emitExpr(d.body, "body", strs, defs, ens))

def emitMain(body: Expr, strs: List[String], defs: List[Fun], ens: List[En]): String =
  emitMain2(emitExpr(body, "build", strs, defs, ens))

def emitMain2(s: Slot): String =
  Str.concat("define i32 @main(i32 %argc, ptr %argv) {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), Str.concat(s.code, Str.concat("  %rc = call i32 @sz_runtime_main_args(ptr ", Str.concat(s.val, Str.concat(", i32 %argc, ptr %argv)", Str.concat(nl(), Str.concat("  ret i32 %rc", Str.concat(nl(), "}")))))))))))

def emitProg(p: Prog, strs: List[String]): String =
  p match {
    case Prog(_, enums, _, _, _, _, defs, _, body) => emitBits(body, defs, strs, enums)
  }

def emitBits(body: Expr, defs: List[Fun], strs: List[String], ens: List[En]): String =
  Str.concat(emitConsts(strs, 0), Str.concat(if (List.isEmpty(strs)) "" else nl(), Str.concat(emitConts(body, strs, defs, ens), Str.concat(emitDefs(defs, strs, defs, ens), emitMain(body, strs, defs, ens)))))

def fmCount(e: Expr): Int =
  e match {
    case Expr.EMethod(recv, name, args) => if (name == "flatMap") fmCount(recv) + 1 + fmCountArgs(args) else fmCount(recv) + fmCountArgs(args)
    case Expr.EPrint(inner) => fmCount(inner)
    case Expr.ELam(_, body) => fmCount(body)
    case Expr.ECall(_, args) => fmCountArgs(args)
    case Expr.EBin(_, l, r) => fmCount(l) + fmCount(r)
    case Expr.EUn(_, inner) => fmCount(inner)
    case Expr.EIf(c, t, el) => fmCount(c) + fmCount(t) + fmCount(el)
    case Expr.ENamed(_, inner) => fmCount(inner)
    case Expr.EMatch(s, arms) => fmCount(s) + fmCountArms(arms)
    case Expr.EList(xs) => fmCountArgs(xs)
    case _ => 0
  }

def fmCountArms(arms: List[Arm]): Int =
  if (List.isEmpty(arms)) 0 else fmCount(List.head(arms).body) + fmCountArms(List.tail(arms))

def fmCountArgs(xs: List[Expr]): Int =
  if (List.isEmpty(xs)) 0 else fmCount(List.head(xs)) + fmCountArgs(List.tail(xs))

def lamBody(args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EUnit else lamBody1(List.head(args))

def lamBody1(e: Expr): Expr =
  e match {
    case Expr.ELam(_, body) => body
    case _ => e
  }

def emitFm(recv: Expr, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En]): Slot =
  emitFm2(emitExpr(recv, Str.concat(prefix, "_in"), strs, defs, ens), prefix, fmCount(recv) + fmCountArgs(args))

def emitFm2(inner: Slot, prefix: String, id: Int): Slot =
  Slot(join(inner.code, join(line(Str.concat(tmp(prefix, "fm"), Str.concat("call ptr @sz_io_flatmap(ptr ", Str.concat(inner.val, Str.concat(", ptr @sz_cont_", Str.concat(Str.fromInt(id), ", ptr null)")))))), join(line(Str.concat("call void @sz_release(ptr ", Str.concat(inner.val, ")"))), line("call void @sz_release(ptr null)")))), pct(prefix, "fm"), false)

def emitOneCont(id: Int, body: Expr, strs: List[String], defs: List[Fun], ens: List[En]): String =
  emitOneCont2(id, emitExpr(body, Str.concat("c", Str.fromInt(id)), strs, defs, ens))

def emitOneCont2(id: Int, s: Slot): String =
  Str.concat("define internal ptr @sz_cont_", Str.concat(Str.fromInt(id), Str.concat("(ptr %value, ptr %env) {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), Str.concat(s.code, Str.concat("  ret ptr ", Str.concat(s.val, Str.concat(nl(), Str.concat("}", Str.concat(nl(), nl()))))))))))))

def emitConts(e: Expr, strs: List[String], defs: List[Fun], ens: List[En]): String =
  emitContsAt(e, strs, defs, ens, 0)._1

def emitContsAt(e: Expr, strs: List[String], defs: List[Fun], ens: List[En], id: Int): (String, Int) =
  e match {
    case Expr.EMethod(recv, name, args) => if (name == "flatMap") emitContsFm(recv, args, strs, defs, ens, id) else emitContsAt(recv, strs, defs, ens, id)
    case Expr.EPrint(inner) => emitContsAt(inner, strs, defs, ens, id)
    case Expr.ELam(_, body) => emitContsAt(body, strs, defs, ens, id)
    case Expr.ECall(_, args) => emitContsArgs(args, strs, defs, ens, id)
    case Expr.EIf(c, t, el) => emitContsIf(c, t, el, strs, defs, ens, id)
    case Expr.ENamed(_, inner) => emitContsAt(inner, strs, defs, ens, id)
    case Expr.EBin(_, l, r) => emitContsIf(l, r, Expr.EUnit, strs, defs, ens, id)
    case Expr.EUn(_, inner) => emitContsAt(inner, strs, defs, ens, id)
    case Expr.EField(recv, _) => emitContsAt(recv, strs, defs, ens, id)
    case Expr.EMatch(s, arms) => emitContsMatch(s, arms, strs, defs, ens, id)
    case Expr.EList(xs) => emitContsArgs(xs, strs, defs, ens, id)
    case _ => ("", id)
  }

def emitContsMatch(s: Expr, arms: List[Arm], strs: List[String], defs: List[Fun], ens: List[En], id: Int): (String, Int) =
  emitContsMatch2(emitContsAt(s, strs, defs, ens, id), arms, strs, defs, ens)

def emitContsMatch2(p: (String, Int), arms: List[Arm], strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArmList(arms, strs, defs, ens, id))
  }

def emitContsArmList(arms: List[Arm], strs: List[String], defs: List[Fun], ens: List[En], id: Int): (String, Int) =
  if (List.isEmpty(arms)) ("", id) else emitContsArmList2(emitContsAt(List.head(arms).body, strs, defs, ens, id), List.tail(arms), strs, defs, ens)

def emitContsArmList2(p: (String, Int), rest: List[Arm], strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArmList(rest, strs, defs, ens, id))
  }

def emitContsFm(recv: Expr, args: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], id: Int): (String, Int) =
  emitContsFm2(emitContsAt(recv, strs, defs, ens, id), lamBody(args), strs, defs, ens)

def emitContsFm2(p: (String, Int), body: Expr, strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  p match {
    case (code, id) => (join(code, emitOneCont(id, body, strs, defs, ens)), id + 1)
  }

def emitContsArgs(xs: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], id: Int): (String, Int) =
  if (List.isEmpty(xs)) ("", id) else emitContsArgs2(emitContsAt(List.head(xs), strs, defs, ens, id), List.tail(xs), strs, defs, ens)

def emitContsArgs2(p: (String, Int), rest: List[Expr], strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArgs(rest, strs, defs, ens, id))
  }

def emitContsArgs3(code: String, p: (String, Int)): (String, Int) =
  p match {
    case (rest, id) => (join(code, rest), id)
  }

def emitContsIf(c: Expr, t: Expr, el: Expr, strs: List[String], defs: List[Fun], ens: List[En], id: Int): (String, Int) =
  emitContsIf2(emitContsAt(c, strs, defs, ens, id), t, el, strs, defs, ens)

def emitContsIf2(p: (String, Int), t: Expr, el: Expr, strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  p match {
    case (code, id) => emitContsIf3(code, emitContsAt(t, strs, defs, ens, id), el, strs, defs, ens)
  }

def emitContsIf3(code: String, p: (String, Int), el: Expr, strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  p match {
    case (rest, id) => emitContsArgs3(join(code, rest), emitContsAt(el, strs, defs, ens, id))
  }

def emit(src: String): String =
  emitProg(Parse.parse(Lexer.lex(src)), collectToks(Lexer.lex(src), []: List[String]))

def decl(s: String): String =
  Str.concat("declare ", Str.concat(s, nl()))

def preamble(): String =
  Str.concat("; Scuzz Lang generated LLVM IR", Str.concat(nl(), Str.concat(nl(), decls())))

def decls(): String =
  join(declsA(), join(declsB(), nl()))

def declsA(): String =
  join(decl("ptr @sz_string_from_cstr(ptr)"), join(decl("void @sz_retain(ptr)"), join(decl("void @sz_release(ptr)"), join(decl("ptr @sz_string_from_int(i64)"), join(decl("ptr @sz_string_concat(ptr, ptr)"), join(decl("ptr @sz_adt_new(i32, ptr)"), join(decl("i32 @sz_adt_tag(ptr)"), decl("ptr @sz_box_i64(i64)"))))))))

def declsB(): String =
  join(decl("ptr @sz_list_nil()"), join(decl("ptr @sz_list_cons(ptr, ptr)"), join(decl("i64 @sz_list_len(ptr)"), join(decl("ptr @sz_list_concat(ptr, ptr)"), join(decl("ptr @sz_list_reverse(ptr)"), join(decl("ptr @sz_io_println(ptr)"), join(decl("ptr @sz_io_flatmap(ptr, ptr, ptr)"), decl("i32 @sz_runtime_main_args(ptr, i32, ptr)"))))))))

def emitFull(src: String): String =
  Str.concat(preamble(), emit(src))

