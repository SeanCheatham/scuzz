rall" else if (f == "List.filter") "sz_list_filter" else if (f == "List.filterNot") "sz_list_filter_not" else if (f == "List.takeWhile") "sz_list_takewhile" else if (f == "List.dropWhile") "sz_list_dropwhile" else if (f == "List.partition") "sz_list_partition" else if (f == "Map.filter") "sz_map_filter" else if (f == "Set.filter") "sz_set_filter" else if (f == "List.find") "sz_list_find" else if (f == "List.findLast") "sz_list_find_last" else if (f == "List.span") "sz_list_span" else if (f == "List.groupBy") "sz_list_group_by" else if (f == "List.distinctBy") "sz_list_distinct_by" else if (f == "List.sortBy") "sz_list_sort_by" else if (f == "List.maxBy") "sz_list_max_by" else if (f == "List.minBy") "sz_list_max_by_min" else if (f == "List.reduceLeft") "sz_list_reduce_left" else if (f == "List.reduceRight") "sz_list_reduce_right" else "sz_lang_resource_use"

def foldKitRt(f: String): String =
  if (f == "Stream.fold") "sz_stream_fold" else if (f == "Stream.scan") "sz_stream_scan" else if (f == "List.foldLeft") "sz_list_fold_left" else if (f == "List.foldRight") "sz_list_fold_right" else if (f == "List.scanLeft") "sz_list_scan_left" else if (f == "List.scanRight") "sz_list_scan_right" else if (f == "Timeline.fold") "sz_timeline_fold" else "sz_stream_zip_with"

def emitMapKit(f: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitMapKitResult(f, args, emitMapKitPred(isPredKit(f) || isPredI64(f), mapKitRt(f), args, prefix, strs, defs, ens, ps, loc), prefix, defs, ens, ps, loc)

def emitMapKitResult(f: String, args: List[Expr], s: Slot, prefix: String, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if ((f == "List.maxBy" || f == "List.minBy" || f == "List.reduceLeft" || f == "List.reduceRight") && isI64Ty(exprRetTyEns(Expr.ECall(f, args, 0), defs, ens, ps, loc))) emitUnboxSlot(s, prefix) else s

def emitMapKitPred(pred: Bool, rt: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitMapKit2(pred, rt, emitExpr(List.at(args, 0), Str.concat(prefix, "_a0"), strs, defs, ens, ps, loc), if (List.isEmpty(List.tail(args))) Expr.EUnit else List.at(List.tail(args), 0), prefix, strs, defs, ens, ps, loc, if (rt == "sz_stream_unfold") exprRetTyEns(List.at(args, 0), defs, ens, ps, loc) else mapElemTy(List.at(args, 0), defs, ens, ps, loc))

def isIntElem(e: Expr): Bool =
  e match {
    case Expr.ECall(f, _, _) => f == "List.indices" || f == "List.range"
    case Expr.EMethod(_, name, _, _) => name == "indices" || name == "range"
    case _ => false
  }

def mapElemTy(e: Expr, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  if (isIntElem(e)) "Int" else mapElemTyOf(exprRetTyEns(e, defs, ens, ps, loc))

def mapElemTyOf(ty: String): String =
  if (Check.isRes(ty)) Check.resPayload(ty) else if (Check.isIo(ty)) Check.ioPayload(ty) else listElemTy(ty)

def listElemTy(ty: String): String =
  Check.elemOf(ty)

def emitMapKit2(pred: Bool, rt: String, inner: Slot, lam: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, elemTy: String): Slot =
  inner match {
    case Slot(ic, iv, io) => emitMapKitPick(pred, rt, ic, iv, io, wrapPh(lam, ps, defs, modOfLoc(loc)), prefix, strs, defs, ens, ps, loc, elemTy)
  }

def emitMapKitPick(pred: Bool, rt: String, ic: String, iv: String, io: Bool, lam: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, elemTy: String): Slot =
  lam match {
    case Expr.EVar(f, _) => if (!pred && isLocalPack(f, ps)) emitMapKitPack(rt, ic, iv, io, f, prefix) else emitMapKit3(pred, rt, ic, iv, io, mapLamBind(lam), mapLamBody(lam), prefix, strs, defs, ens, ps, loc, elemTy)
    case _ => emitMapKit3(pred, rt, ic, iv, io, mapLamBind(lam), mapLamBody(lam), prefix, strs, defs, ens, ps, loc, elemTy)
  }

def isLocalPack(f: String, ps: List[Param]): Bool =
  paramTy(ps, f) != "" && !isI64Ty(paramTy(ps, f))

def emitMapKitPack(rt: String, ic: String, iv: String, io: Bool, f: String, prefix: String): Slot =
  if (isExtremeRt(rt)) emitMapKitPackExtreme(rt, ic, iv, io, f, prefix) else Slot(join(ic, join(unpackFn(f, prefix), join(line(mapPackCall(rt, iv, prefix)), if (io) relPtr(iv) else ""))), pct(prefix, "v"), mapKitOwned(rt))

def emitMapKitPackExtreme(rt: String, ic: String, iv: String, io: Bool, f: String, prefix: String): Slot =
  Slot(join(ic, join(unpackFn(f, prefix), join(line(mapPackCall(rt, iv, prefix)), if (io) join(retPtr(pct(prefix, "v")), relPtr(iv)) else ""))), pct(prefix, "v"), io)

def mapPackCall(rt: String, iv: String, prefix: String): String =
  Str.concat(tmp(prefix, "v"), Str.concat(mapKitCallMid(rt), Str.concat(iv, Str.concat(", ptr ", Str.concat(pct(prefix, "fnp"), Str.concat(", ptr ", Str.concat(pct(prefix, "envp"), mapKitCallEnd(rt))))))))

def wrapPh(e: Expr, ps: List[Param], defs: Ftab, mod: String): Expr =
  if (needsPh(e)) Expr.ELam("_ph", "", rewriteHole(e, "_ph")) else etaKit(e, ps, defs, mod)

def etaKit(e: Expr, ps: List[Param], defs: Ftab, mod: String): Expr =
  e match {
    case Expr.ECall(f, args, _) => if (List.isEmpty(args) && kitEta1(f)) phCall(f) else e
    case Expr.EVar(f, _) => if (etaVar(f, ps, defs, mod)) phCall(f) else e
    case Expr.ENamed(_, inner) => etaKit(inner, ps, defs, mod)
    case Expr.EAscribe(inner, _, _) => etaKit(inner, ps, defs, mod)
    case _ => e
  }

def phCall(f: String): Expr =
  Expr.ELam("_ph", "", Expr.ECall(f, Expr.EVar("_ph", 0) :: noExpr(), 0))

def etaVar(f: String, ps: List[Param], defs: Ftab, mod: String): Bool =
  if (kitEta1(f)) true else paramTy(ps, f) == "" && etaFun1(findDefPrefer(defs, f, mod))

def etaFun1(hit: List[Fun]): Bool =
  !List.isEmpty(hit) && funArity1(List.at(hit, 0))

def funArity1(d: Fun): Bool =
  d match {
    case Fun(_, _, _, _, params, _, _, _, _) => List.len(params) == 1
  }

def kitEta1(f: String): Bool =
  f == "Str.fromInt" || f == "Str.toInt" || f == "Float.fromInt" || f == "Float.toInt"

def mapLamBind(e: Expr): String =
  e match {
    case Expr.ELam(p, _, _) => p
    case _ => "_"
  }

def mapLamBody(e: Expr): Expr =
  e match {
    case Expr.ELam(_, _, body) => body
    case _ => e
  }

def emitMapKit3(pred: Bool, rt: String, ic: String, iv: String, io: Bool, bind: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, elemTy: String): Slot =
  emitMapKit4(rt, ic, iv, io, emitNethTy(rt, prefix, bind, body, strs, defs, ens, ps, loc, pred, elemTy), emitPackEnv(ps, Str.concat(prefix, "_e")), prefix, elemTy)

def emitNethTy(rt: String, prefix: String, bind: String, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, pred: Bool, elemTy: String): String =
  emitNethGoTy(prefix, bind, body, dropParam(ps, bind), strs, defs, ens, loc, pred, mapNethBindTy(rt, bind, body, dropParam(ps, bind), defs, elemTy))

def mapNethBindTy(rt: String, bind: String, body: Expr, rest: List[Param], defs: Ftab, elemTy: String): String =
  if (nethIdxPred(rt)) "Int" else if (rt == "sz_verdict_step_every" || rt == "sz_verdict_on_hit") "(Int, Int)" else if (rt == "sz_fuzz_driver") "List[String]" else if (rt == "sz_fuzz_verify") "Timeline" else if (rt == "sz_fuzz_verify_rel") "(Timeline, Timeline)" else if ((rt == "sz_list_reduce_left" || rt == "sz_list_reduce_right") && bind == "__tup" && elemTy != "") foldTupTy(elemTy, elemTy) else if (bind == "__tup" || bind == "__p" || bind == "_ph") nethBindTy(bind, body, rest, defs) else if (elemTy != "") elemTy else nethBindTy(bind, body, rest, defs)

def nethIdxPred(rt: String): Bool =
  rt == "sz_verdict_every" || rt == "sz_verdict_any" || rt == "sz_timeline_exists"

def emitMapKit4(rt: String, ic: String, iv: String, io: Bool, neth: String, env: Slot, prefix: String, elemTy: String): Slot =
  env match {
    case Slot(ec, ev, eo) => if (!io && (rt == "sz_stream_unfold" && isI64Ty(elemTy) || kitBoxLit(iv, io))) emitMapKitBox(rt, ic, iv, neth, ec, ev, eo, prefix, elemTy) else emitMapKitCall(rt, ic, iv, io, neth, ec, ev, eo, prefix)
  }

def kitBoxLit(v: String, o: Bool): Bool =
  !o && Str.len(v) > 0 && Str.charAt(v, 0) != 37 && v != "null"

def emitMapKitBox(rt: String, ic: String, iv: String, neth: String, ec: String, ev: String, eo: Bool, prefix: String, elemTy: String): Slot =
  Slot(join(neth, join(ic, join(ec, join(boxScalarStem(iv, elemTy, prefix, "zb"), join(line(mapKitCall(rt, pct(prefix, "zb"), prefix, ev)), join(relPtr(pct(prefix, "zb")), emitFmRel(ev, eo))))))), pct(prefix, "v"), mapKitOwned(rt))

def emitMapKitCall(rt: String, ic: String, iv: String, io: Bool, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  if (isExtremeRt(rt)) emitMapKitExtreme(rt, ic, iv, io, neth, ec, ev, eo, prefix) else Slot(join(neth, join(ic, join(ec, join(line(mapKitCall(rt, iv, prefix, ev)), join(if (io) relPtr(iv) else "", emitFmRel(ev, eo)))))), pct(prefix, "v"), mapKitOwned(rt))

def isExtremeRt(rt: String): Bool =
  rt == "sz_list_max_by" || rt == "sz_list_max_by_min"

def emitMapKitExtreme(rt: String, ic: String, iv: String, io: Bool, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  Slot(join(neth, join(ic, join(ec, join(line(mapKitCall(rt, iv, prefix, ev)), join(if (io) join(retPtr(pct(prefix, "v")), relPtr(iv)) else "", emitFmRel(ev, eo)))))), pct(prefix, "v"), io)

def mapKitOwned(rt: String): Bool =
  mapKitRet(rt) == "ptr"

def mapKitRet(rt: String): String =
  if (isPredI64Rt(rt)) "i64" else "ptr"

def isPredI64Rt(rt: String): Bool =
  rt == "sz_list_exists" || rt == "sz_list_forall" || rt == "sz_list_index_where" || rt == "sz_list_last_index_where" || rt == "sz_list_count" || rt == "sz_list_prefix_length" || rt == "sz_map_exists" || rt == "sz_map_forall" || rt == "sz_set_exists" || rt == "sz_set_forall" || rt == "sz_timeline_exists"

def mapKitCall(rt: String, iv: String, prefix: String, ev: String): String =
  Str.concat(tmp(prefix, "v"), Str.concat(mapKitCallMid(rt), Str.concat(iv, Str.concat(", ptr @sz_neth_", Str.concat(prefix, Str.concat(", ptr ", Str.concat(ev, mapKitCallEnd(rt))))))))

def mapKitCallMid(rt: String): String =
  Str.concat("call ", Str.concat(mapKitRet(rt), Str.concat(" @", Str.concat(mapKitRtName(rt), "(ptr "))))

def mapKitRtName(rt: String): String =
  if (rt == "sz_list_max_by_min") "sz_list_max_by" else rt

def mapKitCallEnd(rt: String): String =
  if (rt == "sz_set_map" || rt == "sz_list_group_by" || rt == "sz_list_distinct_by") ", i32 0)" else if (rt == "sz_list_max_by") ", i64 1)" else if (rt == "sz_list_max_by_min") ", i64 0)" else ")"

def emitFoldKit(f: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitFoldKitResult(f, args, emitFoldKit2(foldKitRt(f), List.at(args, 0), List.tail(args), prefix, strs, defs, ens, ps, loc), prefix, defs, ens, ps, loc)

def emitFoldKitResult(f: String, args: List[Expr], s: Slot, prefix: String, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if ((f == "List.foldLeft" || f == "List.foldRight" || f == "Timeline.fold") && isI64Ty(exprRetTyEns(Expr.ECall(f, args, 0), defs, ens, ps, loc))) emitUnboxSlot(s, prefix) else s

def emitFoldKit2(rt: String, a0: Expr, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitFoldKit3(rt, emitExpr(a0, Str.concat(prefix, "_a0"), strs, defs, ens, ps, loc), List.at(rest, 0), List.tail(rest), prefix, strs, defs, ens, ps, loc, foldPairTy(rt, a0, List.at(rest, 0), defs, ens, ps, loc))

def foldPairTy(rt: String, a0: Expr, z: Expr, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  foldPairTy2(rt, foldElemTy(rt, a0, defs, ens, ps, loc), foldKnownTy(exprRetTyEns(z, defs, ens, ps, loc)))

def foldElemTy(rt: String, a0: Expr, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  if (rt == "sz_timeline_fold") "Int" else if (rt == "sz_stream_zip_with") "" else foldKnownTy(mapElemTy(a0, defs, ens, ps, loc))

def foldKnownTy(ty: String): String =
  if (ty == "" || isTupTy(ty) || isTyParam(ty)) "" else ty

def foldPairTy2(rt: String, elem: String, acc: String): String =
  if (elem == "" || acc == "") "" else if (rt == "sz_list_fold_right" || rt == "sz_list_scan_right") foldTupTy(elem, acc) else foldTupTy(acc, elem)

def foldTupTy(a: String, b: String): String =
  Str.concat("(", Str.concat(a, Str.concat(", ", Str.concat(b, ")"))))

def emitFoldKit3(rt: String, inner: Slot, a1: Expr, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, pty: String): Slot =
  emitFoldKit4(rt, inner, emitFoldSeed(a1, emitExpr(a1, Str.concat(prefix, "_z"), strs, defs, ens, ps, loc), prefix, defs, ens, ps, loc), List.at(rest, 0), prefix, strs, defs, ens, ps, loc, pty)

def emitFoldSeed(e: Expr, s: Slot, prefix: String, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitFoldSeedTy(s, exprRetTyEns(e, defs, ens, ps, loc), prefix)

def emitFoldSeedTy(s: Slot, ty: String, prefix: String): Slot =
  s match {
    case Slot(code, v, o) => if (isI64Ty(ty) && !o) Slot(join(code, boxScalarStem(v, ty, prefix, "zb")), pct(prefix, "zb"), true) else s
  }

def emitFoldKit4(rt: String, inner: Slot, z: Slot, lam: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, pty: String): Slot =
  emitFoldKit4b(rt, inner, z, foldLam(lam), prefix, strs, defs, ens, ps, loc, pty)

def foldLam(e: Expr): Expr =
  e match {
    case Expr.ELam(_, _, _) => e
    case Expr.EVar(f, _) => etaFold(f)
    case _ => e
  }

def etaFold(f: String): Expr =
  Expr.ELam("__tup", "", Expr.EMatch(Expr.EVar("__tup", 0), Arm("(a, b)", "", Expr.ECall(f, Expr.EVar("a", 0) :: Expr.EVar("b", 0) :: noExpr(), 0)) :: noArm(), 0))

def emitFoldKit4b(rt: String, inner: Slot, z: Slot, lam: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, pty: String): Slot =
  inner match {
    case Slot(ic, iv, io) => emitFoldKit5(rt, ic, iv, io, z, mapLamBind(lam), mapLamBody(lam), prefix, strs, defs, ens, ps, loc, pty)
  }

def emitFoldKit5(rt: String, ic: String, iv: String, io: Bool, z: Slot, bind: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, pty: String): Slot =
  emitFoldKit6(rt, ic, iv, io, z, emitFoldNeth(prefix, bind, body, strs, defs, ens, ps, loc, pty), emitPackEnv(ps, Str.concat(prefix, "_e")), prefix)

def emitFoldNeth(prefix: String, bind: String, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, pty: String): String =
  if (bind == "__tup" && pty != "") emitNethGoTy(prefix, bind, body, dropParam(ps, bind), strs, defs, ens, loc, false, pty) else emitNeth(prefix, bind, body, strs, defs, ens, ps, loc, false)

def emitFoldKit6(rt: String, ic: String, iv: String, io: Bool, z: Slot, neth: String, env: Slot, prefix: String): Slot =
  z match {
    case Slot(zc, zv, zo) => env match {
  case Slot(ec, ev, eo) => emitFoldKitCall(rt, ic, iv, io, zc, zv, zo, neth, ec, ev, eo, prefix)
}
  }

def emitFoldKitCall(rt: String, ic: String, iv: String, io: Bool, zc: String, zv: String, zo: Bool, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  Slot(join(neth, join(ic, join(zc, join(ec, join(foldCall(rt, iv, zv, prefix, ev), join(if (io) relPtr(iv) else "", join(if (zo) relPtr(zv) else "", emitFmRel(ev, eo)))))))), pct(prefix, "v"), true)

def foldCall(rt: String, a: String, b: String, prefix: String, env: String): String =
  line(Str.concat(tmp(prefix, "v"), foldCall2(rt, a, b, prefix, env)))

def foldCall2(rt: String, a: String, b: String, prefix: String, env: String): String =
  Str.concat("call ptr @", Str.concat(rt, foldCall3(a, b, prefix, env)))

def foldCall3(a: String, b: String, prefix: String, env: String): String =
  Str.concat("(ptr ", Str.concat(a, foldCall4(b, prefix, env)))

def foldCall4(b: String, prefix: String, env: String): String =
  Str.concat(", ptr ", Str.concat(b, foldCall5(prefix, env)))

def foldCall5(prefix: String, env: String): String =
  Str.concat(", ptr @sz_neth_", Str.concat(prefix, foldCall6(env)))

def foldCall6(env: String): String =
  Str.concat(", ptr ", Str.concat(env, ")"))

def emitIterKit(args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitIterKit2(List.at(args, 0), List.tail(args), prefix, strs, defs, ens, ps, loc)

def emitIterKit2(z: Expr, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitIterKit3(emitExpr(z, Str.concat(prefix, "_z"), strs, defs, ens, ps, loc), List.at(rest, 0), List.tail(rest), prefix, strs, defs, ens, ps, loc, exprRetTyEns(z, defs, ens, ps, loc))

def emitIterKit3(zs: Slot, n: Expr, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, ty: String): Slot =
  emitIterKit4(zs, emitExpr(n, Str.concat(prefix, "_n"), strs, defs, ens, ps, loc), List.at(rest, 0), prefix, strs, defs, ens, ps, loc, ty)

def emitIterKit4(zs: Slot, ns: Slot, lam: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, ty: String): Slot =
  zs match {
    case Slot(zc, zv, zo) => emitIterKit5(zc, zv, zo, ns, mapLamBind(lam), mapLamBody(lam), prefix, strs, defs, ens, ps, loc, ty)
  }

def emitIterKit5(zc: String, zv: String, zo: Bool, ns: Slot, bind: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, ty: String): Slot =
  emitIterKit6(zc, zv, zo, ns, if (ty == "") emitNeth(prefix, bind, body, strs, defs, ens, ps, loc, false) else emitNethGoTy(prefix, bind, body, dropParam(ps, bind), strs, defs, ens, loc, false, ty), emitPackEnv(ps, Str.concat(prefix, "_e")), prefix, ty)

def emitIterKit6(zc: String, zv: String, zo: Bool, ns: Slot, neth: String, env: Slot, prefix: String, ty: String): Slot =
  ns match {
    case Slot(nc, nv, _) => env match {
  case Slot(ec, ev, eo) => emitIterKit7(zc, zv, zo, nc, nv, neth, ec, ev, eo, prefix, ty)
}
  }

def emitIterKit7(zc: String, zv: String, zo: Bool, nc: String, nv: String, neth: String, ec: String, ev: String, eo: Bool, prefix: String, ty: String): Slot =
  if ((isI64Ty(ty) || kitBoxLit(zv, zo)) && !zo) emitIterKitBox(zc, zv, nc, nv, neth, ec, ev, eo, prefix, ty) else emitIterKitCall(zc, zv, zo, nc, nv, neth, ec, ev, eo, prefix)

def emitIterKitBox(zc: String, zv: String, nc: String, nv: String, neth: String, ec: String, ev: String, eo: Bool, prefix: String, ty: String): Slot =
  Slot(join(neth, join(zc, join(nc, join(ec, join(boxScalarStem(zv, ty, prefix, "zb"), join(iterCall(pct(prefix, "zb"), nv, prefix, ev), join(relPtr(pct(prefix, "zb")), emitFmRel(ev, eo)))))))), pct(prefix, "v"), true)

def emitIterKitCall(zc: String, zv: String, zo: Bool, nc: String, nv: String, neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  Slot(join(neth, join(zc, join(nc, join(ec, join(iterCall(zv, nv, prefix, ev), join(if (zo) relPtr(zv) else "", emitFmRel(ev, eo))))))), pct(prefix, "v"), true)

def iterCall(z: String, n: String, prefix: String, env: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_stream_iterate(ptr ", Str.concat(z, Str.concat(", i64 ", Str.concat(n, Str.concat(", ptr @sz_neth_", Str.concat(prefix, Str.concat(", ptr ", Str.concat(env, ")"))))))))))

def emitTabulate(args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitTabulate2(emitExpr(List.at(args, 0), Str.concat(prefix, "_n"), strs, defs, ens, ps, loc), List.at(List.tail(args), 0), prefix, strs, defs, ens, ps, loc)

def emitTabulate2(ns: Slot, lam: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  ns match {
    case Slot(nc, nv, _) => emitTabulate3(nc, nv, mapLamBind(lam), mapLamBody(lam), prefix, strs, defs, ens, ps, loc)
  }

def emitTabulate3(nc: String, nv: String, bind: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitTabulate4(nc, nv, emitNeth(prefix, bind, body, strs, defs, ens, ps, loc, false), emitPackEnv(ps, Str.concat(prefix, "_e")), prefix)

def emitTabulate4(nc: String, nv: String, neth: String, env: Slot, prefix: String): Slot =
  env match {
    case Slot(ec, ev, eo) => Slot(join(neth, join(nc, join(ec, join(line(tabCall(nv, prefix, ev)), emitFmRel(ev, eo))))), pct(prefix, "v"), true)
  }

def tabCall(n: String, prefix: String, env: String): String =
  Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_tabulate(i64 ", Str.concat(n, Str.concat(", ptr @sz_neth_", Str.concat(prefix, Str.concat(", ptr ", Str.concat(env, ")")))))))

def emitSegLen(args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitSegLen2(emitExpr(List.at(args, 0), Str.concat(prefix, "_a0"), strs, defs, ens, ps, loc), List.at(List.tail(args), 0), List.at(List.tail(List.tail(args)), 0), prefix, strs, defs, ens, ps, loc)

def emitSegLen2(inner: Slot, lam: Expr, fromE: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  inner match {
    case Slot(ic, iv, io) => emitSegLen3(ic, iv, io, mapLamBind(lam), mapLamBody(lam), emitExpr(fromE, Str.concat(prefix, "_from"), strs, defs, ens, ps, loc), prefix, strs, defs, ens, ps, loc)
  }

def emitSegLen3(ic: String, iv: String, io: Bool, bind: String, body: Expr, fromS: Slot, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitSegLen4(ic, iv, io, emitNeth(prefix, bind, body, strs, defs, ens, ps, loc, true), emitPackEnv(ps, Str.concat(prefix, "_e")), fromS, prefix)

def emitSegLen4(ic: String, iv: String, io: Bool, neth: String, env: Slot, fromS: Slot, prefix: String): Slot =
  env match {
    case Slot(ec, ev, eo) => fromS match {
  case Slot(fc, fv, _) => emitSegLen5(ic, iv, io, neth, ec, ev, eo, fc, fv, prefix)
}
  }

def emitSegLen5(ic: String, iv: String, io: Bool, neth: String, ec: String, ev: String, eo: Bool, fc: String, fv: String, prefix: String): Slot =
  Slot(join(neth, join(ic, join(ec, join(fc, join(line(segCall(iv, prefix, ev, fv)), join(if (io) relPtr(iv) else "", emitFmRel(ev, eo))))))), pct(prefix, "v"), false)

def segCall(iv: String, prefix: String, env: String, from: String): String =
  Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_list_segment_length(ptr ", Str.concat(iv, Str.concat(", ptr @sz_neth_", Str.concat(prefix, Str.concat(", ptr ", Str.concat(env, Str.concat(", i64 ", Str.concat(from, ")")))))))))

def emitNeth(prefix: String, bind: String, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, pred: Bool): String =
  emitNethGo(prefix, bind, body, dropParam(ps, bind), strs, defs, ens, loc, pred)

def emitNethGo(prefix: String, bind: String, body: Expr, rest: List[Param], strs: Strs, defs: Ftab, ens: List[En], loc: String, pred: Bool): String =
  emitNethGoTy(prefix, bind, body, rest, strs, defs, ens, loc, pred, nethBindTy(bind, body, rest, defs))

def emitNethGoTy(prefix: String, bind: String, body: Expr, rest: List[Param], strs: Strs, defs: Ftab, ens: List[En], loc: String, pred: Bool, bty: String): String =
  nethWithConts(prefix, body, strs, defs, ens, nethPsTy(bind, bty, rest), loc, emitNeth2(prefix, join(emitUnpack(rest), emitNethBind2(bind, isI64Ty(bty))), emitExpr(body, Str.concat("n", prefix), strs, defs, ens, nethPsTy(bind, bty, rest), loc), loc, strs, pred, nethPsTy(bind, bty, rest), exprRetTyEns(body, defs, ens, nethPsTy(bind, bty, rest), loc) == "Float"))

def nethPsTy(bind: String, bty: String, rest: List[Param]): List[Param] =
  if (keepBind(bind)) Param(bind, bty, "", "") :: rest else rest

def nethBindTy(bind: String, body: Expr, rest: List[Param], defs: Ftab): String =
  if (bind == "__tup") nethTupTy(body, rest, defs) else if (bind == "_ph") phBindTy(body) else if (bind == "__p") matchLamBindTy(body) else if (nameIntUse(body, bind)) "Int" else ""

def nameIntUse(e: Expr, n: String): Bool =
  e match {
    case Expr.ECall(f, args, _) => nameIntCall(f, args, n) || nameIntUseList(args, n)
    case Expr.EMethod(r, name, args, _) => nameIntCall(name, args, n) || nameIntUse(r, n) || nameIntUseList(args, n)
    case Expr.EBin(op, l, r, _) => nameIntUse(l, n) || nameIntUse(r, n)
    case Expr.EUn(_, inner, _) => nameIntUse(inner, n)
    case Expr.EIf(c, t, el, _) => nameIntUse(c, n) || nameIntUse(t, n) || nameIntUse(el, n)
    case Expr.ELam(p, _, body) => if (p == n) false else nameIntUse(body, n)
    case Expr.EMatch(s, arms, _) => nameIntUse(s, n) || nameIntUseArms(arms, n)
    case Expr.EFor(bs, body, _) => nameIntUseBinds(bs, n) || nameIntUse(body, n)
    case Expr.EList(xs) => nameIntUseList(xs, n)
    case Expr.ETuple(xs) => nameIntUseList(xs, n)
    case Expr.ENamed(_, inner) => nameIntUse(inner, n)
    case Expr.EAscribe(inner, _, _) => nameIntUse(inner, n)
    case Expr.EPrint(inner, _) => nameIntUse(inner, n)
    case _ => false
  }

def nameIntCall(f: String, args: List[Expr], n: String): Bool =
  if (f == "List.at" || f == "at" || f == "List.setAt" || f == "setAt" || f == "List.take" || f == "List.drop" || f == "Str.take" || f == "Str.drop") nameIsVarAt(args, 1, n) else false

def nameIsVarAt(args: List[Expr], k: Int, n: String): Bool =
  if (List.len(args) <= k) false else nameIsVar(List.at(args, k), n)

def nameIsVar(e: Expr, n: String): Bool =
  e match {
    case Expr.EVar(s, _) => s == n
    case _ => false
  }

def nameIntUseList(xs: List[Expr], n: String): Bool =
  !List.isEmpty(xs) && (nameIntUse(List.at(xs, 0), n) || nameIntUseList(List.tail(xs), n))

def nameIntUseArms(arms: List[Arm], n: String): Bool =
  if (List.isEmpty(arms)) false else nameIntUseArm(List.at(arms, 0), n) || nameIntUseArms(List.tail(arms), n)

def nameIntUseArm(a: Arm, n: String): Bool =
  a match {
    case Arm(_, _, body) => nameIntUse(body, n)
  }

def nameIntUseBinds(bs: List[Bind], n: String): Bool =
  if (List.isEmpty(bs)) false else nameIntUseBind(List.at(bs, 0), n) || nameIntUseBinds(List.tail(bs), n)

def nameIntUseBind(b: Bind, n: String): Bool =
  b match {
    case Bind(_, _, v) => nameIntUse(v, n)
  }

def matchLamBindTy(e: Expr): String =
  e match {
    case Expr.EMatch(_, arms, _) => if (armsIntScrut(arms)) "Int" else ""
    case Expr.ECall(f, args, _) => if (f == "IO.pure" && !List.isEmpty(args)) matchLamBindTy(List.at(args, 0)) else ""
    case _ => ""
  }

def armsIntScrut(arms: List[Arm]): Bool =
  !List.isEmpty(arms) && armIntScrut(List.at(arms, 0))

def armIntScrut(a: Arm): Bool =
  a match {
    case Arm(pat, _, _) => isIntPat(pat) || isBoolPat(pat) || isOrIntPat(pat)
  }

def isOrIntPat(pat: String): Bool =
  isOrPat(pat) && (isIntPat(orLeft(pat)) || isBoolPat(orLeft(pat)))

def phBindTy(e: Expr): String =
  if (phUsedAsInt(e)) "Int" else ""

def phUsedAsInt(e: Expr): Bool =
  e match {
    case Expr.EBin(op, l, r, _) => phBinInt(op, l, r)
    case Expr.EUn(_, _, _) => true
    case Expr.ECall(f, args, _) => phCallInt(f, args)
    case Expr.EMethod(_, name, args, _) => phCallInt(name, args)
    case Expr.ENamed(_, inner) => phUsedAsInt(inner)
    case Expr.EAscribe(inner, _, _) => phUsedAsInt(inner)
    case _ => false
  }

def phBinInt(op: String, l: Expr, r: Expr): Bool =
  if (isCmp(op)) phCmpInt(l, r) else op != "::" && (isPhExpr(l) || isPhExpr(r) || phUsedAsInt(l) || phUsedAsInt(r))

def phCmpInt(l: Expr, r: Expr): Bool =
  !phPtrSide(l) && !phPtrSide(r) && (isPhExpr(l) || isPhExpr(r) || phUsedAsInt(l) || phUsedAsInt(r))

def phPtrSide(e: Expr): Bool =
  e match {
    case Expr.EStr(_, _) => true
    case Expr.EList(_) => true
    case Expr.EUnit => true
    case _ => false
  }

def phCallInt(f: String, args: List[Expr]): Bool =
  if (hasPhArg(args)) phFunArgInt(f) else phUsedAsIntArgs(args)

def phFunArgInt(f: String): Bool =
  f == "fromInt" || f == "Str.fromInt" || f == "Float.fromInt"

def hasPhArg(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (isPhExpr(List.at(xs, 0)) || hasPhArg(List.tail(xs)))

def phUsedAsIntArgs(xs: List[Expr]): Bool =
  !List.isEmpty(xs) && (phUsedAsInt(List.at(xs, 0)) || phUsedAsIntArgs(List.tail(xs)))

def isPhExpr(e: Expr): Bool =
  e match {
    case Expr.EHole => true
    case Expr.EVar(s, _) => s == "_ph"
    case _ => false
  }

def nethTupTy(body: Expr, rest: List[Param], defs: Ftab): String =
  if (exprIsI64(body, rest, defs)) "(Int, Int)" else "(Any, Any)"

def emitNethBind2(bind: String, i64: Bool): String =
  if (!keepBind(bind)) "" else if (i64) emitNethBindI64(bind) else emitBindAliasPtr(bind)

def emitNethBindI64(bind: String): String =
  line(Str.concat("%", Str.concat(bind, " = call i64 @sz_unbox_i64(ptr %.closure.value)")))

def emitNeth2(prefix: String, pre: String, s: Slot, loc: String, strs: Strs, pred: Bool, ps: List[Param], isFloat: Bool): String =
  s match {
    case Slot(code, val, o) => emitNeth3(prefix, join(pre, code), if (isI64ParamVal(val, ps)) if (pred) ("", val) else nethBoxI64(val, prefix, isFloat) else if (isPtrParam(val, ps)) if (pred) nethPredRet(val, true, prefix) else if (o) ("", val) else (retPtr(val), val) else if (!pred && !o && thenIsPtr(code, val, false, ps)) (retPtr(val), val) else nethRet(val, o || thenIsPtr(code, val, o, noParam()), prefix, pred, isFloat), loc, strs, pred)
  }

def nethRet(val: String, o: Bool, prefix: String, pred: Bool, isFloat: Bool): (String, String) =
  if (pred) nethPredRet(val, o, prefix) else nethPtrRet(val, o, prefix, isFloat)

def nethPredRet(val: String, o: Bool, prefix: String): (String, String) =
  if (o || ioPurePtr(val) || isPtrSlot(val, noParam())) (line(Str.concat(tmp(prefix, "nr"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(val, ")")))), pct(prefix, "nr")) else ("", val)

def nethPtrRet(val: String, o: Bool, prefix: String, isFloat: Bool): (String, String) =
  if (o || val == "null") ("", val) else if (nethIsPtr(val)) (retPtr(val), val) else nethBoxI64(val, prefix, isFloat)

def nethIsPtr(val: String): Bool =
  ioPurePtr(val) || isPtrSlot(val, noParam()) || val == "%_ph"

def nethBoxI64(val: String, prefix: String, isFloat: Bool): (String, String) =
  (line(Str.concat(tmp(prefix, "nr"), Str.concat("call ptr @", Str.concat(if (isFloat) "sz_box_float_bits" else "sz_box_i64", Str.concat("(i64 ", Str.concat(val, ")")))))), pct(prefix, "nr"))

def emitNeth3(prefix: String, code: String, p: (String, String), loc: String, strs: Strs, pred: Bool): String =
  p match {
    case (extra, ret) => emitNeth4(prefix, code, extra, ret, loc, strs, pred)
  }

def emitNeth4(prefix: String, code: String, extra: String, ret: String, loc: String, strs: Strs, pred: Bool): String =
  Str.concat(nethBeg(), Str.concat(nethSig(prefix, pred, loc, strs), Str.concat(code, Str.concat(extra, Str.concat(nethRetLine(ret, pred), nethEnd())))))

def nethBeg(): String =
  Str.concat("NETHB", nl())

def nethEnd(): String =
  Str.concat(nl(), Str.concat("}", Str.concat(nl(), Str.concat("NETHE", nl()))))

def nethEnvSig(prefix: String, loc: String, strs: Strs): String =
  Str.concat("ptr @sz_neth_", Str.concat(prefix, Str.concat("(ptr %.closure.env) {", Str.concat(nl(), Str.concat(".entry:", Str.concat(nl(), panicPush(loc, strs)))))))

def emitNethWithSig(prefix: String, pre: String, s: Slot, sig: String): String =
  s match {
    case Slot(code, val, o) => emitNethWithSig2(prefix, join(pre, code), nethPtrRet(val, o, prefix, false), sig)
  }

def emitNethWithSig2(_prefix: String, code: String, p: (String, String), sig: String): String =
  p match {
    case (extra, ret) => Str.concat(nethBeg(), Str.concat("define internal ", Str.concat(sig, Str.concat(code, Str.concat(extra, Str.concat(nethRetLine(ret, false), nethEnd()))))))
  }

def emitRebuildNeth(prefix: String, bind: String, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  emitRebuildNeth2(prefix, dropParam(ps, bind), body, strs, defs, ens, loc)

def emitRebuildNeth2(prefix: String, rest: List[Param], body: Expr, strs: Strs, defs: Ftab, ens: List[En], loc: String): String =
  join(emitCaptureSchema(prefix, rest, ens), nethWithConts(prefix, body, strs, defs, ens, rest, loc, emitNethWithSig(prefix, emitUnpack(rest), emitExpr(body, Str.concat("n", prefix), strs, defs, ens, rest, loc), nethEnvSig(prefix, loc, strs))))

def captureSchema(ps: List[Param], ens: List[En]): String =
  Hash.sha256(Str.concat(List.join(List.map(ps, p => Str.concat(p.name, Str.concat(":", p.ty))), ";"), Str.concat("|", Parse.prettyEnums(ens))))

def emitCaptureSchema(prefix: String, ps: List[Param], ens: List[En]): String =
  Str.concat(nethBeg(), Str.concat("@sz_neth_", Str.concat(prefix, Str.concat("_capture = private constant [65 x i8] c\"", Str.concat(captureSchema(ps, ens), Str.concat("\\00\"", Str.concat(nl(), Str.concat("NETHE", nl()))))))))

def emitTapNeth(prefix: String, bind: String, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  emitTapNeth2(prefix, bind, dropParam(ps, bind), body, strs, defs, ens, loc)

def emitTapNeth2(prefix: String, bind: String, rest: List[Param], body: Expr, strs: Strs, defs: Ftab, ens: List[En], loc: String): String =
  nethWithConts(prefix, body, strs, defs, ens, tapNethPs(bind, rest), loc, emitTapNeth3(prefix, join(emitUnpack(rest), tapBindLine(bind)), emitExpr(body, Str.concat("n", prefix), strs, defs, ens, tapNethPs(bind, rest), loc), Check.isIo(exprRetTyEns(body, defs, ens, tapNethPs(bind, rest), loc)) || isIoPred(body), loc, strs))

def tapBindLine(bind: String): String =
  if (!keepBind(bind)) "" else line(Str.concat("%", Str.concat(bind, " = bitcast ptr %.closure.self to ptr")))

def tapNethPs(bind: String, rest: List[Param]): List[Param] =
  if (keepBind(bind)) Param(bind, "", "", "") :: rest else rest

def emitTapNeth3(prefix: String, pre: String, s: Slot, io: Bool, loc: String, strs: Strs): String =
  s match {
    case Slot(code, val, o) => Str.concat(nethBeg(), Str.concat("define internal void @sz_neth_", Str.concat(prefix, Str.concat("(ptr %.closure.self, ptr %.closure.env) {", Str.concat(nl(), Str.concat(".entry:", Str.concat(nl(), Str.concat(panicPush(loc, strs), Str.concat(join(pre, join(code, tapFinish(val, o, prefix, io))), Str.concat(panicPop(), Str.concat("  ret void", nethEnd())))))))))))
  }

def tapFinish(val: String, o: Bool, prefix: String, io: Bool): String =
  if (io) join(line(Str.concat("call void @sz_io_submit_ui(ptr ", Str.concat(val, ")"))), if (o) relPtr(val) else "") else if (o) relPtr(val) else ""

def nethWithConts(prefix: String, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, ir: String): String =
  join(nethBeg(), join(stampNethC(stampCont(emitConts(body, strs, defs, ens, ps, loc), prefix), prefix), stampCont(dropNethB(ir), prefix)))

def dropNethB(ir: String): String =
  if (nethBegAt(ir, 0)) Str.slice(ir, 6, Str.len(ir)) else ir

def stampNethC(ir: String, key: String): String =
  stampFrom(ir, "@sz_neth_c", Str.concat("@sz_neth_", Str.concat(key, "_c")))

def emitLam(bind: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitLamWithCopy(bind, body, prefix, strs, defs, ens, ps, loc, copyPs(ps))

def emitLamTyped(bind: String, ty: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitLam2(emitNethGoTy(prefix, bind, body, dropParam(ps, bind), strs, defs, ens, loc, false, ty), emitPackEnv(copyPs(ps), Str.concat(prefix, "_e")), prefix)

def emitLamWithCopy(bind: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, ps2: List[Param]): Slot =
  emitLam2(emitNeth(prefix, bind, body, strs, defs, ens, ps, loc, false), emitPackEnv(ps2, Str.concat(prefix, "_e")), prefix)

def emitLam2(neth: String, env: Slot, prefix: String): Slot =
  env match {
    case Slot(ec, ev, eo) => emitLam3(neth, ec, ev, eo, prefix)
  }

def emitLam3(neth: String, ec: String, ev: String, eo: Bool, prefix: String): Slot =
  Slot(join(neth, join(ec, emitLamPack(prefix, ev, eo))), pct(prefix, "cl2"), true)

def emitLamPack(prefix: String, ev: String, eo: Bool): String =
  join(lamNil(prefix), join(lamConsEnv(prefix, ev), join(relPtr(pct(prefix, "cl0")), join(lamConsFn(prefix), join(relPtr(pct(prefix, "cl1")), if (eo) relPtr(ev) else "")))))

def lamNil(prefix: String): String =
  line(Str.concat(tmp(prefix, "cl0"), "call ptr @sz_list_nil()"))

def lamConsEnv(prefix: String, ev: String): String =
  line(Str.concat(tmp(prefix, "cl1"), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(ev, Str.concat(", ptr ", Str.concat(pct(prefix, "cl0"), ")"))))))

def lamConsFn(prefix: String): String =
  line(Str.concat(tmp(prefix, "cl2"), Str.concat("call ptr @sz_list_cons(ptr @sz_neth_", Str.concat(prefix, Str.concat(", ptr ", Str.concat(pct(prefix, "cl1"), ")"))))))

def nethSig(prefix: String, pred: Bool, loc: String, strs: Strs): String =
  Str.concat("define internal ", Str.concat(if (pred) "i64" else "ptr", Str.concat(" @sz_neth_", Str.concat(prefix, nethSig2(loc, strs)))))

def nethSig2(loc: String, strs: Strs): String =
  Str.concat("(ptr %.closure.value, ptr %.closure.env) {", Str.concat(nl(), Str.concat(".entry:", Str.concat(nl(), panicPush(loc, strs)))))

def nethRetLine(ret: String, pred: Bool): String =
  Str.concat(panicPop(), Str.concat(if (pred) "  ret i64 " else "  ret ptr ", ret))

def isJsonExtra(f: String): Bool =
  f == "Json.getInt" || f == "Json.getBool" || f == "Json.getStr" || f == "Json.intOr" || f == "Json.set" || f == "Json.setAt" || f == "Json.Int" || f == "Json.Null" || f == "Json.Float" || f == "Json.floatOr" || f == "Json.getFloat" || f == "Json.boolOr" || f == "Json.strOr"

def emitJsonExtra(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "Json.getInt") emitJsonGetI64("sz_json_get_int", code, vals, owns, prefix) else if (f == "Json.getBool") emitJsonGetI64("sz_json_get_bool", code, vals, owns, prefix) else if (f == "Json.getStr") emitJsonGetStr(code, vals, owns, prefix) else if (f == "Json.intOr") emitJsonIntOr(code, vals, owns, prefix) else if (f == "Json.set") emitJsonSet(code, vals, owns, prefix) else if (f == "Json.setAt") emitJsonSetAt(code, vals, owns, prefix) else if (f == "Json.Int") emitJsonInt(code, vals, prefix) else if (f == "Json.Float") emitJsonFloat(code, vals, prefix) else if (f == "Json.floatOr") emitJsonFloatOr(code, vals, owns, prefix) else if (f == "Json.getFloat") emitJsonGetFloat(code, vals, owns, prefix) else if (f == "Json.boolOr") emitJsonBoolOr(code, vals, owns, prefix) else if (f == "Json.strOr") emitJsonStrOr(code, vals, owns, prefix) else emitJsonNull(code, prefix)

def emitJsonFloat(code: String, vals: List[String], prefix: String): Slot =
  emitJsonFloat2(code, arg0(vals), prefix)

def emitJsonFloat2(code: String, n: String, prefix: String): Slot =
  Slot(join(code, join(jsonBoxI64(n, prefix), join(emitAdtNew(prefix, 3, pct(prefix, "ab")), relPtr(pct(prefix, "ab"))))), pct(prefix, "adt"), true)

def emitJsonFloatOr(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitJsonFloatOr2(code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitJsonFloatOr2(code: String, a: String, n: String, oa: Bool, prefix: String): Slot =
  Slot(join(code, join(jsonFloatOrCall(a, n, prefix), if (oa) relPtr(a) else "")), pct(prefix, "v"), false)

def jsonFloatOrCall(a: String, n: String, prefix: String): String =
  join(jsonFloatOrFd(n, prefix), join(jsonFloatOrFr(a, prefix), jsonFloatOrV(prefix)))

def jsonFloatOrFd(n: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "fd"), Str.concat("bitcast i64 ", Str.concat(n, " to double"))))

def jsonFloatOrFr(a: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "fr"), Str.concat("call double @sz_json_float_or(ptr ", Str.concat(a, Str.concat(", double ", Str.concat(pct(prefix, "fd"), ")"))))))

def jsonFloatOrV(prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("bitcast double ", Str.concat(pct(prefix, "fr"), " to i64"))))

def emitJsonGetFloat(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitJsonGetFloat2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitJsonGetFloat2(code: String, a: String, b: String, n: String, oa: Bool, ob: Bool, prefix: String): Slot =
