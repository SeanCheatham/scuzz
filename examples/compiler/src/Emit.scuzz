def emitViewNil(rt: String, code: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, "()"))))), pct(prefix, "v"), true)

def emitViewGrid(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(viewGridNew(vals, prefix), emitViewAdds(pct(prefix, "v"), List.tail(vals), tailOwn(owns), prefix, 0))), pct(prefix, "v"), true)

def viewGridNew(vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_view_grid(i64 ", Str.concat(arg0(vals), ")"))))

