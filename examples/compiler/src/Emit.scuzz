def sigMapCall(src: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_signal_map(ptr ", Str.concat(src, Str.concat(", ptr ", Str.concat(pct(prefix, "fnp"), Str.concat(", ptr ", Str.concat(pct(prefix, "envp"), ", ptr null)"))))))))

