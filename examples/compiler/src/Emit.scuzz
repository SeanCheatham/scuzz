record Slot(code: String, val: String, owned: Bool)

import Parse.Expr
import Parse.Fun
import Parse.Prog
import Parse.En
import Parse.EnCase
import Parse.Arm
import Parse.Param
import Lexer.Tok
import Check.infer

def noStr(): List[String] =
  []

def noExpr(): List[Expr] =
  []

def noBool(): List[Bool] =
  []

def noEnv(): List[(String, String)] =
  []

def noParam(): List[Param] =
  []

def noArm(): List[Arm] =
  []

def noFun(): List[Fun] =
  []

def nl(): String =
  """
"""

def line(s: String): String =
  Str.concat("  ", Str.concat(s, nl()))

def pct(prefix: String, stem: String): String =
  Str.concat("%", Str.concat(prefix, Str.concat("_", stem)))

def tmp(prefix: String, stem: String): String =
  Str.concat(pct(prefix, stem), " = ")

def llvmC(s: String): String =
  Str.concat("c\"", Str.concat(_escLl(s, 0, Builder.empty()), "\\00\""))

def _escLl(s: String, i: Int, b: Builder): String =
  if (i >= Str.len(s)) Builder.result(b) else _escLl2(s, i, b, Str.charAt(s, i))

def _escLl2(s: String, i: Int, b: Builder, c: Int): String =
  _escLl(s, i + 1, Builder.append(b, if (c == 34) "\\22" else if (c == 92) "\\\\" else if (c == 10) "\\0A" else Str.slice(s, i, i + 1)))

def strConst(i: Int, s: String): String =
  Str.concat("@.str", Str.concat(Str.fromInt(i), Str.concat(" = private unnamed_addr constant [", Str.concat(Str.fromInt(Str.len(s) + 1), Str.concat(" x i8] ", Str.concat(llvmC(s), ", align 1"))))))

def strIndex(xs: List[String], s: String, i: Int): Int =
  if (List.isEmpty(xs)) i else if (List.head(xs) == s) i else strIndex(List.tail(xs), s, i + 1)

def intern(acc: List[String], s: String): List[String] =
  if (strIndex(acc, s, 0) < List.len(acc)) acc else List.concat(acc, s :: noStr())

def collectToks(toks: List[Tok], acc: List[String]): List[String] =
  if (List.isEmpty(toks)) acc else collectTok(List.head(toks), List.tail(toks), acc)

def collectTok(t: Tok, rest: List[Tok], acc: List[String]): List[String] =
  t match {
    case Tok.Str(s) => collectToks(rest, intern(acc, s))
    case _ => collectToks(rest, acc)
  }

def emitConsts(xs: List[String], i: Int): String =
  if (List.isEmpty(xs)) "" else Str.concat(strConst(i, List.head(xs)), Str.concat(nl(), emitConsts(List.tail(xs), i + 1)))

def join(a: String, b: String): String =
  Str.concat(a, b)

def llvmBin(op: String): String =
  if (op == "+") "add" else if (op == "-") "sub" else if (op == "*") "mul" else if (op == "/") "sdiv" else if (op == "%") "srem" else if (op == "&") "and" else if (op == "|") "or" else if (op == "^") "xor" else if (op == "<<") "shl" else if (op == ">>") "ashr" else "add"

def emitExpr(e: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  e match {
    case Expr.EInt(n) => Slot("", Str.fromInt(n), false)
    case Expr.EBool(b) => Slot("", if (b) "1" else "0", false)
    case Expr.EVar(s) => Slot("", Str.concat("%", s), s == "value")
    case Expr.EStr(s) => emitStrAs(s, prefix, strs, "s")
    case Expr.EPrint(inner) => emitPrint(inner, prefix, strs, defs, ens, ps)
    case Expr.ECall(f, args) => emitCall(f, args, prefix, strs, defs, ens, ps)
    case Expr.EBin(op, l, r) => emitBin(op, l, r, prefix, strs, defs, ens, ps)
    case Expr.EUn(op, inner) => emitUn(op, inner, prefix, strs, defs, ens, ps)
    case Expr.ENamed(_, inner) => emitExpr(inner, prefix, strs, defs, ens, ps)
    case Expr.EMethod(recv, name, args) => if (name == "flatMap") emitFm(recv, args, prefix, strs, defs, ens, ps) else emitCtorCall(recv, name, args, prefix, strs, defs, ens, ps)
    case Expr.ELam(_, body) => emitExpr(body, prefix, strs, defs, ens, ps)
    case Expr.EIf(c, t, el) => emitIf(c, t, el, prefix, strs, defs, ens, ps)
    case Expr.EField(recv, name) => emitField(recv, name, prefix, ens)
    case Expr.EMatch(s, arms) => emitMatch(s, arms, prefix, strs, defs, ens, ps)
    case Expr.EList(xs) => emitList(xs, prefix, strs, defs, ens, ps)
    case Expr.ETuple(xs) => emitTuple(xs, prefix, strs, defs, ens, ps)
    case _ => Slot("", "0", false)
  }

def emitStr(s: String, prefix: String, strs: List[String]): Slot =
  emitStrAs(s, prefix, strs, "ss")

def emitStrAs(s: String, prefix: String, strs: List[String], stem: String): Slot =
  emitStr2(prefix, strIndex(strs, s, 0), Str.len(s) + 1, stem)

def emitStr2(prefix: String, idx: Int, len: Int, stem: String): Slot =
  Slot(join(line(Str.concat(tmp(prefix, "gep"), Str.concat("getelementptr inbounds [", Str.concat(Str.fromInt(len), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(idx), ", i64 0, i64 0")))))), line(Str.concat(tmp(prefix, stem), Str.concat("call ptr @sz_string_from_cstr(ptr ", Str.concat(pct(prefix, "gep"), ")"))))), pct(prefix, stem), true)

def emitPrint(inner: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  emitPrint2(emitSzString(inner, prefix, strs, defs, ens, ps), prefix)

def emitSzString(inner: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  inner match {
    case Expr.EStr(s) => emitStr(s, prefix, strs)
    case _ => emitExpr(inner, Str.concat(prefix, "_e"), strs, defs, ens, ps)
  }

def emitPrint2(s: Slot, prefix: String): Slot =
  Slot(join(s.code, join(line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @sz_io_println(ptr ", Str.concat(s.val, ")")))), if (s.owned) line(Str.concat("call void @sz_release(ptr ", Str.concat(s.val, ")"))) else "")), pct(prefix, "io"), false)

def emitBin(op: String, l: Expr, r: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  if (op == "::") emitCall("List.cons", l :: r :: noExpr(), prefix, strs, defs, ens, ps) else if (op == "&&") emitSc(true, l, r, prefix, strs, defs, ens, ps) else if (op == "||") emitSc(false, l, r, prefix, strs, defs, ens, ps) else emitBin2(emitExpr(l, Str.concat(prefix, "_l"), strs, defs, ens, ps), emitExpr(r, Str.concat(prefix, "_r"), strs, defs, ens, ps), op, prefix, ps)

def emitBin2(le: Slot, re: Slot, op: String, prefix: String, ps: List[Param]): Slot =
  if (isCmp(op)) emitBinCmp(le, re, op, prefix, ps) else Slot(join(le.code, join(re.code, line(Str.concat(tmp(prefix, "v"), Str.concat(llvmBin(op), Str.concat(" i64 ", Str.concat(le.val, Str.concat(", ", re.val)))))))), pct(prefix, "v"), false)

def emitBinCmp(le: Slot, re: Slot, op: String, prefix: String, ps: List[Param]): Slot =
  if (le.owned || re.owned || isPtrSlot(le.val, ps) || isPtrSlot(re.val, ps)) emitPtrEq(le, re, op, prefix) else emitCmp(le, re, op, prefix)

def emitPtrEq(le: Slot, re: Slot, op: String, prefix: String): Slot =
  le match {
    case Slot(lc, lv, lo) => emitPtrEqR(lc, lv, lo, re, op, prefix)
  }

def emitPtrEqR(lc: String, lv: String, lo: Bool, re: Slot, op: String, prefix: String): Slot =
  re match {
    case Slot(rc, rv, ro) => emitPtrEq3(join(lc, rc), lv, lo, rv, ro, op, prefix)
  }

def emitPtrEq3(code: String, lv: String, lo: Bool, rv: String, ro: Bool, op: String, prefix: String): Slot =
  Slot(join(code, join(ptrEqCall(prefix, lv, rv), join(ptrEqZext(prefix), join(if (lo) relPtr(lv) else "", join(if (ro) relPtr(rv) else "", if (op == "!=") emitPtrNe(prefix) else ""))))), if (op == "!=") pct(prefix, "nev") else pct(prefix, "eq"), false)

def ptrEqCall(prefix: String, a: String, b: String): String =
  line(Str.concat(tmp(prefix, "eqi"), Str.concat("call i32 @sz_ptr_eq(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))

def ptrEqZext(prefix: String): String =
  line(Str.concat(tmp(prefix, "eq"), Str.concat("zext i32 ", Str.concat(pct(prefix, "eqi"), " to i64"))))

def emitPtrNe(prefix: String): String =
  join(line(Str.concat(tmp(prefix, "ne"), Str.concat("icmp eq i64 ", Str.concat(pct(prefix, "eq"), ", 0")))), line(Str.concat(tmp(prefix, "nev"), Str.concat("zext i1 ", Str.concat(pct(prefix, "ne"), " to i64")))))

def isCmp(op: String): Bool =
  op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">="

def llvmIcmp(op: String): String =
  if (op == "==") "eq" else if (op == "!=") "ne" else if (op == "<") "slt" else if (op == "<=") "sle" else if (op == ">") "sgt" else "sge"

def emitCmp(le: Slot, re: Slot, op: String, prefix: String): Slot =
  Slot(join(le.code, join(re.code, join(line(Str.concat(tmp(prefix, "cmp"), Str.concat("icmp ", Str.concat(llvmIcmp(op), Str.concat(" i64 ", Str.concat(le.val, Str.concat(", ", re.val))))))), line(Str.concat(tmp(prefix, "v"), Str.concat("zext i1 ", Str.concat(pct(prefix, "cmp"), " to i64"))))))), pct(prefix, "v"), false)

def emitUn(op: String, inner: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  emitUn2(emitExpr(inner, Str.concat(prefix, "_u"), strs, defs, ens, ps), op, prefix)

def emitUn2(inner: Slot, op: String, prefix: String): Slot =
  if (op == "-") Slot(join(inner.code, line(Str.concat(tmp(prefix, "v"), Str.concat("sub i64 0, ", inner.val)))), pct(prefix, "v"), false) else if (op == "!") emitNot(inner, prefix) else inner

def emitNot(inner: Slot, prefix: String): Slot =
  Slot(join(inner.code, join(line(Str.concat(tmp(prefix, "z"), Str.concat("icmp eq i64 ", Str.concat(inner.val, ", 0")))), line(Str.concat(tmp(prefix, "v"), Str.concat("zext i1 ", Str.concat(pct(prefix, "z"), " to i64")))))), pct(prefix, "v"), false)

def emitList(xs: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  emitListAt(xs, prefix, strs, defs, ens, ps, 0)

def emitTuple(xs: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  if (List.isEmpty(xs)) Slot("", "null", true) else emitTupleFold1(List.head(xs), List.tail(xs), prefix, 0, strs, defs, ens, ps)

def emitTupleFold1(h: Expr, rest: List[Expr], prefix: String, i: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  if (List.isEmpty(rest)) Slot("", "null", true) else emitTupleFold2(h, List.head(rest), List.tail(rest), prefix, i, strs, defs, ens, ps)

def emitTupleFold2(h: Expr, x: Expr, more: List[Expr], prefix: String, i: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  if (List.isEmpty(more)) emitPair(h, x, Str.concat(prefix, Str.concat("_", Str.fromInt(i))), strs, defs, ens, ps) else emitTupleNest(h, emitTupleFold1(x, more, prefix, i + 1, strs, defs, ens, ps), prefix, i, strs, defs, ens, ps)

def emitTupleNest(h: Expr, rest: Slot, prefix: String, i: Int, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  emitPair2(emitExpr(h, Str.concat(prefix, Str.concat("_h", Str.fromInt(i))), strs, defs, ens, ps), rest, exprIsI64(h, ps, defs), false, Str.concat(prefix, Str.concat("_p", Str.fromInt(i))))

def emitPair(l: Expr, r: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  emitPair2(emitExpr(l, Str.concat(prefix, "_l"), strs, defs, ens, ps), emitExpr(r, Str.concat(prefix, "_r"), strs, defs, ens, ps), exprIsI64(l, ps, defs), exprIsI64(r, ps, defs), prefix)

def emitPair2(le: Slot, re: Slot, ln: Bool, rn: Bool, prefix: String): Slot =
  le match {
    case Slot(lc, lv, lo) => emitPair3(lc, lv, lo, ln, re, rn, prefix)
  }

def emitPair3(lc: String, lv: String, lo: Bool, ln: Bool, re: Slot, rn: Bool, prefix: String): Slot =
  re match {
    case Slot(rc, rv, ro) => emitPair4(join(lc, rc), lv, lo, ln, rv, ro, rn, prefix)
  }

def emitPair4(code: String, lv: String, lo: Bool, ln: Bool, rv: String, ro: Bool, rn: Bool, prefix: String): Slot =
  Slot(join(code, join(pairBox(lv, ln, prefix, "lb"), join(pairBox(rv, rn, prefix, "rb"), join(pairNew(prefix, pairPtr(lv, ln, prefix, "lb"), pairPtr(rv, rn, prefix, "rb")), join(pairDrop(lv, lo, ln, prefix, "lb"), pairDrop(rv, ro, rn, prefix, "rb")))))), pct(prefix, "v"), true)

def pairBox(v: String, num: Bool, prefix: String, stem: String): String =
  if (num) line(Str.concat(tmp(prefix, stem), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(v, ")")))) else ""

def pairPtr(v: String, num: Bool, prefix: String, stem: String): String =
  if (num) pct(prefix, stem) else v

def pairNew(prefix: String, lp: String, rp: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_pair_new(ptr ", Str.concat(lp, Str.concat(", ptr ", Str.concat(rp, ")"))))))

def pairDrop(v: String, owned: Bool, num: Bool, prefix: String, stem: String): String =
  if (num) relPtr(pct(prefix, stem)) else if (owned) relPtr(v) else ""

def exprIsI64(e: Expr, ps: List[Param], defs: List[Fun]): Bool =
  e match {
    case Expr.EInt(_) => true
    case Expr.EBool(_) => true
    case Expr.EVar(s) => paramIsI64(ps, s) || isIntSsa(s)
    case Expr.EBin(op, _, _) => op != "::"
    case Expr.EUn(_, _) => true
    case Expr.ECall(f, _) => callIsI64(f, defs)
    case Expr.EMethod(recv, name, _) => exprMethodI64(recv, name, defs)
    case Expr.EMatch(_, arms) => exprIsI64Match(arms, ps, defs)
    case Expr.EIf(_, t, _) => exprIsI64(t, ps, defs)
    case _ => false
  }

def exprIsI64Match(arms: List[Arm], ps: List[Param], defs: List[Fun]): Bool =
  if (List.isEmpty(arms)) false else exprIsI64Arm(List.head(arms), ps, defs)

def exprIsI64Arm(a: Arm, ps: List[Param], defs: List[Fun]): Bool =
  a match {
    case Arm(_, _, body) => exprIsI64(body, ps, defs)
  }

def exprMethodI64(recv: Expr, name: String, defs: List[Fun]): Bool =
  recv match {
    case Expr.EVar(_) => callIsI64(name, defs)
    case _ => false
  }

def paramIsI64(ps: List[Param], s: String): Bool =
  if (List.isEmpty(ps)) false else paramIsI64h(List.head(ps), List.tail(ps), s)

def paramIsI64h(p: Param, rest: List[Param], s: String): Bool =
  p match {
    case Param(n, ty, _, _) => if (n == s) isI64Ty(ty) else paramIsI64(rest, s)
  }

def isIntSsa(s: String): Bool =
  hasSub(s, "_tv") || hasSub(s, "_ic_v") || hasDigitStem(s, "_b")

def hasDigitStem(s: String, stem: String): Bool =
  hasDigitStemAt(s, stem, 0)

def hasDigitStemAt(s: String, stem: String, n: Int): Bool =
  if (n > 12) false else hasSub(s, Str.concat(stem, Str.fromInt(n))) || hasDigitStemAt(s, stem, n + 1)

def hasSub(s: String, sub: String): Bool =
  hasSubAt(s, sub, 0)

def hasSubAt(s: String, sub: String, i: Int): Bool =
  if (i + Str.len(sub) > Str.len(s)) false else if (Str.slice(s, i, i + Str.len(sub)) == sub) true else hasSubAt(s, sub, i + 1)

def callIsI64(f: String, defs: List[Fun]): Bool =
  f == "Str.len" || f == "Str.charAt" || f == "Str.toInt" || f == "Str.startsWith" || f == "List.len" || f == "List.isEmpty" || funRetI64(defs, f)

def funRetI64(defs: List[Fun], f: String): Bool =
  if (List.isEmpty(defs)) false else funRetI64h(List.head(defs), List.tail(defs), f)

def funRetI64h(d: Fun, rest: List[Fun], f: String): Bool =
  d match {
    case Fun(_, name, _, _, ret, _, _) => if (name == f) isI64Ty(ret) else funRetI64(rest, f)
  }

def emitListAt(xs: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], i: Int): Slot =
  if (List.isEmpty(xs)) Slot(line(Str.concat(tmp(prefix, "0"), "call ptr @sz_list_nil()")), pct(prefix, "0"), true) else emitListCons(List.head(xs), List.tail(xs), prefix, strs, defs, ens, ps, i)

def emitListCons(e: Expr, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], i: Int): Slot =
  emitListCons2(emitListAt(rest, prefix, strs, defs, ens, ps, i + 1), emitExpr(e, Str.concat(prefix, Str.concat("_e", Str.fromInt(i))), strs, defs, ens, ps), prefix, i)

def emitListCons2(tail: Slot, elem: Slot, prefix: String, i: Int): Slot =
  tail match {
    case Slot(tc, tv, _) => emitListCons3(tc, tv, elem, prefix, i)
  }

def emitListCons3(tc: String, tv: String, elem: Slot, prefix: String, i: Int): Slot =
  elem match {
    case Slot(ec, ev, eo) => emitListCons4(join(tc, ec), tv, ev, eo, prefix, i)
  }

def emitListCons4(code: String, tv: String, ev: String, eo: Bool, prefix: String, i: Int): Slot =
  if (eo) emitListConsPtr(code, tv, ev, prefix, i) else emitListConsInt(code, tv, ev, prefix, i)

def emitListConsInt(code: String, tv: String, ev: String, prefix: String, i: Int): Slot =
  Slot(join(code, join(emitBox(prefix, i, ev), join(emitCons(prefix, i, pct(prefix, Str.concat("b", Str.fromInt(i))), tv), join(relPtr(tv), relPtr(pct(prefix, Str.concat("b", Str.fromInt(i)))))))), pct(prefix, Str.fromInt(i + 1)), true)

def emitListConsPtr(code: String, tv: String, ev: String, prefix: String, i: Int): Slot =
  Slot(join(code, join(emitCons(prefix, i, ev, tv), join(relPtr(tv), relPtr(ev)))), pct(prefix, Str.fromInt(i + 1)), true)

def emitBox(prefix: String, i: Int, ev: String): String =
  line(Str.concat(tmp(prefix, Str.concat("b", Str.fromInt(i))), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(ev, ")"))))

def emitCons(prefix: String, i: Int, hd: String, tl: String): String =
  line(Str.concat(tmp(prefix, Str.fromInt(i + 1)), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(hd, Str.concat(", ptr ", Str.concat(tl, ")"))))))

def emitArgList(args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], i: Int, code: String, vals: List[String], owns: List[Bool]): (String, List[String], List[Bool]) =
  if (List.isEmpty(args)) (code, List.reverse(vals), List.reverse(owns)) else emitArgList2(emitExpr(List.head(args), Str.concat(prefix, Str.concat("_arg", Str.fromInt(i))), strs, defs, ens, ps), List.tail(args), prefix, strs, defs, ens, ps, i, code, vals, owns)

def emitArgList2(s: Slot, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], i: Int, code: String, vals: List[String], owns: List[Bool]): (String, List[String], List[Bool]) =
  emitArgList(rest, prefix, strs, defs, ens, ps, i + 1, join(code, s.code), s.val :: vals, s.owned :: owns)

def emitCall2(f: String, p: (String, List[String], List[Bool]), prefix: String, defs: List[Fun], args: List[Expr], ens: List[En], ps: List[Param]): Slot =
  p match {
    case (code, vals, owns) => emitCall3(f, code, vals, owns, prefix, defs, args, ens, ps)
  }

def emitCall3(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, defs: List[Fun], args: List[Expr], ens: List[En], ps: List[Param]): Slot =
  if (f == "Str.fromInt") emitFromInt(code, vals, prefix) else if (f == "Str.concat") emitConcat(code, vals, owns, prefix) else if (f == "Str.len") emitStrLen(code, vals, owns, prefix) else if (f == "Str.charAt") emitCharAt(code, vals, owns, prefix) else if (f == "Str.slice") emitSlice(code, vals, owns, prefix) else if (f == "Str.toInt") emitToInt(code, vals, owns, prefix) else if (f == "Str.repeat") emitRepeat(code, vals, owns, prefix) else if (f == "Str.startsWith") emitStarts(code, vals, owns, prefix) else if (f == "List.len") emitListLen(code, vals, owns, prefix) else if (f == "List.concat") emitListCat(code, vals, owns, prefix) else if (f == "List.reverse") emitListRev(code, vals, owns, prefix) else if (f == "List.head") emitListHead(code, vals, owns, prefix, args, ps) else if (f == "List.tail") emitListTail(code, vals, owns, prefix) else if (f == "List.isEmpty") emitListEmpty(code, vals, owns, prefix) else if (f == "List.cons") emitConsCall(code, vals, owns, prefix, args, ps, defs) else if (f == "List.at") emitAt(code, vals, owns, prefix, args, ps) else if (f == "Builder.empty") emitBldNew(code, prefix) else if (f == "Builder.append") emitBldApp(code, vals, owns, prefix) else if (f == "Builder.result") emitBldRes(code, vals, owns, prefix) else if (f == "Fs.read") emitFsRead(code, vals, owns, prefix) else if (f == "Fs.write") emitFsWrite(code, vals, owns, prefix) else if (hasEn(ens, f)) emitRec(f, code, vals, owns, prefix, ens, args, ps, defs) else emitUser(f, code, vals, owns, prefix, defs)

def emitCall(f: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  emitCall2(f, emitArgList(args, prefix, strs, defs, ens, ps, 0, "", noStr(), noBool()), prefix, defs, args, ens, ps)

def emitConcat(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitConcat2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitConcat2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(emitConcatCall(prefix, a, b), emitConcatRel(a, b, oa, ob))), pct(prefix, "v"), true)

def emitConcatCall(prefix: String, a: String, b: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_concat(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))

def emitConcatRel(a: String, b: String, oa: Bool, ob: Bool): String =
  join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else "")

def relPtr(p: String): String =
  line(Str.concat("call void @sz_release(ptr ", Str.concat(p, ")")))

def arg0(vals: List[String]): String =
  nthStrD(vals, 0, "null")

def arg1(vals: List[String]): String =
  nthStrD(vals, 1, "null")

def arg2(vals: List[String]): String =
  nthStrD(vals, 2, "0")

def nthStrD(xs: List[String], i: Int, d: String): String =
  if (List.isEmpty(xs)) d else nthStr1(List.head(xs), List.tail(xs), i)

def nthStr1(h: String, rest: List[String], i: Int): String =
  if (i <= 0) h else nthStrD(rest, i - 1, "null")

def emitListLen(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListLen2(code, arg0(vals), headOwn(owns), prefix)

def emitListLen2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_list_len(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def emitListCat(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListCat2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitListCat2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(emitListCatCall(prefix, a, b), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), true)

def emitListCatCall(prefix: String, a: String, b: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_concat(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))

def emitListRev(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListRev2(code, arg0(vals), headOwn(owns), prefix)

def emitListRev2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_reverse(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def retPtr(p: String): String =
  line(Str.concat("call void @sz_retain(ptr ", Str.concat(p, ")")))

def takePtr(v: String, o: Bool, prefix: String): String =
  if (o) join(retPtr(pct(prefix, "v")), relPtr(v)) else ""

def hasEn(ens: List[En], name: String): Bool =
  if (List.isEmpty(ens)) false else if (List.head(ens).name == name) true else hasEn(List.tail(ens), name)

def emitAt(code: String, vals: List[String], owns: List[Bool], prefix: String, args: List[Expr], ps: List[Param]): Slot =
  emitAt2(code, arg0(vals), arg1(vals), headOwn(owns), prefix, headUnbox(args, ps))

def emitAt2(code: String, v: String, i: String, o: Bool, prefix: String, unbox: Bool): Slot =
  if (unbox) emitAtInt(code, v, i, o, prefix) else emitAtPtr(code, v, i, o, prefix)

def emitAtInt(code: String, v: String, i: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_at(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(i, ")")))))), join(takePtr(v, o, prefix), join(line(Str.concat(tmp(prefix, "u"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(prefix, "v"), ")")))), if (o) relPtr(pct(prefix, "v")) else "")))), pct(prefix, "u"), false)

def emitAtPtr(code: String, v: String, i: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_at(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(i, ")")))))), takePtr(v, o, prefix))), pct(prefix, "v"), o)

def emitRec(en: String, code: String, vals: List[String], owns: List[Bool], prefix: String, ens: List[En], args: List[Expr], ps: List[Param], defs: List[Fun]): Slot =
  if (List.len(vals) == 1) emitRecOne(en, code, vals, owns, prefix, ens) else emitRecJoin(code, emitPack(vals, owns, args, prefix, 0, List.len(vals), ps, defs), en, prefix, ens)

def emitRecJoin(code: String, pack: Slot, en: String, prefix: String, ens: List[En]): Slot =
  pack match {
    case Slot(pc, pv, _) => emitRec2(join(code, pc), pv, en, prefix, ens)
  }

def emitRecOne(en: String, code: String, vals: List[String], owns: List[Bool], prefix: String, ens: List[En]): Slot =
  emitPayloadCtor1(Slot(code, arg0(vals), headOwn(owns)), en, en, prefix, ens)

def emitRec2(pc: String, pv: String, en: String, prefix: String, ens: List[En]): Slot =
  Slot(join(pc, join(emitAdtNew(prefix, ctorTag(ens, en, en), pv), relPtr(pv))), pct(prefix, "adt"), true)

def emitPack(vals: List[String], owns: List[Bool], args: List[Expr], prefix: String, i: Int, n: Int, ps: List[Param], defs: List[Fun]): Slot =
  if (List.isEmpty(vals)) Slot(line(Str.concat(tmp(prefix, "pl0"), "call ptr @sz_list_nil()")), pct(prefix, "pl0"), true) else emitPack1(List.head(vals), headOwn(owns), exprIsI64(List.head(args), ps, defs), emitPack(List.tail(vals), List.tail(owns), List.tail(args), prefix, i + 1, n, ps, defs), prefix, i, n)

def emitPack1(v: String, o: Bool, num: Bool, rest: Slot, prefix: String, i: Int, n: Int): Slot =
  rest match {
    case Slot(rc, rp, _) => emitPack2(rc, rp, v, o, num, prefix, i, n)
  }

def emitPack2(rc: String, rp: String, v: String, o: Bool, num: Bool, prefix: String, i: Int, n: Int): Slot =
  Slot(join(rc, join(packBox(v, num, prefix, i), join(packCons(prefix, i, n, packPtr(v, num, prefix, i), rp), join(relPtr(rp), packDrop(v, o, num, prefix, i))))), pct(prefix, Str.concat("pl", Str.fromInt(n - i))), true)

def packBox(v: String, num: Bool, prefix: String, i: Int): String =
  if (num) line(Str.concat(tmp(prefix, Str.concat("bx", Str.fromInt(i))), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(v, ")")))) else ""

def packPtr(v: String, num: Bool, prefix: String, i: Int): String =
  if (num) pct(prefix, Str.concat("bx", Str.fromInt(i))) else v

def packCons(prefix: String, i: Int, n: Int, hd: String, tl: String): String =
  line(Str.concat(tmp(prefix, Str.concat("pl", Str.fromInt(n - i))), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(hd, Str.concat(", ptr ", Str.concat(tl, ")"))))))

def packDrop(v: String, o: Bool, num: Bool, prefix: String, i: Int): String =
  if (num) relPtr(pct(prefix, Str.concat("bx", Str.fromInt(i)))) else if (o) relPtr(v) else ""

def emitListHead(code: String, vals: List[String], owns: List[Bool], prefix: String, args: List[Expr], ps: List[Param]): Slot =
  emitListHead2(code, arg0(vals), headOwn(owns), prefix, headUnbox(args, ps))

def headUnbox(args: List[Expr], ps: List[Param]): Bool =
  if (List.isEmpty(args)) false else headUnbox1(List.head(args), ps)

def headUnbox1(e: Expr, ps: List[Param]): Bool =
  e match {
    case Expr.EList(xs) => headUnboxList(xs)
    case Expr.EVar(s) => isI64ListTy(paramTy(ps, s))
    case _ => false
  }

def isI64ListTy(ty: String): Bool =
  ty == "List[Bool]" || ty == "List[Int]" || ty == "List"

def headUnboxList(xs: List[Expr]): Bool =
  if (List.isEmpty(xs)) true else headIsInt(xs)

def headIsInt(xs: List[Expr]): Bool =
  List.head(xs) match {
    case Expr.EInt(_) => true
    case _ => false
  }

def emitListHead2(code: String, v: String, o: Bool, prefix: String, unbox: Bool): Slot =
  if (unbox) emitListHeadInt(code, v, o, prefix) else emitListHeadPtr(code, v, o, prefix)

def emitListHeadInt(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_head(ptr ", Str.concat(v, ")")))), join(takePtr(v, o, prefix), join(line(Str.concat(tmp(prefix, "u"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(prefix, "v"), ")")))), if (o) relPtr(pct(prefix, "v")) else "")))), pct(prefix, "u"), false)

def emitListHeadPtr(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_head(ptr ", Str.concat(v, ")")))), takePtr(v, o, prefix))), pct(prefix, "v"), o)

def emitListTail(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListTail2(code, arg0(vals), headOwn(owns), prefix)

def emitListTail2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_tail(ptr ", Str.concat(v, ")")))), takePtr(v, o, prefix))), pct(prefix, "v"), o)

def emitListEmpty(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListEmpty2(code, arg0(vals), headOwn(owns), prefix)

def emitListEmpty2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "i"), Str.concat("call i32 @sz_list_is_empty(ptr ", Str.concat(v, ")")))), join(line(Str.concat(tmp(prefix, "v"), Str.concat("zext i32 ", Str.concat(pct(prefix, "i"), " to i64")))), if (o) relPtr(v) else ""))), pct(prefix, "v"), false)

def emitStrLen(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitStrLen2(code, arg0(vals), headOwn(owns), prefix)

def emitStrLen2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_string_len(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def emitStarts(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitStarts2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitStarts2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(emitStartsCall(prefix, a, b), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), false)

def emitStartsCall(prefix: String, a: String, b: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_string_starts_with(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))

def emitCharAt(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitCharAt2(code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitCharAt2(code: String, v: String, i: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_string_char_at(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(i, ")")))))), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def emitSlice(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitSlice2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), prefix)

def emitSlice2(code: String, v: String, a: String, b: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_slice(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(a, Str.concat(", i64 ", Str.concat(b, ")")))))))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def emitToInt(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitToInt2(code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitToInt2(code: String, v: String, d: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_string_to_int(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(d, ")")))))), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def emitRepeat(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitRepeat2(code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitRepeat2(code: String, v: String, n: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_repeat(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(n, ")")))))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def emitConsCall(code: String, vals: List[String], owns: List[Bool], prefix: String, args: List[Expr], ps: List[Param], defs: List[Fun]): Slot =
  emitConsCall2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix, consHeadInt(args, ps, defs) || isI64Head(arg0(vals), headOwn(owns), ps))

def consHeadInt(args: List[Expr], ps: List[Param], defs: List[Fun]): Bool =
  if (List.isEmpty(args)) true else exprIsI64(List.head(args), ps, defs)

def isI64Head(v: String, o: Bool, ps: List[Param]): Bool =
  !o && v != "null" && !isPtrSlot(v, ps) && (isIntSsa(v) || isI64ParamVal(v, ps))

def isI64ParamVal(v: String, ps: List[Param]): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37 && paramIsI64(ps, Str.slice(v, 1, Str.len(v)))

def emitConsCall2(code: String, h: String, t: String, oh: Bool, ot: Bool, prefix: String, isInt: Bool): Slot =
  if (isInt) emitConsInt(code, h, t, ot, prefix) else emitConsPtr(code, h, t, oh, ot, prefix)

def emitConsInt(code: String, h: String, t: String, ot: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "hd"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(h, ")")))), join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(pct(prefix, "hd"), Str.concat(", ptr ", Str.concat(t, ")")))))), join(relPtr(pct(prefix, "hd")), if (ot) relPtr(t) else "")))), pct(prefix, "v"), true)

def emitConsPtr(code: String, h: String, t: String, oh: Bool, ot: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(h, Str.concat(", ptr ", Str.concat(t, ")")))))), join(if (oh) relPtr(h) else "", if (ot) relPtr(t) else ""))), pct(prefix, "v"), true)

def emitBldNew(code: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), "call ptr @sz_builder_new()"))), pct(prefix, "v"), true)

def emitBldApp(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitBldApp2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitBldApp2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_builder_append(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")")))))), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), true)

def emitBldRes(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitBldRes2(code, arg0(vals), headOwn(owns), prefix)

def emitBldRes2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_builder_result(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def emitFsRead(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitFsRead2(code, arg0(vals), headOwn(owns), prefix)

def emitFsRead2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_fs_read(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def emitFsWrite(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitFsWrite2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitFsWrite2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_fs_write(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")")))))), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), false)

def emitSc(isAnd: Bool, l: Expr, r: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  emitScA(isAnd, emitExpr(l, Str.concat(prefix, "_l"), strs, defs, ens, ps), r, prefix, strs, defs, ens, ps)

def emitScA(isAnd: Bool, le: Slot, r: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  Slot(join(le.code, join(scHead(isAnd, le.val, prefix), emitScB(emitExpr(r, Str.concat(prefix, "_r"), strs, defs, ens, ps), prefix, isAnd))), pct(prefix, "v"), false)

def scHead(isAnd: Bool, lv: String, prefix: String): String =
  join(line(Str.concat("br label %", Str.concat(prefix, "_al_0"))), join(lab(Str.concat(prefix, "_al_0")), join(line(Str.concat(tmp(prefix, "nz0"), Str.concat("icmp ne i64 ", Str.concat(lv, ", 0")))), scBr(isAnd, prefix))))

def scBr(isAnd: Bool, prefix: String): String =
  if (isAnd) line(Str.concat("br i1 ", Str.concat(pct(prefix, "nz0"), Str.concat(", label %", Str.concat(prefix, Str.concat("_rhs_0, label %", Str.concat(prefix, "_sc_0"))))))) else line(Str.concat("br i1 ", Str.concat(pct(prefix, "nz0"), Str.concat(", label %", Str.concat(prefix, Str.concat("_sc_0, label %", Str.concat(prefix, "_rhs_0")))))))

def emitScB(re: Slot, prefix: String, isAnd: Bool): String =
  join(lab(Str.concat(prefix, "_rhs_0")), join(re.code, scTail(isAnd, re.val, prefix)))

def scTail(isAnd: Bool, rv: String, prefix: String): String =
  join(line(Str.concat("br label %", Str.concat(prefix, "_ar_0"))), join(lab(Str.concat(prefix, "_ar_0")), join(line(Str.concat(tmp(prefix, "rnz0"), Str.concat("icmp ne i64 ", Str.concat(rv, ", 0")))), join(line(Str.concat(tmp(prefix, "rb0"), Str.concat("zext i1 ", Str.concat(pct(prefix, "rnz0"), " to i64")))), join(line(Str.concat("br label %", Str.concat(prefix, "_sc_0"))), join(lab(Str.concat(prefix, "_sc_0")), line(Str.concat(tmp(prefix, "v"), scPhi(isAnd, prefix)))))))))

def scPhi(isAnd: Bool, prefix: String): String =
  Str.concat("phi i64 [ ", Str.concat(if (isAnd) "0" else "1", Str.concat(", %", Str.concat(prefix, Str.concat("_al_0 ], [ ", Str.concat(pct(prefix, "rb0"), Str.concat(", %", Str.concat(prefix, "_ar_0 ]"))))))))

def findDef(funs: List[Fun], name: String): List[Fun] =
  findDefKeep(funs, name, noFun())

def findDefKeep(funs: List[Fun], name: String, acc: List[Fun]): List[Fun] =
  if (List.isEmpty(funs)) acc else findDefKeep1(List.head(funs), List.tail(funs), name, acc)

def findDefKeep1(h: Fun, rest: List[Fun], name: String, acc: List[Fun]): List[Fun] =
  h match {
    case Fun(priv, n, ts, ps, ret, body, mod) => findDefKeep(rest, name, if (n == name) Fun(priv, n, ts, ps, ret, body, mod) :: noFun() else acc)
  }

def emitUser(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, defs: List[Fun]): Slot =
  emitUser2(f, code, vals, owns, prefix, findDef(defs, f))

def emitUser2(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, hit: List[Fun]): Slot =
  if (List.isEmpty(hit)) Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_user_Main_", Str.concat(f, Str.concat("(", Str.concat(i64Args(vals), ")"))))))), pct(prefix, "v"), false) else emitUserD(code, vals, owns, prefix, List.head(hit))

def emitUserHit(sym: String, code: String, vals: List[String], owns: List[Bool], prefix: String, hit: List[Fun]): Slot =
  if (List.isEmpty(hit)) Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_user_", Str.concat(sym, Str.concat("(", Str.concat(i64Args(vals), ")"))))))), pct(prefix, "v"), false) else emitUserD(code, vals, owns, prefix, List.head(hit))

def emitUserD(code: String, vals: List[String], owns: List[Bool], prefix: String, d: Fun): Slot =
  d match {
    case Fun(_, name, _, params, ret, _, mod) => emitUser6(symOf(mod, name), code, vals, owns, prefix, params, ret)
  }

def symOf(mod: String, name: String): String =
  Str.concat(if (mod == "") "Main" else mod, Str.concat("_", name))

def emitUser6(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, params: List[Param], ret: String): Slot =
  emitUser7(f, code, prefix, llvmRet(ret), !isI64Ty(ret), packCall(params, vals, owns))

def emitUser7(f: String, code: String, prefix: String, ty: String, owned: Bool, p: (String, String)): Slot =
  p match {
    case (args, rel) => Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ", Str.concat(ty, Str.concat(" @sz_user_", Str.concat(f, Str.concat("(", Str.concat(args, ")")))))))), rel)), pct(prefix, "v"), owned)
  }

def packCall(ps: List[Param], vals: List[String], owns: List[Bool]): (String, String) =
  if (List.isEmpty(ps) || List.isEmpty(vals)) ("", "") else packCall2(List.head(ps), List.head(vals), headOwn(owns), List.tail(ps), List.tail(vals), tailOwn(owns))

def headOwn(owns: List[Bool]): Bool =
  if (List.isEmpty(owns)) false else List.head(owns)

def tailOwn(owns: List[Bool]): List[Bool] =
  if (List.isEmpty(owns)) owns else List.tail(owns)

def packCall2(p: Param, v: String, o: Bool, ps: List[Param], vals: List[String], owns: List[Bool]): (String, String) =
  packCall3(oneArg(p, v), if (o) relPtr(v) else "", packCall(ps, vals, owns))

def packCall3(arg: String, rel: String, rest: (String, String)): (String, String) =
  rest match {
    case (args, rels) => (if (args == "") arg else Str.concat(arg, Str.concat(", ", args)), join(rel, rels))
  }

def oneArg(p: Param, v: String): String =
  if (isI64Ty(p.ty)) Str.concat("i64 ", v) else Str.concat("ptr ", v)

def lab(s: String): String =
  Str.concat(s, Str.concat(":", nl()))

def emitIf(c: Expr, t: Expr, el: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  emitIf2(emitExpr(c, Str.concat(prefix, "_ic"), strs, defs, ens, ps), emitExpr(t, Str.concat(prefix, "_t0"), strs, defs, ens, ps), emitExpr(el, Str.concat(prefix, "_e0"), strs, defs, ens, ps), prefix, ps)

def emitIf2(c: Slot, t: Slot, el: Slot, prefix: String, ps: List[Param]): Slot =
  t match {
    case Slot(tc, tv, to) => el match {
  case Slot(ec, ev, eo) => emitIf3(c, tc, tv, to, ec, ev, eo, prefix, ps)
}
  }

def emitIf3(c: Slot, tc: String, tv: String, to: Bool, ec: String, ev: String, eo: Bool, prefix: String, ps: List[Param]): Slot =
  emitIf4(c, tc, tv, to, ec, ev, eo, prefix, to || eo || isPtrSlot(tv, ps) || isPtrSlot(ev, ps))

def emitIf4(c: Slot, tc: String, tv: String, to: Bool, ec: String, ev: String, eo: Bool, prefix: String, isPtr: Bool): Slot =
  Slot(join(emitIfHead(c, prefix), join(emitIfArm(tc, tv, to, prefix, "_then_0", "_tj_0", isPtr && !to), join(emitIfArm(ec, ev, eo, prefix, "_else_0", "_ej_0", isPtr && !eo), emitIfPhi(tv, ev, prefix, isPtr)))), pct(prefix, "phi"), isPtr)

def isPtrSlot(v: String, ps: List[Param]): Bool =
  isPtrParam(v, ps) || hasDigitStem(v, "_c") || hasSub(v, "_tl") || hasSub(v, "_tr") || hasSub(v, "_pl")

def isPtrParam(v: String, ps: List[Param]): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37 && paramKnown(ps, Str.slice(v, 1, Str.len(v))) && !paramIsI64(ps, Str.slice(v, 1, Str.len(v)))

def paramKnown(ps: List[Param], n: String): Bool =
  if (List.isEmpty(ps)) false else if (List.head(ps).name == n) true else paramKnown(List.tail(ps), n)

def emitIfHead(c: Slot, prefix: String): String =
  c match {
    case Slot(code, val, _) => join(code, join(emitIfCmp(val, prefix), emitIfBr(prefix)))
  }

def emitIfCmp(v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "cmp"), Str.concat("icmp ne i64 ", Str.concat(v, ", 0"))))

def emitIfBr(prefix: String): String =
  line(Str.concat("br i1 ", Str.concat(pct(prefix, "cmp"), Str.concat(", label %", Str.concat(prefix, Str.concat("_then_0, label %", Str.concat(prefix, "_else_0")))))))

def emitIfArm(code: String, val: String, owned: Bool, prefix: String, enter: String, joinLab: String, keep: Bool): String =
  join(lab(Str.concat(prefix, enter)), join(code, join(if (!owned && keep) retPtr(val) else "", join(emitIfJmp(prefix, joinLab), join(lab(Str.concat(prefix, joinLab)), emitIfJmp(prefix, "_merge_0"))))))

def emitIfJmp(prefix: String, dest: String): String =
  line(Str.concat("br label %", Str.concat(prefix, dest)))

def emitIfPhi(tv: String, ev: String, prefix: String, isPtr: Bool): String =
  join(lab(Str.concat(prefix, "_merge_0")), line(Str.concat(tmp(prefix, "phi"), emitIfPhi2(tv, ev, prefix, if (isPtr) "ptr" else "i64"))))

def emitIfPhi2(tv: String, ev: String, prefix: String, ty: String): String =
  Str.concat("phi ", Str.concat(ty, Str.concat(" [ ", Str.concat(tv, Str.concat(", %", Str.concat(prefix, Str.concat("_tj_0 ], [ ", Str.concat(ev, emitIfPhi3(prefix)))))))))

def emitIfPhi3(prefix: String): String =
  Str.concat(", %", Str.concat(prefix, "_ej_0 ]"))

def emitField(recv: Expr, name: String, prefix: String, ens: List[En]): Slot =
  recv match {
    case Expr.EVar(en) => emitCtor(en, name, prefix, ens)
    case _ => Slot("", "0", false)
  }

def emitCtorCall(recv: Expr, name: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  recv match {
    case Expr.EVar(en) => emitCtorOrQual(en, name, args, prefix, strs, defs, ens, ps)
    case _ => Slot("", "0", false)
  }

def emitCtorOrQual(en: String, name: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  if (hasEn(ens, en)) emitPayloadCtor(en, name, args, prefix, strs, defs, ens, ps) else emitQual(en, name, args, prefix, strs, defs, ens, ps)

def emitQual(en: String, name: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  emitQual2(en, name, emitArgList(args, prefix, strs, defs, ens, ps, 0, "", noStr(), noBool()), prefix, defs)

def emitQual2(en: String, name: String, p: (String, List[String], List[Bool]), prefix: String, defs: List[Fun]): Slot =
  p match {
    case (code, vals, owns) => emitUserMod(en, name, code, vals, owns, prefix, defs)
  }

def findDefMod(funs: List[Fun], mod: String, name: String): List[Fun] =
  if (List.isEmpty(funs)) noFun() else findDefMod1(List.head(funs), List.tail(funs), mod, name)

def findDefMod1(h: Fun, rest: List[Fun], mod: String, name: String): List[Fun] =
  h match {
    case Fun(priv, n, ts, ps, ret, body, m) => if (n == name && m == mod) Fun(priv, n, ts, ps, ret, body, m) :: findDefMod(rest, mod, name) else findDefMod(rest, mod, name)
  }

def userName(d: Fun): String =
  d match {
    case Fun(_, name, _, _, _, _, mod) => symOf(mod, name)
  }

def emitUserMod(en: String, name: String, code: String, vals: List[String], owns: List[Bool], prefix: String, defs: List[Fun]): Slot =
  emitUserHit(Str.concat(en, Str.concat("_", name)), code, vals, owns, prefix, findDefMod(defs, en, name))

def emitPayloadCtor(en: String, name: String, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  if (List.isEmpty(args)) emitCtor(en, name, prefix, ens) else emitPayloadCtorRest(en, name, List.head(args), List.tail(args), prefix, strs, defs, ens, ps)

def emitPayloadCtorRest(en: String, name: String, h: Expr, rest: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  if (List.isEmpty(rest)) emitPayloadCtor1(emitExpr(h, Str.concat(prefix, "_ap"), strs, defs, ens, ps), en, name, prefix, ens) else emitPayloadCtorN(en, name, emitArgList(h :: rest, prefix, strs, defs, ens, ps, 0, "", noStr(), noBool()), h :: rest, prefix, ens, ps, defs)

def emitPayloadCtorN(en: String, name: String, p: (String, List[String], List[Bool]), args: List[Expr], prefix: String, ens: List[En], ps: List[Param], defs: List[Fun]): Slot =
  p match {
    case (code, vals, owns) => if (List.len(vals) == 1) emitPayloadCtor1(Slot(code, arg0(vals), headOwn(owns)), en, name, prefix, ens) else emitPayJoin(code, emitPack(vals, owns, args, prefix, 0, List.len(vals), ps, defs), en, name, prefix, ens)
  }

def emitPayJoin(code: String, pack: Slot, en: String, name: String, prefix: String, ens: List[En]): Slot =
  pack match {
    case Slot(pc, pv, _) => emitPay2(join(code, pc), pv, en, name, prefix, ens)
  }

def emitPay2(pc: String, pv: String, en: String, name: String, prefix: String, ens: List[En]): Slot =
  Slot(join(pc, join(emitAdtNew(prefix, ctorTag(ens, en, name), pv), relPtr(pv))), pct(prefix, "adt"), true)

def emitPayloadCtor1(arg: Slot, en: String, name: String, prefix: String, ens: List[En]): Slot =
  if (payloadIsInt(arg, fieldTy(ens, Str.concat(en, Str.concat(".", name))))) emitPayloadInt(arg, en, name, prefix, ens) else emitPayloadPtr(arg, en, name, prefix, ens)

def payloadIsInt(arg: Slot, ft: String): Bool =
  isI64Ty(ft) || !arg.owned && !Str.startsWith(arg.val, "%") && arg.val != "null"

def emitPayloadInt(arg: Slot, en: String, name: String, prefix: String, ens: List[En]): Slot =
  Slot(join(arg.code, join(emitBoxI64(prefix, arg.val), join(emitAdtNew(prefix, ctorTag(ens, en, name), pct(prefix, "box")), relPtr(pct(prefix, "box"))))), pct(prefix, "adt"), true)

def emitPayloadPtr(arg: Slot, en: String, name: String, prefix: String, ens: List[En]): Slot =
  Slot(join(arg.code, join(emitAdtNew(prefix, ctorTag(ens, en, name), arg.val), if (arg.owned) relPtr(arg.val) else "")), pct(prefix, "adt"), true)

def emitBoxI64(prefix: String, v: String): String =
  line(Str.concat(tmp(prefix, "box"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(v, ")"))))

def emitAdtNew(prefix: String, tag: Int, payload: String): String =
  line(Str.concat(tmp(prefix, "adt"), Str.concat("call ptr @sz_adt_new(i32 ", Str.concat(Str.fromInt(tag), Str.concat(", ptr ", Str.concat(payload, ")"))))))

def emitCtor(en: String, name: String, prefix: String, ens: List[En]): Slot =
  Slot(emitAdtNew(prefix, ctorTag(ens, en, name), "null"), pct(prefix, "adt"), true)

def ctorTag(ens: List[En], en: String, name: String): Int =
  if (List.isEmpty(ens)) 0 else ctorTag1(List.head(ens), List.tail(ens), en, name)

def ctorTag1(h: En, rest: List[En], en: String, name: String): Int =
  h match {
    case En(_, n, _, cases) => if (n == en) caseTag(cases, name, 0) else ctorTag(rest, en, name)
  }

def caseTag(cs: List[EnCase], name: String, i: Int): Int =
  if (List.isEmpty(cs)) 0 else if (List.head(cs).name == name) i else caseTag(List.tail(cs), name, i + 1)

def dotAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 46) i else dotAt(s, i + 1)

def patTag(pat: String, ens: List[En]): Int =
  patTag2(dotAt(patCore(pat), 0), patCore(pat), ens)

def patCore(pat: String): String =
  patCore2(parenAt(pat, 0), pat)

def patCore2(p: Int, pat: String): String =
  if (p < 0) pat else Str.slice(pat, 0, p)

def parenAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 40) i else parenAt(s, i + 1)

def patBind(pat: String): String =
  patBind2(parenAt(pat, 0), pat)

def patBind2(p: Int, pat: String): String =
  if (p < 0) "" else Str.slice(pat, p + 1, Str.len(pat) - 1)

def fieldTy(ens: List[En], core: String): String =
  fieldTy2(dotAt(core, 0), core, ens)

def fieldTy2(dot: Int, core: String, ens: List[En]): String =
  if (dot < 0) recFirstTy(ens, core) else caseFieldTy(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def recFirstTy(ens: List[En], name: String): String =
  if (List.isEmpty(ens)) "" else recFirstTy1(List.head(ens), List.tail(ens), name)

def recFirstTy1(h: En, rest: List[En], name: String): String =
  h match {
    case En(_, n, _, cases) => if (n == name) recFirstTy2(cases) else recFirstTy(rest, name)
  }

def recFirstTy2(cs: List[EnCase]): String =
  if (List.isEmpty(cs)) "" else recFirstTy3(List.head(cs))

def recFirstTy3(c: EnCase): String =
  c match {
    case EnCase(_, fs) => firstFieldTy(fs)
  }

def caseFieldTy(ens: List[En], en: String, ctor: String): String =
  if (List.isEmpty(ens)) "" else caseFieldTy1(List.head(ens), List.tail(ens), en, ctor)

def caseFieldTy1(h: En, rest: List[En], en: String, ctor: String): String =
  h match {
    case En(_, name, _, cases) => if (name == en) caseFieldTy2(cases, ctor) else caseFieldTy(rest, en, ctor)
  }

def caseFieldTy2(cs: List[EnCase], ctor: String): String =
  if (List.isEmpty(cs)) "" else caseFieldTy3(List.head(cs), List.tail(cs), ctor)

def caseFieldTy3(h: EnCase, rest: List[EnCase], ctor: String): String =
  h match {
    case EnCase(name, fields) => if (name == ctor) firstFieldTy(fields) else caseFieldTy2(rest, ctor)
  }

def payloadTys(ens: List[En], core: String): List[String] =
  payloadTys2(dotAt(core, 0), core, ens)

def payloadTys2(dot: Int, core: String, ens: List[En]): List[String] =
  if (dot < 0) recTys(ens, core) else caseTys(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def caseTys(ens: List[En], en: String, ctor: String): List[String] =
  if (List.isEmpty(ens)) noStr() else caseTys1(List.head(ens), List.tail(ens), en, ctor)

def caseTys1(h: En, rest: List[En], en: String, ctor: String): List[String] =
  h match {
    case En(_, name, _, cases) => if (name == en) caseTys2(cases, ctor) else caseTys(rest, en, ctor)
  }

def caseTys2(cs: List[EnCase], ctor: String): List[String] =
  if (List.isEmpty(cs)) noStr() else caseTys3(List.head(cs), List.tail(cs), ctor)

def caseTys3(h: EnCase, rest: List[EnCase], ctor: String): List[String] =
  h match {
    case EnCase(name, fields) => if (name == ctor) paramTys(fields) else caseTys2(rest, ctor)
  }

def firstFieldTy(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else List.head(ps).ty

def bindIsInt(pat: String, ens: List[En]): Bool =
  payloadIntTy(fieldTy(ens, patCore(pat)), ens)

def payloadIntTy(ft: String, ens: List[En]): Bool =
  isI64Ty(ft) || ft != "" && !isPtrName(ft, ens)

def isPtrName(ft: String, ens: List[En]): Bool =
  ft == "String" || ft == "Float" || Str.startsWith(ft, "List") || Str.startsWith(ft, "IO") || hasEn(ens, tyHead(ft))

def tyHead(ft: String): String =
  tyHeadAt(ft, 0)

def tyHeadAt(ft: String, i: Int): String =
  if (i >= Str.len(ft)) ft else if (Str.charAt(ft, i) == 91) Str.slice(ft, 0, i) else tyHeadAt(ft, i + 1)

def fpre(prefix: String, i: Int): String =
  Str.concat(ppre(prefix, i), Str.concat("_f", sid(i)))

def bindStem(prefix: String, i: Int, isInt: Bool): String =
  Str.concat(fpre(prefix, i), if (isInt) "_b0" else "_pl")

def patTag2(dot: Int, pat: String, ens: List[En]): Int =
  if (dot < 0) 0 else ctorTag(ens, Str.slice(pat, 0, dot), Str.slice(pat, dot + 1, Str.len(pat)))

def emitMatch(s: Expr, arms: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  s match {
    case Expr.EVar(n) => emitMatchV(n, arms, prefix, strs, defs, ens, ps)
    case _ => emitMatch1(emitExpr(s, Str.concat(prefix, "_sc"), strs, defs, ens, ps), arms, prefix, strs, defs, ens, ps, tupSlots(infer(s, paramEnv(ps), defs, ens).ty))
  }

def emitMatchV(n: String, arms: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  emitMatch1(emitExpr(Expr.EVar(n), Str.concat(prefix, "_sc"), strs, defs, ens, ps), arms, prefix, strs, defs, ens, ps, tupSlots(paramTy(ps, n)))

def paramTy(ps: List[Param], n: String): String =
  if (List.isEmpty(ps)) "" else paramTy1(List.head(ps), List.tail(ps), n)

def paramTy1(p: Param, rest: List[Param], n: String): String =
  p match {
    case Param(name, ty, _, _) => if (name == n) ty else paramTy(rest, n)
  }

def tupSlots(ty: String): List[String] =
  if (!isTupTy(ty)) noStr() else splitPat(Str.slice(ty, 1, Str.len(ty) - 1))

def slotInt(tys: List[String], k: Int): Bool =
  if (List.isEmpty(tys)) k == 1 else if (k <= 0) isI64Ty(List.head(tys)) else slotInt(List.tail(tys), k - 1)

def emitMatch1(se: Slot, arms: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], tys: List[String]): Slot =
  se match {
    case Slot(sc, sv, _) => emitMatchOksFirst(sc, emitOks(arms, prefix, strs, defs, ens, ps, 0, tys), arms, prefix, sv, ens, strs, tys)
  }

def emitMatchOksFirst(sc: String, oks: (String, List[String], Bool), arms: List[Arm], prefix: String, sv: String, ens: List[En], strs: List[String], tys: List[String]): Slot =
  emitMatch2(sc, emitTries(arms, prefix, sv, ens, strs, 0, tys), oks, prefix, isExh(arms))

def isExh(arms: List[Arm]): Bool =
  if (List.isEmpty(arms)) false else isExh2(List.head(arms), List.tail(arms))

def isExh2(h: Arm, t: List[Arm]): Bool =
  if (List.isEmpty(t)) isWild(h) else isExh(t)

def isWild(arm: Arm): Bool =
  arm match {
    case Arm(pat, _, _) => pat == "_"
  }

def emitMatch2(sc: String, tries: String, oks: (String, List[String], Bool), prefix: String, exh: Bool): Slot =
  oks match {
    case (okCode, vals, owned) => emitMatch3(sc, tries, okCode, vals, owned, prefix, exh)
  }

def emitMatch3(sc: String, tries: String, okCode: String, vals: List[String], owned: Bool, prefix: String, exh: Bool): Slot =
  Slot(join(sc, join(brTry(prefix), join(tries, join(emitDefault(prefix, owned, exh), join(okCode, emitMatchPhi(vals, owned, prefix, exh)))))), pct(prefix, "phi"), owned)

def brTry(prefix: String): String =
  line(Str.concat("br label %", Str.concat(prefix, "_try_0_0")))

def emitDefault(prefix: String, owned: Bool, exh: Bool): String =
  if (exh) join(lab(Str.concat(prefix, "_default_0")), line("unreachable")) else if (owned) join(lab(Str.concat(prefix, "_default_0")), line(Str.concat("br label %", Str.concat(prefix, "_merge_0")))) else join(lab(Str.concat(prefix, "_default_0")), join(line(Str.concat(tmp(prefix, "dflt"), "add i64 0, 0")), line(Str.concat("br label %", Str.concat(prefix, "_merge_0")))))

def emitTries(arms: List[Arm], prefix: String, scrut: String, ens: List[En], strs: List[String], i: Int, tys: List[String]): String =
  if (List.isEmpty(arms)) "" else emitTries2(List.head(arms), List.tail(arms), prefix, scrut, ens, strs, i, tys)

def emitTries2(arm: Arm, rest: List[Arm], prefix: String, scrut: String, ens: List[En], strs: List[String], i: Int, tys: List[String]): String =
  if (List.isEmpty(rest)) emitTry1(arm, prefix, scrut, ens, strs, i, true, tys) else join(emitTry1(arm, prefix, scrut, ens, strs, i, false, tys), emitTries(rest, prefix, scrut, ens, strs, i + 1, tys))

def emitTry1(arm: Arm, prefix: String, scrut: String, ens: List[En], strs: List[String], i: Int, last: Bool, tys: List[String]): String =
  arm match {
    case Arm(pat, _, _) => join(lab(tryLab(prefix, i)), emitTryPat(pat, prefix, i, scrut, ens, strs, last, tys))
  }

def emitTryPat(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], strs: List[String], last: Bool, tys: List[String]): String =
  if (pat == "_") line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i))))) else if (isStrPat(pat)) emitStrTry(pat, prefix, i, scrut, strs, last) else if (isIntPat(pat)) emitIntTry(pat, prefix, i, scrut, last) else if (isTuplePat(pat)) emitTupleTry(prefix, i, scrut, tys) else join(emitTag(prefix, i, scrut, patTag(pat, ens)), join(emitTagBr(prefix, i, last), emitMatchedPat(pat, prefix, i, scrut, ens)))

def isTuplePat(pat: String): Bool =
  Str.len(pat) > 0 && Str.charAt(pat, 0) == 40

def emitTupleTry(prefix: String, i: Int, scrut: String, tys: List[String]): String =
  emitTuplePeel(ppre(prefix, i), i + 1, scrut, tys, prefix, i)

def emitTuplePeel(pre: String, sid: Int, scrut: String, tys: List[String], armPrefix: String, armI: Int): String =
  join(peelLeft(pre, sid, scrut), join(peelRight(pre, sid, scrut), join(peelBrTn(pre, sid), join(peelTnLab(pre, sid), emitTupleCont(pre, sid, tys, armPrefix, armI)))))

def emitTupleCont(pre: String, sid: Int, tys: List[String], armPrefix: String, armI: Int): String =
  join(if (slotInt(tys, 0)) peelUnboxL(pre, sid) else "", emitTupleRest(pre, sid, tys, armPrefix, armI))

def emitTupleRest(pre: String, sid: Int, tys: List[String], armPrefix: String, armI: Int): String =
  if (List.len(tys) > 2) emitTuplePeel(Str.concat(pre, Str.concat("_n", Str.fromInt(sid))), sid + 1, pct(pre, Str.concat("tr", Str.fromInt(sid))), List.tail(tys), armPrefix, armI) else join(if (slotInt(tys, 1) || List.isEmpty(tys)) peelUnboxR(pre, sid) else "", tupleBrOk(armPrefix, armI))

def peelLeft(pre: String, sid: Int, scrut: String): String =
  line(Str.concat(tmp(pre, Str.concat("tl", Str.fromInt(sid))), Str.concat("call ptr @sz_pair_left(ptr ", Str.concat(scrut, ")"))))

def peelRight(pre: String, sid: Int, scrut: String): String =
  line(Str.concat(tmp(pre, Str.concat("tr", Str.fromInt(sid))), Str.concat("call ptr @sz_pair_right(ptr ", Str.concat(scrut, ")"))))

def peelBrTn(pre: String, sid: Int): String =
  line(Str.concat("br label %", Str.concat(pre, Str.concat("_tn", Str.fromInt(sid)))))

def peelTnLab(pre: String, sid: Int): String =
  lab(Str.concat(pre, Str.concat("_tn", Str.fromInt(sid))))

def peelUnboxL(pre: String, sid: Int): String =
  line(Str.concat(tmp(pre, Str.concat("tvl", Str.fromInt(sid))), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(pre, Str.concat("tl", Str.fromInt(sid))), ")"))))

def peelUnboxR(pre: String, sid: Int): String =
  line(Str.concat(tmp(pre, Str.concat("tv", Str.fromInt(sid))), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(pre, Str.concat("tr", Str.fromInt(sid))), ")"))))

def tupleLeft(prefix: String, i: Int, scrut: String): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("tl", sid(i))), Str.concat("call ptr @sz_pair_left(ptr ", Str.concat(scrut, ")"))))

def tupleRight(prefix: String, i: Int, scrut: String): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("tr", sid(i))), Str.concat("call ptr @sz_pair_right(ptr ", Str.concat(scrut, ")"))))

def tupleBrTn(prefix: String, i: Int): String =
  line(Str.concat("br label %", Str.concat(ppre(prefix, i), Str.concat("_tn", sid(i)))))

def tupleUnbox(prefix: String, i: Int): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("tv", sid(i))), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(ppre(prefix, i), Str.concat("tr", sid(i))), ")"))))

def tupleBrOk(prefix: String, i: Int): String =
  line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))))

def isStrPat(pat: String): Bool =
  Str.len(pat) >= 2 && Str.charAt(pat, 0) == 34

def isIntPat(pat: String): Bool =
  if (Str.len(pat) == 0) false else isIntPat2(pat, if (Str.charAt(pat, 0) == 45) 1 else 0)

def isIntPat2(pat: String, i: Int): Bool =
  if (i >= Str.len(pat)) i > 0 && (Str.charAt(pat, 0) != 45 || Str.len(pat) > 1) else if (Str.charAt(pat, i) >= 48 && Str.charAt(pat, i) <= 57) isIntPat2(pat, i + 1) else false

def unquote(pat: String): String =
  Str.slice(pat, 1, Str.len(pat) - 1)

def emitStrTry(pat: String, prefix: String, i: Int, scrut: String, strs: List[String], last: Bool): String =
  emitStrTry2(unquote(pat), prefix, i, scrut, strs, last)

def emitStrTry2(s: String, prefix: String, i: Int, scrut: String, strs: List[String], last: Bool): String =
  emitStrTry3(s, prefix, i, scrut, strIndex(strs, s, 0), last)

def emitStrTry3(s: String, prefix: String, i: Int, scrut: String, idx: Int, last: Bool): String =
  join(strGep(s, prefix, i, idx), join(strLit(prefix, i), join(strEqi(prefix, i, scrut), join(relPtr(pct(ppre(prefix, i), Str.concat("slit", sid(i)))), join(strSeq(prefix, i), strBr(prefix, i, last))))))

def strGep(s: String, prefix: String, i: Int, idx: Int): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("sgep", sid(i))), Str.concat("getelementptr inbounds [", Str.concat(Str.fromInt(Str.len(s) + 1), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(idx), ", i64 0, i64 0"))))))

def strLit(prefix: String, i: Int): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("slit", sid(i))), Str.concat("call ptr @sz_string_from_cstr(ptr ", Str.concat(pct(ppre(prefix, i), Str.concat("sgep", sid(i))), ")"))))

def strEqi(prefix: String, i: Int, scrut: String): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("seqi", sid(i))), Str.concat("call i32 @sz_string_eq(ptr ", Str.concat(scrut, Str.concat(", ptr ", Str.concat(pct(ppre(prefix, i), Str.concat("slit", sid(i))), ")"))))))

def strSeq(prefix: String, i: Int): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("seq", sid(i))), Str.concat("icmp ne i32 ", Str.concat(pct(ppre(prefix, i), Str.concat("seqi", sid(i))), ", 0"))))

def strBr(prefix: String, i: Int, last: Bool): String =
  line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), Str.concat("seq", sid(i))), Str.concat(", label %", Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), Str.concat(", label %", nextLab(prefix, i, last)))))))))

def emitIntTry(pat: String, prefix: String, i: Int, scrut: String, last: Bool): String =
  join(line(Str.concat(tmp(ppre(prefix, i), Str.concat("ieq", sid(i))), Str.concat("icmp eq i64 ", Str.concat(scrut, Str.concat(", ", pat))))), line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), Str.concat("ieq", sid(i))), Str.concat(", label %", Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), Str.concat(", label %", nextLab(prefix, i, last))))))))))

def tryLab(prefix: String, i: Int): String =
  Str.concat(prefix, Str.concat("_try_0_", Str.fromInt(i)))

def nextLab(prefix: String, i: Int, last: Bool): String =
  if (last) Str.concat(prefix, "_default_0") else Str.concat(prefix, Str.concat("_try_0_", Str.fromInt(i + 1)))

def ppre(prefix: String, i: Int): String =
  Str.concat(prefix, Str.concat("_p0_", Str.fromInt(i)))

def sid(i: Int): String =
  Str.fromInt(i + 1)

def emitTag(prefix: String, i: Int, scrut: String, tag: Int): String =
  join(line(Str.concat(tmp(ppre(prefix, i), Str.concat("tg", sid(i))), Str.concat("call i32 @sz_adt_tag(ptr ", Str.concat(scrut, ")")))), line(Str.concat(tmp(ppre(prefix, i), Str.concat("eq", sid(i))), Str.concat("icmp eq i32 ", Str.concat(pct(ppre(prefix, i), Str.concat("tg", sid(i))), Str.concat(", ", Str.fromInt(tag)))))))

def emitTagBr(prefix: String, i: Int, last: Bool): String =
  line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), Str.concat("eq", sid(i))), Str.concat(", label %", Str.concat(ppre(prefix, i), Str.concat("_m", Str.concat(sid(i), Str.concat(", label %", nextLab(prefix, i, last)))))))))

def emitMatchedPat(pat: String, prefix: String, i: Int, scrut: String, ens: List[En]): String =
  join(lab(Str.concat(ppre(prefix, i), Str.concat("_m", sid(i)))), join(emitPayload(pat, prefix, i, scrut, ens), emitMatchedEnd(pat, prefix, i)))

def emitMatchedEnd(pat: String, prefix: String, i: Int): String =
  if (hasComma(patBind(pat))) join(line(Str.concat("br label %", Str.concat(ppre(prefix, i), Str.concat("_n", Str.concat(sid(i), "_0"))))), join(lab(Str.concat(ppre(prefix, i), Str.concat("_n", Str.concat(sid(i), "_0")))), line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i))))))) else line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))))

def emitPayload(pat: String, prefix: String, i: Int, scrut: String, ens: List[En]): String =
  if (patBind(pat) == "") "" else if (hasComma(patBind(pat))) emitPayloadN(prefix, i, scrut, splitPat(patBind(pat)), 0, payloadTys(ens, patCore(pat))) else emitPayload2(prefix, i, scrut, bindIsInt(pat, ens))

def emitPayloadN(prefix: String, i: Int, scrut: String, ns: List[String], k: Int, fts: List[String]): String =
  if (k == 0) join(line(Str.concat(tmp(fpre(prefix, i), "pl"), Str.concat("call ptr @sz_adt_payload(ptr ", Str.concat(scrut, ")")))), emitPayloadN(prefix, i, scrut, ns, 1, fts)) else if (List.isEmpty(ns)) "" else join(emitFieldAt(prefix, i, k - 1, slotInt(fts, k - 1)), emitPayloadN(prefix, i, scrut, List.tail(ns), k + 1, fts))

def emitFieldAt(prefix: String, i: Int, k: Int, isInt: Bool): String =
  join(fieldCell(prefix, i, k), if (isInt) fieldUnbox(prefix, i, k) else "")

def fieldCell(prefix: String, i: Int, k: Int): String =
  fieldCell2(tmp(fpre(prefix, i), Str.concat("c", Str.fromInt(k))), pct(fpre(prefix, i), "pl"), Str.fromInt(k))

def fieldCell2(lhs: String, pl: String, k: String): String =
  line(Str.concat(lhs, Str.concat("call ptr @sz_list_at(ptr ", Str.concat(pl, Str.concat(", i64 ", Str.concat(k, ")"))))))

def fieldUnbox(prefix: String, i: Int, k: Int): String =
  fieldUnbox2(tmp(fpre(prefix, i), Str.concat("b", Str.fromInt(k))), pct(fpre(prefix, i), Str.concat("c", Str.fromInt(k))))

def fieldUnbox2(lhs: String, cell: String): String =
  line(Str.concat(lhs, Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(cell, ")"))))

def hasComma(s: String): Bool =
  commaAt(s, 0) >= 0

def emitPayload2(prefix: String, i: Int, scrut: String, isInt: Bool): String =
  join(line(Str.concat(tmp(fpre(prefix, i), "pl"), Str.concat("call ptr @sz_adt_payload(ptr ", Str.concat(scrut, ")")))), if (isInt) line(Str.concat(tmp(fpre(prefix, i), "b0"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(fpre(prefix, i), "pl"), ")")))) else "")

def emitOks(arms: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], i: Int, tys: List[String]): (String, List[String], Bool) =
  if (List.isEmpty(arms)) ("", noStr(), true) else emitOks0(List.head(arms), List.tail(arms), prefix, strs, defs, ens, ps, i, tys)

def emitOks0(arm: Arm, rest: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], i: Int, tys: List[String]): (String, List[String], Bool) =
  arm match {
    case Arm(pat, _, body) => emitOks1(emitOkSlotPat(pat, body, prefix, strs, defs, ens, ps, i, tys), rest, prefix, strs, defs, ens, ps, i, tys)
  }

def emitOkSlotPat(pat: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], i: Int, tys: List[String]): Slot =
  if (isTuplePat(pat)) emitOkTuple(pat, body, prefix, strs, defs, ens, ps, i, tys) else if (hasComma(patBind(pat))) emitOkFields(pat, body, prefix, strs, defs, ens, ps, i) else emitOkSlotBind(patBind(pat), bindIsInt(pat, ens), body, prefix, strs, defs, ens, ps, i)

def emitOkFields(pat: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], i: Int): Slot =
  emitOkOwned(emitOkRetainNs(splitPat(patBind(pat)), payloadTys(ens, patCore(pat)), prefix, i, 0, emitExpr(rewriteFields(splitPat(patBind(pat)), body, prefix, i, 0, payloadTys(ens, patCore(pat))), Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, ps)), ps)

def emitOkRetainNs(ns: List[String], fts: List[String], prefix: String, i: Int, k: Int, s: Slot): Slot =
  if (List.isEmpty(ns)) s else emitOkRetainNs(List.tail(ns), fts, prefix, i, k + 1, emitOkRetainK(fts, prefix, i, k, s))

def emitOkRetainK(fts: List[String], prefix: String, i: Int, k: Int, s: Slot): Slot =
  if (slotInt(fts, k)) s else emitOkSlot3(s, Str.concat("%", fieldStem(prefix, i, k, false)))

def emitOkOwned(s: Slot, ps: List[Param]): Slot =
  s match {
    case Slot(code, val, owned) => if (owned || isIntSsa(val) || !isPtrSlot(val, ps)) s else Slot(join(code, retPtr(val)), val, true)
  }

def rewriteFields(ns: List[String], body: Expr, prefix: String, i: Int, k: Int, fts: List[String]): Expr =
  if (List.isEmpty(ns)) body else rewriteFields(List.tail(ns), rewriteBind(body, List.head(ns), fieldStem(prefix, i, k, slotInt(fts, k))), prefix, i, k + 1, fts)

def fieldStem(prefix: String, i: Int, k: Int, isInt: Bool): String =
  Str.concat(fpre(prefix, i), Str.concat(if (isInt) "_b" else "_c", Str.fromInt(k)))

def emitOkTuple(pat: String, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], i: Int, tys: List[String]): Slot =
  emitOkOwned(emitExpr(rewriteTuple(pat, body, prefix, i, tys), Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, ps), ps)

def rewriteTuple(pat: String, body: Expr, prefix: String, i: Int, tys: List[String]): Expr =
  rewriteTupleAt(splitPat(Str.slice(pat, 1, Str.len(pat) - 1)), body, ppre(prefix, i), i + 1, tys)

def rewriteTupleAt(ns: List[String], body: Expr, pre: String, sid: Int, tys: List[String]): Expr =
  if (List.isEmpty(ns)) body else rewriteTupleAt1(List.head(ns), List.tail(ns), body, pre, sid, tys)

def rewriteTupleAt1(n: String, rest: List[String], body: Expr, pre: String, sid: Int, tys: List[String]): Expr =
  if (List.isEmpty(rest)) rewriteBind(body, n, rightStem(pre, sid, tys)) else rewriteTupleAt2(n, List.head(rest), List.tail(rest), body, pre, sid, tys)

def rewriteTupleAt2(n: String, n2: String, more: List[String], body: Expr, pre: String, sid: Int, tys: List[String]): Expr =
  if (List.isEmpty(more)) rewriteBind(rewriteBind(body, n, leftStem(pre, sid, tys)), n2, rightStem(pre, sid, tys)) else rewriteTupleAt1(n2, more, rewriteBind(body, n, leftStem(pre, sid, tys)), Str.concat(pre, Str.concat("_n", Str.fromInt(sid))), sid + 1, if (List.isEmpty(tys)) tys else List.tail(tys))

def leftStem(pre: String, sid: Int, tys: List[String]): String =
  Str.concat(pre, Str.concat(if (slotInt(tys, 0)) "_tvl" else "_tl", Str.fromInt(sid)))

def rightStem(pre: String, sid: Int, tys: List[String]): String =
  Str.concat(pre, Str.concat(if (slotInt(tys, 1) || List.isEmpty(tys)) "_tv" else "_tr", Str.fromInt(sid)))

def tupleName(pat: String, n: Int): String =
  tupleNameAt(splitPat(Str.slice(pat, 1, Str.len(pat) - 1)), n)

def splitPat(s: String): List[String] =
  splitPatAt(s, commaAt(s, 0))

def commaAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 44) i else commaAt(s, i + 1)

def splitPatAt(s: String, c: Int): List[String] =
  if (c < 0) trimPat(s) :: noStr() else trimPat(Str.slice(s, 0, c)) :: splitPat(Str.slice(s, c + 1, Str.len(s)))

def trimPat(s: String): String =
  trimPat2(s, 0, Str.len(s))

def trimPat2(s: String, a: Int, b: Int): String =
  if (a >= b) "" else if (Str.charAt(s, a) == 32) trimPat2(s, a + 1, b) else if (Str.charAt(s, b - 1) == 32) trimPat2(s, a, b - 1) else Str.slice(s, a, b)

def tupleNameAt(xs: List[String], n: Int): String =
  if (List.isEmpty(xs)) "" else if (n == 0) List.head(xs) else tupleNameAt(List.tail(xs), n - 1)

def emitOkSlotBind(bind: String, isInt: Bool, body: Expr, prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], i: Int): Slot =
  if (bind == "") emitOkSlot2(emitExpr(body, Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, ps), true, isInt, prefix, i) else emitOkSlot2(emitExpr(rewriteBind(body, bind, bindStem(prefix, i, isInt)), Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, ps), false, isInt, prefix, i)

def emitOkSlot2(s: Slot, empty: Bool, isInt: Bool, prefix: String, i: Int): Slot =
  if (empty || isInt) s else emitOkSlot3(s, Str.concat("%", bindStem(prefix, i, false)))

def emitOkSlot3(s: Slot, bind: String): Slot =
  s match {
    case Slot(code, val, owned) => Slot(join(retPtr(bind), code), val, owned || val == bind)
  }

def rewriteBind(e: Expr, from: String, to: String): Expr =
  if (from == "") e else rewriteBind1(e, from, to)

def rewriteBind1(e: Expr, from: String, to: String): Expr =
  e match {
    case Expr.EVar(s) => if (s == from) Expr.EVar(to) else Expr.EVar(s)
    case Expr.EPrint(inner) => Expr.EPrint(rewriteBind(inner, from, to))
    case Expr.ECall(f, args) => Expr.ECall(f, rewriteBindList(args, from, to))
    case Expr.EMethod(recv, name, args) => Expr.EMethod(rewriteBind(recv, from, to), name, rewriteBindList(args, from, to))
    case Expr.EField(recv, name) => Expr.EField(rewriteBind(recv, from, to), name)
    case Expr.EBin(op, l, r) => Expr.EBin(op, rewriteBind(l, from, to), rewriteBind(r, from, to))
    case Expr.EUn(op, inner) => Expr.EUn(op, rewriteBind(inner, from, to))
    case Expr.ELam(p, body) => Expr.ELam(p, rewriteBind(body, from, to))
    case Expr.EIf(c, t, el) => Expr.EIf(rewriteBind(c, from, to), rewriteBind(t, from, to), rewriteBind(el, from, to))
    case Expr.EMatch(s, arms) => Expr.EMatch(rewriteBind(s, from, to), rewriteBindArms(arms, from, to))
    case Expr.EList(xs) => Expr.EList(rewriteBindList(xs, from, to))
    case Expr.ETuple(xs) => Expr.ETuple(rewriteBindList(xs, from, to))
    case Expr.ENamed(n, inner) => Expr.ENamed(n, rewriteBind(inner, from, to))
    case Expr.EFor(bs, body) => Expr.EFor(bs, rewriteBind(body, from, to))
    case Expr.EInt(n) => Expr.EInt(n)
    case Expr.EBool(b) => Expr.EBool(b)
    case Expr.EStr(s) => Expr.EStr(s)
    case Expr.EFloat(s) => Expr.EFloat(s)
    case Expr.EInterp(s) => Expr.EInterp(s)
    case Expr.EHole => Expr.EHole
    case Expr.EUnit => Expr.EUnit
  }

def rewriteBindList(xs: List[Expr], from: String, to: String): List[Expr] =
  if (List.isEmpty(xs)) xs else rewriteBindList2(List.head(xs), List.tail(xs), from, to)

def rewriteBindList2(h: Expr, t: List[Expr], from: String, to: String): List[Expr] =
  rewriteBind(h, from, to) :: rewriteBindList(t, from, to)

def rewriteBindArms(arms: List[Arm], from: String, to: String): List[Arm] =
  if (List.isEmpty(arms)) arms else rewriteBindArms2(List.head(arms), List.tail(arms), from, to)

def rewriteBindArms2(h: Arm, t: List[Arm], from: String, to: String): List[Arm] =
  rewriteBindArm(h, from, to) :: rewriteBindArms(t, from, to)

def rewriteBindArm(arm: Arm, from: String, to: String): Arm =
  arm match {
    case Arm(pat, g, body) => Arm(pat, g, rewriteBind(body, from, to))
  }

def emitOks1(s: Slot, rest: List[Arm], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], i: Int, tys: List[String]): (String, List[String], Bool) =
  s match {
    case Slot(code, val, owned) => emitOks2(val, owned, code, emitOks(rest, prefix, strs, defs, ens, ps, i + 1, tys), prefix, i)
  }

def emitOks2(val: String, owned: Bool, code: String, p: (String, List[String], Bool), prefix: String, i: Int): (String, List[String], Bool) =
  p match {
    case (restCode, vals, _) => (join(emitOkBody(code, prefix, i), restCode), val :: vals, owned)
  }

def emitOkBody(code: String, prefix: String, i: Int): String =
  join(lab(Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))), join(code, join(line(Str.concat("br label %", Str.concat(prefix, Str.concat("_aj_0_", Str.fromInt(i))))), join(lab(Str.concat(prefix, Str.concat("_aj_0_", Str.fromInt(i)))), line(Str.concat("br label %", Str.concat(prefix, "_merge_0")))))))

def emitMatchPhi(vals: List[String], owned: Bool, prefix: String, exh: Bool): String =
  join(lab(Str.concat(prefix, "_merge_0")), line(Str.concat(tmp(prefix, "phi"), emitMatchPhi2(vals, owned, prefix, exh))))

def emitMatchPhi2(vals: List[String], owned: Bool, prefix: String, exh: Bool): String =
  Str.concat("phi ", Str.concat(if (owned) "ptr" else "i64", Str.concat(" ", Str.concat(phiParts(vals, prefix, 0), if (exh) "" else phiTail(owned, prefix)))))

def phiParts(vals: List[String], prefix: String, i: Int): String =
  if (List.isEmpty(vals)) "" else if (List.len(vals) == 1) phiOne(List.head(vals), prefix, i) else Str.concat(phiOne(List.head(vals), prefix, i), Str.concat(", ", phiParts(List.tail(vals), prefix, i + 1)))

def phiOne(v: String, prefix: String, i: Int): String =
  Str.concat("[ ", Str.concat(v, Str.concat(", %", Str.concat(prefix, Str.concat("_aj_0_", Str.concat(Str.fromInt(i), " ]"))))))

def phiTail(owned: Bool, prefix: String): String =
  if (owned) Str.concat(", [ null, %", Str.concat(prefix, "_default_0 ]")) else Str.concat(", [ ", Str.concat(pct(prefix, "dflt"), Str.concat(", %", Str.concat(prefix, "_default_0 ]"))))

def llvmRet(ret: String): String =
  if (ret == "Int" || ret == "Bool") "i64" else "ptr"

def isI64Ty(t: String): Bool =
  t == "Int" || t == "Bool"

def defParams(d: Fun): String =
  defParams2(d.params)

def defParams2(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) oneParam(List.head(ps)) else Str.concat(oneParam(List.head(ps)), Str.concat(", ", defParams2(List.tail(ps))))

def oneParam(p: Param): String =
  if (isI64Ty(p.ty)) Str.concat("i64 %", p.name) else Str.concat("ptr %", p.name)

def emitDefs(ds: List[Fun], strs: List[String], all: List[Fun], ens: List[En]): String =
  if (List.isEmpty(ds)) "" else Str.concat(emitDef(List.head(ds), strs, all, ens), emitDefs(List.tail(ds), strs, all, ens))

def emitDef2(d: Fun, body: Slot): String =
  d match {
    case Fun(_, name, _, params, ret, _, mod) => emitDef3(llvmRet(ret), symOf(mod, name), defParams2(params), body)
  }

def emitDef3(ty: String, name: String, params: String, body: Slot): String =
  Str.concat("define internal ", Str.concat(ty, Str.concat(" @sz_user_", Str.concat(name, emitDefSig(params, ty, body)))))

def emitDefSig(params: String, ty: String, body: Slot): String =
  Str.concat("(", Str.concat(params, Str.concat(") {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), emitDef4(ty, body)))))))

def emitDef4(ty: String, body: Slot): String =
  body match {
    case Slot(code, val, owned) => emitDef5(ty, code, val, ty == "ptr" && !owned)
  }

def emitDef5(ty: String, code: String, val: String, keep: Bool): String =
  Str.concat(code, Str.concat(if (keep) retPtr(val) else "", Str.concat("  ret ", Str.concat(ty, Str.concat(" ", Str.concat(val, Str.concat(nl(), Str.concat("}", Str.concat(nl(), nl())))))))))

def emitFromInt(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_from_int(i64 ", Str.concat(if (List.isEmpty(vals)) "0" else List.head(vals), ")"))))), pct(prefix, "v"), true)

def i64Args(vals: List[String]): String =
  if (List.isEmpty(vals)) "" else if (List.len(vals) == 1) Str.concat("i64 ", List.head(vals)) else Str.concat("i64 ", Str.concat(List.head(vals), Str.concat(", ", i64Args(List.tail(vals)))))

def emitDef(d: Fun, strs: List[String], defs: List[Fun], ens: List[En]): String =
  emitDefRw(rwDef(d, defs, ens), strs, defs, ens)

def emitDefRw(d: Fun, strs: List[String], defs: List[Fun], ens: List[En]): String =
  emitDef2(d, emitExpr(d.body, "body", strs, defs, ens, d.params))

def rwDef(d: Fun, defs: List[Fun], ens: List[En]): Fun =
  d match {
    case Fun(priv, name, ts, ps, ret, body, mod) => Fun(priv, name, ts, ps, ret, rwFields(body, paramEnv(ps), defs, ens, mod), mod)
  }

def paramEnv(ps: List[Param]): List[(String, String)] =
  if (List.isEmpty(ps)) noEnv() else paramEnv1(List.head(ps), List.tail(ps))

def paramEnv1(p: Param, rest: List[Param]): List[(String, String)] =
  p match {
    case Param(n, ty, _, _) => (n, ty) :: paramEnv(rest)
  }

def rwFields(e: Expr, env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String): Expr =
  e match {
    case Expr.EPrint(inner) => Expr.EPrint(rwFields(inner, env, funs, ens, mod))
    case Expr.ECall(f, args) => rwCall(f, rwFieldList(args, env, funs, ens, mod), funs, mod)
    case Expr.EMethod(recv, name, args) => Expr.EMethod(rwFields(recv, env, funs, ens, mod), name, rwFieldList(args, env, funs, ens, mod))
    case Expr.EField(recv, name) => rwField(rwFields(recv, env, funs, ens, mod), name, env, funs, ens)
    case Expr.EBin(op, l, r) => Expr.EBin(op, rwFields(l, env, funs, ens, mod), rwFields(r, env, funs, ens, mod))
    case Expr.EUn(op, inner) => Expr.EUn(op, rwFields(inner, env, funs, ens, mod))
    case Expr.ELam(p, body) => Expr.ELam(p, rwFields(body, env, funs, ens, mod))
    case Expr.EIf(c, t, el) => Expr.EIf(rwFields(c, env, funs, ens, mod), rwFields(t, env, funs, ens, mod), rwFields(el, env, funs, ens, mod))
    case Expr.EMatch(s, arms) => Expr.EMatch(rwFields(s, env, funs, ens, mod), rwFieldArms(arms, env, funs, ens, mod))
    case Expr.EList(xs) => Expr.EList(rwFieldList(xs, env, funs, ens, mod))
    case Expr.ETuple(xs) => Expr.ETuple(rwFieldList(xs, env, funs, ens, mod))
    case Expr.ENamed(n, inner) => Expr.ENamed(n, rwFields(inner, env, funs, ens, mod))
    case Expr.EFor(bs, body) => Expr.EFor(bs, rwFields(body, env, funs, ens, mod))
    case _ => e
  }

def rwCall(f: String, args: List[Expr], funs: List[Fun], mod: String): Expr =
  if (List.isEmpty(findDefMod(funs, mod, f))) Expr.ECall(f, args) else Expr.EMethod(Expr.EVar(mod), f, args)

def rwFieldList(xs: List[Expr], env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String): List[Expr] =
  if (List.isEmpty(xs)) noExpr() else rwFields(List.head(xs), env, funs, ens, mod) :: rwFieldList(List.tail(xs), env, funs, ens, mod)

def rwFieldArms(arms: List[Arm], env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String): List[Arm] =
  if (List.isEmpty(arms)) noArm() else rwFieldArm(List.head(arms), env, funs, ens, mod) :: rwFieldArms(List.tail(arms), env, funs, ens, mod)

def rwFieldArm(a: Arm, env: List[(String, String)], funs: List[Fun], ens: List[En], mod: String): Arm =
  a match {
    case Arm(pat, g, body) => Arm(pat, g, rwFields(body, env, funs, ens, mod))
  }

def rwField(recv: Expr, name: String, env: List[(String, String)], funs: List[Fun], ens: List[En]): Expr =
  recv match {
    case Expr.EVar(en) => if (hasEn(ens, en)) Expr.EField(recv, name) else rwFieldTy(recv, name, infer(recv, env, funs, ens).ty, ens)
    case _ => rwFieldTy(recv, name, infer(recv, env, funs, ens).ty, ens)
  }

def rwFieldTy(recv: Expr, name: String, ty: String, ens: List[En]): Expr =
  if (isTupTy(ty)) tupField(recv, name, ty) else recField(recv, name, recNames(ens, ty), ty, ens)

def isTupTy(ty: String): Bool =
  Str.len(ty) > 0 && Str.charAt(ty, 0) == 40

def tupField(recv: Expr, name: String, ty: String): Expr =
  tupField2(recv, tupIdx(name), splitPat(Str.slice(ty, 1, Str.len(ty) - 1)))

def tupField2(recv: Expr, idx: Int, ns: List[String]): Expr =
  if (List.isEmpty(ns)) Expr.EMatch(recv, Arm("(__f0, __f1)", "", Expr.EVar(if (idx == 0) "__f0" else "__f1")) :: noArm()) else Expr.EMatch(recv, Arm(Str.concat("(", Str.concat(bindsComma(0, List.len(ns)), ")")), "", Expr.EVar(fakeBind(idx))) :: noArm())

def tupIdx(name: String): Int =
  if (name == "_1") 0 else if (name == "_2") 1 else if (name == "_3") 2 else if (name == "_4") 3 else 1

def recField(recv: Expr, name: String, ns: List[String], ty: String, ens: List[En]): Expr =
  if (List.isEmpty(ns)) Expr.EField(recv, name) else recField2(recv, nameIdx(ns, name, 0), List.len(ns), ty, recTys(ens, ty))

def recField2(recv: Expr, idx: Int, n: Int, ty: String, tys: List[String]): Expr =
  if (idx < 0) Expr.EInt(0) else Expr.EMatch(recv, Arm(Str.concat(ty, Str.concat("(", Str.concat(bindsTyped(0, n, tys), ")"))), "", Expr.EVar(pickBind(idx, tys))) :: noArm())

def bindsTyped(i: Int, n: Int, tys: List[String]): String =
  if (i >= n) "" else if (i + 1 == n) pickBind(i, tys) else Str.concat(pickBind(i, tys), Str.concat(", ", bindsTyped(i + 1, n, tys)))

def pickBind(idx: Int, tys: List[String]): String =
  if (slotInt(tys, idx)) intBind(idx) else fakeBind(idx)

def intBind(i: Int): String =
  Str.concat(fakeBind(i), "_b0")

def recNames(ens: List[En], ty: String): List[String] =
  if (List.isEmpty(ens)) noStr() else recNames1(List.head(ens), List.tail(ens), ty)

def recNames1(h: En, rest: List[En], ty: String): List[String] =
  h match {
    case En(_, n, _, cases) => if (n == ty) recNames2(cases) else recNames(rest, ty)
  }

def recNames2(cs: List[EnCase]): List[String] =
  if (List.isEmpty(cs)) noStr() else recNames3(List.head(cs))

def recNames3(c: EnCase): List[String] =
  c match {
    case EnCase(_, fs) => paramNames(fs)
  }

def recTys(ens: List[En], ty: String): List[String] =
  if (List.isEmpty(ens)) noStr() else recTys1(List.head(ens), List.tail(ens), ty)

def recTys1(h: En, rest: List[En], ty: String): List[String] =
  h match {
    case En(_, n, _, cases) => if (n == ty) recTys2(cases) else recTys(rest, ty)
  }

def recTys2(cs: List[EnCase]): List[String] =
  if (List.isEmpty(cs)) noStr() else recTys3(List.head(cs))

def recTys3(c: EnCase): List[String] =
  c match {
    case EnCase(_, fs) => paramTys(fs)
  }

def paramTys(fs: List[Param]): List[String] =
  if (List.isEmpty(fs)) noStr() else paramTys1(List.head(fs), List.tail(fs))

def paramTys1(p: Param, rest: List[Param]): List[String] =
  p match {
    case Param(_, ty, _, _) => ty :: paramTys(rest)
  }

def paramNames(fs: List[Param]): List[String] =
  if (List.isEmpty(fs)) noStr() else paramNames1(List.head(fs), List.tail(fs))

def paramNames1(p: Param, rest: List[Param]): List[String] =
  p match {
    case Param(n, _, _, _) => n :: paramNames(rest)
  }

def nameIdx(ns: List[String], name: String, i: Int): Int =
  if (List.isEmpty(ns)) 0 - 1 else if (List.head(ns) == name) i else nameIdx(List.tail(ns), name, i + 1)

def fakeBind(i: Int): String =
  Str.concat("__f", Str.fromInt(i))

def bindsComma(i: Int, n: Int): String =
  if (i >= n) "" else if (i + 1 == n) fakeBind(i) else Str.concat(fakeBind(i), Str.concat(", ", bindsComma(i + 1, n)))

def emitMain(body: Expr, strs: List[String], defs: List[Fun], ens: List[En]): String =
  emitMain2(emitExpr(rwFields(body, noEnv(), defs, ens, "Main"), "build", strs, defs, ens, noParam()))

def emitMain2(s: Slot): String =
  Str.concat("define i32 @main(i32 %argc, ptr %argv) {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), Str.concat(s.code, Str.concat("  %rc = call i32 @sz_runtime_main_args(ptr ", Str.concat(s.val, Str.concat(", i32 %argc, ptr %argv)", Str.concat(nl(), Str.concat("  ret i32 %rc", Str.concat(nl(), "}")))))))))))

def emitProg(p: Prog, strs: List[String]): String =
  p match {
    case Prog(_, enums, _, _, _, _, defs, _, body) => emitBits(body, defs, strs, enums)
  }

def emitBits(body: Expr, defs: List[Fun], strs: List[String], ens: List[En]): String =
  Str.concat(emitConsts(strs, 0), Str.concat(if (List.isEmpty(strs)) "" else nl(), Str.concat(emitConts(body, strs, defs, ens), Str.concat(emitDefs(defs, strs, defs, ens), emitMain(body, strs, defs, ens)))))

def fmCount(e: Expr): Int =
  e match {
    case Expr.EMethod(recv, name, args) => if (name == "flatMap") fmCount(recv) + 1 + fmCountArgs(args) else fmCount(recv) + fmCountArgs(args)
    case Expr.EPrint(inner) => fmCount(inner)
    case Expr.ELam(_, body) => fmCount(body)
    case Expr.ECall(_, args) => fmCountArgs(args)
    case Expr.EBin(_, l, r) => fmCount(l) + fmCount(r)
    case Expr.EUn(_, inner) => fmCount(inner)
    case Expr.EIf(c, t, el) => fmCount(c) + fmCount(t) + fmCount(el)
    case Expr.ENamed(_, inner) => fmCount(inner)
    case Expr.EMatch(s, arms) => fmCount(s) + fmCountArms(arms)
    case Expr.EList(xs) => fmCountArgs(xs)
    case Expr.ETuple(xs) => fmCountArgs(xs)
    case _ => 0
  }

def fmCountArms(arms: List[Arm]): Int =
  if (List.isEmpty(arms)) 0 else fmCount(List.head(arms).body) + fmCountArms(List.tail(arms))

def fmCountArgs(xs: List[Expr]): Int =
  if (List.isEmpty(xs)) 0 else fmCount(List.head(xs)) + fmCountArgs(List.tail(xs))

def lamBody(args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EUnit else lamBody1(List.head(args))

def lamBody1(e: Expr): Expr =
  e match {
    case Expr.ELam(_, body) => body
    case _ => e
  }

def emitFm(recv: Expr, args: List[Expr], prefix: String, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param]): Slot =
  emitFm2(emitExpr(recv, Str.concat(prefix, "_in"), strs, defs, ens, ps), prefix, fmCount(recv) + fmCountArgs(args))

def emitFm2(inner: Slot, prefix: String, id: Int): Slot =
  Slot(join(inner.code, join(line(Str.concat(tmp(prefix, "fm"), Str.concat("call ptr @sz_io_flatmap(ptr ", Str.concat(inner.val, Str.concat(", ptr @sz_cont_", Str.concat(Str.fromInt(id), ", ptr null)")))))), join(line(Str.concat("call void @sz_release(ptr ", Str.concat(inner.val, ")"))), line("call void @sz_release(ptr null)")))), pct(prefix, "fm"), false)

def emitOneCont(id: Int, body: Expr, strs: List[String], defs: List[Fun], ens: List[En], ps: List[Param], bind: String): String =
  emitOneCont2(id, emitExpr(rewriteBind(body, bind, "value"), Str.concat("c", Str.fromInt(id)), strs, defs, ens, ps))

def emitOneCont2(id: Int, s: Slot): String =
  Str.concat("define internal ptr @sz_cont_", Str.concat(Str.fromInt(id), Str.concat("(ptr %value, ptr %env) {", Str.concat(nl(), Str.concat("entry:", Str.concat(nl(), Str.concat(s.code, Str.concat("  ret ptr ", Str.concat(s.val, Str.concat(nl(), Str.concat("}", Str.concat(nl(), nl()))))))))))))

def emitConts(e: Expr, strs: List[String], defs: List[Fun], ens: List[En]): String =
  emitContsAt(e, strs, defs, ens, 0)._1

def emitContsAt(e: Expr, strs: List[String], defs: List[Fun], ens: List[En], id: Int): (String, Int) =
  e match {
    case Expr.EMethod(recv, name, args) => if (name == "flatMap") emitContsFm(recv, args, strs, defs, ens, id) else emitContsCtor(recv, args, strs, defs, ens, id)
    case Expr.EPrint(inner) => emitContsAt(inner, strs, defs, ens, id)
    case Expr.ELam(_, body) => emitContsAt(body, strs, defs, ens, id)
    case Expr.ECall(_, args) => emitContsArgs(args, strs, defs, ens, id)
    case Expr.EIf(c, t, el) => emitContsIf(c, t, el, strs, defs, ens, id)
    case Expr.ENamed(_, inner) => emitContsAt(inner, strs, defs, ens, id)
    case Expr.EBin(_, l, r) => emitContsIf(l, r, Expr.EUnit, strs, defs, ens, id)
    case Expr.EUn(_, inner) => emitContsAt(inner, strs, defs, ens, id)
    case Expr.EField(recv, _) => emitContsAt(recv, strs, defs, ens, id)
    case Expr.EMatch(s, arms) => emitContsMatch(s, arms, strs, defs, ens, id)
    case Expr.EList(xs) => emitContsArgs(xs, strs, defs, ens, id)
    case Expr.ETuple(xs) => emitContsArgs(xs, strs, defs, ens, id)
    case _ => ("", id)
  }

def emitContsCtor(recv: Expr, args: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], id: Int): (String, Int) =
  emitContsCtor2(emitContsAt(recv, strs, defs, ens, id), args, strs, defs, ens)

def emitContsCtor2(p: (String, Int), args: List[Expr], strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArgs(args, strs, defs, ens, id))
  }

def emitContsMatch(s: Expr, arms: List[Arm], strs: List[String], defs: List[Fun], ens: List[En], id: Int): (String, Int) =
  emitContsMatch2(emitContsAt(s, strs, defs, ens, id), arms, strs, defs, ens)

def emitContsMatch2(p: (String, Int), arms: List[Arm], strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArmList(arms, strs, defs, ens, id))
  }

def emitContsArmList(arms: List[Arm], strs: List[String], defs: List[Fun], ens: List[En], id: Int): (String, Int) =
  if (List.isEmpty(arms)) ("", id) else emitContsArmList2(emitContsAt(List.head(arms).body, strs, defs, ens, id), List.tail(arms), strs, defs, ens)

def emitContsArmList2(p: (String, Int), rest: List[Arm], strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArmList(rest, strs, defs, ens, id))
  }

def emitContsFm(recv: Expr, args: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], id: Int): (String, Int) =
  emitContsFm2(emitContsAt(recv, strs, defs, ens, id), lamArg(args), strs, defs, ens)

def lamArg(args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EUnit else List.head(args)

def emitContsFm2(p: (String, Int), lam: Expr, strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  p match {
    case (code, id) => emitContsFm3(code, id, lam, strs, defs, ens)
  }

def emitContsFm3(code: String, id: Int, lam: Expr, strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  lam match {
    case Expr.ELam(p, body) => (join(code, emitOneCont(id, body, strs, defs, ens, noParam(), p)), id + 1)
    case _ => (join(code, emitOneCont(id, lam, strs, defs, ens, noParam(), "")), id + 1)
  }

def emitContsArgs(xs: List[Expr], strs: List[String], defs: List[Fun], ens: List[En], id: Int): (String, Int) =
  if (List.isEmpty(xs)) ("", id) else emitContsArgs2(emitContsAt(List.head(xs), strs, defs, ens, id), List.tail(xs), strs, defs, ens)

def emitContsArgs2(p: (String, Int), rest: List[Expr], strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArgs(rest, strs, defs, ens, id))
  }

def emitContsArgs3(code: String, p: (String, Int)): (String, Int) =
  p match {
    case (rest, id) => (join(code, rest), id)
  }

def emitContsIf(c: Expr, t: Expr, el: Expr, strs: List[String], defs: List[Fun], ens: List[En], id: Int): (String, Int) =
  emitContsIf2(emitContsAt(c, strs, defs, ens, id), t, el, strs, defs, ens)

def emitContsIf2(p: (String, Int), t: Expr, el: Expr, strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  p match {
    case (code, id) => emitContsIf3(code, emitContsAt(t, strs, defs, ens, id), el, strs, defs, ens)
  }

def emitContsIf3(code: String, p: (String, Int), el: Expr, strs: List[String], defs: List[Fun], ens: List[En]): (String, Int) =
  p match {
    case (rest, id) => emitContsArgs3(join(code, rest), emitContsAt(el, strs, defs, ens, id))
  }

def emit(src: String): String =
  emitProg(Parse.parse(Lexer.lex(src)), collectToks(Lexer.lex(src), noStr()))

def internFiles(files: List[(String, String)], acc: List[String]): List[String] =
  if (List.isEmpty(files)) acc else internFiles2(List.head(files), List.tail(files), acc)

def internFiles2(f: (String, String), rest: List[(String, String)], acc: List[String]): List[String] =
  f match {
    case (_, src) => internFiles(rest, collectToks(Lexer.lex(src), acc))
  }

def emitFiles(files: List[(String, String)]): String =
  emitProg(Parse.parseFiles(files), internFiles(files, noStr()))

def emitFullFiles(files: List[(String, String)]): String =
  Str.concat(preamble(), emitFiles(files))

def decl(s: String): String =
  Str.concat("declare ", Str.concat(s, nl()))

def preamble(): String =
  Str.concat("; Scuzz Lang generated LLVM IR", Str.concat(nl(), Str.concat(nl(), decls())))

def decls(): String =
  join(declsA(), join(declsB(), join(declsC(), join(declsD(), join(declsE(), join(declsF(), nl()))))))

def declsA(): String =
  join(decl("ptr @sz_string_from_cstr(ptr)"), join(decl("void @sz_retain(ptr)"), join(decl("void @sz_release(ptr)"), join(decl("ptr @sz_string_from_int(i64)"), join(decl("ptr @sz_string_concat(ptr, ptr)"), join(decl("ptr @sz_adt_new(i32, ptr)"), join(decl("i32 @sz_adt_tag(ptr)"), decl("ptr @sz_box_i64(i64)"))))))))

def declsB(): String =
  join(decl("ptr @sz_list_nil()"), join(decl("ptr @sz_list_cons(ptr, ptr)"), join(decl("i64 @sz_list_len(ptr)"), join(decl("ptr @sz_list_concat(ptr, ptr)"), join(decl("ptr @sz_list_reverse(ptr)"), join(decl("ptr @sz_io_println(ptr)"), join(decl("ptr @sz_io_flatmap(ptr, ptr, ptr)"), decl("i32 @sz_runtime_main_args(ptr, i32, ptr)"))))))))

def declsC(): String =
  join(decl("ptr @sz_adt_payload(ptr)"), join(decl("i64 @sz_unbox_i64(ptr)"), join(decl("ptr @sz_list_head(ptr)"), join(decl("ptr @sz_list_tail(ptr)"), join(decl("i32 @sz_list_is_empty(ptr)"), decl("ptr @sz_list_at(ptr, i64)"))))))

def declsD(): String =
  join(decl("i32 @sz_string_eq(ptr, ptr)"), join(decl("i32 @sz_ptr_eq(ptr, ptr)"), join(decl("i64 @sz_string_len(ptr)"), join(decl("i64 @sz_string_char_at(ptr, i64)"), join(decl("ptr @sz_string_slice(ptr, i64, i64)"), join(decl("ptr @sz_builder_new()"), join(decl("ptr @sz_builder_append(ptr, ptr)"), decl("ptr @sz_builder_result(ptr)"))))))))

def declsE(): String =
  join(decl("i64 @sz_string_to_int(ptr, i64)"), join(decl("ptr @sz_string_repeat(ptr, i64)"), join(decl("i64 @sz_string_starts_with(ptr, ptr)"), join(decl("ptr @sz_pair_new(ptr, ptr)"), join(decl("ptr @sz_pair_left(ptr)"), decl("ptr @sz_pair_right(ptr)"))))))

def declsF(): String =
  join(decl("ptr @sz_fs_read(ptr)"), decl("ptr @sz_fs_write(ptr, ptr)"))

def emitFull(src: String): String =
  Str.concat(preamble(), emit(src))

