  if (f == "View.textField") "sz_lang_view_text_field" else if (f == "View.checkbox") "sz_lang_view_checkbox" else if (f == "View.switch") "sz_lang_view_switch" else if (f == "View.chip") "sz_lang_view_chip" else if (f == "View.filterChip") "sz_lang_view_filter_chip" else if (f == "View.inputChip") "sz_lang_view_input_chip" else if (f == "View.checkboxListTile") "sz_lang_view_checkbox_list_tile" else if (f == "View.switchListTile") "sz_lang_view_switch_list_tile" else ""

