def emitNetServe(f: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (isNetTlsFiles(f)) emitNetFiles(f, args, prefix, strs, defs, ens, ps, loc) else emitNetServe2(netServeRt(f), emitExpr(List.at(args, 0), Str.concat(prefix, "_p"), strs, defs, ens, ps, loc), wrapPh(if (List.isEmpty(List.tail(args))) Expr.EUnit else List.at(List.tail(args), 0), ps, defs, modOfLoc(loc)), prefix, strs, defs, ens, ps, loc)

def isNetTlsFiles(f: String): Bool =
  f == "Net.serveTlsFiles" || f == "Net.serveOnceTlsFiles"

def netServeRt(f: String): String =
  if (f == "Net.serve") "sz_net_serve" else if (f == "Net.serveTls") "sz_net_serve_tls" else if (f == "Net.serveTlsFiles") "sz_net_serve_tls_files" else if (f == "Net.serveOnceTls") "sz_net_serve_once_tls" else if (f == "Net.serveOnceTlsFiles") "sz_net_serve_once_tls_files" else "sz_net_serve_once"

def emitNetFiles(f: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitNetFilesPort(netServeRt(f), emitExpr(List.at(args, 0), Str.concat(prefix, "_p"), strs, defs, ens, ps, loc), emitExpr(List.at(List.tail(args), 0), Str.concat(prefix, "_c"), strs, defs, ens, ps, loc), emitExpr(List.at(List.tail(List.tail(args)), 0), Str.concat(prefix, "_k"), strs, defs, ens, ps, loc), wrapPh(List.at(args, 3), ps, defs, modOfLoc(loc)), prefix, strs, defs, ens, ps, loc)

def emitNetFilesPort(rt: String, port: Slot, cert: Slot, key: Slot, lam: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  port match {
    case Slot(pc, pv, po) => emitNetFilesCert(rt, pc, pv, po, cert, key, lam, prefix, strs, defs, ens, ps, loc)
  }

def emitNetFilesCert(rt: String, pc: String, pv: String, po: Bool, cert: Slot, key: Slot, lam: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  cert match {
