def emitViewI64I64Ptr(rt: String, code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(i64 ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), Str.concat(", ptr ", Str.concat(arg2(vals), ")"))))))))))), pct(prefix, "v"), true)

def emitViewImage(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(viewImageCall(vals, prefix), if (headOwn(tailOwn(tailOwn(tailOwn(owns))))) relPtr(arg3(vals)) else "")), pct(prefix, "v"), true)

