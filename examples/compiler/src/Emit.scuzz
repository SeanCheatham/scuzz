def emitListSetAt(code: String, vals: List[String], owns: List[Bool], prefix: String, boxElem: Bool, isFloat: Bool): Slot =
  if (boxElem) emitListSetAt2(join(code, pairBoxTyped(arg2(vals), true, isFloat, prefix, "lb")), arg0(vals), arg1(vals), pct(prefix, "lb"), headOwn(owns), true, prefix) else emitListSetAt2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(tailOwn(owns))), prefix)

def emitListSetAt2(code: String, xs: String, i: String, v: String, ox: Bool, ov: Bool, prefix: String): Slot =
  Slot(join(code, join(listSetAtCall(xs, i, v, prefix), join(if (ox) relPtr(xs) else "", if (ov) relPtr(v) else ""))), pct(prefix, "v"), true)

def listSetAtCall(xs: String, i: String, v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_set_at(ptr ", Str.concat(xs, Str.concat(", i64 ", Str.concat(i, Str.concat(", ptr ", Str.concat(v, ")"))))))))

