  Slot(join(code, join(unpackFnPtr(arg1(vals), prefix), join(viewTapPtr(rt, arg0(vals), prefix), join(if (headOwn(owns)) relPtr(arg0(vals)) else "", if (headOwn(tailOwn(owns))) relPtr(arg1(vals)) else "")))), pct(prefix, "v"), true)

