def isTlKit(f: String): Bool =
  f == "Timeline.len" || f == "Timeline.signalInt" || f == "Timeline.signalListLen" || (f == "Timeline.signalStrHas" || f == "Timeline.fileTextIs" || f == "Timeline.fileSame") || tlHasRt(f) != "" || tlI64Rt(f) != "" || f == "Verdict.ok" || f == "Verdict.fail" || f == "Verdict.and" || f == "Verdict.or" || f == "Verdict.alwaysHas" || f == "Verdict.afterHit" || f == "Verdict.onHit"

def tlHasRt(f: String): String =
  if (f == "Timeline.a11yHas") "sz_timeline_a11y_has" else if (f == "Timeline.lastHitHas") "sz_timeline_last_hit_has" else if (f == "Timeline.hit") "sz_timeline_hit" else if (f == "Timeline.driveHas") "sz_timeline_drive_has" else if (f == "Timeline.effectHas") "sz_timeline_effect_has" else if (f == "Timeline.faultKindHas") "sz_timeline_fault_kind_has" else ""

def tlI64Rt(f: String): String =
  if (f == "Timeline.effectCount") "sz_timeline_effect_count" else if (f == "Timeline.fiberLive") "sz_timeline_fiber_live" else if (f == "Timeline.fiberReady") "sz_timeline_fiber_ready" else if (f == "Timeline.fiberParked") "sz_timeline_fiber_parked" else if (f == "Timeline.fiberDone") "sz_timeline_fiber_done" else if (f == "Timeline.faultN") "sz_timeline_fault_n" else if (f == "Timeline.checkpoint") "sz_timeline_checkpoint" else if (f == "Timeline.nearestCheckpoint") "sz_timeline_nearest_checkpoint" else ""

def emitTlKit(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "Timeline.len") emitTlLen(code, vals, prefix) else if (f == "Timeline.signalInt" || f == "Timeline.signalListLen") emitTlSigRt(tlSigRt(f), code, vals, owns, prefix) else if (f == "Timeline.fileSame") emitTlFileSame(code, vals, owns, prefix) else if (f == "Timeline.signalStrHas" || f == "Timeline.fileTextIs") emitTlStrHas(if (f == "Timeline.fileTextIs") "sz_timeline_file_text_is" else "sz_timeline_signal_str_has", code, vals, owns, prefix) else if (tlHasRt(f) != "") emitTlHas(tlHasRt(f), code, vals, owns, prefix) else if (tlI64Rt(f) != "") emitTlI64(tlI64Rt(f), code, vals, prefix) else if (f == "Verdict.ok") emitVOk(code, prefix) else if (f == "Verdict.fail") emitVFail(code, vals, prefix) else if (f == "Verdict.and") emitVBin("sz_verdict_and", code, vals, prefix) else if (f == "Verdict.alwaysHas") emitVStr1("sz_verdict_always_has", code, vals, owns, prefix) else if (f == "Verdict.afterHit") emitVStr2("sz_verdict_after_hit", code, vals, owns, prefix) else emitVBin("sz_verdict_or", code, vals, prefix)

