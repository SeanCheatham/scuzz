  if (f == "Property.check") emitPropCheck(code, vals, owns, prefix) else if (f == "Property.assert") emitPropAssert(code, vals, owns, prefix) else if (f == "Property.force") emitPropForce(code, vals, owns, prefix) else if (f == "Property.classify") emitPropClass(code, vals, owns, prefix) else if (f == "Property.a11yHas") emitPropA11y(code, vals, owns, prefix) else if (f == "Property.signalInt") emitPropI64("sz_property_signal_int", code, vals, owns, prefix) else if (f == "Property.signalListLen") emitPropI64("sz_property_signal_list_len", code, vals, owns, prefix) else if (f == "Property.signalStr") emitPropStr(code, vals, owns, prefix) else if (f == "Property.signalListAt") emitPropListAt(code, vals, owns, prefix) else emitPropCheck(code, vals, owns, prefix)

