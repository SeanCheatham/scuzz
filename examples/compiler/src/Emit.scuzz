  if (f == "View.button") "sz_lang_view_button" else if (f == "View.iconButton") "sz_lang_view_icon_button" else if (f == "View.fab") "sz_lang_view_fab" else if (f == "View.outlinedButton") "sz_lang_view_outlined_button" else if (f == "View.textButton") "sz_lang_view_text_button" else if (f == "View.actionChip") "sz_lang_view_action_chip" else if (f == "View.onSecondary") "sz_lang_view_on_secondary" else ""

