def emitStrEq(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitStrEq2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitStrEq2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(emitStrEqCall(prefix, a, b), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), false)

def emitStrEqCall(prefix: String, a: String, b: String): String =
  join(line(Str.concat(tmp(prefix, "eqi"), Str.concat("call i32 @sz_string_eq(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")")))))), line(Str.concat(tmp(prefix, "v"), Str.concat("zext i32 ", Str.concat(pct(prefix, "eqi"), " to i64")))))

def emitZipAllKit(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String, boxC: Bool, boxD: Bool, floatC: Bool, floatD: Bool): Slot =
  emitZipAllKit2(rt, join(code, join(pairBoxTyped(arg2(vals), boxC, floatC, prefix, "zc"), pairBoxTyped(arg3(vals), boxD, floatD, prefix, "zd"))), arg0(vals), arg1(vals), pairPtr(arg2(vals), boxC, prefix, "zc"), pairPtr(arg3(vals), boxD, prefix, "zd"), headOwn(owns), headOwn(tailOwn(owns)), boxC || headOwn(tailOwn(tailOwn(owns))), boxD || headOwn(tailOwn(tailOwn(tailOwn(owns)))), prefix)

def arg3(vals: List[String]): String =
  nthStrD(vals, 3, "null")

def emitZipAllKit2(rt: String, code: String, a: String, b: String, c: String, d: String, oa: Bool, ob: Bool, oc: Bool, od: Bool, prefix: String): Slot =
  Slot(join(code, join(zipAllCall(rt, prefix, a, b, c, d), join(if (oa) relPtr(a) else "", join(if (ob) relPtr(b) else "", join(if (oc) relPtr(c) else "", if (od) relPtr(d) else ""))))), pct(prefix, "v"), true)

def zipAllCall(rt: String, prefix: String, a: String, b: String, c: String, d: String): String =
  line(Str.concat(tmp(prefix, "v"), zipAllCall2(rt, a, b, c, d)))

def zipAllCall2(rt: String, a: String, b: String, c: String, d: String): String =
  Str.concat("call ptr @", Str.concat(rt, zipAllCall3(a, b, c, d)))

def zipAllCall3(a: String, b: String, c: String, d: String): String =
  Str.concat("(ptr ", Str.concat(a, zipAllCall4(b, c, d)))

def zipAllCall4(b: String, c: String, d: String): String =
  Str.concat(", ptr ", Str.concat(b, zipAllCall5(c, d)))

def zipAllCall5(c: String, d: String): String =
  Str.concat(", ptr ", Str.concat(c, zipAllCall6(d)))

def zipAllCall6(d: String): String =
  Str.concat(", ptr ", Str.concat(d, ")"))

