def emitUiKit(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "Color.rgb") emitColorRgb(code, vals, prefix) else if (f == "Color.rgba") emitColorRgba(code, vals, prefix) else if (Str.startsWith(f, "Theme.") || Str.startsWith(f, "Icon.")) emitTheme(f, code, prefix) else if (f == "Ui.run") emitUiRun(code, vals, owns, prefix) else if (Str.startsWith(f, "Ui.")) emitUiSess(f, code, vals, owns, prefix) else if (Str.startsWith(f, "Property.")) emitPropKit(f, code, vals, owns, prefix) else emitViewKit(f, code, vals, owns, prefix)

def emitUiSess(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "Ui.setEditorCaret") emitUiCaret(code, vals, prefix) else if (f == "Ui.editorCaret") emitClock("sz_lang_ui_editor_caret", code, prefix) else if (uiDrop1Rt(f) != "") emitFsReadRt(uiDrop1Rt(f), code, vals, owns, prefix) else emitUiRun(code, vals, owns, prefix)

def uiDrop1Rt(f: String): String =
  if (f == "Ui.setTitle") "sz_lang_ui_set_title" else if (f == "Ui.setEditorDiagnostics") "sz_lang_ui_set_editor_diagnostics" else if (f == "Ui.setEditorTokens") "sz_lang_ui_set_editor_tokens" else if (f == "Ui.setEditorInlays") "sz_lang_ui_set_editor_inlays" else if (f == "Ui.setEditorFolds") "sz_lang_ui_set_editor_folds" else ""

def emitUiCaret(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_ui_set_editor_caret(i64 ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), ")"))))))), pct(prefix, "v"), false)

def emitColorRgb(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_color_rgb(i64 ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), Str.concat(", i64 ", Str.concat(arg2(vals), ")"))))))))), pct(prefix, "v"), false)

def emitColorRgba(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_color_rgba(i64 ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), Str.concat(", i64 ", Str.concat(arg2(vals), Str.concat(", i64 ", Str.concat(arg3(vals), ")"))))))))))), pct(prefix, "v"), false)

def emitTheme(f: String, code: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(themeRt(f), "()"))))), pct(prefix, "v"), false)

def themeRt(f: String): String =
  if (f == "Theme.accent") "sz_theme_accent" else if (f == "Theme.primary") "sz_theme_primary" else if (f == "Theme.muted") "sz_theme_muted" else if (f == "Theme.foreground") "sz_theme_foreground" else if (f == "Icon.book") "sz_icon_book" else if (f == "Icon.code") "sz_icon_code" else if (f == "Icon.link") "sz_icon_link" else if (f == "Icon.web") "sz_icon_web" else if (f == "Icon.gui") "sz_icon_gui" else "sz_icon_install"

def emitUiRun(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(unpackFnPtr(arg0(vals), prefix), join(uiRunCall(prefix, "null"), if (headOwn(owns)) relPtr(arg0(vals)) else ""))), pct(prefix, "v"), true)

def emitPropCheck(code: String, vals: List[String], owns: List[Bool], _prefix: String): Slot =
  Slot(join(code, join(line(Str.concat("call void @sz_property_check(ptr ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), ")"))))), if (headOwn(owns)) relPtr(arg0(vals)) else "")), arg2(vals), headOwn(tailOwn(tailOwn(owns))))

def emitViewKit(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "View.column" || f == "View.row" || f == "View.stack" || f == "View.wrap" || f == "View.breadcrumb") emitViewBox(viewBoxRt(f), code, vals, owns, prefix) else if (f == "View.grid") emitViewGrid(code, vals, owns, prefix) else if (f == "View.divider") emitViewNil("sz_lang_view_divider", code, prefix) else if (f == "View.verticalDivider") emitViewNil("sz_lang_view_vertical_divider", code, prefix) else if (viewWrap1Rt(f) != "") emitViewPtr1(viewWrap1Rt(f), code, vals, prefix) else if (viewDrop1Rt(f) != "") emitViewDrop1(viewDrop1Rt(f), code, vals, owns, prefix) else if (viewI64PtrRt(f) != "") emitViewI64Ptr(viewI64PtrRt(f), code, vals, prefix) else if (viewI64I64PtrRt(f) != "") emitViewI64I64Ptr(viewI64I64PtrRt(f), code, vals, prefix) else if (tapViewRt(f) != "") emitViewTap(tapViewRt(f), code, vals, owns, prefix) else emitViewKit2(f, code, vals, owns, prefix)

def emitViewKit2(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  if (f == "View.section") emitViewSection(code, vals, owns, prefix) else if (f == "View.link") emitViewPtr2("sz_lang_view_link", true, true, code, vals, owns, prefix) else if (f == "View.navTile") emitViewNavTile(code, vals, owns, prefix) else if (viewPtr2Drop1Rt(f) != "") emitViewPtr2(viewPtr2Drop1Rt(f), false, true, code, vals, owns, prefix) else if (viewPtr2Drop0Rt(f) != "") emitViewPtr2(viewPtr2Drop0Rt(f), true, false, code, vals, owns, prefix) else if (viewPtr2Rt(f) != "") emitViewPtr2(viewPtr2Rt(f), false, false, code, vals, owns, prefix) else if (viewRadioRt(f) != "") emitViewRadio(viewRadioRt(f), code, vals, owns, prefix) else if (f == "View.showWhen") emitViewShowWhen(code, vals, prefix) else if (f == "View.split") emitViewPtr3("sz_lang_view_split", code, vals, prefix) else if (f == "View.segmented") emitViewSeg(code, vals, owns, prefix) else if (f == "View.expansionTile") emitViewExp(code, vals, owns, prefix) else if (f == "View.inkWell") emitViewInk(code, vals, owns, prefix) else if (f == "View.listTile") emitViewListTile(code, vals, owns, prefix) else if (f == "View.image") emitViewImage(code, vals, owns, prefix) else if (f == "View.icon") emitViewIcon(code, vals, prefix) else emitViewPtr1("sz_lang_view_center", code, vals, prefix)

def viewBoxRt(f: String): String =
  if (f == "View.column") "sz_lang_view_column" else if (f == "View.row") "sz_lang_view_row" else if (f == "View.wrap") "sz_lang_view_wrap" else if (f == "View.breadcrumb") "sz_lang_view_breadcrumb" else "sz_lang_view_stack"

def emitViewBox(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(viewBoxNew(rt, prefix), emitViewAdds(pct(prefix, "v"), vals, owns, prefix, 0))), pct(prefix, "v"), true)

def viewBoxNew(rt: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, "()"))))

def emitViewAdds(parent: String, xs: List[String], owns: List[Bool], prefix: String, i: Int): String =
  if (List.isEmpty(xs)) "" else join(viewAddOwn(parent, List.at(xs, 0), headOwn(owns), prefix, i), emitViewAdds(parent, List.tail(xs), tailOwn(owns), prefix, i + 1))

def viewAddOwn(parent: String, child: String, owned: Bool, prefix: String, i: Int): String =
  join(if (owned) "" else retPtr(child), viewAddLine(parent, child, prefix, i))

def viewAddLine(parent: String, child: String, prefix: String, i: Int): String =
  line(Str.concat(tmp(prefix, Str.concat("ac", Str.fromInt(i))), Str.concat("call ptr @sz_lang_view_add_child(ptr ", Str.concat(parent, Str.concat(", ptr ", Str.concat(child, ")"))))))

def uiRunCall(prefix: String, schema: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_ui_run_rebuild(ptr ", Str.concat(pct(prefix, "fnp"), Str.concat(", ptr ", Str.concat(pct(prefix, "envp"), Str.concat(", ptr ", Str.concat(schema, ")"))))))))

def viewTapPtr(rt: String, label: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(label, Str.concat(", ptr ", Str.concat(pct(prefix, "fnp"), Str.concat(", ptr ", Str.concat(pct(prefix, "envp"), ")"))))))))))

def viewImageCall(vals: List[String], prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_lang_view_image(i64 ", Str.concat(arg0(vals), Str.concat(", i64 ", Str.concat(arg1(vals), Str.concat(", i64 ", Str.concat(arg2(vals), Str.concat(", ptr ", Str.concat(arg3(vals), ")"))))))))))

def emitViewPtr1(rt: String, code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(arg0(vals), ")"))))))), pct(prefix, "v"), true)

def emitViewDrop1(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(arg0(vals), ")")))))), if (headOwn(owns)) relPtr(arg0(vals)) else "")), pct(prefix, "v"), true)

def emitViewI64Ptr(rt: String, code: String, vals: List[String], prefix: String): Slot =
