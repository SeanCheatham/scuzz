def emitSysI64Ptr(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitSysI64Ptr2(rt, code, arg0(vals), arg1(vals), headOwn(tailOwn(owns)), prefix)

def emitSysI64Ptr2(rt: String, code: String, a: String, b: String, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(i64 ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")")))))))), if (ob) relPtr(b) else "")), pct(prefix, "v"), false)

def emitFsList(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitFsList2(code, arg0(vals), headOwn(owns), prefix)

def emitFsList2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_fs_list(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def emitIoPure(code: String, vals: List[String], owns: List[Bool], prefix: String, ps: List[Param], isFloat: Bool): Slot =
  emitIoPure2(code, arg0(vals), headOwn(owns), prefix, ps, isFloat)

def emitIoPure2(code: String, v: String, o: Bool, prefix: String, ps: List[Param], isFloat: Bool): Slot =
  if (o || v == "null" || isPtrSlot(v, ps)) emitIoPurePtr(code, v, o, prefix) else if (pureI64(v, ps)) emitIoPureI64(code, v, prefix, isFloat) else if (Str.len(v) > 0 && Str.charAt(v, 0) == 37) emitIoPurePtr(code, v, o, prefix) else emitIoPureI64(code, v, prefix, isFloat)

def pureI64(v: String, ps: List[Param]): Bool =
  isI64Lit(v) || isIntSsa(v) || hasSub(v, "_v") || Str.len(v) > 1 && Str.charAt(v, 0) == 37 && paramIsI64(ps, Str.slice(v, 1, Str.len(v)))

def ioPurePtr(v: String): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37 && !hasSub(v, "_")

def emitIoPurePtr(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @sz_io_pure(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "io"), true)

def emitIoPureI64(code: String, v: String, prefix: String, isFloat: Bool): Slot =
  Slot(join(code, join(boxScalarStem(v, if (isFloat) "Float" else "Int", prefix, "b"), join(line(Str.concat(tmp(prefix, "io"), Str.concat("call ptr @sz_io_pure(ptr ", Str.concat(pct(prefix, "b"), ")")))), relPtr(pct(prefix, "b"))))), pct(prefix, "io"), true)

def emitSc(isAnd: Bool, l: Expr, r: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitScA(isAnd, emitExpr(l, Str.concat(prefix, "_l"), strs, defs, ens, ps, loc), r, prefix, strs, defs, ens, ps, loc)

def emitScA(isAnd: Bool, le: Slot, r: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  Slot(cat3(le.code, scHead(isAnd, le.val, prefix), emitScB(emitExpr(r, Str.concat(prefix, "_r"), strs, defs, ens, ps, loc), prefix, isAnd)), pct(prefix, "v"), false)

def scHead(isAnd: Bool, lv: String, prefix: String): String =
  join(line(Str.concat("br label %", Str.concat(prefix, "_al_0"))), join(lab(Str.concat(prefix, "_al_0")), join(line(Str.concat(tmp(prefix, "nz0"), Str.concat("icmp ne i64 ", Str.concat(lv, ", 0")))), scBr(isAnd, prefix))))

def scBr(isAnd: Bool, prefix: String): String =
  if (isAnd) line(Str.concat("br i1 ", Str.concat(pct(prefix, "nz0"), Str.concat(", label %", Str.concat(prefix, Str.concat("_rhs_0, label %", Str.concat(prefix, "_sc_0"))))))) else line(Str.concat("br i1 ", Str.concat(pct(prefix, "nz0"), Str.concat(", label %", Str.concat(prefix, Str.concat("_sc_0, label %", Str.concat(prefix, "_rhs_0")))))))

def emitScB(re: Slot, prefix: String, isAnd: Bool): String =
  cat3(lab(Str.concat(prefix, "_rhs_0")), re.code, scTail(isAnd, re.val, prefix))

def scTail(isAnd: Bool, rv: String, prefix: String): String =
  join(line(Str.concat("br label %", Str.concat(prefix, "_ar_0"))), join(lab(Str.concat(prefix, "_ar_0")), join(line(Str.concat(tmp(prefix, "rnz0"), Str.concat("icmp ne i64 ", Str.concat(rv, ", 0")))), join(line(Str.concat(tmp(prefix, "rb0"), Str.concat("zext i1 ", Str.concat(pct(prefix, "rnz0"), " to i64")))), join(line(Str.concat("br label %", Str.concat(prefix, "_sc_0"))), join(lab(Str.concat(prefix, "_sc_0")), line(Str.concat(tmp(prefix, "v"), scPhi(isAnd, prefix)))))))))

def scPhi(isAnd: Bool, prefix: String): String =
  Str.concat("phi i64 [ ", Str.concat(if (isAnd) "0" else "1", Str.concat(", %", Str.concat(prefix, Str.concat("_al_0 ], [ ", Str.concat(pct(prefix, "rb0"), Str.concat(", %", Str.concat(prefix, "_ar_0 ]"))))))))

def findDef(funs: Ftab, name: String): List[Fun] =
  Check.ftabGet(funs.tab, name)

def modOfLoc(loc: String): String =
  modOfLoc2(loc, Str.indexOf(loc, ".scuzz:"))

def modOfLoc2(loc: String, i: Int): String =
  if (i < 0) "" else Str.slice(loc, 0, i)

def findDefPrefer(defs: Ftab, name: String, mod: String): List[Fun] =
  if (mod == "") findDef(defs, name) else findDefPrefer2(findDefMod(defs, mod, name), defs, name)

def findDefPrefer2(hit: List[Fun], defs: Ftab, name: String): List[Fun] =
  if (List.isEmpty(hit)) findDef(defs, name) else hit

def emitUser(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, defs: Ftab, args: List[Expr], ens: List[En], ps: List[Param], mod: String): Slot =
  emitUser2(f, code, vals, owns, prefix, findDefPrefer(defs, f, mod), userArgTys(args, defs, ens, ps, mod), exprRetTyEns(Expr.ECall(f, args, 0), defs, ens, ps, mod))

def userArgTys(args: List[Expr], defs: Ftab, ens: List[En], ps: List[Param], mod: String): List[String] =
  if (List.isEmpty(args)) noStr() else exprRetTyEns(List.at(args, 0), defs, ens, ps, mod) :: userArgTys(List.tail(args), defs, ens, ps, mod)

def emitUser2(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, hit: List[Fun], argTys: List[String], retTy: String): Slot =
  if (List.isEmpty(hit)) Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_user_Main_", Str.concat(f, Str.concat("(", Str.concat(i64Args(vals), ")"))))))), pct(prefix, "v"), false) else emitUserD(code, vals, owns, prefix, List.at(hit, 0), argTys, retTy)

def emitUserHit(sym: String, code: String, vals: List[String], owns: List[Bool], prefix: String, hit: List[Fun], argTys: List[String], retTy: String): Slot =
  if (List.isEmpty(hit)) Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_user_", Str.concat(sym, Str.concat("(", Str.concat(i64Args(vals), ")"))))))), pct(prefix, "v"), false) else emitUserD(code, vals, owns, prefix, List.at(hit, 0), argTys, retTy)

def emitUserD(code: String, vals: List[String], owns: List[Bool], prefix: String, d: Fun, argTys: List[String], retTy: String): Slot =
  d match {
    case Fun(_, _, name, _, params, ret, _, mod, _) => emitUser6(symOf(mod, name), code, vals, owns, prefix, params, ret, argTys, retTy)
  }

def symOf(mod: String, name: String): String =
  Str.concat(if (mod == "") "Main" else mod, Str.concat("_", name))

def emitUser6(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, params: List[Param], ret: String, argTys: List[String], retTy: String): Slot =
  if (!isI64Ty(ret) && (isI64Ty(retTy) || isI64Ty(callRetArgTy(params, argTys, ret)))) emitUnboxSlot(emitUser7(f, code, prefix, llvmRet(ret), true, packCall(params, vals, owns, argTys, prefix, 0)), prefix) else emitUser7(f, code, prefix, llvmRet(ret), !isI64Ty(ret), packCall(params, vals, owns, argTys, prefix, 0))

def callRetArgTy(params: List[Param], argTys: List[String], ret: String): String =
  if (!isTyParam(ret) || List.isEmpty(params) || List.isEmpty(argTys)) "" else if (List.at(params, 0).ty == ret) List.at(argTys, 0) else callRetArgTy(List.tail(params), List.tail(argTys), ret)

def emitUser7(f: String, code: String, prefix: String, ty: String, owned: Bool, p: ((String, String), String)): Slot =
  p match {
    case ((pre, args), rel) => Slot(join(code, join(pre, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ", Str.concat(ty, Str.concat(" @sz_user_", Str.concat(f, Str.concat("(", Str.concat(args, ")")))))))), rel))), pct(prefix, "v"), owned)
  }

def packCall(ps: List[Param], vals: List[String], owns: List[Bool], argTys: List[String], prefix: String, i: Int): ((String, String), String) =
  if (List.isEmpty(ps) || List.isEmpty(vals)) (("", ""), "") else packCall2(List.at(ps, 0), List.at(vals, 0), headOwn(owns), if (List.isEmpty(argTys)) "" else List.at(argTys, 0), List.tail(ps), List.tail(vals), tailOwn(owns), if (List.isEmpty(argTys)) argTys else List.tail(argTys), prefix, i)

def packCall2(p: Param, v: String, o: Bool, srcTy: String, ps: List[Param], vals: List[String], owns: List[Bool], argTys: List[String], prefix: String, i: Int): ((String, String), String) =
  if (isI64Ty(p.ty) && v == "%.closure.value") packCallUnbox(p, v, o, ps, vals, owns, argTys, prefix, i) else if (!isI64Ty(p.ty) && !o && (isI64Ty(srcTy) || isI64Lit(v) || isIntSsa(v))) packCallBox(p, v, o, ps, vals, owns, argTys, prefix, i, srcTy) else packCall3(oneArg(p, v), if (o && !isViewMoveTy(p.ty)) relPtr(v) else "", packCall(ps, vals, owns, argTys, prefix, i + 1))

def packCallUnbox(_p: Param, v: String, o: Bool, ps: List[Param], vals: List[String], owns: List[Bool], argTys: List[String], prefix: String, i: Int): ((String, String), String) =
  packCallUnbox2(pct(prefix, Str.concat("pu", Str.fromInt(i))), v, o, packCall(ps, vals, owns, argTys, prefix, i + 1), prefix, i)

def packCallUnbox2(uv: String, v: String, o: Bool, rest: ((String, String), String), prefix: String, i: Int): ((String, String), String) =
  rest match {
    case ((pre, args), rels) => ((join(line(Str.concat(tmp(prefix, Str.concat("pu", Str.fromInt(i))), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(v, ")")))), pre), packArg(Str.concat("i64 ", uv), args)), join(if (o) relPtr(v) else "", rels))
  }

def packCallBox(_p: Param, v: String, o: Bool, ps: List[Param], vals: List[String], owns: List[Bool], argTys: List[String], prefix: String, i: Int, srcTy: String): ((String, String), String) =
  packCallBox2(pct(prefix, Str.concat("pb", Str.fromInt(i))), v, o, packCall(ps, vals, owns, argTys, prefix, i + 1), prefix, i, srcTy)

def packCallBox2(bx: String, v: String, o: Bool, rest: ((String, String), String), prefix: String, i: Int, srcTy: String): ((String, String), String) =
  rest match {
    case ((pre, args), rels) => ((join(boxScalarStem(v, srcTy, prefix, Str.concat("pb", Str.fromInt(i))), pre), packArg(Str.concat("ptr ", bx), args)), join(relPtr(bx), join(if (o) relPtr(v) else "", rels)))
  }

def packCall3(arg: String, rel: String, rest: ((String, String), String)): ((String, String), String) =
  rest match {
    case ((pre, args), rels) => ((pre, packArg(arg, args)), join(rel, rels))
  }

def packArg(arg: String, args: String): String =
  if (args == "") arg else Str.concat(arg, Str.concat(", ", args))

def headOwn(owns: List[Bool]): Bool =
  if (List.isEmpty(owns)) false else List.at(owns, 0)

def tailOwn(owns: List[Bool]): List[Bool] =
  if (List.isEmpty(owns)) owns else List.tail(owns)

def oneArg(p: Param, v: String): String =
  if (isI64Ty(p.ty)) Str.concat("i64 ", v) else Str.concat("ptr ", v)

def lab(s: String): String =
  Str.concat(s, Str.concat(":", nl()))

def emitIfFid(c: Expr, t: Expr, el: Expr, ioff: Int, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitIfThen(unboxBin(emitExprFid(c, Str.concat(prefix, "_ic"), strs, defs, ens, ps, loc, fid), ps, Str.concat(prefix, "_iu")), t, el, ioff, prefix, strs, defs, ens, ps, loc, fid + fmCount(c))

def emitIfThen(c: Slot, t: Expr, el: Expr, ioff: Int, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitIfElse(c, covThen(t, ioff, emitLiftUnitIo(t, el, Str.concat(prefix, "_t0"), strs, defs, ens, ps, loc, fid), loc, strs, prefix), el, ioff, prefix, strs, defs, ens, ps, loc, fid + fmCount(t))

def covThen(t: Expr, ioff: Int, s: Slot, loc: String, strs: Strs, prefix: String): Slot =
  t match {
    case Expr.EUnit => s
    case _ => covSlot(t, ioff, "t", s, loc, strs, Str.concat(prefix, "_cvt"))
  }

def covElse(el: Expr, ioff: Int, s: Slot, loc: String, strs: Strs, prefix: String): Slot =
  el match {
    case Expr.EUnit => s
    case _ => covSlot(el, ioff, "e", s, loc, strs, Str.concat(prefix, "_cve"))
  }

def emitLiftUnitIo(t: Expr, el: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  t match {
    case Expr.EUnit => if (isIoPred(el)) emitIoUnit(prefix) else emitExprFid(t, prefix, strs, defs, ens, ps, loc, fid)
    case _ => emitExprFid(t, prefix, strs, defs, ens, ps, loc, fid)
  }

def emitIfElse(c: Slot, th: Slot, el: Expr, ioff: Int, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  th match {
    case Slot(tc, tv, to) => emitIf2(c, Slot(tc, tv, to), covElse(el, ioff, emitUnitElse(el, thenIsPtr(tc, tv, to, ps), isIoSlot(tv), prefix, strs, defs, ens, ps, loc, fid), loc, strs, prefix), prefix, ps)
  }

def thenIsPtr(code: String, v: String, o: Bool, ps: List[Param]): Bool =
  o || isPtrSlot(v, ps) || v == "null" || thenCallPtr(code, v)

def thenCallPtr(code: String, v: String): Bool =
  if (skipCallScan(v)) false else hasSubTail(code, Str.concat(v, " = call ptr @")) && !hasSubTail(code, Str.concat(v, " = call i64 @"))

def skipCallScan(v: String): Bool =
  Str.len(v) == 0 || Str.charAt(v, 0) != 37 || isIntSsa(v) || isI64Lit(v)

def hasSubTail(s: String, sub: String): Bool =
  hasSub(s, sub)

def isIoSlot(v: String): Bool =
  hasSub(v, "_io") || hasSub(v, "_fm")

def emitUnitElse(el: Expr, thenOwned: Bool, thenIo: Bool, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  el match {
    case Expr.EUnit => if (thenIo) emitIoUnit(prefix) else if (thenOwned) Slot("", "null", true) else Slot("", "0", false)
    case _ => emitExprFid(el, Str.concat(prefix, "_e0"), strs, defs, ens, ps, loc, fid)
  }

def emitIoUnit(prefix: String): Slot =
  Slot(line(Str.concat(tmp(prefix, "iu"), "call ptr @sz_io_pure(ptr null)")), pct(prefix, "iu"), true)

def emitIf2(c: Slot, t: Slot, el: Slot, prefix: String, ps: List[Param]): Slot =
  t match {
    case Slot(tc, tv, to) => el match {
  case Slot(ec, ev, eo) => emitIf3(c, tc, tv, to, ec, ev, eo, prefix, ps)
}
  }

def emitIf3(c: Slot, tc: String, tv: String, to: Bool, ec: String, ev: String, eo: Bool, prefix: String, ps: List[Param]): Slot =
  emitIf4(c, tc, tv, to, ec, ev, eo, prefix, thenIsPtr(tc, tv, to, ps) || thenIsPtr(ec, ev, eo, ps))

def emitIf4(c: Slot, tc: String, tv: String, to: Bool, ec: String, ev: String, eo: Bool, prefix: String, isPtr: Bool): Slot =
  Slot(cat4(emitIfHead(c, prefix), emitIfArm(tc, tv, to, prefix, "_then_0", "_tj_0", isPtr && !to), emitIfArm(ec, ev, eo, prefix, "_else_0", "_ej_0", isPtr && !eo), emitIfPhi(tv, ev, prefix, isPtr)), pct(prefix, "phi"), isPtr)

def isPtrSlot(v: String, ps: List[Param]): Bool =
  !isI64ParamVal(v, ps) && (isPtrParam(v, ps) || hasDigitStem(v, "_c") || hasSub(v, "_tl") || hasSub(v, "_tr") || hasSub(v, "_pl") || hasSub(v, "_io") || hasSub(v, "_fm") || hasSub(v, "_ch") || hasSub(v, "_ct") || hasSub(v, "_ptr"))

def isPtrParam(v: String, ps: List[Param]): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37 && paramKnown(ps, Str.slice(v, 1, Str.len(v))) && !paramIsI64(ps, Str.slice(v, 1, Str.len(v)))

def paramKnown(ps: List[Param], n: String): Bool =
  if (List.isEmpty(ps)) false else paramKnownHd(List.at(ps, 0), List.tail(ps), n)

def paramKnownHd(p: Param, rest: List[Param], n: String): Bool =
  p match {
    case Param(name, _, _, _) => if (name == n) true else paramKnown(rest, n)
  }

def emitIfHead(c: Slot, prefix: String): String =
  c match {
    case Slot(code, val, _) => cat3(code, emitIfCmp(val, prefix), emitIfBr(prefix))
  }

def emitIfCmp(v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "cmp"), Str.concat("icmp ne i64 ", Str.concat(v, ", 0"))))

def emitIfBr(prefix: String): String =
  line(Str.concat("br i1 ", Str.concat(pct(prefix, "cmp"), Str.concat(", label %", Str.concat(prefix, Str.concat("_then_0, label %", Str.concat(prefix, "_else_0")))))))

def emitIfArm(code: String, val: String, owned: Bool, prefix: String, enter: String, joinLab: String, keep: Bool): String =
  cat6(lab(Str.concat(prefix, enter)), code, if (!owned && keep) retPtr(val) else "", emitIfJmp(prefix, joinLab), lab(Str.concat(prefix, joinLab)), emitIfJmp(prefix, "_merge_0"))

def emitIfJmp(prefix: String, dest: String): String =
  line(Str.concat("br label %", Str.concat(prefix, dest)))

def emitIfPhi(tv: String, ev: String, prefix: String, isPtr: Bool): String =
  join(lab(Str.concat(prefix, "_merge_0")), line(Str.concat(tmp(prefix, "phi"), emitIfPhi2(tv, ev, prefix, if (isPtr) "ptr" else "i64"))))

def emitIfPhi2(tv: String, ev: String, prefix: String, ty: String): String =
  Str.concat("phi ", Str.concat(ty, Str.concat(" [ ", Str.concat(tv, Str.concat(", %", Str.concat(prefix, Str.concat("_tj_0 ], [ ", Str.concat(ev, emitIfPhi3(prefix)))))))))

def emitIfPhi3(prefix: String): String =
  Str.concat(", %", Str.concat(prefix, "_ej_0 ]"))

def emitField(recv: Expr, name: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (isTupField(name)) emitTupField(recv, name, prefix, strs, defs, ens, ps, loc) else emitFieldEn(recv, name, prefix, strs, defs, ens, ps, loc)

def emitFieldEn(recv: Expr, name: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  recv match {
    case Expr.EVar(en, _) => if (paramTy(ps, en) != "") emitRecFieldVar(en, name, prefix, ens, ps) else emitCtor(en, name, prefix, ens)
    case _ => emitRecFieldFrom(emitExpr(recv, Str.concat(prefix, "_recv"), strs, defs, ens, ps, loc), name, prefix, copyEnAt(recv, ens, defs, ps, loc), ens)
  }

def emitRecFieldFrom(s: Slot, name: String, prefix: String, en: String, ens: List[En]): Slot =
  emitRecFieldFromTy(s, prefix, recFieldIdx(recNames(ens, en), name), slotInt(recTys(ens, en), recFieldIdx(recNames(ens, en), name)), List.len(recNames(ens, en)))

def emitRecFieldFromTy(s: Slot, prefix: String, k: Int, unbox: Bool, n: Int): Slot =
  emitRecFieldFromDone(s, emitRecFieldIdx2(line(Str.concat(tmp(prefix, "rpl"), Str.concat("call ptr @sz_adt_payload(ptr ", Str.concat(s.val, ")")))), prefix, k, unbox, n), unbox)

def emitRecFieldFromDone(recv: Slot, field: Slot, unbox: Bool): Slot =
  Slot(join(recv.code, join(field.code, join(if (recv.owned && !unbox) retPtr(field.val) else "", if (recv.owned) relPtr(recv.val) else ""))), field.val, recv.owned && !unbox)

def emitRecFieldVar(en: String, name: String, prefix: String, ens: List[En], ps: List[Param]): Slot =
  emitRecFieldVar2(en, prefix, recNames(ens, recHead(en, name, ens, ps)), recTys(ens, recHead(en, name, ens, ps)), name)

def emitRecFieldVar2(en: String, prefix: String, ns: List[String], tys: List[String], name: String): Slot =
  emitRecFieldIdx(en, prefix, recFieldIdx(ns, name), slotInt(tys, recFieldIdx(ns, name)), List.len(ns))

def recFieldIdx(ns: List[String], name: String): Int =
  if (List.isEmpty(ns)) 0 else idxOf(ns, name)

def emitRecFieldIdx(en: String, prefix: String, k: Int, unbox: Bool, n: Int): Slot =
  emitRecFieldIdx2(line(Str.concat(tmp(prefix, "rpl"), Str.concat("call ptr @sz_adt_payload(ptr %", Str.concat(en, ")")))), prefix, k, unbox, n)

def emitRecFieldIdx2(pl: String, prefix: String, k: Int, unbox: Bool, n: Int): Slot =
  if (n <= 1) emitRecFieldMaybeUnbox(pl, pct(prefix, "rpl"), prefix, unbox) else emitRecFieldMaybeUnbox(join(pl, line(Str.concat(tmp(prefix, "rat"), Str.concat("call ptr @sz_list_at(ptr ", Str.concat(pct(prefix, "rpl"), Str.concat(", i64 ", Str.concat(Str.fromInt(k), ")"))))))), pct(prefix, "rat"), prefix, unbox)

def emitRecFieldMaybeUnbox(code: String, v: String, prefix: String, unbox: Bool): Slot =
  if (unbox) Slot(join(code, line(Str.concat(tmp(prefix, "ru"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(v, ")"))))), pct(prefix, "ru"), false) else Slot(code, v, false)

def emitTupField(recv: Expr, name: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  recv match {
    case Expr.EVar(s, _) => emitTupSel(Str.concat("%", s), tupSlots(paramTy(ps, s)), tupIdx(name), prefix, 0)
    case Expr.EAscribe(inner, _, _) => emitTupField(inner, name, prefix, strs, defs, ens, ps, loc)
    case Expr.ENamed(_, inner) => emitTupField(inner, name, prefix, strs, defs, ens, ps, loc)
    case _ => emitTupFrom(emitExpr(recv, Str.concat(prefix, "_tf"), strs, defs, ens, ps, loc), name, prefix, recv, defs, ens, ps, loc)
  }

def emitTupFrom(s: Slot, name: String, prefix: String, recv: Expr, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  s match {
    case Slot(code, v, _) => emitTupSelJoin2(code, emitTupSel(v, tupSlots(exprRetTyEns(recv, defs, ens, ps, loc)), tupIdx(name), prefix, 0))
  }

def emitTupSel(scrut: String, tys: List[String], k: Int, prefix: String, i: Int): Slot =
  if (k <= 0) emitPairTake(scrut, true, prefix, headOrAny(tys)) else if (List.isEmpty(tys) || List.len(tys) == 2) emitPairTake(scrut, false, prefix, secondOrAny(tys)) else emitTupSelGo(scrut, tys, k, prefix, i)

def emitTupSelGo(scrut: String, tys: List[String], k: Int, prefix: String, i: Int): Slot =
  emitTupSelJoin(line(Str.concat(tmp(prefix, Str.concat("tr", Str.fromInt(i))), Str.concat("call ptr @sz_pair_right(ptr ", Str.concat(scrut, ")")))), tys, k, prefix, i)

def emitTupSelJoin(pre: String, tys: List[String], k: Int, prefix: String, i: Int): Slot =
  emitTupSelJoin2(pre, emitTupSel(pct(prefix, Str.concat("tr", Str.fromInt(i))), tailOrEmpty(tys), k - 1, prefix, i + 1))

def emitTupSelJoin2(pre: String, s: Slot): Slot =
  s match {
    case Slot(code, v, o) => Slot(join(pre, code), v, o)
  }

def emitPairTake(scrut: String, left: Bool, prefix: String, ty: String): Slot =
  if (isI64Ty(ty)) emitPairUnbox(scrut, left, prefix) else Slot(kitCallPtr1(pairRt(left), scrut, prefix), pct(prefix, "v"), false)

def pairRt(left: Bool): String =
  if (left) "sz_pair_left" else "sz_pair_right"

def emitPairUnbox(scrut: String, left: Bool, prefix: String): Slot =
  Slot(join(line(Str.concat(tmp(prefix, "p"), Str.concat("call ptr @", Str.concat(pairRt(left), Str.concat("(ptr ", Str.concat(scrut, ")")))))), line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(prefix, "p"), ")"))))), pct(prefix, "v"), false)

def emitCtorCall(recv: Expr, name: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  if (name == "copy" && copyEnAt(recv, ens, defs, ps, loc) != "") emitCopy(recv, args, prefix, strs, defs, ens, ps, loc) else if (name == "require") emitRequire(recv, args, prefix, strs, defs, ens, ps, loc) else emitCtorCall2(recv, name, args, prefix, strs, defs, ens, ps, loc, fid)

def emitRequire(recv: Expr, _args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitExpr(recv, Str.concat(prefix, "_r"), strs, defs, ens, ps, loc)

def emitCtorCall2(recv: Expr, name: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  recv match {
    case Expr.EVar(en, _) => if (paramTy(ps, en) != "") emitMethodVal(recv, name, args, prefix, recvEn(en, ps, ens, defs, name), strs, defs, ens, ps, loc, fid) else emitCtorOrQual(en, name, args, prefix, strs, defs, ens, ps, loc, fid)
    case _ => emitMethodVal(recv, name, args, prefix, copyEnAt(recv, ens, defs, ps, loc), strs, defs, ens, ps, loc, fid)
  }

def recvEn(n: String, ps: List[Param], ens: List[En], defs: Ftab, meth: String): String =
  recvEnTy(tyHead(paramTy(ps, n)), ens, defs, meth)

def recvEnTy(t: String, ens: List[En], defs: Ftab, meth: String): String =
  if (hasEn(ens, t)) t else methEnOf(defs, meth)

def methEnOf(defs: Ftab, meth: String): String =
  methEnOfL(defs.list, meth)

def methEnOfL(ds: List[Fun], meth: String): String =
  if (List.isEmpty(ds)) "Point" else methEnOfH(List.at(ds, 0), List.tail(ds), meth)

def methEnOfH(d: Fun, rest: List[Fun], meth: String): String =
  d match {
    case Fun(_, _, name, _, _, _, _, mod, _) => if (name == meth && mod != "") mod else methEnOfL(rest, meth)
  }

def emitMethodVal(recv: Expr, name: String, args: List[Expr], prefix: String, en: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitMethodVal2(emitExprFid(recv, Str.concat(prefix, "_mr"), strs, defs, ens, ps, loc, fid), emitArgList(args, prefix, strs, defs, ens, ps, loc, 0, "", noStr(), noBool(), fid + fmCount(recv)), name, prefix, en, defs, userArgTys(recv :: args, defs, ens, ps, loc), exprRetTyEns(Expr.EMethod(recv, name, args, 0), defs, ens, ps, loc))

def emitMethodVal2(r: Slot, ap: (String, List[String], List[Bool]), name: String, prefix: String, en: String, defs: Ftab, argTys: List[String], retTy: String): Slot =
  r match {
    case Slot(rc, rv, ro) => emitMethodVal3(rc, rv, ro, ap, name, prefix, en, defs, argTys, retTy)
  }

def emitMethodVal3(rc: String, rv: String, ro: Bool, ap: (String, List[String], List[Bool]), name: String, prefix: String, en: String, defs: Ftab, argTys: List[String], retTy: String): Slot =
  ap match {
    case (ac, vals, owns) => emitUserHit(Str.concat(en, Str.concat("_", name)), join(rc, ac), rv :: vals, ro :: owns, prefix, methodHit(defs, en, name), argTys, retTy)
  }

def methodHit(defs: Ftab, en: String, name: String): List[Fun] =
  methodHit2(findDefMod(defs, en, name), defs, name)

def methodHit2(hit: List[Fun], defs: Ftab, name: String): List[Fun] =
  if (List.isEmpty(hit)) findDef(defs, name) else hit

def emitCopy(recv: Expr, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitCopyGo(emitExpr(recv, Str.concat(prefix, "_cr"), strs, defs, ens, ps, loc), args, prefix, copyEnAt(recv, ens, defs, ps, loc), strs, defs, ens, ps, loc)

def copyEn(recv: Expr, ens: List[En], defs: Ftab): String =
  copyEnAt(recv, ens, defs, noParam(), "Main")

def copyEnAt(recv: Expr, ens: List[En], defs: Ftab, ps: List[Param], loc: String): String =
  copyEnOr(Type.headNameStr(exprRetTyEns(recv, defs, ens, ps, loc)), ens)

def copyEnCall(f: String, ens: List[En], defs: Ftab): String =
  if (ctorHead(f, ens) != "") ctorHead(f, ens) else tyHead(funRetStr(defs, f))

def copyEnOr(h: String, ens: List[En]): String =
  if (h == "" || h == "Any") "" else if (hasEn(ens, h)) h else ""

def ctorHead(f: String, ens: List[En]): String =
  if (f == "" || f == "Any") "" else if (hasEn(ens, f)) f else ctorHeadDot(f, ens, dotAt(f, 0))

def ctorHeadDot(f: String, ens: List[En], dot: Int): String =
  if (dot >= 0) ctorHeadOrCase(Str.slice(f, 0, dot), Str.slice(f, dot + 1, Str.len(f)), ens) else enOfCase(ens, f)

def ctorHeadOrCase(mod: String, name: String, ens: List[En]): String =
  if (hasEn(ens, mod)) mod else enOfCase(ens, name)

def emitCopyGo(r: Slot, args: List[Expr], prefix: String, en: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(args)) r else emitCopyUpd(r, args, prefix, en, recNames(ens, en), strs, defs, ens, ps, loc)

def emitCopyUpd(r: Slot, args: List[Expr], prefix: String, en: String, names: List[String], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  r match {
    case Slot(c, v, o) => emitCopyUpd2(c, v, o, args, prefix, en, names, strs, defs, ens, ps, loc)
  }

def emitCopyUpd2(c: String, v: String, o: Bool, args: List[Expr], prefix: String, en: String, names: List[String], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.len(names) == 1) emitCopyOne(c, v, o, args, prefix, en, List.at(names, 0), strs, defs, ens, ps, loc) else emitCopyPackRel(emitCopyPack(join(c, line(Str.concat(tmp(prefix, "pl"), Str.concat("call ptr @sz_adt_payload(ptr ", Str.concat(v, ")"))))), args, prefix, en, names, 0, strs, defs, ens, ps, loc, noStr(), noBool()), v, o)

def emitCopyOne(c: String, v: String, o: Bool, args: List[Expr], prefix: String, en: String, name: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  emitCopyOneHit(c, v, o, copyOverride(args, 0, name), prefix, en, strs, defs, ens, ps, loc)

def emitCopyOneHit(c: String, v: String, o: Bool, hit: List[Expr], prefix: String, en: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): Slot =
  if (List.isEmpty(hit)) emitCopyOneKeep(c, v, o, prefix, en, ens) else emitCopyOneArg(emitExpr(List.at(hit, 0), Str.concat(prefix, "_u0"), strs, defs, ens, ps, loc), exprRetTyEns(List.at(hit, 0), defs, ens, ps, loc), c, v, o, prefix, en, ens)

def emitCopyOneKeep(c: String, v: String, o: Bool, prefix: String, en: String, ens: List[En]): Slot =
  Slot(join(c, join(line(Str.concat(tmp(prefix, "pl"), Str.concat("call ptr @sz_adt_payload(ptr ", Str.concat(v, ")")))), join(emitAdtNew(prefix, ctorTag(ens, en, en), pct(prefix, "pl")), if (o) relPtr(v) else ""))), pct(prefix, "adt"), true)

def emitCopyOneArg(s: Slot, ty: String, c: String, v: String, o: Bool, prefix: String, en: String, ens: List[En]): Slot =
  s match {
    case Slot(ec, ev, eo) => if (isI64Ty(ty)) emitCopyOneBox(ec, ev, c, v, o, prefix, en, ens, ty) else Slot(join(c, join(ec, join(emitAdtNew(prefix, ctorTag(ens, en, en), ev), join(if (eo) relPtr(ev) else "", if (o) relPtr(v) else "")))), pct(prefix, "adt"), true)
  }

def emitCopyOneBox(ec: String, ev: String, c: String, v: String, o: Bool, prefix: String, en: String, ens: List[En], ty: String): Slot =
  Slot(join(c, join(ec, join(boxScalarStem(ev, ty, prefix, "box"), join(emitAdtNew(prefix, ctorTag(ens, en, en), pct(prefix, "box")), join(relPtr(pct(prefix, "box")), if (o) relPtr(v) else ""))))), pct(prefix, "adt"), true)

def emitCopyPackRel(s: Slot, v: String, o: Bool): Slot =
  s match {
    case Slot(code, val, owned) => Slot(join(code, if (o) relPtr(v) else ""), val, owned)
  }

def emitCopyPack(code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool]): Slot =
  if (k >= List.len(names)) emitCopyDone(code, List.reverse(vals), List.reverse(owns), prefix, en, ens, ps, defs) else emitCopyPackK(code, args, prefix, en, names, k, strs, defs, ens, ps, loc, vals, owns)

def emitCopyDone(code: String, vals: List[String], owns: List[Bool], prefix: String, en: String, ens: List[En], ps: List[Param], defs: Ftab): Slot =
  emitCopyDone2(code, emitPack(vals, owns, noExpr(), prefix, 0, List.len(vals), ps, defs, ens, ""), en, prefix, ens)

def emitCopyDone2(code: String, pack: Slot, en: String, prefix: String, ens: List[En]): Slot =
  pack match {
    case Slot(pc, pv, _) => emitRec2(join(code, pc), pv, en, prefix, ens)
  }

def emitCopyPackK(code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool]): Slot =
  emitCopyPackHit(copyOverride(args, k, List.at(names, k)), code, args, prefix, en, names, k, strs, defs, ens, ps, loc, vals, owns)

def copyOverride(args: List[Expr], k: Int, name: String): List[Expr] =
  copyOverrideNamed(args, name, copyOverridePos(args, k, 0))

def copyOverrideNamed(args: List[Expr], name: String, pos: List[Expr]): List[Expr] =
  if (List.isEmpty(args)) pos else copyOverrideNamed1(List.at(args, 0), List.tail(args), name, pos)

def copyOverrideNamed1(h: Expr, rest: List[Expr], name: String, pos: List[Expr]): List[Expr] =
  h match {
    case Expr.ENamed(n, inner) => if (n == name) inner :: noExpr() else copyOverrideNamed(rest, name, pos)
    case _ => copyOverrideNamed(rest, name, pos)
  }

def copyOverridePos(args: List[Expr], k: Int, i: Int): List[Expr] =
  if (List.isEmpty(args)) noExpr() else copyOverridePos1(List.at(args, 0), List.tail(args), k, i)

def copyOverridePos1(h: Expr, rest: List[Expr], k: Int, i: Int): List[Expr] =
  h match {
    case Expr.ENamed(_, _) => copyOverridePos(rest, k, i)
    case _ => if (i == k) h :: noExpr() else copyOverridePos(rest, k, i + 1)
  }

def emitCopyPackHit(hit: List[Expr], code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool]): Slot =
  if (List.isEmpty(hit)) emitCopyKeep(code, args, prefix, en, names, k, strs, defs, ens, ps, loc, vals, owns) else emitCopyArg(List.at(hit, 0), code, args, prefix, en, names, k, strs, defs, ens, ps, loc, vals, owns)

def emitCopyKeep(code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool]): Slot =
  emitCopyPack(join(code, copyKeepLoad(prefix, k)), args, prefix, en, names, k + 1, strs, defs, ens, ps, loc, pct(prefix, Str.concat("k", Str.fromInt(k))) :: vals, false :: owns)

def copyKeepLoad(prefix: String, k: Int): String =
  copyKeepLoad2(tmp(prefix, Str.concat("k", Str.fromInt(k))), pct(prefix, "pl"), Str.fromInt(k))

def copyKeepLoad2(lhs: String, pl: String, k: String): String =
  line(Str.concat(lhs, Str.concat("call ptr @sz_list_at(ptr ", Str.concat(pl, Str.concat(", i64 ", Str.concat(k, ")"))))))

def emitCopyArg(e: Expr, code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool]): Slot =
  emitCopyArg2(emitExpr(e, Str.concat(prefix, Str.concat("_u", Str.fromInt(k))), strs, defs, ens, ps, loc), exprRetTyEns(e, defs, ens, ps, loc), code, args, prefix, en, names, k, strs, defs, ens, ps, loc, vals, owns)

def emitCopyArg2(s: Slot, ty: String, code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool]): Slot =
  s match {
    case Slot(ec, ev, eo) => if (isI64Ty(ty)) emitCopyArgBox(ec, ev, code, args, prefix, en, names, k, strs, defs, ens, ps, loc, vals, owns, ty) else emitCopyPack(join(code, ec), args, prefix, en, names, k + 1, strs, defs, ens, ps, loc, ev :: vals, eo :: owns)
  }

def emitCopyArgBox(ec: String, ev: String, code: String, args: List[Expr], prefix: String, en: String, names: List[String], k: Int, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, vals: List[String], owns: List[Bool], ty: String): Slot =
  emitCopyPack(join(code, join(ec, copyArgBox(prefix, k, ev, ty))), args, prefix, en, names, k + 1, strs, defs, ens, ps, loc, pct(prefix, Str.concat("ub", Str.fromInt(k))) :: vals, true :: owns)

def copyArgBox(prefix: String, k: Int, ev: String, ty: String): String =
  boxScalarStem(ev, ty, prefix, Str.concat("ub", Str.fromInt(k)))

def emitCtorOrQual(en: String, name: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  if (enHasCase(ens, en, name)) emitPayloadCtor(en, name, args, prefix, strs, defs, ens, ps, loc, fid) else emitCtorOrQualKit(en, name, args, prefix, strs, defs, ens, ps, loc, fid)

def emitCtorOrQualKit(en: String, name: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  if (isEmitKit(Str.concat(en, Str.concat(".", name)))) emitCall(Str.concat(en, Str.concat(".", name)), args, prefix, strs, defs, ens, ps, loc, fid) else if (hasEn(ens, en)) emitPayloadCtor(en, name, args, prefix, strs, defs, ens, ps, loc, fid) else emitQual(en, name, args, prefix, strs, defs, ens, ps, loc, fid)

def isEmitKit(f: String): Bool =
  isUiKit(f) || f == "List.setAt" || f == "List.join" || kitUnaryPtr(f) != "" || kitUnaryI64(f) != "" || kitPtrI64(f) != "" || kitBinaryPtr(f) != "" || kitBinaryI64(f) != "" || isJsonExtra(f) || isRtExtra(f) || isHoKit(f) || f == "Map.empty" || f == "Set.empty" || f == "List.empty" || f == "Str.replace" || f == "Str.replaceMatch" || f == "Str.padLeft" || f == "Str.padRight" || f == "Map.set" || f == "Set.add" || f == "Map.getOrElse" || f == "Clock.iso8601" || f == "Clock.zone" || f == "Clock.monotonic" || f == "Clock.realTime" || f == "Fs.mkdirs" || f == "Fs.canonicalize" || f == "Fs.exists" || f == "Fs.walk" || f == "Fs.delete" || f == "List.len" || f == "List.concat" || f == "List.reverse" || f == "List.head" || f == "List.tail" || f == "List.isEmpty" || f == "List.cons" || f == "List.at" || f == "Str.fromInt" || f == "Str.fromBool" || f == "Str.concat" || f == "Str.len" || f == "Str.byteLen" || f == "Str.byteSlice" || f == "Fs.read" || f == "Fs.write" || f == "Fs.list" || f == "IO.pure" || f == "Sys.getenv" || f == "Impurity.runKit" || f == "Net.serveOnce" || f == "Net.serve" || f == "Net.serveOnceTls" || f == "Net.serveTls" || f == "Net.serveOnceTlsFiles" || f == "Net.serveTlsFiles" || isNetEmit(f) || f == "Queue.unbounded" || f == "Deferred.empty" || f == "Float.toInt" || f == "Float.fromInt" || f == "Map.isEmpty" || f == "Set.isEmpty" || f == "Map.nonEmpty" || f == "Set.nonEmpty" || f == "List.range" || f == "List.fill" || f == "List.getOrElse" || f == "List.padTo" || f == "List.max" || f == "List.min" || f == "List.sort" || f == "List.toSet" || f == "List.slice" || f == "List.isDefinedAt" || f == "List.lengthCompare" || f == "List.tabulate" || f == "List.segmentLength" || isTlKit(f) || f == "Net.retryAfterMillis" || f == "Oracle.sumTo" || f == "Fs.rename" || f == "Random.nextInt" || f == "Uuid.v4" || f == "Fuzz.driver"

def isNetEmit(f: String): Bool =
  f == "Net.httpGet" || f == "Net.httpHead" || f == "Net.httpDelete" || f == "Net.httpPost" || f == "Net.httpPut" || f == "Net.httpPatch" || f == "Net.tcpConnect" || f == "Net.tcpListen" || f == "Net.tcpAccept" || f == "Net.tcpRead" || f == "Net.tcpWrite" || f == "Net.tcpClose" || f == "Net.udpBind" || f == "Net.udpSend" || f == "Net.udpRecv" || f == "Net.udpClose"

def isUiKit(f: String): Bool =
  Str.startsWith(f, "View.") || Str.startsWith(f, "Signal.") || Str.startsWith(f, "Color.") || Str.startsWith(f, "Theme.") || Str.startsWith(f, "Icon.") || Str.startsWith(f, "Property.") || Str.startsWith(f, "Ui.")

def emitQual(en: String, name: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitQual2(en, name, emitArgList(alignFill(funParamsOfHit(findDefMod(defs, en, name)), args), prefix, strs, defs, ens, ps, loc, 0, "", noStr(), noBool(), fid), prefix, defs, userArgTys(alignFill(funParamsOfHit(findDefMod(defs, en, name)), args), defs, ens, ps, loc), exprRetTyEns(Expr.ECall(Str.concat(en, Str.concat(".", name)), args, 0), defs, ens, ps, loc))

def emitQual2(en: String, name: String, p: (String, List[String], List[Bool]), prefix: String, defs: Ftab, argTys: List[String], retTy: String): Slot =
  p match {
    case (code, vals, owns) => emitUserMod(en, name, code, vals, owns, prefix, defs, argTys, retTy)
  }

def findDefMod(funs: Ftab, mod: String, name: String): List[Fun] =
  Check.ftabGetMod(funs.tab, mod, name)

def emitUserMod(en: String, name: String, code: String, vals: List[String], owns: List[Bool], prefix: String, defs: Ftab, argTys: List[String], retTy: String): Slot =
  emitUserHit(Str.concat(en, Str.concat("_", name)), code, vals, owns, prefix, findDefMod(defs, en, name), argTys, retTy)

def emitPayloadCtor(en: String, name: String, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  if (List.isEmpty(args)) emitCtor(en, name, prefix, ens) else emitPayloadCtorRest(en, name, List.at(args, 0), List.tail(args), prefix, strs, defs, ens, ps, loc, fid)

def emitPayloadCtorRest(en: String, name: String, h: Expr, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  if (List.isEmpty(rest)) emitPayloadCtor1(emitExprFid(h, Str.concat(prefix, "_ap"), strs, defs, ens, ps, loc, fid), en, name, prefix, ens, exprRetTyEns(h, defs, ens, ps, loc)) else emitPayloadCtorN(en, name, emitArgList(h :: rest, prefix, strs, defs, ens, ps, loc, 0, "", noStr(), noBool(), fid), h :: rest, prefix, ens, ps, defs, modOfLoc(loc))

def emitPayloadCtorN(en: String, name: String, p: (String, List[String], List[Bool]), args: List[Expr], prefix: String, ens: List[En], ps: List[Param], defs: Ftab, mod: String): Slot =
  p match {
    case (code, vals, owns) => if (List.isEmpty(vals)) emitCtor(en, name, prefix, ens) else if (List.len(vals) == 1) emitPayloadCtor1(Slot(code, arg0(vals), headOwn(owns)), en, name, prefix, ens, Check.typeOfEns(List.at(args, 0), defs, ens, ps, mod)) else emitPayJoin(code, emitPack(vals, owns, args, prefix, 0, List.len(vals), ps, defs, ens, mod), en, name, prefix, ens)
  }

def emitPayJoin(code: String, pack: Slot, en: String, name: String, prefix: String, ens: List[En]): Slot =
  pack match {
    case Slot(pc, pv, _) => emitPay2(join(code, pc), pv, en, name, prefix, ens)
  }

def emitPay2(pc: String, pv: String, en: String, name: String, prefix: String, ens: List[En]): Slot =
  Slot(join(pc, join(emitAdtNew(prefix, ctorTag(ens, en, name), pv), relPtr(pv))), pct(prefix, "adt"), true)

def emitPayloadCtor1(arg: Slot, en: String, name: String, prefix: String, ens: List[En], ty: String): Slot =
  if (isI64Ty(ty)) emitPayloadInt(arg, en, name, prefix, ens, ty) else emitPayloadPtr(arg, en, name, prefix, ens)

def emitPayloadInt(arg: Slot, en: String, name: String, prefix: String, ens: List[En], ty: String): Slot =
  Slot(join(arg.code, join(emitBoxScalar(prefix, arg.val, ty), join(emitAdtNew(prefix, ctorTag(ens, en, name), pct(prefix, "box")), relPtr(pct(prefix, "box"))))), pct(prefix, "adt"), true)

def emitPayloadPtr(arg: Slot, en: String, name: String, prefix: String, ens: List[En]): Slot =
  Slot(join(arg.code, join(emitAdtNew(prefix, ctorTag(ens, en, name), arg.val), if (arg.owned) relPtr(arg.val) else "")), pct(prefix, "adt"), true)

def emitBoxI64(prefix: String, v: String): String =
  line(Str.concat(tmp(prefix, "box"), Str.concat("call ptr @sz_box_i64(i64 ", Str.concat(v, ")"))))

def emitBoxScalar(prefix: String, v: String, ty: String): String =
  boxScalarStem(v, ty, prefix, "box")

def boxScalarStem(v: String, ty: String, prefix: String, stem: String): String =
  line(Str.concat(tmp(prefix, stem), Str.concat("call ptr @", Str.concat(if (ty == "Float") "sz_box_float_bits" else "sz_box_i64", Str.concat("(i64 ", Str.concat(v, ")"))))))

def emitAdtNew(prefix: String, tag: Int, payload: String): String =
  line(Str.concat(tmp(prefix, "adt"), Str.concat("call ptr @sz_adt_new(i32 ", Str.concat(Str.fromInt(tag), Str.concat(", ptr ", Str.concat(payload, ")"))))))

def emitCtor(en: String, name: String, prefix: String, ens: List[En]): Slot =
  Slot(emitAdtNew(prefix, ctorTag(ens, en, name), "null"), pct(prefix, "adt"), true)

def ctorTag(ens: List[En], en: String, name: String): Int =
  if (en == "Option") optionTag(name) else if (en == "Result") resultTag(name) else if (en == "Json") jsonTag(name) else ctorTagAt(ens, en, name, 0)

def optionTag(name: String): Int =
  if (name == "Some") 1 else 0

def resultTag(name: String): Int =
  if (name == "Ok") 1 else 0

def jsonTag(name: String): Int =
  if (name == "Bool") 1 else if (name == "Int") 2 else if (name == "Float") 3 else if (name == "Str") 4 else if (name == "Arr") 5 else if (name == "Obj") 6 else 0

def ctorTagAt(ens: List[En], en: String, name: String, i: Int): Int =
  if (List.isEmpty(ens)) 0 else ctorTagHit(List.at(ens, 0), List.tail(ens), en, name, i)

def ctorTagHit(h: En, rest: List[En], en: String, name: String, i: Int): Int =
  h match {
    case En(_, n, _, cases) => if (n == en) caseTag(cases, name, 0) else ctorTagAt(rest, en, name, i + 1)
  }

def caseTag(cs: List[EnCase], name: String, i: Int): Int =
  if (List.isEmpty(cs)) 0 else caseTagHit(List.at(cs, 0), List.tail(cs), name, i)

def caseTagHit(c: EnCase, rest: List[EnCase], name: String, i: Int): Int =
  if (c.name == name) i else caseTag(rest, name, i + 1)

def dotAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 46) i else dotAt(s, i + 1)

def patTag(pat: String, ens: List[En]): Int =
  patTag2(dotAt(patCore(pat), 0), patCore(pat), ens)

def patCore(pat: String): String =
  patCore2(parenAt(pat, 0), pat)

def patCore2(p: Int, pat: String): String =
  if (p < 0) pat else Str.slice(pat, 0, p)

def parenAt(s: String, i: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 40) i else parenAt(s, i + 1)

def patBind(pat: String): String =
  patBind2(parenAt(pat, 0), pat)

def patBind2(p: Int, pat: String): String =
  if (p < 0) "" else Str.slice(pat, p + 1, Str.len(pat) - 1)

def fieldTy(ens: List[En], core: String): String =
  fieldTy2(dotAt(core, 0), core, ens)

def fieldTy2(dot: Int, core: String, ens: List[En]): String =
  if (dot < 0) fieldTyBare(core, ens) else caseFieldTy(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def fieldTyBare(core: String, ens: List[En]): String =
  if (enOfCase(ens, core) == "") recFirstTy(ens, core) else caseFieldTy(ens, enOfCase(ens, core), core)

def recFirstTy(ens: List[En], name: String): String =
  if (List.isEmpty(ens)) "" else recFirstTy1(List.at(ens, 0), List.tail(ens), name)

def recFirstTy1(h: En, rest: List[En], name: String): String =
  h match {
    case En(_, n, _, cases) => if (n == name) recFirstTy2(cases) else recFirstTy(rest, name)
  }

def recFirstTy2(cs: List[EnCase]): String =
  if (List.isEmpty(cs)) "" else recFirstTy3(List.at(cs, 0))

def recFirstTy3(c: EnCase): String =
  c match {
    case EnCase(_, fs) => firstFieldTy(fs)
  }

def caseFieldTy(ens: List[En], en: String, ctor: String): String =
  if (en == "Json") jsonFieldTy(ctor) else if (List.isEmpty(ens)) "" else caseFieldTy1(List.at(ens, 0), List.tail(ens), en, ctor)

def jsonFieldTy(ctor: String): String =
  if (ctor == "Int" || ctor == "Bool") "Int" else if (ctor == "Float") "Float" else if (ctor == "Str") "String" else if (ctor == "Obj") "List[(String, Json)]" else "List[Json]"

def caseFieldTy1(h: En, rest: List[En], en: String, ctor: String): String =
  h match {
    case En(_, name, _, cases) => if (name == en) caseFieldTy2(cases, ctor) else caseFieldTy(rest, en, ctor)
  }

def caseFieldTy2(cs: List[EnCase], ctor: String): String =
  if (List.isEmpty(cs)) "" else caseFieldTy3(List.at(cs, 0), List.tail(cs), ctor)

def caseFieldTy3(h: EnCase, rest: List[EnCase], ctor: String): String =
  h match {
    case EnCase(name, fields) => if (name == ctor) firstFieldTy(fields) else caseFieldTy2(rest, ctor)
  }

def payloadTys(ens: List[En], core: String): List[String] =
  payloadTys2(dotAt(core, 0), core, ens)

def payloadTys2(dot: Int, core: String, ens: List[En]): List[String] =
  if (dot < 0) recTys(ens, core) else caseTys(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def caseTys(ens: List[En], en: String, ctor: String): List[String] =
  if (List.isEmpty(ens)) noStr() else caseTys1(List.at(ens, 0), List.tail(ens), en, ctor)

def caseTys1(h: En, rest: List[En], en: String, ctor: String): List[String] =
  h match {
    case En(_, name, _, cases) => if (name == en) caseTys2(cases, ctor) else caseTys(rest, en, ctor)
  }

def caseTys2(cs: List[EnCase], ctor: String): List[String] =
  if (List.isEmpty(cs)) noStr() else caseTys3(List.at(cs, 0), List.tail(cs), ctor)

def caseTys3(h: EnCase, rest: List[EnCase], ctor: String): List[String] =
  h match {
    case EnCase(name, fields) => if (name == ctor) paramTys(fields) else caseTys2(rest, ctor)
  }

def firstFieldTy(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else paramTyOf(List.at(ps, 0))

def paramTyOf(p: Param): String =
  p match {
    case Param(_, ty, _, _) => ty
  }

def bindIsInt(pat: String, ens: List[En]): Bool =
  payloadIntTy(fieldTy(ens, patCore(pat)), ens)

def payloadIntTy(ft: String, _ens: List[En]): Bool =
  isI64Ty(ft)

def isTyParam(ft: String): Bool =
  Str.len(ft) == 1 && Str.charAt(ft, 0) >= 65 && Str.charAt(ft, 0) <= 90

def tyHead(ft: String): String =
  tyHeadAt(ft, 0)

def tyHeadAt(ft: String, i: Int): String =
  if (i >= Str.len(ft)) ft else if (Str.charAt(ft, i) == 91) Str.slice(ft, 0, i) else tyHeadAt(ft, i + 1)

def fpre(prefix: String, i: Int): String =
  Str.concat(ppre(prefix, i), Str.concat("_f", sid(i)))

def bindStem(prefix: String, i: Int, isInt: Bool): String =
  Str.concat(fpre(prefix, i), if (isInt) "_b0" else "_pl")

def patTag2(dot: Int, pat: String, ens: List[En]): Int =
  if (dot < 0) ctorTag(ens, enOfCase(ens, pat), pat) else ctorTag(ens, Str.slice(pat, 0, dot), Str.slice(pat, dot + 1, Str.len(pat)))

def emitMatch(s: Expr, arms: List[Arm], moff: Int, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  s match {
    case Expr.EVar(n, _) => emitMatchV(n, arms, moff, prefix, strs, defs, ens, ps, loc, fid)
    case _ => emitMatch1(emitExprFid(s, Str.concat(prefix, "_sc"), strs, defs, ens, ps, loc, fid), arms, moff, prefix, strs, defs, Check.specializeEnums(ens, exprRetTyEns(s, defs, ens, ps, loc)), ps, loc, matchSlots(exprRetTyEns(s, defs, ens, ps, loc)), exprIsI64(s, ps, defs), fid + fmCount(s))
  }

def emitMatchV(n: String, arms: List[Arm], moff: Int, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitMatch1(emitExpr(Expr.EVar(n, 0), Str.concat(prefix, "_sc"), strs, defs, ens, ps, loc), arms, moff, prefix, strs, defs, Check.specializeEnums(ens, paramTy(ps, n)), ps, loc, matchSlots(paramTy(ps, n)), paramIsI64(ps, n), fid)

def matchSlots(ty: String): List[String] =
  if (isTupTy(ty)) tupSlots(ty) else listElemSlots(ty)

def listElemSlots(ty: String): List[String] =
  if (Str.startsWith(ty, "List[") && Str.len(ty) > 6) Str.slice(ty, 5, Str.len(ty) - 1) :: noStr() else noStr()

def paramTy(ps: List[Param], n: String): String =
  if (List.isEmpty(ps)) "" else paramTy1(List.at(ps, 0), List.tail(ps), n)

def paramTy1(p: Param, rest: List[Param], n: String): String =
  p match {
    case Param(name, ty, _, _) => if (name == n) ty else paramTy(rest, n)
  }

def tupSlots(ty: String): List[String] =
  if (!isTupTy(ty)) noStr() else splitPat(Str.slice(ty, 1, Str.len(ty) - 1))

def slotInt(tys: List[String], k: Int): Bool =
  if (List.isEmpty(tys)) false else if (k <= 0) isI64Ty(List.at(tys, 0)) else slotInt(List.tail(tys), k - 1)

def oneArm(arms: List[Arm]): Bool =
  !List.isEmpty(arms) && List.isEmpty(List.tail(arms))

def emitMatch1(se: Slot, arms: List[Arm], moff: Int, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, tys: List[String], asI64: Bool, fid: Int): Slot =
  se match {
    case Slot(sc, sv, owned) => emitMatchRelease(emitMatchOksFirst(sc, emitOks(arms, moff, prefix, strs, defs, ens, ps, loc, 0, tys, sv, asI64, fid, !owned && oneArm(arms)), arms, prefix, sv, ens, strs, tys, moff), sv, owned)
  }

def emitMatchRelease(result: Slot, value: String, owned: Bool): Slot =
  Slot(join(result.code, if (owned) relPtr(value) else ""), result.val, result.owned)

def emitMatchOksFirst(sc: String, oks: (String, List[String], Bool, Bool), arms: List[Arm], prefix: String, sv: String, ens: List[En], strs: Strs, tys: List[String], moff: Int): Slot =
  emitMatch2(sc, emitTries(arms, prefix, sv, ens, strs, 0, tys), oks, prefix, isExh(arms), moff, strs)

def isExh(arms: List[Arm]): Bool =
  if (List.isEmpty(arms)) false else isExh2(List.at(arms, 0), List.tail(arms))

def isExh2(h: Arm, t: List[Arm]): Bool =
  if (List.isEmpty(t)) isWild(h) else isExh(t)

def isWild(arm: Arm): Bool =
  arm match {
    case Arm(pat, _, _) => pat == "_"
  }

def emitMatch2(sc: String, tries: String, oks: (String, List[String], Bool, Bool), prefix: String, exh: Bool, moff: Int, strs: Strs): Slot =
  oks match {
    case (okCode, vals, owned, isPtr) => emitMatch3(sc, tries, okCode, vals, owned, isPtr, prefix, exh, moff, strs)
  }

def emitMatch3(sc: String, tries: String, okCode: String, vals: List[String], owned: Bool, isPtr: Bool, prefix: String, exh: Bool, moff: Int, strs: Strs): Slot =
  Slot(join(sc, join(brTry(prefix), join(tries, join(emitDefault(prefix, isPtr, exh, moff, strs), join(okCode, emitMatchPhi(vals, isPtr, owned, prefix, forMissExh(exh, moff))))))), pct(prefix, phiStem(isPtr, owned)), owned)

def phiStem(isPtr: Bool, owned: Bool): String =
  if (isPtr && !owned) "ptr" else "phi"

def forMissExh(exh: Bool, moff: Int): Bool =
  if (moff < 0) true else exh

def brTry(prefix: String): String =
  line(Str.concat("br label %", Str.concat(prefix, "_try_0_0")))

def emitDefault(prefix: String, isPtr: Bool, exh: Bool, moff: Int, strs: Strs): String =
  if (moff < 0) emitForMiss(prefix, strs) else emitDefaultGo(prefix, isPtr, exh)

def emitDefaultGo(prefix: String, isPtr: Bool, exh: Bool): String =
  if (exh) join(lab(Str.concat(prefix, "_default_0")), line("unreachable")) else if (isPtr) join(lab(Str.concat(prefix, "_default_0")), line(Str.concat("br label %", Str.concat(prefix, "_merge_0")))) else join(lab(Str.concat(prefix, "_default_0")), join(line(Str.concat(tmp(prefix, "dflt"), "add i64 0, 0")), line(Str.concat("br label %", Str.concat(prefix, "_merge_0")))))

def emitForMiss(prefix: String, strs: Strs): String =
  join(lab(Str.concat(prefix, "_default_0")), join(line(Str.concat(pct(prefix, "mg"), internGepRhs("for binding does not match", strs))), join(line(Str.concat("call void @sz_panic(ptr ", Str.concat(pct(prefix, "mg"), ")"))), line("unreachable"))))

def emitTries(arms: List[Arm], prefix: String, scrut: String, ens: List[En], strs: Strs, i: Int, tys: List[String]): String =
  if (List.isEmpty(arms)) "" else emitTries2(List.at(arms, 0), List.tail(arms), prefix, scrut, ens, strs, i, tys)

def emitTries2(arm: Arm, rest: List[Arm], prefix: String, scrut: String, ens: List[En], strs: Strs, i: Int, tys: List[String]): String =
  if (List.isEmpty(rest)) emitTry1(arm, prefix, scrut, ens, strs, i, true, tys) else join(emitTry1(arm, prefix, scrut, ens, strs, i, false, tys), emitTries(rest, prefix, scrut, ens, strs, i + 1, tys))

def emitTry1(arm: Arm, prefix: String, scrut: String, ens: List[En], strs: Strs, i: Int, last: Bool, tys: List[String]): String =
  arm match {
    case Arm(pat, _, _) => join(lab(tryLab(prefix, i)), emitTryPat(pat, prefix, i, scrut, ens, strs, last, tys))
  }

def emitTryPat(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], strs: Strs, last: Bool, tys: List[String]): String =
  if (isAsPat(pat)) emitTryPat(stripAs(pat), prefix, i, scrut, ens, strs, last, tys) else emitTryPat2(pat, prefix, i, scrut, ens, strs, last, tys)

def emitTryPat2(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], strs: Strs, last: Bool, tys: List[String]): String =
  if (pat == "_") line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i))))) else if (pat == "[]") emitNilTry(prefix, i, scrut, last) else if (isConsPat(pat)) emitConsTry(prefix, i, scrut, last, slotInt(tys, 0), consTail(pat)) else if (isOrPat(pat)) emitOrTry(pat, prefix, i, scrut, ens, strs, last) else if (isStrPat(pat)) emitStrTry(pat, prefix, i, scrut, strs, last) else if (isIntPat(pat)) emitIntTry(pat, prefix, i, scrut, last) else if (isBoolPat(pat)) emitIntTry(boolPatLit(pat), prefix, i, scrut, last) else if (isTuplePat(pat)) emitTupleTry(pat, prefix, i, scrut, strs, last, tys, ens) else if (isVarPat(pat, ens)) line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i))))) else if (isConsPat(patBind(pat))) emitCtorConsTry(pat, prefix, i, scrut, ens, last, tys) else join(emitTag(prefix, i, scrut, patTag(pat, ens)), join(emitTagBr(prefix, i, last), emitLiteralMatchedPat(pat, prefix, i, scrut, ens, strs, last)))

def emitCtorConsTry(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], last: Bool, tys: List[String]): String =
  join(emitTag(prefix, i, scrut, patTag(pat, ens)), join(emitTagBr(prefix, i, last), emitCtorConsM(pat, prefix, i, scrut, last, tys)))

def emitCtorConsM(pat: String, prefix: String, i: Int, scrut: String, last: Bool, tys: List[String]): String =
  join(lab(Str.concat(ppre(prefix, i), Str.concat("_m", sid(i)))), join(emitPayload2(prefix, i, scrut, false), emitConsTry(prefix, i, pct(fpre(prefix, i), "pl"), last, slotInt(tys, 0), consTail(patBind(pat)))))

def isConsPat(pat: String): Bool =
  consAt(pat, 0) >= 0

def consAt(s: String, i: Int): Int =
  consAtD(s, i, 0)

def consAtD(s: String, i: Int, d: Int): Int =
  if (i + 4 > Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 34) consAtD(s, Parse.quotedEnd(s, i), d) else if (Str.charAt(s, i) == 40) consAtD(s, i + 1, d + 1) else if (Str.charAt(s, i) == 41) consAtD(s, i + 1, if (d > 0) d - 1 else 0) else if (d == 0 && Str.slice(s, i, i + 4) == " :: ") i else consAtD(s, i + 1, d)

def consHead(pat: String): String =
  Str.slice(pat, 0, consAt(pat, 0))

def consTail(pat: String): String =
  Str.slice(pat, consAt(pat, 0) + 4, Str.len(pat))

def emitNilTry(prefix: String, i: Int, scrut: String, last: Bool): String =
  join(line(Str.concat(tmp(ppre(prefix, i), "ne"), Str.concat("call i32 @sz_list_is_empty(ptr ", Str.concat(scrut, ")")))), join(line(Str.concat(tmp(ppre(prefix, i), "nc"), Str.concat("icmp ne i32 ", Str.concat(pct(ppre(prefix, i), "ne"), ", 0")))), line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), "nc"), Str.concat(", label %", Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), Str.concat(", label %", nextLab(prefix, i, last)))))))))))

def emitConsTry(prefix: String, i: Int, scrut: String, last: Bool, unbox: Bool, tail: String): String =
  join(emitConsEmpty(prefix, i, scrut), join(emitConsBr(prefix, i, last), join(lab(Str.concat(ppre(prefix, i), "_cm")), join(emitConsLoad(prefix, i, scrut, unbox), emitConsAfterLoad(tail, prefix, i, last)))))

def emitConsAfterLoad(tail: String, prefix: String, i: Int, last: Bool): String =
  if (tail == "[]") emitConsTailNil(prefix, i, last) else emitConsOk(prefix, i)

def emitConsTailNil(prefix: String, i: Int, last: Bool): String =
  join(line(Str.concat(tmp(ppre(prefix, i), "te"), Str.concat("call i32 @sz_list_is_empty(ptr ", Str.concat(pct(ppre(prefix, i), "ct"), ")")))), join(line(Str.concat(tmp(ppre(prefix, i), "tn"), Str.concat("icmp ne i32 ", Str.concat(pct(ppre(prefix, i), "te"), ", 0")))), line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), "tn"), Str.concat(", label %", Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), Str.concat(", label %", nextLab(prefix, i, last)))))))))))

def emitConsEmpty(prefix: String, i: Int, scrut: String): String =
  join(line(Str.concat(tmp(ppre(prefix, i), "ce"), Str.concat("call i32 @sz_list_is_empty(ptr ", Str.concat(scrut, ")")))), line(Str.concat(tmp(ppre(prefix, i), "cc"), Str.concat("icmp eq i32 ", Str.concat(pct(ppre(prefix, i), "ce"), ", 0")))))

def emitConsBr(prefix: String, i: Int, last: Bool): String =
  line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), "cc"), Str.concat(", label %", Str.concat(ppre(prefix, i), Str.concat("_cm, label %", nextLab(prefix, i, last)))))))

def emitConsLoad(prefix: String, i: Int, scrut: String, unbox: Bool): String =
  join(line(Str.concat(tmp(ppre(prefix, i), "ch"), Str.concat("call ptr @sz_list_head(ptr ", Str.concat(scrut, ")")))), join(line(Str.concat(tmp(ppre(prefix, i), "ct"), Str.concat("call ptr @sz_list_tail(ptr ", Str.concat(scrut, ")")))), if (unbox) line(Str.concat(tmp(ppre(prefix, i), "cu"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(ppre(prefix, i), "ch"), ")")))) else ""))

def emitConsOk(prefix: String, i: Int): String =
  line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))))

def isTuplePat(pat: String): Bool =
  Str.len(pat) > 0 && Str.charAt(pat, 0) == 40

def emitTupleTry(pat: String, prefix: String, i: Int, scrut: String, strs: Strs, last: Bool, tys: List[String], ens: List[En]): String =
  emitTuplePeel(ppre(prefix, i), i + 1, scrut, tys, tupComps(pat), prefix, i, last, strs, true, ens)

def tupComps(pat: String): List[String] =
  splitPat(Str.slice(pat, 1, Str.len(pat) - 1))

def compAt(comps: List[String], k: Int): String =
  if (List.isEmpty(comps)) "" else if (k <= 0) List.at(comps, 0) else compAt(List.tail(comps), k - 1)

def nestComps(comp: String): List[String] =
  if (isTuplePat(comp)) tupComps(comp) else noStr()

def tailComps(comps: List[String]): List[String] =
  if (List.isEmpty(comps)) comps else List.tail(comps)

def emitTuplePeel(pre: String, sid: Int, scrut: String, tys: List[String], comps: List[String], armPrefix: String, armI: Int, last: Bool, strs: Strs, fin: Bool, ens: List[En]): String =
  join(peelLeft(pre, sid, scrut), join(peelRight(pre, sid, scrut), join(peelBrTn(pre, sid), join(peelTnLab(pre, sid), emitTupleCont(pre, sid, tys, comps, armPrefix, armI, last, strs, fin, ens)))))

def emitTupleCont(pre: String, sid: Int, tys: List[String], comps: List[String], armPrefix: String, armI: Int, last: Bool, strs: Strs, fin: Bool, ens: List[En]): String =
  join(if (slotInt(tys, 0)) peelUnboxL(pre, sid) else "", tupleSideTest(compAt(comps, 0), pre, sid, "l", slotInt(tys, 0), strs, emitTupleRest(pre, sid, tys, comps, armPrefix, armI, last, strs, fin, ens), nextLab(armPrefix, armI, last), ens, headTy(tys), armPrefix, armI, last))

def emitTupleRest(pre: String, sid: Int, tys: List[String], comps: List[String], armPrefix: String, armI: Int, last: Bool, strs: Strs, fin: Bool, ens: List[En]): String =
  join(emitNest(pre, sid, "tl", headTy(tys), compAt(comps, 0), armPrefix, armI, last, strs, ens), emitTupleRest2(pre, sid, tys, comps, armPrefix, armI, last, strs, fin, ens))

def emitTupleRest2(pre: String, sid: Int, tys: List[String], comps: List[String], armPrefix: String, armI: Int, last: Bool, strs: Strs, fin: Bool, ens: List[En]): String =
  if (List.len(tys) > 2) emitTuplePeel(Str.concat(pre, Str.concat("_n", Str.fromInt(sid))), sid + 1, pct(pre, Str.concat("tr", Str.fromInt(sid))), List.tail(tys), tailComps(comps), armPrefix, armI, last, strs, fin, ens) else join(emitNest(pre, sid, "tr", secondTy(tys), compAt(comps, 1), armPrefix, armI, last, strs, ens), join(if (slotInt(tys, 1)) peelUnboxR(pre, sid) else "", tupleSideTest(compAt(comps, 1), pre, sid, "r", slotInt(tys, 1), strs, if (fin) tupleBrOk(armPrefix, armI) else "", nextLab(armPrefix, armI, last), ens, secondTy(tys), armPrefix, armI, last)))

def emitNest(pre: String, sid: Int, side: String, ty: String, comp: String, armPrefix: String, armI: Int, last: Bool, strs: Strs, ens: List[En]): String =
  if (!isTupTy(ty)) "" else emitTuplePeel(Str.concat(pre, Str.concat(Str.concat("_", side), Str.fromInt(sid))), 1, pct(pre, Str.concat(side, Str.fromInt(sid))), tupSlots(ty), nestComps(comp), armPrefix, armI, last, strs, false, ens)

def tupleSideTest(comp: String, pre: String, sid: Int, side: String, isInt: Bool, strs: Strs, cont: String, fail: String, ens: List[En], ty: String, armPrefix: String, armI: Int, last: Bool): String =
  if (isIntPat(comp) || isBoolPat(comp)) tupleIntTest(comp, pre, sid, side, isInt, cont, fail) else if (isStrPat(comp)) tupleStrTest(comp, pre, sid, side, strs, cont, fail) else if (isTuplePat(comp)) cont else join(emitFieldTest(comp, if (isInt) tupleSideI64(pre, sid, side) else tupleSideVal(pre, sid, side), ty, armPrefix, armI, ens, strs, last), cont)

def tupleContStem(pre: String, side: String): String =
  Str.concat(pre, Str.concat("_tok", side))

def tupleSideVal(pre: String, sid: Int, side: String): String =
  pct(pre, Str.concat(if (side == "l") "tl" else "tr", Str.fromInt(sid)))

def tupleSideI64(pre: String, sid: Int, side: String): String =
  pct(pre, Str.concat(if (side == "l") "tvl" else "tv", Str.fromInt(sid)))

def tupleIntTest(comp: String, pre: String, sid: Int, side: String, isInt: Bool, cont: String, fail: String): String =
  if (!isInt) cont else join(line(Str.concat(tmp(pre, Str.concat("tie", side)), Str.concat("icmp eq i64 ", Str.concat(tupleSideI64(pre, sid, side), Str.concat(", ", if (isBoolPat(comp)) boolPatLit(comp) else comp))))), join(line(Str.concat("br i1 ", Str.concat(pct(pre, Str.concat("tie", side)), Str.concat(", label %", Str.concat(tupleContStem(pre, side), Str.concat(", label %", fail)))))), join(lab(tupleContStem(pre, side)), cont)))

def tupleStrTest(comp: String, pre: String, sid: Int, side: String, strs: Strs, cont: String, fail: String): String =
  join(tupleStrCompare(unquote(comp), pre, side, tupleSideVal(pre, sid, side), strs), join(line(Str.concat("br i1 ", Str.concat(pct(pre, Str.concat("tseq", side)), Str.concat(", label %", Str.concat(tupleContStem(pre, side), Str.concat(", label %", fail)))))), join(lab(tupleContStem(pre, side)), cont)))

def tupleStrCompare(s: String, pre: String, side: String, val: String, strs: Strs): String =
  join(line(Str.concat(tmp(pre, Str.concat("tsgep", side)), Str.concat("getelementptr inbounds [", Str.concat(Str.fromInt(strArr(s)), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(strIndex(strs, s, 0)), ", i64 0, i64 0")))))), join(line(Str.concat(tmp(pre, Str.concat("tslit", side)), Str.concat("call ptr @sz_string_lit(ptr ", Str.concat(pct(pre, Str.concat("tsgep", side)), ")")))), join(line(Str.concat(tmp(pre, Str.concat("tseqi", side)), Str.concat("call i32 @sz_string_eq(ptr ", Str.concat(val, Str.concat(", ptr ", Str.concat(pct(pre, Str.concat("tslit", side)), ")")))))), join(relPtr(pct(pre, Str.concat("tslit", side))), line(Str.concat(tmp(pre, Str.concat("tseq", side)), Str.concat("icmp ne i32 ", Str.concat(pct(pre, Str.concat("tseqi", side)), ", 0"))))))))

def headTy(tys: List[String]): String =
  if (List.isEmpty(tys)) "" else List.at(tys, 0)

def secondTy(tys: List[String]): String =
  if (List.isEmpty(tys) || List.isEmpty(List.tail(tys))) "" else List.at(List.tail(tys), 0)

def peelLeft(pre: String, sid: Int, scrut: String): String =
  line(Str.concat(tmp(pre, Str.concat("tl", Str.fromInt(sid))), Str.concat("call ptr @sz_pair_left(ptr ", Str.concat(scrut, ")"))))

def peelRight(pre: String, sid: Int, scrut: String): String =
  line(Str.concat(tmp(pre, Str.concat("tr", Str.fromInt(sid))), Str.concat("call ptr @sz_pair_right(ptr ", Str.concat(scrut, ")"))))

def peelBrTn(pre: String, sid: Int): String =
  line(Str.concat("br label %", Str.concat(pre, Str.concat("_tn", Str.fromInt(sid)))))

def peelTnLab(pre: String, sid: Int): String =
  lab(Str.concat(pre, Str.concat("_tn", Str.fromInt(sid))))

def peelUnboxL(pre: String, sid: Int): String =
  line(Str.concat(tmp(pre, Str.concat("tvl", Str.fromInt(sid))), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(pre, Str.concat("tl", Str.fromInt(sid))), ")"))))

def peelUnboxR(pre: String, sid: Int): String =
  line(Str.concat(tmp(pre, Str.concat("tv", Str.fromInt(sid))), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(pre, Str.concat("tr", Str.fromInt(sid))), ")"))))

def tupleBrOk(prefix: String, i: Int): String =
  line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))))

def isStrPat(pat: String): Bool =
  Str.len(pat) >= 2 && Str.charAt(pat, 0) == 34

def isIntPat(pat: String): Bool =
  if (Str.len(pat) == 0) false else isIntPat2(pat, if (Str.charAt(pat, 0) == 45) 1 else 0)

def isIntPat2(pat: String, i: Int): Bool =
  if (i >= Str.len(pat)) i > 0 && (Str.charAt(pat, 0) != 45 || Str.len(pat) > 1) else if (Str.charAt(pat, i) >= 48 && Str.charAt(pat, i) <= 57) isIntPat2(pat, i + 1) else false

def isBoolPat(pat: String): Bool =
  pat == "true" || pat == "false"

def boolPatLit(pat: String): String =
  if (pat == "true") "1" else "0"

def isAsPat(pat: String): Bool =
  asAt(pat, 0) >= 0

def asAt(s: String, i: Int): Int =
  asAtD(s, i, 0)

def asAtD(s: String, i: Int, d: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 34) asAtD(s, Parse.quotedEnd(s, i), d) else if (Str.charAt(s, i) == 40) asAtD(s, i + 1, d + 1) else if (Str.charAt(s, i) == 41) asAtD(s, i + 1, if (d > 0) d - 1 else 0) else if (d == 0 && i + 3 <= Str.len(s) && Str.slice(s, i, i + 3) == " @ ") i else asAtD(s, i + 1, d)

def asName(pat: String): String =
  Str.slice(pat, 0, asAt(pat, 0))

def stripAs(pat: String): String =
  Str.slice(pat, asAt(pat, 0) + 3, Str.len(pat))

def ssaName(v: String): String =
  if (Str.len(v) > 0 && Str.charAt(v, 0) == 37) Str.slice(v, 1, Str.len(v)) else v

def isOrPat(pat: String): Bool =
  orAt(pat, 0) >= 0

def orAt(s: String, i: Int): Int =
  Parse.patternAlternativeAt(s, i, 0)

def orLeft(pat: String): String =
  Str.slice(pat, 0, orAt(pat, 0))

def orRight(pat: String): String =
  Str.slice(pat, orAt(pat, 0) + 3, Str.len(pat))

def emitOrTry(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], strs: Strs, last: Bool): String =
  if (isLiteralAlternative(pat)) emitLiteralAlternatives(pat, prefix, i, scrut, strs, last, 0) else emitConstructorAlternatives(pat, prefix, i, scrut, ens, strs, last)

def isLiteralAlternative(pat: String): Bool =
  if (isOrPat(pat)) isLiteralAlternative(orLeft(pat)) && isLiteralAlternative(orRight(pat)) else isStrPat(pat) || isIntPat(pat) || isBoolPat(pat)

def emitLiteralAlternatives(pat: String, prefix: String, i: Int, scrut: String, strs: Strs, last: Bool, k: Int): String =
  if (isOrPat(pat)) join(emitLiteralAlternative(orLeft(pat), prefix, i, scrut, strs, k, orFailLab(prefix, i, k)), join(lab(orFailLab(prefix, i, k)), emitLiteralAlternatives(orRight(pat), prefix, i, scrut, strs, last, k + 1))) else emitLiteralAlternative(pat, prefix, i, scrut, strs, k, nextLab(prefix, i, last))

def emitLiteralAlternative(pat: String, prefix: String, i: Int, scrut: String, strs: Strs, k: Int, fail: String): String =
  if (isStrPat(pat)) emitStrTry3(unquote(pat), prefix, i, Str.concat("o", Str.fromInt(k)), scrut, strIndex(strs, unquote(pat), 0), fail) else emitScalarAlternative(if (isBoolPat(pat)) boolPatLit(pat) else pat, prefix, i, scrut, k, fail)

def emitScalarAlternative(value: String, prefix: String, i: Int, scrut: String, k: Int, fail: String): String =
  join(line(Str.concat(tmp(ppre(prefix, i), Str.concat("oa", Str.fromInt(k))), Str.concat("icmp eq i64 ", Str.concat(scrut, Str.concat(", ", value))))), line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), Str.concat("oa", Str.fromInt(k))), Str.concat(", label %", Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), Str.concat(", label %", fail)))))))))

def orFailLab(prefix: String, i: Int, k: Int): String =
  Str.concat(ppre(prefix, i), Str.concat("_orf", Str.fromInt(k)))

def emitConstructorAlternatives(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], strs: Strs, last: Bool): String =
  join(emitConstructorChoices(pat, prefix, i, scrut, ens, strs, last, 0), emitAlternativeBindings(pat, prefix, i, ens))

def emitConstructorChoices(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], strs: Strs, last: Bool, k: Int): String =
  if (isOrPat(pat)) join(emitConstructorChoice(orLeft(pat), prefix, i, scrut, ens, strs, k), emitConstructorChoices(orRight(pat), prefix, i, scrut, ens, strs, last, k + 1)) else join(emitConstructorChoice(pat, prefix, i, scrut, ens, strs, k), line(Str.concat("br label %", nextLab(prefix, i, last))))

def emitConstructorChoice(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], strs: Strs, k: Int): String =
  emitConstructorChoiceAt(pat, prefix, Str.concat(prefix, Str.concat("_alt", Str.fromInt(k))), i, scrut, ens, strs)

def emitConstructorChoiceAt(pat: String, prefix: String, alt: String, i: Int, scrut: String, ens: List[En], strs: Strs): String =
  join(emitTag(alt, i, scrut, patTag(pat, ens)), join(emitTagBr(alt, i, false), join(emitLiteralMatchedPat(pat, alt, i, scrut, ens, strs, false), join(lab(Str.concat(alt, Str.concat("_ok_0_", Str.fromInt(i)))), join(line(Str.concat("br label %", Str.concat(ppre(prefix, i), Str.concat("_m", sid(i))))), lab(nextLab(alt, i, false)))))))

def isPatternName(name: String): Bool =
  keepBind(name) && !isStrPat(name) && !isIntPat(name) && !isBoolPat(name) && !isOrPat(name)

def constructorBindings(pat: String, ens: List[En]): List[(String, Ty)] =
  if (patBind(pat) == "") [] else List.filter(Check.bindPat(pat, "", noEnv(), ens), binding => isPatternName(binding._1))

def emitAlternativeBindings(pat: String, prefix: String, i: Int, ens: List[En]): String =
  join(lab(Str.concat(ppre(prefix, i), Str.concat("_m", sid(i)))), join(emitAlternativePhis(constructorBindings(orLeft(pat), ens), pat, prefix, i, ens), emitMatchedEnd(orLeft(pat), prefix, i)))

def emitAlternativePhis(bindings: List[(String, Ty)], pat: String, prefix: String, i: Int, ens: List[En]): String =
  if (List.isEmpty(bindings)) "" else join(emitAlternativePhi(List.at(bindings, 0), pat, prefix, i, ens), emitAlternativePhis(List.tail(bindings), pat, prefix, i, ens))

def emitAlternativePhi(binding: (String, Ty), pat: String, prefix: String, i: Int, ens: List[En]): String =
  line(Str.concat("%", Str.concat(constructorBindingStem(orLeft(pat), binding._1, prefix, i, ens), Str.concat(" = phi ", Str.concat(if (isI64Ty(Type.show(binding._2))) "i64 " else "ptr ", alternativeIncoming(pat, binding._1, prefix, i, ens, 0))))))

def alternativeIncoming(pat: String, name: String, prefix: String, i: Int, ens: List[En], k: Int): String =
  if (isOrPat(pat)) Str.concat(alternativeIncomingOne(orLeft(pat), name, prefix, i, ens, k), Str.concat(", ", alternativeIncoming(orRight(pat), name, prefix, i, ens, k + 1))) else alternativeIncomingOne(pat, name, prefix, i, ens, k)

def alternativeIncomingOne(pat: String, name: String, prefix: String, i: Int, ens: List[En], k: Int): String =
  alternativeIncomingAt(pat, name, Str.concat(prefix, Str.concat("_alt", Str.fromInt(k))), i, ens)

def alternativeIncomingAt(pat: String, name: String, alt: String, i: Int, ens: List[En]): String =
  Str.concat("[ %", Str.concat(constructorBindingStem(pat, name, alt, i, ens), Str.concat(", %", Str.concat(alt, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), " ]"))))))

def constructorBindingStem(pat: String, name: String, prefix: String, i: Int, ens: List[En]): String =
  if (hasComma(patBind(pat)) || namedMulti(pat, ens)) fieldStem(prefix, i, constructorBindingIndex(splitPat(patBind(pat)), name, payloadNames(ens, patCore(pat)), 0), isI64Ty(paramTy(List.map(constructorBindings(pat, ens), binding => Param(binding._1, Type.show(binding._2), "", "")), name))) else bindStem(prefix, i, bindIsInt(pat, ens))

def constructorBindingIndex(fields: List[String], name: String, names: List[String], k: Int): Int =
  if (List.isEmpty(fields)) 0 - 1 else if (fieldBind(List.at(fields, 0)) == name) fieldIdx(List.at(fields, 0), k, names) else constructorBindingIndex(List.tail(fields), name, names, k + 1)

def unquote(pat: String): String =
  unquoteToken(List.at(Lexer.lex(pat), 0))

def unquoteToken(t: SpTok): String =
  t match {
    case SpTok(token, _, _) => unquoteValue(token)
  }

def unquoteValue(t: Tok): String =
  t match {
    case Tok.Str(value) => value
    case _ => ""
  }

def emitStrTry(pat: String, prefix: String, i: Int, scrut: String, strs: Strs, last: Bool): String =
  emitStrTry2(unquote(pat), prefix, i, scrut, strs, last)

def emitStrTry2(s: String, prefix: String, i: Int, scrut: String, strs: Strs, last: Bool): String =
  emitStrTry3(s, prefix, i, "", scrut, strIndex(strs, s, 0), nextLab(prefix, i, last))

def emitStrTry3(s: String, prefix: String, i: Int, tag: String, scrut: String, idx: Int, fail: String): String =
  join(strGep(s, prefix, i, tag, idx), join(strLit(prefix, i, tag), join(strEqi(prefix, i, tag, scrut), join(relPtr(pct(ppre(prefix, i), Str.concat("slit", Str.concat(sid(i), tag)))), join(strSeq(prefix, i, tag), strBrTo(prefix, i, tag, fail))))))

def strGep(s: String, prefix: String, i: Int, tag: String, idx: Int): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("sgep", Str.concat(sid(i), tag))), Str.concat("getelementptr inbounds [", Str.concat(Str.fromInt(strArr(s)), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(idx), ", i64 0, i64 0"))))))

def strLit(prefix: String, i: Int, tag: String): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("slit", Str.concat(sid(i), tag))), Str.concat("call ptr @sz_string_lit(ptr ", Str.concat(pct(ppre(prefix, i), Str.concat("sgep", Str.concat(sid(i), tag))), ")"))))

def strEqi(prefix: String, i: Int, tag: String, scrut: String): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("seqi", Str.concat(sid(i), tag))), Str.concat("call i32 @sz_string_eq(ptr ", Str.concat(scrut, Str.concat(", ptr ", Str.concat(pct(ppre(prefix, i), Str.concat("slit", Str.concat(sid(i), tag))), ")"))))))

def strSeq(prefix: String, i: Int, tag: String): String =
  line(Str.concat(tmp(ppre(prefix, i), Str.concat("seq", Str.concat(sid(i), tag))), Str.concat("icmp ne i32 ", Str.concat(pct(ppre(prefix, i), Str.concat("seqi", Str.concat(sid(i), tag))), ", 0"))))

def strBrTo(prefix: String, i: Int, tag: String, fail: String): String =
  line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), Str.concat("seq", Str.concat(sid(i), tag))), Str.concat(", label %", Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), Str.concat(", label %", fail))))))))

def emitIntTry(pat: String, prefix: String, i: Int, scrut: String, last: Bool): String =
  join(line(Str.concat(tmp(ppre(prefix, i), Str.concat("ieq", sid(i))), Str.concat("icmp eq i64 ", Str.concat(scrut, Str.concat(", ", pat))))), line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), Str.concat("ieq", sid(i))), Str.concat(", label %", Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), Str.concat(", label %", nextLab(prefix, i, last))))))))))

def tryLab(prefix: String, i: Int): String =
  Str.concat(prefix, Str.concat("_try_0_", Str.fromInt(i)))

def nextLab(prefix: String, i: Int, last: Bool): String =
  if (last) Str.concat(prefix, "_default_0") else Str.concat(prefix, Str.concat("_try_0_", Str.fromInt(i + 1)))

def ppre(prefix: String, i: Int): String =
  Str.concat(prefix, Str.concat("_p0_", Str.fromInt(i)))

def sid(i: Int): String =
  Str.fromInt(i + 1)

def emitTag(prefix: String, i: Int, scrut: String, tag: Int): String =
  join(line(Str.concat(tmp(ppre(prefix, i), Str.concat("tg", sid(i))), Str.concat("call i32 @sz_adt_tag(ptr ", Str.concat(scrut, ")")))), line(Str.concat(tmp(ppre(prefix, i), Str.concat("eq", sid(i))), Str.concat("icmp eq i32 ", Str.concat(pct(ppre(prefix, i), Str.concat("tg", sid(i))), Str.concat(", ", Str.fromInt(tag)))))))

def emitTagBr(prefix: String, i: Int, last: Bool): String =
  line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), Str.concat("eq", sid(i))), Str.concat(", label %", Str.concat(ppre(prefix, i), Str.concat("_m", Str.concat(sid(i), Str.concat(", label %", nextLab(prefix, i, last)))))))))

def emitMatchedPat(pat: String, prefix: String, i: Int, scrut: String, ens: List[En]): String =
  join(lab(Str.concat(ppre(prefix, i), Str.concat("_m", sid(i)))), join(emitPayload(pat, prefix, i, scrut, ens), emitMatchedEnd(pat, prefix, i)))

def emitLiteralMatchedPat(pat: String, prefix: String, i: Int, scrut: String, ens: List[En], strs: Strs, last: Bool): String =
  join(lab(Str.concat(ppre(prefix, i), Str.concat("_m", sid(i)))), join(emitPayload(pat, prefix, i, scrut, ens), emitLiteralFields(splitPat(patBind(pat)), pat, prefix, i, ens, strs, last, 0)))

def emitLiteralFields(fields: List[String], pat: String, prefix: String, i: Int, ens: List[En], strs: Strs, last: Bool, k: Int): String =
  join(emitFieldTests(fields, pat, prefix, i, ens, strs, last, k, prefix, i), emitMatchedEnd(pat, prefix, i))

def emitFieldTests(fields: List[String], pat: String, prefix: String, i: Int, ens: List[En], strs: Strs, last: Bool, k: Int, armPrefix: String, armI: Int): String =
  if (List.isEmpty(fields)) "" else join(emitFieldTest(fieldBind(List.at(fields, 0)), literalFieldValue(pat, List.at(fields, 0), prefix, i, k, ens), fieldTyAt(pat, List.at(fields, 0), k, ens), armPrefix, armI, ens, strs, last), emitFieldTests(List.tail(fields), pat, prefix, i, ens, strs, last, k + 1, armPrefix, armI))

def fieldTyAt(pat: String, field: String, k: Int, ens: List[En]): String =
  fieldTyAt2(payloadTys(ens, patCore(pat)), fieldIdx(field, k, payloadNames(ens, patCore(pat))))

def fieldTyAt2(fts: List[String], k: Int): String =
  if (k < 0 || k >= List.len(fts)) "" else List.at(fts, k)

def nestPreOf(v: String): String =
  Str.concat(ssaName(v), "_n")

def isCtorPat(pat: String, ens: List[En]): Bool =
  if (isAsPat(pat) || isConsPat(pat) || isTuplePat(pat) || isOrPat(pat) || isStrPat(pat) || isIntPat(pat) || isBoolPat(pat) || pat == "_" || pat == "[]" || pat == "") false else patBind(pat) != "" || dotAt(patCore(pat), 0) >= 0 || enOfCase(ens, patCore(pat)) != ""

def emitFieldTest(pat: String, value: String, ty: String, armPrefix: String, armI: Int, ens: List[En], strs: Strs, last: Bool): String =
  if (isAsPat(pat)) emitFieldTest(stripAs(pat), value, ty, armPrefix, armI, ens, strs, last) else if (isStrPat(pat) || isIntPat(pat) || isBoolPat(pat)) literalFieldTestTo(pat, value, nestPreOf(value), 0, "lit", strs, nextLab(armPrefix, armI, last)) else if (pat == "[]") emitNestedNil(value, nestPreOf(value), nextLab(armPrefix, armI, last)) else if (isConsPat(pat)) emitNestedCons(pat, value, nestPreOf(value), armPrefix, armI, last, ens, strs, ty) else if (isTuplePat(pat)) emitTuplePeel(ssaName(value), 1, value, tupSlots(ty), tupComps(pat), armPrefix, armI, last, strs, false, ens) else if (isCtorPat(pat, ens)) emitNestedCtor(pat, value, nestPreOf(value), armPrefix, armI, last, ens, strs) else ""

def emitNestedNil(value: String, pre: String, fail: String): String =
  join(line(Str.concat(tmp(pre, "ne"), Str.concat("call i32 @sz_list_is_empty(ptr ", Str.concat(value, ")")))), join(line(Str.concat(tmp(pre, "nc"), Str.concat("icmp ne i32 ", Str.concat(pct(pre, "ne"), ", 0")))), join(line(Str.concat("br i1 ", Str.concat(pct(pre, "nc"), Str.concat(", label %", Str.concat(pre, Str.concat("_ok, label %", fail)))))), lab(Str.concat(pre, "_ok")))))

def emitNestedCons(pat: String, value: String, pre: String, armPrefix: String, armI: Int, last: Bool, ens: List[En], strs: Strs, ty: String): String =
  join(emitConsEmpty(pre, 0, value), join(emitConsBrTo(pre, 0, nextLab(armPrefix, armI, last)), join(lab(Str.concat(ppre(pre, 0), "_cm")), join(emitConsLoad(pre, 0, value, isI64Ty(Check.elemOf(ty))), join(emitFieldTest(consHead(pat), Str.concat("%", consHeadStem(pre, 0, isI64Ty(Check.elemOf(ty)))), Check.elemOf(ty), armPrefix, armI, ens, strs, last), emitFieldTest(consTail(pat), pct(ppre(pre, 0), "ct"), ty, armPrefix, armI, ens, strs, last))))))

def emitConsBrTo(prefix: String, i: Int, fail: String): String =
  line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), "cc"), Str.concat(", label %", Str.concat(ppre(prefix, i), Str.concat("_cm, label %", fail))))))

def emitNestedCtor(pat: String, value: String, pre: String, armPrefix: String, armI: Int, last: Bool, ens: List[En], strs: Strs): String =
  join(emitTag(pre, 0, value, patTag(pat, ens)), join(emitTagBrTo(pre, 0, nextLab(armPrefix, armI, last)), join(lab(Str.concat(ppre(pre, 0), Str.concat("_m", sid(0)))), join(emitPayload(pat, pre, 0, value, ens), emitFieldTests(splitPat(patBind(pat)), pat, pre, 0, ens, strs, last, 0, armPrefix, armI)))))

def emitTagBrTo(prefix: String, i: Int, fail: String): String =
  line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), Str.concat("eq", sid(i))), Str.concat(", label %", Str.concat(ppre(prefix, i), Str.concat("_m", Str.concat(sid(i), Str.concat(", label %", fail))))))))

def literalFieldTestTo(pat: String, value: String, prefix: String, i: Int, tag: String, strs: Strs, fail: String): String =
  join(literalFieldCompare(pat, value, prefix, i, tag, strs), join(line(Str.concat("br i1 ", Str.concat(pct(ppre(prefix, i), Str.concat("seq", Str.concat(sid(i), tag))), Str.concat(", label %", Str.concat(ppre(prefix, i), Str.concat(tag, Str.concat(", label %", fail))))))), lab(Str.concat(ppre(prefix, i), tag))))

def literalFieldValue(pat: String, field: String, prefix: String, i: Int, k: Int, ens: List[En]): String =
  if (hasComma(patBind(pat)) || namedMulti(pat, ens)) Str.concat("%", fieldStem(prefix, i, fieldIdx(field, k, payloadNames(ens, patCore(pat))), slotInt(payloadTys(ens, patCore(pat)), fieldIdx(field, k, payloadNames(ens, patCore(pat)))))) else Str.concat("%", bindStem(prefix, i, bindIsInt(pat, ens)))

def emitLiteralField(pat: String, value: String, prefix: String, i: Int, k: Int, strs: Strs, last: Bool): String =
  if (isStrPat(pat) || isIntPat(pat) || isBoolPat(pat)) literalFieldTestTo(pat, value, prefix, i, Str.concat("lit", Str.fromInt(k)), strs, nextLab(prefix, i, last)) else ""

def literalFieldTest(pat: String, value: String, prefix: String, i: Int, tag: String, strs: Strs, last: Bool): String =
  literalFieldTestTo(pat, value, prefix, i, tag, strs, nextLab(prefix, i, last))

def literalFieldCompare(pat: String, value: String, prefix: String, i: Int, tag: String, strs: Strs): String =
  if (isStrPat(pat)) literalStringCompare(unquote(pat), value, prefix, i, tag, strs) else line(Str.concat(tmp(ppre(prefix, i), Str.concat("seq", Str.concat(sid(i), tag))), Str.concat("icmp eq i64 ", Str.concat(value, Str.concat(", ", if (isBoolPat(pat)) boolPatLit(pat) else pat)))))

def literalStringCompare(s: String, value: String, prefix: String, i: Int, tag: String, strs: Strs): String =
  join(strGep(s, prefix, i, tag, strIndex(strs, s, 0)), join(strLit(prefix, i, tag), join(strEqi(prefix, i, tag, value), join(relPtr(pct(ppre(prefix, i), Str.concat("slit", Str.concat(sid(i), tag)))), strSeq(prefix, i, tag)))))

def emitMatchedEnd(pat: String, prefix: String, i: Int): String =
  if (hasComma(patBind(pat)) || isNamedPat(patBind(pat))) join(line(Str.concat("br label %", Str.concat(ppre(prefix, i), Str.concat("_n", Str.concat(sid(i), "_0"))))), join(lab(Str.concat(ppre(prefix, i), Str.concat("_n", Str.concat(sid(i), "_0")))), line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i))))))) else line(Str.concat("br label %", Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))))

def emitPayload(pat: String, prefix: String, i: Int, scrut: String, ens: List[En]): String =
  if (patBind(pat) == "") "" else if (hasComma(patBind(pat)) || namedMulti(pat, ens)) emitPayloadN(prefix, i, scrut, splitPat(patBind(pat)), 0, payloadTys(ens, patCore(pat)), payloadNames(ens, patCore(pat))) else emitPayload2(prefix, i, scrut, bindIsInt(pat, ens))

def emitPayloadN(prefix: String, i: Int, scrut: String, ns: List[String], k: Int, fts: List[String], names: List[String]): String =
  if (k == 0) join(line(Str.concat(tmp(fpre(prefix, i), "pl"), Str.concat("call ptr @sz_adt_payload(ptr ", Str.concat(scrut, ")")))), emitPayloadN(prefix, i, scrut, ns, 1, fts, names)) else if (List.isEmpty(ns)) "" else join(emitFieldAt(prefix, i, fieldIdx(List.at(ns, 0), k - 1, names), slotInt(fts, fieldIdx(List.at(ns, 0), k - 1, names))), emitPayloadN(prefix, i, scrut, List.tail(ns), k + 1, fts, names))

def emitFieldAt(prefix: String, i: Int, k: Int, isInt: Bool): String =
  join(fieldCell(prefix, i, k), if (isInt) fieldUnbox(prefix, i, k) else "")

def fieldCell(prefix: String, i: Int, k: Int): String =
  fieldCell2(tmp(fpre(prefix, i), Str.concat("c", Str.fromInt(k))), pct(fpre(prefix, i), "pl"), Str.fromInt(k))

def fieldCell2(lhs: String, pl: String, k: String): String =
  line(Str.concat(lhs, Str.concat("call ptr @sz_list_at(ptr ", Str.concat(pl, Str.concat(", i64 ", Str.concat(k, ")"))))))

def fieldUnbox(prefix: String, i: Int, k: Int): String =
  fieldUnbox2(tmp(fpre(prefix, i), Str.concat("b", Str.fromInt(k))), pct(fpre(prefix, i), Str.concat("c", Str.fromInt(k))))

def fieldUnbox2(lhs: String, cell: String): String =
  line(Str.concat(lhs, Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(cell, ")"))))

def hasComma(s: String): Bool =
  commaAt(s, 0) >= 0

def emitPayload2(prefix: String, i: Int, scrut: String, isInt: Bool): String =
  join(line(Str.concat(tmp(fpre(prefix, i), "pl"), Str.concat("call ptr @sz_adt_payload(ptr ", Str.concat(scrut, ")")))), if (isInt) line(Str.concat(tmp(fpre(prefix, i), "b0"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(fpre(prefix, i), "pl"), ")")))) else "")

def emitOks(arms: List[Arm], moff: Int, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String, asI64: Bool, fid: Int, borrow: Bool): (String, List[String], Bool, Bool) =
  if (List.isEmpty(arms)) ("", noStr(), false, false) else emitOks0(List.at(arms, 0), List.tail(arms), moff, prefix, strs, defs, ens, ps, loc, i, tys, sv, asI64, fid, borrow)

def emitOks0(arm: Arm, rest: List[Arm], moff: Int, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String, asI64: Bool, fid: Int, borrow: Bool): (String, List[String], Bool, Bool) =
  arm match {
    case Arm(pat, g, body) => emitOks1g(g, pat, covSlot(body, moff, Str.fromInt(i), emitOkSlotPat(pat, body, prefix, strs, defs, ens, ps, loc, i, tys, sv, asI64, fid, borrow), loc, strs, Str.concat(prefix, Str.concat("_cv", Str.fromInt(i)))), rest, moff, prefix, strs, defs, ens, ps, loc, i, tys, sv, List.isEmpty(rest), asI64, fid + fmCount(body), borrow)
  }

def emitOkSlotPat(pat: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String, asI64: Bool, fid: Int, borrow: Bool): Slot =
  if (isAsPat(pat)) emitOkSlotPat(stripAs(pat), rewriteBind(body, asName(pat), ssaName(sv)), prefix, strs, defs, ens, ps, loc, i, tys, sv, asI64, fid, borrow) else if (isVarPat(pat, ens)) emitOkVar(pat, body, prefix, strs, defs, ens, ps, loc, i, sv, asI64, fid) else emitOkSlotPat2(pat, body, prefix, strs, defs, ens, ps, loc, i, tys, fid, borrow)

def isVarPat(pat: String, ens: List[En]): Bool =
  isSimpleBind(pat) && !isOrPat(pat) && !isTuplePat(pat) && dotAt(pat, 0) < 0 && pat != "_" && pat != "[]" && enOfCase(ens, patCore(pat)) == "" && !isIntPat(pat) && !isBoolPat(pat) && !isStrPat(pat)

def emitOkVar(pat: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, sv: String, asI64: Bool, fid: Int): Slot =
  emitOkVarBps(pat, body, prefix, strs, defs, ens, Param(pat, if (asI64) "Int" else "", "", "") :: dropParam(ps, pat), loc, i, sv, asI64, fid)

def emitOkVarBps(pat: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], bps: List[Param], loc: String, i: Int, sv: String, asI64: Bool, fid: Int): Slot =
  emitOkVar2(bindAliasTy(pat, sv, asI64), emitOkOwned(emitExprFid(body, Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, bps, loc, fid), bps), asI64)

def emitOkVar2(alias: String, s: Slot, asI64: Bool): Slot =
  s match {
    case Slot(code, val, owned) => Slot(join(alias, code), val, owned || !asI64)
  }

def emitOkSlotPat2(pat: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], fid: Int, borrow: Bool): Slot =
  if (isOrPat(pat)) emitOkSlotPat2(orLeft(pat), body, prefix, strs, defs, ens, ps, loc, i, tys, fid, borrow) else if (isConsPat(pat)) emitOkCons(pat, body, prefix, strs, defs, ens, ps, loc, i, tys, fid, borrow) else if (isConsPat(patBind(pat))) emitOkCons(patBind(pat), body, prefix, strs, defs, ens, ps, loc, i, tys, fid, borrow) else if (isTuplePat(pat)) emitOkTuple(pat, body, prefix, strs, defs, ens, ps, loc, i, tys, fid) else if (hasComma(patBind(pat)) || namedMulti(pat, ens)) emitOkFields(pat, body, prefix, strs, defs, ens, ps, loc, i, fid, borrow) else emitOkNestedBind(fieldBind(patBind(pat)), bindStem(prefix, i, bindIsInt(pat, ens)), fieldTy(ens, patCore(pat)), body, prefix, strs, defs, ens, ps, loc, i, fid, borrow)

def patternPayloadParams(pat: String, prefix: String, i: Int, ens: List[En], ps: List[Param]): List[Param] =
  if (!isPatternName(fieldBind(patBind(pat)))) ps else Param(bindStem(prefix, i, bindIsInt(pat, ens)), fieldTy(ens, patCore(pat)), "", "") :: ps

def namedMulti(pat: String, ens: List[En]): Bool =
  isNamedPat(patBind(pat)) && List.len(payloadTys(ens, patCore(pat))) > 1

def isNamedPat(s: String): Bool =
  namedEqAt(s, 0) >= 0

def namedEqAt(s: String, i: Int): Int =
  if (i + 3 > Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 34) namedEqAt(s, Parse.quotedEnd(s, i)) else if (Str.slice(s, i, i + 3) == " = ") i else namedEqAt(s, i + 1)

def fieldBind(s: String): String =
  if (namedEqAt(s, 0) < 0) s else Str.slice(s, namedEqAt(s, 0) + 3, Str.len(s))

def fieldNameOf(s: String): String =
  if (namedEqAt(s, 0) < 0) s else Str.slice(s, 0, namedEqAt(s, 0))

def emitOkCons(pat: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], fid: Int, borrow: Bool): Slot =
  emitOkConsNest(consTail(pat), prefix, i, tys, emitOkPatternBody(rewriteCons(pat, body, prefix, i, slotInt(tys, 0)), Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, consPayloadParams(pat, prefix, i, tys, ps), loc, fid, borrow))

def emitOkPatternBody(body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int, borrow: Bool): Slot =
  emitOkTyped(emitExprFid(body, prefix, strs, defs, ens, ps, loc, fid), exprRetTyEns(body, defs, ens, ps, loc), borrow)

def emitOkTyped(s: Slot, ty: String, borrow: Bool): Slot =
  if (s.owned || isI64Ty(ty) || borrow) s else Slot(join(s.code, retPtr(s.val)), s.val, true)

def emitOkConsNest(t: String, prefix: String, i: Int, tys: List[String], s: Slot): Slot =
  if (isConsPat(t)) emitOkConsNest2(prefix, i, tys, s) else s

def emitOkConsNest2(prefix: String, i: Int, tys: List[String], s: Slot): Slot =
  s match {
    case Slot(code, val, owned) => Slot(join(emitConsNestLoad(prefix, i, tys), code), val, owned)
  }

def emitConsNestLoad(prefix: String, i: Int, tys: List[String]): String =
  join(emitConsNestHead(prefix, i), join(if (slotInt(tys, 0)) line(Str.concat(tmp(ppre(prefix, i), "ncu"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(ppre(prefix, i), "nch"), ")")))) else "", emitConsNestTail(prefix, i)))

def emitConsNestHead(prefix: String, i: Int): String =
  line(Str.concat(tmp(ppre(prefix, i), "nch"), Str.concat("call ptr @sz_list_head(ptr ", Str.concat(pct(ppre(prefix, i), "ct"), ")"))))

def emitConsNestTail(prefix: String, i: Int): String =
  line(Str.concat(tmp(ppre(prefix, i), "nct"), Str.concat("call ptr @sz_list_tail(ptr ", Str.concat(pct(ppre(prefix, i), "ct"), ")"))))

def rewriteCons(pat: String, body: Expr, prefix: String, i: Int, unbox: Bool): Expr =
  rewriteCons2(consAt(pat, 0), pat, body, prefix, i, unbox)

def rewriteCons2(at: Int, pat: String, body: Expr, prefix: String, i: Int, unbox: Bool): Expr =
  rewriteCons3(Str.slice(pat, 0, at), pat, at, body, prefix, i, unbox)

def rewriteCons3(h: String, pat: String, at: Int, body: Expr, prefix: String, i: Int, unbox: Bool): Expr =
  rewriteCons4(h, Str.slice(pat, at + 4, Str.len(pat)), body, prefix, i, unbox)

def rewriteCons4(h: String, t: String, body: Expr, prefix: String, i: Int, unbox: Bool): Expr =
  rewriteConsTail(t, rewriteBind(body, h, consHeadStem(prefix, i, unbox)), prefix, i, unbox)

def rewriteConsTail(t: String, body: Expr, prefix: String, i: Int, unbox: Bool): Expr =
  if (t == "_" || t == "[]") body else if (isConsPat(t)) rewriteBind(rewriteBind(body, consHead(t), Str.concat(ppre(prefix, i), if (unbox) "_ncu" else "_nch")), consTail(t), Str.concat(ppre(prefix, i), "_nct")) else rewriteBind(body, t, Str.concat(ppre(prefix, i), "_ct"))

def consHeadStem(prefix: String, i: Int, unbox: Bool): String =
  Str.concat(ppre(prefix, i), if (unbox) "_cu" else "_ch")

def consPayloadParams(pat: String, prefix: String, i: Int, tys: List[String], ps: List[Param]): List[Param] =
  if (List.isEmpty(tys)) ps else consPayloadParamsTy(pat, prefix, i, List.at(tys, 0), ps)

def consPayloadParamsTy(pat: String, prefix: String, i: Int, ty: String, ps: List[Param]): List[Param] =
  consTailParams(consTail(pat), prefix, i, ty, patternParam(consHead(pat), consHeadStem(prefix, i, isI64Ty(ty)), ty, ps))

def consTailParams(t: String, prefix: String, i: Int, ty: String, ps: List[Param]): List[Param] =
  if (isConsPat(t)) patternParam(consTail(t), Str.concat(ppre(prefix, i), "_nct"), Str.concat("List[", Str.concat(ty, "]")), patternParam(consHead(t), Str.concat(ppre(prefix, i), if (isI64Ty(ty)) "_ncu" else "_nch"), ty, ps)) else patternParam(t, Str.concat(ppre(prefix, i), "_ct"), Str.concat("List[", Str.concat(ty, "]")), ps)

def patternParam(bind: String, stem: String, ty: String, ps: List[Param]): List[Param] =
  if (!keepBind(bind) || bind == "[]") ps else Param(stem, ty, "", "") :: ps

def emitOkFields(pat: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, fid: Int, borrow: Bool): Slot =
  emitOkPatternBody(rewriteFields(splitPat(patBind(pat)), body, prefix, i, 0, payloadTys(ens, patCore(pat)), payloadNames(ens, patCore(pat)), ens), Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, fieldPayloadParams(splitPat(patBind(pat)), payloadTys(ens, patCore(pat)), payloadNames(ens, patCore(pat)), prefix, i, 0, ens, ps), loc, fid, borrow)

def fieldPayloadParams(ns: List[String], fts: List[String], names: List[String], prefix: String, i: Int, k: Int, ens: List[En], ps: List[Param]): List[Param] =
  if (List.isEmpty(ns)) ps else fieldPayloadParams(List.tail(ns), fts, names, prefix, i, k + 1, ens, fieldPayloadParam(List.at(ns, 0), fts, names, prefix, i, k, ens, ps))

def fieldPayloadParam(name: String, fts: List[String], names: List[String], prefix: String, i: Int, k: Int, ens: List[En], ps: List[Param]): List[Param] =
  nestBps(fieldBind(name), fieldStem(prefix, i, fieldIdx(name, k, names), slotInt(fts, fieldIdx(name, k, names))), fieldTyAt2(fts, fieldIdx(name, k, names)), ens, ps)

def nestBps(pat: String, stem: String, ty: String, ens: List[En], ps: List[Param]): List[Param] =
  if (isAsPat(pat)) nestBps(stripAs(pat), stem, ty, ens, patternParam(asName(pat), stem, ty, ps)) else if (isTuplePat(pat)) stemBpsAt(tupComps(pat), ssaName(stem), 1, tupSlots(ty), ens, ps) else if (isConsPat(pat)) consPayloadParams(pat, nestPreOf(stem), 0, Check.elemOf(ty) :: noStr(), ps) else if (isCtorPat(pat, ens)) fieldPayloadParams(splitPat(patBind(pat)), payloadTys(ens, patCore(pat)), payloadNames(ens, patCore(pat)), nestPreOf(stem), 0, 0, ens, ps) else if (pat == "[]" || pat == "_" || !isPatternName(pat)) ps else Param(stem, ty, "", "") :: dropParam(ps, stem)

def emitOkOwned(s: Slot, ps: List[Param]): Slot =
  s match {
    case Slot(code, val, owned) => if (owned || isIntSsa(val) || !isPtrSlot(val, ps)) s else Slot(join(code, retPtr(val)), val, true)
  }

def rewriteFields(ns: List[String], body: Expr, prefix: String, i: Int, k: Int, fts: List[String], names: List[String], ens: List[En]): Expr =
  if (List.isEmpty(ns)) body else rewriteFields(List.tail(ns), rewriteNested(fieldBind(List.at(ns, 0)), fieldStem(prefix, i, fieldIdx(List.at(ns, 0), k, names), slotInt(fts, fieldIdx(List.at(ns, 0), k, names))), fieldTyAt2(fts, fieldIdx(List.at(ns, 0), k, names)), ens, body), prefix, i, k + 1, fts, names, ens)

def rewriteNested(pat: String, stem: String, ty: String, ens: List[En], body: Expr): Expr =
  if (isAsPat(pat)) rewriteBind(rewriteNested(stripAs(pat), stem, ty, ens, body), asName(pat), stem) else if (isTuplePat(pat)) rewriteTupleAt(tupComps(pat), body, ssaName(stem), 1, tupSlots(ty), ens) else if (isConsPat(pat)) rewriteCons(pat, body, nestPreOf(stem), 0, isI64Ty(Check.elemOf(ty))) else if (isCtorPat(pat, ens)) rewriteFields(splitPat(patBind(pat)), body, nestPreOf(stem), 0, 0, payloadTys(ens, patCore(pat)), payloadNames(ens, patCore(pat)), ens) else if (pat == "_" || isPatternName(pat) && pat != "[]") rewriteBind(body, pat, stem) else body

def fieldIdx(h: String, k: Int, names: List[String]): Int =
  if (isNamedPat(h)) idxOf(names, fieldNameOf(h)) else k

def idxOf(xs: List[String], s: String): Int =
  idxOfAt(xs, s, 0)

def idxOfAt(xs: List[String], s: String, i: Int): Int =
  if (List.isEmpty(xs)) 0 else if (Str.eq(List.at(xs, 0), s)) i else idxOfAt(List.tail(xs), s, i + 1)

def payloadNames(ens: List[En], core: String): List[String] =
  payloadNames2(dotAt(core, 0), core, ens)

def payloadNames2(dot: Int, core: String, ens: List[En]): List[String] =
  if (dot < 0) recNames(ens, core) else caseNames(ens, Str.slice(core, 0, dot), Str.slice(core, dot + 1, Str.len(core)))

def caseNames(ens: List[En], en: String, ctor: String): List[String] =
  if (List.isEmpty(ens)) noStr() else caseNames1(List.at(ens, 0), List.tail(ens), en, ctor)

def caseNames1(h: En, rest: List[En], en: String, ctor: String): List[String] =
  h match {
    case En(_, name, _, cases) => if (name == en) caseNames2(cases, ctor) else caseNames(rest, en, ctor)
  }

def caseNames2(cs: List[EnCase], ctor: String): List[String] =
  if (List.isEmpty(cs)) noStr() else caseNames3(List.at(cs, 0), List.tail(cs), ctor)

def caseNames3(h: EnCase, rest: List[EnCase], ctor: String): List[String] =
  h match {
    case EnCase(name, fields) => if (name == ctor) paramNames(fields) else caseNames2(rest, ctor)
  }

def fieldStem(prefix: String, i: Int, k: Int, isInt: Bool): String =
  Str.concat(fpre(prefix, i), Str.concat(if (isInt) "_b" else "_c", Str.fromInt(k)))

def emitOkTuple(pat: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], fid: Int): Slot =
  emitOkTuple2(pat, rewriteTuple(pat, body, prefix, i, tys, ens), prefix, strs, defs, ens, loc, i, stemBps(pat, prefix, i, tys, ens, ps), fid)

def emitOkTuple2(pat: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], loc: String, i: Int, bps: List[Param], fid: Int): Slot =
  emitOkTupleJoin(emitOkOwned(emitExprFid(body, Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, bps, loc, fid), bps), exprIsI64(body, bps, defs))

def emitOkTupleJoin(s: Slot, asI64: Bool): Slot =
  s match {
    case Slot(code, val, owned) => Slot(code, val, owned || !asI64)
  }

def stemBps(pat: String, prefix: String, i: Int, tys: List[String], ens: List[En], ps: List[Param]): List[Param] =
  stemBpsAt(splitPat(Str.slice(pat, 1, Str.len(pat) - 1)), ppre(prefix, i), i + 1, tys, ens, ps)

def stemBpsAt(ns: List[String], pre: String, sid: Int, tys: List[String], ens: List[En], ps: List[Param]): List[Param] =
  if (List.len(ns) < 2) ps else if (List.len(ns) == 2) addStem(List.at(ns, 0), leftStem(pre, sid, tys), stemTy(tys, 0), ens, addStem(List.at(List.tail(ns), 0), rightStem(pre, sid, tys), stemTy(tys, 1), ens, ps)) else addStem(List.at(ns, 0), leftStem(pre, sid, tys), stemTy(tys, 0), ens, stemBpsAt(List.tail(ns), Str.concat(pre, Str.concat("_n", Str.fromInt(sid))), sid + 1, if (List.isEmpty(tys)) tys else List.tail(tys), ens, ps))

def stemTy(tys: List[String], k: Int): String =
  if (k <= 0) headOrAny(tys) else secondOrAny(tys)

def addStem(n: String, stem: String, ty: String, ens: List[En], ps: List[Param]): List[Param] =
  nestBps(n, stem, ty, ens, ps)

def rewriteTuple(pat: String, body: Expr, prefix: String, i: Int, tys: List[String], ens: List[En]): Expr =
  rewriteTupleAt(splitPat(Str.slice(pat, 1, Str.len(pat) - 1)), body, ppre(prefix, i), i + 1, tys, ens)

def rewriteTupleAt(ns: List[String], body: Expr, pre: String, sid: Int, tys: List[String], ens: List[En]): Expr =
  if (List.isEmpty(ns)) body else rewriteTupleAt1(List.at(ns, 0), List.tail(ns), body, pre, sid, tys, ens)

def rewriteTupleAt1(n: String, rest: List[String], body: Expr, pre: String, sid: Int, tys: List[String], ens: List[En]): Expr =
  if (List.isEmpty(rest)) rewriteSlot(n, rightStem(pre, sid, tys), if (List.len(tys) > 1) secondTy(tys) else headTy(tys), ens, body) else rewriteTupleAt2(n, List.at(rest, 0), List.tail(rest), body, pre, sid, tys, ens)

def rewriteTupleAt2(n: String, n2: String, more: List[String], body: Expr, pre: String, sid: Int, tys: List[String], ens: List[En]): Expr =
  if (List.isEmpty(more)) rewriteSlot(n, leftStem(pre, sid, tys), headTy(tys), ens, rewriteSlot(n2, rightStem(pre, sid, tys), secondTy(tys), ens, body)) else rewriteTupleAt1(n2, more, rewriteSlot(n, leftStem(pre, sid, tys), headTy(tys), ens, body), Str.concat(pre, Str.concat("_n", Str.fromInt(sid))), sid + 1, if (List.isEmpty(tys)) tys else List.tail(tys), ens)

def rewriteSlot(n: String, stem: String, ty: String, ens: List[En], body: Expr): Expr =
  rewriteNested(n, stem, ty, ens, body)

def leftStem(pre: String, sid: Int, tys: List[String]): String =
  Str.concat(pre, Str.concat(if (slotInt(tys, 0)) "_tvl" else "_tl", Str.fromInt(sid)))

def rightStem(pre: String, sid: Int, tys: List[String]): String =
  Str.concat(pre, Str.concat(if (slotInt(tys, 1)) "_tv" else "_tr", Str.fromInt(sid)))

def splitPat(s: String): List[String] =
  splitPatAt(s, commaAt(s, 0))

def commaAt(s: String, i: Int): Int =
  commaAtD(s, i, 0)

def commaAtD(s: String, i: Int, d: Int): Int =
  if (i >= Str.len(s)) 0 - 1 else if (Str.charAt(s, i) == 34) commaAtD(s, Parse.quotedEnd(s, i), d) else commaAtC(s, i, d, Str.charAt(s, i))

def commaAtC(s: String, i: Int, d: Int, c: Int): Int =
  if (c == 40) commaAtD(s, i + 1, d + 1) else if (c == 41) commaAtD(s, i + 1, if (d > 0) d - 1 else 0) else if (c == 44 && d == 0) i else commaAtD(s, i + 1, d)

def splitPatAt(s: String, c: Int): List[String] =
  if (c < 0) trimPat(s) :: noStr() else trimPat(Str.slice(s, 0, c)) :: splitPat(Str.slice(s, c + 1, Str.len(s)))

def trimPat(s: String): String =
  trimPat2(s, 0, Str.len(s))

def trimPat2(s: String, a: Int, b: Int): String =
  if (a >= b) "" else if (Str.charAt(s, a) == 32) trimPat2(s, a + 1, b) else if (Str.charAt(s, b - 1) == 32) trimPat2(s, a, b - 1) else Str.slice(s, a, b)

def emitOkSlotBind(bind: String, isInt: Bool, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, fid: Int, borrow: Bool): Slot =
  if (isAsPat(bind)) emitOkSlotBind(asName(bind), isInt, body, prefix, strs, defs, ens, ps, loc, i, fid, borrow) else emitOkPatternBody(if (bind == "") body else rewriteBind(body, bind, bindStem(prefix, i, isInt)), Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, ps, loc, fid, borrow)

def emitOkNestedBind(bind: String, stem: String, ty: String, body: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, fid: Int, borrow: Bool): Slot =
  emitOkPatternBody(rewriteNested(bind, stem, ty, ens, body), Str.concat(prefix, Str.concat("_a0_", Str.fromInt(i))), strs, defs, ens, nestBps(bind, stem, ty, ens, ps), loc, fid, borrow)

def rewriteBind(e: Expr, from: String, to: String): Expr =
  if (from == "") e else rewriteBind1(e, from, to)

def rewriteBind1(e: Expr, from: String, to: String): Expr =
  e match {
    case Expr.EVar(s, off) => if (s == from) Expr.EVar(to, off) else e
    case Expr.EPrint(inner, off) => Expr.EPrint(rewriteBind(inner, from, to), off)
    case Expr.ECall(f, args, off) => Expr.ECall(f, rewriteBindList(args, from, to), off)
    case Expr.EMethod(recv, name, args, off) => Expr.EMethod(rewriteBind(recv, from, to), name, rewriteBindList(args, from, to), off)
    case Expr.EField(recv, name, off) => Expr.EField(rewriteBind(recv, from, to), name, off)
    case Expr.EBin(op, l, r, off) => Expr.EBin(op, rewriteBind(l, from, to), rewriteBind(r, from, to), off)
    case Expr.EUn(op, inner, off) => Expr.EUn(op, rewriteBind(inner, from, to), off)
    case Expr.ELam(p, ty, body) => Expr.ELam(p, ty, rewriteBind(body, from, to))
    case Expr.EIf(c, t, el, off) => Expr.EIf(rewriteBind(c, from, to), rewriteBind(t, from, to), rewriteBind(el, from, to), off)
    case Expr.EMatch(s, arms, off) => Expr.EMatch(rewriteBind(s, from, to), rewriteBindArms(arms, from, to), off)
    case Expr.EList(xs) => Expr.EList(rewriteBindList(xs, from, to))
    case Expr.ETuple(xs) => Expr.ETuple(rewriteBindList(xs, from, to))
    case Expr.ENamed(n, inner) => Expr.ENamed(n, rewriteBind(inner, from, to))
    case Expr.EAscribe(inner, ty, off) => Expr.EAscribe(rewriteBind(inner, from, to), ty, off)
    case Expr.EFor(bs, body, off) => Expr.EFor(rewriteBindBinds(bs, from, to), rewriteBind(body, from, to), off)
    case Expr.EInt(_, _) => e
    case Expr.EBool(_) => e
    case Expr.EStr(_, _) => e
    case Expr.EFloat(s, off) => Expr.EFloat(s, off)
    case Expr.EInterp(s, parts, off) => Expr.EInterp(rewriteInterpStr(s, from, to), rewriteBindList(parts, from, to), off)
    case Expr.EHole => Expr.EHole
    case Expr.EUnit => Expr.EUnit
  }

def rewriteBindBinds(bs: List[Bind], from: String, to: String): List[Bind] =
  if (List.isEmpty(bs)) bs else rewriteBindBindsHit(bs, from, to)

def rewriteBindBindsHit(bs: List[Bind], from: String, to: String): List[Bind] =
  bs match {
    case b :: rest => rewriteBindBinds1(b, rest, from, to)
    case [] => bs
  }

def rewriteBindBinds1(b: Bind, rest: List[Bind], from: String, to: String): List[Bind] =
  b match {
    case Bind(d, n, v) => Bind(d, n, rewriteBind(v, from, to)) :: rewriteBindBinds(rest, from, to)
  }

def rewriteInterpStr(s: String, from: String, to: String): String =
  rewriteInterpAt(s, 0, Builder.empty(), from, to)

def rewriteInterpAt(s: String, i: Int, b: Builder, from: String, to: String): String =
  if (i >= Str.len(s)) Builder.result(b) else rewriteInterpCh(s, i, b, from, to, Str.charAt(s, i))

def rewriteInterpCh(s: String, i: Int, b: Builder, from: String, to: String, c: Int): String =
  if (c == 36) rewriteInterpDollar(s, i, b, from, to) else rewriteInterpAt(s, i + 1, Builder.append(b, Str.slice(s, i, i + 1)), from, to)

def rewriteInterpDollar(s: String, i: Int, b: Builder, from: String, to: String): String =
  if (i + 1 >= Str.len(s)) rewriteInterpAt(s, i + 1, Builder.append(b, "$"), from, to) else rewriteInterpDollar2(s, i, b, from, to, Str.charAt(s, i + 1))

def rewriteInterpDollar2(s: String, i: Int, b: Builder, from: String, to: String, n: Int): String =
  if (n == 123) rewriteInterpBrace(s, i, b, from, to) else if (isIdentStart(n)) rewriteInterpIdent(s, i + 1, b, from, to) else rewriteInterpAt(s, i + 1, Builder.append(b, "$"), from, to)

def rewriteInterpIdent(s: String, i: Int, b: Builder, from: String, to: String): String =
  rewriteInterpIdent2(s, i, i, b, from, to)

def rewriteInterpIdent2(s: String, i: Int, start: Int, b: Builder, from: String, to: String): String =
  if (i >= Str.len(s)) rewriteInterpIdent3(s, i, start, b, from, to) else if (isIdentCont(Str.charAt(s, i))) rewriteInterpIdent2(s, i + 1, start, b, from, to) else rewriteInterpIdent3(s, i, start, b, from, to)

def rewriteInterpIdent3(s: String, i: Int, start: Int, b: Builder, from: String, to: String): String =
  rewriteInterpAt(s, i, Builder.append(Builder.append(b, "$"), rewriteIdent(Str.slice(s, start, i), from, to)), from, to)

def rewriteIdent(n: String, from: String, to: String): String =
  if (n == from) to else n

def rewriteInterpBrace(s: String, i: Int, b: Builder, from: String, to: String): String =
  rewriteInterpBrace2(Parse.interpCloseBrace(s, i + 2, 1), s, i, b, from, to)

def rewriteInterpBrace2(j: Int, s: String, i: Int, b: Builder, from: String, to: String): String =
  rewriteInterpAt(s, j, Builder.append(b, rewriteInterpInner(Str.slice(s, i + 2, j - 1), from, to)), from, to)

def rewriteInterpInner(inner: String, from: String, to: String): String =
  rewriteInterpInner2(Parse.parseExprList(Lexer.lex(inner), 0), from, to)

def rewriteInterpInner2(p: (Expr, Int), from: String, to: String): String =
  p match {
    case (e, _) => Str.concat("${", Str.concat(Parse.pretty0(rewriteBind(e, from, to)), "}"))
  }

def rewriteBindList(xs: List[Expr], from: String, to: String): List[Expr] =
  if (List.isEmpty(xs)) xs else rewriteBindList2(List.at(xs, 0), List.tail(xs), from, to)

def rewriteBindList2(h: Expr, t: List[Expr], from: String, to: String): List[Expr] =
  rewriteBind(h, from, to) :: rewriteBindList(t, from, to)

def rewriteBindArms(arms: List[Arm], from: String, to: String): List[Arm] =
  if (List.isEmpty(arms)) arms else rewriteBindArms2(List.at(arms, 0), List.tail(arms), from, to)

def rewriteBindArms2(h: Arm, t: List[Arm], from: String, to: String): List[Arm] =
  rewriteBindArm(h, from, to) :: rewriteBindArms(t, from, to)

def rewriteBindArm(arm: Arm, from: String, to: String): Arm =
  arm match {
    case Arm(pat, g, body) => Arm(pat, g, rewriteBind(body, from, to))
  }

def emitOks1g(g: String, pat: String, s: Slot, rest: List[Arm], moff: Int, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String, last: Bool, asI64: Bool, fid: Int, borrow: Bool): (String, List[String], Bool, Bool) =
  s match {
    case Slot(code, val, owned) => emitOks2g(g, pat, val, owned, code, emitOks(rest, moff, prefix, strs, defs, ens, ps, loc, i + 1, tys, sv, asI64, fid, borrow), prefix, i, last, strs, defs, ens, ps, loc)
  }

def emitOks2g(g: String, pat: String, val: String, owned: Bool, code: String, p: (String, List[String], Bool, Bool), prefix: String, i: Int, last: Bool, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): (String, List[String], Bool, Bool) =
  p match {
    case (restCode, vals, restOwned, restPtr) => (join(emitOkBodyG(g, pat, code, prefix, i, last, strs, defs, ens, ps, loc), restCode), val :: vals, owned || restOwned, armIsPtr(val, owned, code, ps) || restPtr)
  }

def armIsPtr(val: String, owned: Bool, code: String, ps: List[Param]): Bool =
  owned || val == "null" || isPtrSlot(val, ps) || thenCallPtr(code, val)

def emitOkBodyG(g: String, pat: String, code: String, prefix: String, i: Int, last: Bool, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  if (g == "") emitOkBody(code, prefix, i) else emitOkBodyGuard(emitPatternGuard(pat, g, prefix, strs, defs, ens, ps, loc, i), code, prefix, i, last)

def parseGuard(g: String): Expr =
  parseGuard1(Parse.parseExprList(Lexer.lex(g), 0))

def parseGuard1(p: (Expr, Int)): Expr =
  p match {
    case (e, _) => guardExpr(e)
  }

def guardExpr(e: Expr): Expr =
  e

def emitOkBodyGuard(gs: Slot, code: String, prefix: String, i: Int, last: Bool): String =
  gs match {
    case Slot(gc, gv, _) => join(lab(Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))), join(gc, join(emitGuardBr(gv, prefix, i, last), join(lab(okBodyLab(prefix, i)), join(code, join(line(Str.concat("br label %", Str.concat(prefix, Str.concat("_aj_0_", Str.fromInt(i))))), join(lab(Str.concat(prefix, Str.concat("_aj_0_", Str.fromInt(i)))), line(Str.concat("br label %", Str.concat(prefix, "_merge_0"))))))))))
  }

def emitGuardBr(gv: String, prefix: String, i: Int, last: Bool): String =
  join(line(Str.concat(tmp(Str.concat(prefix, Str.concat("_gc_", Str.fromInt(i))), "cmp"), Str.concat("icmp ne i64 ", Str.concat(gv, ", 0")))), line(Str.concat("br i1 ", Str.concat(pct(Str.concat(prefix, Str.concat("_gc_", Str.fromInt(i))), "cmp"), Str.concat(", label %", Str.concat(okBodyLab(prefix, i), Str.concat(", label %", nextLab(prefix, i, last))))))))

def okBodyLab(prefix: String, i: Int): String =
  Str.concat(prefix, Str.concat("_ok_0_", Str.concat(Str.fromInt(i), "_body")))

def emitOkBody(code: String, prefix: String, i: Int): String =
  join(lab(Str.concat(prefix, Str.concat("_ok_0_", Str.fromInt(i)))), join(code, join(line(Str.concat("br label %", Str.concat(prefix, Str.concat("_aj_0_", Str.fromInt(i))))), join(lab(Str.concat(prefix, Str.concat("_aj_0_", Str.fromInt(i)))), line(Str.concat("br label %", Str.concat(prefix, "_merge_0")))))))

def emitMatchPhi(vals: List[String], isPtr: Bool, owned: Bool, prefix: String, exh: Bool): String =
  join(lab(Str.concat(prefix, "_merge_0")), line(Str.concat(tmp(prefix, phiStem(isPtr, owned)), emitMatchPhi2(vals, isPtr, prefix, exh))))

def emitMatchPhi2(vals: List[String], isPtr: Bool, prefix: String, exh: Bool): String =
  Str.concat("phi ", Str.concat(if (isPtr) "ptr" else "i64", Str.concat(" ", Str.concat(phiParts(vals, isPtr, prefix, 0), if (exh) "" else phiTail(isPtr, prefix)))))

def phiParts(vals: List[String], isPtr: Bool, prefix: String, i: Int): String =
  if (List.isEmpty(vals)) "" else if (List.len(vals) == 1) phiOne(phiArmVal(List.at(vals, 0), isPtr), prefix, i) else Str.concat(phiOne(phiArmVal(List.at(vals, 0), isPtr), prefix, i), Str.concat(", ", phiParts(List.tail(vals), isPtr, prefix, i + 1)))

def phiArmVal(v: String, isPtr: Bool): String =
  if (isPtr && (v == "0" || isI64Lit(v))) "null" else v

def phiOne(v: String, prefix: String, i: Int): String =
  Str.concat("[ ", Str.concat(v, Str.concat(", %", Str.concat(prefix, Str.concat("_aj_0_", Str.concat(Str.fromInt(i), " ]"))))))

def phiTail(isPtr: Bool, prefix: String): String =
  if (isPtr) Str.concat(", [ null, %", Str.concat(prefix, "_default_0 ]")) else Str.concat(", [ ", Str.concat(pct(prefix, "dflt"), Str.concat(", %", Str.concat(prefix, "_default_0 ]"))))

def llvmRet(ret: String): String =
  if (ret == "Int" || ret == "Bool" || ret == "Float") "i64" else "ptr"

def isI64Ty(t: String): Bool =
  t == "Int" || t == "Bool" || t == "Float"

def defParams2(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) oneParam(List.at(ps, 0)) else Str.concat(oneParam(List.at(ps, 0)), Str.concat(", ", defParams2(List.tail(ps))))

def oneParam(p: Param): String =
  if (isI64Ty(p.ty)) Str.concat("i64 %", p.name) else Str.concat("ptr %", p.name)

def emitDefs(ds: List[Fun], strs: Strs, all: Ftab, ens: List[En], files: List[(String, String)], lidx: Map[String, LineIndex]): String =
  Builder.result(emitDefsB(ds, strs, all, ens, files, lidx, Builder.empty()))

def emitDefsB(ds: List[Fun], strs: Strs, all: Ftab, ens: List[En], files: List[(String, String)], lidx: Map[String, LineIndex], b: Builder): Builder =
  if (List.isEmpty(ds)) b else emitDefsB(List.tail(ds), strs, all, ens, files, lidx, Builder.append(b, emitDef(List.at(ds, 0), strs, all, ens, files, lidx)))

def emitDef3(ty: String, name: String, params: String, body: Slot, loc: String, strs: Strs): String =
  Str.concat("define internal ", Str.concat(ty, Str.concat(" @sz_user_", Str.concat(name, emitDefSig(params, ty, body, loc, strs)))))

def emitDefSig(params: String, ty: String, body: Slot, loc: String, strs: Strs): String =
  Str.concat("(", Str.concat(params, Str.concat(") {", Str.concat(nl(), Str.concat(".entry:", Str.concat(nl(), Str.concat(panicPush(loc, strs), emitDef4(ty, body))))))))

def emitDef4(ty: String, body: Slot): String =
  body match {
    case Slot(code, val, owned) => if (ty == "i64" && owned) emitDefUnbox(code, val) else emitDef5(ty, code, val, ty == "ptr" && !owned)
  }

def emitDefUnbox(code: String, val: String): String =
  Str.concat(code, Str.concat(line(Str.concat("%ret_u = call i64 @sz_unbox_i64(ptr ", Str.concat(val, ")"))), Str.concat(if (isFnPack(val)) relPtr(val) else "", Str.concat(panicPop(), Str.concat("  ret i64 %ret_u", Str.concat(nl(), Str.concat("}", Str.concat(nl(), nl()))))))))

def emitDef5(ty: String, code: String, val: String, keep: Bool): String =
  Str.concat(code, Str.concat(if (keep) retPtr(val) else "", Str.concat(panicPop(), Str.concat("  ret ", Str.concat(ty, Str.concat(" ", Str.concat(val, Str.concat(nl(), Str.concat("}", Str.concat(nl(), nl()))))))))))

def emitFromInt(code: String, vals: List[String], prefix: String, ps: List[Param], owns: List[Bool]): Slot =
  emitFromInt2(code, if (List.isEmpty(vals)) "0" else List.at(vals, 0), prefix, ps, headOwn(owns))

def emitFromInt2(code: String, v: String, prefix: String, ps: List[Param], o: Bool): Slot =
  if (o || fromIntUnbox(v, ps) || thenIsPtr(code, v, o, ps)) emitFromIntUnbox(code, v, prefix) else emitFromIntI64(code, v, prefix)

def fromIntUnbox(v: String, ps: List[Param]): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37 && !isI64ParamVal(v, ps) && (!hasSub(v, "_") || hasSub(v, "_tl") || hasSub(v, "_tr") || hasSub(v, "_pl"))

def emitFromIntI64(code: String, v: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_from_int(i64 ", Str.concat(v, ")"))))), pct(prefix, "v"), true)

def emitFromBool(code: String, vals: List[String], prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_from_bool(i64 ", Str.concat(if (List.isEmpty(vals)) "0" else List.at(vals, 0), ")"))))), pct(prefix, "v"), true)

def emitFromIntUnbox(code: String, v: String, prefix: String): Slot =
  emitFromIntUnbox2(join(code, join(unboxLine(v, prefix), fromIntLine(prefix))), prefix)

def unboxLine(v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "u"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(v, ")"))))

def fromIntLine(prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_string_from_int(i64 ", Str.concat(pct(prefix, "u"), ")"))))

def emitFromIntUnbox2(code: String, prefix: String): Slot =
  Slot(code, pct(prefix, "v"), true)

def i64Args(vals: List[String]): String =
  if (List.isEmpty(vals)) "" else if (List.len(vals) == 1) oneVal(List.at(vals, 0)) else Str.concat(oneVal(List.at(vals, 0)), Str.concat(", ", i64Args(List.tail(vals))))

def oneVal(v: String): String =
  if (isI64Lit(v) || isIntSsa(v)) Str.concat("i64 ", v) else Str.concat("ptr ", v)

def emitDef(d: Fun, strs: Strs, defs: Ftab, ens: List[En], files: List[(String, String)], lidx: Map[String, LineIndex]): String =
  emitDefRw(rwDef(d, defs, ens), strs, defs, ens, files, lidx)

def emitDefRw(d: Fun, strs: Strs, defs: Ftab, ens: List[En], files: List[(String, String)], lidx: Map[String, LineIndex]): String =
  d match {
    case Fun(_, _, name, _, ps, ret, body, mod, off) => emitDefByRet(name, mod, ret, ps, body, strs, defs, ens, panicLocAt(files, lidx, mod, off))
  }

def isIoTy(ret: String): Bool =
  Str.len(ret) >= 2 && Str.slice(ret, 0, 2) == "IO"

def emitDefByRet(name: String, mod: String, ret: String, ps: List[Param], body: Expr, strs: Strs, defs: Ftab, ens: List[En], loc: String): String =
  stampNeth(stampCont(Str.concat(emitDefConts(ret, body, strs, defs, ens, ps, loc), emitDefBody(name, mod, ret, ps, body, strs, defs, ens, loc)), contKey(mod, name)), contKey(mod, name))

def emitDefConts(ret: String, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  if (isIoTy(ret) || fmCount(body) > 0) emitConts(body, strs, defs, ens, ps, loc) else ""

def emitDefBody(name: String, mod: String, ret: String, ps: List[Param], body: Expr, strs: Strs, defs: Ftab, ens: List[En], loc: String): String =
  if (!isIoTy(ret) && hasTailIf(body, name)) emitDefTco(name, mod, ret, ps, body, strs, defs, ens, loc) else emitDef3(llvmRet(ret), symOf(mod, name), defParams2(ps), emitExpr(body, "body", strs, defs, ens, ps, loc), loc, strs)

def hasTailIf(e: Expr, name: String): Bool =
  e match {
    case Expr.EIf(_, t, el, _) => isSelfTail(t, name) || isSelfTail(el, name) || hasTailIf(t, name) || hasTailIf(el, name)
    case Expr.EMatch(_, arms, _) => hasTailArm(arms, name)
    case _ => false
  }

def hasTailArm(arms: List[Arm], name: String): Bool =
  !List.isEmpty(arms) && hasTailArm1(List.at(arms, 0), List.tail(arms), name)

def hasTailArm1(a: Arm, rest: List[Arm], name: String): Bool =
  a match {
    case Arm(_, _, body) => isSelfTail(body, name) || hasTailArm(rest, name)
  }

def isSelfTail(e: Expr, name: String): Bool =
  e match {
    case Expr.ECall(f, _, _) => f == name
    case Expr.EMethod(_, f, _, _) => f == name
    case _ => false
  }

def defParamsTco(ps: List[Param]): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) oneParamTco(List.at(ps, 0)) else Str.concat(oneParamTco(List.at(ps, 0)), Str.concat(", ", defParamsTco(List.tail(ps))))

def oneParamTco(p: Param): String =
  if (isI64Ty(p.ty)) Str.concat("i64 %", Str.concat(p.name, "_in")) else Str.concat("ptr %", Str.concat(p.name, "_in"))

def emitDefTco(name: String, mod: String, ret: String, ps: List[Param], body: Expr, strs: Strs, defs: Ftab, ens: List[En], loc: String): String =
  body match {
    case Expr.EIf(c, t, el, ioff) => emitDefTcoIf(name, mod, ret, ps, c, t, el, ioff, strs, defs, ens, loc)
    case Expr.EMatch(s, arms, moff) => emitDefTcoMatch(name, mod, ret, ps, s, arms, moff, strs, defs, ens, loc)
    case _ => emitDef3(llvmRet(ret), symOf(mod, name), defParams2(ps), emitExpr(body, "body", strs, defs, ens, ps, loc), loc, strs)
  }

def emitDefTcoMatch(name: String, mod: String, ret: String, ps: List[Param], s: Expr, arms: List[Arm], moff: Int, strs: Strs, defs: Ftab, ens: List[En], loc: String): String =
  emitDefTcoIf3(llvmRet(ret), symOf(mod, name), defParamsTco(ps), join(emitTcoPrep(ps), emitMatchTail(s, arms, moff, name, llvmRet(ret), strs, defs, ens, ps, loc)), loc, strs)

def emitMatchTail(s: Expr, arms: List[Arm], moff: Int, fname: String, tret: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  emitMatchTail1(emitExpr(s, "body_sc", strs, defs, ens, ps, loc), arms, moff, fname, tret, strs, defs, Check.specializeEnums(ens, exprRetTyEns(s, defs, ens, ps, loc)), ps, loc, matchSlots(exprRetTyEns(s, defs, ens, ps, loc)))

def emitMatchTail1(se: Slot, arms: List[Arm], moff: Int, fname: String, tret: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, tys: List[String]): String =
  se match {
    case Slot(sc, sv, owned) => join(sc, join(brTry("body"), join(emitTries(arms, "body", sv, ens, strs, 0, tys), join(emitDefault("body", false, true, moff, strs), emitOksTail(arms, moff, fname, tret, strs, defs, ens, ps, loc, 0, tys, sv, if (owned) relPtr(sv) else "")))))
  }

def emitOksTail(arms: List[Arm], moff: Int, fname: String, tret: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String, cleanup: String): String =
  if (List.isEmpty(arms)) "" else emitOksTail0(List.at(arms, 0), List.tail(arms), moff, fname, tret, strs, defs, ens, ps, loc, i, tys, sv, cleanup)

def emitOksTail0(arm: Arm, rest: List[Arm], moff: Int, fname: String, tret: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String, cleanup: String): String =
  arm match {
    case Arm(pat, g, body) => join(emitOkTailArm(pat, g, body, moff, fname, tret, strs, defs, ens, ps, loc, i, tys, sv, List.isEmpty(rest), cleanup), emitOksTail(rest, moff, fname, tret, strs, defs, ens, ps, loc, i + 1, tys, sv, cleanup))
  }

def emitOkTailArm(pat: String, g: String, body: Expr, moff: Int, fname: String, tret: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String, last: Bool, cleanup: String): String =
  if (g == "") join(lab(Str.concat("body_ok_0_", Str.fromInt(i))), join(covHitIf(body, moff, Str.fromInt(i), loc, strs, Str.concat("body_cv_", Str.fromInt(i))), emitOkTailBody(pat, body, fname, tret, strs, defs, ens, ps, loc, i, tys, sv, cleanup))) else emitTailGuard(emitTailGuardExpr(pat, g, strs, defs, ens, ps, loc, i), join(covHitIf(body, moff, Str.fromInt(i), loc, strs, Str.concat("body_cv_", Str.fromInt(i))), emitOkTailBody(pat, body, fname, tret, strs, defs, ens, ps, loc, i, tys, sv, cleanup)), i, last)

def emitTailGuardExpr(pat: String, g: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  emitPatternGuard(pat, g, "body", strs, defs, ens, ps, loc, i)

def emitPatternGuard(pat: String, g: String, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int): Slot =
  if (isOrPat(pat)) emitPatternGuard(orLeft(pat), g, prefix, strs, defs, ens, ps, loc, i) else if (hasComma(patBind(pat)) || namedMulti(pat, ens)) emitExpr(rewriteFields(splitPat(patBind(pat)), parseGuard(g), prefix, i, 0, payloadTys(ens, patCore(pat)), payloadNames(ens, patCore(pat)), ens), Str.concat(prefix, Str.concat("_g0_", Str.fromInt(i))), strs, defs, ens, fieldPayloadParams(splitPat(patBind(pat)), payloadTys(ens, patCore(pat)), payloadNames(ens, patCore(pat)), prefix, i, 0, ens, ps), loc) else emitExpr(rewriteNested(fieldBind(patBind(pat)), bindStem(prefix, i, bindIsInt(pat, ens)), fieldTy(ens, patCore(pat)), ens, parseGuard(g)), Str.concat(prefix, Str.concat("_g0_", Str.fromInt(i))), strs, defs, ens, nestBps(fieldBind(patBind(pat)), bindStem(prefix, i, bindIsInt(pat, ens)), fieldTy(ens, patCore(pat)), ens, ps), loc)

def emitTailGuard(gs: Slot, code: String, i: Int, last: Bool): String =
  gs match {
    case Slot(gc, gv, _) => join(lab(Str.concat("body_ok_0_", Str.fromInt(i))), join(gc, join(emitGuardBr(gv, "body", i, last), join(lab(okBodyLab("body", i)), code))))
  }

def emitOkTailBody(pat: String, body: Expr, fname: String, tret: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String, cleanup: String): String =
  if (isSelfTail(body, fname)) join(emitOkTailSlot(pat, body, strs, defs, ens, ps, loc, i, tys, sv, cleanup != "").code, join(cleanup, line("br label %tco_loop"))) else emitOkTailBase(emitOkSlotPat(pat, body, "body", strs, defs, ens, ps, loc, i, tys, sv, false, 0, false), tret, ps, i, cleanup)

def emitOkTailBase(s: Slot, tret: String, ps: List[Param], i: Int, cleanup: String): String =
  s match {
    case Slot(c, v, o) => join(c, emitTcoRetSlots(tret, v, o, ps, Str.concat("ok_", Str.fromInt(i)), cleanup))
  }

def emitOkTailSlot(pat: String, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], sv: String, keep: Bool): Slot =
  if (isAsPat(pat)) emitOkTailSlot(stripAs(pat), rewriteBind(body, asName(pat), ssaName(sv)), strs, defs, ens, ps, loc, i, tys, sv, keep) else emitOkTailSlot2(pat, body, strs, defs, ens, ps, loc, i, tys, keep)

def emitOkTailSlot2(pat: String, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], keep: Bool): Slot =
  if (isOrPat(pat)) emitOkTailSlot2(orLeft(pat), body, strs, defs, ens, ps, loc, i, tys, keep) else if (isConsPat(pat)) emitOkOwned(emitOkConsNest(consTail(pat), "body", i, tys, emitTailLeafTyped(rewriteCons(pat, body, "body", i, slotInt(tys, 0)), strs, defs, ens, ps, consPayloadParams(pat, "body", i, tys, ps), loc, i, keep)), ps) else emitOkTailSlot3(pat, body, strs, defs, ens, ps, loc, i, tys, keep)

def emitOkTailSlot3(pat: String, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, i: Int, tys: List[String], keep: Bool): Slot =
  if (isTuplePat(pat)) emitTailLeafTyped(rewriteTuple(pat, body, "body", i, tys, ens), strs, defs, ens, ps, stemBps(pat, "body", i, tys, ens, ps), loc, i, keep) else if (hasComma(patBind(pat)) || namedMulti(pat, ens)) emitTailLeafTyped(rewriteFields(splitPat(patBind(pat)), body, "body", i, 0, payloadTys(ens, patCore(pat)), payloadNames(ens, patCore(pat)), ens), strs, defs, ens, ps, fieldPayloadParams(splitPat(patBind(pat)), payloadTys(ens, patCore(pat)), payloadNames(ens, patCore(pat)), "body", i, 0, ens, ps), loc, i, keep) else emitTailLeafBind(fieldBind(patBind(pat)), bindIsInt(pat, ens), body, strs, defs, ens, ps, patternPayloadParams(pat, "body", i, ens, ps), loc, i, keep)

def emitTailLeafTyped(body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], bps: List[Param], loc: String, i: Int, keep: Bool): Slot =
  Slot(emitSelfTailTyped(body, Str.concat("body_a0_", Str.fromInt(i)), strs, defs, ens, ps, bps, loc, keep), "tco", false)

def emitTailLeafBind(bind: String, isInt: Bool, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], bps: List[Param], loc: String, i: Int, keep: Bool): Slot =
  if (bind == "" || bind == "_") emitTailLeafTyped(body, strs, defs, ens, ps, bps, loc, i, keep) else emitTailLeafTyped(rewriteBind(body, bind, bindStem("body", i, isInt)), strs, defs, ens, ps, bps, loc, i, keep)

def emitDefTcoIf(name: String, mod: String, ret: String, ps: List[Param], c: Expr, t: Expr, el: Expr, ioff: Int, strs: Strs, defs: Ftab, ens: List[En], loc: String): String =
  emitDefTcoIf2(llvmRet(ret), symOf(mod, name), name, defParamsTco(ps), ps, c, t, el, ioff, strs, defs, ens, loc)

def emitDefTcoIf2(ty: String, sym: String, fname: String, params: String, ps: List[Param], c: Expr, t: Expr, el: Expr, ioff: Int, strs: Strs, defs: Ftab, ens: List[En], loc: String): String =
  emitDefTcoIf3(ty, sym, params, join(emitTcoPrep(ps), emitIfTail(c, t, el, ioff, "body", strs, defs, ens, ps, loc, ty, fname)), loc, strs)

def emitDefTcoIf3(ty: String, name: String, params: String, body: String, loc: String, strs: Strs): String =
  Str.concat("define internal ", Str.concat(ty, Str.concat(" @sz_user_", Str.concat(name, emitDefTcoSig(params, body, loc, strs)))))

def emitDefTcoSig(params: String, body: String, loc: String, strs: Strs): String =
  Str.concat("(", Str.concat(params, Str.concat(") {", Str.concat(nl(), Str.concat(".entry:", Str.concat(nl(), Str.concat(panicPush(loc, strs), Str.concat(body, Str.concat("}", Str.concat(nl(), nl()))))))))))

def emitTcoPrep(ps: List[Param]): String =
  join(emitTcoAlloc(ps, 0), join(line("br label %tco_loop"), join(lab("tco_loop"), emitTcoLoads(ps, 0))))

def emitTcoAlloc(ps: List[Param], i: Int): String =
  if (i >= List.len(ps)) "" else emitTcoAllocOne(List.at(ps, i), ps, i)

def emitTcoAllocOne(p: Param, ps: List[Param], i: Int): String =
  p match {
    case Param(n, ty, _, _) => join(emitTcoAllocN(n, isI64Ty(ty)), emitTcoAlloc(ps, i + 1))
  }

def emitTcoAllocN(n: String, i64: Bool): String =
  if (i64) join(line(Str.concat("%", Str.concat(n, "_slot = alloca i64"))), line(Str.concat("store i64 %", Str.concat(n, Str.concat("_in, ptr %", Str.concat(n, "_slot")))))) else join(line(Str.concat("%", Str.concat(n, "_slot = alloca ptr"))), join(line(Str.concat("store ptr %", Str.concat(n, Str.concat("_in, ptr %", Str.concat(n, "_slot"))))), join(line(Str.concat("%", Str.concat(n, "_held = alloca i1"))), line(Str.concat("store i1 false, ptr %", Str.concat(n, "_held"))))))

def emitTcoLoads(ps: List[Param], i: Int): String =
  if (i >= List.len(ps)) "" else emitTcoLoadOne(List.at(ps, i), ps, i)

def emitTcoLoadOne(p: Param, ps: List[Param], i: Int): String =
  p match {
    case Param(n, ty, _, _) => join(line(Str.concat("%", Str.concat(n, Str.concat(" = load ", Str.concat(if (isI64Ty(ty)) "i64" else "ptr", Str.concat(", ptr %", Str.concat(n, "_slot"))))))), emitTcoLoads(ps, i + 1))
  }

def emitIfTail(c: Expr, t: Expr, el: Expr, ioff: Int, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, ret: String, fname: String): String =
  emitIfTail2(emitExpr(c, Str.concat(prefix, "_ic"), strs, defs, ens, ps, loc), t, el, ioff, prefix, strs, defs, ens, ps, loc, ret, fname)

def emitIfTail2(c: Slot, t: Expr, el: Expr, ioff: Int, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, ret: String, fname: String): String =
  c match {
    case Slot(cc, cv, _) => join(cc, join(emitIfCmp(cv, prefix), join(emitIfBr(prefix), join(join(lab(Str.concat(prefix, "_then_0")), join(covHitIf(t, ioff, "t", loc, strs, Str.concat(prefix, "_cvt")), emitTailArm(t, Str.concat(prefix, "_t"), strs, defs, ens, ps, loc, ret, fname))), join(lab(Str.concat(prefix, "_else_0")), join(covElseTail(el, ioff, loc, strs, prefix), emitTailArm(el, Str.concat(prefix, "_e"), strs, defs, ens, ps, loc, ret, fname)))))))
  }

def covElseTail(el: Expr, ioff: Int, loc: String, strs: Strs, prefix: String): String =
  el match {
    case Expr.EUnit => ""
    case _ => covHitIf(el, ioff, "e", loc, strs, Str.concat(prefix, "_cve"))
  }

def emitTailArm(e: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, ret: String, fname: String): String =
  if (isSelfTail(e, fname)) emitSelfTail(e, prefix, strs, defs, ens, ps, loc) else emitTailArmIf(e, prefix, strs, defs, ens, ps, loc, ret, fname)

def emitTailArmIf(e: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, ret: String, fname: String): String =
  e match {
    case Expr.EIf(c, t, el, ioff) => emitIfTail(c, t, el, ioff, prefix, strs, defs, ens, ps, loc, ret, fname)
    case _ => emitTailBase(e, prefix, strs, defs, ens, ps, loc, ret)
  }

def emitTailBase(e: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, ret: String): String =
  emitTailBase1(emitExpr(e, Str.concat(prefix, "_b"), strs, defs, ens, ps, loc), ret, ps, prefix)

def emitTailBase1(s: Slot, ret: String, ps: List[Param], tag: String): String =
  s match {
    case Slot(tc, tv, to) => join(tc, emitTcoRetSlots(ret, tv, to, ps, tag, ""))
  }

def emitTcoRetSlots(ret: String, tv: String, to: Bool, ps: List[Param], tag: String, cleanup: String): String =
  join(if (ret == "ptr" && !to) retPtr(tv) else "", join(cleanup, join(emitTcoReleases(ps, 0, Str.concat(tag, "_rb")), join(panicPop(), line(Str.concat(if (ret == "ptr") "ret ptr " else "ret i64 ", tv))))))

def emitSelfTail(e: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  join(emitSelfTailTyped(e, prefix, strs, defs, ens, ps, ps, loc, false), line("br label %tco_loop"))

def emitSelfTailTyped(e: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], bps: List[Param], loc: String, keep: Bool): String =
  e match {
    case Expr.ECall(_, args, _) => emitSelfTailAcc(args, prefix, strs, defs, ens, ps, bps, loc, 0, "", noStr(), keep)
    case Expr.EMethod(_, _, args, _) => emitSelfTailAcc(args, prefix, strs, defs, ens, ps, bps, loc, 0, "", noStr(), keep)
    case _ => ""
  }

def emitSelfTailAcc(args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], bps: List[Param], loc: String, i: Int, code: String, vals: List[String], keep: Bool): String =
  if (List.isEmpty(args)) emitTcoCommit(code, ps, vals, prefix) else emitSelfTailOne(List.at(args, 0), List.tail(args), prefix, strs, defs, ens, ps, bps, loc, i, code, vals, keep)

def emitSelfTailOne(a: Expr, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], bps: List[Param], loc: String, i: Int, code: String, vals: List[String], keep: Bool): String =
  emitSelfTailGot(emitExpr(a, Str.concat(prefix, Str.concat("_targ", Str.fromInt(i))), strs, defs, ens, bps, loc), rest, prefix, strs, defs, ens, ps, bps, loc, i, code, vals, keep)

def emitSelfTailGot(s: Slot, rest: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], bps: List[Param], loc: String, i: Int, code: String, vals: List[String], keep: Bool): String =
  s match {
    case Slot(c, v, o) => emitSelfTailAcc(rest, prefix, strs, defs, ens, ps, bps, loc, i + 1, join(code, c), List.concat(vals, tcoMarkArg(v, o, keep) :: noStr()), keep)
  }

def tcoMark(v: String, o: Bool): String =
  tcoMarkArg(v, o, false)

def tcoMarkArg(v: String, o: Bool, keep: Bool): String =
  if (o) Str.concat("~", v) else if (keep) Str.concat("!", v) else v

def tcoVal(v: String): String =
  if (Str.startsWith(v, "~") || Str.startsWith(v, "!")) Str.slice(v, 1, Str.len(v)) else v

def tcoKeep(v: String): Bool =
  Str.startsWith(v, "!")

def emitTcoCommit(code: String, ps: List[Param], vals: List[String], tag: String): String =
  join(code, join(emitTcoAny(ps, vals, tag), join(emitTcoRetains(ps, vals, 0, tag), join(emitTcoReleases(ps, 0, tag), join(emitTcoStores(ps, vals, 0), join(emitTcoHeld(ps, vals, 0, tag), emitTcoTempRels(ps, vals, 0)))))))

def tcoOwned(v: String): Bool =
  Str.startsWith(v, "~")

def tcoBorrow(ps: List[Param], vals: List[String], i: Int): Bool =
  if (i >= List.len(ps) || i >= List.len(vals)) false else tcoBorrowOne(List.at(ps, i), List.at(vals, i), ps, vals, i)

def tcoBorrowOne(p: Param, v: String, ps: List[Param], vals: List[String], i: Int): Bool =
  p match {
    case Param(_, ty, _, _) => if (!isI64Ty(ty) && !tcoOwned(v) && !tcoKeep(v)) true else tcoBorrow(ps, vals, i + 1)
  }

def tcoPtrN(ps: List[Param], i: Int, n: Int): Int =
  if (i >= List.len(ps)) n else tcoPtrN1(List.at(ps, i), ps, i, n)

def tcoPtrN1(p: Param, ps: List[Param], i: Int, n: Int): Int =
  p match {
    case Param(_, ty, _, _) => tcoPtrN(ps, i + 1, if (isI64Ty(ty)) n else n + 1)
  }

def tcoHfName(i: Int, tag: String): String =
  Str.concat("%tco_hf", Str.concat(Str.fromInt(i), Str.concat("_", tag)))

def tcoOrName(i: Int, tag: String): String =
  Str.concat("%tco_or", Str.concat(Str.fromInt(i), Str.concat("_", tag)))

def tcoAnyPrev(tag: String, seen: Int): String =
  if (seen <= 1) tcoHfName(0, tag) else tcoOrName(seen - 1, tag)

def tcoAnyRef(ps: List[Param], tag: String): String =
  tcoAnyRefN(tcoPtrN(ps, 0, 0), tag)

def tcoAnyRefN(n: Int, tag: String): String =
  if (n <= 1) tcoHfName(0, tag) else tcoOrName(n - 1, tag)

def emitTcoAny(ps: List[Param], vals: List[String], tag: String): String =
  if (tcoBorrow(ps, vals, 0)) emitTcoAnyGo(ps, 0, tag, 0) else ""

def emitTcoAnyGo(ps: List[Param], i: Int, tag: String, seen: Int): String =
  if (i >= List.len(ps)) "" else emitTcoAnyOne(List.at(ps, i), ps, i, tag, seen)

def emitTcoAnyOne(p: Param, ps: List[Param], i: Int, tag: String, seen: Int): String =
  p match {
    case Param(n, ty, _, _) => if (isI64Ty(ty)) emitTcoAnyGo(ps, i + 1, tag, seen) else join(emitTcoAnyLoad(n, tag, seen), emitTcoAnyGo(ps, i + 1, tag, seen + 1))
  }

def emitTcoAnyLoad(n: String, tag: String, seen: Int): String =
  if (seen == 0) line(Str.concat(tcoHfName(0, tag), Str.concat(" = load i1, ptr %", Str.concat(n, "_held")))) else join(line(Str.concat(tcoHfName(seen, tag), Str.concat(" = load i1, ptr %", Str.concat(n, "_held")))), line(Str.concat(tcoOrName(seen, tag), Str.concat(" = or i1 ", Str.concat(tcoAnyPrev(tag, seen), Str.concat(", ", tcoHfName(seen, tag)))))))

def emitTcoRetains(ps: List[Param], vals: List[String], i: Int, tag: String): String =
  if (i >= List.len(ps) || i >= List.len(vals)) "" else emitTcoRetainOne(List.at(ps, i), List.at(vals, i), ps, vals, i, tag)

def emitTcoRetainOne(p: Param, v: String, ps: List[Param], vals: List[String], i: Int, tag: String): String =
  p match {
    case Param(_, ty, _, _) => join(emitTcoRetainTy(ty, v, ps, i, tag), emitTcoRetains(ps, vals, i + 1, tag))
  }

def emitTcoRetainTy(ty: String, v: String, ps: List[Param], i: Int, tag: String): String =
  if (isI64Ty(ty)) "" else if (tcoOwned(v) || tcoKeep(v)) retPtr(tcoVal(v)) else emitTcoRetainBr(tcoVal(v), ps, i, tag)

def emitTcoRetainBr(v: String, ps: List[Param], i: Int, tag: String): String =
  join(line(Str.concat("br i1 ", Str.concat(tcoAnyRef(ps, tag), Str.concat(", label %", Str.concat(tcoLab("keep", i, tag), Str.concat(", label %", tcoLab("nok", i, tag))))))), join(lab(tcoLab("keep", i, tag)), join(retPtr(v), join(line(Str.concat("br label %", tcoLab("nok", i, tag))), lab(tcoLab("nok", i, tag))))))

def emitTcoReleases(ps: List[Param], i: Int, tag: String): String =
  if (i >= List.len(ps)) "" else emitTcoReleaseOne(List.at(ps, i), ps, i, tag)

def emitTcoReleaseOne(p: Param, ps: List[Param], i: Int, tag: String): String =
  p match {
    case Param(n, ty, _, _) => join(if (isI64Ty(ty)) "" else emitTcoReleaseN(n, i, tag), emitTcoReleases(ps, i + 1, tag))
  }

def emitTcoReleaseN(n: String, i: Int, tag: String): String =
  join(emitTcoHv(n, i, tag), join(emitTcoRelBr(i, tag), join(lab(tcoLab("rel", i, tag)), join(emitTcoOld(n, i, tag), join(emitTcoRelCall(i, tag), join(line(Str.concat("br label %", tcoLab("skip", i, tag))), lab(tcoLab("skip", i, tag))))))))

def tcoLab(kind: String, i: Int, tag: String): String =
  Str.concat("tco_", Str.concat(kind, Str.concat("_", Str.concat(Str.fromInt(i), Str.concat("_", tag)))))

def tcoSsa(kind: String, i: Int, tag: String): String =
  Str.concat("%tco_", Str.concat(kind, Str.concat(Str.fromInt(i), Str.concat("_", tag))))

def emitTcoHv(n: String, i: Int, tag: String): String =
  line(Str.concat(tcoSsa("hv", i, tag), Str.concat(" = load i1, ptr %", Str.concat(n, "_held"))))

def emitTcoRelBr(i: Int, tag: String): String =
  line(Str.concat("br i1 ", Str.concat(tcoSsa("hv", i, tag), Str.concat(", label %", Str.concat(tcoLab("rel", i, tag), Str.concat(", label %", tcoLab("skip", i, tag)))))))

def emitTcoOld(n: String, i: Int, tag: String): String =
  line(Str.concat(tcoSsa("old", i, tag), Str.concat(" = load ptr, ptr %", Str.concat(n, "_slot"))))

def emitTcoRelCall(i: Int, tag: String): String =
  line(Str.concat("call void @sz_release(ptr ", Str.concat(tcoSsa("old", i, tag), ")")))

def emitTcoStores(ps: List[Param], vals: List[String], i: Int): String =
  if (i >= List.len(ps) || i >= List.len(vals)) "" else emitTcoStoreOne(List.at(ps, i), List.at(vals, i), ps, vals, i)

def emitTcoStoreOne(p: Param, v: String, ps: List[Param], vals: List[String], i: Int): String =
  p match {
    case Param(n, ty, _, _) => join(line(Str.concat("store ", Str.concat(if (isI64Ty(ty)) "i64 " else "ptr ", Str.concat(tcoVal(v), Str.concat(", ptr %", Str.concat(n, "_slot")))))), emitTcoStores(ps, vals, i + 1))
  }

def emitTcoTempRels(ps: List[Param], vals: List[String], i: Int): String =
  if (i >= List.len(ps) || i >= List.len(vals)) "" else emitTcoTempRelOne(List.at(ps, i), List.at(vals, i), ps, vals, i)

def emitTcoTempRelOne(p: Param, v: String, ps: List[Param], vals: List[String], i: Int): String =
  p match {
    case Param(_, ty, _, _) => join(if (isI64Ty(ty)) "" else emitTcoTempRel(v), emitTcoTempRels(ps, vals, i + 1))
  }

def emitTcoTempRel(v: String): String =
  if (Str.startsWith(v, "~")) line(Str.concat("call void @sz_release(ptr ", Str.concat(tcoVal(v), ")"))) else ""

def emitTcoHeld(ps: List[Param], vals: List[String], i: Int, tag: String): String =
  if (i >= List.len(ps) || i >= List.len(vals)) "" else emitTcoHeldOne(List.at(ps, i), List.at(vals, i), ps, vals, i, tag)

def emitTcoHeldOne(p: Param, v: String, ps: List[Param], vals: List[String], i: Int, tag: String): String =
  p match {
    case Param(n, ty, _, _) => join(if (isI64Ty(ty)) "" else emitTcoHeldStore(n, v, ps, tag), emitTcoHeld(ps, vals, i + 1, tag))
  }

def emitTcoHeldStore(n: String, v: String, ps: List[Param], tag: String): String =
  if (tcoOwned(v) || tcoKeep(v)) line(Str.concat("store i1 true, ptr %", Str.concat(n, "_held"))) else line(Str.concat("store i1 ", Str.concat(tcoAnyRef(ps, tag), Str.concat(", ptr %", Str.concat(n, "_held")))))

def contKey(mod: String, name: String): String =
  if (mod == "") name else Str.concat(mod, Str.concat("_", name))

def stampCont(ir: String, key: String): String =
  stampFrom(ir, "@sz_cont_", Str.concat("@sz_cont_", Str.concat(key, "_")))

def stampNeth(ir: String, key: String): String =
  stampFrom(ir, "@sz_neth_", Str.concat("@sz_neth_", Str.concat(key, "_")))

def stampFrom(s: String, old: String, neu: String): String =
  Str.replace(s, old, neu)

def rwDef(d: Fun, defs: Ftab, ens: List[En]): Fun =
  d match {
    case Fun(priv, ora, name, ts, ps, ret, body, mod, off) => Fun(priv, ora, name, ts, ps, ret, rwFields(body, paramEnv(ps), defs, ens, mod), mod, off)
  }

def paramEnv(ps: List[Param]): List[(String, Ty)] =
  if (List.isEmpty(ps)) noEnv() else paramEnv1(List.at(ps, 0), List.tail(ps))

def paramEnv1(p: Param, rest: List[Param]): List[(String, Ty)] =
  p match {
    case Param(n, ty, _, _) => envBind(n, ty, paramEnv(rest))
  }

def rwFields(e: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): Expr =
  e match {
    case Expr.EPrint(inner, off) => Expr.EPrint(rwFields(inner, env, funs, ens, mod), off)
    case Expr.ECall(f, args, off) => rwCall(f, rwFieldCallArgs(args, funParamsOf(funs, f, mod), env, funs, ens, mod), funs, mod, off)
    case Expr.EMethod(recv, name, args, off) => Expr.EMethod(rwFields(recv, env, funs, ens, mod), name, rwFieldMethodArgs(recv, name, args, env, funs, ens, mod), off)
    case Expr.EField(recv, name, off) => rwField(rwFields(recv, env, funs, ens, mod), name, off, env, funs, ens)
    case Expr.EBin(op, l, r, off) => Expr.EBin(op, rwFields(l, env, funs, ens, mod), rwFields(r, env, funs, ens, mod), off)
    case Expr.EUn(op, inner, off) => Expr.EUn(op, rwFields(inner, env, funs, ens, mod), off)
    case Expr.ELam(p, ty, body) => Expr.ELam(p, ty, rwFields(body, envBind(p, ty, env), funs, ens, mod))
    case Expr.EIf(c, t, el, off) => Expr.EIf(rwFields(c, env, funs, ens, mod), rwFields(t, env, funs, ens, mod), rwFields(el, env, funs, ens, mod), off)
    case Expr.EMatch(s, arms, off) => Expr.EMatch(rwFields(s, env, funs, ens, mod), rwFieldArms(arms, env, funs, ens, mod), off)
    case Expr.EList(xs) => Expr.EList(rwFieldList(xs, env, funs, ens, mod))
    case Expr.ETuple(xs) => Expr.ETuple(rwFieldList(xs, env, funs, ens, mod))
    case Expr.ENamed(n, inner) => Expr.ENamed(n, rwFields(inner, env, funs, ens, mod))
    case Expr.EAscribe(inner, ty, off) => Expr.EAscribe(rwFields(inner, env, funs, ens, mod), ty, off)
    case Expr.EFor(bs, body, off) => Expr.EFor(rwForBinds(bs, env, funs, ens, mod), rwFields(body, env, funs, ens, mod), off)
    case _ => e
  }

def rwFieldMethodArgs(recv: Expr, name: String, args: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): List[Expr] =
  recv match {
    case Expr.EVar(owner, _) => rwFieldCallArgs(args, funParamsOf(funs, name, owner), env, funs, ens, mod)
    case _ => rwFieldList(args, env, funs, ens, mod)
  }

def rwFieldCallArgs(args: List[Expr], params: List[Param], env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): List[Expr] =
  rwFieldCallArgsGo(args, params, params, env, funs, ens, mod)

def rwFieldCallArgsGo(args: List[Expr], params: List[Param], all: List[Param], env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): List[Expr] =
  if (List.isEmpty(args)) noExpr() else if (List.isEmpty(params)) rwFieldList(args, env, funs, ens, mod) else rwFieldCallArg(List.at(args, 0), List.at(params, 0), all, env, funs, ens, mod) :: rwFieldCallArgsGo(List.tail(args), List.tail(params), all, env, funs, ens, mod)

def rwFieldCallArg(arg: Expr, param: Param, all: List[Param], env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): Expr =
  arg match {
    case Expr.ENamed(name, inner) => Expr.ENamed(name, rwFieldCallArgTy(inner, paramTy(all, name), env, funs, ens, mod))
    case _ => rwFieldCallArgTy(arg, paramTyOf(param), env, funs, ens, mod)
  }

def rwFieldCallArgTy(arg: Expr, ty: String, env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): Expr =
  arg match {
    case Expr.ELam(p, ann, body) => Expr.ELam(p, ann, rwFields(body, envBind(p, if (ann != "") ann else if (isFunTy(ty)) Type.funArgStr(ty) else "", env), funs, ens, mod))
    case _ => rwFields(arg, env, funs, ens, mod)
  }

def rwCall(f: String, args: List[Expr], funs: Ftab, mod: String, off: Int): Expr =
  if (List.isEmpty(findDefMod(funs, mod, f))) Expr.ECall(f, args, off) else Expr.EMethod(Expr.EVar(mod, 0), f, args, off)

def rwFieldList(xs: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): List[Expr] =
  if (List.isEmpty(xs)) noExpr() else rwFieldListGo(xs, env, funs, ens, mod)

def rwFieldListGo(xs: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): List[Expr] =
  rwFieldListH(List.at(xs, 0), env, funs, ens, mod, xs)

def rwFieldListH(h: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String, xs: List[Expr]): List[Expr] =
  rwFieldListT(h, env, funs, ens, mod, List.tail(xs))

def rwFieldListT(h: Expr, env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String, rest: List[Expr]): List[Expr] =
  rwFieldListCons(rwFields(h, env, funs, copyEns(ens), mod), rest, env, funs, ens, mod)

def rwFieldListCons(e: Expr, rest: List[Expr], env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): List[Expr] =
  e :: rwFieldList(rest, env, funs, ens, mod)

def rwFieldArms(arms: List[Arm], env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): List[Arm] =
  if (List.isEmpty(arms)) noArm() else rwFieldArm(List.at(arms, 0), env, funs, ens, mod) :: rwFieldArms(List.tail(arms), env, funs, ens, mod)

def rwForBinds(bs: List[Bind], env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): List[Bind] =
  if (List.isEmpty(bs)) bs else rwForBindsHit(bs, env, funs, ens, mod)

def rwForBindsHit(bs: List[Bind], env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): List[Bind] =
  bs match {
    case b :: rest => rwForBinds1(b, rest, env, funs, ens, mod)
    case [] => bs
  }

def rwForBinds1(b: Bind, rest: List[Bind], env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): List[Bind] =
  b match {
    case Bind(d, n, v) => Bind(d, n, rwFields(v, env, funs, ens, mod)) :: rwForBinds(rest, env, funs, ens, mod)
  }

def rwFieldArm(a: Arm, env: List[(String, Ty)], funs: Ftab, ens: List[En], mod: String): Arm =
  a match {
    case Arm(pat, g, body) => Arm(pat, g, rwFields(body, env, funs, ens, mod))
  }

def rwField(recv: Expr, name: String, off: Int, env: List[(String, Ty)], funs: Ftab, ens: List[En]): Expr =
  recv match {
    case Expr.EVar(en, _) => rwFieldVar(en, name, off, env, ens)
    case Expr.EMethod(r, m, args, _) => rwFieldMethod(r, m, args, name, off, env, funs, ens)
    case Expr.ECall(f, args, coff) => rwFieldTy(Expr.ECall(f, args, coff), name, off, copyEnCall(f, ens, funs), ens)
    case _ => rwFieldTy(recv, name, off, copyEn(recv, ens, funs), ens)
  }

def rwFieldVar(en: String, name: String, off: Int, env: List[(String, Ty)], ens: List[En]): Expr =
  if (hasEn(ens, en)) Expr.EField(Expr.EVar(en, 0), name, off) else rwFieldTy(Expr.EVar(en, 0), name, off, Type.show(getTy(env, en)), ens)

def rwFieldMethod(r: Expr, m: String, args: List[Expr], name: String, off: Int, _env: List[(String, Ty)], funs: Ftab, ens: List[En]): Expr =
  r match {
    case Expr.EVar(mod, _) => rwFieldQualHit(m, args, name, off, ens, findDefMod(funs, mod, m))
    case _ => rwFieldTy(Expr.EMethod(r, m, args, 0), name, off, copyEn(Expr.EMethod(r, m, args, 0), ens, funs), ens)
  }

def rwFieldQualHit(m: String, args: List[Expr], name: String, off: Int, ens: List[En], hit: List[Fun]): Expr =
  if (List.isEmpty(hit)) Expr.EField(Expr.EMethod(Expr.EVar("", 0), m, args, 0), name, off) else rwFieldQualFun(m, args, name, off, ens, List.at(hit, 0))

def rwFieldQualFun(m: String, args: List[Expr], name: String, off: Int, ens: List[En], d: Fun): Expr =
  d match {
    case Fun(_, _, _, _, _, ret, _, mod, _) => rwFieldTy(Expr.EMethod(Expr.EVar(mod, 0), m, args, 0), name, off, ret, ens)
  }

def rwFieldTy(recv: Expr, name: String, off: Int, ty: String, ens: List[En]): Expr =
  if (isTupTy(ty)) tupField(recv, name, ty, off) else recField(recv, name, off, recNames(copyEns(ens), ty), ty, ens)

def isTupTy(ty: String): Bool =
  Str.len(ty) > 0 && Str.charAt(ty, 0) == 40

def tupField(recv: Expr, name: String, ty: String, off: Int): Expr =
  tupField2(recv, tupIdx(name), splitPat(Str.slice(ty, 1, Str.len(ty) - 1)), off)

def tupField2(recv: Expr, idx: Int, ns: List[String], off: Int): Expr =
  if (List.isEmpty(ns)) Expr.EMatch(recv, Arm(if (idx == 0) "(__f0, _)" else "(_, __f1)", "", Expr.EVar(if (idx == 0) "__f0" else "__f1", 0)) :: noArm(), off) else Expr.EMatch(recv, Arm(Str.concat("(", Str.concat(bindsSelect(0, List.len(ns), idx), ")")), "", Expr.EVar(fakeBind(idx), 0)) :: noArm(), off)

def recField(recv: Expr, name: String, off: Int, ns: List[String], ty: String, ens: List[En]): Expr =
  if (List.isEmpty(ns)) Expr.EField(recv, name, off) else recFieldGo(recv, name, off, ns, ty, ens)

def recFieldGo(recv: Expr, name: String, off: Int, ns: List[String], ty: String, ens: List[En]): Expr =
  recFieldPair(recv, name, off, ty, ens, idxLen(ns, name, 0))

def idxLen(ns: List[String], name: String, i: Int): (Int, Int) =
  idxLenN(ns, name, i, List.len(ns))

def idxLenN(ns: List[String], name: String, i: Int, n: Int): (Int, Int) =
  if (i >= n) (0 - 1, n) else idxLenHit(List.at(ns, i), ns, name, i, n)

def idxLenHit(h: String, ns: List[String], name: String, i: Int, n: Int): (Int, Int) =
  if (h == name) (i, n) else idxLenN(ns, name, i + 1, n)

def recFieldPair(recv: Expr, name: String, off: Int, ty: String, ens: List[En], p: (Int, Int)): Expr =
  p match {
    case (idx, n) => recField2(recv, name, off, idx, n, ty, recTys(ens, ty))
  }

def recField2(recv: Expr, name: String, off: Int, idx: Int, n: Int, ty: String, tys: List[String]): Expr =
  if (idx < 0) Expr.EField(recv, name, off) else Expr.EMatch(recv, Arm(Str.concat(ty, Str.concat("(", Str.concat(bindsTyped(0, n, tys), ")"))), "", Expr.EVar(pickBind(idx, tys), 0)) :: noArm(), off)

def bindsTyped(i: Int, n: Int, tys: List[String]): String =
  if (i >= n) "" else if (i + 1 == n) pickBind(i, tys) else Str.concat(pickBind(i, tys), Str.concat(", ", bindsTyped(i + 1, n, tys)))

def pickBind(idx: Int, tys: List[String]): String =
  if (slotInt(tys, idx)) intBind(idx) else fakeBind(idx)

def intBind(i: Int): String =
  Str.concat(fakeBind(i), "_b0")

def recNames(ens: List[En], ty: String): List[String] =
  recNamesAt(ens, ty)

def recNamesAt(ens: List[En], ty: String): List[String] =
  if (List.isEmpty(ens)) noStr() else recNamesHit(List.at(ens, 0), List.tail(ens), ty)

def recNamesHit(h: En, rest: List[En], ty: String): List[String] =
  h match {
    case En(_, n, _, cases) => if (n == ty || n == tyHead(ty)) recNames2(cases) else recNamesAt(rest, ty)
  }

def recNames2(cs: List[EnCase]): List[String] =
  if (List.isEmpty(cs)) noStr() else recNames3(List.at(cs, 0))

def recNames3(c: EnCase): List[String] =
  c match {
    case EnCase(_, fs) => paramNames(fs)
  }

def recHead(en: String, name: String, ens: List[En], ps: List[Param]): String =
  recHeadHit(tyHead(paramTy(ps, en)), name, ens)

def recHeadHit(ty: String, name: String, ens: List[En]): String =
  if (!List.isEmpty(recNames(ens, ty))) ty else recHeadField(ens, name)

def recHeadField(ens: List[En], name: String): String =
  if (List.isEmpty(ens)) "" else recHeadFieldHit(List.at(ens, 0), List.tail(ens), name)

def recHeadFieldHit(h: En, rest: List[En], name: String): String =
  h match {
    case En(_, n, _, cases) => if (hasFieldName(cases, name)) n else recHeadField(rest, name)
  }

def hasFieldName(cs: List[EnCase], name: String): Bool =
  if (List.isEmpty(cs)) false else hasFieldName1(List.at(cs, 0), List.tail(cs), name)

def hasFieldName1(c: EnCase, rest: List[EnCase], name: String): Bool =
  c match {
    case EnCase(_, fs) => hasParamName(fs, name) || hasFieldName(rest, name)
  }

def hasParamName(fs: List[Param], name: String): Bool =
  if (List.isEmpty(fs)) false else hasParamName1(List.at(fs, 0), List.tail(fs), name)

def hasParamName1(p: Param, rest: List[Param], name: String): Bool =
  p match {
    case Param(n, _, _, _) => n == name || hasParamName(rest, name)
  }

def recTys(ens: List[En], ty: String): List[String] =
  recTysAt(ens, ty)

def recTysAt(ens: List[En], ty: String): List[String] =
  if (List.isEmpty(ens)) noStr() else recTysHit(List.at(ens, 0), List.tail(ens), ty)

def recTysHit(h: En, rest: List[En], ty: String): List[String] =
  h match {
    case En(_, n, _, cases) => if (n == ty || n == tyHead(ty)) recTys2(cases) else recTysAt(rest, ty)
  }

def recTys2(cs: List[EnCase]): List[String] =
  if (List.isEmpty(cs)) noStr() else recTys3(List.at(cs, 0))

def recTys3(c: EnCase): List[String] =
  c match {
    case EnCase(_, fs) => paramTys(fs)
  }

def paramTys(fs: List[Param]): List[String] =
  if (List.isEmpty(fs)) noStr() else paramTys1(List.at(fs, 0), List.tail(fs))

def paramTys1(p: Param, rest: List[Param]): List[String] =
  p match {
    case Param(_, ty, _, _) => ty :: paramTys(rest)
  }

def paramNames(fs: List[Param]): List[String] =
  if (List.isEmpty(fs)) noStr() else paramNames1(List.at(fs, 0), List.tail(fs))

def paramNames1(p: Param, rest: List[Param]): List[String] =
  p match {
    case Param(n, _, _, _) => n :: paramNames(rest)
  }

def fakeBind(i: Int): String =
  Str.concat("__f", Str.fromInt(i))

def bindsSelect(i: Int, n: Int, idx: Int): String =
  if (i >= n) "" else if (i + 1 == n) bindOrWild(i, idx) else Str.concat(bindOrWild(i, idx), Str.concat(", ", bindsSelect(i + 1, n, idx)))

def bindOrWild(i: Int, idx: Int): String =
  if (i == idx) fakeBind(i) else "_"

def emitMain(body: Expr, strs: Strs, defs: Ftab, ens: List[En], files: List[(String, String)], lidx: Map[String, LineIndex]): String =
  stampNeth(emitMain2(emitExpr(rwFields(body, noEnv(), defs, ens, "Main"), "build", strs, defs, ens, noParam(), panicLocExprAt(files, lidx, body)), defs, strs, ens, panicLocExprAt(files, lidx, body)), "Main")

def emitMain2(s: Slot, defs: Ftab, strs: Strs, ens: List[En], loc: String): String =
  emitMain3(s.code, s.val, drvFuns(defs.list), relFuns(defs.list), sessFuns(defs.list), strs, ens, loc, defs)

def emitMain3(code: String, val: String, ds: List[Fun], rs: List[Fun], ss: List[Fun], strs: Strs, ens: List[En], loc: String, defs: Ftab): String =
  Str.concat(emitDrvTramps(ds, 0, ens, strs), emitMain4(code, val, Str.concat(emitSetupReg(defs), Str.concat(emitDrvRegs(ds, strs, 0), Str.concat(emitRelRegs(rs, strs, 0), emitSessRegs(ss, strs, 0)))), loc, strs))

def emitMain4(code: String, val: String, regs: String, loc: String, strs: Strs): String =
  Str.concat("define i32 @main(i32 %argc, ptr %argv) {", Str.concat(nl(), Str.concat(".entry:", Str.concat(nl(), Str.concat(panicPush(loc, strs), Str.concat(regs, Str.concat(code, Str.concat("  %rc = call i32 @sz_runtime_main_args(ptr ", Str.concat(val, Str.concat(", i32 %argc, ptr %argv)", Str.concat(nl(), Str.concat(panicPop(), Str.concat("  ret i32 %rc", Str.concat(nl(), "}"))))))))))))))

def drvFuns(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else drvFuns1(List.at(ds, 0), List.tail(ds))

def drvFuns1(d: Fun, rest: List[Fun]): List[Fun] =
  if (isDrv(d)) d :: drvFuns(rest) else drvFuns(rest)

def isDrv(d: Fun): Bool =
  d.mod == "__verify" && isIoTy(d.ret) && !d.priv && d.name != "setup" && !Str.startsWith(d.name, "_scn_")

def emitSetupReg(defs: Ftab): String =
  if (hasSetupFun(defs.list)) """  call void @sz_scenario_register_setup(ptr @sz_user___verify_setup)
""" else ""

def hasSetupFun(ds: List[Fun]): Bool =
  if (List.isEmpty(ds)) false else if (List.at(ds, 0).name == "setup" && List.at(ds, 0).mod == "__verify") true else hasSetupFun(List.tail(ds))

def isRelFun(d: Fun): Bool =
  d.ret == "Verdict" && List.len(d.params) == 2 && isTlPs(d.params)

def isSessFun(d: Fun): Bool =
  d.ret == "Verdict" && List.len(d.params) == 1 && isTlPs(d.params)

def isTlPs(ps: List[Param]): Bool =
  if (List.isEmpty(ps)) true else isTlPsGo(List.at(ps, 0), List.tail(ps))

def isTlPsGo(h: Param, rest: List[Param]): Bool =
  h match {
    case Param(_, ty, _, _) => ty == "Timeline" && isTlPs(rest)
  }

def relFuns(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else relFuns1(List.at(ds, 0), List.tail(ds))

def relFuns1(d: Fun, rest: List[Fun]): List[Fun] =
  if (isRelFun(d)) d :: relFuns(rest) else relFuns(rest)

def sessFuns(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) noFun() else sessFuns1(List.at(ds, 0), List.tail(ds))

def sessFuns1(d: Fun, rest: List[Fun]): List[Fun] =
  if (isSessFun(d)) d :: sessFuns(rest) else sessFuns(rest)

def internRel(p: Prog, acc: Strs): Strs =
  p match {
    case Prog(_, enums, _, _, _, _, defs, _, _) => internRelDefs(defs, internEns(enums, internRelStr(defs, acc)))
  }

def internRelStr(defs: List[Fun], acc: Strs): Strs =
  if (needsDecodeStr(defs)) intern(acc, "drive decode failed") else acc

def needsDecodeStr(defs: List[Fun]): Bool =
  !List.isEmpty(relFuns(defs)) || !List.isEmpty(sessFuns(defs)) || !List.isEmpty(drvFuns(defs))

def internEns(ens: List[En], acc: Strs): Strs =
  if (List.isEmpty(ens)) acc else internEn(List.at(ens, 0), internEns(List.tail(ens), acc))

def internEn(e: En, acc: Strs): Strs =
  e match {
    case En(_, name, _, cases) => internCases(cases, intern(acc, name))
  }

def internCases(cs: List[EnCase], acc: Strs): Strs =
  if (List.isEmpty(cs)) acc else internCases(List.tail(cs), internCase(List.at(cs, 0), acc))

def internCase(c: EnCase, acc: Strs): Strs =
  intern(acc, c.name)

def internRelDefs(ds: List[Fun], acc: Strs): Strs =
  if (List.isEmpty(ds)) acc else internRelDefs(List.tail(ds), internRelDef(List.at(ds, 0), acc))

def internRelDef(d: Fun, acc: Strs): Strs =
  if (isRelFun(d) || isSessFun(d)) intern(acc, d.name) else if (isDrv(d)) intern(acc, drvRegName(d.name)) else acc

def internSigProg(p: Prog, files: List[(String, String)], lidx: Map[String, LineIndex], acc: Strs): Strs =
  p match {
    case Prog(_, _, _, _, impls, _, defs, _, body) => internSigDefs(defs, files, lidx, internSigImpls(impls, files, lidx, internBranch(body, panicLocExprAt(files, lidx, body), intern(internSigExpr(body, acc), panicLocExprAt(files, lidx, body)))))
  }

def internSigImpls(xs: List[Im], files: List[(String, String)], lidx: Map[String, LineIndex], acc: Strs): Strs =
  if (List.isEmpty(xs)) acc else internSigImpls(List.tail(xs), files, lidx, internSigImpl(List.at(xs, 0), files, lidx, acc))

def internSigImpl(x: Im, files: List[(String, String)], lidx: Map[String, LineIndex], acc: Strs): Strs =
  x match {
    case Im(_, _, forTy, methods) => internSigDefs(stampMod(methods, forTy, noFun()), files, lidx, acc)
  }

def internSigDefs(ds: List[Fun], files: List[(String, String)], lidx: Map[String, LineIndex], acc: Strs): Strs =
  if (List.isEmpty(ds)) acc else internSigDefs(List.tail(ds), files, lidx, internSigDef(List.at(ds, 0), files, lidx, acc))

def internSigDef(d: Fun, files: List[(String, String)], lidx: Map[String, LineIndex], acc: Strs): Strs =
  d match {
    case Fun(_, _, _, _, _, _, body, mod, off) => internBranch(body, panicLocAt(files, lidx, mod, off), internSigExpr(body, intern(acc, panicLocAt(files, lidx, mod, off))))
  }

def internBranch(e: Expr, loc: String, acc: Strs): Strs =
  e match {
    case Expr.EIf(c, t, el, ioff) => internBranch(c, loc, internBranch(t, loc, internBranch(el, loc, internIfArm(el, ioff, "e", loc, internIfArm(t, ioff, "t", loc, acc)))))
    case Expr.EMatch(s, arms, moff) => internBranchArms(arms, moff, loc, internBranch(s, loc, acc), 0)
    case Expr.ECall(_, args, _) => internBranchList(args, loc, acc)
    case Expr.EMethod(recv, _, args, _) => internBranchList(args, loc, internBranch(recv, loc, acc))
    case Expr.EField(recv, _, _) => internBranch(recv, loc, acc)
    case Expr.EBin(_, l, r, _) => internBranch(r, loc, internBranch(l, loc, acc))
    case Expr.EUn(_, inner, _) => internBranch(inner, loc, acc)
    case Expr.ELam(_, _, body) => internBranch(body, loc, acc)
    case Expr.EPrint(inner, _) => internBranch(inner, loc, acc)
    case Expr.EFor(bs, body, _) => internBranch(body, loc, internBranchBinds(bs, loc, acc))
    case Expr.EList(xs) => internBranchList(xs, loc, acc)
    case Expr.ETuple(xs) => internBranchList(xs, loc, acc)
    case Expr.ENamed(_, inner) => internBranch(inner, loc, acc)
    case Expr.EAscribe(inner, _, _) => internBranch(inner, loc, acc)
    case _ => acc
  }

def internIfArm(e: Expr, parentOff: Int, tag: String, loc: String, acc: Strs): Strs =
  e match {
    case Expr.EUnit => acc
    case _ => intern(acc, Check.covKeyOf(loc, Parse.spanOff(e, parentOff), tag))
  }

def internBranchArms(arms: List[Arm], moff: Int, loc: String, acc: Strs, i: Int): Strs =
  if (List.isEmpty(arms)) acc else internBranchArms(List.tail(arms), moff, loc, internBranchArm(List.at(arms, 0), moff, loc, acc, i), i + 1)

def internBranchArm(a: Arm, moff: Int, loc: String, acc: Strs, i: Int): Strs =
  a match {
    case Arm(_, _, body) => internBranch(body, loc, intern(acc, Check.covKeyOf(loc, Parse.spanOff(body, moff), Str.fromInt(i))))
  }

def internBranchList(xs: List[Expr], loc: String, acc: Strs): Strs =
  if (List.isEmpty(xs)) acc else internBranchList(List.tail(xs), loc, internBranch(List.at(xs, 0), loc, acc))

def internBranchBinds(bs: List[Bind], loc: String, acc: Strs): Strs =
  if (List.isEmpty(bs)) acc else internBranchBinds(List.tail(bs), loc, internBranchBind(List.at(bs, 0), loc, acc))

def internBranchBind(b: Bind, loc: String, acc: Strs): Strs =
  b match {
    case Bind(draw, name, value) => internBranch(value, loc, internForMiss(draw, name, acc))
  }

def internForMiss(draw: Bool, name: String, acc: Strs): Strs =
  if (draw || eqIsLet(name)) acc else intern(acc, "for binding does not match")

def internSigBinds(bs: List[Bind], acc: Strs): Strs =
  if (List.isEmpty(bs)) acc else internSigBinds(List.tail(bs), internSigBind(List.at(bs, 0), acc))

def internSigBind(b: Bind, acc: Strs): Strs =
  b match {
    case Bind(draw, name, v) => internSigExpr(v, internSigName(draw, name, v, acc))
  }

def internSigName(draw: Bool, name: String, v: Expr, acc: Strs): Strs =
  if (draw || name == "_" || !isSimpleBind(name)) acc else internSigNameGo(name, v, acc)

def internSigNameGo(name: String, v: Expr, acc: Strs): Strs =
  v match {
    case Expr.ECall(f, _, _) => if (sigCtorKit(f)) intern(acc, name) else acc
    case _ => acc
  }

def internSigExpr(e: Expr, acc: Strs): Strs =
  e match {
    case Expr.EFor(bs, body, _) => internSigExpr(body, internSigBinds(bs, acc))
    case Expr.ECall(_, args, _) => internSigList(args, acc)
    case Expr.EMethod(recv, _, args, _) => internSigList(args, internSigExpr(recv, acc))
    case Expr.EField(recv, _, _) => internSigExpr(recv, acc)
    case Expr.EPrint(inner, _) => internSigExpr(inner, acc)
    case Expr.EBin(_, l, r, _) => internSigExpr(r, internSigExpr(l, acc))
    case Expr.EUn(_, inner, _) => internSigExpr(inner, acc)
    case Expr.ELam(_, _, body) => internSigExpr(body, acc)
    case Expr.EIf(c, t, el, _) => internSigExpr(el, internSigExpr(t, internSigExpr(c, acc)))
    case Expr.EMatch(s, arms, _) => internSigArms(arms, internSigExpr(s, acc))
    case Expr.EList(xs) => internSigList(xs, acc)
    case Expr.ETuple(xs) => internSigList(xs, acc)
    case Expr.ENamed(_, inner) => internSigExpr(inner, acc)
    case Expr.EAscribe(inner, _, _) => internSigExpr(inner, acc)
    case _ => acc
  }

def internSigList(xs: List[Expr], acc: Strs): Strs =
  if (List.isEmpty(xs)) acc else internSigList(List.tail(xs), internSigExpr(List.at(xs, 0), acc))

def internSigArms(xs: List[Arm], acc: Strs): Strs =
  if (List.isEmpty(xs)) acc else internSigArms(List.tail(xs), internSigArm(List.at(xs, 0), acc))

def internSigArm(a: Arm, acc: Strs): Strs =
  a match {
    case Arm(_, _, body) => internSigExpr(body, acc)
  }

def emitRelRegs(ds: List[Fun], strs: Strs, i: Int): String =
  if (List.isEmpty(ds)) "" else Str.concat(emitRelReg(List.at(ds, 0), strs, i), emitRelRegs(List.tail(ds), strs, i + 1))

def emitRelReg(d: Fun, strs: Strs, i: Int): String =
  d match {
    case Fun(_, _, name, _, _, _, _, mod, _) => emitRelReg2(name, mod, strs, i)
  }

def emitRelReg2(name: String, mod: String, strs: Strs, i: Int): String =
  join(relGep(name, strs, i), relCall(name, mod, i))

def relGep(name: String, strs: Strs, i: Int): String =
  line(Str.concat("%vrl", Str.concat(Str.fromInt(i), Str.concat("_gep = getelementptr inbounds [", Str.concat(Str.fromInt(strArr(name)), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(strIndex(strs, name, 0)), ", i64 0, i64 0")))))))

def relCall(name: String, mod: String, i: Int): String =
  line(Str.concat("call void @sz_verify_register_rel(ptr %vrl", Str.concat(Str.fromInt(i), Str.concat("_gep, ptr @sz_user_", Str.concat(symOf(mod, name), ")")))))

def emitSessRegs(ds: List[Fun], strs: Strs, i: Int): String =
  if (List.isEmpty(ds)) "" else Str.concat(emitSessReg(List.at(ds, 0), strs, i), emitSessRegs(List.tail(ds), strs, i + 1))

def emitSessReg(d: Fun, strs: Strs, i: Int): String =
  d match {
    case Fun(_, _, name, _, _, _, _, mod, _) => emitSessReg2(name, mod, strs, i)
  }

def emitSessReg2(name: String, mod: String, strs: Strs, i: Int): String =
  join(sessGep(name, strs, i), sessCall(name, mod, i))

def sessGep(name: String, strs: Strs, i: Int): String =
  line(Str.concat("%ver", Str.concat(Str.fromInt(i), Str.concat("_gep = getelementptr inbounds [", Str.concat(Str.fromInt(strArr(name)), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(strIndex(strs, name, 0)), ", i64 0, i64 0")))))))

def sessCall(name: String, mod: String, i: Int): String =
  line(Str.concat("call void @sz_verify_register(ptr %ver", Str.concat(Str.fromInt(i), Str.concat("_gep, ptr @sz_user_", Str.concat(symOf(mod, name), ")")))))

def emitDrvRegs(ds: List[Fun], strs: Strs, i: Int): String =
  if (List.isEmpty(ds)) "" else Str.concat(emitDrvReg(List.at(ds, 0), strs, i), emitDrvRegs(List.tail(ds), strs, i + 1))

def emitDrvReg(d: Fun, strs: Strs, i: Int): String =
  d match {
    case Fun(_, _, name, _, ps, _, _, mod, _) => emitDrvReg2(drvRegName(name), name, ps, mod, strs, i)
  }

def drvRegName(name: String): String =
  if (Str.startsWith(name, "_drv_")) Str.slice(name, 5, Str.len(name)) else name

def emitDrvReg2(reg: String, name: String, ps: List[Param], mod: String, strs: Strs, i: Int): String =
  join(drvGep(reg, strs, i), join(drvSs(i), drvCall(name, ps, mod, i)))

def emitDrvTramps(ds: List[Fun], i: Int, ens: List[En], strs: Strs): String =
  if (List.isEmpty(ds)) "" else Str.concat(emitDrvTramp(List.at(ds, 0), i, ens, strs), emitDrvTramps(List.tail(ds), i + 1, ens, strs))

def emitDrvTramp(d: Fun, i: Int, ens: List[En], strs: Strs): String =
  d match {
    case Fun(_, _, name, _, ps, _, _, mod, _) => emitDrvTramp2(name, ps, mod, i, ens, strs)
  }

def emitDrvTramp2(name: String, ps: List[Param], mod: String, i: Int, ens: List[En], strs: Strs): String =
  if (needsDecode(ps)) decodeTramp(name, ps, mod, i, ens, strs) else if (List.len(ps) <= 1) "" else trampFn(name, ps, mod, i)

def needsDecode(ps: List[Param]): Bool =
  !List.isEmpty(ps) && (needsDecodeP(List.at(ps, 0)) || needsDecode(List.tail(ps)))

def needsDecodeP(p: Param): Bool =
  p.ty != "Int" && p.ty != "String" && p.ty != "Bool"

def drvSym(name: String, ps: List[Param], mod: String, i: Int): String =
  if (needsDecode(ps) || List.len(ps) > 1) Str.concat("@sz_drv_tramp_", Str.fromInt(i)) else Str.concat("@sz_user_", symOf(mod, name))

def decodeTramp(name: String, ps: List[Param], mod: String, i: Int, ens: List[En], strs: Strs): String =
  if (List.len(ps) != 1) trampFn(name, ps, mod, i) else decodeTramp1(name, List.at(ps, 0), mod, i, ens, strs)

def trampPre(i: Int): String =
  Str.concat("t", Str.concat(Str.fromInt(i), "_"))

def decodeTramp1(name: String, p: Param, mod: String, i: Int, ens: List[En], strs: Strs): String =
  decodeTrampGot(name, mod, i, decodeTok(pct(trampPre(i), "cs"), p.ty, ens, strs, trampPre(i), 0, 0))

def decodeTrampGot(name: String, mod: String, i: Int, d: Dec): String =
  d match {
    case Dec(code, val, num, owned, _) => decodeTrampEnd(name, mod, i, code, val, num, owned)
  }

def decodeTrampEnd(name: String, mod: String, i: Int, code: String, val: String, num: Bool, owned: Bool): String =
  Str.concat(decodeHeader(i), Str.concat(line(Str.concat(tmp(trampPre(i), "cs"), "call ptr @sz_string_cstr(ptr %a)")), Str.concat(code, Str.concat(decodeCall(name, mod, val, num), Str.concat(if (owned) relPtr(val) else "", Str.concat(line("ret ptr %dio"), Str.concat(Str.concat("}", nl()), nl())))))))

def decodeHeader(i: Int): String =
  Str.concat("define internal ptr @sz_drv_tramp_", Str.concat(Str.fromInt(i), Str.concat("(ptr %a) {", Str.concat(nl(), Str.concat(".entry:", nl())))))

def decodeCall(name: String, mod: String, val: String, num: Bool): String =
  line(Str.concat("%dio = call ptr @sz_user_", Str.concat(symOf(mod, name), Str.concat("(", Str.concat(if (num) "i64 " else "ptr ", Str.concat(val, ")"))))))

def decId(prefix: String, stem: String, n: Int): String =
  Str.concat(prefix, Str.concat(stem, Str.fromInt(n)))

def decPct(prefix: String, stem: String, n: Int): String =
  Str.concat("%", decId(prefix, stem, n))

def decLab(prefix: String, n: Int): String =
  Str.concat(prefix, Str.fromInt(n))

def decodeTok(tok: String, ty: String, ens: List[En], strs: Strs, prefix: String, n: Int, depth: Int): Dec =
  if (ty == "Int") decParse("sz_drive_parse_int", tok, prefix, n) else if (ty == "Bool") decParse("sz_drive_parse_bool", tok, prefix, n) else if (ty == "String") decFromCstr(tok, prefix, n) else decodeAdt(tok, ty, ens, strs, prefix, n, depth)

def decParse(rt: String, tok: String, prefix: String, n: Int): Dec =
  Dec(decParseCode(rt, tok, prefix, n), decPct(prefix, "p", n), true, false, n + 1)

def decParseCode(rt: String, tok: String, prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "p", n), Str.concat(" = call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(tok, ")"))))))

def decFromCstr(tok: String, prefix: String, n: Int): Dec =
  Dec(decFromCstrCode(tok, prefix, n), decPct(prefix, "s", n), false, true, n + 1)

def decFromCstrCode(tok: String, prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "s", n), Str.concat(" = call ptr @sz_string_from_cstr(ptr ", Str.concat(tok, ")"))))

def decodeAdt(tok: String, ty: String, ens: List[En], strs: Strs, prefix: String, n: Int, depth: Int): Dec =
  decodeAdtHit(tok, findEnNm(ens, tyHead(ty)), ens, strs, prefix, n, depth)

def findEnNm(ens: List[En], name: String): List[En] =
  if (List.isEmpty(ens)) noEn() else findEnNm1(List.at(ens, 0), List.tail(ens), name)

def findEnNm1(h: En, rest: List[En], name: String): List[En] =
  h match {
    case En(_, n, _, _) => if (n == name) h :: noEn() else findEnNm(rest, name)
  }

def decodeAdtHit(tok: String, hit: List[En], ens: List[En], strs: Strs, prefix: String, n: Int, depth: Int): Dec =
  if (List.isEmpty(hit)) decParse("sz_drive_parse_int", tok, prefix, n) else decodeAdtEn(tok, List.at(hit, 0), ens, strs, prefix, n, depth)

def decodeAdtEn(tok: String, e: En, ens: List[En], strs: Strs, prefix: String, n: Int, depth: Int): Dec =
  e match {
    case En(isRec, name, _, cases) => decodeAdtBody(tok, pickCases(isRec, name, cases, depth), ens, strs, prefix, n, depth)
  }

def pickCases(isRec: Bool, name: String, cases: List[EnCase], depth: Int): List[EnCase] =
  if (depth >= 3) leafDrvCases(cases) else cases

def leafDrvCases(cs: List[EnCase]): List[EnCase] =
  if (List.isEmpty(cs)) cs else leafDrv1(List.at(cs, 0), List.tail(cs))

def leafDrv1(c: EnCase, rest: List[EnCase]): List[EnCase] =
  if (drvLeaf(c)) c :: leafDrvCases(rest) else leafDrvCases(rest)

def drvLeaf(c: EnCase): Bool =
  c match {
    case EnCase(_, fs) => drvAllLeaf(fs)
  }

def drvAllLeaf(fs: List[Param]): Bool =
  if (List.isEmpty(fs)) true else drvAllLeafGo(List.at(fs, 0), List.tail(fs))

def drvAllLeafGo(h: Param, rest: List[Param]): Bool =
  h match {
    case Param(_, ty, _, _) => drvLeafTy(ty) && drvAllLeaf(rest)
  }

def drvLeafTy(t: String): Bool =
  t == "Int" || t == "String" || t == "Bool"

def decodeAdtBody(tok: String, cases: List[EnCase], ens: List[En], strs: Strs, prefix: String, n: Int, depth: Int): Dec =
  decodeAdtBody2(tok, cases, ens, strs, prefix, n, n + 1, n + 2, List.len(cases), depth)

def decodeAdtBody2(tok: String, cases: List[EnCase], ens: List[En], strs: Strs, prefix: String, inner: Int, fail: Int, joinL: Int, k: Int, depth: Int): Dec =
  decodeTries(tok, cases, 0, k, inner + 3, fail, joinL, prefix, inner + 3 + k + k, "", ens, strs, depth, inner, decAlloca(prefix, inner), if (k == 0) fail else inner + 3)

def decAlloca(prefix: String, inner: Int): String =
  line(Str.concat(decPct(prefix, "b", inner), " = alloca [192 x i8], align 1"))

def decodeTries(tok: String, cases: List[EnCase], i: Int, k: Int, base: Int, fail: Int, joinL: Int, prefix: String, n: Int, phi: String, ens: List[En], strs: Strs, depth: Int, inner: Int, code: String, first: Int): Dec =
  if (i >= k) decodeFailJoin(prefix, fail, joinL, phi, code, first, k, strs, n) else decodeTry(tok, cases, List.at(cases, i), i, k, base, fail, joinL, prefix, n, phi, ens, strs, depth, inner, code, first)

def decodeTry(tok: String, cases: List[EnCase], c: EnCase, i: Int, k: Int, base: Int, fail: Int, joinL: Int, prefix: String, n: Int, phi: String, ens: List[En], strs: Strs, depth: Int, inner: Int, code: String, first: Int): Dec =
  c match {
    case EnCase(cname, fs) => decodeTry2(tok, cases, cname, fs, i, k, base, fail, joinL, prefix, n, phi, ens, strs, depth, inner, code, first)
  }

def decodeTry2(tok: String, cases: List[EnCase], cname: String, fs: List[Param], i: Int, k: Int, base: Int, fail: Int, joinL: Int, prefix: String, n: Int, phi: String, ens: List[En], strs: Strs, depth: Int, inner: Int, code: String, first: Int): Dec =
  decodeTry3(internGep(cname, strs, prefix, n), tok, cases, fs, i, k, base, fail, joinL, prefix, n + 1, phi, ens, strs, depth, inner, code, first)

def internGep(s: String, strs: Strs, prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "g", n), internGepRhs(s, strs)))

def internGepRhs(s: String, strs: Strs): String =
  Str.concat(" = getelementptr inbounds [", Str.concat(Str.fromInt(strArr(s)), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(strIndex(strs, s, 0)), ", i64 0, i64 0"))))

def decodeTry3(gep: String, tok: String, cases: List[EnCase], fs: List[Param], i: Int, k: Int, base: Int, fail: Int, joinL: Int, prefix: String, n: Int, phi: String, ens: List[En], strs: Strs, depth: Int, inner: Int, code: String, first: Int): Dec =
  decodeConstruct(decodeFields(fs, 0, decPct(prefix, "b", inner), ens, strs, prefix, n + 2, depth + 1), tok, cases, i, k, base, fail, joinL, prefix, phi, ens, strs, depth, inner, tryHead(code, gep, tok, i, k, base, fail, prefix, n, inner, first))

def tryHead(code: String, gep: String, tok: String, i: Int, k: Int, base: Int, fail: Int, prefix: String, n: Int, inner: Int, first: Int): String =
  join(code, join(if (i == 0) decBr(prefix, first) else "", join(lab(decLab(prefix, base + i)), join(gep, join(unconsLine(tok, prefix, n, inner), join(unconsIcmp(prefix, n), unconsBr(prefix, n, base, k, i, fail)))))))

def unconsLine(tok: String, prefix: String, n: Int, inner: Int): String =
  line(Str.concat(decPct(prefix, "is", n), Str.concat(" = call i32 @sz_drive_uncons(ptr ", Str.concat(tok, Str.concat(", ptr ", Str.concat(decPct(prefix, "g", n - 1), Str.concat(", ptr ", Str.concat(decPct(prefix, "b", inner), ", i32 192)"))))))))

def unconsIcmp(prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "h", n), Str.concat(" = icmp ne i32 ", Str.concat(decPct(prefix, "is", n), ", 0"))))

def unconsBr(prefix: String, n: Int, base: Int, k: Int, i: Int, fail: Int): String =
  line(Str.concat("br i1 ", Str.concat(decPct(prefix, "h", n), Str.concat(", label %", Str.concat(decLab(prefix, base + k + i), Str.concat(", label %", Str.concat(decLab(prefix, if (i + 1 < k) base + i + 1 else fail), "")))))))

def decBr(prefix: String, dest: Int): String =
  line(Str.concat("br label %", decLab(prefix, dest)))

def decodeConstruct(fields: Decs, tok: String, cases: List[EnCase], i: Int, k: Int, base: Int, fail: Int, joinL: Int, prefix: String, phi: String, ens: List[En], strs: Strs, depth: Int, inner: Int, head: String): Dec =
  fields match {
    case Decs(fc, ds, n2) => decodeConstruct2(buildAdt(i, ds, prefix, n2), tok, cases, i, k, base, fail, joinL, prefix, phi, ens, strs, depth, inner, join(head, join(lab(decLab(prefix, base + k + i)), fc)))
  }

def decodeConstruct2(built: Dec, tok: String, cases: List[EnCase], i: Int, k: Int, base: Int, fail: Int, joinL: Int, prefix: String, phi: String, ens: List[En], strs: Strs, depth: Int, inner: Int, head: String): Dec =
  built match {
    case Dec(bc, bv, _, _, n3) => decodeTries(tok, cases, i + 1, k, base, fail, joinL, prefix, n3 + 1, phiAdd(phi, bv, prefix, n3), ens, strs, depth, inner, join(head, join(bc, join(decBr(prefix, n3), join(lab(decLab(prefix, n3)), decBr(prefix, joinL))))), base)
  }

def noDec(): List[Dec] =
  []

def decodeFields(fs: List[Param], i: Int, inner: String, ens: List[En], strs: Strs, prefix: String, n: Int, depth: Int): Decs =
  if (List.isEmpty(fs)) Decs("", noDec(), n) else decodeFields1(List.at(fs, 0), List.tail(fs), i, inner, ens, strs, prefix, n, depth)

def decodeFields1(p: Param, rest: List[Param], i: Int, inner: String, ens: List[En], strs: Strs, prefix: String, n: Int, depth: Int): Decs =
  decodeFields2(decodeTok(decPct(prefix, "f", n), p.ty, ens, strs, prefix, n + 1, depth), fieldPrep(inner, prefix, n, i), rest, i, inner, ens, strs, prefix, depth)

def fieldPrep(inner: String, prefix: String, n: Int, i: Int): String =
  join(line(Str.concat(decPct(prefix, "f", n), " = alloca [192 x i8], align 1")), fieldCall(inner, prefix, n, i))

def fieldCall(inner: String, prefix: String, n: Int, i: Int): String =
  line(Str.concat(decPct(prefix, "ok", n), Str.concat(" = call i32 @sz_drive_field(ptr ", Str.concat(inner, Str.concat(", i64 ", Str.concat(Str.fromInt(i), Str.concat(", ptr ", Str.concat(decPct(prefix, "f", n), ", i32 192)"))))))))

def decodeFields2(d: Dec, pre: String, rest: List[Param], i: Int, inner: String, ens: List[En], strs: Strs, prefix: String, depth: Int): Decs =
  d match {
    case Dec(dc, _, _, _, n2) => decodeFields3(pre, dc, d, decodeFields(rest, i + 1, inner, ens, strs, prefix, n2, depth))
  }

def decodeFields3(pre: String, dc: String, d: Dec, rest: Decs): Decs =
  rest match {
    case Decs(rc, ds, n3) => Decs(join(pre, join(dc, rc)), d :: ds, n3)
  }

def buildAdt(tag: Int, ds: List[Dec], prefix: String, n: Int): Dec =
  if (List.isEmpty(ds)) Dec(buildAdtNil(tag, prefix, n), decPct(prefix, "a", n), false, true, n + 1) else if (List.len(ds) == 1) buildAdt1(tag, List.at(ds, 0), prefix, n) else buildAdtN(tag, ds, prefix, n)

def buildAdtNil(tag: Int, prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "a", n), Str.concat(" = call ptr @sz_adt_new(i32 ", Str.concat(Str.fromInt(tag), ", ptr null)"))))

def buildAdt1(tag: Int, d: Dec, prefix: String, n: Int): Dec =
  d match {
    case Dec(_, v, num, owned, _) => if (num) buildAdtBox(tag, v, prefix, n) else buildAdtPtr(tag, v, owned, prefix, n)
  }

def buildAdtBox(tag: Int, v: String, prefix: String, n: Int): Dec =
  Dec(buildAdtBoxCode(tag, v, prefix, n), decPct(prefix, "a", n), false, true, n + 1)

def buildAdtBoxCode(tag: Int, v: String, prefix: String, n: Int): String =
  join(boxI64Line(v, prefix, n), join(adtNewPtr(tag, decPct(prefix, "x", n), prefix, n), relPtr(decPct(prefix, "x", n))))

def boxI64Line(v: String, prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "x", n), Str.concat(" = call ptr @sz_box_i64(i64 ", Str.concat(v, ")"))))

def adtNewPtr(tag: Int, payload: String, prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "a", n), Str.concat(" = call ptr @sz_adt_new(i32 ", Str.concat(Str.fromInt(tag), Str.concat(", ptr ", Str.concat(payload, ")"))))))

def buildAdtPtr(tag: Int, v: String, owned: Bool, prefix: String, n: Int): Dec =
  Dec(buildAdtPtrCode(tag, v, owned, prefix, n), decPct(prefix, "a", n), false, true, n + 1)

def buildAdtPtrCode(tag: Int, v: String, owned: Bool, prefix: String, n: Int): String =
  join(adtNewPtr(tag, v, prefix, n), if (owned) relPtr(v) else "")

def buildAdtN(tag: Int, ds: List[Dec], prefix: String, n: Int): Dec =
  buildAdtN2(tag, consFold(List.reverse(ds), decPct(prefix, "nl", n), prefix, n + 1, line(Str.concat(decPct(prefix, "nl", n), " = call ptr @sz_list_nil()"))), prefix)

def consFold(ds: List[Dec], cur: String, prefix: String, n: Int, code: String): Dec =
  if (List.isEmpty(ds)) Dec(code, cur, false, true, n) else consFold1(List.at(ds, 0), List.tail(ds), cur, prefix, n, code)

def consFold1(h: Dec, rest: List[Dec], cur: String, prefix: String, n: Int, code: String): Dec =
  h match {
    case Dec(_, v, num, owned, _) => if (num) consFoldBox(v, rest, cur, prefix, n, code) else consFoldPtr(v, owned, rest, cur, prefix, n, code)
  }

def consFoldBox(v: String, rest: List[Dec], cur: String, prefix: String, n: Int, code: String): Dec =
  consFold(rest, decPct(prefix, "c", n), prefix, n + 1, join(code, consBoxCode(v, cur, prefix, n)))

def consBoxCode(v: String, cur: String, prefix: String, n: Int): String =
  join(boxI64Line(v, prefix, n), join(consLine(decPct(prefix, "x", n), cur, prefix, n), join(relPtr(decPct(prefix, "x", n)), relPtr(cur))))

def consLine(hd: String, tl: String, prefix: String, n: Int): String =
  line(Str.concat(decPct(prefix, "c", n), Str.concat(" = call ptr @sz_list_cons(ptr ", Str.concat(hd, Str.concat(", ptr ", Str.concat(tl, ")"))))))

def consFoldPtr(v: String, owned: Bool, rest: List[Dec], cur: String, prefix: String, n: Int, code: String): Dec =
  consFold(rest, decPct(prefix, "c", n), prefix, n + 1, join(code, join(consLine(v, cur, prefix, n), join(if (owned) relPtr(v) else "", relPtr(cur)))))

def buildAdtN2(tag: Int, lst: Dec, prefix: String): Dec =
  lst match {
    case Dec(lc, lv, _, _, n) => Dec(buildAdtN2Code(tag, lc, lv, prefix, n), decPct(prefix, "a", n), false, true, n + 1)
  }

def buildAdtN2Code(tag: Int, lc: String, lv: String, prefix: String, n: Int): String =
  join(lc, join(adtNewPtr(tag, lv, prefix, n), relPtr(lv)))

def phiAdd(phi: String, v: String, prefix: String, lab: Int): String =
  if (phi == "") Str.concat("[ ", Str.concat(v, Str.concat(", %", Str.concat(decLab(prefix, lab), " ]")))) else Str.concat(phi, Str.concat(", [ ", Str.concat(v, Str.concat(", %", Str.concat(decLab(prefix, lab), " ]")))))

def decodeFailJoin(prefix: String, fail: Int, joinL: Int, phi: String, code: String, first: Int, k: Int, strs: Strs, n: Int): Dec =
  Dec(decodeFailCode(prefix, fail, joinL, phi, code, k, strs, n), decPct(prefix, "ap", joinL), false, true, n + 1)

def decodeFailCode(prefix: String, fail: Int, joinL: Int, phi: String, code: String, k: Int, strs: Strs, n: Int): String =
  join(code, join(if (k == 0) decBr(prefix, fail) else "", join(lab(decLab(prefix, fail)), join(internGep("drive decode failed", strs, prefix, n), join(decodePanic(prefix, n), join(lab(decLab(prefix, joinL)), decodePhi(prefix, joinL, phi)))))))

def decodePanic(prefix: String, fail: Int): String =
  join(fromCstrLine(prefix, fail), join(panicLine(prefix, fail), line("unreachable")))

def fromCstrLine(prefix: String, fail: Int): String =
  line(Str.concat(decPct(prefix, "ps", fail), Str.concat(" = call ptr @sz_string_lit(ptr ", Str.concat(decPct(prefix, "g", fail), ")"))))

def panicLine(prefix: String, fail: Int): String =
  line(Str.concat("call void @sz_panic(ptr ", Str.concat(decPct(prefix, "ps", fail), ")")))

def decodePhi(prefix: String, joinL: Int, phi: String): String =
  line(Str.concat(decPct(prefix, "ap", joinL), Str.concat(" = phi ptr ", if (phi == "") "[ null, %entry ]" else phi)))

def trampFn(name: String, ps: List[Param], mod: String, i: Int): String =
  Str.concat("define internal ptr @sz_drv_tramp_", Str.concat(Str.fromInt(i), Str.concat("(ptr %args) {", Str.concat(nl(), Str.concat(".entry:", Str.concat(nl(), Str.concat(trampLoads(ps, 0), Str.concat(trampRet(name, ps, mod), Str.concat("}", Str.concat(nl(), nl()))))))))))

def trampLoads(ps: List[Param], k: Int): String =
  if (List.isEmpty(ps)) "" else Str.concat(trampLoad(List.at(ps, 0), k), trampLoads(List.tail(ps), k + 1))

def trampLoad(p: Param, k: Int): String =
  join(line(Str.concat("%da", Str.concat(Str.fromInt(k), Str.concat(" = call ptr @sz_list_at(ptr %args, i64 ", Str.concat(Str.fromInt(k), ")"))))), trampUnbox(p, k))

def trampUnbox(p: Param, k: Int): String =
  if (isI64Ty(p.ty)) line(Str.concat("%dv", Str.concat(Str.fromInt(k), Str.concat(" = call i64 @sz_unbox_i64(ptr %da", Str.concat(Str.fromInt(k), ")"))))) else ""

def trampRet(name: String, ps: List[Param], mod: String): String =
  join(line(Str.concat("%dio = call ptr @sz_user_", Str.concat(symOf(mod, name), Str.concat("(", Str.concat(trampArgs(ps, 0), ")"))))), line("ret ptr %dio"))

def trampArgs(ps: List[Param], k: Int): String =
  if (List.isEmpty(ps)) "" else if (List.len(ps) == 1) trampArg(List.at(ps, 0), k) else Str.concat(trampArg(List.at(ps, 0), k), Str.concat(", ", trampArgs(List.tail(ps), k + 1)))

def trampArg(p: Param, k: Int): String =
  if (isI64Ty(p.ty)) Str.concat("i64 %dv", Str.fromInt(k)) else Str.concat("ptr %da", Str.fromInt(k))

def drvGep(name: String, strs: Strs, i: Int): String =
  line(Str.concat("%drv", Str.concat(Str.fromInt(i), Str.concat("_gep = getelementptr inbounds [", Str.concat(Str.fromInt(strArr(name)), Str.concat(" x i8], ptr @.str", Str.concat(Str.fromInt(strIndex(strs, name, 0)), ", i64 0, i64 0")))))))

def drvSs(i: Int): String =
  line(Str.concat("%drv", Str.concat(Str.fromInt(i), Str.concat("_ss = call ptr @sz_string_lit(ptr %drv", Str.concat(Str.fromInt(i), "_gep)")))))

def drvCall(name: String, ps: List[Param], mod: String, i: Int): String =
  line(Str.concat("call void @sz_driver_register(ptr %drv", Str.concat(Str.fromInt(i), Str.concat("_ss, i64 ", Str.concat(Str.fromInt(List.len(ps)), Str.concat(", i64 ", Str.concat(Str.fromInt(packKind(ps)), Str.concat(", ptr ", Str.concat(drvSym(name, ps, mod, i), ")")))))))))

def packKind(ps: List[Param]): Int =
  packKindAt(ps, 1, 0)

def packKindAt(ps: List[Param], place: Int, acc: Int): Int =
  if (List.isEmpty(ps)) acc else packKindAt(List.tail(ps), place * 4, acc + kindOf(List.at(ps, 0)) * place)

def kindOf(p: Param): Int =
  if (p.ty == "Bool") 2 else if (p.ty == "Int") 0 else 1

def emitProg(p: Prog, strs: Strs, files: List[(String, String)], lidx: Map[String, LineIndex]): String =
  emitBits(Check.expandExpr(p.body, p.aliases), Check.ftabOfList(prepDefs(p)), internReady(strs), Parse.builtins(p.enums), files, lidx)

def prepDefs(p: Prog): List[Fun] =
  withSelfFuns(rwAliasFuns(implFuns(p.impls, withImportFuns(p.imps, p.defs)), p.aliases))

def withSelfFuns(ds: List[Fun]): List[Fun] =
  if (List.isEmpty(ds)) ds else withSelfFun(List.at(ds, 0)) :: withSelfFuns(List.tail(ds))

def withSelfFun(d: Fun): Fun =
  d match {
    case Fun(priv, ora, name, ts, ps, ret, body, mod, off) => if (paramKnown(ps, "self") || !exprFreeVar(body, "self")) d else Fun(priv, ora, name, ts, Param("self", if (mod == "") "" else mod, "", "") :: ps, ret, body, mod, off)
  }

def implFuns(impls: List[Im], defs: List[Fun]): List[Fun] =
  if (List.isEmpty(impls)) defs else implFuns(List.tail(impls), implMeths(List.at(impls, 0), defs))

def implMeths(im: Im, defs: List[Fun]): List[Fun] =
  im match {
    case Im(_, _, forTy, methods) => stampMod(methods, forTy, defs)
  }

def stampMod(ms: List[Fun], mod: String, defs: List[Fun]): List[Fun] =
  if (List.isEmpty(ms)) defs else stampFun(List.at(ms, 0), mod) :: stampMod(List.tail(ms), mod, defs)

def stampFun(d: Fun, mod: String): Fun =
  d match {
    case Fun(priv, ora, name, ts, ps, ret, body, _, off) => Fun(priv, ora, name, ts, Param("self", mod, "", "") :: ps, ret, body, mod, off)
  }

def rwAliasFuns(ds: List[Fun], als: List[Alias]): List[Fun] =
  if (List.isEmpty(ds)) ds else rwAliasFun(List.at(ds, 0), als) :: rwAliasFuns(List.tail(ds), als)

def rwAliasFun(d: Fun, als: List[Alias]): Fun =
  d match {
    case Fun(priv, ora, name, ts, ps, ret, body, mod, off) => Fun(priv, ora, name, ts, rwAliasParams(ps, als), rwAliasTy(ret, als), Check.expandExpr(body, als), mod, off)
  }

def rwAliasParams(ps: List[Param], als: List[Alias]): List[Param] =
  if (List.isEmpty(ps)) ps else rwAliasParam(List.at(ps, 0), als) :: rwAliasParams(List.tail(ps), als)

def rwAliasParam(p: Param, als: List[Alias]): Param =
  p match {
    case Param(n, ty, w, d) => Param(n, rwAliasTy(ty, als), w, d)
  }

def rwAliasTy(t: String, als: List[Alias]): String =
  if (List.isEmpty(als)) t else rwAliasApply(List.at(als, 0), t, List.tail(als))

def rwAliasApply(a: Alias, t: String, rest: List[Alias]): String =
  a match {
    case Alias(n, tps, target) => if (t == n) rwAliasTy(target, rest) else if (List.len(tps) > 0 && Str.startsWith(t, Str.concat(n, "["))) rwAliasTy(rwAliasPrefix(target, n, t), rest) else rwAliasTy(t, rest)
  }

def rwAliasPrefix(target: String, n: String, t: String): String =
  Str.concat(tyHead(target), Str.slice(t, Str.len(n), Str.len(t)))

def emitBits(body: Expr, defs: Ftab, strs: Strs, ens: List[En], files: List[(String, String)], lidx: Map[String, LineIndex]): String =
  emitBitsHeld(body :: noExpr(), defs, strs, ens, files, lidx)

def emitBitsHeld(held: List[Expr], defs: Ftab, strs: Strs, ens: List[En], files: List[(String, String)], lidx: Map[String, LineIndex]): String =
  emitBitsFromConts(emitConts(List.at(held, 0), strs, defs, ens, noParam(), panicLocExprAt(files, lidx, List.at(held, 0))), held, defs, strs, ens, files, lidx)

def emitBitsFromConts(conts: String, held: List[Expr], defs: Ftab, strs: Strs, ens: List[En], files: List[(String, String)], lidx: Map[String, LineIndex]): String =
  emitBitsJoin(emitMainIf(List.at(held, 0), strs, defs, ens, files, lidx), conts, defs, strs, ens, files, lidx)

def emitBitsJoin(main: String, conts: String, defs: Ftab, strs: Strs, ens: List[En], files: List[(String, String)], lidx: Map[String, LineIndex]): String =
  Str.concat(emitConsts(strs.xs, 0), Str.concat(if (List.isEmpty(strs.xs)) "" else nl(), hoistNeth(Str.concat(conts, Str.concat(emitDefs(defs.list, strs, defs, ens, files, lidx), main)))))

def emitMainIf(body: Expr, strs: Strs, defs: Ftab, ens: List[En], files: List[(String, String)], lidx: Map[String, LineIndex]): String =
  if (isEmptyMain(body)) "" else emitMain(body, strs, defs, ens, files, lidx)

def isEmptyMain(e: Expr): Bool =
  e match {
    case Expr.EUnit => true
    case Expr.EVar(s, _) => s == ""
    case _ => false
  }

def fmCount(e: Expr): Int =
  e match {
    case Expr.EMethod(recv, name, args, _) => fmCountMeth(recv, name, args)
    case Expr.EPrint(inner, _) => fmCount(inner)
    case Expr.ELam(_, _, body) => fmCount(body)
    case Expr.ECall(_, args, _) => fmCountSkipLam(args)
    case Expr.EBin(_, l, r, _) => fmCount(l) + fmCount(r)
    case Expr.EUn(_, inner, _) => fmCount(inner)
    case Expr.EIf(c, t, el, _) => fmCount(c) + fmCount(t) + fmCount(el)
    case Expr.ENamed(_, inner) => fmCount(inner)
    case Expr.EAscribe(inner, _, _) => fmCount(inner)
    case Expr.EMatch(s, arms, _) => fmCount(s) + fmCountArms(arms)
    case Expr.EList(xs) => fmCountArgs(xs)
    case Expr.ETuple(xs) => fmCountArgs(xs)
    case Expr.EFor(bs, body, _) => fmCount(desugarFor(bs, body))
    case _ => 0
  }

def fmCountMeth(recv: Expr, name: String, args: List[Expr]): Int =
  if (isFmName(name)) fmCountFm(recv, args) else if (name == "map") fmCountMap(recv, args) else fmCount(recv) + fmCountSkipLam(args)

def fmCountMap(recv: Expr, args: List[Expr]): Int =
  fmCountFm(recv, args)

def fmCountSkipLam(xs: List[Expr]): Int =
  if (List.isEmpty(xs)) 0 else fmCountSkipLam1(List.at(xs, 0)) + fmCountSkipLam(List.tail(xs))

def fmCountSkipLam1(e: Expr): Int =
  e match {
    case Expr.ELam(_, _, _) => 0
    case _ => fmCount(e)
  }

def isFmName(name: String): Bool =
  name match {
    case "flatMap" => true
    case "handleErrorWith" => true
    case _ => false
  }

def fmRt(name: String): String =
  name match {
    case "handleErrorWith" => "sz_io_handle_value"
    case _ => "sz_io_flatmap"
  }

def fmCountFm(recv: Expr, args: List[Expr]): Int =
  1 + fmCount(recv) + fmCountArgs(args)

def fmCountArms(arms: List[Arm]): Int =
  if (List.isEmpty(arms)) 0 else fmCountArm(List.at(arms, 0), List.tail(arms))

def fmCountArm(a: Arm, rest: List[Arm]): Int =
  a match {
    case Arm(_, _, body) => fmCount(body) + fmCountArms(rest)
  }

def fmCountArgs(xs: List[Expr]): Int =
  if (List.isEmpty(xs)) 0 else fmCountArgsHit(xs)

def fmCountArgsHit(xs: List[Expr]): Int =
  xs match {
    case h :: rest => fmCount(h) + fmCountArgs(rest)
    case [] => 0
  }

def emitIoMap(recv: Expr, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  if (Check.isIo(exprRetTyEns(recv, defs, ens, ps, loc))) emitFmRt("sz_io_flatmap", recv, wrapIoMapArgs(args, ps, defs, modOfLoc(loc)), prefix, strs, defs, ens, ps, loc, fid) else emitCtorCall(recv, "map", args, prefix, strs, defs, ens, ps, loc, fid)

def wrapIoMapArgs(args: List[Expr], ps: List[Param], defs: Ftab, mod: String): List[Expr] =
  if (List.isEmpty(args)) args else wrapIoMapLam(List.at(args, 0), ps, defs, mod) :: List.tail(args)

def wrapIoMapLam(e: Expr, ps: List[Param], defs: Ftab, mod: String): Expr =
  wrapIoMapLam1(wrapPh(e, ps, defs, mod))

def wrapIoMapLam1(e: Expr): Expr =
  e match {
    case Expr.ELam(p, ty, body) => Expr.ELam(p, ty, Expr.ECall("IO.pure", body :: noExpr(), 0))
    case Expr.EMatch(s, arms, _) => Expr.ELam("__p", "", Expr.ECall("IO.pure", Expr.EMatch(s, arms, 0) :: noExpr(), 0))
    case _ => Expr.ELam("_ph", "", Expr.ECall("IO.pure", e :: noExpr(), 0))
  }

def emitFmRt(rt: String, recv: Expr, args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitFmCounted(rt, recv, args, prefix, strs, defs, ens, ps, loc, fid, fmCount(recv) + fmCountArgs(args))

def emitFmCounted(rt: String, recv: Expr, _args: List[Expr], prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int, n: Int): Slot =
  emitFmA(rt, fid + n, recv, prefix, strs, defs, ens, ps, loc, fid)

def emitFmA(rt: String, na: Int, recv: Expr, prefix: String, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, fid: Int): Slot =
  emitFm2(rt, emitExprFid(recv, Str.concat(prefix, "_in"), strs, defs, ens, ps, loc, fid), prefix, na, ps)

def emitFm2(rt: String, inner: Slot, prefix: String, id: Int, ps: List[Param]): Slot =
  emitFm3(rt, inner, emitPackEnv(ps, prefix), prefix, id)

def emitFm3(rt: String, inner: Slot, env: Slot, prefix: String, id: Int): Slot =
  inner match {
    case Slot(ic, iv, io) => emitFm4(rt, ic, iv, io, env, prefix, id)
  }

def emitFm4(rt: String, ic: String, iv: String, io: Bool, env: Slot, prefix: String, id: Int): Slot =
  env match {
    case Slot(ec, ev, eo) => emitFm5(rt, join(ic, ec), iv, io, ev, eo, prefix, id)
  }

def emitFm5(rt: String, code: String, iv: String, io: Bool, ev: String, eo: Bool, prefix: String, id: Int): Slot =
  Slot(join(code, join(emitFmCall(rt, prefix, iv, id, ev), join(if (io) relPtr(iv) else "", emitFmRel(ev, eo)))), pct(prefix, "fm"), true)

def emitFmCall(rt: String, prefix: String, iv: String, id: Int, ev: String): String =
  line(Str.concat(tmp(prefix, "fm"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(iv, Str.concat(", ptr @sz_cont_", Str.concat(Str.fromInt(id), Str.concat(", ptr ", Str.concat(ev, ")"))))))))))

def emitFmRel(ev: String, eo: Bool): String =
  if (eo) relPtr(ev) else line("call void @sz_release(ptr null)")

def emitPackEnv(ps: List[Param], prefix: String): Slot =
  if (List.isEmpty(ps)) Slot("", "null", false) else emitPackEnv2(List.reverse(ps), prefix, 0, Slot(line(Str.concat(tmp(prefix, "cap0"), "call ptr @sz_list_nil()")), pct(prefix, "cap0"), true))

def emitPackEnv2(ps: List[Param], prefix: String, i: Int, acc: Slot): Slot =
  if (List.isEmpty(ps)) acc else emitPackEnv3(List.at(ps, 0), List.tail(ps), prefix, i, acc)

def emitPackEnv3(p: Param, rest: List[Param], prefix: String, i: Int, acc: Slot): Slot =
  emitPackEnv2(rest, prefix, i + 1, emitPackCons(p, acc, prefix, i))

def emitPackCons(p: Param, acc: Slot, prefix: String, i: Int): Slot =
  acc match {
    case Slot(code, val, _) => emitPackConsP(p, code, val, prefix, i)
  }

def emitPackConsP(p: Param, code: String, cur: String, prefix: String, i: Int): Slot =
  p match {
    case Param(n, ty, _, _) => emitPackCons2(n, ty, code, cur, prefix, i)
  }

def emitPackCons2(n: String, ty: String, code: String, cur: String, prefix: String, i: Int): Slot =
  if (isI64Ty(ty)) emitPackBox(n, code, cur, prefix, i, ty) else emitPackPtr(n, code, cur, prefix, i)

def emitPackPtr(n: String, code: String, cur: String, prefix: String, i: Int): Slot =
  Slot(join(code, join(emitPackConsCall(prefix, i, Str.concat("%", n), cur), relPtr(cur))), pct(prefix, Str.concat("cap", Str.fromInt(i + 1))), true)

def emitPackConsCall(prefix: String, i: Int, hd: String, cur: String): String =
  line(Str.concat(tmp(prefix, Str.concat("cap", Str.fromInt(i + 1))), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(hd, Str.concat(", ptr ", Str.concat(cur, ")"))))))

def emitPackBox(n: String, code: String, cur: String, prefix: String, i: Int, ty: String): Slot =
  emitPackBox2(n, code, cur, prefix, i, Str.concat("bx", Str.fromInt(i)), ty)

def emitPackBox2(n: String, code: String, cur: String, prefix: String, i: Int, bx: String, ty: String): Slot =
  Slot(join(code, join(boxScalarStem(Str.concat("%", n), ty, prefix, bx), join(emitPackConsCall(prefix, i, pct(prefix, bx), cur), join(relPtr(cur), relPtr(pct(prefix, bx)))))), pct(prefix, Str.concat("cap", Str.fromInt(i + 1))), true)

def emitUnpack(ps: List[Param]): String =
  emitUnpackAt(ps, 0)

def emitUnpackAt(ps: List[Param], i: Int): String =
  if (List.isEmpty(ps)) "" else emitUnpackOne(List.at(ps, 0), List.tail(ps), i)

def emitUnpackOne(p: Param, rest: List[Param], i: Int): String =
  p match {
    case Param(n, ty, _, _) => join(if (isI64Ty(ty)) emitUnpackI64(n, i) else emitUnpackPtr(n, i), emitUnpackAt(rest, i + 1))
  }

def emitUnpackPtr(n: String, i: Int): String =
  line(Str.concat("%", Str.concat(n, Str.concat(" = call ptr @sz_list_at(ptr %.closure.env, i64 ", Str.concat(Str.fromInt(i), ")")))))

def emitUnpackI64(n: String, i: Int): String =
  join(line(Str.concat(tmp(".closure.capture", Str.fromInt(i)), Str.concat("call ptr @sz_list_at(ptr %.closure.env, i64 ", Str.concat(Str.fromInt(i), ")")))), line(Str.concat("%", Str.concat(n, Str.concat(" = call i64 @sz_unbox_i64(ptr ", Str.concat(pct(".closure.capture", Str.fromInt(i)), ")"))))))

def emitOneCont(id: Int, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, bind: String, nested: Bool, start: Int, bty: String): String =
  emitOneContHeld(id, body :: noExpr(), strs, defs, ens, ps, loc, bind, nested, start, bty)

def emitOneContHeld(id: Int, held: List[Expr], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, bind: String, nested: Bool, start: Int, bty: String): String =
  emitOneContTy(id, List.at(held, 0), strs, defs, ens, ps, loc, bind, nested, start, peelIo(bty))

def peelIo(ty: String): String =
  if (Check.isIo(ty)) Check.ioPayload(ty) else ty

def emitOneContTy(id: Int, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, bind: String, nested: Bool, start: Int, bty: String): String =
  if (keepBind(bind) || isI64Ty(bty) || isTuplePat(bind) || isTupTy(bty)) emitOneContAlias(id, body, strs, defs, ens, ps, loc, bind, start, bty) else emitOneCont2(id, emitOneCont3(emitUnpack(ps), emitExprFid(rewriteBind(body, bind, ".closure.value"), Str.concat("c", Str.fromInt(id)), strs, defs, ens, ps, loc, start)), loc, strs)

def keepBind(bind: String): Bool =
  bind != "" && bind != "_"

def bindPsTy(bind: String, ps: List[Param], ty: String): List[Param] =
  if (isTuplePat(bind)) bindTupPsTy(tupBindNs(bind), tupSlots(ty), ps) else if (keepBind(bind)) Param(bind, ty, "", "") :: dropParam(ps, bind) else ps

def bindTupPsTy(ns: List[String], tys: List[String], ps: List[Param]): List[Param] =
  if (List.isEmpty(ns)) ps else bindTupPsTy1(List.at(ns, 0), List.tail(ns), tys, ps)

def bindTupPsTy1(n: String, rest: List[String], tys: List[String], ps: List[Param]): List[Param] =
  if (keepBind(n)) Param(n, headOrAny(tys), "", "") :: dropParam(bindTupPsTy(rest, tailOrEmpty(tys), ps), n) else bindTupPsTy(rest, tailOrEmpty(tys), ps)

def headOrAny(tys: List[String]): String =
  if (List.isEmpty(tys)) "" else List.at(tys, 0)

def tailOrEmpty(tys: List[String]): List[String] =
  if (List.isEmpty(tys)) tys else List.tail(tys)

def secondOrAny(tys: List[String]): String =
  if (List.isEmpty(tys) || List.isEmpty(List.tail(tys))) "" else List.at(List.tail(tys), 0)

def tupBindNs(n: String): List[String] =
  splitPat(Str.slice(n, 1, Str.len(n) - 1))

def dropParam(ps: List[Param], n: String): List[Param] =
  if (List.isEmpty(ps)) ps else dropParam1(List.at(ps, 0), List.tail(ps), n)

def dropParam1(p: Param, rest: List[Param], n: String): List[Param] =
  p match {
    case Param(pn, _, _, _) => if (pn == n) dropParam(rest, n) else p :: dropParam(rest, n)
  }

def emitBindAlias(n: String, ty: String): String =
  if (isTuplePat(n)) emitTupAlias(n, ty) else if (isI64Ty(ty)) emitBindAliasI64(n) else emitBindAliasPtr(n)

def emitTupAlias(n: String, ty: String): String =
  emitTupAliasAt(tupBindNs(n), tupSlots(ty), "%.closure.value", 0)

def emitTupAliasAt(ns: List[String], tys: List[String], scrut: String, k: Int): String =
  if (List.len(ns) < 2) "" else if (List.len(ns) == 2) join(tupAliasSlot(List.at(ns, 0), scrut, true, headOrAny(tys)), tupAliasSlot(List.at(List.tail(ns), 0), scrut, false, secondOrAny(tys))) else join(tupAliasSlot(List.at(ns, 0), scrut, true, headOrAny(tys)), join(tupAliasRight(tupRestName(k), scrut), emitTupAliasAt(List.tail(ns), tailOrEmpty(tys), Str.concat("%", tupRestName(k)), k + 1)))

def tupRestName(k: Int): String =
  Str.concat(".closure.tuple_rest", Str.fromInt(k))

def tupAliasSlot(n: String, scrut: String, left: Bool, ty: String): String =
  if (!keepBind(n) || isTuplePat(n)) "" else if (isI64Ty(ty)) tupAliasUnbox(n, scrut, left) else if (left) tupAliasLeft(n, scrut) else tupAliasRight(n, scrut)

def tupAliasUnbox(n: String, scrut: String, left: Bool): String =
  join(line(Str.concat("%.closure.tuple.", Str.concat(n, Str.concat(" = call ptr @", Str.concat(if (left) "sz_pair_left" else "sz_pair_right", Str.concat("(ptr ", Str.concat(scrut, ")"))))))), line(Str.concat("%", Str.concat(n, Str.concat(" = call i64 @sz_unbox_i64(ptr %.closure.tuple.", Str.concat(n, ")"))))))

def tupAliasLeft(n: String, scrut: String): String =
  line(Str.concat("%", Str.concat(n, Str.concat(" = call ptr @sz_pair_left(ptr ", Str.concat(scrut, ")")))))

def tupAliasRight(n: String, scrut: String): String =
  line(Str.concat("%", Str.concat(n, Str.concat(" = call ptr @sz_pair_right(ptr ", Str.concat(scrut, ")")))))

def emitBindAliasPtr(n: String): String =
  line(Str.concat("%", Str.concat(n, " = bitcast ptr %.closure.value to ptr")))

def emitBindAliasI64(n: String): String =
  join(line(Str.concat("%", Str.concat(n, " = call i64 @sz_unbox_i64(ptr %.closure.value)"))), relPtr("%.closure.value"))

def emitOneContAlias(id: Int, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, bind: String, start: Int, bty: String): String =
  emitOneContAlias2(id, body, strs, defs, ens, dropParam(ps, bind), loc, bind, start, bty)

def emitOneContAlias2(id: Int, body: Expr, strs: Strs, defs: Ftab, ens: List[En], rest: List[Param], loc: String, bind: String, start: Int, bty: String): String =
  emitOneCont2(id, emitContDrop(emitOneCont3(join(emitUnpack(rest), emitBindAlias(bind, bty)), emitExprFid(body, Str.concat("c", Str.fromInt(id)), strs, defs, ens, bindPsTy(bind, rest, bty), loc, start)), bty), loc, strs)

def emitContDrop(s: Slot, bty: String): Slot =
  Slot(join(s.code, if (isI64Ty(bty)) "" else relPtr("%.closure.value")), s.val, s.owned)

def emitOneCont3(pre: String, s: Slot): Slot =
  s match {
    case Slot(code, val, o) => Slot(join(pre, code), val, o)
  }

def emitOneCont2(id: Int, s: Slot, loc: String, strs: Strs): String =
  Str.concat("define internal ptr @sz_cont_", Str.concat(Str.fromInt(id), Str.concat("(ptr %.closure.value, ptr %.closure.env) {", Str.concat(nl(), Str.concat(".entry:", Str.concat(nl(), Str.concat(panicPush(loc, strs), Str.concat(s.code, Str.concat(panicPop(), Str.concat("  ret ptr ", Str.concat(s.val, Str.concat(nl(), Str.concat("}", Str.concat(nl(), nl()))))))))))))))

def emitConts(e: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): String =
  emitContsHead(emitContsAt(e, strs, defs, ens, ps, loc, 0))

def emitContsHead(p: (String, Int)): String =
  p match {
    case (code, _) => Str.concat(code, "")
  }

def emitContsAt(e: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  e match {
    case Expr.EMethod(recv, name, args, _) => if (name == "handleErrorWith") emitContsFmTy(Check.ioErr(exprRetTyEns(recv, defs, ens, ps, loc)), recv, args, strs, defs, ens, ps, loc, id) else if (isFmName(name)) emitContsFm(recv, args, strs, defs, ens, ps, loc, id) else if (name == "map") emitContsMap(recv, args, strs, defs, ens, ps, loc, id) else if (name == "apply") emitContsApply(recv, args, strs, defs, ens, ps, loc, id) else emitContsCtor(recv, args, strs, defs, ens, ps, loc, id)
    case Expr.EPrint(inner, _) => emitContsAtGo(inner, strs, defs, ens, ps, loc, id)
    case Expr.ELam(_, _, _) => ("", id)
    case Expr.ECall(_, args, _) => emitContsArgs(args, strs, defs, ens, ps, loc, id)
    case Expr.EIf(c, t, el, _) => emitContsIf(c, t, el, strs, defs, ens, ps, loc, id)
    case Expr.ENamed(_, inner) => emitContsAtGo(inner, strs, defs, ens, ps, loc, id)
    case Expr.EAscribe(inner, _, _) => emitContsAtGo(inner, strs, defs, ens, ps, loc, id)
    case Expr.EBin(_, l, r, _) => emitContsIf(l, r, Expr.EUnit, strs, defs, ens, ps, loc, id)
    case Expr.EUn(_, inner, _) => emitContsAtGo(inner, strs, defs, ens, ps, loc, id)
    case Expr.EField(recv, _, _) => emitContsAtGo(recv, strs, defs, ens, ps, loc, id)
    case Expr.EMatch(s, arms, _) => emitContsMatch(s, arms, strs, defs, ens, ps, loc, id)
    case Expr.EList(xs) => emitContsArgs(xs, strs, defs, ens, ps, loc, id)
    case Expr.ETuple(xs) => emitContsArgs(xs, strs, defs, ens, ps, loc, id)
    case Expr.EFor(bs, body, _) => emitContsAtGo(desugarFor(bs, body), strs, defs, ens, ps, loc, id)
    case _ => ("", id)
  }

def emitContsAtGo(e: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsAt(e, strs, defs, ens, ps, loc, id)

def emitContsApply(recv: Expr, args: List[Expr], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  recv match {
    case Expr.ELam(p, _, body) => emitContsApplyLam(p, body, args, strs, defs, ens, ps, loc, id)
    case _ => emitContsCtor(recv, args, strs, defs, ens, ps, loc, id)
  }

def emitContsApplyLam(p: String, body: Expr, args: List[Expr], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsCtor2(emitContsAt(body, strs, defs, ens, bindPsTy(p, ps, applyBindTy(p, applyScrut(args), defs, ens, ps, loc)), loc, id), args, strs, defs, ens, ps, loc)

def emitContsCtor(recv: Expr, args: List[Expr], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsCtor2(emitContsAt(recv, strs, defs, ens, ps, loc, id), args, strs, defs, ens, ps, loc)

def emitContsCtor2(p: (String, Int), args: List[Expr], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArgs(args, strs, defs, ens, ps, loc, id))
  }

def emitContsMatch(s: Expr, arms: List[Arm], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsMatch2(emitContsAt(s, strs, defs, ens, ps, loc, id), arms, strs, defs, ens, ps, loc, exprRetTyEns(s, defs, ens, ps, loc))

def emitContsMatch2(p: (String, Int), arms: List[Arm], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, ty: String): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArmList(arms, strs, defs, ens, ps, loc, id, ty))
  }

def emitContsArmList(arms: List[Arm], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, id: Int, ty: String): (String, Int) =
  if (List.isEmpty(arms)) ("", id) else emitContsArmHd(List.at(arms, 0), List.tail(arms), strs, defs, ens, ps, loc, id, ty)

def emitContsArmHd(a: Arm, rest: List[Arm], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, id: Int, ty: String): (String, Int) =
  a match {
    case Arm(pat, _, body) => emitContsArmList2(emitContsAt(body, strs, defs, ens, bindPatPs(pat, ps, ty, ens), loc, id), rest, strs, defs, ens, ps, loc, ty)
  }

def bindPatPs(pat: String, ps: List[Param], ty: String, ens: List[En]): List[Param] =
  if (isOrPat(pat)) bindPatPs(orLeft(pat), ps, ty, ens) else if (isTuplePat(pat)) bindTupPsTy(tupBindNs(pat), tupSlots(ty), ps) else if (isVarPat(pat, ens)) bindPsTy(pat, ps, ty) else if (patBind(pat) != "" || isConsPat(pat)) List.concat(List.map(List.filter(Check.bindPat(pat, ty, noEnv(), ens), binding => isPatternName(binding._1)), binding => Param(binding._1, Type.show(binding._2), "", "")), ps) else ps

def emitContsArmList2(p: (String, Int), rest: List[Arm], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, ty: String): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArmList(rest, strs, defs, ens, ps, loc, id, ty))
  }

def emitContsMap(recv: Expr, args: List[Expr], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  if (Check.isIo(exprRetTyEns(recv, defs, ens, ps, loc))) emitContsFm(recv, wrapIoMapArgs(args, ps, defs, modOfLoc(loc)), strs, defs, ens, ps, loc, id) else reserveMapCont(emitContsCtor(recv, args, strs, defs, ens, ps, loc, id), args)

def reserveMapCont(p: (String, Int), args: List[Expr]): (String, Int) =
  (p._1, p._2 + 1 + fmCountArgs(args) - fmCountSkipLam(args))

def emitContsFm(recv: Expr, args: List[Expr], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsFmTy(recvBindTy(recv, ens, defs, ps, loc), recv, args, strs, defs, ens, ps, loc, id)

def recvBindTy(recv: Expr, ens: List[En], defs: Ftab, ps: List[Param], loc: String): String =
  peelIo(exprRetTyEns(recv, defs, ens, ps, loc))

def emitContsFmTy(bty: String, recv: Expr, args: List[Expr], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsFm2(emitContsAt(recv, strs, defs, ens, ps, loc, id), lamArg(args), strs, defs, ens, ps, loc, bty)

def lamArg(args: List[Expr]): Expr =
  if (List.isEmpty(args)) Expr.EUnit else List.at(args, 0)

def emitContsFm2(p: (String, Int), lam: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, bty: String): (String, Int) =
  p match {
    case (code, id) => emitContsFm3(code, id, lam, strs, defs, ens, ps, loc, bty)
  }

def emitContsFm3(code: String, id: Int, lam: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, bty: String): (String, Int) =
  lam match {
    case Expr.ELam(p, _, body) => emitContsFm3Body(code, id, p, body, strs, defs, ens, ps, loc, bty)
    case _ => (code, id)
  }

def emitContsFm3Body(code: String, id: Int, p: String, body: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, bty: String): (String, Int) =
  emitContsFm3Held(code, id, p, body :: noExpr(), strs, defs, ens, ps, loc, bty)

def emitContsFm3Held(code: String, id: Int, p: String, held: List[Expr], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, bty: String): (String, Int) =
  emitContsFm3After(code, id, p, held, strs, defs, ens, ps, loc, bty, emitContsAt(List.at(held, 0), strs, defs, ens, bindPsTy(p, ps, bty), loc, id))

def emitContsFm3After(code: String, id: Int, p: String, held: List[Expr], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, bty: String, nested: (String, Int)): (String, Int) =
  nested match {
    case (ncode, id2) => (join(code, join(ncode, emitOneCont(id2, List.at(held, 0), strs, defs, ens, ps, loc, p, id2 > id, id, bty))), id2 + 1)
  }

def emitContsArgs(xs: List[Expr], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  if (List.isEmpty(xs)) ("", id) else emitContsArgs2(emitContsAt(List.at(xs, 0), strs, defs, ens, ps, loc, id), List.tail(xs), strs, defs, ens, ps, loc)

def emitContsArgs2(p: (String, Int), rest: List[Expr], strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): (String, Int) =
  p match {
    case (code, id) => emitContsArgs3(code, emitContsArgs(rest, strs, defs, ens, ps, loc, id))
  }

def emitContsArgs3(code: String, p: (String, Int)): (String, Int) =
  p match {
    case (rest, id) => (join(code, rest), id)
  }

def emitContsIf(c: Expr, t: Expr, el: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String, id: Int): (String, Int) =
  emitContsIf2(emitContsAt(c, strs, defs, ens, ps, loc, id), t, el, strs, defs, ens, ps, loc)

def emitContsIf2(p: (String, Int), t: Expr, el: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): (String, Int) =
  p match {
    case (code, id) => emitContsIf3(code, emitContsAt(t, strs, defs, ens, ps, loc, id), el, strs, defs, ens, ps, loc)
  }

def emitContsIf3(code: String, p: (String, Int), el: Expr, strs: Strs, defs: Ftab, ens: List[En], ps: List[Param], loc: String): (String, Int) =
  p match {
    case (rest, id) => emitContsArgs3(join(code, rest), emitContsAt(el, strs, defs, ens, ps, loc, id))
  }

def hoistNeth(ir: String): String =
  hoistNethPairs(ir, findNeths(ir, 0, [], []))

def findNeths(s: String, i: Int, stack: List[Int], acc: List[(Int, Int)]): List[(Int, Int)] =
  if (i >= Str.len(s)) List.reverse(acc) else if (nethBegAt(s, i)) findNeths(s, i + 6, i :: stack, acc) else if (nethEndAt(s, i) && !List.isEmpty(stack)) findNeths(s, i + 6, List.tail(stack), (List.at(stack, 0), i) :: acc) else findNeths(s, i + 1, stack, acc)

def hoistNethPairs(s: String, pairs: List[(Int, Int)]): String =
  Builder.result(hoistNethRest(s, pairs, hoistNethBodies(s, pairs, pairs, Builder.empty())))

def hoistNethBodies(s: String, pairs: List[(Int, Int)], all: List[(Int, Int)], b: Builder): Builder =
  if (List.isEmpty(pairs)) b else hoistNethBodies(s, List.tail(pairs), all, copySkip(s, List.at(pairs, 0)._1 + 6, List.at(pairs, 0)._2, childSkips(all, List.at(pairs, 0)._1, List.at(pairs, 0)._2), b))

def childSkips(all: List[(Int, Int)], b: Int, e: Int): List[(Int, Int)] =
  childSkipsGo(all, b, e, [])

def childSkipsGo(all: List[(Int, Int)], b: Int, e: Int, acc: List[(Int, Int)]): List[(Int, Int)] =
  if (List.isEmpty(all)) acc else childSkipsHd(List.at(all, 0), List.tail(all), b, e, acc)

def childSkipsHd(p: (Int, Int), rest: List[(Int, Int)], b: Int, e: Int, acc: List[(Int, Int)]): List[(Int, Int)] =
  p match {
    case (cb, ce) => if (cb > b && ce < e) childSkipsGo(rest, b, e, insSkip(acc, (cb, ce + 6))) else childSkipsGo(rest, b, e, acc)
  }

def insSkip(xs: List[(Int, Int)], p: (Int, Int)): List[(Int, Int)] =
  if (List.isEmpty(xs)) p :: [] else insSkipHd(List.at(xs, 0), List.tail(xs), p)

def insSkipHd(h: (Int, Int), rest: List[(Int, Int)], p: (Int, Int)): List[(Int, Int)] =
  h match {
    case (hu, _) => insSkipP(hu, h, rest, p)
  }

def insSkipP(hu: Int, h: (Int, Int), rest: List[(Int, Int)], p: (Int, Int)): List[(Int, Int)] =
  p match {
    case (pu, _) => if (pu < hu) p :: h :: rest else h :: insSkip(rest, p)
  }

def copySkip(s: String, from: Int, to: Int, skips: List[(Int, Int)], b: Builder): Builder =
  if (from >= to) b else if (List.isEmpty(skips)) Builder.append(b, Str.slice(s, from, to)) else if (List.at(skips, 0)._2 <= from) copySkip(s, from, to, List.tail(skips), b) else if (List.at(skips, 0)._1 >= to) Builder.append(b, Str.slice(s, from, to)) else if (List.at(skips, 0)._1 <= from) copySkip(s, List.at(skips, 0)._2, to, List.tail(skips), b) else copySkip(s, List.at(skips, 0)._2, to, List.tail(skips), Builder.append(b, Str.slice(s, from, List.at(skips, 0)._1)))

def hoistNethRest(s: String, pairs: List[(Int, Int)], b: Builder): Builder =
  copySkip(s, 0, Str.len(s), allSkips(pairs, []), b)

def allSkips(pairs: List[(Int, Int)], acc: List[(Int, Int)]): List[(Int, Int)] =
  if (List.isEmpty(pairs)) acc else allSkipsHd(List.at(pairs, 0), List.tail(pairs), acc)

def allSkipsHd(p: (Int, Int), rest: List[(Int, Int)], acc: List[(Int, Int)]): List[(Int, Int)] =
  p match {
    case (b, e) => allSkips(rest, insSkip(acc, (b, e + 6)))
  }

def nethBegAt(s: String, i: Int): Bool =
  i + 6 <= Str.len(s) && Str.charAt(s, i) == 78 && Str.charAt(s, i + 1) == 69 && Str.charAt(s, i + 2) == 84 && Str.charAt(s, i + 3) == 72 && Str.charAt(s, i + 4) == 66 && Str.charAt(s, i + 5) == 10

def nethEndAt(s: String, i: Int): Bool =
  i + 6 <= Str.len(s) && Str.charAt(s, i) == 78 && Str.charAt(s, i + 1) == 69 && Str.charAt(s, i + 2) == 84 && Str.charAt(s, i + 3) == 72 && Str.charAt(s, i + 4) == 69 && Str.charAt(s, i + 5) == 10

def emit(src: String): String =
  emitOne(Parse.parseFiles(("Main", src) :: []), collectToks(Lexer.lex(src), emptyStrs()), ("Main", src) :: [])

def emitOne(p: Prog, strs: Strs, files: List[(String, String)]): String =
  emitOneIdx(p, strs, files, fileIndex(files))

def emitOneIdx(p: Prog, strs: Strs, files: List[(String, String)], lidx: Map[String, LineIndex]): String =
  emitProg(p, internSigProg(p, files, lidx, strs), files, lidx)

def internFiles(files: List[(String, String)], acc: Strs): Strs =
  if (List.isEmpty(files)) intern(acc, "guard") else internFiles2(List.at(files, 0), List.tail(files), acc)

def internFiles2(f: (String, String), rest: List[(String, String)], acc: Strs): Strs =
  f match {
    case (_, src) => internFiles(rest, collectToks(Lexer.lex(src), acc))
  }

def emitFiles(files: List[(String, String)]): String =
  emitFilesGot(Parse.parseFiles(files), internFiles(files, emptyStrs()), files)

def emitFilesGot(p: Prog, strs: Strs, files: List[(String, String)]): String =
  emitFilesIdx(p, strs, files, fileIndex(files))

def emitFilesIdx(p: Prog, strs: Strs, files: List[(String, String)], lidx: Map[String, LineIndex]): String =
  emitProg(p, internSigProg(p, files, lidx, internRel(p, strs)), files, lidx)

