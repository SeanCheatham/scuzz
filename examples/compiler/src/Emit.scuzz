def emitConsCall(code: String, vals: List[String], owns: List[Bool], prefix: String, args: List[Expr], ps: List[Param], defs: Ftab): Slot =
  emitConsCall2(code, arg0(vals), arg1(vals), headOwn(owns) || isViewParamVal(arg0(vals), ps), headOwn(tailOwn(owns)), prefix, consHeadInt(args, ps, defs) || isI64Head(arg0(vals), headOwn(owns), ps), false)

def consHeadInt(args: List[Expr], ps: List[Param], defs: Ftab): Bool =
  if (List.isEmpty(args)) true else exprIsI64(List.at(args, 0), ps, defs)

def isI64Head(v: String, o: Bool, ps: List[Param]): Bool =
  !o && v != "null" && !isPtrSlot(v, ps) && (isIntSsa(v) || isI64ParamVal(v, ps))

def isI64ParamVal(v: String, ps: List[Param]): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37 && paramIsI64(ps, Str.slice(v, 1, Str.len(v)))

def isViewParamVal(v: String, ps: List[Param]): Bool =
  Str.len(v) > 0 && Str.charAt(v, 0) == 37 && paramTy(ps, Str.slice(v, 1, Str.len(v))) == "View"

def emitConsCall2(code: String, h: String, t: String, oh: Bool, ot: Bool, prefix: String, isInt: Bool, isFloat: Bool): Slot =
  if (isInt) emitConsInt(code, h, t, ot, prefix, isFloat) else emitConsPtr(code, h, t, oh, ot, prefix)

def emitConsInt(code: String, h: String, t: String, ot: Bool, prefix: String, isFloat: Bool): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "hd"), Str.concat("call ptr @", Str.concat(if (isFloat) "sz_box_float_bits" else "sz_box_i64", Str.concat("(i64 ", Str.concat(h, ")")))))), join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(pct(prefix, "hd"), Str.concat(", ptr ", Str.concat(t, ")")))))), join(relPtr(pct(prefix, "hd")), if (ot) relPtr(t) else "")))), pct(prefix, "v"), true)

def emitConsPtr(code: String, h: String, t: String, oh: Bool, ot: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(h, Str.concat(", ptr ", Str.concat(t, ")")))))), join(if (oh) relPtr(h) else "", if (ot) relPtr(t) else ""))), pct(prefix, "v"), true)

