def netHttpUnaryRt(f: String): String =
  if (f == "Net.httpDelete") "sz_net_http_delete" else if (f == "Net.httpHead") "sz_net_http_head" else "sz_net_http_get"

def kitUnaryI64(f: String): String =
  if (f == "Bytes.len") "sz_string_len" else if (f == "Map.size" || f == "Set.size") "sz_map_size" else if (f == "Json.isNull") "sz_json_is_null" else if (f == "Json.isObj") "sz_json_is_obj" else if (f == "Json.isArr") "sz_json_is_arr" else if (f == "Json.isBool") "sz_json_is_bool" else if (f == "Json.isInt") "sz_json_is_int" else if (f == "Json.isStr") "sz_json_is_str" else if (f == "Json.isFloat") "sz_json_is_float" else if (f == "List.sum") "sz_list_sum" else if (f == "List.product") "sz_list_product" else if (f == "List.nonEmpty") "sz_list_non_empty" else if (f == "Str.isEmpty") "sz_string_is_empty" else if (f == "Str.nonEmpty") "sz_string_non_empty" else if (f == "Str.isBlank") "sz_string_is_blank" else ""

def kitPtrI64(f: String): String =
  if (f == "List.take") "sz_list_take" else if (f == "List.drop") "sz_list_drop" else if (f == "List.takeRight") "sz_list_take_right" else if (f == "List.dropRight") "sz_list_drop_right" else if (f == "List.splitAt") "sz_list_split_at" else if (f == "List.grouped") "sz_list_grouped" else if (f == "List.sliding") "sz_list_sliding" else if (f == "Str.take") "sz_string_utake" else if (f == "Str.drop") "sz_string_udrop" else if (f == "Str.takeRight") "sz_string_utake_right" else if (f == "Str.dropRight") "sz_string_udrop_right" else if (f == "Json.at") "sz_json_at" else if (f == "Json.dropAt") "sz_json_drop_at" else if (f == "Stream.take") "sz_stream_take" else if (f == "Stream.drop") "sz_stream_drop" else if (f == "Stream.repeatN") "sz_stream_repeat_n" else if (f == "Stream.grouped") "sz_stream_grouped" else if (f == "Stream.takeRight") "sz_stream_take_right" else if (f == "Stream.dropRight") "sz_stream_drop_right" else if (f == "Stream.sliding") "sz_stream_sliding" else ""

def kitBinaryPtr(f: String): String =
  if (f == "Hash.hmacSha256") "sz_hash_hmac_sha256" else if (f == "Net.nextLink") "sz_net_next_link" else if (f == "Json.get") "sz_json_get" else if (f == "Json.merge") "sz_json_merge" else if (f == "Json.remove") "sz_json_remove" else if (f == "Json.append") "sz_json_append" else if (f == "Json.prepend") "sz_json_prepend" else if (f == "Set.union") "sz_set_union" else if (f == "Set.intersect") "sz_set_intersect" else if (f == "Set.diff") "sz_set_diff" else if (f == "Map.union") "sz_map_union" else if (f == "Map.intersect") "sz_map_intersect" else if (f == "Map.diff") "sz_map_diff" else if (f == "Map.remove" || f == "Set.remove") "sz_map_remove" else if (f == "Map.get") "sz_map_get" else kitBinaryPtrB(f)

def kitBinaryPtrB(f: String): String =
  if (f == "IO.both") "sz_io_both" else if (f == "IO.race") "sz_io_race" else if (f == "IO.ensure") "sz_io_ensure" else if (f == "Ref.set") "sz_ref_set" else if (f == "Queue.offer") "sz_queue_offer" else if (f == "Deferred.complete") "sz_deferred_complete" else if (f == "Deferred.fail") "sz_deferred_fail" else if (f == "Stream.concat") "sz_stream_concat" else if (f == "Stream.zip") "sz_stream_zip" else if (f == "Stream.interleave") "sz_stream_interleave" else if (f == "Stream.orElse") "sz_stream_or_else" else if (f == "Stream.intersperse") "sz_stream_intersperse" else if (f == "List.interleave") "sz_list_interleave" else if (f == "List.append") "sz_list_append" else if (f == "List.zip") "sz_list_zip" else if (f == "List.intersperse") "sz_list_intersperse" else if (f == "List.diff") "sz_list_diff" else if (f == "List.intersect") "sz_list_intersect" else if (f == "Str.split") "sz_string_split" else if (f == "Str.capture") "sz_string_capture" else if (f == "Str.stripPrefix") "sz_string_strip_prefix" else if (f == "Str.stripSuffix") "sz_string_strip_suffix" else if (f == "Fs.join") "sz_fs_join" else ""

def kitBinaryI64(f: String): String =
  if (f == "Hash.constantTimeEqual") "sz_hash_constant_time_equal" else if (f == "Map.contains" || f == "Set.contains") "sz_map_contains" else if (f == "Json.has") "sz_json_has" else if (f == "Str.contains") "sz_string_contains" else if (f == "Str.matches") "sz_string_matches" else if (f == "Str.endsWith") "sz_string_ends_with" else if (f == "Str.indexOf") "sz_string_uindex_of" else if (f == "Str.lastIndexOf") "sz_string_ulast_index_of" else if (f == "Set.isSubset") "sz_set_is_subset" else if (f == "Set.isDisjoint") "sz_set_is_disjoint" else if (f == "List.contains") "sz_list_contains" else if (f == "List.indexOf") "sz_list_index_of" else if (f == "List.lastIndexOf") "sz_list_last_index_of" else if (f == "List.indexOfSlice") "sz_list_index_of_slice" else if (f == "List.lastIndexOfSlice") "sz_list_last_index_of_slice" else if (f == "List.startsWith") "sz_list_starts_with" else if (f == "List.endsWith") "sz_list_ends_with" else if (f == "List.sameElements") "sz_list_same_elements" else ""

def emitKitUnaryPtr(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitKitUnaryPtr2(rt, code, arg0(vals), headOwn(owns), prefix)

def emitKitUnaryPtr2(rt: String, code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(kitUnaryPre(rt, v, o), join(kitCallPtr1(rt, v, prefix), kitUnaryRel(rt, v, o)))), pct(prefix, "v"), true)

def kitKeepUnaryArg(rt: String): Bool =
  rt == "sz_ref_of"

def kitUnaryPre(rt: String, v: String, o: Bool): String =
  if (!o && kitKeepUnaryArg(rt)) retPtr(v) else ""

def kitUnaryRel(rt: String, v: String, o: Bool): String =
  if (o && !kitKeepUnaryArg(rt)) relPtr(v) else ""

def emitKitUnaryBox(rt: String, code: String, v: String, prefix: String, isFloat: Bool): Slot =
  Slot(join(code, join(boxScalarStem(v, if (isFloat) "Float" else "Int", prefix, "kb"), join(kitCallPtr1(rt, pct(prefix, "kb"), prefix), kitUnaryRel(rt, pct(prefix, "kb"), true)))), pct(prefix, "v"), true)

def kitCallPtr1(rt: String, v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(v, ")"))))))

def emitKitUnaryI64(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitKitUnaryI642(rt, code, arg0(vals), headOwn(owns), prefix)

def emitKitUnaryI642(rt: String, code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(kitCallI641(rt, v, prefix), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def kitCallI641(rt: String, v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(v, ")"))))))

def emitKitPtrI64(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitKitPtrI642(rt, code, arg0(vals), arg1(vals), headOwn(owns), prefix)

def emitKitPtrI642(rt: String, code: String, a: String, n: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(kitCallPtrI64(rt, a, n, prefix), if (o) relPtr(a) else "")), pct(prefix, "v"), true)

def kitCallPtrI64(rt: String, a: String, n: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(a, Str.concat(", i64 ", Str.concat(n, ")"))))))))

def emitKitBinaryPtr(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitKitBinaryPtr2(rt, code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitKitBinaryPtr2(rt: String, code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(kitCallPtr2(rt, a, b, prefix), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), true)

def emitKitBinaryBoxB(rt: String, code: String, a: String, b: String, oa: Bool, prefix: String, isFloat: Bool): Slot =
  Slot(join(code, join(boxScalarStem(b, if (isFloat) "Float" else "Int", prefix, "kb"), join(kitCallPtr2(rt, a, pct(prefix, "kb"), prefix), join(if (oa) relPtr(a) else "", relPtr(pct(prefix, "kb")))))), pct(prefix, "v"), true)

def kitCallPtr2(rt: String, a: String, b: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, Str.concat("(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))))

def emitKitBinaryI64(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitKitBinaryI642(rt, code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitKitBinaryI642(rt: String, code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String): Slot =
  Slot(join(code, join(kitCallI642(rt, a, b, prefix), join(if (oa) relPtr(a) else "", if (ob) relPtr(b) else ""))), pct(prefix, "v"), false)

def emitKitBinaryI64Box(rt: String, code: String, a: String, b: String, oa: Bool, prefix: String, isFloat: Bool): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "kb"), Str.concat("call ptr @", Str.concat(if (isFloat) "sz_box_float_bits" else "sz_box_i64", Str.concat("(i64 ", Str.concat(b, ")")))))), join(kitCallI642(rt, a, pct(prefix, "kb"), prefix), join(if (oa) relPtr(a) else "", relPtr(pct(prefix, "kb")))))), pct(prefix, "v"), false)

def kitCallI642(rt: String, a: String, b: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call i64 @", Str.concat(rt, Str.concat("(ptr ", Str.concat(a, Str.concat(", ptr ", Str.concat(b, ")"))))))))

def emitListJoin(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListJoin2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitListJoin2(code: String, xs: String, sep: String, ox: Bool, os: Bool, prefix: String): Slot =
  Slot(join(code, join(kitJoinCall(xs, sep, prefix), join(if (ox) relPtr(xs) else "", if (os) relPtr(sep) else ""))), pct(prefix, "v"), true)

def kitJoinCall(xs: String, sep: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_join(ptr ", Str.concat(xs, Str.concat(", ptr ", Str.concat(sep, ")"))))))

def emitMapEmpty(code: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), "call ptr @sz_map_empty()"))), pct(prefix, "v"), true)

def emitListNil(code: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), "call ptr @sz_list_nil()"))), pct(prefix, "v"), true)

def secondNeedsBox(e: Expr, owns: List[Bool], defs: Ftab, ens: List[En], ps: List[Param], mod: String): Bool =
  isI64Ty(exprRetTyEns(e, defs, ens, ps, mod)) && !headOwn(tailOwn(owns))

def firstNeedsBox(e: Expr, owns: List[Bool], defs: Ftab, ens: List[En], ps: List[Param], mod: String): Bool =
  isI64Ty(exprRetTyEns(e, defs, ens, ps, mod)) && !headOwn(owns)

def thirdNeedsBox(e: Expr, owns: List[Bool], defs: Ftab, ens: List[En], ps: List[Param], mod: String): Bool =
  isI64Ty(exprRetTyEns(e, defs, ens, ps, mod)) && !headOwn(tailOwn(tailOwn(owns)))

def fourthNeedsBox(e: Expr, owns: List[Bool], defs: Ftab, ens: List[En], ps: List[Param], mod: String): Bool =
  isI64Ty(exprRetTyEns(e, defs, ens, ps, mod)) && !headOwn(tailOwn(tailOwn(tailOwn(owns))))

def emitMapSet(code: String, vals: List[String], owns: List[Bool], prefix: String, numeric: Bool, boxKey: Bool, keyFloat: Bool, valueFloat: Bool): Slot =
  if (boxKey) emitMapSetBox(code, vals, owns, prefix, numeric, keyFloat, valueFloat) else emitMapSet2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(owns)), headOwn(tailOwn(tailOwn(owns))), prefix, numeric, valueFloat)

def emitMapSetBox(code: String, vals: List[String], owns: List[Bool], prefix: String, numeric: Bool, keyFloat: Bool, valueFloat: Bool): Slot =
  emitMapSet2(join(code, pairBoxTyped(arg1(vals), true, keyFloat, prefix, "mk")), arg0(vals), pct(prefix, "mk"), arg2(vals), headOwn(owns), true, headOwn(tailOwn(tailOwn(owns))), prefix, numeric, valueFloat)

def emitMapSet2(code: String, m: String, k: String, v: String, om: Bool, ok: Bool, ov: Bool, prefix: String, numeric: Bool, valueFloat: Bool): Slot =
  if (numeric) emitMapSetNum(code, m, k, v, om, ok, prefix, valueFloat) else emitMapSetPtr(code, m, k, v, om, ok, ov, prefix)

def emitMapSetPtr(code: String, m: String, k: String, v: String, om: Bool, ok: Bool, ov: Bool, prefix: String): Slot =
  Slot(join(code, join(kitMapSetCall(m, k, v, prefix), join(if (om) relPtr(m) else "", join(if (ok) relPtr(k) else "", if (ov) relPtr(v) else "")))), pct(prefix, "v"), true)

def emitMapSetNum(code: String, m: String, k: String, v: String, om: Bool, ok: Bool, prefix: String, valueFloat: Bool): Slot =
  Slot(join(code, join(pairBoxTyped(v, true, valueFloat, prefix, "mb"), join(kitMapSetCall(m, k, pct(prefix, "mb"), prefix), join(if (om) relPtr(m) else "", join(if (ok) relPtr(k) else "", relPtr(pct(prefix, "mb"))))))), pct(prefix, "v"), true)

def kitMapSetCall(m: String, k: String, v: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_map_set(ptr ", Str.concat(m, Str.concat(", ptr ", Str.concat(k, Str.concat(", ptr ", Str.concat(v, ", i32 1)"))))))))

def emitSetAdd(code: String, vals: List[String], owns: List[Bool], prefix: String, boxKey: Bool, keyFloat: Bool): Slot =
  if (boxKey) emitSetAdd2(join(code, pairBoxTyped(arg1(vals), true, keyFloat, prefix, "mk")), arg0(vals), pct(prefix, "mk"), headOwn(owns), true, prefix) else emitSetAdd2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix)

def emitSetAdd2(code: String, m: String, k: String, om: Bool, ok: Bool, prefix: String): Slot =
  Slot(join(code, join(kitSetAddCall(m, k, prefix), join(if (om) relPtr(m) else "", if (ok) relPtr(k) else ""))), pct(prefix, "v"), true)

def kitSetAddCall(m: String, k: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_map_set(ptr ", Str.concat(m, Str.concat(", ptr ", Str.concat(k, ", ptr null, i32 1)"))))))

def emitBoxedSecondPtr(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, boxSecond: Bool, isFloat: Bool): Slot =
  if (boxSecond) emitKitBinaryBoxB(kitBinaryPtr(f), code, arg0(vals), arg1(vals), headOwn(owns), prefix, isFloat) else emitKitBinaryPtr(kitBinaryPtr(f), code, vals, owns, prefix)

def emitBoxedSecondI64(f: String, code: String, vals: List[String], owns: List[Bool], prefix: String, boxSecond: Bool, isFloat: Bool): Slot =
  if (boxSecond) emitKitBinaryI64Box(kitBinaryI64(f), code, arg0(vals), arg1(vals), headOwn(owns), prefix, isFloat) else emitKitBinaryI64(kitBinaryI64(f), code, vals, owns, prefix)

def emitMapGetOr(code: String, vals: List[String], owns: List[Bool], prefix: String, boxKey: Bool, numeric: Bool, boxDefault: Bool, keyFloat: Bool, valueFloat: Bool): Slot =
  if (boxKey) emitMapGetOr2(join(code, pairBoxTyped(arg1(vals), true, keyFloat, prefix, "mk")), arg0(vals), pct(prefix, "mk"), arg2(vals), headOwn(owns), true, headOwn(tailOwn(tailOwn(owns))), prefix, numeric, boxDefault, valueFloat) else emitMapGetOr2(code, arg0(vals), arg1(vals), arg2(vals), headOwn(owns), headOwn(tailOwn(owns)), headOwn(tailOwn(tailOwn(owns))), prefix, numeric, boxDefault, valueFloat)

def emitMapGetOr2(code: String, m: String, k: String, d: String, om: Bool, ok: Bool, od: Bool, prefix: String, numeric: Bool, boxDefault: Bool, valueFloat: Bool): Slot =
  if (numeric) emitMapGetOrNum(code, m, k, d, om, ok, od, prefix, boxDefault, valueFloat) else emitMapGetOrPtr(code, m, k, d, om, ok, od, prefix)

def emitMapGetOrPtr(code: String, m: String, k: String, d: String, om: Bool, ok: Bool, od: Bool, prefix: String): Slot =
  Slot(join(code, join(kitGetOrCall(m, k, d, prefix), join(if (ok) relPtr(k) else "", getOrAfter(m, d, om, od, pct(prefix, "p"))))), pct(prefix, "p"), om || od)

def emitMapGetOrNum(code: String, m: String, k: String, d: String, om: Bool, ok: Bool, od: Bool, prefix: String, boxDefault: Bool, valueFloat: Bool): Slot =
  if (boxDefault) emitUnboxSlot(emitMapGetOrPtr(join(code, pairBoxTyped(d, true, valueFloat, prefix, "md")), m, k, pct(prefix, "md"), om, ok, true, prefix), prefix) else emitUnboxSlot(emitMapGetOrPtr(code, m, k, d, om, ok, od, prefix), prefix)

def kitGetOrCall(m: String, k: String, d: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "p"), Str.concat("call ptr @sz_map_get_or(ptr ", Str.concat(m, Str.concat(", ptr ", Str.concat(k, Str.concat(", ptr ", Str.concat(d, ")"))))))))

def emitClock(rt: String, code: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @", Str.concat(rt, "()"))))), pct(prefix, "v"), false)

def emitClockIso(code: String, vals: List[String], prefix: String, ps: List[Param], owns: List[Bool]): Slot =
  emitClockIso2(code, arg0(vals), prefix, ps, headOwn(owns))

def emitClockIso2(code: String, v: String, prefix: String, ps: List[Param], o: Bool): Slot =
  if (o || fromIntUnbox(v, ps) || thenIsPtr(code, v, o, ps)) emitClockIsoUnbox(code, v, prefix) else emitClockIsoI64(code, v, prefix)

def emitClockIsoI64(code: String, v: String, prefix: String): Slot =
  Slot(join(code, line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_clock_iso8601(i64 ", Str.concat(v, ")"))))), pct(prefix, "v"), true)

def emitClockIsoUnbox(code: String, v: String, prefix: String): Slot =
  emitFromIntUnbox2(join(code, join(unboxLine(v, prefix), line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_clock_iso8601(i64 ", Str.concat(pct(prefix, "u"), ")")))))), prefix)

def emitClockZone(code: String, vals: List[String], prefix: String, ps: List[Param], owns: List[Bool]): Slot =
  emitClockZone2(code, arg0(vals), arg1(vals), headOwn(owns), headOwn(tailOwn(owns)), prefix, ps)

def emitClockZone2(code: String, a: String, b: String, oa: Bool, ob: Bool, prefix: String, ps: List[Param]): Slot =
  emitClockZone3(code, a, b, zonePtr(code, a, oa, ps), zonePtr(code, b, ob, ps), prefix)

def zonePtr(code: String, v: String, o: Bool, ps: List[Param]): Bool =
  o || fromIntUnbox(v, ps) || thenIsPtr(code, v, o, ps)

def emitClockZone3(code: String, a: String, b: String, pa: Bool, pb: Bool, prefix: String): Slot =
  Slot(join(code, join(if (pa) zoneUnbox(a, prefix, "za") else "", join(if (pb) zoneUnbox(b, prefix, "zb") else "", zoneCall(if (pa) pct(prefix, "za") else a, if (pb) pct(prefix, "zb") else b, prefix)))), pct(prefix, "v"), true)

def zoneUnbox(v: String, prefix: String, name: String): String =
  line(Str.concat(tmp(prefix, name), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(v, ")"))))

def zoneCall(a: String, b: String, prefix: String): String =
  line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_clock_zone(i64 ", Str.concat(a, Str.concat(", i64 ", Str.concat(b, ")"))))))

def emitFsMkdirs(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitFsReadRt("sz_fs_mkdirs", code, vals, owns, prefix)

def emitFsReadRt(rt: String, code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitFsReadRt2(rt, code, arg0(vals), headOwn(owns), prefix)

def emitFsReadRt2(rt: String, code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(kitCallPtr1(rt, v, prefix), if (o) relPtr(v) else "")), pct(prefix, "v"), false)

def retPtr(p: String): String =
  line(Str.concat("call void @sz_retain(ptr ", Str.concat(p, ")")))

def takePtr(v: String, o: Bool, prefix: String): String =
  if (o) join(retPtr(pct(prefix, "v")), relPtr(v)) else ""

def hasEn(ens: List[En], name: String): Bool =
  if (List.isEmpty(ens)) false else hasEnHead(List.at(ens, 0), List.tail(ens), name)

def hasEnHead(h: En, rest: List[En], name: String): Bool =
  h match {
    case En(_, n, _, _) => if (n == name) true else hasEn(rest, name)
  }

def enHasCase(ens: List[En], en: String, name: String): Bool =
  if (List.isEmpty(ens)) false else enHasCaseH(List.at(ens, 0), List.tail(ens), en, name)

def enHasCaseH(h: En, rest: List[En], en: String, name: String): Bool =
  h match {
    case En(_, n, _, cases) => n == en && hasCase(cases, name) || enHasCase(rest, en, name)
  }

def isCtorName(f: String): Bool =
  Str.len(f) > 0 && Str.charAt(f, 0) >= 65 && Str.charAt(f, 0) <= 90 && !hasSub(f, ".")

def isQualCtor(f: String, ens: List[En]): Bool =
  qualName(f) != "" && (hasEn(ens, qualEn(f)) || qualEn(f) == "Json" || qualEn(f) == "Result" || qualEn(f) == "Option")

def qualEn(f: String): String =
  if (dotAt(f, 0) < 0) "" else Str.slice(f, 0, dotAt(f, 0))

def qualName(f: String): String =
  if (dotAt(f, 0) < 0) "" else Str.slice(f, dotAt(f, 0) + 1, Str.len(f))

def emitAt(code: String, vals: List[String], owns: List[Bool], prefix: String, args: List[Expr], ps: List[Param], defs: Ftab, ens: List[En], mod: String): Slot =
  emitAt2(code, arg0(vals), arg1(vals), headOwn(owns), prefix, headUnbox(args, ps) || isI64Ty(exprRetTyEns(Expr.ECall("List.at", args, 0), defs, ens, ps, mod)))

def emitAt2(code: String, v: String, i: String, o: Bool, prefix: String, unbox: Bool): Slot =
  if (unbox) emitAtInt(code, v, i, o, prefix) else emitAtPtr(code, v, i, o, prefix)

def emitAtInt(code: String, v: String, i: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_at(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(i, ")")))))), join(takePtr(v, o, prefix), join(line(Str.concat(tmp(prefix, "u"), Str.concat("call i64 @sz_unbox_i64(ptr ", Str.concat(pct(prefix, "v"), ")")))), if (o) relPtr(pct(prefix, "v")) else "")))), pct(prefix, "u"), false)

def emitAtPtr(code: String, v: String, i: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_at(ptr ", Str.concat(v, Str.concat(", i64 ", Str.concat(i, ")")))))), takePtr(v, o, prefix))), pct(prefix, "v"), o)

def emitRec(en: String, code: String, vals: List[String], owns: List[Bool], prefix: String, ens: List[En], args: List[Expr], ps: List[Param], defs: Ftab, mod: String): Slot =
  if (List.isEmpty(vals)) emitCtor(recEn(en, ens), en, prefix, ens) else if (List.len(vals) == 1) emitPayloadCtorN(recEn(en, ens), en, (code, vals, owns), args, prefix, ens, ps, defs, mod) else emitRecJoin(code, emitPack(vals, owns, args, prefix, 0, List.len(vals), ps, defs, ens, mod), en, prefix, ens)

def emitRecJoin(code: String, pack: Slot, en: String, prefix: String, ens: List[En]): Slot =
  pack match {
    case Slot(pc, pv, _) => emitRec2(join(code, pc), pv, en, prefix, ens)
  }

def emitRec2(pc: String, pv: String, en: String, prefix: String, ens: List[En]): Slot =
  Slot(join(pc, join(emitAdtNew(prefix, ctorTag(ens, recEn(en, ens), en), pv), relPtr(pv))), pct(prefix, "adt"), true)

def recEn(en: String, ens: List[En]): String =
  if (hasEn(ens, en)) en else enOfCase(ens, en)

def emitPack(vals: List[String], owns: List[Bool], args: List[Expr], prefix: String, i: Int, n: Int, ps: List[Param], defs: Ftab, ens: List[En], mod: String): Slot =
  if (List.isEmpty(vals)) Slot(line(Str.concat(tmp(prefix, "pl0"), "call ptr @sz_list_nil()")), pct(prefix, "pl0"), true) else emitPack1(List.at(vals, 0), headOwn(owns), if (List.isEmpty(args)) "" else Check.typeOfEns(List.at(args, 0), defs, ens, ps, mod), emitPack(List.tail(vals), List.tail(owns), if (List.isEmpty(args)) args else List.tail(args), prefix, i + 1, n, ps, defs, ens, mod), prefix, i, n)

def emitPack1(v: String, o: Bool, ty: String, rest: Slot, prefix: String, i: Int, n: Int): Slot =
  rest match {
    case Slot(rc, rp, _) => emitPack2(rc, rp, v, o, ty, prefix, i, n)
  }

def emitPack2(rc: String, rp: String, v: String, o: Bool, ty: String, prefix: String, i: Int, n: Int): Slot =
  Slot(join(rc, join(packBox(v, ty, prefix, i), join(packCons(prefix, i, n, packPtr(v, isI64Ty(ty), prefix, i), rp), join(relPtr(rp), packDrop(v, o, isI64Ty(ty), prefix, i))))), pct(prefix, Str.concat("pl", Str.fromInt(n - i))), true)

def packBox(v: String, ty: String, prefix: String, i: Int): String =
  if (isI64Ty(ty)) boxScalarStem(v, ty, prefix, Str.concat("bx", Str.fromInt(i))) else ""

def packPtr(v: String, num: Bool, prefix: String, i: Int): String =
  if (num) pct(prefix, Str.concat("bx", Str.fromInt(i))) else v

def packCons(prefix: String, i: Int, n: Int, hd: String, tl: String): String =
  line(Str.concat(tmp(prefix, Str.concat("pl", Str.fromInt(n - i))), Str.concat("call ptr @sz_list_cons(ptr ", Str.concat(hd, Str.concat(", ptr ", Str.concat(tl, ")"))))))

def packDrop(v: String, o: Bool, num: Bool, prefix: String, i: Int): String =
  if (num) relPtr(pct(prefix, Str.concat("bx", Str.fromInt(i)))) else if (o) relPtr(v) else ""

def emitListHead(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListHeadPtr(code, arg0(vals), headOwn(owns), prefix)

def headUnbox(args: List[Expr], ps: List[Param]): Bool =
  if (List.isEmpty(args)) false else headUnbox1(List.at(args, 0), ps)

def headUnbox1(e: Expr, ps: List[Param]): Bool =
  e match {
    case Expr.EList(xs) => headUnboxList(xs)
    case Expr.EVar(s, _) => isI64ListTy(paramTy(ps, s))
    case _ => false
  }

def isI64ListTy(ty: String): Bool =
  ty == "List[Bool]" || ty == "List[Int]" || ty == "List"

def headUnboxList(xs: List[Expr]): Bool =
  if (List.isEmpty(xs)) true else headIsInt(xs)

def headIsInt(xs: List[Expr]): Bool =
  List.at(xs, 0) match {
    case Expr.EInt(_, _) => true
    case _ => false
  }

def emitListHeadPtr(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_head_opt(ptr ", Str.concat(v, ")")))), if (o) relPtr(v) else "")), pct(prefix, "v"), true)

def emitListTail(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListTail2(code, arg0(vals), headOwn(owns), prefix)

def emitListTail2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "v"), Str.concat("call ptr @sz_list_tail(ptr ", Str.concat(v, ")")))), takePtr(v, o, prefix))), pct(prefix, "v"), o)

def emitListEmpty(code: String, vals: List[String], owns: List[Bool], prefix: String): Slot =
  emitListEmpty2(code, arg0(vals), headOwn(owns), prefix)

def emitListEmpty2(code: String, v: String, o: Bool, prefix: String): Slot =
  Slot(join(code, join(line(Str.concat(tmp(prefix, "i"), Str.concat("call i32 @sz_list_is_empty(ptr ", Str.concat(v, ")")))), join(line(Str.concat(tmp(prefix, "v"), Str.concat("zext i32 ", Str.concat(pct(prefix, "i"), " to i64")))), if (o) relPtr(v) else ""))), pct(prefix, "v"), false)

