def find(f: String): Kit =
  findGo(lookupKits(f), f)

def lookupKits(f: String): List[Kit] =
  if (Str.startsWith(f, "Str.")) strKits() else if (Str.startsWith(f, "List.")) listKits() else if (Str.startsWith(f, "Map.") || Str.startsWith(f, "Set.")) mapSetKits() else if (Str.startsWith(f, "Fs.") || Str.startsWith(f, "Sys.") || Str.startsWith(f, "Impurity.")) fsSysKits() else if (Str.startsWith(f, "Json.") || Str.startsWith(f, "Net.")) jsonNetKits() else lookupEffectKits(f)

def lookupEffectKits(f: String): List[Kit] =
  if (Str.startsWith(f, "Signal.") || Str.startsWith(f, "Ui.") || Str.startsWith(f, "Color.") || Str.startsWith(f, "Theme.")) uiKits() else if (Str.startsWith(f, "View.")) viewKits() else if (Str.startsWith(f, "Property.") || Str.startsWith(f, "Timeline.") || Str.startsWith(f, "Verdict.")) extraKits() else if (Str.startsWith(f, "Stream.")) streamKits() else if (Str.startsWith(f, "IO.") || Str.startsWith(f, "Builder.") || Str.startsWith(f, "Clock.") || Str.startsWith(f, "Deferred.") || Str.startsWith(f, "Fiber.") || Str.startsWith(f, "Float.") || Str.startsWith(f, "Oracle.") || Str.startsWith(f, "Queue.") || Str.startsWith(f, "Random.") || Str.startsWith(f, "Ref.") || Str.startsWith(f, "Resource.")) ioKits() else nsKit()

def findGo(xs: List[Kit], f: String): Kit =
  if (List.isEmpty(xs)) miss() else findHd(List.at(xs, 0), List.tail(xs), f)

def findHd(h: Kit, rest: List[Kit], f: String): Kit =
  h match {
    case Kit(n, _, _, _, _) => if (n == f) h else findGo(rest, f)
  }

def kitName(kit: Kit): String =
  kit match {
    case Kit(n, _, _, _, _) => n
  }

def kitParamsOf(kit: Kit): List[String] =
  kit match {
    case Kit(_, ps, _, _, _) => ps
  }

def kitRetOf(kit: Kit): String =
  kit match {
    case Kit(_, _, r, _, _) => r
  }

def kitRestOf(kit: Kit): String =
  kit match {
    case Kit(_, _, _, r, _) => r
  }

def kitOptOf(kit: Kit): Int =
  kit match {
    case Kit(_, _, _, _, o) => o
  }

def has(f: String): Bool =
  kitName(find(f)) != ""

def params(f: String): List[String] =
  kitParamsOf(find(f))

def ret(f: String): String =
  kitRetOf(find(f))

def rest(f: String): String =
  kitRestOf(find(f))

def opt(f: String): Int =
  kitOptOf(find(f))

def names(): List[String] =
  namesOf(allKits())

def namesOf(xs: List[Kit]): List[String] =
  if (List.isEmpty(xs)) [] else namesOfHd(List.at(xs, 0), List.tail(xs))

def namesOfHd(h: Kit, rest: List[Kit]): List[String] =
  kitName(h) :: namesOf(rest)

def want(f: String, n: Int): List[String] =
  wantOf(find(f), n)

def wantOf(kit: Kit, n: Int): List[String] =
  wantOf2(kitName(kit), kitParamsOf(kit), kitRestOf(kit), kitOptOf(kit), n)

def wantOf2(name: String, ps: List[String], r: String, o: Int, n: Int): List[String] =
  if (name == "") ns() else if (r != "") wantRest(ps, r, n) else wantOpt(ps, o, n)

def wantRest(ps: List[String], r: String, n: Int): List[String] =
  if (n < List.len(ps)) ns() else List.concat(ps, fill(r, n - List.len(ps)))

def wantOpt(ps: List[String], o: Int, n: Int): List[String] =
  if (n < List.len(ps) - o || n > List.len(ps)) ns() else take(ps, n)

def fill(t: String, n: Int): List[String] =
  if (n <= 0) ns() else t :: fill(t, n - 1)

def take(xs: List[String], n: Int): List[String] =
  if (n <= 0 || List.isEmpty(xs)) ns() else List.at(xs, 0) :: take(List.tail(xs), n - 1)

def arityOk(f: String, n: Int): Bool =
  arityOf(find(f), n)

def arityOf(kit: Kit, n: Int): Bool =
  arityOf2(kitName(kit), kitParamsOf(kit), kitRestOf(kit), kitOptOf(kit), n)

def arityOf2(name: String, ps: List[String], r: String, o: Int, n: Int): Bool =
  if (name == "") false else if (r != "") n >= List.len(ps) else n >= List.len(ps) - o && n <= List.len(ps)

def anyCount(): Int =
  anyCountGo(allKits())

def anyCountGo(xs: List[Kit]): Int =
  if (List.isEmpty(xs)) 0 else anyCountKit(List.at(xs, 0)) + anyCountGo(List.tail(xs))

def anyCountKit(kit: Kit): Int =
  countAnyStr(kitRetOf(kit)) + countAnyStr(kitRestOf(kit)) + anyCountParams(kitParamsOf(kit))

def anyCountParams(ps: List[String]): Int =
  if (List.isEmpty(ps)) 0 else countAnyStr(List.at(ps, 0)) + anyCountParams(List.tail(ps))

def catalogMd(): String =
  Str.concat("""# Kit catalog

Signatures live in `examples/compiler/src/Kits.scuzz`.

| Kit | Params | Return |
| --- | --- | --- |
""", catalogRows(allKits()))

def catalogRows(xs: List[Kit]): String =
  if (List.isEmpty(xs)) "" else Str.concat(catalogRow(List.at(xs, 0)), catalogRows(List.tail(xs)))

def catalogRow(kit: Kit): String =
  Str.concat("| `", Str.concat(kitName(kit), Str.concat("` | `", Str.concat(showParams(kit), Str.concat("` | `", Str.concat(kitRetOf(kit), """` |
"""))))))

def showParams(kit: Kit): String =
  showParams2(kitParamsOf(kit), kitRestOf(kit), kitOptOf(kit))

def showParams2(ps: List[String], r: String, o: Int): String =
  if (r != "") showRest(ps, r) else if (List.isEmpty(ps)) "()" else joinComma(ps)

def showRest(ps: List[String], r: String): String =
  if (List.isEmpty(ps)) Str.concat(r, "*") else Str.concat(joinComma(ps), Str.concat(", ", Str.concat(r, "*")))

def joinComma(ps: List[String]): String =
  if (List.isEmpty(ps)) "" else if (List.isEmpty(List.tail(ps))) List.at(ps, 0) else Str.concat(List.at(ps, 0), Str.concat(", ", joinComma(List.tail(ps))))

