record Build(ok: Bool, ir: String, diags: String)

record PkgOut(ok: Bool, name: String, ll: String, llPath: String, link: String, diags: String)

record FuzzRun(path: String, src: String, script: String, sched: String, fault: String)

record FuzzAcc(fail: Int, corpFail: Int, repro: String)

record FuzzMut(killed: Int, survived: Int, inert: Int, ran: Int, sites: Int)

record FuzzJob(dir: String, outDir: String, exe: String, name: String, hasUi: Bool, iterations: Int, seed: Int, noFailFast: Bool, files: List[(String, String)], oracles: Bool)

import Manifest.Man
import Parse.En

def compileSrc(src: String): Build =
  compileSrc2(Check.check(src), src)

def compileSrc2(diags: String, src: String): Build =
  if (diags == "[]") Build(true, Emit.emit(src), diags) else Build(false, "", diags)

def joinSlash(a: String, b: String): String =
  if (a == "") b else if (Str.charAt(a, Str.len(a) - 1) == 47) Str.concat(a, b) else Str.concat(a, Str.concat("/", b))

def llName(outDir: String, name: String): String =
  joinSlash(outDir, Str.concat(name, ".ll"))

def exeName(outDir: String, name: String): String =
  joinSlash(outDir, name)

def linkLine(clang: String, ll: String, lib: String, exe: String): String =
  Str.concat(clang, Str.concat(" -O0 -Wno-override-module ", Str.concat(ll, Str.concat(" ", Str.concat(lib, Str.concat(" -lpthread -lssl -lcrypto -o ", exe))))))

def crateHome(): IO[String] =
  Sys.getenv("SCUZZ_HOME").map(h => joinSlash(h, "."))

def crateAt(h: String, rel: String): String =
  joinSlash(h, rel)

def skiaLib(h: String): String =
  crateAt(h, "crates/ffi-skia/build/libsk_capi.a")

def deskLib(h: String): String =
  crateAt(h, "crates/embedder-desktop/build/libscuzz_embedder.a")

def mobLib(h: String): String =
  crateAt(h, "crates/embedder-mobile/build/libscuzz_mobile.a")

def uiFlags1(mac: Bool): String =
  if (mac) " -lc++ -lm -lz -lbz2 -framework CoreFoundation -framework CoreGraphics -framework CoreText -framework Foundation -framework Carbon " else " -lstdc++ -lm -lz -lbz2 -Wl,--whole-archive "

def uiFlags2(mac: Bool): String =
  if (mac) " -framework Cocoa -lobjc " else " -Wl,--no-whole-archive -lX11 -Wl,--whole-archive "

def uiFlags3(gpu: Bool, mac: Bool): String =
  if (mac) Str.concat(if (gpu) gpuLibs(mac) else "", " -L/opt/homebrew/opt/openssl@3/lib -L/usr/local/opt/openssl@3/lib -lpthread -lssl -lcrypto -o ") else Str.concat(" -Wl,--no-whole-archive", Str.concat(if (gpu) gpuLibs(mac) else "", " -lpthread -lssl -lcrypto -rdynamic -o "))

def gpuLibs(mac: Bool): String =
  if (mac) " -framework OpenGL" else " -lEGL -lGLESv2"

def forceLoad(mac: Bool, lib: String): String =
  if (mac) Str.concat("-Wl,-force_load,", lib) else lib

def linkGpu(h: String): IO[Bool] =
  Fs.read(crateAt(h, "crates/ffi-skia/build/sk_capi_backend")).map(s => Str.trim(s) == "gpu").handleErrorWith(_ => IO.pure(false))

def linkLineUi(clang: String, ll: String, lib: String, exe: String, h: String, gpu: Bool, mac: Bool): String =
  Str.concat(clang, Str.concat(" -O0 -Wno-override-module ", Str.concat(ll, Str.concat(" ", Str.concat(lib, Str.concat(" ", Str.concat(skiaLib(h), Str.concat(uiFlags1(mac), Str.concat(forceLoad(mac, deskLib(h)), Str.concat(uiFlags2(mac), Str.concat(forceLoad(mac, mobLib(h)), Str.concat(uiFlags3(gpu, mac), exe))))))))))))

def hostMac(): IO[Bool] =
  Sys.exec("uname -s").map(r => Str.trim(r._2) == "Darwin")

def linkLineMac(clang: String, ll: String, lib: String, exe: String): String =
  Str.concat(clang, Str.concat(" -O0 -Wno-override-module ", Str.concat(ll, Str.concat(" ", Str.concat(lib, Str.concat(" -framework CoreFoundation -L/opt/homebrew/opt/openssl@3/lib -L/usr/local/opt/openssl@3/lib -lpthread -lssl -lcrypto -o ", exe))))))

def linkLineHost(hasUi: Bool, mac: Bool, clang: String, ll: String, lib: String, exe: String, h: String, gpu: Bool): String =
  if (hasUi) linkLineUi(clang, ll, lib, exe, h, gpu, mac) else if (mac) linkLineMac(clang, ll, lib, exe) else linkLine(clang, ll, lib, exe)

def runLinkLine(hasUi: Bool, dir: String, name: String): IO[(Int, String, String)] =
  crateHome().flatMap(h => ensureRtMade(h).flatMap(_ => runLinkHost(hasUi, dir, name, h)))

def runLinkHost(hasUi: Bool, dir: String, name: String, h: String): IO[(Int, String, String)] =
  hostMac().flatMap(mac => runLinkGpu(hasUi, dir, name, h, mac))

def runLinkGpu(hasUi: Bool, dir: String, name: String, h: String, mac: Bool): IO[(Int, String, String)] =
  linkGpu(h).flatMap(gpu => runLinkGot(hasUi, dir, name, h, mac, gpu))

def runLinkGot(hasUi: Bool, dir: String, name: String, h: String, mac: Bool, gpu: Bool): IO[(Int, String, String)] =
  runLine(linkLineHost(hasUi, mac, "clang", llName(dir, name), rtLib(h), exeName(dir, name), h, gpu))

def ensureRtMade(h: String): IO[Unit] =
  runLine(Str.concat("make -C ", Str.concat(crateAt(h, "crates/runtime"), " lib CC=clang"))).flatMap(r => ensureRtGot(r))

def ensureRtGot(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) IO.println(err).flatMap(_ => IO.fail("runtime")) else IO.pure(())
  }

def missToml(dir: String): String =
  Str.concat("missing scuzz.toml in ", dir)

def showMan(m: Man): String =
  if (!m.ok) Str.concat("err:", m.err) else Str.concat("name=", Str.concat(m.name, Str.concat(" ver=", Str.concat(m.version, Str.concat(" ui=", Str.concat(if (m.hasUi) "true" else "false", Str.concat(" deps=", Str.fromInt(List.len(m.deps)))))))))

def compilePkg(toml: String, src: String, outDir: String, clang: String, lib: String): PkgOut =
  compilePkg2(Manifest.parse(toml), src, outDir, clang, lib)

def compilePkg2(m: Man, src: String, outDir: String, clang: String, lib: String): PkgOut =
  if (!m.ok) PkgOut(false, "", "", "", "", m.err) else compilePkg3(m, src, compileSrc(src), outDir, clang, lib)

def compilePkg3(m: Man, src: String, b: Build, outDir: String, clang: String, lib: String): PkgOut =
  if (!b.ok) PkgOut(false, m.name, "", "", "", b.diags) else compilePkg4(m, src, outDir, clang, lib)

def compilePkg4(m: Man, src: String, outDir: String, clang: String, lib: String): PkgOut =
  PkgOut(true, m.name, Emit.emitFull(src), llName(outDir, m.name), linkLine(clang, llName(outDir, m.name), lib, exeName(outDir, m.name)), "[]")

def compileFiles(toml: String, files: List[(String, String)], outDir: String, clang: String, lib: String): PkgOut =
  compileFiles2(Manifest.parse(toml), files, outDir, clang, lib)

def compileFiles2(m: Man, files: List[(String, String)], outDir: String, clang: String, lib: String): PkgOut =
  if (!m.ok) PkgOut(false, "", "", "", "", m.err) else compileFiles3(m, Emit.emitFullFiles(files), outDir, clang, lib)

def compileFiles3(m: Man, ll: String, outDir: String, clang: String, lib: String): PkgOut =
  PkgOut(true, m.name, ll, llName(outDir, m.name), linkLine(clang, llName(outDir, m.name), lib, exeName(outDir, m.name)), "[]")

def rtLib(h: String): String =
  crateAt(h, "crates/runtime/build/libscuzz_rt.a")

def isScuzz(name: String): Bool =
  Str.len(name) > 6 && Str.slice(name, Str.len(name) - 6, Str.len(name)) == ".scuzz"

def stemOf(name: String): String =
  Str.slice(name, 0, Str.len(name) - 6)

def emitDir(dir: String, outDir: String, full: Bool): IO[Unit] =
  if (full) emitDirBump(dir, outDir) else emitDirLive(dir, outDir)

def emitDirBump(dir: String, outDir: String): IO[Unit] =
  Fs.mkdirs(joinSlash(dir, ".scuzz")).flatMap(_ => Fs.write(fpPath(dir), "").flatMap(_ => emitDirLive(dir, outDir)))

def emitDirLive(dir: String, outDir: String): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => emitDirMan(dir, outDir, Manifest.parse(toml)))

def emitDirMan(dir: String, outDir: String, m: Man): IO[Unit] =
  m match {
    case Man(ok, name, version, hasUi, deps, err) => emitDirMan2(dir, outDir, ok, err, deps)
  }

def emitDirMan2(dir: String, outDir: String, ok: Bool, err: String, deps: List[(String, String)]): IO[Unit] =
  if (!ok) IO.println(Str.concat("fail:", err)) else Fs.list(joinSlash(dir, "src")).flatMap(ents => emitDirListed(dir, outDir, deps, ents))

def emitDirListed(dir: String, outDir: String, deps: List[(String, String)], ents: List[(String, Bool)]): IO[Unit] =
  readSrcFiles(joinSlash(dir, "src"), ents).flatMap(own => emitDirCollected(dir, outDir, deps, own))

def emitDirCollected(dir: String, outDir: String, deps: List[(String, String)], own: List[(String, String)]): IO[Unit] =
  collectDeps(dir, deps, own).flatMap(files => emitDirReady(dir, outDir, files))

def emitDirReady(dir: String, outDir: String, files: List[(String, String)]): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => emitDirHit(dir, outDir, files, toml, fpText(toml, files)))

def fpPath(dir: String): String =
  joinSlash(joinSlash(dir, ".scuzz"), "fingerprint")

def fpText(toml: String, files: List[(String, String)]): String =
  Str.concat(toml, fpFiles(files))

def fpFiles(files: List[(String, String)]): String =
  Builder.result(fpFilesAt(files, Builder.empty()))

def fpNl(): String =
  """
"""

def fpFilesAt(files: List[(String, String)], b: Builder): Builder =
  if (List.isEmpty(files)) b else fpFilesHd(List.at(files, 0), List.tail(files), b)

def fpFilesHd(h: (String, String), rest: List[(String, String)], b: Builder): Builder =
  h match {
    case (stem, src) => fpFilesAt(rest, Builder.append(Builder.append(Builder.append(Builder.append(b, stem), fpNl()), src), fpNl()))
  }

def emitDirHit(dir: String, outDir: String, files: List[(String, String)], toml: String, fp: String): IO[Unit] =
  Fs.read(fpPath(dir)).flatMap(old => emitDirHitGot(dir, outDir, files, toml, fp, old)).handleErrorWith(_ => emitDirFresh(dir, outDir, files, toml, fp))

def emitDirHitGot(dir: String, outDir: String, files: List[(String, String)], toml: String, fp: String, old: String): IO[Unit] =
  if (old == fp) emitDirHitArt(dir, outDir, files, toml, fp) else emitDirFresh(dir, outDir, files, toml, fp)

def emitDirHitArt(dir: String, outDir: String, files: List[(String, String)], toml: String, fp: String): IO[Unit] =
  emitDirHitArtMan(dir, outDir, files, toml, fp, Manifest.parse(toml))

def emitDirHitArtMan(dir: String, outDir: String, files: List[(String, String)], toml: String, fp: String, m: Man): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)) else Fs.exists(llName(outDir, m.name)).flatMap(hit => if (hit) emitDirUp(outDir, toml) else emitDirFresh(dir, outDir, files, toml, fp))

def emitDirUp(outDir: String, toml: String): IO[Unit] =
  emitDirUpMan(outDir, Manifest.parse(toml))

def emitDirUpMan(outDir: String, m: Man): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)) else IO.println(Str.concat("up-to-date ", exeName(outDir, m.name)))

def emitDirFresh(dir: String, outDir: String, files: List[(String, String)], toml: String, fp: String): IO[Unit] =
  crateHome().flatMap(h => emitDirOut(compileFiles(toml, files, outDir, "clang", rtLib(h))).flatMap(ok => emitDirStored(dir, fp, ok)))

def emitDirStored(dir: String, fp: String, ok: Bool): IO[Unit] =
  if (!ok) IO.pure(()) else Fs.mkdirs(joinSlash(dir, ".scuzz")).flatMap(_ => Fs.write(fpPath(dir), fp))

def emitDirAlways(dir: String, outDir: String, own: List[(String, String)]): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => emitDirAlwaysGot(toml, own, outDir))

def emitDirAlwaysGot(toml: String, own: List[(String, String)], outDir: String): IO[Unit] =
  crateHome().flatMap(h => emitDirOut(compileFiles(toml, own, outDir, "clang", rtLib(h))).flatMap(_ => IO.pure(())))

def fuzzCollect(dir: String): IO[List[(String, String)]] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => fuzzCollectMan(dir, Manifest.parse(toml)))

def fuzzCollectMan(dir: String, m: Man): IO[List[(String, String)]] =
  m match {
    case Man(ok, _name, _version, _hasUi, deps, err) => fuzzCollectMan2(dir, ok, err, deps)
  }

def fuzzCollectMan2(dir: String, ok: Bool, err: String, deps: List[(String, String)]): IO[List[(String, String)]] =
  if (!ok) IO.println(Str.concat("fail:", err)).flatMap(_ => IO.pure(Manifest.noPairs())) else Fs.list(joinSlash(dir, "src")).flatMap(ents => fuzzCollectListed(dir, deps, ents))

def fuzzCollectListed(dir: String, deps: List[(String, String)], ents: List[(String, Bool)]): IO[List[(String, String)]] =
  readSrcFiles(joinSlash(dir, "src"), ents).flatMap(own => collectDeps(dir, deps, own).flatMap(files => fuzzSimFiles(dir, deps, files).flatMap(simmed => fuzzReadDrv(joinSlash(dir, "src")).flatMap(drv => fuzzCollectVer(dir, simmed, drv)))))

def fuzzSimFiles(dir: String, deps: List[(String, String)], files: List[(String, String)]): IO[List[(String, String)]] =
  if (List.isEmpty(files)) IO.pure(files) else fuzzSimHd(dir, deps, List.at(files, 0), List.tail(files))

def fuzzSimHd(dir: String, deps: List[(String, String)], h: (String, String), rest: List[(String, String)]): IO[List[(String, String)]] =
  h match {
    case (stem, src) => fuzzSimPair(dir, deps, stem, src, rest)
  }

def fuzzSimPair(dir: String, deps: List[(String, String)], stem: String, src: String, rest: List[(String, String)]): IO[List[(String, String)]] =
  fuzzSimOne(dir, deps, stem, src).flatMap(got => fuzzSimFiles(dir, deps, rest).flatMap(more => IO.pure((stem, got) :: more)))

def fuzzSimOne(dir: String, deps: List[(String, String)], stem: String, src: String): IO[String] =
  fuzzSimPath(joinSlash(joinSlash(dir, "src"), Str.concat(stem, ".scuzz_sim")), src).handleErrorWith(_ => fuzzSimDeps(dir, deps, stem, src))

def fuzzSimPath(path: String, src: String): IO[String] =
  Fs.read(path).map(sim => Verify.applySim(src, sim))

def fuzzSimDeps(dir: String, deps: List[(String, String)], stem: String, src: String): IO[String] =
  if (List.isEmpty(deps)) IO.pure(src) else fuzzSimDepHd(dir, List.at(deps, 0), List.tail(deps), stem, src)

def fuzzSimDepHd(dir: String, d: (String, String), rest: List[(String, String)], stem: String, src: String): IO[String] =
  d match {
    case (_name, path) => fuzzSimPath(joinSlash(joinSlash(joinSlash(dir, path), "src"), Str.concat(stem, ".scuzz_sim")), src).handleErrorWith(_ => fuzzSimDeps(dir, rest, stem, src))
  }

def fuzzReadDrv(srcDir: String): IO[String] =
  Fs.list(srcDir).flatMap(ents => fuzzDrvGo(srcDir, ents, "")).handleErrorWith(_ => IO.pure(""))

def fuzzDrvGo(srcDir: String, ents: List[(String, Bool)], acc: String): IO[String] =
  if (List.isEmpty(ents)) IO.pure(acc) else fuzzDrvHd(srcDir, List.at(ents, 0), List.tail(ents), acc)

def fuzzDrvHd(srcDir: String, ent: (String, Bool), rest: List[(String, Bool)], acc: String): IO[String] =
  ent match {
    case (name, isDir) => fuzzDrvPick(srcDir, name, isDir, rest, acc)
  }

def fuzzDrvPick(srcDir: String, name: String, isDir: Bool, rest: List[(String, Bool)], acc: String): IO[String] =
  if (isDir || !isDrivers(name)) fuzzDrvGo(srcDir, rest, acc) else Fs.read(joinSlash(srcDir, name)).flatMap(src => fuzzDrvGo(srcDir, rest, Str.concat(acc, src)))

def isDrivers(name: String): Bool =
  Str.len(name) > 14 && Str.slice(name, Str.len(name) - 14, Str.len(name)) == ".scuzz_drivers"

def fuzzCollectVer(dir: String, files: List[(String, String)], drv: String): IO[List[(String, String)]] =
  Fs.list(dir).flatMap(ents => emitFuzzVerGo(dir, files, drv, ents, Manifest.noPairs()))

def emitFuzzVerGo(dir: String, files: List[(String, String)], drv: String, ents: List[(String, Bool)], ver: List[(String, String)]): IO[List[(String, String)]] =
  if (List.isEmpty(ents)) IO.pure(fuzzFiles(files, ver, drv)) else emitFuzzVerHd(dir, files, drv, List.at(ents, 0), List.tail(ents), ver)

def emitFuzzVerHd(dir: String, files: List[(String, String)], drv: String, ent: (String, Bool), rest: List[(String, Bool)], ver: List[(String, String)]): IO[List[(String, String)]] =
  ent match {
    case (name, isDir) => emitFuzzVerPick(dir, files, drv, name, isDir, rest, ver)
  }

def emitFuzzVerPick(dir: String, files: List[(String, String)], drv: String, name: String, isDir: Bool, rest: List[(String, Bool)], ver: List[(String, String)]): IO[List[(String, String)]] =
  if (isDir || !isVerify(name)) emitFuzzVerGo(dir, files, drv, rest, ver) else Fs.read(joinSlash(dir, name)).flatMap(src => emitFuzzVerGo(dir, files, drv, rest, (stemVerify(name), src) :: ver))

def stemVerify(name: String): String =
  Str.slice(name, 0, Str.len(name) - 13)

def fuzzFiles(files: List[(String, String)], ver: List[(String, String)], drv: String): List[(String, String)] =
  List.concat(Verify.rewriteReqFiles(files), fuzzWrap(ver, drv))

def fuzzWrap(ver: List[(String, String)], drv: String): List[(String, String)] =
  fuzzWrapGot(Str.concat(Verify.wrapFiles(ver), drv))

def fuzzWrapGot(src: String): List[(String, String)] =
  if (src == "") Manifest.noPairs() else (Verify.wrapMod(), src) :: Manifest.noPairs()

def collectDeps(dir: String, deps: List[(String, String)], acc: List[(String, String)]): IO[List[(String, String)]] =
  if (List.isEmpty(deps)) IO.pure(acc) else collectDepGo(dir, deps, acc)

def collectDepGo(dir: String, deps: List[(String, String)], acc: List[(String, String)]): IO[List[(String, String)]] =
  collectDepHead(dir, List.at(deps, 0), deps, acc)

def collectDepHead(dir: String, d: (String, String), deps: List[(String, String)], acc: List[(String, String)]): IO[List[(String, String)]] =
  collectDep(dir, d, List.tail(deps), acc)

def collectDep(dir: String, d: (String, String), rest: List[(String, String)], acc: List[(String, String)]): IO[List[(String, String)]] =
  d match {
    case (name, path) => collectDepNamed(dir, name, path, rest, acc)
  }

def collectDepNamed(dir: String, _name: String, path: String, rest: List[(String, String)], acc: List[(String, String)]): IO[List[(String, String)]] =
  collectPkg(joinSlash(dir, path), dir, rest, acc)

def collectPkg(pkgDir: String, parentDir: String, rest: List[(String, String)], acc: List[(String, String)]): IO[List[(String, String)]] =
  Fs.read(joinSlash(pkgDir, "scuzz.toml")).flatMap(toml => collectPkgMan(pkgDir, parentDir, rest, acc, Manifest.parse(toml)))

def collectPkgMan(pkgDir: String, parentDir: String, rest: List[(String, String)], acc: List[(String, String)], m: Man): IO[List[(String, String)]] =
  m match {
    case Man(ok, name, version, hasUi, nested, err) => collectPkgOk(pkgDir, parentDir, rest, acc, ok, nested)
  }

def collectPkgOk(pkgDir: String, parentDir: String, rest: List[(String, String)], acc: List[(String, String)], ok: Bool, nested: List[(String, String)]): IO[List[(String, String)]] =
  if (!ok) collectDeps(parentDir, rest, acc) else Fs.list(joinSlash(pkgDir, "src")).flatMap(ents => collectPkgListed(pkgDir, parentDir, rest, acc, nested, ents))

def collectPkgListed(pkgDir: String, parentDir: String, rest: List[(String, String)], acc: List[(String, String)], nested: List[(String, String)], ents: List[(String, Bool)]): IO[List[(String, String)]] =
  readSrcFiles(joinSlash(pkgDir, "src"), ents).flatMap(more => collectPkgGot(pkgDir, parentDir, rest, acc, nested, more))

def collectPkgGot(pkgDir: String, parentDir: String, rest: List[(String, String)], acc: List[(String, String)], nested: List[(String, String)], more: List[(String, String)]): IO[List[(String, String)]] =
  collectDeps(pkgDir, nested, acc).flatMap(withNested => collectAfterNested(parentDir, rest, withNested, more))

def collectAfterNested(parentDir: String, rest: List[(String, String)], withNested: List[(String, String)], more: List[(String, String)]): IO[List[(String, String)]] =
  collectDeps(parentDir, rest, appendNew(withNested, more))

def hasStem(xs: List[(String, String)], stem: String): Bool =
  hasStemAt(xs, stem, 0)

def hasStemAt(xs: List[(String, String)], stem: String, i: Int): Bool =
  hasStemAt2(xs, stem, i, List.len(xs))

def hasStemAt2(xs: List[(String, String)], stem: String, i: Int, n: Int): Bool =
  if (i >= n) false else hasStemAt3(xs, stem, i, n)

def hasStemAt3(xs: List[(String, String)], stem: String, i: Int, n: Int): Bool =
  hasStemFrom(List.at(xs, i), xs, stem, i, n)

def hasStemFrom(p: (String, String), xs: List[(String, String)], stem: String, i: Int, n: Int): Bool =
  p match {
    case (name, src) => hasStemName(name, xs, stem, i, n)
  }

def hasStemName(name: String, xs: List[(String, String)], stem: String, i: Int, n: Int): Bool =
  if (name == stem) true else hasStemAt2(xs, stem, i + 1, n)

def appendNew(acc: List[(String, String)], more: List[(String, String)]): List[(String, String)] =
  if (List.isEmpty(more)) acc else appendNewGo(acc, List.at(more, 0), more)

def appendNewGo(acc: List[(String, String)], h: (String, String), more: List[(String, String)]): List[(String, String)] =
  appendNewPick(acc, h, List.tail(more))

def appendNewPick(acc: List[(String, String)], h: (String, String), rest: List[(String, String)]): List[(String, String)] =
  h match {
    case (stem, src) => appendNewKnown(acc, stem, src, rest)
  }

def appendNewKnown(acc: List[(String, String)], stem: String, src: String, rest: List[(String, String)]): List[(String, String)] =
  if (hasStem(acc, stem)) appendNew(acc, rest) else appendNew((stem, src) :: acc, rest)

def readSrcFiles(srcDir: String, ents: List[(String, Bool)]): IO[List[(String, String)]] =
  readSrcAcc(srcDir, ents, Manifest.noPairs())

def readSrcAcc(srcDir: String, ents: List[(String, Bool)], acc: List[(String, String)]): IO[List[(String, String)]] =
  if (List.isEmpty(ents)) IO.pure(acc) else readSrcAccGo(srcDir, ents, acc)

def readSrcAccGo(srcDir: String, ents: List[(String, Bool)], acc: List[(String, String)]): IO[List[(String, String)]] =
  readSrcHd(srcDir, List.at(ents, 0), acc, ents)

def readSrcHd(srcDir: String, ent: (String, Bool), acc: List[(String, String)], ents: List[(String, Bool)]): IO[List[(String, String)]] =
  readSrcHd2(srcDir, ent, acc, List.tail(ents))

def readSrcHd2(srcDir: String, ent: (String, Bool), acc: List[(String, String)], rest: List[(String, Bool)]): IO[List[(String, String)]] =
  ent match {
    case (name, isDir) => readSrcPick(srcDir, name, isDir, rest, acc)
  }

def readSrcPick(srcDir: String, name: String, isDir: Bool, rest: List[(String, Bool)], acc: List[(String, String)]): IO[List[(String, String)]] =
  if (isDir) readSrcAcc(srcDir, rest, acc) else if (!isScuzz(name)) readSrcAcc(srcDir, rest, acc) else Fs.read(joinSlash(srcDir, name)).flatMap(src => readSrcAcc(srcDir, rest, (stemOf(name), src) :: acc))

def emitDirOut(p: PkgOut): IO[Bool] =
  p match {
    case PkgOut(ok, name, ll, llPath, link, diags) => emitDirWrite(ok, ll, llPath, diags)
  }

def emitDirWrite(ok: Bool, ll: String, llPath: String, diags: String): IO[Bool] =
  if (!ok) IO.println(Str.concat("fail:", diags)).flatMap(_ => IO.pure(false)) else Fs.write(llPath, ll).flatMap(_ => IO.println("ok").flatMap(_ => IO.pure(true)))

def runDir(dir: String, outDir: String, runEnv: String): IO[Unit] =
  emitDir(dir, outDir, false).flatMap(_ => linkRun(dir, outDir, runEnv))

def linkRun(dir: String, outDir: String, runEnv: String): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => linkRunMan(Manifest.parse(toml), outDir, runEnv))

def linkRunMan(m: Man, outDir: String, runEnv: String): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)) else linkRunUi(m.hasUi, m.name, outDir, runEnv)

def linkRunUi(hasUi: Bool, name: String, outDir: String, runEnv: String): IO[Unit] =
  if (hasUi) ensureUi().flatMap(_ => linkRunNamed(true, name, outDir, runEnv)) else linkRunNamed(false, name, outDir, runEnv)

def ensureUi(): IO[Unit] =
  crateHome().flatMap(h => runLine(Str.concat("make -C ", Str.concat(crateAt(h, "crates/ffi-skia"), " lib CC=clang"))).flatMap(r => ensureUiDesk(h, r)))

def ensureUiDesk(h: String, r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) IO.println(err) else runLine(Str.concat("make -C ", Str.concat(crateAt(h, "crates/embedder-desktop"), " lib CC=clang"))).flatMap(r2 => ensureUiMob(h, r2))
  }

def ensureUiMob(h: String, r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) IO.println(err) else runLine(Str.concat("make -C ", Str.concat(crateAt(h, "crates/embedder-mobile"), " lib CC=clang"))).flatMap(r2 => ensureUiDone(r2))
  }

def ensureUiDone(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) IO.println(err) else IO.pure(())
  }

def linkRunNamed(hasUi: Bool, name: String, outDir: String, runEnv: String): IO[Unit] =
  runLinkLine(hasUi, outDir, name).flatMap(r => afterClang(r, exeName(outDir, name), runEnv))

def runLine(cmd: String): IO[(Int, String, String)] =
  Sys.exec(cmd)

def runProbe(cmd: String): IO[(Int, String, String)] =
  runLine(Str.concat("timeout --kill-after=2s 20s env ", cmd))

def afterClang(r: (Int, String, String), exe: String, runEnv: String): IO[Unit] =
  r match {
    case (code, out, err) => afterClang2(code, out, err, exe, runEnv)
  }

def afterClang2(code: Int, _out: String, err: String, exe: String, runEnv: String): IO[Unit] =
  if (code != 0) afterClangFail(err) else afterClangRun(exe, runEnv)

def afterClangFail(err: String): IO[Unit] =
  IO.println(err).flatMap(_ => IO.fail("link"))

def afterClangRun(exe: String, runEnv: String): IO[Unit] =
  runLine(Str.concat(runEnv, exe)).flatMap(r => afterRun(r))

def afterRun(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, out, err) => afterRun2(code, out, err)
  }

def afterRun2(code: Int, out: String, err: String): IO[Unit] =
  if (code != 0) IO.println(err).flatMap(_ => IO.fail("run")) else Sys.write(out)

def testEnv(): String =
  "SCUZZ_TESTRT=1 SCUZZ_SERVE=1 SCUZZ_KIT=sealed "

def headlessEnv(): String =
  "SCUZZ_UI_RUNTIME=headless SCUZZ_UI_WIDTH=200 SCUZZ_UI_HEIGHT=120 SCUZZ_UI_SCALE=1 "

def skipSp(s: String, i: Int): Int =
  if (i >= Str.len(s)) i else if (Str.charAt(s, i) == 32 || Str.charAt(s, i) == 9 || Str.charAt(s, i) == 61 || Str.charAt(s, i) == 91 || Str.charAt(s, i) == 44) skipSp(s, i + 1) else i

def takeDigits(s: String, i: Int): String =
  takeDigits2(s, i, i)

def takeDigits2(s: String, i: Int, j: Int): String =
  if (j >= Str.len(s) || Str.charAt(s, j) < 48 || Str.charAt(s, j) > 57) Str.slice(s, i, j) else takeDigits2(s, i, j + 1)

def sizePair(toml: String): (String, String) =
  sizePairAt(toml, Str.indexOf(toml, "headless_size"))

def sizePairAt(toml: String, i: Int): (String, String) =
  if (i < 0) ("200", "120") else sizePair2(toml, skipSp(toml, i + 13))

def sizePair2(toml: String, i: Int): (String, String) =
  sizePair3(toml, takeDigits(toml, i), i)

def sizePair3(toml: String, w: String, i: Int): (String, String) =
  if (w == "") ("200", "120") else sizePair4(toml, w, skipSp(toml, i + Str.len(w)))

def sizePair4(toml: String, w: String, j: Int): (String, String) =
  sizePair5(w, takeDigits(toml, j))

def sizePair5(w: String, h: String): (String, String) =
  if (h == "") (w, "120") else (w, h)

def headlessEnvOf(toml: String): String =
  headlessEnvPair(sizePair(toml))

def headlessEnvPair(wh: (String, String)): String =
  wh match {
    case (w, h) => Str.concat("SCUZZ_UI_RUNTIME=headless SCUZZ_UI_WIDTH=", Str.concat(w, Str.concat(" SCUZZ_UI_HEIGHT=", Str.concat(h, " SCUZZ_UI_SCALE=1 "))))
  }

def tapNOf(toml: String): String =
  tapNAt(toml, Str.indexOf(toml, "tap_button"))

def tapNAt(toml: String, i: Int): String =
  if (i < 0) "" else takeDigits(toml, skipSp(toml, i + 10))

def tapNEnv(toml: String, tap: Bool): String =
  if (!tap || tapNOf(toml) == "") "" else Str.concat("SCUZZ_UI_TAP_N=", Str.concat(tapNOf(toml), " "))

def snapEnv(outDir: String): String =
  Str.concat(headlessEnv(), Str.concat("SCUZZ_SNAPSHOT_PATH=", Str.concat(joinSlash(outDir, "snapshot.png"), " ")))

def checkDir(dir: String, json: Bool): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => checkDirMan(dir, json, Manifest.parse(toml)))

def checkDirMan(dir: String, json: Bool, m: Man): IO[Unit] =
  m match {
    case Man(ok, _name, _version, _hasUi, deps, err) => checkDirMan2(dir, json, ok, err, deps)
  }

def checkDirMan2(dir: String, json: Bool, ok: Bool, err: String, deps: List[(String, String)]): IO[Unit] =
  if (!ok) IO.println(Str.concat("fail:", err)) else Fs.list(joinSlash(dir, "src")).flatMap(ents => checkDirListed(dir, json, deps, ents))

def isVerify(name: String): Bool =
  Str.len(name) > 13 && Str.slice(name, Str.len(name) - 13, Str.len(name)) == ".scuzz_verify"

def checkDirListed(dir: String, json: Bool, deps: List[(String, String)], ents: List[(String, Bool)]): IO[Unit] =
  readSrcFiles(joinSlash(dir, "src"), ents).flatMap(own => checkDirVerify(dir, json, deps, own))

def checkDirVerify(dir: String, json: Bool, deps: List[(String, String)], own: List[(String, String)]): IO[Unit] =
  Fs.list(dir).flatMap(ents => checkVerifyGo(dir, json, deps, own, ents))

def checkVerifyGo(dir: String, json: Bool, deps: List[(String, String)], own: List[(String, String)], ents: List[(String, Bool)]): IO[Unit] =
  if (List.isEmpty(ents)) collectDeps(dir, deps, own).flatMap(files => checkFmtGo(json, files, own, fileStems(own))) else checkVerifyHd(dir, json, deps, own, List.at(ents, 0), List.tail(ents))

def checkVerifyHd(dir: String, json: Bool, deps: List[(String, String)], own: List[(String, String)], ent: (String, Bool), rest: List[(String, Bool)]): IO[Unit] =
  ent match {
    case (name, isDir) => checkVerifyPick(dir, json, deps, own, name, isDir, rest)
  }

def checkVerifyPick(dir: String, json: Bool, deps: List[(String, String)], own: List[(String, String)], name: String, isDir: Bool, rest: List[(String, Bool)]): IO[Unit] =
  if (isDir || !isVerify(name)) checkVerifyGo(dir, json, deps, own, rest) else Fs.read(joinSlash(dir, name)).flatMap(src => checkVerifySrc(dir, json, deps, own, name, src, rest))

def checkVerifySrc(dir: String, json: Bool, deps: List[(String, String)], own: List[(String, String)], name: String, src: String, rest: List[(String, Bool)]): IO[Unit] =
  checkVerifyGot(dir, json, deps, own, rest, Verify.checkVerify(src, name))

def checkVerifyGot(dir: String, json: Bool, deps: List[(String, String)], own: List[(String, String)], rest: List[(String, Bool)], msg: String): IO[Unit] =
  if (msg == "scuzz check ok") checkVerifyGo(dir, json, deps, own, rest) else IO.println(msg).flatMap(_ => IO.fail("scuzz check"))

def checkFmtGo(json: Bool, all: List[(String, String)], rest: List[(String, String)], stems: List[String]): IO[Unit] =
  if (List.isEmpty(rest)) checkFmtDone(json, all, stems) else checkFmtHd(json, all, List.at(rest, 0), List.tail(rest), stems)

def checkFmtDone(json: Bool, all: List[(String, String)], stems: List[String]): IO[Unit] =
  checkFmtDone2(json, stems, sigFiles(all, stems))

def checkFmtDone2(json: Bool, stems: List[String], sigs: List[(String, String)]): IO[Unit] =
  checkDirOut(json, Check.checkFilesOwn(sigs, stems), Check.humanFilesOwn(sigs, stems), sigs)

def checkFmtHd(json: Bool, all: List[(String, String)], h: (String, String), rest: List[(String, String)], stems: List[String]): IO[Unit] =
  h match {
    case (stem, src) => checkFmtSrc(json, all, stem, src, rest, stems)
  }

def checkFmtSrc(json: Bool, all: List[(String, String)], stem: String, src: String, rest: List[(String, String)], stems: List[String]): IO[Unit] =
  if (Parse.pretty(Parse.parse(Lexer.lex(src))) == src) checkFmtGo(json, all, rest, stems) else checkFmtFail(stem)

def fileStems(files: List[(String, String)]): List[String] =
  if (List.isEmpty(files)) [] else fileStemsHd(List.at(files, 0), List.tail(files))

def fileStemsHd(h: (String, String), rest: List[(String, String)]): List[String] =
  h match {
    case (stem, _) => stem :: fileStems(rest)
  }

def sigFiles(files: List[(String, String)], stems: List[String]): List[(String, String)] =
  if (List.isEmpty(files)) Manifest.noPairs() else sigFilesHd(List.at(files, 0), List.tail(files), stems)

def sigFilesHd(h: (String, String), rest: List[(String, String)], stems: List[String]): List[(String, String)] =
  h match {
    case (stem, src) => sigPair(stem, src, stems) :: sigFiles(rest, stems)
  }

def sigPair(stem: String, src: String, stems: List[String]): (String, String) =
  if (hasFileStem(stems, stem)) (stem, src) else if (Str.len(src) > 40000) (stem, sigSrc(src)) else (stem, src)

def hasFileStem(stems: List[String], stem: String): Bool =
  if (List.isEmpty(stems)) false else if (List.at(stems, 0) == stem) true else hasFileStem(List.tail(stems), stem)

def sigSrc(src: String): String =
  sigLines(Str.split(src, """
"""), 0, 0, Builder.empty())

def sigLines(lines: List[String], mode: Int, depth: Int, b: Builder): String =
  if (List.isEmpty(lines)) Builder.result(b) else sigLine(List.at(lines, 0), List.tail(lines), mode, depth, b)

def sigLine(line: String, rest: List[String], mode: Int, depth: Int, b: Builder): String =
  if (mode == 2) sigSkipLine(line, rest, b) else sigCopyLine(line, rest, b)

def sigCopyLine(line: String, rest: List[String], b: Builder): String =
  if (lineIsDef(line)) sigLines(rest, 2, 0, b) else sigLines(rest, 0, 0, nlAppend(b, line))

def sigSkipLine(line: String, rest: List[String], b: Builder): String =
  if (lineIsDef(line)) sigLines(rest, 2, 0, b) else if (lineIsTop(line)) sigCopyLine(line, rest, b) else sigLines(rest, 2, 0, b)

def nlAppend(b: Builder, line: String): Builder =
  Builder.append(b, Str.concat(line, """
"""))

def lineIsDef(line: String): Bool =
  Str.startsWith(line, "def ") || Str.startsWith(line, "@main def ") || Str.startsWith(line, "private def ")

def lineIsTop(line: String): Bool =
  lineIsDef(line) || Str.startsWith(line, "enum ") || Str.startsWith(line, "record ") || Str.startsWith(line, "import ") || Str.startsWith(line, "type ") || Str.startsWith(line, "opaque ") || Str.startsWith(line, "@")

def checkFmtFail(stem: String): IO[Unit] =
  IO.println(Str.concat(stem, ".scuzz:1:1: error: needs formatting (run scuzz fmt)")).flatMap(_ => IO.fail("scuzz check"))

def checkDirOut(json: Bool, diags: String, human: String, files: List[(String, String)]): IO[Unit] =
  if (json) checkDirJson(diags, files) else checkDirHuman(human)

def checkDirJson(diags: String, files: List[(String, String)]): IO[Unit] =
  if (diags == "[]") IO.println(Check.unclaimedJson(files)) else IO.println(diags).flatMap(_ => IO.fail("scuzz check"))

def checkDirHuman(human: String): IO[Unit] =
  if (human == "scuzz check ok") IO.println(human) else IO.println(human).flatMap(_ => IO.fail("scuzz check"))

def testDir(dir: String, outDir: String, update: Bool, pixels: Bool, differential: Bool): IO[Unit] =
  if (differential) testDiff(dir, outDir) else emitDir(dir, outDir, true).flatMap(_ => testLink(dir, outDir, update, pixels))

def testLink(dir: String, outDir: String, update: Bool, pixels: Bool): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => testLinkMan(dir, Manifest.parse(toml), outDir, update, pixels))

def testLinkMan(dir: String, m: Man, outDir: String, update: Bool, pixels: Bool): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)) else testLinkUi(m.hasUi, dir, m.name, outDir, update, pixels)

def testLinkUi(hasUi: Bool, dir: String, name: String, outDir: String, update: Bool, pixels: Bool): IO[Unit] =
  if (hasUi) ensureUi().flatMap(_ => testLinkNamed(true, dir, name, outDir, update, pixels)) else testLinkNamed(false, dir, name, outDir, update, pixels)

def testLinkNamed(hasUi: Bool, dir: String, name: String, outDir: String, update: Bool, pixels: Bool): IO[Unit] =
  runLinkLine(hasUi, outDir, name).flatMap(r => testAfterClang(r, exeName(outDir, name), dir, outDir, name, hasUi, update, pixels))

def testAfterClang(r: (Int, String, String), exe: String, dir: String, outDir: String, name: String, hasUi: Bool, update: Bool, pixels: Bool): IO[Unit] =
  r match {
    case (code, out, err) => testAfterClang2(code, out, err, exe, dir, outDir, name, hasUi, update, pixels)
  }

def testAfterClang2(code: Int, _out: String, err: String, exe: String, dir: String, outDir: String, name: String, hasUi: Bool, update: Bool, pixels: Bool): IO[Unit] =
  if (code != 0) testClangFail(err) else testClangOk(hasUi, dir, outDir, name, exe, update, pixels)

def testClangFail(err: String): IO[Unit] =
  IO.println(err).flatMap(_ => IO.fail("clang"))

def testClangOk(hasUi: Bool, dir: String, outDir: String, name: String, exe: String, update: Bool, pixels: Bool): IO[Unit] =
  IO.println("project compile smoke ok").flatMap(_ => testAfterSmoke(hasUi, dir, outDir, name, exe, update, pixels))

def testAfterSmoke(hasUi: Bool, dir: String, outDir: String, name: String, exe: String, update: Bool, pixels: Bool): IO[Unit] =
  if (hasUi) testUi(dir, outDir, name, exe, update, pixels) else testRun(exe)

def uiDumpEnvOf(toml: String, dump: String, snap: String, tap: Bool): String =
  Str.concat(headlessEnvOf(toml), Str.concat("SCUZZ_SNAPSHOT_PATH=", Str.concat(snap, Str.concat(" SCUZZ_FUZZ_DUMP=", Str.concat(dump, Str.concat(if (tap) " SCUZZ_UI_TAP=1 " else " ", tapNEnv(toml, tap)))))))

def testUi(dir: String, outDir: String, name: String, _exe: String, update: Bool, pixels: Bool): IO[Unit] =
  if (update) Fs.mkdirs(joinSlash(dir, "goldens")).flatMap(_ => testUiToml(dir, outDir, name, update, pixels)) else testUiToml(dir, outDir, name, update, pixels)

def testUiToml(dir: String, outDir: String, name: String, update: Bool, pixels: Bool): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => testUiHit(dir, outDir, name, toml, update, pixels))

def testUiHit(dir: String, outDir: String, name: String, toml: String, update: Bool, pixels: Bool): IO[Unit] =
  Fs.exists(joinSlash(dir, "sample.txt")).flatMap(hit => testUiDumps(dir, outDir, name, toml, if (hit) " sample.txt" else "", update, pixels))

def testUiDumps(dir: String, outDir: String, name: String, toml: String, arg: String, update: Bool, pixels: Bool): IO[Unit] =
  testUiDump(dir, outDir, name, toml, arg, update, pixels, false).flatMap(_ => testUiDump(dir, outDir, name, toml, arg, update, pixels, true).flatMap(_ => IO.println("scuzz test ok")))

def testUiDump(dir: String, outDir: String, name: String, toml: String, arg: String, update: Bool, pixels: Bool, tap: Bool): IO[Unit] =
  testUiRun(dir, name, uiDumpEnvOf(toml, uiDumpRel(name, tap), uiSnapRel(name, tap), tap), uiGolden(dir, name, tap), uiActual(outDir, name, tap), update, pixels, tap, arg, outDir)

def uiDumpRel(name: String, tap: Bool): String =
  joinSlash("build", if (tap) Str.concat(name, "_after_tap.actual.dump") else Str.concat(name, ".actual.dump"))

def uiSnapRel(name: String, tap: Bool): String =
  joinSlash("build", if (tap) Str.concat(name, "_after_tap.actual.png") else Str.concat(name, ".actual.png"))

def uiGolden(dir: String, name: String, tap: Bool): String =
  joinSlash(joinSlash(dir, "goldens"), if (tap) Str.concat(name, "_after_tap.dump") else Str.concat(name, ".dump"))

def uiActual(outDir: String, name: String, tap: Bool): String =
  joinSlash(outDir, if (tap) Str.concat(name, "_after_tap.actual.dump") else Str.concat(name, ".actual.dump"))

def uiSnap(outDir: String, name: String, tap: Bool): String =
  joinSlash(outDir, if (tap) Str.concat(name, "_after_tap.actual.png") else Str.concat(name, ".actual.png"))

def testUiRun(dir: String, name: String, runEnv: String, golden: String, actual: String, update: Bool, pixels: Bool, tap: Bool, arg: String, outDir: String): IO[Unit] =
  runLine(Str.concat("cd ", Str.concat(dir, Str.concat(" && ", Str.concat(runEnv, Str.concat(joinSlash("build", name), arg)))))).flatMap(r => testUiAfter(r, golden, actual, update, pixels, tap, dir, outDir, name))

def testUiAfter(r: (Int, String, String), golden: String, actual: String, update: Bool, pixels: Bool, tap: Bool, dir: String, outDir: String, name: String): IO[Unit] =
  r match {
    case (code, out, err) => testUiAfter2(code, out, err, golden, actual, update, pixels, tap, dir, outDir, name)
  }

def testUiAfter2(code: Int, _out: String, err: String, golden: String, actual: String, update: Bool, pixels: Bool, tap: Bool, dir: String, outDir: String, name: String): IO[Unit] =
  if (code != 0) testUiFail(err) else testUiCmp(golden, actual, update).flatMap(_ => testPng(dir, outDir, name, tap, update, pixels))

def testUiFail(err: String): IO[Unit] =
  IO.println(err).flatMap(_ => IO.fail("ui golden"))

def testPng(dir: String, outDir: String, name: String, tap: Bool, update: Bool, pixels: Bool): IO[Unit] =
  if (!pixels) IO.pure(()) else testPngCmp(uiPngGolden(dir, name, tap), uiSnap(outDir, name, tap), update)

def uiPngGolden(dir: String, name: String, tap: Bool): String =
  joinSlash(joinSlash(dir, "goldens"), if (tap) Str.concat(name, "_after_tap.png") else Str.concat(name, ".png"))

def testUiCmp(golden: String, actual: String, update: Bool): IO[Unit] =
  if (update) Fs.read(actual).flatMap(got => Fs.write(golden, got).flatMap(_ => IO.println(Str.concat("golden updated: ", golden)))) else Fs.read(golden).flatMap(want => Fs.read(actual).flatMap(got => testUiEq(golden, want, got)))

def testUiEq(golden: String, want: String, got: String): IO[Unit] =
  if (want == got) IO.println(Str.concat("golden ok: ", golden)) else IO.println(Str.concat("structural golden mismatch: ", golden)).flatMap(_ => IO.fail("golden"))

def testPngCmp(golden: String, actual: String, update: Bool): IO[Unit] =
  if (update) Fs.read(actual).flatMap(got => Fs.write(golden, got).flatMap(_ => IO.println(Str.concat("pixel golden updated: ", golden)))) else Fs.read(golden).flatMap(want => Fs.read(actual).flatMap(got => testPngEq(golden, want, got)))

def testPngEq(golden: String, want: String, got: String): IO[Unit] =
  if (want == got) IO.println(Str.concat("pixel golden ok: ", golden)) else IO.println(Str.concat("pixel golden mismatch: ", golden)).flatMap(_ => IO.fail("pixels"))

def testDiff(dir: String, outDir: String): IO[Unit] =
  Fs.exists(joinSlash(dir, "goldens")).flatMap(ok => if (ok == 0) failMsg("missing goldens/ for [ui] package. Seed with `scuzz test --update`.", "differential") else testDiffUi(dir, outDir))

def testDiffUi(dir: String, outDir: String): IO[Unit] =
  ensureUi().flatMap(_ => Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => testDiffMan(dir, outDir, Manifest.parse(toml))))

def testDiffMan(dir: String, outDir: String, m: Man): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)).flatMap(_ => IO.fail("toml")) else if (!m.hasUi) IO.println("--differential needs a [ui] package").flatMap(_ => IO.fail("differential")) else testDiffBackends(dir, outDir, m.name, "skia" :: "sk_sw" :: "gpu" :: [], [])

def testDiffBackends(dir: String, outDir: String, name: String, rest: List[String], dumps: List[String]): IO[Unit] =
  if (List.isEmpty(rest)) testDiffDone(dumps) else testDiffOne(dir, outDir, name, List.at(rest, 0), List.tail(rest), dumps)

def testDiffDone(dumps: List[String]): IO[Unit] =
  if (List.len(dumps) < 2) IO.println("differential needs at least two runnable backends").flatMap(_ => IO.fail("differential")) else testDiffEq(List.at(dumps, 0), List.tail(dumps))

def testDiffEq(ref: String, rest: List[String]): IO[Unit] =
  if (List.isEmpty(rest)) IO.println("differential ok") else if (ref == List.at(rest, 0)) testDiffEq(ref, List.tail(rest)) else IO.println("structural dump differs across backends").flatMap(_ => IO.fail("differential"))

def testDiffOne(dir: String, outDir: String, name: String, backend: String, rest: List[String], dumps: List[String]): IO[Unit] =
  skiaMake(backend).flatMap(ok => if (!ok) testDiffBackends(dir, outDir, name, rest, dumps) else testDiffEmit(dir, outDir, name, backend, rest, dumps))

def testDiffEmit(dir: String, outDir: String, name: String, backend: String, rest: List[String], dumps: List[String]): IO[Unit] =
  emitDir(dir, outDir, true).flatMap(_ => testDiffLink(dir, outDir, name, backend, rest, dumps))

def failMsg(msg: String, tag: String): IO[Unit] =
  IO.println(msg).flatMap(_ => IO.fail(tag))

def skiaMake(backend: String): IO[Bool] =
  crateHome().flatMap(h => runLine(Str.concat("SCUZZ_SKIA=", Str.concat(backend, Str.concat(" make -C ", Str.concat(crateAt(h, "crates/ffi-skia"), " lib CC=clang"))))).flatMap(r => skiaMakeGot(r, backend)))

def skiaMakeGot(r: (Int, String, String), backend: String): IO[Bool] =
  r match {
    case (code, _out, err) => if (code != 0) IO.println(Str.concat("differential: backend unavailable: ", backend)).map(_ => false) else IO.pure(true)
  }

def testDiffLink(dir: String, outDir: String, name: String, backend: String, rest: List[String], dumps: List[String]): IO[Unit] =
  runLinkLine(true, outDir, name).flatMap(r => testDiffLinked(r, dir, outDir, name, backend, rest, dumps))

def testDiffLinked(r: (Int, String, String), dir: String, outDir: String, name: String, backend: String, rest: List[String], dumps: List[String]): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) testDiffBackends(dir, outDir, name, rest, dumps) else testDiffCap(dir, outDir, name, backend, rest, dumps)
  }

def testDiffCap(dir: String, outDir: String, name: String, backend: String, rest: List[String], dumps: List[String]): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => testDiffCap2(dir, outDir, name, backend, rest, dumps, toml))

def testDiffCap2(dir: String, outDir: String, name: String, backend: String, rest: List[String], dumps: List[String], toml: String): IO[Unit] =
  Fs.exists(joinSlash(dir, "sample.txt")).flatMap(hit => testDiffCap3(dir, outDir, name, backend, rest, dumps, toml, if (hit) " sample.txt" else ""))

def testDiffCap3(dir: String, outDir: String, name: String, backend: String, rest: List[String], dumps: List[String], toml: String, arg: String): IO[Unit] =
  testDiffDump(dir, name, toml, arg, backend, false).flatMap(a => testDiffDump(dir, name, toml, arg, backend, true).flatMap(b => testDiffKeep(dir, outDir, name, rest, dumps, a, b)))

def testDiffKeep(dir: String, outDir: String, name: String, rest: List[String], dumps: List[String], a: String, b: String): IO[Unit] =
  if (a == "" || b == "") testDiffBackends(dir, outDir, name, rest, dumps) else testDiffBackends(dir, outDir, name, rest, Str.concat(a, b) :: dumps)

def testDiffDump(dir: String, name: String, toml: String, arg: String, backend: String, tap: Bool): IO[String] =
  runLine(Str.concat("cd ", Str.concat(dir, Str.concat(" && ", Str.concat(uiDumpEnvOf(toml, uiDumpRel(name, tap), uiSnapRel(name, tap), tap), Str.concat(joinSlash("build", name), arg)))))).flatMap(r => testDiffDumpGot(r, dir, name, tap, backend))

def testDiffDumpGot(r: (Int, String, String), dir: String, name: String, tap: Bool, _backend: String): IO[String] =
  r match {
    case (code, _out, err) => if (code != 0) IO.pure("") else Fs.read(uiActual(joinSlash(dir, "build"), name, tap))
  }

def testRun(exe: String): IO[Unit] =
  runLine(Str.concat(testEnv(), exe)).flatMap(r => testAfterRun(r))

def testAfterRun(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, out, err) => testAfterRun2(code, out, err)
  }

def testAfterRun2(code: Int, out: String, err: String): IO[Unit] =
  if (code != 0) IO.println(err).flatMap(_ => IO.fail("IO smoke")) else Sys.write(out).flatMap(_ => IO.println("IO smoke ok").flatMap(_ => IO.println("scuzz test ok")))

def showPkg(p: PkgOut): String =
  if (!p.ok) Str.concat("fail:", p.diags) else Str.concat("ok name=", Str.concat(p.name, Str.concat(" ll=", Str.concat(p.llPath, Str.concat(" link=", p.link)))))

def xcodeMiss(): String =
  "missing Xcode - install Xcode from the App Store, then xcode-select --install"

def ndkMiss(): String =
  "missing Android NDK - install the NDK, then set ANDROID_NDK_HOME"

def badTarget(t: String): String =
  Str.concat("unknown package target '", Str.concat(t, "' (host|android|ios|all). Example: scuzz package --target host"))

def bundleId(): String =
  "dev.scuzz.app"

def hostRunSh(name: String): String =
  Str.concat("#!/usr/bin/env bash\n# Host Mobile shell smoke. Same app binary; Mobile peer + host embedder.\nset -euo pipefail\nDIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nexport SCUZZ_UI_RUNTIME=mobile\nexport SCUZZ_MOBILE_SHELL=1\nexec \"$DIR/", Str.concat(name, "\" \"$@\"\n"))

def hostMeta(name: String): String =
  Str.concat("[package]\nname = \"", Str.concat(name, Str.concat("\"\ntarget = \"host\"\nbundle_id = \"", Str.concat(bundleId(), "\"\nruntime = \"mobile\"\n"))))

def linkOnly(hasUi: Bool, name: String, outDir: String): IO[Unit] =
  runLinkLine(hasUi, outDir, name).flatMap(r => linkOnlyGot(r))

def linkReload(ll: String, outDir: String): IO[Unit] =
  runLine(Str.concat("clang -O0 -Wno-override-module -shared -fPIC ", Str.concat(ll, Str.concat(" -o ", joinSlash(outDir, "reload.dylib"))))).flatMap(r => linkOnlyGot(r))

def linkOnlyGot(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) IO.println(err).flatMap(_ => IO.fail("link")) else IO.pure(())
  }

def compileLinked(dir: String, outDir: String): IO[Unit] =
  emitDir(dir, outDir, true).flatMap(_ => compileLinkedMan(dir, outDir))

def compileLinkedMan(dir: String, outDir: String): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => compileLinkedUi(Manifest.parse(toml), outDir))

def compileLinkedUi(m: Man, outDir: String): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)).flatMap(_ => IO.fail("toml")) else if (m.hasUi) ensureUi().flatMap(_ => linkOnly(true, m.name, outDir)) else linkOnly(false, m.name, outDir)

def pkgDir(dir: String, outDir: String, target: String): IO[Unit] =
  if (target == "host") pkgHost(dir, outDir) else if (target == "android") pkgAndroid(dir, outDir) else if (target == "ios") pkgIos(dir) else if (target == "all") pkgHost(dir, outDir).flatMap(_ => pkgAndroid(dir, outDir).flatMap(_ => pkgIos(dir))) else IO.println(badTarget(target)).flatMap(_ => IO.fail("package"))

def pkgHost(dir: String, outDir: String): IO[Unit] =
  compileLinked(dir, outDir).flatMap(_ => pkgHostMan(dir, outDir))

def pkgHostMan(dir: String, outDir: String): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => pkgHostNamed(Manifest.parse(toml), dir, outDir))

def pkgHostNamed(m: Man, _dir: String, outDir: String): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)).flatMap(_ => IO.fail("toml")) else pkgHostCopy(m.name, exeName(outDir, m.name), joinSlash(joinSlash(outDir, "package"), "host"))

def pkgHostCopy(name: String, exe: String, dest: String): IO[Unit] =
  Fs.mkdirs(dest).flatMap(_ => pkgHostCp(name, exe, dest))

def pkgHostCp(name: String, exe: String, dest: String): IO[Unit] =
  runLine(Str.concat("cp ", Str.concat(exe, Str.concat(" ", joinSlash(dest, name))))).flatMap(r => pkgHostChmod(r, name, dest))

def pkgHostChmod(r: (Int, String, String), name: String, dest: String): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) pkgHostCpFail(err) else pkgHostChmodOk(name, dest)
  }

def pkgHostCpFail(err: String): IO[Unit] =
  IO.println(err).flatMap(_ => IO.fail("cp"))

def pkgHostChmodOk(name: String, dest: String): IO[Unit] =
  runLine(Str.concat("chmod +x ", joinSlash(dest, name))).flatMap(_ => pkgHostWrite(name, dest))

def pkgHostWrite(name: String, dest: String): IO[Unit] =
  Fs.write(joinSlash(dest, "run.sh"), hostRunSh(name)).flatMap(_ => runLine(Str.concat("chmod +x ", joinSlash(dest, "run.sh"))).flatMap(_ => Fs.write(joinSlash(dest, "package.toml"), hostMeta(name)).flatMap(_ => IO.println(Str.concat("packaged host -> ", dest)).flatMap(_ => IO.println(Str.concat("scuzz package ok (", Str.concat(dest, ")")))))))

def pkgAndroid(dir: String, outDir: String): IO[Unit] =
  crateHome().flatMap(h => runLine(Str.concat("bash ", Str.concat(crateAt(h, "crates/embedder-mobile/shells/android/build_ndk.sh"), Str.concat(" ", dir)))).flatMap(r => pkgAndroidNdk(h, r, dir, outDir)))

def pkgAndroidNdk(h: String, r: (Int, String, String), dir: String, outDir: String): IO[Unit] =
  r match {
    case (code, out, err) => if (code != 0) pkgAndroidFail(out, err) else runLine(Str.concat("bash ", Str.concat(crateAt(h, "crates/embedder-mobile/shells/android/build_apk.sh"), Str.concat(" ", dir)))).flatMap(r2 => pkgAndroidApk(r2, dir, outDir))
  }

def pkgAndroidApk(r: (Int, String, String), dir: String, outDir: String): IO[Unit] =
  r match {
    case (code, out, err) => if (code != 0) pkgAndroidFail(out, err) else pkgAndroidStage(dir, outDir)
  }

def pkgAndroidStage(dir: String, outDir: String): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => pkgAndroidNamed(Manifest.parse(toml), dir, outDir))

def pkgAndroidNamed(m: Man, dir: String, outDir: String): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)).flatMap(_ => IO.fail("toml")) else pkgAndroidCopy(m.name, dir, joinSlash(joinSlash(outDir, "package"), "android"))

def androidLib(dir: String): String =
  joinSlash(joinSlash(joinSlash(dir, "build"), "android"), "lib")

def androidApk(dir: String, name: String): String =
  joinSlash(joinSlash(joinSlash(dir, "build"), "android"), Str.concat(name, ".apk"))

def pkgAndroidCopy(name: String, dir: String, dest: String): IO[Unit] =
  Fs.mkdirs(dest).flatMap(_ => pkgAndroidCpSo(name, dir, dest))

def pkgAndroidCpSo(name: String, dir: String, dest: String): IO[Unit] =
  runLine(Str.concat("rm -rf ", Str.concat(joinSlash(dest, "lib"), Str.concat(" && cp -a ", Str.concat(androidLib(dir), Str.concat(" ", joinSlash(dest, "lib"))))))).flatMap(r => pkgAndroidCpSoGot(r, name, dir, dest))

def pkgAndroidCpSoGot(r: (Int, String, String), name: String, dir: String, dest: String): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) IO.println(err).flatMap(_ => IO.fail("cp")) else pkgAndroidCpApk(name, dir, dest)
  }

def pkgAndroidCpApk(name: String, dir: String, dest: String): IO[Unit] =
  runLine(Str.concat("cp ", Str.concat(androidApk(dir, name), Str.concat(" ", joinSlash(dest, Str.concat(name, ".apk")))))).flatMap(r => pkgAndroidCpApkGot(r, name, dest))

def pkgAndroidCpApkGot(r: (Int, String, String), name: String, dest: String): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) IO.println(err).flatMap(_ => IO.fail("cp")) else pkgAndroidWrite(name, dest)
  }

def pkgAndroidWrite(name: String, dest: String): IO[Unit] =
  Fs.write(joinSlash(dest, "package.toml"), androidMeta(name)).flatMap(_ => pkgAndroidAdb(name, dest))

def pkgAndroidAdb(name: String, dest: String): IO[Unit] =
  crateHome().flatMap(h => runLine(Str.concat("bash ", Str.concat(crateAt(h, "crates/embedder-mobile/shells/android/install_apk.sh"), Str.concat(" ", joinSlash(dest, Str.concat(name, ".apk")))))).flatMap(r => pkgAndroidAdbGot(r, dest)))

def pkgAndroidAdbGot(r: (Int, String, String), dest: String): IO[Unit] =
  r match {
    case (code, out, err) => if (code != 0) pkgAndroidAdbFail(out, err) else pkgAndroidAdbOk(out, dest)
  }

def pkgAndroidAdbFail(out: String, err: String): IO[Unit] =
  IO.println(if (Str.len(err) > 0) err else out).flatMap(_ => IO.fail("android"))

def pkgAndroidAdbOk(out: String, dest: String): IO[Unit] =
  IO.println(if (Str.len(out) > 0) out else "").flatMap(_ => IO.println(Str.concat("scuzz package ok (android) -> ", dest)))

def androidMeta(name: String): String =
  Str.concat("[package]\nname = \"", Str.concat(name, Str.concat("\"\ntarget = \"android\"\nbundle_id = \"", Str.concat(bundleId(), "\"\nruntime = \"mobile\"\n"))))

def pkgAndroidFail(out: String, err: String): IO[Unit] =
  IO.println(if (Str.len(err) > 0) err else if (Str.len(out) > 0) out else ndkMiss()).flatMap(_ => IO.fail("android"))

def pkgIos(dir: String): IO[Unit] =
  runLine("xcrun --sdk iphonesimulator --show-sdk-path").flatMap(r => pkgIosGot(r, dir))

def pkgIosGot(r: (Int, String, String), dir: String): IO[Unit] =
  r match {
    case (code, _out, _err) => if (code != 0) pkgIosMiss() else pkgIosBuild(dir)
  }

def pkgIosMiss(): IO[Unit] =
  IO.println(xcodeMiss()).flatMap(_ => IO.fail("ios"))

def pkgIosBuild(dir: String): IO[Unit] =
  crateHome().flatMap(h => runLine(Str.concat("bash ", Str.concat(crateAt(h, "crates/embedder-mobile/shells/ios/build_sim.sh"), Str.concat(" ", dir)))).flatMap(r2 => pkgIosRun(r2)))

def pkgIosRun(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, out, err) => if (code != 0) IO.println(if (Str.len(err) > 0) err else out).flatMap(_ => IO.fail("ios")) else IO.println("scuzz package ok (ios)")
  }

def fuzzDir(dir: String, outDir: String, iterations: Int, seed: Int, replay: String, noFailFast: Bool, oracles: Bool): IO[Unit] =
  fuzzCollect(dir).flatMap(files => emitDirAlways(dir, outDir, files).flatMap(_ => compileLinkedMan(dir, outDir).flatMap(_ => fuzzWriteTable(dir, outDir, files).flatMap(_ => fuzzLiveBuild(dir, outDir).flatMap(_ => fuzzLinked(dir, outDir, iterations, seed, replay, files, noFailFast, oracles))))))

def fuzzWriteTable(dir: String, outDir: String, files: List[(String, String)]): IO[Unit] =
  fuzzVerSrcs(dir).flatMap(srcs => Fs.write(joinSlash(outDir, "drivers.txt"), Verify.driversFrom(srcs, Verify.ensOfFiles(files))))

def fuzzVerSrcs(dir: String): IO[List[String]] =
  Fs.list(dir).flatMap(ents => fuzzVerSrcGo(dir, ents, Verify.noStr())).handleErrorWith(_ => IO.pure(Verify.noStr()))

def fuzzVerSrcGo(dir: String, ents: List[(String, Bool)], acc: List[String]): IO[List[String]] =
  if (List.isEmpty(ents)) IO.pure(acc) else fuzzVerSrcHd(dir, List.at(ents, 0), List.tail(ents), acc)

def fuzzVerSrcHd(dir: String, ent: (String, Bool), rest: List[(String, Bool)], acc: List[String]): IO[List[String]] =
  ent match {
    case (name, isDir) => fuzzVerSrcPick(dir, name, isDir, rest, acc)
  }

def fuzzVerSrcPick(dir: String, name: String, isDir: Bool, rest: List[(String, Bool)], acc: List[String]): IO[List[String]] =
  if (isDir || !isVerify(name)) fuzzVerSrcGo(dir, rest, acc) else Fs.read(joinSlash(dir, name)).flatMap(src => fuzzVerSrcGo(dir, rest, src :: acc))

def fuzzLiveBuild(dir: String, outDir: String): IO[Unit] =
  fuzzLiveCollect(dir).flatMap(files => fuzzLiveEmit(dir, joinSlash(outDir, "live"), files))

def fuzzLiveEmit(dir: String, liveDir: String, files: List[(String, String)]): IO[Unit] =
  Fs.mkdirs(liveDir).flatMap(_ => emitDirAlways(dir, liveDir, files).flatMap(_ => compileLinkedMan(dir, liveDir)))

def fuzzLiveCollect(dir: String): IO[List[(String, String)]] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => fuzzLiveMan(dir, Manifest.parse(toml)))

def fuzzLiveMan(dir: String, m: Man): IO[List[(String, String)]] =
  m match {
    case Man(ok, _name, _version, _hasUi, deps, err) => fuzzLiveMan2(dir, ok, err, deps)
  }

def fuzzLiveMan2(dir: String, ok: Bool, err: String, deps: List[(String, String)]): IO[List[(String, String)]] =
  if (!ok) IO.println(Str.concat("fail:", err)).flatMap(_ => IO.pure(Manifest.noPairs())) else Fs.list(joinSlash(dir, "src")).flatMap(ents => fuzzLiveListed(dir, deps, ents))

def fuzzLiveListed(dir: String, deps: List[(String, String)], ents: List[(String, Bool)]): IO[List[(String, String)]] =
  readSrcFiles(joinSlash(dir, "src"), ents).flatMap(own => collectDeps(dir, deps, own))

def fuzzLinked(dir: String, outDir: String, iterations: Int, seed: Int, replay: String, files: List[(String, String)], noFailFast: Bool, oracles: Bool): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => fuzzMan(Manifest.parse(toml), dir, outDir, iterations, seed, replay, files, noFailFast, oracles))

def fuzzMan(m: Man, dir: String, outDir: String, iterations: Int, seed: Int, replay: String, files: List[(String, String)], noFailFast: Bool, oracles: Bool): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)).flatMap(_ => IO.fail("toml")) else fuzzMan2(FuzzJob(dir, outDir, exeName(outDir, m.name), m.name, m.hasUi, iterations, seed, noFailFast, files, oracles), replay)

def fuzzMan2(job: FuzzJob, replay: String): IO[Unit] =
  if (replay != "") fuzzReplayFile(job.outDir, job.exe, job.hasUi, replay) else fuzzBody(job)

def fuzzReplayFile(outDir: String, exe: String, hasUi: Bool, replay: String): IO[Unit] =
  Fs.read(replay).flatMap(src => fuzzReplayGot(outDir, exe, hasUi, replay, src))

def fuzzReplayGot(outDir: String, exe: String, hasUi: Bool, replay: String, src: String): IO[Unit] =
  fuzzReplayRun(outDir, exe, hasUi, replay, fuzzRunOf(replay, src))

def fuzzReplayRun(outDir: String, exe: String, hasUi: Bool, replay: String, run: FuzzRun): IO[Unit] =
  IO.println(fuzzReplayHead(replay, run)).flatMap(_ => fuzzWriteDrive(outDir, run.script).flatMap(_ => fuzzProbeRun(exe, hasUi, outDir, run).flatMap(bad => fuzzReplayDone(bad))))

def fuzzReplayHead(replay: String, run: FuzzRun): String =
  Str.concat("scuzz fuzz --replay ", Str.concat(replay, Str.concat(" (", Str.concat(Str.fromInt(List.len(Verify.linesOf(run.script))), " events)"))))

def fuzzReplayDone(bad: Int): IO[Unit] =
  if (bad > 0) IO.println("fuzz replay reproduced a failure").flatMap(_ => IO.fail("fuzz")) else IO.println("fuzz replay ok (no failure)")

def fuzzBody(job: FuzzJob): IO[Unit] =
  fuzzClearPromo(job.outDir).flatMap(_ => fuzzSeedText(job.dir, job.files).flatMap(script => fuzzBody2(job, script)))

def fuzzClearPromo(outDir: String): IO[Unit] =
  Fs.delete(joinSlash(joinSlash(outDir, "fuzz"), "promo")).handleErrorWith(_ => IO.pure(()))

def fuzzBody2(job: FuzzJob, script: String): IO[Unit] =
  fuzzWriteSeeds(job.outDir, script).flatMap(_ => fuzzCorpusFiles(job.dir).flatMap(runs => fuzzBody3(job, script, runs)))

def fuzzBody3(job: FuzzJob, script: String, runs: List[FuzzRun]): IO[Unit] =
  fuzzSplit(job).flatMap(_ => fuzzReplayGo(job.exe, job.hasUi, job.outDir, job.seed, fuzzAddSeeds(runs, joinSlash(job.outDir, "seeds.txt"), script), FuzzAcc(0, 0, "")).flatMap(acc => fuzzAfterReplay(job, script, List.len(fuzzAddSeeds(runs, joinSlash(job.outDir, "seeds.txt"), script)), acc)))

def fuzzAfterReplay(job: FuzzJob, script: String, corpus: Int, acc: FuzzAcc): IO[Unit] =
  if (acc.fail > 0 && !job.noFailFast) fuzzDone(job, corpus, acc.fail, acc.corpFail, acc.repro, emptyMut(Mutate.countFiles(job.files, job.oracles))) else fuzzSearch(job.exe, job.hasUi, job.outDir, script, Verify.searchN(job.iterations), 0, 1, job.seed).flatMap(fail => fuzzAfterSearch(job, script, corpus, acc, fail))

def fuzzAfterSearch(job: FuzzJob, script: String, corpus: Int, acc: FuzzAcc, fail: Int): IO[Unit] =
  if (fail > 0 && acc.repro == "") fuzzAfterSearchFail(job, script, corpus, acc, fail) else fuzzMutate(job, corpus, fail, acc.corpFail, acc.repro)

def fuzzAfterSearchFail(job: FuzzJob, script: String, corpus: Int, acc: FuzzAcc, fail: Int): IO[Unit] =
  if (job.hasUi) fuzzSearchFail(job, script, corpus, acc, fail) else fuzzMutate(job, corpus, fail, acc.corpFail, joinSlash(joinSlash(job.outDir, "fuzz"), "repro.toml"))

def fuzzSearchFail(job: FuzzJob, script: String, corpus: Int, acc: FuzzAcc, fail: Int): IO[Unit] =
  fuzzSaveRepro(job.outDir, job.seed, FuzzRun(joinSlash(job.outDir, "seeds.txt"), "", fuzzFailScript(job, script), "", "")).flatMap(path => fuzzSearchFail2(job, script, corpus, acc, fail, path))

def fuzzSearchFail2(job: FuzzJob, script: String, corpus: Int, acc: FuzzAcc, fail: Int, path: String): IO[Unit] =
  if (!job.hasUi || script != "") fuzzMutate(job, corpus, fail, acc.corpFail, path) else fuzzPromoteTap(job).flatMap(_ => fuzzMutate(job, corpus + 1, fail, acc.corpFail, path))

def fuzzFailScript(job: FuzzJob, script: String): String =
  if (job.hasUi && script == "") """tap 0
""" else script

def fuzzPromoteTap(job: FuzzJob): IO[Unit] =
  Fs.mkdirs(joinSlash(job.dir, "corpus")).flatMap(_ => Fs.write(joinSlash(joinSlash(job.dir, "corpus"), "tap0.toml"), Verify.reproText(job.seed, "", "", "tap 0" :: Verify.noStr())).flatMap(_ => Fs.write(joinSlash(joinSlash(job.outDir, "fuzz"), "promo"), "1")))

def emptyMut(sites: Int): FuzzMut =
  FuzzMut(0, 0, 0, 0, sites)

def fuzzSplit(job: FuzzJob): IO[Unit] =
  if (!job.hasUi) IO.pure(()) else Fs.read(joinSlash(job.dir, "scuzz.toml")).flatMap(toml => fuzzSplitMan(job, Manifest.parse(toml)))

def fuzzSplitMan(job: FuzzJob, m: Man): IO[Unit] =
  fuzzHasSim(job.dir, m.deps).flatMap(sim => if (sim) IO.pure(()) else fuzzSplitGo(job))

def fuzzHasSim(dir: String, deps: List[(String, String)]): IO[Bool] =
  fuzzHasSimDir(joinSlash(dir, "src")).flatMap(hit => if (hit) IO.pure(true) else fuzzHasSimDeps(dir, deps))

def fuzzHasSimDir(srcDir: String): IO[Bool] =
  Fs.list(srcDir).map(ents => fuzzHasSimEnts(ents)).handleErrorWith(_ => IO.pure(false))

def fuzzHasSimEnts(ents: List[(String, Bool)]): Bool =
  if (List.isEmpty(ents)) false else fuzzHasSimHd(List.at(ents, 0), List.tail(ents))

def fuzzHasSimHd(h: (String, Bool), rest: List[(String, Bool)]): Bool =
  h match {
    case (name, isDir) => if (!isDir && isSimName(name)) true else fuzzHasSimEnts(rest)
  }

def isSimName(name: String): Bool =
  Str.len(name) > 10 && Str.slice(name, Str.len(name) - 10, Str.len(name)) == ".scuzz_sim"

def fuzzHasSimDeps(dir: String, deps: List[(String, String)]): IO[Bool] =
  if (List.isEmpty(deps)) IO.pure(false) else fuzzHasSimDepHd(dir, List.at(deps, 0), List.tail(deps))

def fuzzHasSimDepHd(dir: String, d: (String, String), rest: List[(String, String)]): IO[Bool] =
  d match {
    case (_name, path) => fuzzHasSimDir(joinSlash(joinSlash(dir, path), "src")).flatMap(hit => if (hit) IO.pure(true) else fuzzHasSimDeps(dir, rest))
  }

def fuzzLiveExe(job: FuzzJob): String =
  exeName(joinSlash(job.outDir, "live"), job.name)

def fuzzSplitGo(job: FuzzJob): IO[Unit] =
  Fs.mkdirs(joinSlash(job.outDir, "fuzz")).flatMap(_ => Fs.mkdirs(joinSlash(joinSlash(job.outDir, "fuzz"), "live")).flatMap(_ => fuzzSplitRun(job)))

def fuzzSplitRun(job: FuzzJob): IO[Unit] =
  fuzzSplitProbe(job.exe, job.hasUi, fuzzDumpPath(job.outDir), fuzzTlPath(job.outDir)).flatMap(cv => if (cv != 0) failMsg("fuzz probe failed: app fails under TestRuntime before any event", "scuzz fuzz") else fuzzSplitLive(job))

def fuzzTlPath(outDir: String): String =
  joinSlash(joinSlash(outDir, "fuzz"), "timeline.txt")

def fuzzSplitLive(job: FuzzJob): IO[Unit] =
  fuzzSplitProbe(fuzzLiveExe(job), job.hasUi, joinSlash(joinSlash(joinSlash(job.outDir, "fuzz"), "live"), "dump.txt"), joinSlash(joinSlash(joinSlash(job.outDir, "fuzz"), "live"), "timeline.txt")).flatMap(cl => if (cl != 0) failMsg("fuzz live/verify split: live graph failed on the same seed", "scuzz fuzz") else fuzzSplitCmp(job))

def fuzzSplitProbe(exe: String, hasUi: Bool, dump: String, tl: String): IO[Int] =
  runProbe(Str.concat(fuzzSplitEnv(hasUi, dump, tl), exe)).map(r => fuzzProbeCode(r))

def fuzzSplitEnv(hasUi: Bool, dump: String, tl: String): String =
  Str.concat(testEnv(), Str.concat(if (hasUi) headlessEnv() else "", Str.concat(Str.concat("SCUZZ_FUZZ_DUMP=", Str.concat(dump, " ")), fuzzTlEnv(tl))))

def fuzzSplitCmp(job: FuzzJob): IO[Unit] =
  fuzzReadOr(fuzzDumpPath(job.outDir)).flatMap(vd => fuzzReadOr(joinSlash(joinSlash(joinSlash(job.outDir, "fuzz"), "live"), "dump.txt")).flatMap(ld => fuzzReadOr(fuzzTlPath(job.outDir)).flatMap(vt => fuzzReadOr(joinSlash(joinSlash(joinSlash(job.outDir, "fuzz"), "live"), "timeline.txt")).flatMap(lt => fuzzSplitEq(ld, vd, lt, vt)))))

def fuzzReadOr(path: String): IO[String] =
  Fs.read(path).handleErrorWith(_ => IO.pure(""))

def fuzzSplitEq(liveDump: String, verDump: String, liveTl: String, verTl: String): IO[Unit] =
  if (liveDump != verDump || liveTl != verTl) IO.println("fuzz live/verify split: silent observation mismatch").flatMap(_ => IO.fail("scuzz fuzz")) else IO.pure(())

def noRuns(): List[FuzzRun] =
  []

def fuzzRunOf(path: String, src: String): FuzzRun =
  FuzzRun(path, src, Verify.nls(Verify.parseEvents(src)), Verify.tomlQuoted(src, "schedule_seed"), Verify.tomlQuoted(src, "fault_seed"))

def fuzzCorpusFiles(dir: String): IO[List[FuzzRun]] =
  Fs.list(joinSlash(dir, "corpus")).flatMap(ents => fuzzCorpusRead(dir, Verify.sortStrs(fuzzTomlNames(ents, Verify.noStr())))).handleErrorWith(_ => IO.pure(noRuns()))

def fuzzTomlNames(ents: List[(String, Bool)], acc: List[String]): List[String] =
  if (List.isEmpty(ents)) acc else fuzzTomlNamesHd(List.at(ents, 0), List.tail(ents), acc)

def fuzzTomlNamesHd(h: (String, Bool), rest: List[(String, Bool)], acc: List[String]): List[String] =
  h match {
    case (name, isDir) => if (isDir) fuzzTomlNames(rest, acc) else if (Str.endsWith(name, ".toml")) fuzzTomlNames(rest, name :: acc) else fuzzTomlNames(rest, acc)
  }

def fuzzCorpusRead(dir: String, names: List[String]): IO[List[FuzzRun]] =
  if (List.isEmpty(names)) IO.pure(noRuns()) else fuzzCorpusReadHd(dir, List.at(names, 0), List.tail(names))

def fuzzCorpusReadHd(dir: String, name: String, rest: List[String]): IO[List[FuzzRun]] =
  Fs.read(joinSlash(joinSlash(dir, "corpus"), name)).flatMap(src => fuzzCorpusRead(dir, rest).flatMap(more => IO.pure(fuzzRunOf(joinSlash(joinSlash(dir, "corpus"), name), src) :: more)))

def fuzzAddSeeds(runs: List[FuzzRun], seedsPath: String, script: String): List[FuzzRun] =
  fuzzAddSeedLines(runs, seedsPath, Verify.linesOf(script))

def fuzzAddSeedLines(runs: List[FuzzRun], seedsPath: String, lines: List[String]): List[FuzzRun] =
  if (List.isEmpty(lines)) runs else fuzzAddSeedLines(fuzzAddSeed(runs, seedsPath, List.at(lines, 0)), seedsPath, List.tail(lines))

def fuzzAddSeed(runs: List[FuzzRun], seedsPath: String, line: String): List[FuzzRun] =
  if (line == "") runs else if (fuzzHasScript(runs, Str.concat(line, Verify.nl()))) runs else List.concat(runs, fuzzSeedRun(seedsPath, line) :: noRuns())

def fuzzSeedRun(seedsPath: String, line: String): FuzzRun =
  FuzzRun(seedsPath, "", Str.concat(line, Verify.nl()), "", "")

def fuzzHasScript(runs: List[FuzzRun], script: String): Bool =
  if (List.isEmpty(runs)) false else fuzzHasScriptHd(List.at(runs, 0), List.tail(runs), script)

def fuzzHasScriptHd(h: FuzzRun, rest: List[FuzzRun], script: String): Bool =
  h.script == script || fuzzHasScript(rest, script)

def fuzzReplayGo(exe: String, hasUi: Bool, outDir: String, seed: Int, runs: List[FuzzRun], acc: FuzzAcc): IO[FuzzAcc] =
  if (List.isEmpty(runs) || acc.fail > 0) IO.pure(acc) else fuzzReplayOne(exe, hasUi, outDir, seed, List.at(runs, 0), List.tail(runs), acc)

def fuzzReplayOne(exe: String, hasUi: Bool, outDir: String, seed: Int, h: FuzzRun, rest: List[FuzzRun], acc: FuzzAcc): IO[FuzzAcc] =
  fuzzWriteDrive(outDir, h.script).flatMap(_ => fuzzProbeRun(exe, hasUi, outDir, h).flatMap(bad => fuzzReplayNext(exe, hasUi, outDir, seed, rest, acc, h, bad)))

def fuzzReplayNext(exe: String, hasUi: Bool, outDir: String, seed: Int, rest: List[FuzzRun], acc: FuzzAcc, h: FuzzRun, bad: Int): IO[FuzzAcc] =
  if (bad == 0) fuzzReplayGo(exe, hasUi, outDir, seed, rest, acc) else fuzzNoteFail(outDir, seed, h, acc).flatMap(next => fuzzReplayGo(exe, hasUi, outDir, seed, rest, next))

def fuzzNoteFail(outDir: String, seed: Int, run: FuzzRun, acc: FuzzAcc): IO[FuzzAcc] =
  fuzzSaveRepro(outDir, seed, run).flatMap(path => fuzzNoteFail2(outDir, run, acc, path))

def fuzzNoteFail2(_outDir: String, run: FuzzRun, acc: FuzzAcc, path: String): IO[FuzzAcc] =
  IO.println(Str.concat("fuzz failure on corpus ", Str.concat(run.path, Str.concat(" (", Str.concat(Str.fromInt(List.len(Verify.linesOf(run.script))), " events)"))))).flatMap(_ => IO.println(Str.concat("replay: scuzz fuzz --replay ", path)).flatMap(_ => IO.pure(FuzzAcc(acc.fail + 1, acc.corpFail + 1, path))))

def fuzzSaveRepro(outDir: String, seed: Int, run: FuzzRun): IO[String] =
  Fs.mkdirs(joinSlash(outDir, "fuzz")).flatMap(_ => fuzzSaveRepro2(outDir, seed, run))

def fuzzSaveRepro2(outDir: String, seed: Int, run: FuzzRun): IO[String] =
  fuzzSaveRepro3(joinSlash(joinSlash(outDir, "fuzz"), "repro.toml"), seed, run)

def fuzzSaveRepro3(path: String, seed: Int, run: FuzzRun): IO[String] =
  Fs.write(path, if (run.src != "") run.src else Verify.reproText(seed, run.sched, run.fault, Verify.linesOf(run.script))).map(_ => path)

def fuzzDrivePath(outDir: String): String =
  joinSlash(joinSlash(outDir, "fuzz"), "drive.txt")

def fuzzWriteSeeds(outDir: String, script: String): IO[Unit] =
  Fs.mkdirs(joinSlash(outDir, "fuzz")).flatMap(_ => Fs.write(joinSlash(outDir, "seeds.txt"), script))

def fuzzDumpPath(outDir: String): String =
  joinSlash(joinSlash(outDir, "fuzz"), "dump.txt")

def fuzzClassPath(outDir: String): String =
  joinSlash(joinSlash(outDir, "fuzz"), "classify.dump")

def fuzzWriteDrive(outDir: String, script: String): IO[Unit] =
  Fs.mkdirs(joinSlash(outDir, "fuzz")).flatMap(_ => Fs.write(fuzzDrivePath(outDir), script))

def fuzzSeedText(dir: String, files: List[(String, String)]): IO[String] =
  Fs.list(dir).flatMap(ents => fuzzSeedGo(dir, ents, Verify.noStr(), Verify.ensOfFiles(files)))

def fuzzSeedGo(dir: String, ents: List[(String, Bool)], acc: List[String], ens: List[En]): IO[String] =
  if (List.isEmpty(ents)) IO.pure(Verify.nls(Verify.sortStrs(acc))) else fuzzSeedHd(dir, List.at(ents, 0), List.tail(ents), acc, ens)

def fuzzSeedHd(dir: String, ent: (String, Bool), rest: List[(String, Bool)], acc: List[String], ens: List[En]): IO[String] =
  ent match {
    case (name, isDir) => fuzzSeedPick(dir, name, isDir, rest, acc, ens)
  }

def fuzzSeedPick(dir: String, name: String, isDir: Bool, rest: List[(String, Bool)], acc: List[String], ens: List[En]): IO[String] =
  if (isDir || !isVerify(name)) fuzzSeedGo(dir, rest, acc, ens) else Fs.read(joinSlash(dir, name)).flatMap(src => fuzzSeedGo(dir, rest, fuzzSeedAdd(acc, src, ens), ens))

def fuzzSeedAdd(acc: List[String], src: String, ens: List[En]): List[String] =
  List.concat(acc, Verify.mapSeedE(Verify.parseVerify(src), ens))

def fuzzSearch(exe: String, hasUi: Bool, outDir: String, script: String, n: Int, fail: Int, i: Int, seed: Int): IO[Int] =
  if (n <= 0) IO.pure(fail) else fuzzWriteDrive(outDir, script).flatMap(_ => fuzzProbeRun(exe, hasUi, outDir, FuzzRun("", "", script, Str.fromInt(i), "")).flatMap(bad => fuzzSearchHit(exe, hasUi, outDir, script, n, fail, i, seed, bad)))

def fuzzSearchHit(exe: String, hasUi: Bool, outDir: String, script: String, n: Int, fail: Int, i: Int, seed: Int, bad: Int): IO[Int] =
  if (bad > 0 && fail == 0) fuzzSaveRepro(outDir, seed, FuzzRun(joinSlash(outDir, "seeds.txt"), "", script, Str.fromInt(i), "")).flatMap(_ => fuzzSearch(exe, hasUi, outDir, script, n - 1, fail + bad, i + 1, seed)) else fuzzSearch(exe, hasUi, outDir, script, n - 1, fail + bad, i + 1, seed)

def fuzzProbeRun(exe: String, hasUi: Bool, outDir: String, run: FuzzRun): IO[Int] =
  runProbe(Str.concat(fuzzProbeEnv(hasUi, fuzzDrivePath(outDir), fuzzDumpPath(outDir), run.script != "", run.sched, run.fault, outDir), exe)).map(r => fuzzProbeCode(r))

def fuzzProbeEnv(hasUi: Bool, scriptPath: String, dumpPath: String, hasScript: Bool, sched: String, fault: String, outDir: String): String =
  Str.concat(testEnv(), Str.concat(if (hasUi) headlessEnv() else "", Str.concat(fuzzScriptEnv(hasUi, scriptPath, dumpPath, hasScript), Str.concat(fuzzSchedEnv(sched), Str.concat(fuzzFaultEnv(fault), fuzzClassEnv(outDir))))))

def fuzzScriptEnv(hasUi: Bool, scriptPath: String, dumpPath: String, hasScript: Bool): String =
  if (hasScript) fuzzDriveEnv(hasUi, scriptPath, dumpPath) else if (hasUi) Str.concat("SCUZZ_UI_TAP=1 SCUZZ_FUZZ_DUMP=", Str.concat(dumpPath, " ")) else ""

def fuzzDriveEnv(hasUi: Bool, scriptPath: String, dumpPath: String): String =
  if (hasUi) Str.concat("SCUZZ_UI_SCRIPT=", Str.concat(scriptPath, Str.concat(" SCUZZ_FUZZ_DUMP=", Str.concat(dumpPath, " ")))) else Str.concat("SCUZZ_DRIVE_SCRIPT=", Str.concat(scriptPath, " "))

def fuzzSchedEnv(sched: String): String =
  if (sched == "") "" else Str.concat("SCUZZ_SCHED_SEED=", Str.concat(sched, " "))

def fuzzFaultEnv(fault: String): String =
  if (fault == "") "" else Str.concat("SCUZZ_FAULT_SEED=", Str.concat(fault, " "))

def fuzzClassEnv(outDir: String): String =
  Str.concat("SCUZZ_CLASSIFY_DUMP=", Str.concat(fuzzClassPath(outDir), " "))

def fuzzProbeCode(r: (Int, String, String)): Int =
  r match {
    case (code, _out, _err) => if (code == 0) 0 else 1
  }

def fuzzDone(job: FuzzJob, corpus: Int, fail: Int, corpFail: Int, repro: String, mut: FuzzMut): IO[Unit] =
  fuzzWriteSummary(job, corpus, fail, corpFail, repro, mut).flatMap(_ => IO.println(Verify.fuzzOut2(Verify.fuzzHead(job.iterations, corpus, mut.sites), Verify.searchN(job.iterations), job.seed, corpus, mut.sites, fail, corpFail, Mutate.fuzzMutLine(mut.killed, mut.survived, mut.inert, mut.ran, mut.sites))).flatMap(_ => if (fail > 0) IO.fail("scuzz fuzz") else IO.pure(())))

def fuzzWriteSummary(job: FuzzJob, corpus: Int, fail: Int, corpFail: Int, repro: String, mut: FuzzMut): IO[Unit] =
  Fs.mkdirs(joinSlash(job.outDir, "fuzz")).flatMap(_ => fuzzPromoOf(job.outDir).flatMap(promo => fuzzClassText(job.outDir).flatMap(ct => Fs.write(joinSlash(joinSlash(job.outDir, "fuzz"), "summary.toml"), Verify.summaryToml(fail == 0, job.seed, job.iterations, Verify.searchN(job.iterations), fail, corpus, corpFail, promo, repro, mut.killed, mut.survived, mut.inert, mut.ran, mut.sites, job.oracles, ct)))))

def fuzzPromoOf(outDir: String): IO[String] =
  Fs.read(joinSlash(joinSlash(outDir, "fuzz"), "promo")).map(_ => "1").handleErrorWith(_ => IO.pure("0"))

def fuzzClassText(outDir: String): IO[String] =
  Fs.read(fuzzClassPath(outDir)).map(t => Verify.classToml(t)).handleErrorWith(_ => IO.pure(""))

def fuzzMutate(job: FuzzJob, corpus: Int, fail: Int, corpFail: Int, repro: String): IO[Unit] =
  fuzzMutate2(job, corpus, fail, corpFail, repro, Mutate.countFiles(job.files, job.oracles))

def fuzzMutate2(job: FuzzJob, corpus: Int, fail: Int, corpFail: Int, repro: String, sites: Int): IO[Unit] =
  fuzzMutate3(job, corpus, fail, corpFail, repro, sites, if (Verify.mutateN(job.iterations) < sites) Verify.mutateN(job.iterations) else sites)

def fuzzMutate3(job: FuzzJob, corpus: Int, fail: Int, corpFail: Int, repro: String, sites: Int, take: Int): IO[Unit] =
  if (sites == 0) fuzzMutNone(job, corpus, fail, corpFail, repro, sites) else if (take <= 0) fuzzDone(job, corpus, fail, corpFail, repro, emptyMut(sites)) else IO.println(Mutate.mutateHead(take, sites, job.oracles)).flatMap(_ => fuzzMutBase(job).flatMap(base => fuzzMutGo(job, Mutate.pickSites(job.seed, take, sites), base, emptyMut(sites), take).flatMap(mut => fuzzMutFin(job, corpus, fail, corpFail, repro, mut, take))))

def fuzzMutNone(job: FuzzJob, corpus: Int, fail: Int, corpFail: Int, repro: String, sites: Int): IO[Unit] =
  IO.println(if (job.oracles) "scuzz fuzz: no residual Property.check / Property.assert / .require sites" else "scuzz fuzz: no live-code mutation sites").flatMap(_ => fuzzDone(job, corpus, fail, corpFail, repro, emptyMut(sites)))

def fuzzMutFin(job: FuzzJob, corpus: Int, fail: Int, corpFail: Int, repro: String, mut: FuzzMut, take: Int): IO[Unit] =
  IO.println(Str.concat("scuzz fuzz mutate: ", Str.concat(Str.fromInt(mut.killed), Str.concat(" killed, ", Str.concat(Str.fromInt(mut.survived), Str.concat(" survived, ", Str.concat(Str.fromInt(mut.inert), Str.concat(" inert (", Str.concat(Str.fromInt(take), " ran)"))))))))).flatMap(_ => fuzzDone(job, corpus, fail, corpFail, repro, FuzzMut(mut.killed, mut.survived, mut.inert, take, mut.sites)))

def fuzzMutBase(job: FuzzJob): IO[String] =
  fuzzIdleAt(job.exe, job.hasUi, joinSlash(joinSlash(job.outDir, "fuzz"), "mutate/baseline")).map(p => fuzzIdleTl(p))

def fuzzIdleTl(p: (Int, String)): String =
  p._2

def fuzzMutGo(job: FuzzJob, sites: List[Int], base: String, acc: FuzzMut, take: Int): IO[FuzzMut] =
  if (List.isEmpty(sites)) IO.pure(acc) else fuzzMutOne(job, List.at(sites, 0), base, acc).flatMap(next => fuzzMutGo(job, List.tail(sites), base, next, take))

def fuzzMutOne(job: FuzzJob, site: Int, base: String, acc: FuzzMut): IO[FuzzMut] =
  fuzzMutCompile(job, site).flatMap(exe => fuzzMutRun(job, site, exe, base, acc))

def fuzzMutCompile(job: FuzzJob, site: Int): IO[String] =
  fuzzMutCompile2(job, site, joinSlash(joinSlash(joinSlash(job.outDir, "fuzz"), "mutate"), Str.fromInt(site)), Mutate.applyFiles(job.files, site, job.oracles))

def fuzzMutCompile2(job: FuzzJob, _site: Int, mutDir: String, files: List[(String, String)]): IO[String] =
  Fs.mkdirs(mutDir).flatMap(_ => emitDirAlwaysGot(fuzzToml(job), files, mutDir).flatMap(_ => fuzzMutLink(job, mutDir)))

def fuzzToml(job: FuzzJob): String =
  Str.concat("[package]\nname = \"", Str.concat(job.name, "\"\n"))

def fuzzMutLink(job: FuzzJob, mutDir: String): IO[String] =
  runLinkLine(job.hasUi, mutDir, job.name).map(r => fuzzMutLinkGot(r, exeName(mutDir, job.name)))

def fuzzMutLinkGot(r: (Int, String, String), exe: String): String =
  r match {
    case (code, _out, _err) => if (code == 0) exe else ""
  }

def fuzzMutRun(job: FuzzJob, site: Int, exe: String, base: String, acc: FuzzMut): IO[FuzzMut] =
  if (exe == "") IO.println(Str.concat("  mutant ", Str.concat(Str.fromInt(site), ": killed (compile)"))).map(_ => FuzzMut(acc.killed + 1, acc.survived, acc.inert, acc.ran, acc.sites)) else fuzzIdleAt(exe, job.hasUi, joinSlash(joinSlash(joinSlash(job.outDir, "fuzz"), "mutate"), Str.fromInt(site))).flatMap(p => fuzzMutClass(site, p, base, acc))

def fuzzMutClass(site: Int, p: (Int, String), base: String, acc: FuzzMut): IO[FuzzMut] =
  fuzzMutClass2(site, p._1, p._2, base, acc)

def fuzzMutClass2(site: Int, code: Int, tl: String, base: String, acc: FuzzMut): IO[FuzzMut] =
  if (code != 0) IO.println(Str.concat("  mutant ", Str.concat(Str.fromInt(site), ": killed"))).map(_ => FuzzMut(acc.killed + 1, acc.survived, acc.inert, acc.ran, acc.sites)) else if (tl == base) IO.pure(FuzzMut(acc.killed, acc.survived, acc.inert + 1, acc.ran, acc.sites)) else IO.println(Str.concat("  mutant ", Str.concat(Str.fromInt(site), ": survived"))).map(_ => FuzzMut(acc.killed, acc.survived + 1, acc.inert, acc.ran, acc.sites))

def fuzzIdleAt(exe: String, hasUi: Bool, mutDir: String): IO[(Int, String)] =
  Fs.mkdirs(mutDir).flatMap(_ => Fs.write(joinSlash(mutDir, "timeline.txt"), "").flatMap(_ => runProbe(Str.concat(fuzzProbeEnv(hasUi, joinSlash(mutDir, "drive.txt"), joinSlash(mutDir, "dump.txt"), false, "", "", mutDir), Str.concat(fuzzTlEnv(joinSlash(mutDir, "timeline.txt")), exe))).flatMap(r => fuzzIdleGot(mutDir, r))))

def fuzzTlEnv(path: String): String =
  Str.concat("SCUZZ_TIMELINE_DUMP=", Str.concat(path, " "))

def fuzzIdleGot(mutDir: String, r: (Int, String, String)): IO[(Int, String)] =
  r match {
    case (code, _out, _err) => fuzzIdleRead(mutDir, code)
  }

def fuzzIdleRead(mutDir: String, code: Int): IO[(Int, String)] =
  Fs.read(joinSlash(mutDir, "timeline.txt")).handleErrorWith(_ => IO.pure("")).map(tl => (code, tl))

def fuzzRelate(dir: String, outDir: String): IO[Unit] =
  fuzzCollect(dir).flatMap(files => emitDirAlways(dir, outDir, files).flatMap(_ => compileLinkedMan(dir, outDir).flatMap(_ => fuzzRelateLinked(dir, outDir, files))))

def fuzzRelateLinked(dir: String, outDir: String, files: List[(String, String)]): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => fuzzRelateMan(Manifest.parse(toml), dir, outDir, files))

def fuzzRelateMan(m: Man, dir: String, outDir: String, files: List[(String, String)]): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)).flatMap(_ => IO.fail("toml")) else fuzzRelateJob(exeName(outDir, m.name), m.hasUi, dir, outDir, files)

def fuzzRelateJob(exe: String, hasUi: Bool, dir: String, outDir: String, files: List[(String, String)]): IO[Unit] =
  fuzzSeedText(dir, files).flatMap(script => fuzzWriteSeeds(outDir, script).flatMap(_ => fuzzCorpusFiles(dir).flatMap(runs => fuzzRelateGo(exe, hasUi, outDir, fuzzAddSeeds(runs, joinSlash(outDir, "seeds.txt"), script)))))

def fuzzRelateGo(exe: String, hasUi: Bool, outDir: String, runs: List[FuzzRun]): IO[Unit] =
  if (List.isEmpty(runs)) IO.println("scuzz fuzz: --relate: no corpus entries") else Fs.mkdirs(joinSlash(joinSlash(outDir, "fuzz"), "relate")).flatMap(_ => fuzzRelateAcc(exe, hasUi, joinSlash(joinSlash(outDir, "fuzz"), "relate"), runs, 0, 0, List.len(runs)))

def fuzzRelateAcc(exe: String, hasUi: Bool, relDir: String, runs: List[FuzzRun], n: Int, fail: Int, total: Int): IO[Unit] =
  if (List.isEmpty(runs)) fuzzRelateDone(fail, total) else fuzzRelateOne(exe, hasUi, relDir, List.at(runs, 0), n).flatMap(bad => fuzzRelateAcc(exe, hasUi, relDir, List.tail(runs), n + 1, fail + bad, total))

def fuzzRelateDone(fail: Int, total: Int): IO[Unit] =
  if (fail > 0) IO.println(Str.concat("fuzz --relate: ", Str.concat(Str.fromInt(fail), Str.concat(" of ", Str.concat(Str.fromInt(total), " entries failed"))))).flatMap(_ => IO.fail("relate")) else IO.println(Str.concat("scuzz fuzz: --relate: ", Str.concat(Str.fromInt(total), " entries ok")))

def fuzzRelateOne(exe: String, hasUi: Bool, relDir: String, run: FuzzRun, n: Int): IO[Int] =
  fuzzRelateOne2(exe, hasUi, relDir, run, n, relateLabel(run), Verify.perturbSched(run.sched, Verify.relateSeed(relateLabel(run), run.sched, run.script, n)))

def fuzzRelateOne2(exe: String, hasUi: Bool, relDir: String, run: FuzzRun, n: Int, label: String, pert: String): IO[Int] =
  fuzzRelateOne3(exe, hasUi, relDir, run, n, label, pert, joinSlash(relDir, Str.concat(Str.fromInt(n), ".a.txt")), joinSlash(relDir, Str.concat(Str.fromInt(n), ".b.txt")))

def fuzzRelateOne3(exe: String, hasUi: Bool, relDir: String, run: FuzzRun, n: Int, label: String, pert: String, a: String, b: String): IO[Int] =
  relateExec(exe, hasUi, relDir, a, Str.concat(Str.fromInt(n), ".a"), run.script, run.sched, run.fault).flatMap(codeA => fuzzRelateOne4(exe, hasUi, relDir, run, n, label, pert, a, b, codeA))

def fuzzRelateOne4(exe: String, hasUi: Bool, relDir: String, run: FuzzRun, n: Int, label: String, pert: String, a: String, b: String, codeA: Int): IO[Int] =
  relateExec(exe, hasUi, relDir, b, Str.concat(Str.fromInt(n), ".b"), run.script, pert, run.fault).flatMap(codeB => fuzzRelateJudge(exe, a, b, label, codeA, codeB))

def fuzzRelateJudge(exe: String, a: String, b: String, label: String, codeA: Int, codeB: Int): IO[Int] =
  fuzzRelateNote(label, "a", codeA).flatMap(fa => fuzzRelateJudgeB(exe, a, b, label, fa, codeB))

def fuzzRelateJudgeB(exe: String, a: String, b: String, label: String, fa: Int, codeB: Int): IO[Int] =
  fuzzRelateNote(label, "b", codeB).flatMap(fb => fuzzRelateJudgeC(exe, a, b, label, fa, fb))

def fuzzRelateJudgeC(exe: String, a: String, b: String, label: String, fa: Int, fb: Int): IO[Int] =
  relateJudge(exe, a, b).flatMap(fj => fuzzRelateFin(label, fa + fb + fj))

def fuzzRelateNote(label: String, tag: String, code: Int): IO[Int] =
  if (code == 0) IO.pure(0) else IO.println(Str.concat("relate failed: ", Str.concat(label, Str.concat(" (run ", Str.concat(tag, Str.concat(" exited ", Str.concat(Str.fromInt(code), ")"))))))).map(_ => 1)

def fuzzRelateFin(label: String, fail: Int): IO[Int] =
  if (fail > 0) IO.pure(1) else IO.println(Str.concat("relate ok: ", label)).map(_ => 0)

def relateLabel(run: FuzzRun): String =
  relateLabel2(baseName(run.path), run.script)

def relateLabel2(name: String, script: String): String =
  if (name == "seeds.txt") Str.concat("seeds.txt:", firstLine(script)) else name

def baseName(path: String): String =
  baseNameAt(path, Str.len(path) - 1)

def baseNameAt(path: String, i: Int): String =
  if (i < 0) path else if (Str.charAt(path, i) == 47) Str.slice(path, i + 1, Str.len(path)) else baseNameAt(path, i - 1)

def firstLine(s: String): String =
  if (List.isEmpty(Verify.linesOf(s))) "" else List.at(Verify.linesOf(s), 0)

def relateExec(exe: String, hasUi: Bool, relDir: String, out: String, tag: String, script: String, sched: String, fault: String): IO[Int] =
  relateExec2(exe, hasUi, relDir, out, tag, script, sched, fault, joinSlash(relDir, Str.concat(tag, ".script.txt")), joinSlash(relDir, Str.concat(tag, ".sometimes")))

def relateExec2(exe: String, hasUi: Bool, relDir: String, out: String, tag: String, script: String, sched: String, fault: String, scriptPath: String, reached: String): IO[Int] =
  Fs.write(out, "").flatMap(_ => Fs.write(reached, "").flatMap(_ => Fs.write(scriptPath, script).flatMap(_ => Fs.write(joinSlash(relDir, Str.concat(tag, ".dump.txt")), "").flatMap(_ => runProbe(Str.concat(relateEnv(hasUi, scriptPath, joinSlash(relDir, Str.concat(tag, ".dump.txt")), script != "", out, reached, sched, fault), exe)).flatMap(r => relateExecGot(r))))))

def relateExecGot(r: (Int, String, String)): IO[Int] =
  r match {
    case (code, out, err) => relateExecCode(code, out, err)
  }

def relateExecCode(code: Int, out: String, err: String): IO[Int] =
  if (code == 0) IO.pure(0) else IO.println(if (Str.len(err) > 0) err else out).map(_ => code)

def relateEnv(hasUi: Bool, scriptPath: String, dumpPath: String, hasScript: Bool, tl: String, reached: String, sched: String, fault: String): String =
  Str.concat(relateBaseEnv(hasUi), Str.concat(relateScriptEnv(hasUi, scriptPath, dumpPath, hasScript), Str.concat(fuzzTlEnv(tl), Str.concat(Str.concat("SCUZZ_SOMETIMES_DUMP=", Str.concat(reached, " ")), Str.concat(fuzzSchedEnv(sched), fuzzFaultEnv(fault))))))

def relateBaseEnv(hasUi: Bool): String =
  Str.concat(testEnv(), if (hasUi) headlessEnv() else "")

def relateScriptEnv(hasUi: Bool, scriptPath: String, dumpPath: String, hasScript: Bool): String =
  if (!hasScript) "" else if (hasUi) Str.concat("SCUZZ_UI_SCRIPT=", Str.concat(scriptPath, Str.concat(" SCUZZ_FUZZ_DUMP=", Str.concat(dumpPath, " ")))) else Str.concat("SCUZZ_DRIVE_SCRIPT=", Str.concat(scriptPath, " "))

def relateJudge(exe: String, a: String, b: String): IO[Int] =
  runLine(Str.concat("SCUZZ_JUDGE_REL=", Str.concat(a, Str.concat(",", Str.concat(b, Str.concat(" ", exe)))))).flatMap(r => relateJudgeGot(r))

def relateJudgeGot(r: (Int, String, String)): IO[Int] =
  r match {
    case (code, out, err) => if (code == 0) IO.pure(0) else IO.println(if (Str.len(err) > 0) err else out).map(_ => 1)
  }

