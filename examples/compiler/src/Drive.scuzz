record Build(ok: Bool, ir: String, diags: String)

record PkgOut(ok: Bool, name: String, ll: String, llPath: String, link: String, diags: String)

record FuzzRun(path: String, src: String, script: String, sched: String, fault: String)

record FuzzAcc(fail: Int, corpFail: Int, repro: String)

record FuzzMut(killed: Int, survived: Int, inert: Int, ran: Int, sites: Int)

record FuzzJob(dir: String, outDir: String, exe: String, name: String, hasUi: Bool, iterations: Int, seed: Int, noFailFast: Bool, files: List[(String, String)])

import Manifest.Man

def compileSrc(src: String): Build =
  compileSrc2(Check.check(src), src)

def compileSrc2(diags: String, src: String): Build =
  if (diags == "[]") Build(true, Emit.emit(src), diags) else Build(false, "", diags)

def joinSlash(a: String, b: String): String =
  if (a == "") b else if (Str.charAt(a, Str.len(a) - 1) == 47) Str.concat(a, b) else Str.concat(a, Str.concat("/", b))

def llName(outDir: String, name: String): String =
  joinSlash(outDir, Str.concat(name, ".ll"))

def exeName(outDir: String, name: String): String =
  joinSlash(outDir, name)

def linkLine(clang: String, ll: String, lib: String, exe: String): String =
  Str.concat(clang, Str.concat(" -Wno-override-module ", Str.concat(ll, Str.concat(" ", Str.concat(lib, Str.concat(" -lpthread -o ", exe))))))

def skiaLib(): String =
  "crates/ffi-skia/build/libsk_capi.a"

def deskLib(): String =
  "crates/embedder-desktop/build/libscuzz_embedder.a"

def mobLib(): String =
  "crates/embedder-mobile/build/libscuzz_mobile.a"

def uiFlags1(): String =
  " -lstdc++ -lm -lz -lbz2 -Wl,--whole-archive "

def uiFlags2(): String =
  " -Wl,--no-whole-archive -lX11 -Wl,--whole-archive "

def uiFlags3(): String =
  " -Wl,--no-whole-archive -lpthread -rdynamic -o "

def linkLineUi(clang: String, ll: String, lib: String, exe: String): String =
  Str.concat(clang, Str.concat(" -Wno-override-module ", Str.concat(ll, Str.concat(" ", Str.concat(lib, Str.concat(" ", Str.concat(skiaLib(), Str.concat(uiFlags1(), Str.concat(deskLib(), Str.concat(uiFlags2(), Str.concat(mobLib(), Str.concat(uiFlags3(), exe))))))))))))

def linkLineFor(hasUi: Bool, clang: String, ll: String, lib: String, exe: String): String =
  if (hasUi) linkLineUi(clang, ll, lib, exe) else linkLine(clang, ll, lib, exe)

def missToml(dir: String): String =
  Str.concat("missing scuzz.toml in ", dir)

def showMan(m: Man): String =
  if (!m.ok) Str.concat("err:", m.err) else Str.concat("name=", Str.concat(m.name, Str.concat(" ver=", Str.concat(m.version, Str.concat(" ui=", Str.concat(if (m.hasUi) "true" else "false", Str.concat(" deps=", Str.fromInt(List.len(m.deps)))))))))

def compilePkg(toml: String, src: String, outDir: String, clang: String, lib: String): PkgOut =
  compilePkg2(Manifest.parse(toml), src, outDir, clang, lib)

def compilePkg2(m: Man, src: String, outDir: String, clang: String, lib: String): PkgOut =
  if (!m.ok) PkgOut(false, "", "", "", "", m.err) else compilePkg3(m, src, compileSrc(src), outDir, clang, lib)

def compilePkg3(m: Man, src: String, b: Build, outDir: String, clang: String, lib: String): PkgOut =
  if (!b.ok) PkgOut(false, m.name, "", "", "", b.diags) else compilePkg4(m, src, outDir, clang, lib)

def compilePkg4(m: Man, src: String, outDir: String, clang: String, lib: String): PkgOut =
  PkgOut(true, m.name, Emit.emitFull(src), llName(outDir, m.name), linkLine(clang, llName(outDir, m.name), lib, exeName(outDir, m.name)), "[]")

def compileFiles(toml: String, files: List[(String, String)], outDir: String, clang: String, lib: String): PkgOut =
  compileFiles2(Manifest.parse(toml), files, outDir, clang, lib)

def compileFiles2(m: Man, files: List[(String, String)], outDir: String, clang: String, lib: String): PkgOut =
  if (!m.ok) PkgOut(false, "", "", "", "", m.err) else compileFiles3(m, Emit.emitFullFiles(files), outDir, clang, lib)

def compileFiles3(m: Man, ll: String, outDir: String, clang: String, lib: String): PkgOut =
  PkgOut(true, m.name, ll, llName(outDir, m.name), linkLine(clang, llName(outDir, m.name), lib, exeName(outDir, m.name)), "[]")

def rtLib(): String =
  "crates/runtime/build/libscuzz_rt.a"

def isScuzz(name: String): Bool =
  Str.len(name) > 6 && Str.slice(name, Str.len(name) - 6, Str.len(name)) == ".scuzz"

def stemOf(name: String): String =
  Str.slice(name, 0, Str.len(name) - 6)

def emitDir(dir: String, outDir: String, full: Bool): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => emitDirMan(dir, outDir, full, Manifest.parse(toml)))

def emitDirMan(dir: String, outDir: String, full: Bool, m: Man): IO[Unit] =
  m match {
    case Man(ok, name, version, hasUi, deps, err) => emitDirMan2(dir, outDir, full, ok, err, deps)
  }

def emitDirMan2(dir: String, outDir: String, full: Bool, ok: Bool, err: String, deps: List[(String, String)]): IO[Unit] =
  if (!ok) IO.println(Str.concat("fail:", err)) else Fs.list(joinSlash(dir, "src")).flatMap(ents => emitDirListed(dir, outDir, full, deps, ents))

def emitDirListed(dir: String, outDir: String, full: Bool, deps: List[(String, String)], ents: List[(String, Bool)]): IO[Unit] =
  readSrcFiles(joinSlash(dir, "src"), ents).flatMap(own => emitDirCollected(dir, outDir, full, deps, own))

def emitDirCollected(dir: String, outDir: String, full: Bool, deps: List[(String, String)], own: List[(String, String)]): IO[Unit] =
  collectDeps(dir, deps, own).flatMap(files => emitDirReady(dir, outDir, full, files))

def emitDirReady(dir: String, outDir: String, full: Bool, files: List[(String, String)]): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => emitDirFp(dir, outDir, full, files, toml, fpText(toml, files)))

def fpPath(dir: String): String =
  joinSlash(joinSlash(dir, ".scuzz"), "fingerprint")

def fpText(toml: String, files: List[(String, String)]): String =
  Str.concat(toml, fpFiles(files))

def fpFiles(files: List[(String, String)]): String =
  if (List.isEmpty(files)) "" else fpFilesHd(List.head(files), List.tail(files))

def fpFilesHd(h: (String, String), rest: List[(String, String)]): String =
  h match {
    case (stem, src) => Str.concat(stem, Str.concat("""
""", Str.concat(src, Str.concat("""
""", fpFiles(rest)))))
  }

def emitDirFp(dir: String, outDir: String, full: Bool, files: List[(String, String)], toml: String, fp: String): IO[Unit] =
  if (full) emitDirFresh(dir, outDir, files, toml, fp) else emitDirHit(dir, outDir, files, toml, fp)

def emitDirHit(dir: String, outDir: String, files: List[(String, String)], toml: String, fp: String): IO[Unit] =
  Fs.read(fpPath(dir)).flatMap(old => emitDirHitGot(dir, outDir, files, toml, fp, old)).handleErrorWith(_ =>
    emitDirFresh(dir, outDir, files, toml, fp)
  )

def emitDirHitGot(dir: String, outDir: String, files: List[(String, String)], toml: String, fp: String, old: String): IO[Unit] =
  if (old == fp) emitDirUp(outDir, toml) else emitDirFresh(dir, outDir, files, toml, fp)

def emitDirUp(outDir: String, toml: String): IO[Unit] =
  emitDirUpMan(outDir, Manifest.parse(toml))

def emitDirUpMan(outDir: String, m: Man): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)) else IO.println(Str.concat("up-to-date ", exeName(outDir, m.name)))

def emitDirFresh(dir: String, outDir: String, files: List[(String, String)], toml: String, fp: String): IO[Unit] =
  emitDirOut(compileFiles(toml, files, outDir, "clang", rtLib())).flatMap(ok => emitDirStored(dir, fp, ok))

def emitDirStored(dir: String, fp: String, ok: Bool): IO[Unit] =
  if (!ok) IO.pure(()) else Fs.mkdirs(joinSlash(dir, ".scuzz")).flatMap(_ => Fs.write(fpPath(dir), fp))

def emitDirAlways(dir: String, outDir: String, own: List[(String, String)]): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => emitDirAlwaysGot(toml, own, outDir))

def emitDirAlwaysGot(toml: String, own: List[(String, String)], outDir: String): IO[Unit] =
  emitDirOut(compileFiles(toml, own, outDir, "clang", rtLib())).map(_ => ())

def emitFuzz(dir: String, outDir: String): IO[Unit] =
  fuzzCollect(dir).flatMap(files => emitDirAlways(dir, outDir, files))

def fuzzCollect(dir: String): IO[List[(String, String)]] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => fuzzCollectMan(dir, Manifest.parse(toml)))

def fuzzCollectMan(dir: String, m: Man): IO[List[(String, String)]] =
  m match {
    case Man(ok, _name, _version, _hasUi, deps, err) => fuzzCollectMan2(dir, ok, err, deps)
  }

def fuzzCollectMan2(dir: String, ok: Bool, err: String, deps: List[(String, String)]): IO[List[(String, String)]] =
  if (!ok) IO.println(Str.concat("fail:", err)).flatMap(_ => IO.pure(Manifest.noPairs())) else Fs.list(joinSlash(dir, "src")).flatMap(ents => fuzzCollectListed(dir, deps, ents))

def fuzzCollectListed(dir: String, deps: List[(String, String)], ents: List[(String, Bool)]): IO[List[(String, String)]] =
  readSrcFiles(joinSlash(dir, "src"), ents).flatMap(own =>
    collectDeps(dir, deps, own).flatMap(files => fuzzSimFiles(dir, deps, files).flatMap(simmed => fuzzReadDrv(joinSlash(dir, "src")).flatMap(drv => fuzzCollectVer(dir, simmed, drv))))
  )

def fuzzSimFiles(dir: String, deps: List[(String, String)], files: List[(String, String)]): IO[List[(String, String)]] =
  if (List.isEmpty(files)) IO.pure(files) else fuzzSimHd(dir, deps, List.head(files), List.tail(files))

def fuzzSimHd(dir: String, deps: List[(String, String)], h: (String, String), rest: List[(String, String)]): IO[List[(String, String)]] =
  h match {
    case (stem, src) => fuzzSimOne(dir, deps, stem, src).flatMap(got => fuzzSimFiles(dir, deps, rest).map(more => (stem, got) :: more))
  }

def fuzzSimOne(dir: String, deps: List[(String, String)], stem: String, src: String): IO[String] =
  fuzzSimPath(joinSlash(joinSlash(dir, "src"), Str.concat(stem, ".scuzz_sim")), src).handleErrorWith(_ =>
    fuzzSimDeps(dir, deps, stem, src)
  )

def fuzzSimPath(path: String, src: String): IO[String] =
  Fs.read(path).map(sim => Verify.applySim(src, sim))

def fuzzSimDeps(dir: String, deps: List[(String, String)], stem: String, src: String): IO[String] =
  if (List.isEmpty(deps)) IO.pure(src) else fuzzSimDepHd(dir, List.head(deps), List.tail(deps), stem, src)

def fuzzSimDepHd(dir: String, d: (String, String), rest: List[(String, String)], stem: String, src: String): IO[String] =
  d match {
    case (_name, path) => fuzzSimPath(joinSlash(joinSlash(joinSlash(dir, path), "src"), Str.concat(stem, ".scuzz_sim")), src).handleErrorWith(_ =>
      fuzzSimDeps(dir, rest, stem, src)
    )
  }

def fuzzReadDrv(srcDir: String): IO[String] =
  Fs.list(srcDir).flatMap(ents => fuzzDrvGo(srcDir, ents, "")).handleErrorWith(_ =>
    IO.pure("")
  )

def fuzzDrvGo(srcDir: String, ents: List[(String, Bool)], acc: String): IO[String] =
  if (List.isEmpty(ents)) IO.pure(acc) else fuzzDrvHd(srcDir, List.head(ents), List.tail(ents), acc)

def fuzzDrvHd(srcDir: String, ent: (String, Bool), rest: List[(String, Bool)], acc: String): IO[String] =
  ent match {
    case (name, isDir) => fuzzDrvPick(srcDir, name, isDir, rest, acc)
  }

def fuzzDrvPick(srcDir: String, name: String, isDir: Bool, rest: List[(String, Bool)], acc: String): IO[String] =
  if (isDir || !isDrivers(name)) fuzzDrvGo(srcDir, rest, acc) else Fs.read(joinSlash(srcDir, name)).flatMap(src => fuzzDrvGo(srcDir, rest, Str.concat(acc, src)))

def isDrivers(name: String): Bool =
  Str.len(name) > 14 && Str.slice(name, Str.len(name) - 14, Str.len(name)) == ".scuzz_drivers"

def fuzzCollectVer(dir: String, files: List[(String, String)], drv: String): IO[List[(String, String)]] =
  Fs.list(dir).flatMap(ents => emitFuzzVerGo(dir, files, drv, ents, Manifest.noPairs()))

def emitFuzzVerGo(dir: String, files: List[(String, String)], drv: String, ents: List[(String, Bool)], ver: List[(String, String)]): IO[List[(String, String)]] =
  if (List.isEmpty(ents)) IO.pure(fuzzFiles(files, ver, drv)) else emitFuzzVerHd(dir, files, drv, List.head(ents), List.tail(ents), ver)

def emitFuzzVerHd(dir: String, files: List[(String, String)], drv: String, ent: (String, Bool), rest: List[(String, Bool)], ver: List[(String, String)]): IO[List[(String, String)]] =
  ent match {
    case (name, isDir) => emitFuzzVerPick(dir, files, drv, name, isDir, rest, ver)
  }

def emitFuzzVerPick(dir: String, files: List[(String, String)], drv: String, name: String, isDir: Bool, rest: List[(String, Bool)], ver: List[(String, String)]): IO[List[(String, String)]] =
  if (isDir || !isVerify(name)) emitFuzzVerGo(dir, files, drv, rest, ver) else Fs.read(joinSlash(dir, name)).flatMap(src => emitFuzzVerGo(dir, files, drv, rest, (stemVerify(name), src) :: ver))

def stemVerify(name: String): String =
  Str.slice(name, 0, Str.len(name) - 13)

def fuzzFiles(files: List[(String, String)], ver: List[(String, String)], drv: String): List[(String, String)] =
  List.concat(Verify.rewriteReqFiles(files), fuzzWrap(ver, drv))

def fuzzWrap(ver: List[(String, String)], drv: String): List[(String, String)] =
  fuzzWrapGot(Str.concat(Verify.wrapFiles(ver), drv))

def fuzzWrapGot(src: String): List[(String, String)] =
  if (src == "") Manifest.noPairs() else (Verify.wrapMod(), src) :: Manifest.noPairs()

def collectDeps(dir: String, deps: List[(String, String)], acc: List[(String, String)]): IO[List[(String, String)]] =
  if (List.isEmpty(deps)) IO.pure(acc) else collectDepGo(dir, deps, acc)

def collectDepGo(dir: String, deps: List[(String, String)], acc: List[(String, String)]): IO[List[(String, String)]] =
  collectDepHead(dir, List.head(deps), deps, acc)

def collectDepHead(dir: String, d: (String, String), deps: List[(String, String)], acc: List[(String, String)]): IO[List[(String, String)]] =
  collectDep(dir, d, List.tail(deps), acc)

def collectDep(dir: String, d: (String, String), rest: List[(String, String)], acc: List[(String, String)]): IO[List[(String, String)]] =
  d match {
    case (name, path) => collectDepNamed(dir, name, path, rest, acc)
  }

def collectDepNamed(dir: String, _name: String, path: String, rest: List[(String, String)], acc: List[(String, String)]): IO[List[(String, String)]] =
  collectPkg(joinSlash(dir, path), dir, rest, acc)

def collectPkg(pkgDir: String, parentDir: String, rest: List[(String, String)], acc: List[(String, String)]): IO[List[(String, String)]] =
  Fs.read(joinSlash(pkgDir, "scuzz.toml")).flatMap(toml => collectPkgMan(pkgDir, parentDir, rest, acc, Manifest.parse(toml)))

def collectPkgMan(pkgDir: String, parentDir: String, rest: List[(String, String)], acc: List[(String, String)], m: Man): IO[List[(String, String)]] =
  m match {
    case Man(ok, name, version, hasUi, nested, err) => collectPkgOk(pkgDir, parentDir, rest, acc, ok, nested)
  }

def collectPkgOk(pkgDir: String, parentDir: String, rest: List[(String, String)], acc: List[(String, String)], ok: Bool, nested: List[(String, String)]): IO[List[(String, String)]] =
  if (!ok) collectDeps(parentDir, rest, acc) else Fs.list(joinSlash(pkgDir, "src")).flatMap(ents => collectPkgListed(pkgDir, parentDir, rest, acc, nested, ents))

def collectPkgListed(pkgDir: String, parentDir: String, rest: List[(String, String)], acc: List[(String, String)], nested: List[(String, String)], ents: List[(String, Bool)]): IO[List[(String, String)]] =
  readSrcFiles(joinSlash(pkgDir, "src"), ents).flatMap(more => collectPkgGot(pkgDir, parentDir, rest, acc, nested, more))

def collectPkgGot(pkgDir: String, parentDir: String, rest: List[(String, String)], acc: List[(String, String)], nested: List[(String, String)], more: List[(String, String)]): IO[List[(String, String)]] =
  collectDeps(pkgDir, nested, acc).flatMap(withNested => collectAfterNested(parentDir, rest, withNested, more))

def collectAfterNested(parentDir: String, rest: List[(String, String)], withNested: List[(String, String)], more: List[(String, String)]): IO[List[(String, String)]] =
  collectDeps(parentDir, rest, appendNew(withNested, more))

def hasStem(xs: List[(String, String)], stem: String): Bool =
  hasStemAt(xs, stem, 0)

def hasStemAt(xs: List[(String, String)], stem: String, i: Int): Bool =
  hasStemAt2(xs, stem, i, List.len(xs))

def hasStemAt2(xs: List[(String, String)], stem: String, i: Int, n: Int): Bool =
  if (i >= n) false else hasStemAt3(xs, stem, i, n)

def hasStemAt3(xs: List[(String, String)], stem: String, i: Int, n: Int): Bool =
  hasStemFrom(List.at(xs, i), xs, stem, i, n)

def hasStemFrom(p: (String, String), xs: List[(String, String)], stem: String, i: Int, n: Int): Bool =
  p match {
    case (name, src) => hasStemName(name, xs, stem, i, n)
  }

def hasStemName(name: String, xs: List[(String, String)], stem: String, i: Int, n: Int): Bool =
  if (name == stem) true else hasStemAt2(xs, stem, i + 1, n)

def appendNew(acc: List[(String, String)], more: List[(String, String)]): List[(String, String)] =
  if (List.isEmpty(more)) acc else appendNewGo(acc, List.head(more), more)

def appendNewGo(acc: List[(String, String)], h: (String, String), more: List[(String, String)]): List[(String, String)] =
  appendNewPick(acc, h, List.tail(more))

def appendNewPick(acc: List[(String, String)], h: (String, String), rest: List[(String, String)]): List[(String, String)] =
  h match {
    case (stem, src) => appendNewKnown(acc, stem, src, rest)
  }

def appendNewKnown(acc: List[(String, String)], stem: String, src: String, rest: List[(String, String)]): List[(String, String)] =
  if (hasStem(acc, stem)) appendNew(acc, rest) else appendNew((stem, src) :: acc, rest)

def readSrcFiles(srcDir: String, ents: List[(String, Bool)]): IO[List[(String, String)]] =
  readSrcAcc(srcDir, ents, Manifest.noPairs())

def readSrcAcc(srcDir: String, ents: List[(String, Bool)], acc: List[(String, String)]): IO[List[(String, String)]] =
  if (List.isEmpty(ents)) IO.pure(acc) else readSrcAccGo(srcDir, ents, acc)

def readSrcAccGo(srcDir: String, ents: List[(String, Bool)], acc: List[(String, String)]): IO[List[(String, String)]] =
  readSrcHd(srcDir, List.head(ents), acc, ents)

def readSrcHd(srcDir: String, ent: (String, Bool), acc: List[(String, String)], ents: List[(String, Bool)]): IO[List[(String, String)]] =
  readSrcHd2(srcDir, ent, acc, List.tail(ents))

def readSrcHd2(srcDir: String, ent: (String, Bool), acc: List[(String, String)], rest: List[(String, Bool)]): IO[List[(String, String)]] =
  ent match {
    case (name, isDir) => readSrcPick(srcDir, name, isDir, rest, acc)
  }

def readSrcPick(srcDir: String, name: String, isDir: Bool, rest: List[(String, Bool)], acc: List[(String, String)]): IO[List[(String, String)]] =
  if (isDir) readSrcAcc(srcDir, rest, acc) else if (!isScuzz(name)) readSrcAcc(srcDir, rest, acc) else Fs.read(joinSlash(srcDir, name)).flatMap(src => readSrcAcc(srcDir, rest, (stemOf(name), src) :: acc))

def emitDirOut(p: PkgOut): IO[Bool] =
  p match {
    case PkgOut(ok, name, ll, llPath, link, diags) => emitDirWrite(ok, ll, llPath, diags)
  }

def emitDirWrite(ok: Bool, ll: String, llPath: String, diags: String): IO[Bool] =
  if (!ok) IO.println(Str.concat("fail:", diags)).map(_ => false) else Fs.write(llPath, ll).flatMap(_ =>
  IO.println("ok").map(_ => true)
)

def runDir(dir: String, outDir: String, env: String): IO[Unit] =
  emitDir(dir, outDir, true).flatMap(_ => linkRun(dir, outDir, env))

def linkRun(dir: String, outDir: String, env: String): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => linkRunMan(Manifest.parse(toml), outDir, env))

def linkRunMan(m: Man, outDir: String, env: String): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)) else linkRunUi(m.hasUi, m.name, outDir, env)

def linkRunUi(hasUi: Bool, name: String, outDir: String, env: String): IO[Unit] =
  if (hasUi) ensureUi().flatMap(_ => linkRunNamed(true, name, outDir, env)) else linkRunNamed(false, name, outDir, env)

def ensureUi(): IO[Unit] =
  runLine("make -C crates/ffi-skia lib CC=clang").flatMap(r => ensureUiDesk(r))

def ensureUiDesk(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) IO.println(err) else runLine("make -C crates/embedder-desktop lib CC=clang").flatMap(r2 => ensureUiMob(r2))
  }

def ensureUiMob(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) IO.println(err) else runLine("make -C crates/embedder-mobile lib CC=clang").flatMap(r2 => ensureUiDone(r2))
  }

def ensureUiDone(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) IO.println(err) else IO.pure(())
  }

def linkRunNamed(hasUi: Bool, name: String, outDir: String, env: String): IO[Unit] =
  runLine(linkLineFor(hasUi, "clang", llName(outDir, name), rtLib(), exeName(outDir, name))).flatMap(r => afterClang(r, exeName(outDir, name), env))

def runLine(cmd: String): IO[(Int, String, String)] =
  Sys.exec(cmd)

def afterClang(r: (Int, String, String), exe: String, env: String): IO[Unit] =
  r match {
    case (code, out, err) => afterClang2(code, out, err, exe, env)
  }

def afterClang2(code: Int, _out: String, err: String, exe: String, env: String): IO[Unit] =
  if (code != 0) IO.println(err) else runLine(Str.concat(env, exe)).flatMap(r => afterRun(r))

def afterRun(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, out, err) => afterRun2(code, out, err)
  }

def afterRun2(code: Int, out: String, err: String): IO[Unit] =
  if (code != 0) IO.println(err) else Sys.write(out)

def testEnv(): String =
  "SCUZZ_TESTRT=1 SCUZZ_SERVE=1 SCUZZ_KIT=sealed "

def headlessEnv(): String =
  "SCUZZ_UI_RUNTIME=headless SCUZZ_UI_WIDTH=200 SCUZZ_UI_HEIGHT=120 SCUZZ_UI_SCALE=1 "

def checkDir(dir: String, json: Bool): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => checkDirMan(dir, json, Manifest.parse(toml)))

def checkDirMan(dir: String, json: Bool, m: Man): IO[Unit] =
  m match {
    case Man(ok, _name, _version, _hasUi, deps, err) => checkDirMan2(dir, json, ok, err, deps)
  }

def checkDirMan2(dir: String, json: Bool, ok: Bool, err: String, deps: List[(String, String)]): IO[Unit] =
  if (!ok) IO.println(Str.concat("fail:", err)) else Fs.list(joinSlash(dir, "src")).flatMap(ents => checkDirListed(dir, json, deps, ents))

def isVerify(name: String): Bool =
  Str.len(name) > 13 && Str.slice(name, Str.len(name) - 13, Str.len(name)) == ".scuzz_verify"

def checkDirListed(dir: String, json: Bool, deps: List[(String, String)], ents: List[(String, Bool)]): IO[Unit] =
  readSrcFiles(joinSlash(dir, "src"), ents).flatMap(own => checkDirVerify(dir, json, deps, own))

def checkDirVerify(dir: String, json: Bool, deps: List[(String, String)], own: List[(String, String)]): IO[Unit] =
  Fs.list(dir).flatMap(ents => checkVerifyGo(dir, json, deps, own, ents))

def checkVerifyGo(dir: String, json: Bool, deps: List[(String, String)], own: List[(String, String)], ents: List[(String, Bool)]): IO[Unit] =
  if (List.isEmpty(ents)) collectDeps(dir, deps, own).flatMap(files => checkFmtGo(json, files, own)) else checkVerifyHd(dir, json, deps, own, List.head(ents), List.tail(ents))

def checkVerifyHd(dir: String, json: Bool, deps: List[(String, String)], own: List[(String, String)], ent: (String, Bool), rest: List[(String, Bool)]): IO[Unit] =
  ent match {
    case (name, isDir) => checkVerifyPick(dir, json, deps, own, name, isDir, rest)
  }

def checkVerifyPick(dir: String, json: Bool, deps: List[(String, String)], own: List[(String, String)], name: String, isDir: Bool, rest: List[(String, Bool)]): IO[Unit] =
  if (isDir || !isVerify(name)) checkVerifyGo(dir, json, deps, own, rest) else Fs.read(joinSlash(dir, name)).flatMap(src => checkVerifySrc(dir, json, deps, own, name, src, rest))

def checkVerifySrc(dir: String, json: Bool, deps: List[(String, String)], own: List[(String, String)], name: String, src: String, rest: List[(String, Bool)]): IO[Unit] =
  checkVerifyGot(dir, json, deps, own, rest, Verify.checkVerify(src, name))

def checkVerifyGot(dir: String, json: Bool, deps: List[(String, String)], own: List[(String, String)], rest: List[(String, Bool)], msg: String): IO[Unit] =
  if (msg == "scuzz check ok") checkVerifyGo(dir, json, deps, own, rest) else IO.println(msg).flatMap(_ => IO.fail("scuzz check"))

def checkFmtGo(json: Bool, all: List[(String, String)], rest: List[(String, String)]): IO[Unit] =
  if (List.isEmpty(rest)) checkDirOut(json, Check.checkFiles(all), Check.humanFiles(all), all) else checkFmtHd(json, all, List.head(rest), List.tail(rest))

def checkFmtHd(json: Bool, all: List[(String, String)], h: (String, String), rest: List[(String, String)]): IO[Unit] =
  h match {
    case (stem, src) => checkFmtSrc(json, all, stem, src, rest)
  }

def checkFmtSrc(json: Bool, all: List[(String, String)], stem: String, src: String, rest: List[(String, String)]): IO[Unit] =
  if (Parse.pretty(Parse.parse(Lexer.lex(src))) == src) checkFmtGo(json, all, rest) else checkFmtFail(stem)

def checkFmtFail(stem: String): IO[Unit] =
  IO.println(Str.concat(stem, ".scuzz:1:1: error: needs formatting (run scuzz fmt)")).flatMap(_ => IO.fail("scuzz check"))

def checkDirOut(json: Bool, diags: String, human: String, files: List[(String, String)]): IO[Unit] =
  if (json) checkDirJson(diags, files) else checkDirHuman(human)

def checkDirJson(diags: String, files: List[(String, String)]): IO[Unit] =
  if (diags == "[]") IO.println(Check.unclaimedJson(files)) else IO.println(diags).flatMap(_ => IO.fail("scuzz check"))

def checkDirHuman(human: String): IO[Unit] =
  if (human == "scuzz check ok") IO.println(human) else IO.println(human).flatMap(_ => IO.fail("scuzz check"))

def testDir(dir: String, outDir: String, update: Bool): IO[Unit] =
  emitDir(dir, outDir, true).flatMap(_ => testLink(dir, outDir, update))

def testLink(dir: String, outDir: String, update: Bool): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => testLinkMan(dir, Manifest.parse(toml), outDir, update))

def testLinkMan(dir: String, m: Man, outDir: String, update: Bool): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)) else testLinkUi(m.hasUi, dir, m.name, outDir, update)

def testLinkUi(hasUi: Bool, dir: String, name: String, outDir: String, update: Bool): IO[Unit] =
  if (hasUi) ensureUi().flatMap(_ => testLinkNamed(true, dir, name, outDir, update)) else testLinkNamed(false, dir, name, outDir, update)

def testLinkNamed(hasUi: Bool, dir: String, name: String, outDir: String, update: Bool): IO[Unit] =
  runLine(linkLineFor(hasUi, "clang", llName(outDir, name), rtLib(), exeName(outDir, name))).flatMap(r => testAfterClang(r, exeName(outDir, name), dir, outDir, name, hasUi, update))

def testAfterClang(r: (Int, String, String), exe: String, dir: String, outDir: String, name: String, hasUi: Bool, update: Bool): IO[Unit] =
  r match {
    case (code, out, err) => testAfterClang2(code, out, err, exe, dir, outDir, name, hasUi, update)
  }

def testAfterClang2(code: Int, _out: String, err: String, exe: String, dir: String, outDir: String, name: String, hasUi: Bool, update: Bool): IO[Unit] =
  if (code != 0) IO.println(err) else IO.println("project compile smoke ok").flatMap(_ => testAfterSmoke(hasUi, dir, outDir, name, exe, update))

def testAfterSmoke(hasUi: Bool, dir: String, outDir: String, name: String, exe: String, update: Bool): IO[Unit] =
  if (hasUi) testUi(dir, outDir, name, exe, update) else testRun(exe)

def uiDumpEnv(dump: String, snap: String, tap: Bool): String =
  Str.concat(headlessEnv(), Str.concat("SCUZZ_SNAPSHOT_PATH=", Str.concat(snap, Str.concat(" SCUZZ_FUZZ_DUMP=", Str.concat(dump, if (tap) " SCUZZ_UI_TAP=1 " else " ")))))

def testUi(dir: String, outDir: String, name: String, exe: String, update: Bool): IO[Unit] =
  if (update) Fs.mkdirs(joinSlash(dir, "goldens")).flatMap(_ => testUiDumps(dir, outDir, name, exe, update)) else testUiDumps(dir, outDir, name, exe, update)

def testUiDumps(dir: String, outDir: String, name: String, exe: String, update: Bool): IO[Unit] =
  testUiDump(dir, outDir, name, exe, update, false).flatMap(_ =>
    testUiDump(dir, outDir, name, exe, update, true).flatMap(_ => IO.println("scuzz test ok"))
  )

def testUiDump(dir: String, outDir: String, name: String, exe: String, update: Bool, tap: Bool): IO[Unit] =
  testUiRun(exe, uiDumpEnv(uiActual(outDir, name, tap), uiSnap(outDir, name, tap), tap), uiGolden(dir, name, tap), uiActual(outDir, name, tap), update)

def uiGolden(dir: String, name: String, tap: Bool): String =
  joinSlash(joinSlash(dir, "goldens"), if (tap) Str.concat(name, "_after_tap.dump") else Str.concat(name, ".dump"))

def uiActual(outDir: String, name: String, tap: Bool): String =
  joinSlash(outDir, if (tap) Str.concat(name, "_after_tap.actual.dump") else Str.concat(name, ".actual.dump"))

def uiSnap(outDir: String, name: String, tap: Bool): String =
  joinSlash(outDir, if (tap) Str.concat(name, "_after_tap.actual.png") else Str.concat(name, ".actual.png"))

def testUiRun(exe: String, env: String, golden: String, actual: String, update: Bool): IO[Unit] =
  runLine(Str.concat(env, exe)).flatMap(r => testUiAfter(r, golden, actual, update))

def testUiAfter(r: (Int, String, String), golden: String, actual: String, update: Bool): IO[Unit] =
  r match {
    case (code, out, err) => testUiAfter2(code, out, err, golden, actual, update)
  }

def testUiAfter2(code: Int, _out: String, err: String, golden: String, actual: String, update: Bool): IO[Unit] =
  if (code != 0) IO.println(err).flatMap(_ => IO.fail("ui golden")) else testUiCmp(golden, actual, update)

def testUiCmp(golden: String, actual: String, update: Bool): IO[Unit] =
  if (update) Fs.read(actual).flatMap(got =>
  Fs.write(golden, got).flatMap(_ => IO.println(Str.concat("golden updated: ", golden)))
) else Fs.read(golden).flatMap(want =>
  Fs.read(actual).flatMap(got => testUiEq(golden, want, got))
)

def testUiEq(golden: String, want: String, got: String): IO[Unit] =
  if (want == got) IO.println(Str.concat("golden ok: ", golden)) else IO.println(Str.concat("structural golden mismatch: ", golden)).flatMap(_ => IO.fail("golden"))

def testRun(exe: String): IO[Unit] =
  runLine(Str.concat(testEnv(), exe)).flatMap(r => testAfterRun(r))

def testAfterRun(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, out, err) => testAfterRun2(code, out, err)
  }

def testAfterRun2(code: Int, _out: String, err: String): IO[Unit] =
  if (code != 0) IO.println(err).flatMap(_ => IO.fail("IO smoke")) else IO.println("IO smoke ok").flatMap(_ => IO.println("scuzz test ok"))

def showPkg(p: PkgOut): String =
  if (!p.ok) Str.concat("fail:", p.diags) else Str.concat("ok name=", Str.concat(p.name, Str.concat(" ll=", Str.concat(p.llPath, Str.concat(" link=", p.link)))))

def xcodeMiss(): String =
  "missing Xcode — install Xcode from the App Store, then xcode-select --install"

def ndkMiss(): String =
  "missing Android NDK — install the NDK, then set ANDROID_NDK_HOME"

def sdkMiss(): String =
  "missing Android SDK — install the Android SDK, then set ANDROID_HOME"

def badTarget(t: String): String =
  Str.concat("unknown package target '", Str.concat(t, "' (host|android|ios|all). Example: scuzz package --target host"))

def bundleId(): String =
  "dev.scuzz.app"

def hostRunSh(name: String): String =
  Str.concat("#!/usr/bin/env bash\n# Host Mobile shell smoke. Same app binary; Mobile peer + host embedder.\nset -euo pipefail\nDIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nexport SCUZZ_UI_RUNTIME=mobile\nexport SCUZZ_MOBILE_SHELL=1\nexec \"$DIR/", Str.concat(name, "\" \"$@\"\n"))

def hostMeta(name: String): String =
  Str.concat("[package]\nname = \"", Str.concat(name, Str.concat("\"\ntarget = \"host\"\nbundle_id = \"", Str.concat(bundleId(), "\"\nruntime = \"mobile\"\n"))))

def linkOnly(hasUi: Bool, name: String, outDir: String): IO[Unit] =
  runLine(linkLineFor(hasUi, "clang", llName(outDir, name), rtLib(), exeName(outDir, name))).flatMap(r => linkOnlyGot(r))

def linkOnlyGot(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) IO.println(err).flatMap(_ => IO.fail("link")) else IO.pure(())
  }

def compileLinked(dir: String, outDir: String): IO[Unit] =
  emitDir(dir, outDir, true).flatMap(_ => compileLinkedMan(dir, outDir))

def compileLinkedMan(dir: String, outDir: String): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => compileLinkedUi(Manifest.parse(toml), outDir))

def compileLinkedUi(m: Man, outDir: String): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)).flatMap(_ => IO.fail("toml")) else if (m.hasUi) ensureUi().flatMap(_ => linkOnly(true, m.name, outDir)) else linkOnly(false, m.name, outDir)

def pkgDir(dir: String, outDir: String, target: String): IO[Unit] =
  if (target == "host") pkgHost(dir, outDir) else if (target == "android") pkgAndroid(dir) else if (target == "ios") pkgIos(dir) else if (target == "all") pkgHost(dir, outDir).flatMap(_ =>
  pkgAndroid(dir).flatMap(_ => pkgIos(dir))
) else IO.println(badTarget(target)).flatMap(_ => IO.fail("package"))

def pkgHost(dir: String, outDir: String): IO[Unit] =
  compileLinked(dir, outDir).flatMap(_ => pkgHostMan(dir, outDir))

def pkgHostMan(dir: String, outDir: String): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => pkgHostNamed(Manifest.parse(toml), dir, outDir))

def pkgHostNamed(m: Man, _dir: String, outDir: String): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)).flatMap(_ => IO.fail("toml")) else pkgHostCopy(m.name, exeName(outDir, m.name), joinSlash(joinSlash(outDir, "package"), "host"))

def pkgHostCopy(name: String, exe: String, dest: String): IO[Unit] =
  Fs.mkdirs(dest).flatMap(_ => pkgHostCp(name, exe, dest))

def pkgHostCp(name: String, exe: String, dest: String): IO[Unit] =
  runLine(Str.concat("cp ", Str.concat(exe, Str.concat(" ", joinSlash(dest, name))))).flatMap(r => pkgHostChmod(r, name, dest))

def pkgHostChmod(r: (Int, String, String), name: String, dest: String): IO[Unit] =
  r match {
    case (code, _out, err) => if (code != 0) IO.println(err).flatMap(_ => IO.fail("cp")) else runLine(Str.concat("chmod +x ", joinSlash(dest, name))).flatMap(_ => pkgHostWrite(name, dest))
  }

def pkgHostWrite(name: String, dest: String): IO[Unit] =
  Fs.write(joinSlash(dest, "run.sh"), hostRunSh(name)).flatMap(_ =>
    runLine(Str.concat("chmod +x ", joinSlash(dest, "run.sh"))).flatMap(_ =>
      Fs.write(joinSlash(dest, "package.toml"), hostMeta(name)).flatMap(_ =>
        IO.println(Str.concat("packaged host → ", dest)).flatMap(_ => IO.println(Str.concat("scuzz package ok (", Str.concat(dest, ")"))))
      )
    )
  )

def pkgAndroid(dir: String): IO[Unit] =
  runLine(Str.concat("bash crates/embedder-mobile/shells/android/build_ndk.sh ", dir)).flatMap(r => pkgAndroidNdk(r, dir))

def pkgAndroidNdk(r: (Int, String, String), dir: String): IO[Unit] =
  r match {
    case (code, out, err) => if (code != 0) pkgAndroidFail(out, err) else runLine(Str.concat("bash crates/embedder-mobile/shells/android/build_apk.sh ", dir)).flatMap(r2 => pkgAndroidApk(r2))
  }

def pkgAndroidApk(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, out, err) => if (code != 0) pkgAndroidFail(out, err) else IO.println("scuzz package ok (android)")
  }

def pkgAndroidFail(out: String, err: String): IO[Unit] =
  IO.println(if (Str.len(err) > 0) err else if (Str.len(out) > 0) out else ndkMiss()).flatMap(_ => IO.fail("android"))

def pkgIos(dir: String): IO[Unit] =
  runLine("xcrun --sdk iphonesimulator --show-sdk-path").flatMap(r => pkgIosGot(r, dir))

def pkgIosGot(r: (Int, String, String), dir: String): IO[Unit] =
  r match {
    case (code, _out, _err) => if (code != 0) IO.println(xcodeMiss()).flatMap(_ => IO.fail("ios")) else runLine(Str.concat("bash crates/embedder-mobile/shells/ios/build_sim.sh ", dir)).flatMap(r2 => pkgIosRun(r2))
  }

def pkgIosRun(r: (Int, String, String)): IO[Unit] =
  r match {
    case (code, out, err) => if (code != 0) IO.println(if (Str.len(err) > 0) err else out).flatMap(_ => IO.fail("ios")) else IO.println("scuzz package ok (ios)")
  }

def fuzzDir(dir: String, outDir: String, iterations: Int, seed: Int, replay: String, noFailFast: Bool): IO[Unit] =
  fuzzCollect(dir).flatMap(files =>
    emitDirAlways(dir, outDir, files).flatMap(_ =>
      compileLinkedMan(dir, outDir).flatMap(_ =>
        fuzzLiveBuild(dir, outDir).flatMap(_ => fuzzLinked(dir, outDir, iterations, seed, replay, files, noFailFast))
      )
    )
  )

def fuzzLiveBuild(dir: String, outDir: String): IO[Unit] =
  fuzzLiveCollect(dir).flatMap(files => fuzzLiveEmit(dir, joinSlash(outDir, "live"), files))

def fuzzLiveEmit(dir: String, liveDir: String, files: List[(String, String)]): IO[Unit] =
  Fs.mkdirs(liveDir).flatMap(_ =>
    emitDirAlways(dir, liveDir, files).flatMap(_ => compileLinkedMan(dir, liveDir))
  )

def fuzzLiveCollect(dir: String): IO[List[(String, String)]] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => fuzzLiveMan(dir, Manifest.parse(toml)))

def fuzzLiveMan(dir: String, m: Man): IO[List[(String, String)]] =
  m match {
    case Man(ok, _name, _version, _hasUi, deps, err) => fuzzLiveMan2(dir, ok, err, deps)
  }

def fuzzLiveMan2(dir: String, ok: Bool, err: String, deps: List[(String, String)]): IO[List[(String, String)]] =
  if (!ok) IO.println(Str.concat("fail:", err)).flatMap(_ => IO.pure(Manifest.noPairs())) else Fs.list(joinSlash(dir, "src")).flatMap(ents => fuzzLiveListed(dir, deps, ents))

def fuzzLiveListed(dir: String, deps: List[(String, String)], ents: List[(String, Bool)]): IO[List[(String, String)]] =
  readSrcFiles(joinSlash(dir, "src"), ents).flatMap(own => collectDeps(dir, deps, own))

def fuzzLinked(dir: String, outDir: String, iterations: Int, seed: Int, replay: String, files: List[(String, String)], noFailFast: Bool): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => fuzzMan(Manifest.parse(toml), dir, outDir, iterations, seed, replay, files, noFailFast))

def fuzzMan(m: Man, dir: String, outDir: String, iterations: Int, seed: Int, replay: String, files: List[(String, String)], noFailFast: Bool): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)).flatMap(_ => IO.fail("toml")) else fuzzMan2(FuzzJob(dir, outDir, exeName(outDir, m.name), m.name, m.hasUi, iterations, seed, noFailFast, files), replay)

def fuzzMan2(job: FuzzJob, replay: String): IO[Unit] =
  if (replay != "") fuzzReplayFile(job.outDir, job.exe, job.hasUi, replay) else fuzzBody(job)

def fuzzReplayFile(outDir: String, exe: String, hasUi: Bool, replay: String): IO[Unit] =
  Fs.read(replay).flatMap(src => fuzzReplayGot(outDir, exe, hasUi, replay, src))

def fuzzReplayGot(outDir: String, exe: String, hasUi: Bool, replay: String, src: String): IO[Unit] =
  fuzzReplayRun(outDir, exe, hasUi, replay, fuzzRunOf(replay, src))

def fuzzReplayRun(outDir: String, exe: String, hasUi: Bool, replay: String, run: FuzzRun): IO[Unit] =
  IO.println(fuzzReplayHead(replay, run)).flatMap(_ =>
    fuzzWriteDrive(outDir, run.script).flatMap(_ =>
      fuzzProbeRun(exe, hasUi, outDir, run).flatMap(bad => fuzzReplayDone(bad))
    )
  )

def fuzzReplayHead(replay: String, run: FuzzRun): String =
  Str.concat("scuzz fuzz --replay ", Str.concat(replay, Str.concat(" (", Str.concat(Str.fromInt(List.len(Verify.linesOf(run.script))), " events)"))))

def fuzzReplayDone(bad: Int): IO[Unit] =
  if (bad > 0) IO.println("fuzz replay reproduced a failure").flatMap(_ => IO.fail("fuzz")) else IO.println("fuzz replay ok (no failure)")

def fuzzBody(job: FuzzJob): IO[Unit] =
  fuzzSeedText(job.dir).flatMap(script => fuzzBody2(job, script))

def fuzzBody2(job: FuzzJob, script: String): IO[Unit] =
  fuzzWriteSeeds(job.outDir, script).flatMap(_ =>
    fuzzCorpusFiles(job.dir).flatMap(runs => fuzzBody3(job, script, runs))
  )

def fuzzBody3(job: FuzzJob, script: String, runs: List[FuzzRun]): IO[Unit] =
  fuzzSplit(job).flatMap(_ =>
    fuzzReplayGo(job.exe, job.hasUi, job.outDir, job.seed, fuzzAddSeeds(runs, joinSlash(job.outDir, "seeds.txt"), script), FuzzAcc(0, 0, "")).flatMap(acc => fuzzAfterReplay(job, script, List.len(fuzzAddSeeds(runs, joinSlash(job.outDir, "seeds.txt"), script)), acc))
  )

def fuzzAfterReplay(job: FuzzJob, script: String, corpus: Int, acc: FuzzAcc): IO[Unit] =
  if (acc.fail > 0 && !job.noFailFast) fuzzDone(job, corpus, acc.fail, acc.corpFail, acc.repro, emptyMut(Mutate.countFiles(job.files))) else fuzzSearch(job.exe, job.hasUi, job.outDir, script, Verify.searchN(job.iterations), 0).flatMap(fail => fuzzAfterSearch(job, script, corpus, acc, fail))

def fuzzAfterSearch(job: FuzzJob, script: String, corpus: Int, acc: FuzzAcc, fail: Int): IO[Unit] =
  if (fail > 0 && acc.repro == "") fuzzSearchFail(job, script, corpus, acc, fail) else fuzzMutate(job, corpus, fail, acc.corpFail, acc.repro)

def fuzzSearchFail(job: FuzzJob, script: String, corpus: Int, acc: FuzzAcc, fail: Int): IO[Unit] =
  fuzzSaveRepro(job.outDir, job.seed, FuzzRun(joinSlash(job.outDir, "seeds.txt"), "", script, "", "")).flatMap(path => fuzzMutate(job, corpus, fail, acc.corpFail, path))

def emptyMut(sites: Int): FuzzMut =
  FuzzMut(0, 0, 0, 0, sites)

def fuzzSplit(job: FuzzJob): IO[Unit] =
  if (!job.hasUi) IO.pure(()) else Fs.read(joinSlash(job.dir, "scuzz.toml")).flatMap(toml => fuzzSplitMan(job, Manifest.parse(toml)))

def fuzzSplitMan(job: FuzzJob, m: Man): IO[Unit] =
  fuzzHasSim(job.dir, m.deps).flatMap(sim => if (sim) IO.pure(()) else fuzzSplitGo(job))

def fuzzHasSim(dir: String, deps: List[(String, String)]): IO[Bool] =
  fuzzHasSimDir(joinSlash(dir, "src")).flatMap(hit => if (hit) IO.pure(true) else fuzzHasSimDeps(dir, deps))

def fuzzHasSimDir(srcDir: String): IO[Bool] =
  Fs.list(srcDir).map(ents => fuzzHasSimEnts(ents)).handleErrorWith(_ =>
    IO.pure(false)
  )

def fuzzHasSimEnts(ents: List[(String, Bool)]): Bool =
  if (List.isEmpty(ents)) false else fuzzHasSimHd(List.head(ents), List.tail(ents))

def fuzzHasSimHd(h: (String, Bool), rest: List[(String, Bool)]): Bool =
  h match {
    case (name, isDir) => if (!isDir && isSimName(name)) true else fuzzHasSimEnts(rest)
  }

def isSimName(name: String): Bool =
  Str.len(name) > 10 && Str.slice(name, Str.len(name) - 10, Str.len(name)) == ".scuzz_sim"

def fuzzHasSimDeps(dir: String, deps: List[(String, String)]): IO[Bool] =
  if (List.isEmpty(deps)) IO.pure(false) else fuzzHasSimDepHd(dir, List.head(deps), List.tail(deps))

def fuzzHasSimDepHd(dir: String, d: (String, String), rest: List[(String, String)]): IO[Bool] =
  d match {
    case (_name, path) => fuzzHasSimDir(joinSlash(joinSlash(dir, path), "src")).flatMap(hit => if (hit) IO.pure(true) else fuzzHasSimDeps(dir, rest))
  }

def fuzzLiveExe(job: FuzzJob): String =
  exeName(joinSlash(job.outDir, "live"), job.name)

def fuzzSplitGo(job: FuzzJob): IO[Unit] =
  Fs.mkdirs(joinSlash(job.outDir, "fuzz")).flatMap(_ =>
    Fs.mkdirs(joinSlash(joinSlash(job.outDir, "fuzz"), "live")).flatMap(_ => fuzzSplitRun(job))
  )

def fuzzSplitRun(job: FuzzJob): IO[Unit] =
  fuzzSplitProbe(job.exe, job.hasUi, fuzzDumpPath(job.outDir), fuzzTlPath(job.outDir)).flatMap(cv =>
    if (cv != 0) IO.println("fuzz probe failed: app fails under TestRuntime before any event").flatMap(_ => IO.fail("scuzz fuzz")) else fuzzSplitLive(job)
  )

def fuzzTlPath(outDir: String): String =
  joinSlash(joinSlash(outDir, "fuzz"), "timeline.txt")

def fuzzSplitLive(job: FuzzJob): IO[Unit] =
  fuzzSplitProbe(fuzzLiveExe(job), job.hasUi, joinSlash(joinSlash(joinSlash(job.outDir, "fuzz"), "live"), "dump.txt"), joinSlash(joinSlash(joinSlash(job.outDir, "fuzz"), "live"), "timeline.txt")).flatMap(cl =>
    if (cl != 0) IO.println("fuzz live/verify split: live graph failed on the same seed").flatMap(_ => IO.fail("scuzz fuzz")) else fuzzSplitCmp(job)
  )

def fuzzSplitProbe(exe: String, hasUi: Bool, dump: String, tl: String): IO[Int] =
  runLine(Str.concat(fuzzSplitEnv(hasUi, dump, tl), exe)).map(r => fuzzProbeCode(r))

def fuzzSplitEnv(hasUi: Bool, dump: String, tl: String): String =
  Str.concat(testEnv(), Str.concat(if (hasUi) headlessEnv() else "", Str.concat(Str.concat("SCUZZ_FUZZ_DUMP=", Str.concat(dump, " ")), fuzzTlEnv(tl))))

def fuzzSplitCmp(job: FuzzJob): IO[Unit] =
  fuzzReadOr(fuzzDumpPath(job.outDir)).flatMap(vd =>
    fuzzReadOr(joinSlash(joinSlash(joinSlash(job.outDir, "fuzz"), "live"), "dump.txt")).flatMap(ld =>
      fuzzReadOr(fuzzTlPath(job.outDir)).flatMap(vt =>
        fuzzReadOr(joinSlash(joinSlash(joinSlash(job.outDir, "fuzz"), "live"), "timeline.txt")).flatMap(lt => fuzzSplitEq(ld, vd, lt, vt))
      )
    )
  )

def fuzzReadOr(path: String): IO[String] =
  Fs.read(path).handleErrorWith(_ =>
    IO.pure("")
  )

def fuzzSplitEq(liveDump: String, verDump: String, liveTl: String, verTl: String): IO[Unit] =
  if (liveDump != verDump || liveTl != verTl) IO.println("fuzz live/verify split: silent observation mismatch").flatMap(_ => IO.fail("scuzz fuzz")) else IO.pure(())

def noRuns(): List[FuzzRun] =
  []

def fuzzRunOf(path: String, src: String): FuzzRun =
  FuzzRun(path, src, Verify.nls(Verify.parseEvents(src)), Verify.tomlQuoted(src, "schedule_seed"), Verify.tomlQuoted(src, "fault_seed"))

def fuzzCorpusFiles(dir: String): IO[List[FuzzRun]] =
  Fs.list(joinSlash(dir, "corpus")).flatMap(ents => fuzzCorpusRead(dir, Verify.sortStrs(fuzzTomlNames(ents, Verify.noStr())))).handleErrorWith(_ =>
    IO.pure(noRuns())
  )

def fuzzTomlNames(ents: List[(String, Bool)], acc: List[String]): List[String] =
  if (List.isEmpty(ents)) acc else fuzzTomlNamesHd(List.head(ents), List.tail(ents), acc)

def fuzzTomlNamesHd(h: (String, Bool), rest: List[(String, Bool)], acc: List[String]): List[String] =
  h match {
    case (name, isDir) => if (isDir) fuzzTomlNames(rest, acc) else if (Str.endsWith(name, ".toml")) fuzzTomlNames(rest, name :: acc) else fuzzTomlNames(rest, acc)
  }

def fuzzCorpusRead(dir: String, names: List[String]): IO[List[FuzzRun]] =
  if (List.isEmpty(names)) IO.pure(noRuns()) else fuzzCorpusReadHd(dir, List.head(names), List.tail(names))

def fuzzCorpusReadHd(dir: String, name: String, rest: List[String]): IO[List[FuzzRun]] =
  Fs.read(joinSlash(joinSlash(dir, "corpus"), name)).flatMap(src =>
    fuzzCorpusRead(dir, rest).map(more => fuzzRunOf(joinSlash(joinSlash(dir, "corpus"), name), src) :: more)
  )

def fuzzAddSeeds(runs: List[FuzzRun], seedsPath: String, script: String): List[FuzzRun] =
  fuzzAddSeedLines(runs, seedsPath, Verify.linesOf(script))

def fuzzAddSeedLines(runs: List[FuzzRun], seedsPath: String, lines: List[String]): List[FuzzRun] =
  if (List.isEmpty(lines)) runs else fuzzAddSeedLines(fuzzAddSeed(runs, seedsPath, List.head(lines)), seedsPath, List.tail(lines))

def fuzzAddSeed(runs: List[FuzzRun], seedsPath: String, line: String): List[FuzzRun] =
  if (line == "") runs else if (fuzzHasScript(runs, Str.concat(line, Verify.nl()))) runs else List.concat(runs, fuzzSeedRun(seedsPath, line) :: noRuns())

def fuzzSeedRun(seedsPath: String, line: String): FuzzRun =
  FuzzRun(seedsPath, "", Str.concat(line, Verify.nl()), "", "")

def fuzzHasScript(runs: List[FuzzRun], script: String): Bool =
  if (List.isEmpty(runs)) false else fuzzHasScriptHd(List.head(runs), List.tail(runs), script)

def fuzzHasScriptHd(h: FuzzRun, rest: List[FuzzRun], script: String): Bool =
  h.script == script || fuzzHasScript(rest, script)

def fuzzReplayGo(exe: String, hasUi: Bool, outDir: String, seed: Int, runs: List[FuzzRun], acc: FuzzAcc): IO[FuzzAcc] =
  if (List.isEmpty(runs) || acc.fail > 0) IO.pure(acc) else fuzzReplayOne(exe, hasUi, outDir, seed, List.head(runs), List.tail(runs), acc)

def fuzzReplayOne(exe: String, hasUi: Bool, outDir: String, seed: Int, h: FuzzRun, rest: List[FuzzRun], acc: FuzzAcc): IO[FuzzAcc] =
  fuzzWriteDrive(outDir, h.script).flatMap(_ =>
    fuzzProbeRun(exe, hasUi, outDir, h).flatMap(bad => fuzzReplayNext(exe, hasUi, outDir, seed, rest, acc, h, bad))
  )

def fuzzReplayNext(exe: String, hasUi: Bool, outDir: String, seed: Int, rest: List[FuzzRun], acc: FuzzAcc, h: FuzzRun, bad: Int): IO[FuzzAcc] =
  if (bad == 0) fuzzReplayGo(exe, hasUi, outDir, seed, rest, acc) else fuzzNoteFail(outDir, seed, h, acc).flatMap(next => fuzzReplayGo(exe, hasUi, outDir, seed, rest, next))

def fuzzNoteFail(outDir: String, seed: Int, run: FuzzRun, acc: FuzzAcc): IO[FuzzAcc] =
  fuzzSaveRepro(outDir, seed, run).flatMap(path => fuzzNoteFail2(outDir, run, acc, path))

def fuzzNoteFail2(_outDir: String, run: FuzzRun, acc: FuzzAcc, path: String): IO[FuzzAcc] =
  IO.println(Str.concat("fuzz failure on corpus ", Str.concat(run.path, Str.concat(" (", Str.concat(Str.fromInt(List.len(Verify.linesOf(run.script))), " events)"))))).flatMap(_ =>
    IO.println(Str.concat("replay: scuzz fuzz --replay ", path)).flatMap(_ => IO.pure(FuzzAcc(acc.fail + 1, acc.corpFail + 1, path)))
  )

def fuzzSaveRepro(outDir: String, seed: Int, run: FuzzRun): IO[String] =
  Fs.mkdirs(joinSlash(outDir, "fuzz")).flatMap(_ => fuzzSaveRepro2(outDir, seed, run))

def fuzzSaveRepro2(outDir: String, seed: Int, run: FuzzRun): IO[String] =
  fuzzSaveRepro3(joinSlash(joinSlash(outDir, "fuzz"), "repro.toml"), seed, run)

def fuzzSaveRepro3(path: String, seed: Int, run: FuzzRun): IO[String] =
  Fs.write(path, if (run.src != "") run.src else Verify.reproText(seed, run.sched, run.fault, Verify.linesOf(run.script))).map(_ => path)

def fuzzDrivePath(outDir: String): String =
  joinSlash(joinSlash(outDir, "fuzz"), "drive.txt")

def fuzzWriteSeeds(outDir: String, script: String): IO[Unit] =
  Fs.mkdirs(joinSlash(outDir, "fuzz")).flatMap(_ => Fs.write(joinSlash(outDir, "seeds.txt"), script))

def fuzzDumpPath(outDir: String): String =
  joinSlash(joinSlash(outDir, "fuzz"), "dump.txt")

def fuzzWriteDrive(outDir: String, script: String): IO[Unit] =
  Fs.mkdirs(joinSlash(outDir, "fuzz")).flatMap(_ => Fs.write(fuzzDrivePath(outDir), script))

def fuzzSeedText(dir: String): IO[String] =
  Fs.list(dir).flatMap(ents => fuzzSeedGo(dir, ents, Verify.noStr()))

def fuzzSeedGo(dir: String, ents: List[(String, Bool)], acc: List[String]): IO[String] =
  if (List.isEmpty(ents)) IO.pure(Verify.nls(Verify.sortStrs(acc))) else fuzzSeedHd(dir, List.head(ents), List.tail(ents), acc)

def fuzzSeedHd(dir: String, ent: (String, Bool), rest: List[(String, Bool)], acc: List[String]): IO[String] =
  ent match {
    case (name, isDir) => fuzzSeedPick(dir, name, isDir, rest, acc)
  }

def fuzzSeedPick(dir: String, name: String, isDir: Bool, rest: List[(String, Bool)], acc: List[String]): IO[String] =
  if (isDir || !isVerify(name)) fuzzSeedGo(dir, rest, acc) else Fs.read(joinSlash(dir, name)).flatMap(src => fuzzSeedGo(dir, rest, fuzzSeedAdd(acc, src)))

def fuzzSeedAdd(acc: List[String], src: String): List[String] =
  List.concat(acc, Verify.mapSeed(Verify.parseVerify(src)))

def fuzzSearch(exe: String, hasUi: Bool, outDir: String, script: String, n: Int, fail: Int): IO[Int] =
  if (n <= 0) IO.pure(fail) else fuzzWriteDrive(outDir, script).flatMap(_ =>
  fuzzProbe(exe, hasUi, outDir, script).flatMap(bad => fuzzSearch(exe, hasUi, outDir, script, n - 1, fail + bad))
)

def fuzzProbe(exe: String, hasUi: Bool, outDir: String, script: String): IO[Int] =
  runLine(Str.concat(fuzzProbeEnv(hasUi, fuzzDrivePath(outDir), fuzzDumpPath(outDir), script != "", "", ""), exe)).map(r => fuzzProbeCode(r))

def fuzzProbeRun(exe: String, hasUi: Bool, outDir: String, run: FuzzRun): IO[Int] =
  runLine(Str.concat(fuzzProbeEnv(hasUi, fuzzDrivePath(outDir), fuzzDumpPath(outDir), run.script != "", run.sched, run.fault), exe)).map(r => fuzzProbeCode(r))

def fuzzProbeEnv(hasUi: Bool, scriptPath: String, dumpPath: String, hasScript: Bool, sched: String, fault: String): String =
  Str.concat(testEnv(), Str.concat(if (hasUi) headlessEnv() else "", Str.concat(if (hasScript) fuzzDriveEnv(hasUi, scriptPath, dumpPath) else "", Str.concat(fuzzSchedEnv(sched), fuzzFaultEnv(fault)))))

def fuzzDriveEnv(hasUi: Bool, scriptPath: String, dumpPath: String): String =
  if (hasUi) Str.concat("SCUZZ_UI_SCRIPT=", Str.concat(scriptPath, Str.concat(" SCUZZ_FUZZ_DUMP=", Str.concat(dumpPath, " ")))) else Str.concat("SCUZZ_DRIVE_SCRIPT=", Str.concat(scriptPath, " "))

def fuzzSchedEnv(sched: String): String =
  if (sched == "") "" else Str.concat("SCUZZ_SCHED_SEED=", Str.concat(sched, " "))

def fuzzFaultEnv(fault: String): String =
  if (fault == "") "" else Str.concat("SCUZZ_FAULT_SEED=", Str.concat(fault, " "))

def fuzzProbeCode(r: (Int, String, String)): Int =
  r match {
    case (code, _out, _err) => if (code == 0) 0 else 1
  }

def fuzzDone(job: FuzzJob, corpus: Int, fail: Int, corpFail: Int, repro: String, mut: FuzzMut): IO[Unit] =
  fuzzWriteSummary(job, corpus, fail, corpFail, repro, mut).flatMap(_ =>
    IO.println(Verify.fuzzOut2(Verify.fuzzHead(job.iterations, corpus, mut.sites), Verify.searchN(job.iterations), job.seed, corpus, mut.sites, fail, corpFail, Mutate.fuzzMutLine(mut.killed, mut.survived, mut.inert, mut.ran, mut.sites))).flatMap(_ => if (fail > 0 || mut.survived > 0) IO.fail("scuzz fuzz") else IO.pure(()))
  )

def fuzzWriteSummary(job: FuzzJob, corpus: Int, fail: Int, corpFail: Int, repro: String, mut: FuzzMut): IO[Unit] =
  Fs.mkdirs(joinSlash(job.outDir, "fuzz")).flatMap(_ => Fs.write(joinSlash(joinSlash(job.outDir, "fuzz"), "summary.toml"), Verify.summaryToml(fail == 0 && mut.survived == 0, job.seed, job.iterations, Verify.searchN(job.iterations), fail, corpus, corpFail, repro, mut.killed, mut.survived, mut.inert, mut.ran, mut.sites)))

def fuzzMutate(job: FuzzJob, corpus: Int, fail: Int, corpFail: Int, repro: String): IO[Unit] =
  fuzzMutate2(job, corpus, fail, corpFail, repro, Mutate.countFiles(job.files))

def fuzzMutate2(job: FuzzJob, corpus: Int, fail: Int, corpFail: Int, repro: String, sites: Int): IO[Unit] =
  fuzzMutate3(job, corpus, fail, corpFail, repro, sites, if (Verify.mutateN(job.iterations) < sites) Verify.mutateN(job.iterations) else sites)

def fuzzMutate3(job: FuzzJob, corpus: Int, fail: Int, corpFail: Int, repro: String, sites: Int, take: Int): IO[Unit] =
  if (take <= 0) fuzzDone(job, corpus, fail, corpFail, repro, emptyMut(sites)) else IO.println(Mutate.mutateHead(take, sites)).flatMap(_ =>
  fuzzMutBase(job).flatMap(base =>
    fuzzMutGo(job, Mutate.pickSites(job.seed, take, sites), base, emptyMut(sites), take).flatMap(mut => fuzzMutFin(job, corpus, fail, corpFail, repro, mut, take))
  )
)

def fuzzMutFin(job: FuzzJob, corpus: Int, fail: Int, corpFail: Int, repro: String, mut: FuzzMut, take: Int): IO[Unit] =
  IO.println(Str.concat("scuzz fuzz mutate: ", Str.concat(Str.fromInt(mut.killed), Str.concat(" killed, ", Str.concat(Str.fromInt(mut.survived), Str.concat(" survived, ", Str.concat(Str.fromInt(mut.inert), Str.concat(" inert (", Str.concat(Str.fromInt(take), " ran)"))))))))).flatMap(_ => fuzzDone(job, corpus, fail, corpFail, repro, FuzzMut(mut.killed, mut.survived, mut.inert, take, mut.sites)))

def fuzzMutBase(job: FuzzJob): IO[String] =
  fuzzIdleAt(job.exe, job.hasUi, joinSlash(joinSlash(job.outDir, "fuzz"), "mutate/baseline")).map(p => fuzzIdleTl(p))

def fuzzIdleTl(p: (Int, String)): String =
  p match {
    case (_code, tl) => tl
  }

def fuzzMutGo(job: FuzzJob, sites: List[Int], base: String, acc: FuzzMut, take: Int): IO[FuzzMut] =
  if (List.isEmpty(sites)) IO.pure(acc) else fuzzMutOne(job, List.head(sites), base, acc).flatMap(next => fuzzMutGo(job, List.tail(sites), base, next, take))

def fuzzMutOne(job: FuzzJob, site: Int, base: String, acc: FuzzMut): IO[FuzzMut] =
  fuzzMutCompile(job, site).flatMap(exe => fuzzMutRun(job, site, exe, base, acc))

def fuzzMutCompile(job: FuzzJob, site: Int): IO[String] =
  fuzzMutCompile2(job, site, joinSlash(joinSlash(joinSlash(job.outDir, "fuzz"), "mutate"), Str.fromInt(site)), Mutate.applyFiles(job.files, site))

def fuzzMutCompile2(job: FuzzJob, _site: Int, mutDir: String, files: List[(String, String)]): IO[String] =
  Fs.mkdirs(mutDir).flatMap(_ =>
    emitDirAlwaysGot(fuzzToml(job), files, mutDir).flatMap(_ => fuzzMutLink(job, mutDir))
  )

def fuzzToml(job: FuzzJob): String =
  Str.concat("[package]\nname = \"", Str.concat(job.name, "\"\n"))

def fuzzMutLink(job: FuzzJob, mutDir: String): IO[String] =
  runLine(linkLineFor(job.hasUi, "clang", llName(mutDir, job.name), rtLib(), exeName(mutDir, job.name))).map(r => fuzzMutLinkGot(r, exeName(mutDir, job.name)))

def fuzzMutLinkGot(r: (Int, String, String), exe: String): String =
  r match {
    case (code, _out, _err) => if (code == 0) exe else ""
  }

def fuzzMutRun(job: FuzzJob, site: Int, exe: String, base: String, acc: FuzzMut): IO[FuzzMut] =
  if (exe == "") IO.println(Str.concat("  mutant ", Str.concat(Str.fromInt(site), ": killed (compile)"))).map(_ => FuzzMut(acc.killed + 1, acc.survived, acc.inert, acc.ran, acc.sites)) else fuzzIdleAt(exe, job.hasUi, joinSlash(joinSlash(joinSlash(job.outDir, "fuzz"), "mutate"), Str.fromInt(site))).flatMap(p => fuzzMutClass(site, p, base, acc))

def fuzzMutClass(site: Int, p: (Int, String), base: String, acc: FuzzMut): IO[FuzzMut] =
  p match {
    case (code, tl) => fuzzMutClass2(site, code, tl, base, acc)
  }

def fuzzMutClass2(site: Int, code: Int, tl: String, base: String, acc: FuzzMut): IO[FuzzMut] =
  if (code != 0) IO.println(Str.concat("  mutant ", Str.concat(Str.fromInt(site), ": killed"))).map(_ => FuzzMut(acc.killed + 1, acc.survived, acc.inert, acc.ran, acc.sites)) else if (tl == base) IO.pure(FuzzMut(acc.killed, acc.survived, acc.inert + 1, acc.ran, acc.sites)) else IO.println(Str.concat("  mutant ", Str.concat(Str.fromInt(site), ": survived"))).map(_ => FuzzMut(acc.killed, acc.survived + 1, acc.inert, acc.ran, acc.sites))

def fuzzIdleAt(exe: String, hasUi: Bool, mutDir: String): IO[(Int, String)] =
  Fs.mkdirs(mutDir).flatMap(_ =>
    Fs.write(joinSlash(mutDir, "timeline.txt"), "").flatMap(_ =>
      runLine(Str.concat(fuzzProbeEnv(hasUi, joinSlash(mutDir, "drive.txt"), joinSlash(mutDir, "dump.txt"), false, "", ""), Str.concat(fuzzTlEnv(joinSlash(mutDir, "timeline.txt")), exe))).flatMap(r => fuzzIdleGot(mutDir, r))
    )
  )

def fuzzTlEnv(path: String): String =
  Str.concat("SCUZZ_TIMELINE_DUMP=", Str.concat(path, " "))

def fuzzIdleGot(mutDir: String, r: (Int, String, String)): IO[(Int, String)] =
  r match {
    case (code, _out, _err) => Fs.read(joinSlash(mutDir, "timeline.txt")).handleErrorWith(_ =>
  IO.pure("")
).map(tl => (code, tl))
  }

def fuzzRelate(dir: String, outDir: String): IO[Unit] =
  fuzzCollect(dir).flatMap(files =>
    emitDirAlways(dir, outDir, files).flatMap(_ =>
      compileLinkedMan(dir, outDir).flatMap(_ => fuzzRelateLinked(dir, outDir))
    )
  )

def fuzzRelateLinked(dir: String, outDir: String): IO[Unit] =
  Fs.read(joinSlash(dir, "scuzz.toml")).flatMap(toml => fuzzRelateMan(Manifest.parse(toml), dir, outDir))

def fuzzRelateMan(m: Man, dir: String, outDir: String): IO[Unit] =
  if (!m.ok) IO.println(Str.concat("fail:", m.err)).flatMap(_ => IO.fail("toml")) else fuzzRelateJob(exeName(outDir, m.name), m.hasUi, dir, outDir)

def fuzzRelateJob(exe: String, hasUi: Bool, dir: String, outDir: String): IO[Unit] =
  fuzzSeedText(dir).flatMap(script =>
    fuzzWriteSeeds(outDir, script).flatMap(_ =>
      fuzzCorpusFiles(dir).flatMap(runs => fuzzRelateGo(exe, hasUi, outDir, fuzzAddSeeds(runs, joinSlash(outDir, "seeds.txt"), script)))
    )
  )

def fuzzRelateGo(exe: String, hasUi: Bool, outDir: String, runs: List[FuzzRun]): IO[Unit] =
  if (List.isEmpty(runs)) IO.println("scuzz fuzz: --relate: no corpus entries") else Fs.mkdirs(joinSlash(joinSlash(outDir, "fuzz"), "relate")).flatMap(_ =>
    fuzzRelateAcc(exe, hasUi, joinSlash(joinSlash(outDir, "fuzz"), "relate"), runs, 0, 0, List.len(runs))
  )

def fuzzRelateAcc(exe: String, hasUi: Bool, relDir: String, runs: List[FuzzRun], n: Int, fail: Int, total: Int): IO[Unit] =
  if (List.isEmpty(runs)) fuzzRelateDone(fail, total) else fuzzRelateOne(exe, hasUi, relDir, List.head(runs), n).flatMap(bad =>
    fuzzRelateAcc(exe, hasUi, relDir, List.tail(runs), n + 1, fail + bad, total)
  )

def fuzzRelateDone(fail: Int, total: Int): IO[Unit] =
  if (fail > 0) IO.println(Str.concat("fuzz --relate: ", Str.concat(Str.fromInt(fail), Str.concat(" of ", Str.concat(Str.fromInt(total), " entries failed"))))).flatMap(_ => IO.fail("relate")) else IO.println(Str.concat("scuzz fuzz: --relate: ", Str.concat(Str.fromInt(total), " entries ok")))

def fuzzRelateOne(exe: String, hasUi: Bool, relDir: String, run: FuzzRun, n: Int): IO[Int] =
  fuzzRelateOne2(exe, hasUi, relDir, run, n, relateLabel(run), Verify.perturbSched(run.sched, Verify.relateSeed(relateLabel(run), run.sched, run.script, n)))

def fuzzRelateOne2(exe: String, hasUi: Bool, relDir: String, run: FuzzRun, n: Int, label: String, pert: String): IO[Int] =
  fuzzRelateOne3(exe, hasUi, relDir, run, n, label, pert, joinSlash(relDir, Str.concat(Str.fromInt(n), ".a.txt")), joinSlash(relDir, Str.concat(Str.fromInt(n), ".b.txt")))

def fuzzRelateOne3(exe: String, hasUi: Bool, relDir: String, run: FuzzRun, n: Int, label: String, pert: String, a: String, b: String): IO[Int] =
  relateExec(exe, hasUi, relDir, a, Str.concat(Str.fromInt(n), ".a"), run.script, run.sched, run.fault).flatMap(codeA =>
    relateExec(exe, hasUi, relDir, b, Str.concat(Str.fromInt(n), ".b"), run.script, pert, run.fault).flatMap(codeB =>
      fuzzRelateJudge(exe, a, b, label, codeA, codeB)
    )
  )

def fuzzRelateJudge(exe: String, a: String, b: String, label: String, codeA: Int, codeB: Int): IO[Int] =
  fuzzRelateNote(label, "a", codeA).flatMap(fa =>
    fuzzRelateNote(label, "b", codeB).flatMap(fb =>
      relateJudge(exe, a, b).flatMap(fj => fuzzRelateFin(label, fa + fb + fj))
    )
  )

def fuzzRelateNote(label: String, tag: String, code: Int): IO[Int] =
  if (code == 0) IO.pure(0) else IO.println(Str.concat("relate failed: ", Str.concat(label, Str.concat(" (run ", Str.concat(tag, Str.concat(" exited ", Str.concat(Str.fromInt(code), ")"))))))).map(_ => 1)

def fuzzRelateFin(label: String, fail: Int): IO[Int] =
  if (fail > 0) IO.pure(1) else IO.println(Str.concat("relate ok: ", label)).map(_ => 0)

def relateLabel(run: FuzzRun): String =
  relateLabel2(baseName(run.path), run.script)

def relateLabel2(name: String, script: String): String =
  if (name == "seeds.txt") Str.concat("seeds.txt:", firstLine(script)) else name

def baseName(path: String): String =
  baseNameAt(path, Str.len(path) - 1)

def baseNameAt(path: String, i: Int): String =
  if (i < 0) path else if (Str.charAt(path, i) == 47) Str.slice(path, i + 1, Str.len(path)) else baseNameAt(path, i - 1)

def firstLine(s: String): String =
  if (List.isEmpty(Verify.linesOf(s))) "" else List.head(Verify.linesOf(s))

def relateExec(exe: String, hasUi: Bool, relDir: String, out: String, tag: String, script: String, sched: String, fault: String): IO[Int] =
  relateExec2(exe, hasUi, relDir, out, tag, script, sched, fault, joinSlash(relDir, Str.concat(tag, ".script.txt")), joinSlash(relDir, Str.concat(tag, ".sometimes")))

def relateExec2(exe: String, hasUi: Bool, relDir: String, out: String, tag: String, script: String, sched: String, fault: String, scriptPath: String, reached: String): IO[Int] =
  Fs.write(out, "").flatMap(_ =>
    Fs.write(reached, "").flatMap(_ =>
      Fs.write(scriptPath, script).flatMap(_ =>
        Fs.write(joinSlash(relDir, Str.concat(tag, ".dump.txt")), "").flatMap(_ =>
          runLine(Str.concat(relateEnv(hasUi, scriptPath, joinSlash(relDir, Str.concat(tag, ".dump.txt")), script != "", out, reached, sched, fault), exe)).flatMap(r => relateExecGot(r))
        )
      )
    )
  )

def relateExecGot(r: (Int, String, String)): IO[Int] =
  r match {
    case (code, out, err) => if (code == 0) IO.pure(0) else IO.println(if (Str.len(err) > 0) err else out).map(_ => code)
  }

def relateEnv(hasUi: Bool, scriptPath: String, dumpPath: String, hasScript: Bool, tl: String, reached: String, sched: String, fault: String): String =
  Str.concat(relateBaseEnv(hasUi), Str.concat(relateScriptEnv(hasUi, scriptPath, dumpPath, hasScript), Str.concat(fuzzTlEnv(tl), Str.concat(Str.concat("SCUZZ_SOMETIMES_DUMP=", Str.concat(reached, " ")), Str.concat(fuzzSchedEnv(sched), fuzzFaultEnv(fault))))))

def relateBaseEnv(hasUi: Bool): String =
  Str.concat(testEnv(), if (hasUi) headlessEnv() else "")

def relateScriptEnv(hasUi: Bool, scriptPath: String, dumpPath: String, hasScript: Bool): String =
  if (!hasScript) "" else if (hasUi) Str.concat("SCUZZ_UI_SCRIPT=", Str.concat(scriptPath, Str.concat(" SCUZZ_FUZZ_DUMP=", Str.concat(dumpPath, " ")))) else Str.concat("SCUZZ_DRIVE_SCRIPT=", Str.concat(scriptPath, " "))

def relateJudge(exe: String, a: String, b: String): IO[Int] =
  runLine(Str.concat("SCUZZ_JUDGE_REL=", Str.concat(a, Str.concat(",", Str.concat(b, Str.concat(" ", exe)))))).flatMap(r => relateJudgeGot(r))

def relateJudgeGot(r: (Int, String, String)): IO[Int] =
  r match {
    case (code, out, err) => if (code == 0) IO.pure(0) else IO.println(if (Str.len(err) > 0) err else out).map(_ => 1)
  }

