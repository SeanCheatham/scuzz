def requestHeaders(token: String): Map[String, String] =
  Map.set(Map.set(Map.set(Map.empty(), "Authorization", s"Bearer $token"), "Accept", "application/json"), "User-Agent", "scuzz-api-report")

def isOpen(row: Json): Bool =
  Json.getStr(row, "state", "") == "open"

def validRecord(row: Json): Bool =
  Json.isObj(row) && List.nonEmpty(Json.get(row, "state")) && List.forall(Json.get(row, "state"), s => Json.isStr(s))

def decode(status: Int, body: String): Result[String, List[Json]] =
  if (status == 401 || status == 403) Result.Err("API credentials rejected") else if (status < 200 || status >= 300) Result.Err(s"API status $status") else Json.parse(body) match {
  case Result.Err(_) => Result.Err("API returned invalid JSON")
  case Result.Ok(value) => if (!Json.isArr(value)) Result.Err("API response must be an array") else if (!List.forall(Json.arr(value), row => validRecord(row))) Result.Err("Each record must have a string state") else Result.Ok(List.filter(Json.arr(value), row => isOpen(row)))
}

def writeRows(rows: List[Json], output: String): IO[Unit] =
  Json.stringify(Json.Arr(rows.require(xs => List.forall(xs, row => isOpen(row))))) match {
    case Result.Err(_) => IO.fail("Cannot encode report")
    case Result.Ok(text) => Fs.write(output, text)
  }

def retryable(status: Int): Bool =
  status == 429 || status == 502 || status == 503 || status == 504

def retryDelay(status: Int, headers: Map[String, String], nowMs: Int): Int =
  if (!retryable(status)) -1 else retryHeader(status, headers, nowMs, List.filter(Map.keys(headers), name => Str.toLower(name) == "retry-after"))

private def retryHeader(status: Int, headers: Map[String, String], nowMs: Int, names: List[String]): Int =
  if (List.isEmpty(names)) if (status == 429) 1000 else 100 else if (List.len(names) != 1) -1 else Net.retryAfterMillis(Map.getOrElse(headers, List.at(names, 0), ""), nowMs)

private def waitForRetry(url: String, headers: Map[String, String], remaining: Int, response: (Int, Map[String, String], String), delay: Int): IO[(Int, Map[String, String], String)] =
  if (delay < 0) IO.pure(response) else IO.sleep(delay).flatMap(_ => fetch(url, headers, remaining - 1))

private def continueRequest(url: String, headers: Map[String, String], remaining: Int, response: (Int, Map[String, String], String)): IO[(Int, Map[String, String], String)] =
  response match {
    case (status, responseHeaders, _) => if (!retryable(status) || remaining <= 0) IO.pure(response) else Clock.realTime().flatMap(now => waitForRetry(url, headers, remaining, response, retryDelay(status, responseHeaders, now)))
  }

private def fetch(url: String, headers: Map[String, String], remaining: Int): IO[(Int, Map[String, String], String)] =
  Net.httpGet(url, headers).flatMap(response => continueRequest(url, headers, remaining.require(n => n >= 0 && n <= 2), response))

def nextPage(headers: Map[String, String], current: Int): Int =
  pageHeader(headers, current, List.filter(Map.keys(headers), name => Str.toLower(name) == "x-next-page"))

private def pageHeader(headers: Map[String, String], current: Int, names: List[String]): Int =
  if (List.isEmpty(names)) 0 else if (List.len(names) != 1) -1 else pageNumber(Str.trim(Map.getOrElse(headers, List.at(names, 0), "")), current)

private def boundedPage(page: Int, current: Int): Int =
  if (page == 100) if (page > current) page else -1 else if (page > current && page < 100) page else -1

private def pageNumber(value: String, current: Int): Int =
  if (value == "") 0 else if (!Str.matches(value, "[0-9]+")) -1 else boundedPage(Str.toInt(value, -1), current)

def pageUrl(url: String, page: Int): String =
  if (page == 1) url else numberedUrl(List.at(Str.split(url, "#"), 0), page)

private def numberedUrl(url: String, page: Int): String =
  Str.indexOf(url, "?") match {
    case -1 => Str.concat(url, Str.concat("?page=", Str.fromInt(page)))
    case mark => Str.concat(Str.take(url, mark), Str.concat("?", pageQuery(Str.drop(url, mark + 1), page)))
  }

private def pageQuery(query: String, page: Int): String =
  List.join(List.concat(List.filter(Str.split(query, "&"), field => field != "" && !Str.matches(List.at(Str.split(field, "="), 0), "(p|%70)(a|%61)(g|%67)(e|%65)")), [Str.concat("page=", Str.fromInt(page))]), "&")

def linkHeader(headers: Map[String, String]): String =
  List.join(List.map(List.filter(Map.keys(headers), name => Str.toLower(name) == "link"), name => Map.getOrElse(headers, name, "")), ",")

private def readPage(base: String, url: String, headers: Map[String, String], page: Int, rows: List[Json], seen: List[String]): IO[List[Json]] =
  if (List.len(seen) >= 100 || List.contains(seen, url)) IO.fail("Pagination cycle or page limit") else fetch(url, headers, 2).flatMap(response => collectPage(base, url, headers, page, rows, url :: seen, response))

private def collectPage(base: String, url: String, headers: Map[String, String], page: Int, rows: List[Json], seen: List[String], response: (Int, Map[String, String], String)): IO[List[Json]] =
  response match {
    case (status, responseHeaders, body) => decode(status, body) match {
  case Result.Err(message) => IO.fail(message)
  case Result.Ok(found) => advancePage(base, url, headers, page, List.concat(rows, found), seen, responseHeaders)
}
  }

private def advancePage(base: String, url: String, headers: Map[String, String], page: Int, rows: List[Json], seen: List[String], responseHeaders: Map[String, String]): IO[List[Json]] =
  if (List.exists(Map.keys(responseHeaders), name => Str.toLower(name) == "link")) Net.nextLink(url, linkHeader(responseHeaders)) match {
  case Result.Err(message) => IO.fail(message)
  case Result.Ok(next) => if (next == "") IO.pure(rows) else readPage(base, next, headers, page + 1, rows, seen)
} else continuePages(base, headers, nextPage(responseHeaders, page), rows, seen)

private def continuePages(base: String, headers: Map[String, String], next: Int, rows: List[Json], seen: List[String]): IO[List[Json]] =
  if (next < 0) IO.fail("Invalid X-Next-Page header") else if (next == 0) IO.pure(rows) else readPage(base, pageUrl(base, next), headers, next, rows, seen)

def run(url: String, token: String, output: String, timeoutMs: Int): IO[Unit] =
  if (Str.len(token) == 0) IO.fail("Set SCUZZ_API_TOKEN") else for {
  rows <- IO.timeout(timeoutMs, readPage(url, url, requestHeaders(token), 1, [], []))
  _ <- writeRows(rows, output)
} yield ()

