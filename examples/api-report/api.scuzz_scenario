  linkedRequest(3)

def linkOrigin(): IO[Unit] =
  linkedRequest(4)

def linkMalformed(): IO[Unit] =
  linkedRequest(5)

def linkTimeout(): IO[Unit] =
  linkedRequest(6)

def linkAmbiguous(): IO[Unit] =
  linkedRequest(7)

def linkLimit(): IO[Unit] =
  linkedRequest(8)

def linkHundred(): IO[Unit] =
  linkedRequest(9)

private def queryReply(request: (String, String, Map[String, String], String)): IO[(Int, Map[String, String], String)] =
  request match {
    case (path, method, headers, _) => if (method != "GET" || Map.getOrElse(headers, "authorization", "") != "Bearer sim-token") reply(401, "denied") else if (path == "/records?page=1&p%61ge=1&filter=a%26b") IO.pure((200, Map.set(Map.empty(), "X-Next-Page", "2"), "[{\"id\":21,\"state\":\"open\"}]")) else if (path == "/records?filter=a%26b&page=2") reply(200, "[{\"id\":22,\"state\":\"open\"}]") else reply(400, "Invalid page query")
  }

def queryPages(): IO[Unit] =
  for {
    server <- Fiber.fork(Net.serveTls(18083, queryReply))
    _ <- IO.ensure(IO.attempt(Main.runConfigured("https://127.0.0.1:18083/records?page=1&p%61ge=1&filter=a%26b#view?tab=1", "sim-token", "report.json")).map(_ => ()), Fiber.interrupt(server))
  } yield ()

